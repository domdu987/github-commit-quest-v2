[
 {
  "id": "s40",
  "text": "ไม่ไกลกัน",
  "t0": 0.0,
  "t1": 0.838
 },
 {
  "id": "s40",
  "text": "รถเก๋งคันหนึ่ง",
  "t0": 0.838,
  "t1": 1.825
 },
 {
  "id": "s40",
  "text": "พลิกตะแคง",
  "t0": 1.825,
  "t1": 3.184
 },
 {
  "id": "s41",
  "text": "หมอแพรว",
  "t0": 3.292,
  "t1": 4.033
 },
 {
  "id": "s41",
  "text": "หมอห้องฉุกเฉิน",
  "t0": 4.033,
  "t1": 5.568
 },
 {
  "id": "s41",
  "text": "กำลังดึงคุณทศ",
  "t0": 5.568,
  "t1": 6.846
 },
 {
  "id": "s41",
  "text": "ออกจากซากรถ",
  "t0": 6.846,
  "t1": 8.055
 },
 {
  "id": "s42",
  "text": "แต่ประตูที่ยุบ",
  "t0": 8.167,
  "t1": 9.454
 },
 {
  "id": "s42",
  "text": "อัดเขาติดเบาะ",
  "t0": 9.454,
  "t1": 10.658
 },
 {
  "id": "s43",
  "text": "ไกลออกไป",
  "t0": 10.875,
  "t1": 11.879
 },
 {
  "id": "s43",
  "text": "ฝูงของมัน",
  "t0": 11.879,
  "t1": 12.865
 },
 {
  "id": "s43",
  "text": "กำลังวิ่งมา",
  "t0": 12.865,
  "t1": 14.064
 },
 {
  "id": "s44",
  "text": "ก้องชะงัก",
  "t0": 14.25,
  "t1": 15.072
 },
 {
  "id": "s44",
  "text": "หนีตอนนี้",
  "t0": 15.072,
  "t1": 16.457
 },
 {
  "id": "s44",
  "text": "ยังทัน",
  "t0": 16.457,
  "t1": 17.377
 },
 {
  "id": "s45",
  "text": "แต่เขา",
  "t0": 17.584,
  "t1": 18.419
 },
 {
  "id": "s45",
  "text": "วิ่งกลับเข้าไปช่วย",
  "t0": 18.419,
  "t1": 19.88
 },
 {
  "id": "s46",
  "text": "ก้องเอาเครื่องตัดง้างประตู",
  "t0": 20.0,
  "t1": 21.848
 },
 {
  "id": "s46",
  "text": "คุณทศหลุดออกมา",
  "t0": 21.848,
  "t1": 23.701
 },
 {
  "id": "s47",
  "text": "พี่!",
  "t0": 23.917,
  "t1": 24.503
 },
 {
  "id": "s47",
  "text": "รอผมด้วย!",
  "t0": 24.503,
  "t1": 25.769
 },
 {
  "id": "s48",
  "text": "เจมส์",
  "t0": 25.875,
  "t1": 26.295
 },
 {
  "id": "s48",
  "text": "ไรเดอร์ส่งอาหาร",
  "t0": 26.295,
  "t1": 26.917
 },
 {
  "id": "s48",
  "text": "กระโดดลงจากหลังคารถ",
  "t0": 26.917,
  "t1": 28.533
 },
 {
  "id": "s48",
  "text": "แต่ที่ตามหลังมา",
  "t0": 28.533,
  "t1": 29.647
 },
 {
  "id": "s48",
  "text": "คือน้องของก้อง",
  "t0": 29.647,
  "t1": 30.97
 },
 {
  "id": "s49",
  "text": "ทุกคนขึ้นรถกู้ภัย",
  "t0": 31.125,
  "t1": 32.982
 },
 {
  "id": "s49",
  "text": "ประตูปิดทัน",
  "t0": 32.982,
  "t1": 34.277
 },
 {
  "id": "s49",
  "text": "แค่เสี้ยววินาที",
  "t0": 34.277,
  "t1": 35.803
 },
 {
  "id": "s50",
  "text": "หน้าที่แนบกระจก",
  "t0": 36.042,
  "t1": 37.004
 },
 {
  "id": "s50",
  "text": "คือคนที่เขาสัญญา",
  "t0": 37.004,
  "t1": 38.543
 },
 {
  "id": "s50",
  "text": "ว่าจะพาไปโรงพยาบาล",
  "t0": 38.543,
  "t1": 40.626
 },
 {
  "id": "s51",
  "text": "ก้องออกรถ",
  "t0": 40.875,
  "t1": 41.923
 },
 {
  "id": "s51",
  "text": "แทรกไปตามช่องว่าง",
  "t0": 41.923,
  "t1": 43.532
 },
 {
  "id": "s52",
  "text": "แต่ข้างหน้า",
  "t0": 43.625,
  "t1": 44.819
 },
 {
  "id": "s52",
  "text": "รถบรรทุกขวาง",
  "t0": 44.819,
  "t1": 45.967
 },
 {
  "id": "s52",
  "text": "เต็มถนน",
  "t0": 45.967,
  "t1": 47.237
 },
 {
  "id": "s53",
  "text": "มือเขาไปเอง",
  "t0": 47.375,
  "t1": 48.416
 },
 {
  "id": "s53",
  "text": "ตามความเคยชิน",
  "t0": 48.416,
  "t1": 49.604
 },
 {
  "id": "s53",
  "text": "เปิดไซเรนขอทาง",
  "t0": 49.604,
  "t1": 51.063
 },
 {
  "id": "s54",
  "text": "ทุกตัวบนทางด่วน",
  "t0": 52.25,
  "t1": 53.482
 },
 {
  "id": "s54",
  "text": "หยุดวิ่ง",
  "t0": 53.482,
  "t1": 54.321
 },
 {
  "id": "s54",
  "text": "แล้วหันมา",
  "t0": 54.321,
  "t1": 55.215
 },
 {
  "id": "s54",
  "text": "พร้อมกัน",
  "t0": 55.215,
  "t1": 56.093
 },
 {
  "id": "s55",
  "text": "ปิดเสียง!",
  "t0": 56.25,
  "t1": 57.044
 },
 {
  "id": "s55",
  "text": "เร็ว!",
  "t0": 57.044,
  "t1": 57.75
 },
 {
  "id": "s56",
  "text": "ก้องปิดไซเรน",
  "t0": 57.834,
  "t1": 58.777
 },
 {
  "id": "s56",
  "text": "แต่สายไปแล้ว",
  "t0": 58.777,
  "t1": 60.25
 },
 {
  "id": "s56",
  "text": "ทั้งฝูงรู้แล้ว",
  "t0": 60.25,
  "t1": 61.307
 },
 {
  "id": "s56",
  "text": "ว่าเขาอยู่ตรงไหน",
  "t0": 61.307,
  "t1": 62.878
 },
 {
  "id": "s57",
  "text": "เสียง กับแสง",
  "t0": 63.125,
  "t1": 65.002
 },
 {
  "id": "s57",
  "text": "คือสิ่งที่เรียกมัน",
  "t0": 65.002,
  "t1": 66.348
 },
 {
  "id": "s58",
  "text": "ขับไปสิ!",
  "t0": 66.542,
  "t1": 67.155
 },
 {
  "id": "s58",
  "text": "จะจอดให้มันกิน",
  "t0": 67.155,
  "t1": 67.955
 },
 {
  "id": "s58",
  "text": "หรือไง!",
  "t0": 67.955,
  "t1": 68.826
 },
 {
  "id": "s59",
  "text": "รถข้างหน้า",
  "t0": 68.917,
  "t1": 69.818
 },
 {
  "id": "s59",
  "text": "ขยับไม่ได้!",
  "t0": 69.818,
  "t1": 71.2
 },
 {
  "id": "s60",
  "text": "พี่! ผมเคยผ่านแถวนี้",
  "t0": 71.334,
  "t1": 73.044
 },
 {
  "id": "s60",
  "text": "มีทางลง",
  "t0": 73.044,
  "t1": 73.962
 },
 {
  "id": "s60",
  "text": "ข้างรถคันนั้น!",
  "t0": 73.962,
  "t1": 75.116
 }
]