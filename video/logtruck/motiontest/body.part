      // ---------- ท่อนซุงลงเขา · motion test (V11) ----------
      const GDAY = { top: "#fff3d6", bottom: "#cfe6f4", op: 0.08 };
      const LIFE = (dur, extra) => (tl, id, t0, L) => { Lt.life(tl, `#${id}`, t0, dur); if (extra) extra(tl, id, t0, L); };
      const flash = (tl, t, op = 0.85) => { tl.set("#flashw", { opacity: op }, t); tl.to("#flashw", { opacity: 0, duration: 0.25 }, t + 0.03); };
      const kick = (a, b, amp) => (t) => (t >= a && t < b ? { x: amp * Math.sin(t * 61) * (1 - (t - a) / (b - a)), y: amp * 0.8 * Math.sin(t * 47) * (1 - (t - a) / (b - a)), r: 0 } : 0);
      // 1. HOOK 0–0.9: the front chain snaps (sparks), the top log jumps out and tumbles end-first at the lens, filling the windscreen
      add("hook", { set: "ltPOV", setOpts: { id: "h", mirror: 0.85, truck: { x: 560, y: 1300, s: 0.8, brake: 1, smoke: 0.5 } }, dark: 0, grade: GDAY, blur: { fg: 2 },
        cam: { keys: [{ t: 0, ...fr(560, 1020, 1.22, 540, 960) }, { t: 0.9, glide: 0.88, ...fr(560, 1000, 1.38, 540, 960) }] },
        shake: (t) => (t > 0.02 ? { x: 9 * Math.sin(t * 70), y: 7 * Math.sin(t * 53), r: 0.4 * Math.sin(t * 31) } : 0),
        fx: LIFE(0.9, (tl, id, t0, L) => {
          Lt.snap(tl, "h", t0 + 0.02);
          Lt.sparks(tl, L.glow, t0 + 0.02, 560, 806, 1.3, 18, 5);
          Lt.sparks(tl, L.glow, t0 + 0.06, 800, 1060, 0.9, 10, 9);
          tl.fromTo("#h-truck-top", { x: 0, y: 0, scale: 1, rotation: 0, transformOrigin: "50% 50%" }, { keyframes: [{ x: -10, y: -60, scale: 1.4, rotation: 30, duration: 0.18, ease: "power2.out" }, { x: -26, y: 150, scale: 7.5, rotation: 170, duration: 0.6, ease: "power2.in" }], immediateRender: false }, t0 + 0.06);
          flash(tl, t0 + 0.84, 0.6);
        }) });
      // 2. the log hits the road in front, bounces, rolls to the guardrail; เจ๋ง stamps on the brake (camera dips), the garland swings
      add("bounce", { set: "ltPOV", setOpts: { id: "b", mirror: 0.95, truck: { x: 600, y: 1240, s: 0.56, brake: 1 }, loose: { x: 420, y: 760, s: 1.5 } }, dark: 0, grade: GDAY, blur: { fg: 2 },
        cam: { keys: [{ t: 0, ...fr(560, 1000, 1.18, 540, 960) }, { t: 2, glide: 1.6, ...fr(580, 1010, 1.12, 540, 960) }] },
        shake: (t) => { const d = kick(0.28, 0.7, 14)(t); const dip = t < 0.9 ? 18 * Math.sin(Math.min(1, t / 0.9) * Math.PI) : 0; return { x: d ? d.x : 0, y: (d ? d.y : 0) + dip, r: t < 0.9 ? -0.6 * Math.sin(t / 0.9 * Math.PI) : 0 }; },
        fx: LIFE(2, (tl, id, t0, L) => {
          tl.fromTo("#b-loose", { attr: { transform: "translate(420,760) scale(1.5) rotate(-24)" } }, { keyframes: [
            { attr: { transform: "translate(520,1330) scale(1.45) rotate(4)" }, duration: 0.3, ease: "power2.in" },
            { attr: { transform: "translate(760,1160) scale(1.08) rotate(16)" }, duration: 0.28, ease: "power2.out" },
            { attr: { transform: "translate(930,1250) scale(0.9) rotate(8)" }, duration: 0.24, ease: "power2.in" },
            { attr: { transform: "translate(1060,1190) scale(0.78) rotate(2)" }, duration: 0.7, ease: "power3.out" }], immediateRender: false }, t0);
          tl.fromTo("#b-loose .lroll", { x: 0 }, { x: 18, duration: 0.05, repeat: 18, yoyo: true, immediateRender: false }, t0);
          HnFx.dust(tl, L.glow, t0 + 0.3, 520, 1380, 2.2); HnFx.dust(tl, L.glow, t0 + 0.82, 930, 1290, 1.6);
        }) });
      // 3. the mirror: the chrome grille fills it and comes closer, high beams flash twice (the air horn will lead it in the mix)
      add("mirror", { set: "ltMirror", setOpts: { id: "m", is: 1.0, iy: 1330 }, dark: 0, grade: GDAY, blur: { fg: 3 },
        cam: { keys: [{ t: 0, ...fr(540, 860, 1.5, 540, 900) }, { t: 2, glide: 2, ...fr(540, 870, 1.7, 540, 900) }] }, shake: kick(0.5, 1.2, 6),
        fx: LIFE(2, (tl, id, t0) => {
          tl.fromTo("#m-img", { attr: { transform: "translate(540,1330) scale(1.0)" } }, { attr: { transform: "translate(540,1560) scale(1.5)" }, duration: 2, ease: "power1.in", immediateRender: false }, t0);
          [0.5, 0.95].forEach((k) => { tl.set("#m-t-beam", { opacity: 1 }, t0 + k); tl.set("#m-t-beam", { opacity: 0 }, t0 + k + 0.18); tl.set("#m-flash", { opacity: 0.5 }, t0 + k); tl.to("#m-flash", { opacity: 0, duration: 0.2 }, t0 + k + 0.02); });
        }) });
      // 4. the convoy in profile on the descent: truck (smoke, brake lights) – our car squeezed – the big one behind; the gap coin pops
      add("slope", { set: "ltSlope", setOpts: { id: "s", ground: 1300, slope: 9, convoy: { truck: 1500, car: 900, tank: -270, trs: 0.62, cs: 0.62, ts: 0.62, cabOnly: true, smoke: 1, brake: 1, cbrake: 1 } }, dark: 0, grade: GDAY, blur: { far: 1.5 },
        cam: { keys: [{ t: 0, ...fr(1120, 1330, 0.9, 540, 1150) }, { t: 3, glide: 3, ...fr(1400, 1380, 0.95, 540, 1150) }] },
        fx: LIFE(3, (tl, id, t0, L) => {
          const mv = (sel, d) => tl.to(sel, { x: d, y: d * Math.tan(9 * Math.PI / 180), duration: 3, ease: "none" }, t0);
          mv("#s-truck", 260); mv("#s-car", 290); mv("#s-tank", 330);
          put(L.glow, Lt.coin("gap", 1280, 900, 2.2, "s-coin"));
          Lt.coinIn(tl, "s-coin", t0 + 0.9, 2);
        }) });
      // 5. the coin set (V11): mirror rule, low gear, don't lift it, orange plate — each pops, squashes, lives
      add("coins", { set: "ltPOV", setOpts: { id: "c", mirror: 0.6, truck: { x: 560, y: 1300, s: 0.6, smoke: 0.8 } }, dark: 0.25, grade: GDAY, blur: { far: 4, mid: 4, set: 6, act: 6, fg: 8 },
        cam: { keys: [{ t: 0, ...fr(560, 1000, 1.1, 540, 960) }, { t: 1.9, glide: 1.9, ...fr(560, 990, 1.16, 540, 960) }] },
        fx: LIFE(1.9, (tl, id, t0, L) => {
          [["mirror", 300, 760], ["gear", 780, 760], ["nolift", 300, 1220], ["orange", 780, 1220]].forEach(([n, x, y], k) => {
            const cid = `c-coin${k}`; put(L.glow, Lt.coin(n, x, y, 2.6, cid)); Lt.coinIn(tl, cid, t0 + 0.1 + k * 0.22, 1.9);
          });
        }) });
