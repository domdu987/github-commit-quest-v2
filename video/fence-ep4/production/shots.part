      // ======================================================================================================
      // เอาชีวิตรอด 99 วัน · EP.4 "รั้วล้ม"
      // ======================================================================================================
      const put = (el, html) => el.insertAdjacentHTML("beforeend", html);
      const SKIN_PIM = { skin: "#ecc29c", sleeve: "#9fc5d8" }, SKIN_PHU = { skin: "#d39a6e", sleeve: "#6b7a5a" };
      const MLP = "ที่มา: <em>MedlinePlus (สหรัฐฯ · NIH)</em> · ";
      const HA = (who, x, y, s, track, extra = {}) => ({ who, x, y, s, blinks: [], track, ...extra });
      const ZF = (L, tl, pre, t0, dur, list, mode = "lunge") => list.forEach(([w, x, s, ph], k) => behind(L, tl, `${pre}-z${k}`, w, x, 1180, s, true, t0, dur, [{ t: 0, mode, eyes: "dead", mouth: "snarl", opts: { period: 1.2 + ph } }]));
      const RAIN = (L, o) => Fence.rain(L, o);
      const CLIP = (list) => { list.sort((a, b) => a.t - b.t); for (let n = 0; n + 1 < list.length; n++) list[n].end = Math.min(list[n].end, list[n + 1].t - 0.03); return list; };
      const THUNDER = (tl, t, a = 0.5) => { tl.fromTo("#flashw", { opacity: a }, { opacity: 0, duration: 0.12, immediateRender: false }, t); tl.fromTo("#flashw", { opacity: a * 0.6 }, { opacity: 0, duration: 0.3, immediateRender: false }, t + 0.18); };
      PK_ICON.knife = (p) => `${PKG(p)}${SHADOW(24, 45, 16)}<g class="a-wob" style="transform-origin:24px 24px"><path d="M8,40l10,-10" stroke="#3a2e22" stroke-width="7" stroke-linecap="round"/><path d="M16,32L36,8q6,-2 6,6L24,38z" fill="#dfe6e2" stroke="${PK_INK}" stroke-width="2" stroke-linejoin="round"/><path d="M20,32L36,12" stroke="#fff" stroke-width="2"/></g>`;
      PK_ICON.spear = (p) => `${PKG(p)}${SHADOW(24, 45, 16)}<g class="a-wob" style="transform-origin:24px 24px"><path d="M6,42L30,18" stroke="#b9c0c6" stroke-width="7" stroke-linecap="round"/><path d="M26,22L38,6q6,-2 6,6L32,28z" fill="#dfe6e2" stroke="${PK_INK}" stroke-width="2" stroke-linejoin="round"/><path d="M22,26l6,6" stroke="#1f1d1a" stroke-width="5"/></g>`;
      PK_ICON.rain = (p) => `${PKG(p)}${SHADOW(24, 45, 14)}<path d="M12,20q-8,-14 8,-14q4,-10 16,-6q12,-2 12,10q8,6 0,12H12z" fill="#9aa0a6" stroke="${PK_INK}" stroke-width="2"/><g class="a-bob"><path d="M16,30l-4,10M26,30l-4,10M36,30l-4,10" stroke="#6fb3d6" stroke-width="3" stroke-linecap="round"/></g>`;
      Object.assign(GameUI.ILL, {
        tq: `${PKG("tq")}${SHADOW(60, 108, 34)}<rect x="40" y="10" width="40" height="100" rx="12" fill="#3f5a8a" stroke="${PK_INK}" stroke-width="3"/><path d="M48,86h24" stroke="#8f1b1b" stroke-width="8" stroke-linecap="round"/><rect x="30" y="40" width="60" height="18" rx="4" fill="#3a2e22" stroke="${PK_INK}" stroke-width="2.5"/><g class="a-wob" style="transform-origin:60px 49px"><rect x="20" y="44" width="80" height="10" rx="4" fill="#c9955c" stroke="${PK_INK}" stroke-width="2.5"/></g><text x="98" y="30" font-family="Kanit" font-weight="900" font-size="16" fill="#c8392b">5–7 ซม.</text>`,
        trap: `${PKG("tr")}${SHADOW(60, 108, 34)}<rect x="30" y="40" width="60" height="50" rx="6" fill="#2e2a26" stroke="${PK_INK}" stroke-width="3"/><circle cx="48" cy="60" r="5" fill="#f4ecd8"/><circle cx="72" cy="60" r="5" fill="#f4ecd8"/><path d="M48,78q12,-10 24,0" stroke="#f4ecd8" stroke-width="3" fill="none"/><path d="M60,40V14" stroke="#8a857a" stroke-width="3"/><g class="a-pulse" style="transform-origin:60px 65px"><path d="M14,50q-10,15 0,30M106,50q10,15 0,30M6,40q-16,25 0,50M114,40q16,25 0,50" stroke="#f2c55c" stroke-width="4" fill="none" stroke-linecap="round"/></g>`,
        rainfast: `${PKG("rf")}${SHADOW(60, 108, 34)}<path d="M24,50q-14,-24 14,-26q6,-18 28,-12q22,-4 24,16q16,8 2,22H24z" fill="#9aa0a6" stroke="${PK_INK}" stroke-width="3"/><g class="a-bob"><path d="M34,64l-6,16M54,64l-6,16M74,64l-6,16M94,60l-6,16" stroke="#6fb3d6" stroke-width="4" stroke-linecap="round"/></g><path d="M20,100h30M12,108h26M60,104h40" stroke="#c8392b" stroke-width="4" stroke-linecap="round"/><text x="104" y="40" font-family="Kanit" font-weight="900" font-size="18" fill="#c8392b">×2</text>`,
      });
      const KN = (id) => `<g id="${id}" opacity="0"><rect x="8" y="-70" width="28" height="120" rx="8" fill="#5a3a1e" stroke="#2e2a26" stroke-width="4"/><path d="M4,50h36l-6,250q-12,26 -24,0z" fill="url(#fCan)" stroke="#2e2a26" stroke-width="4" stroke-linejoin="round"/><path d="M16,60l2,210" stroke="#fff" stroke-width="3" opacity=".55"/></g>`;
      const ROLL = (id) => `<g id="${id}" opacity="0" transform="translate(22,-10)"><circle r="54" fill="#1f1d1a" stroke="#2e2a26" stroke-width="4"/><circle r="54" fill="none" stroke="#3a3632" stroke-width="12" stroke-dasharray="6 9"/><circle r="22" fill="#e8dcc6" stroke="#2e2a26" stroke-width="4"/></g>`;
      // the small battery speaker tied to a post: a black box with two round grilles (the "face" ปั้น draws) on a string
      const LUREBOX = (id, x, y, s = 1) => `<g id="${id}" transform="translate(${x},${y}) scale(${s})"><path d="M0,-90V0" stroke="#8a857a" stroke-width="4"/><rect x="-34" y="0" width="68" height="54" rx="6" fill="#2e2a26" stroke="#111" stroke-width="3"/><circle cx="-14" cy="22" r="8" fill="none" stroke="#9aa0a6" stroke-width="3"/><circle cx="14" cy="22" r="8" fill="none" stroke="#9aa0a6" stroke-width="3"/><rect x="-14" y="40" width="28" height="6" fill="#9aa0a6"/><circle class="lurelt" cx="26" cy="8" r="3" fill="#ff5a4a"/></g>`;

      // ---------- 1. hook, first person through the bars in the rain: a child's voice out in the dark; "อย่าเพิ่งออกไป" ----------
      add("hook", {
        set: "gateClose", setOpts: { id: "hk", time: "night", bolt: 0 }, dark: 0.45, blur: { far: 5, mid: 2 },
        cam: { keys: [{ t: 0, ...fr(540, 1050, 0.82, 540, 1000), drift: { s: 0.02 } }, { t: vo("hook", 1) - 0.1, glide: 0.8, ...fr(560, 1000, 1.05, 540, 960), drift: { s: 0.03 } }, { t: vo("hook", 2) - 0.05, ...fr(600, 1150, 1.3, 540, 1050), drift: { s: 0.04 } }] },
        shake: (t) => (t > vo("hook", 2) && t < vo("hook", 2) + 0.35 ? 12 * Math.sin(t * 23) * (vo("hook", 2) + 0.35 - t) / 0.35 : 1.5 * Math.sin(t * 2.6)),
        captions: CLIP([...caps("hook", [0]), ...caps("hook", [1], { quote: true }), ...caps("hook", [2])]),
        extra(L) { RAIN(L, { n: 110, op: 0.6 }); put(L.glow, `<circle cx="300" cy="900" r="420" fill="url(#fLamp)" opacity=".4"/>`); put(L.mid, `<g id="hk-lurelt" opacity="0"><circle cx="1500" cy="1060" r="5" fill="#ff5a4a"/><circle cx="1500" cy="1060" r="22" fill="#ff5a4a" opacity=".25"/></g>`); },
        fx(tl, id, t0) {
          document.querySelectorAll(`#${id} .capbox`).forEach((c, i) => { if (i >= caps("hook", [0]).length && i < caps("hook", [0]).length + caps("hook", [1]).length) c.classList.add("radio"); });
          THUNDER(tl, t0 + 0.6, 0.35); THUNDER(tl, t0 + vo("hook", 1) + 1.2, 0.5);
          for (let t = vo("hook", 1); t < vo("hook", 2); t += 0.9) { tl.set("#hk-lurelt", { opacity: 1 }, t0 + t); tl.set("#hk-lurelt", { opacity: 0 }, t0 + t + 0.15); }
          Fx.punch(tl, `#${id} .stage`, t0 + vo("hook", 2), 1.08, 0.4); Fx.glitch(tl, `#${id}`, t0 + vo("hook", 2), 0.25, 10, 11); red(tl, t0 + vo("hook", 2));
          Fx.heart(tl, t0 + vo("hook", 1), D("hook") - vo("hook", 1), 0.5, 0.55);
          tl.set("#black", { opacity: 1 }, t0 + D("hook") - 0.12); tl.set("#black", { opacity: 0 }, t0 + D("hook"));
        },
      });

      // ---------- 2. chapter: the page, 96 days; the camp has no weapon at all ----------
      add("chapter", {
        set: "schoolYard", setOpts: { id: "ch", time: "day", level: 0.5 }, dark: 0.25, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(560, 760, 0.62, 540, 900), drift: { s: 0.012, y: 10 } }] },
        captions: caps("chapter"),
        ui: [{ type: "board", t: 0.05, day: "96", ep: "ตอนที่ 4 · รั้วล้ม", top: 330 },
          { type: "counter", t: F("chapter", 0, 1) - 0.1, end: D("chapter") - 0.05, label: "อาวุธของค่าย", icon: "knife", unit: "ชิ้น", max: 3, sub: "เคียวหัก · มีดหาย", keys: [{ t: F("chapter", 0, 1), v: 0 }], alarm: F("chapter", 0, 1) + 0.3, top: 1080, right: true }],
        fx(tl, id, t0) { Fx.heart(tl, t0 + 0.6, D("chapter") - 0.6, 0.7, 0.3); Fx.punch(tl, `#${id} .stage`, t0 + F("chapter", 0, 1) + 0.3, 1.05, 0.3); red(tl, t0 + F("chapter", 0, 1) + 0.3, 0.4, 0.5); },
      });

      // ---------- 3. "เราจะสู้ด้วยอะไร" — the stock-keeper knows without walking: four brooms, one roll of tape, no knife ----------
      add("ask", {
        set: "schoolYard", setOpts: { id: "ak", time: "day", level: 0.5 }, dark: 0.15, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(300, 1150, 0.95, 540, 1050), drift: { s: 0.015 } }, { t: vo("ask", 1) - 0.05, ...fr(-20, 1180, 1.15, 540, 1050), drift: { s: 0.02 } }] },
        actors: [KO(300, 1500, 0.9, [{ t: 0, mode: "point", eyes: "wide", mouth: "o" }, { t: vo("ask", 1), mode: "idle", eyes: "normal", mouth: "frown" }]), PI(560, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }], { flip: true }),
          HO(-60, 1500, 0.9, [{ t: 0, mode: "write", eyes: "normal", mouth: "flat" }, { t: vo("ask", 1) - 0.1, mode: "point", eyes: "normal", mouth: "flat" }], { prop: "ledger" }), PH(760, 1500, 0.9, [{ t: 0, mode: "listen", eyes: "normal", mouth: "flat" }], { flip: true }),
          MA(-280, 1500, 0.9, [{ t: 0, mode: "holdArm", eyes: "normal", mouth: "frown" }]), PU(140, 1500, 0.58, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }])],
        captions: caps("ask", [2]),
        bubbles: [bub("ask", 0, 380, 520, 420), bub("ask", 1, 40, 520, 160)],
        ui: [{ type: "skill", t: vo("ask", 1) + 0.2, end: D("ask") - 0.1, x: 560, y: 820, name: "เจ๊หงส์", skill: "คลัง", desc: "รู้ว่าของอยู่ไหน มีเท่าไหร่ ไม่ต้องเดินดู", icon: "ledger" }],
        fx(tl, id, t0) { Fx.punch(tl, `#${id} .stage`, t0 + F("ask", 1, 2), 1.05, 0.35); red(tl, t0 + F("ask", 1, 2), 0.4, 0.5); Fx.heart(tl, t0, D("ask"), 0.65, 0.35); },
      });

      // ---------- 4. "ผมมีมีด" — the stranger's knife becomes the only edge in the camp ----------
      add("phuKnife", {
        set: "schoolYard", setOpts: { id: "pk", time: "day", level: 0.5 }, dark: 0.18, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(760, 1200, 1.3, 540, 1050), drift: { s: 0.02 } }, { t: vo("phuKnife", 1) - 0.05, glide: 0.5, ...fr(560, 1150, 0.95, 540, 1050), drift: { s: 0.02 } }] },
        actors: [PH(760, 1500, 0.9, [{ t: 0, mode: "reach", eyes: "normal", mouth: "flat" }, { t: 0.5, mode: "raise", eyes: "normal", mouth: "flat" }], { flip: true, prop: "knife" }), PI(560, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }, { t: 0.6, mode: "idle", eyes: "wide", mouth: "o" }]),
          KO(300, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: 0.6, mode: "idle", eyes: "wide", mouth: "smile" }]), HO(-60, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }], { prop: "ledger" }), MA(-280, 1500, 0.9, [{ t: 0, mode: "holdArm", eyes: "normal", mouth: "frown" }])],
        captions: caps("phuKnife", [1]),
        bubbles: [bub("phuKnife", 0, 520, 520, 60)],
        fx(tl, id, t0) { Fx.punch(tl, `#${id} .stage`, t0 + 0.55, 1.05, 0.35); Fx.punch(tl, `#${id} .stage`, t0 + F("phuKnife", 1, 1), 1.05, 0.35); red(tl, t0 + F("phuKnife", 1, 1), 0.45, 0.5); Fx.heart(tl, t0 + 0.5, D("phuKnife") - 0.5, 0.55, 0.45); },
      });

      // ---------- 5. the runner: three minutes, everything on the desk ----------
      add("run", {
        set: "schoolYard", setOpts: { id: "rn", time: "day", level: 0.5 }, dark: 0.15, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(400, 1150, 0.9, 540, 1050), r: -2, drift: { s: 0.04, r: 2, x: 60 } }] },
        shake: (t) => 3 * Math.sin(t * 15),
        actors: [KO(-400, 1500, 0.9, [{ t: 0, mode: "run", eyes: "wide", mouth: "smile" }], { prop: "broom", moveTo: { x: 1500, dur: D("run"), ease: "none" } }), HO(900, 1500, 0.9, [{ t: 0, mode: "point", eyes: "normal", mouth: "flat" }], { flip: true, prop: "ledger" })],
        captions: caps("run"),
        ui: [{ type: "skill", t: 0.3, end: D("run") - 0.1, x: 60, y: 820, name: "ก้อง", skill: "นักวิ่ง", desc: "เร็วที่สุด · เก็บของครบก่อนใคร", icon: "shoe" }],
        fx(tl, id, t0) { Fx.speed(tl, t0 + 0.2, t0 + D("run") - 0.2); Fx.heart(tl, t0, D("run"), 0.5, 0.5); },
      });

      // ---------- 6. first person at the desk: broom + knife + tape = the spear; then the steel pipe from the tank ladder — +1 ----------
      {
        const held = { L: "translate(378,1214) rotate(90) scale(-0.62,0.62)", R: "translate(809,1126) rotate(-90) scale(0.62,0.62)" };
        add("craft", {
          set: "classroom", setOpts: { id: "cf", time: "day", lampX: 540, lampY: 700 }, dark: 0.2, blur: { far: 4 },
          cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960), drift: { s: 0.012, y: -6 } }, { t: F("craft", 1, 0) - 0.05, glide: 0.55, ...fr(880, 1090, 1.45, 540, 980) }, { t: F("craft", 1, 0) + 0.55, ...fr(540, 960, 1.0, 540, 960), drift: { s: 0.01 } }, { t: F("craft", 3, 0) - 0.05, glide: 0.5, ...fr(900, 1080, 1.35, 540, 980) }, { t: F("craft", 3, 0) + 0.5, ...fr(540, 960, 1.0, 540, 960), drift: { s: 0.01 } }] },
          shake: (t) => 3 * Math.sin(t * 2.1) + 1.5 * Math.sin(t * 5.3) + ((t > F("craft", 1, 0) - 0.5 && t < F("craft", 1, 0) + 0.05) || (t > F("craft", 3, 0) - 0.5 && t < F("craft", 3, 0) + 0.05) ? 9 * Math.sin(t * 25) : 0),
          captions: caps("craft"),
          ui: [{ type: "craft", t: 0.3, end: D("craft") - 0.1, top: 150, title: "สูตรประดิษฐ์", who: "สมุดสูตร · วันที่ 103",
            parts: [{ icon: "broom", label: "ไม้กวาด", at: F("craft", 0, 0) + 0.1 }, { icon: "knife", label: "มีดของภู", at: F("craft", 0, 1) + 0.1 }, { icon: "tape", label: "เทปพันสาย", at: F("craft", 0, 2) + 0.1 }],
            build: F("craft", 1, 0), result: { icon: "spear", label: "หอกมีด" }, stats: [{ label: "ระยะ", v: 3 }, { label: "แรง", v: 3 }, { label: "เสียง", v: 1 }],
            upgrade: { at: F("craft", 2, 1), part: { icon: "pipe", label: "ท่อเหล็ก" }, label: "หอกมีด +1", stats: [{ v: 5 }, { v: 4 }, { v: 2 }] } },
            { type: "skill", t: F("craft", 2, 0) + 0.2, end: D("craft") - 0.3, x: 40, y: 760, name: "ลุงหมาน", skill: "ช่าง", desc: "อัปเกรดได้คนเดียวในค่าย", icon: "wrench" },
            { type: "callback", t: F("craft", 1, 0) + 0.3, end: F("craft", 2, 0) - 0.1, label: "ประดิษฐ์สำเร็จ", text: "หอกมีด", top: 1040 }, { type: "callback", t: F("craft", 3, 0) + 0.1, end: D("craft") - 0.3, label: "อัปเกรด", text: "หอกมีด <em>+1</em>", top: 1100 }],
          extra(L) {
            put(L.set, `<path d="M-1200,900L2300,900L2300,2800L-1200,2800Z" fill="#6b4a2e" stroke="#2e2a26" stroke-width="4"/><path d="M-1200,900L2300,900L2300,940L-1200,940Z" fill="#8a6a42"/>${[1020, 1160, 1320, 1500, 1700, 1950, 2250].map((y) => `<path d="M-1200,${y}L2300,${y}" stroke="#5a3d24" stroke-width="3" opacity=".8"/>`).join("")}<ellipse cx="600" cy="1380" rx="760" ry="330" fill="#9a7045" opacity=".28"/>`);
            glow(L, `<circle cx="560" cy="1050" r="720" fill="url(#fLamp)" opacity=".4"/>`);
            const ko = Rig.CAST.kong, ma = Rig.CAST.man;
            const BROOM = `<rect class="shaft" x="0" y="-18" width="864" height="36" rx="12" fill="#c9955c" stroke="#2e2a26" stroke-width="4"/><path d="M-40,-60q-40,60 0,120h70q10,-60 0,-120z" fill="#e2c988" stroke="#2e2a26" stroke-width="4" stroke-linejoin="round"/><path d="M-30,-40v80M-10,-50v100M10,-44v88" stroke="#a78a4a" stroke-width="3"/><rect x="-44" y="-24" width="82" height="20" fill="#c8392b" stroke="#2e2a26" stroke-width="3"/>`;
            put(L.act, `<g id="cp-desk">
              <g id="cp-broom0" transform="translate(140,1480) rotate(-6)">${BROOM}</g>
              <g id="cp-knife0" transform="translate(700,1560) rotate(-62)">${KN("cp-knife0i").replace('opacity="0"', 'opacity="1"')}</g>
              <g id="cp-roll0" transform="translate(940,1620)">${ROLL("cp-roll0i").replace('opacity="0"', 'opacity="1"')}</g></g>
            <g id="cp-held">
              <g id="cp-spear" transform="translate(140,1480) rotate(-6)" opacity="0">
                <g id="cp-wood">${BROOM}</g>
                <g id="cp-pipe" transform="translate(1300,0)" opacity="0"><rect x="0" y="-21" width="864" height="42" rx="14" fill="url(#fCan)" stroke="#2e2a26" stroke-width="4"/><path d="M20,-6h800" stroke="#fff" stroke-width="3" opacity=".5"/><rect x="-44" y="-24" width="82" height="20" fill="#c8392b" stroke="#2e2a26" stroke-width="3"/></g>
                <g transform="translate(830,22) rotate(-90)">${KN("cp-kn")}</g>
                ${[770, 806, 842].map((x, k) => `<rect id="cp-band${k}" x="${x}" y="-22" width="26" height="44" rx="4" fill="#1f1d1a" stroke="#2e2a26" stroke-width="3" opacity="0"/>`).join("")}
                <path id="cp-glint" d="M300,-30L380,-30L340,30L260,30Z" fill="#fff" opacity="0"/><g id="cp-sparks">${Array.from({ length: 16 }, (_, k) => `<circle class="spk" cx="850" cy="0" r="${4 + (k % 3) * 2}" fill="${k % 4 ? "#ffd25a" : "#fff6d8"}" opacity="0"/>`).join("")}</g>
              </g>
              <g id="cp-hl" transform="translate(-300,2300) rotate(90) scale(-0.62,0.62)">${Hand.grip({ skin: ko.skin, sleeve: ko.sleeve })}</g>
              <g id="cp-hr" transform="translate(1400,2300) rotate(-90) scale(0.62,0.62)">${Hand.grip({ skin: ko.skin, sleeve: ko.sleeve })}<g transform="translate(22,0)">${KN("cp-knh")}</g>${ROLL("cp-rollh")}</g>
            </g>
            <g id="cp-hm" transform="translate(1700,1500) rotate(-90) scale(0.6,0.6)">${Hand.grip({ skin: ma.skin, sleeve: ma.sleeve })}</g>`);
          },
          fx(tl, id, t0, L) {
            const A = (sel, from, to, t, d, ease = "power2.inOut") => tl.fromTo(sel, { attr: { transform: from } }, { attr: { transform: to }, duration: d, ease, immediateRender: false }, t0 + t);
            const show = (sel, t, on = 1) => tl.set(sel, { opacity: on }, t0 + t);
            const P0 = F("craft", 0, 0), P1 = F("craft", 0, 1), P2 = F("craft", 0, 2), B = F("craft", 1, 0), U = F("craft", 2, 1), U2 = F("craft", 3, 0);
            A("#cp-hl", "translate(-300,2300) rotate(90) scale(-0.62,0.62)", "translate(342,1500) rotate(90) scale(-0.62,0.62)", P0 - 0.3, 0.45, "power2.out");
            show("#cp-broom0", P0 + 0.15, 0); show("#cp-spear", P0 + 0.15, 1);
            A("#cp-spear", "translate(140,1480) rotate(-6)", "translate(120,1250) rotate(-11.5)", P0 + 0.15, 0.55);
            A("#cp-hl", "translate(342,1500) rotate(90) scale(-0.62,0.62)", held.L, P0 + 0.15, 0.55);
            A("#cp-hr", "translate(1400,2300) rotate(-90) scale(0.62,0.62)", "translate(702,1578) rotate(-62) scale(0.62,0.62)", P1 - 0.3, 0.4, "power2.out");
            show("#cp-knife0", P1 + 0.12, 0); show("#cp-knh", P1 + 0.12, 1);
            A("#cp-hr", "translate(702,1578) rotate(-62) scale(0.62,0.62)", "translate(992,1098) rotate(-101) scale(0.62,0.62)", P1 + 0.15, 0.5);
            show("#cp-knh", P1 + 0.68, 0); show("#cp-kn", P1 + 0.68, 1);
            A("#cp-spear", "translate(120,1250) rotate(-11.5)", "translate(122,1262) rotate(-12.2)", P1 + 0.68, 0.08, "power1.out"); A("#cp-spear", "translate(122,1262) rotate(-12.2)", "translate(120,1250) rotate(-11.5)", P1 + 0.76, 0.12, "power1.out");
            A("#cp-hr", "translate(992,1098) rotate(-101) scale(0.62,0.62)", "translate(942,1640) rotate(-90) scale(0.62,0.62)", P2 - 0.3, 0.3);
            show("#cp-roll0", P2 + 0.02, 0); show("#cp-rollh", P2 + 0.02, 1);
            const c = { k: 0 }, J = [963, 1079];
            tl.to(c, { k: 1, duration: 1.0, ease: "none", immediateRender: false, onUpdate: () => { const a = c.k * Math.PI * 6, g = document.getElementById("cp-hr"); if (g) g.setAttribute("transform", `translate(${(J[0] + Math.cos(a) * 95).toFixed(1)},${(J[1] + 50 + Math.sin(a) * 60).toFixed(1)}) rotate(${(-90 + Math.sin(a) * 25).toFixed(1)}) scale(0.62,0.62)`); } }, t0 + P2 + 0.05);
            [0.25, 0.55, 0.85].forEach((o, k) => tl.fromTo(`#cp-band${k}`, { opacity: 0, scaleY: 0.3 }, { opacity: 1, scaleY: 1, duration: 0.15, transformOrigin: "50% 50%", immediateRender: false }, t0 + P2 + o));
            show("#cp-rollh", P2 + 1.05, 0);
            A("#cp-hr", `translate(${J[0] + 95},${J[1] + 60}) rotate(-90) scale(0.62,0.62)`, held.R, P2 + 1.05, 0.3);
            tl.fromTo("#cp-held", { scale: 1, y: 0 }, { scale: 1.14, y: -120, duration: 0.45, ease: "power2.in", transformOrigin: "50% 100%", immediateRender: false }, t0 + B - 0.45);
            tl.to("#cp-held", { scale: 1.3, y: -260, duration: 0.12, ease: "power3.out" }, t0 + B); tl.to("#cp-held", { scale: 1.08, y: -80, duration: 0.6, ease: "elastic.out(1,.45)" }, t0 + B + 0.15);
            tl.fromTo("#cp-glint", { opacity: 0, x: -300 }, { opacity: 0.9, x: 500, duration: 0.35, ease: "power1.inOut", immediateRender: false }, t0 + B + 0.15); tl.to("#cp-glint", { opacity: 0, duration: 0.1 }, t0 + B + 0.5);
            A("#cp-hm", "translate(1700,1500) rotate(-90) scale(0.6,0.6)", "translate(1180,1080) rotate(-96) scale(0.6,0.6)", U - 0.1, 0.5, "power2.out");
            show("#cp-pipe", U2 - 0.55, 1);
            A("#cp-pipe", "translate(1300,0)", "translate(0,0)", U2 - 0.5, 0.5, "power3.in");
            A("#cp-hm", "translate(1180,1080) rotate(-96) scale(0.6,0.6)", "translate(560,1200) rotate(-96) scale(0.6,0.6)", U2 - 0.5, 0.5, "power3.in");
            tl.set("#cp-wood", { opacity: 0 }, t0 + U2);
            tl.fromTo("#cp-held", { x: 0 }, { x: -14, duration: 0.05, repeat: 5, yoyo: true, immediateRender: false }, t0 + U2);
            tl.fromTo("#cp-glint", { opacity: 0, x: -300 }, { opacity: 1, x: 560, duration: 0.3, ease: "power1.inOut", immediateRender: false }, t0 + U2 + 0.05); tl.to("#cp-glint", { opacity: 0, duration: 0.1 }, t0 + U2 + 0.35);
            A("#cp-hm", "translate(560,1200) rotate(-96) scale(0.6,0.6)", "translate(1700,1700) rotate(-90) scale(0.6,0.6)", U2 + 0.45, 0.6, "power2.in");
            Fx.speed(tl, t0 + B - 0.5, t0 + B); tl.set("#fxspeed", { opacity: 0 }, t0 + B + 0.01);
            Fx.letterbox(tl, t0 + B, t0 + B + 2.0);
            impact(tl, id, L, t0 + B, 1010, 1060, 1.1); red(tl, t0 + B, 0.5, 0.5); Fx.punch(tl, `#${id} .stage`, t0 + B, 1.08, 0.35);
            Fx.speed(tl, t0 + U2 - 0.45, t0 + U2); tl.set("#fxspeed", { opacity: 0 }, t0 + U2 + 0.01);
            impact(tl, id, L, t0 + U2, 960, 1080, 0.8); Fx.glitch(tl, `#${id}`, t0 + U2, 0.2, 8, 5); Fx.punch(tl, `#${id} .stage`, t0 + U2, 1.06, 0.35);
            document.querySelectorAll("#cp-sparks .spk").forEach((sp, k) => { const a = -0.3 - (k / 16) * 2.6, d = 140 + (k % 5) * 60;
              tl.fromTo(sp, { x: 0, y: 0, opacity: 1, scale: 1.2 }, { x: Math.cos(a) * d, y: Math.sin(a) * d + 60, opacity: 0, scale: 0.2, duration: 0.45 + (k % 3) * 0.1, ease: "power2.out", immediateRender: false }, t0 + U2 - 0.3 + (k % 4) * 0.06);
              tl.fromTo(sp, { x: 0, y: 0, opacity: 1, scale: 1.4 }, { x: Math.cos(a + 1) * d * 1.3, y: Math.sin(a + 1) * d + 80, opacity: 0, scale: 0.2, duration: 0.5, ease: "power2.out", immediateRender: false }, t0 + U2 + (k % 4) * 0.04); });
            Fx.heart(tl, t0, D("craft"), 0.7, 0.3);
          },
        });
      }

      // ---------- 7. "ด้ามไม่หักแล้ว… แต่มันดัง" — the price of every weapon ----------
      add("loud", {
        set: "schoolYard", setOpts: { id: "ld", time: "dusk", sunX: 900, level: 0.5 }, dark: 0.25, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(500, 1180, 1.15, 540, 1050), drift: { s: 0.02 } }] },
        actors: [MA(300, 1500, 0.9, [{ t: 0, mode: "point", eyes: "normal", mouth: "flat" }]), KO(640, 1500, 0.9, [{ t: 0, mode: "raise", eyes: "normal", mouth: "smile" }], { flip: true, prop: "spear1f" }), PU(460, 1500, 0.58, [{ t: 0, mode: "lookUp", eyes: "normal", mouth: "smile" }])],
        bubbles: [bub("loud", 0, 40, 520, 300)],
        ui: [{ type: "callback", t: F("loud", 0, 1), end: D("loud") - 0.05, label: "กฎของเรื่อง", text: "มันเดินตามเสียง · <em>อาวุธยิ่งแรง ยิ่งดัง</em>", top: 1300 }],
        fx(tl, id, t0) { Fx.punch(tl, `#${id} .stage`, t0 + F("loud", 0, 1), 1.05, 0.35); red(tl, t0 + F("loud", 0, 1), 0.4, 0.5); Fx.heart(tl, t0, D("loud"), 0.65, 0.35); },
      });

      // ---------- 8. the first rain in a hundred days — and in the rain they get faster ----------
      add("rain", {
        set: "schoolYard", setOpts: { id: "ra", time: "dusk", sunX: 900, level: 0.5 }, dark: 0.4, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(560, 900, 0.7, 540, 960), drift: { s: 0.015 } }, { t: vo("rain", 1) - 0.05, ...fr(1300, 1150, 1.1, 540, 1050), drift: { s: 0.03 } }] },
        actors: [PI(400, 1500, 0.9, [{ t: 0, mode: "lookUp", eyes: "normal", mouth: "o" }]), PH(640, 1500, 0.9, [{ t: 0, mode: "lookUp", eyes: "normal", mouth: "flat" }], { flip: true }), PU(520, 1500, 0.58, [{ t: 0, mode: "reachUp", eyes: "normal", mouth: "smile" }])],
        captions: caps("rain"),
        ui: [{ type: "tip", t: F("rain", 1, 0) - 0.1, end: D("rain") - 0.05, ill: "rainfast", label: "กฎของโลกนี้", text: "ฝนตก → พวกมัน{เร็วขึ้น}", tone: "danger", top: 230 }],
        extra(L) { RAIN(L, { n: 120, op: 0.55 }); },
        fx(tl, id, t0, L) {
          tl.set(`#${id} .raind, #${id} .raind2, #${id} .rsplash`, { opacity: 0 }, t0); tl.to(`#${id} .raind`, { opacity: 0.55, duration: 1.2 }, t0 + 0.4); tl.to(`#${id} .raind2`, { opacity: 0.33, duration: 1.2 }, t0 + 0.6); tl.to(`#${id} .rsplash`, { opacity: 1, duration: 0.5 }, t0 + 1.2);
          ZF(L, tl, "ra", t0, D("rain"), [["ha1", 1500, 0.8, 0], ["ha3", 1700, 0.78, 0.3]], "shamble");
          route(tl, "ra-z0", t0, [{ t: 0, x: 1500, y: 1180 }, { t: vo("rain", 1), x: 1460, y: 1180 }, { t: D("rain"), x: 1180, y: 1180 }], 0.8, true); route(tl, "ra-z1", t0, [{ t: 0, x: 1700, y: 1180 }, { t: vo("rain", 1), x: 1660, y: 1180 }, { t: D("rain"), x: 1340, y: 1180 }], 0.78, true);
          THUNDER(tl, t0 + F("rain", 0, 1), 0.5); THUNDER(tl, t0 + F("rain", 1, 1), 0.6); Fx.punch(tl, `#${id} .stage`, t0 + F("rain", 1, 1), 1.06, 0.4); red(tl, t0 + F("rain", 1, 1), 0.5, 0.6); Fx.heart(tl, t0 + vo("rain", 1), D("rain") - vo("rain", 1), 0.5, 0.5);
        },
      });

      // ---------- 9. the crying: ปั้น wakes; ก้อง takes the spear; "มันร้องเหมือนเดิมทุกครั้ง"; "นั่นไม่ใช่เด็ก" ----------
      split("cry", vo("cry", 3) - 0.1, {
        set: "classroom", setOpts: { id: "cr", night: true, lampX: 400, lampY: 1100 }, dark: 0.6, blur: { far: 4 },
        cam: { keys: [{ t: 0, ...fr(760, 1180, 1.2, 540, 1050), drift: { s: 0.02 } }, { t: vo("cry", 2) - 0.05, ...fr(400, 1150, 1.0, 540, 1050), drift: { s: 0.03 } }] },
        actors: [PU(900, 1500, 0.58, [{ t: 0, mode: "sleepSit", eyes: "closed", mouth: "flat" }, { t: vo("cry", 1) - 0.3, mode: "lookUp", eyes: "wide", mouth: "o" }]), PI(1100, 1500, 0.9, [{ t: 0, mode: "sit", eyes: "closed", mouth: "flat" }, { t: vo("cry", 1), mode: "sit", eyes: "wide", mouth: "o" }], { flip: true }),
          KO(300, 1500, 0.9, [{ t: 0, mode: "sit", eyes: "closed", mouth: "flat" }, { t: vo("cry", 1) + 0.3, mode: "idle", eyes: "wide", mouth: "o" }, { t: vo("cry", 2), mode: "guard", eyes: "wide", mouth: "o" }], { prop: "spear1f" }), HO(600, 1500, 0.9, [{ t: 0, mode: "sleepSit", eyes: "closed", mouth: "flat" }], { flip: true }), PH(-20, 1500, 0.9, [{ t: 0, mode: "listen", eyes: "normal", mouth: "flat" }])],
        captions: caps("cry", [0], { quote: true }),
        bubbles: [bub("cry", 1, 520, 520, 200), bub("cry", 2, 40, 520, 320)],
        fx(tl, id, t0) { document.querySelectorAll(`#${id} .capbox`).forEach((c) => c.classList.add("radio")); THUNDER(tl, t0 + 0.3, 0.3); Fx.heart(tl, t0, vo("cry", 3), 0.6, 0.45); Fx.punch(tl, `#${id} .stage`, t0 + vo("cry", 1), 1.04, 0.3); },
      }, {
        set: "schoolYard", setOpts: { id: "cy", time: "night", lampX: -300, gate: 0 }, dark: 0.55, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(460, 1180, 1.1, 540, 1050), drift: { s: 0.02 } }, { t: vo("cry", 4) - vo("cry", 3) + 0.05, ...fr(160, 1180, 1.3, 540, 1050), drift: { s: 0.03 } }] },
        actors: [KO(600, 1500, 0.9, [{ t: 0, mode: "walk", eyes: "wide", mouth: "o" }], { prop: "spear1", moveTo: { x: 760, dur: D("cry") - vo("cry", 3) + 0.1, ease: "none" } }), PI(380, 1500, 0.9, [{ t: 0, mode: "stopHand", eyes: "wide", mouth: "o" }]), PH(120, 1500, 0.9, [{ t: 0, mode: "listen", eyes: "normal", mouth: "flat" }, { t: vo("cry", 4) - vo("cry", 3) + 0.1, mode: "stopHand", eyes: "normal", mouth: "flat" }])],
        captions: capsFrom("cry", vo("cry", 3) - 0.1, [5]),
        bubbles: [bub("cry", 3, 40, 520, 380), bub("cry", 4, 40, 520, 120)].map((b, i) => ({ ...b, t: i ? vo("cry", 4) - vo("cry", 3) + 0.05 : 0.05, end: b.end - (vo("cry", 3) - 0.1) })),
        extra(L) { RAIN(L, { n: 120, op: 0.5 }); put(L.mid, `<g id="cy-lurelt" opacity="0"><circle cx="1500" cy="1060" r="5" fill="#ff5a4a"/><circle cx="1500" cy="1060" r="22" fill="#ff5a4a" opacity=".25"/></g>`); },
        fx(tl, id, t0) { const X = t0 + F("cry", 5, 1) - (vo("cry", 3) - 0.1); for (let t = 0; t < D("cry") - vo("cry", 3); t += 0.9) { tl.set("#cy-lurelt", { opacity: 1 }, t0 + t); tl.set("#cy-lurelt", { opacity: 0 }, t0 + t + 0.15); } Fx.punch(tl, `#${id} .stage`, t0 + F("cry", 4, 1) - (vo("cry", 3) - 0.1), 1.06, 0.4); red(tl, t0 + F("cry", 4, 1) - (vo("cry", 3) - 0.1), 0.5, 0.6); Fx.punch(tl, `#${id} .stage`, X, 1.05, 0.35); Fx.glitch(tl, `#${id}`, X, 0.15, 8, 21); Fx.heart(tl, t0, D("cry") - vo("cry", 3) + 0.1, 0.45, 0.6); },
      });

      // ---------- 10. the gate opened a hand's width — the crying stops; then they come running in the rain ----------
      add("peek", {
        set: "schoolYard", setOpts: { id: "pe", time: "night", lampX: -300, gate: 0.12 }, dark: 0.55, blur: { far: 2 },
        cam: { keys: [{ t: 0, ...fr(820, 1180, 1.25, 540, 1050), drift: { s: 0.02 } }, { t: vo("peek", 1) - 0.05, ...fr(1000, 1100, 1.0, 540, 1000), drift: { s: 0.04 } }] },
        shake: (t) => (t > vo("peek", 1) ? 4 * Math.sin(t * 19) : 0),
        actors: [KO(700, 1500, 0.9, [{ t: 0, mode: "push", eyes: "wide", mouth: "o" }, { t: vo("peek", 1), mode: "guard", eyes: "wide", mouth: "scream" }], { prop: "spear1f" })],
        captions: caps("peek"),
        extra(L) { RAIN(L, { n: 120, op: 0.5 }); },
        fx(tl, id, t0, L) {
          ZF(L, tl, "pe", t0, D("peek"), [["ha1", 1900, 0.8, 0], ["ha2", 2060, 0.76, 0.4], ["ha3", 2200, 0.78, 0.2], ["ha1", 2380, 0.74, 0.7], ["ha2", 2520, 0.7, 0.9], ["ha3", 1760, 0.72, 0.5]], "zrun");
          [0, 1, 2, 3, 4, 5].forEach((k) => route(tl, `pe-z${k}`, t0, [{ t: 0, x: [1900, 2060, 2200, 2380, 2520, 1760][k], y: 1180 }, { t: vo("peek", 1) - 0.2, x: [1900, 2060, 2200, 2380, 2520, 1760][k], y: 1180 }, { t: D("peek"), x: [1180, 1300, 1420, 1560, 1700, 1100][k], y: 1180 }], [0.8, 0.76, 0.78, 0.74, 0.7, 0.72][k], true));
          THUNDER(tl, t0 + F("peek", 1, 0) + 0.1, 0.7); Fx.punch(tl, `#${id} .stage`, t0 + F("peek", 0, 1), 1.04, 0.3); Fx.punch(tl, `#${id} .stage`, t0 + F("peek", 1, 1), 1.07, 0.4); red(tl, t0 + F("peek", 1, 1), 0.6, 0.6); Fx.heart(tl, t0 + F("peek", 0, 1), D("peek") - F("peek", 0, 1), 0.4, 0.7);
        },
      });

      // ---------- 11. the card: a child's crying is a human trap ----------
      add("trap", {
        set: "schoolYard", setOpts: { id: "tp", time: "night", lampX: -300, gate: 0.12 }, dark: 0.6, blur: { far: 4, set: 2 },
        cam: { keys: [{ t: 0, ...fr(1300, 1050, 1.5, 540, 1000), drift: { s: 0.03 } }] },
        captions: caps("trap"),
        ui: [{ type: "tip", t: 0.2, end: D("trap") - 0.05, ill: "trap", label: "กับดักของคน", text: "เสียงเด็กร้อง → เปิดประตู → {ฝูงตามเข้ามา}", tone: "danger", top: 230 }],
        extra(L) { RAIN(L, { n: 100, op: 0.5 }); put(L.set, LUREBOX("tp-box", 1346, 900, 1.0)); },
        fx(tl, id, t0) { for (let t = 0.2; t < D("trap"); t += 0.9) { tl.set("#tp-box .lurelt", { opacity: 1 }, t0 + t); tl.set("#tp-box .lurelt", { opacity: 0.2 }, t0 + t + 0.15); } Fx.punch(tl, `#${id} .stage`, t0 + F("trap", 0, 1), 1.06, 0.4); Fx.glitch(tl, `#${id}`, t0 + F("trap", 0, 1), 0.2, 10, 31); red(tl, t0 + F("trap", 0, 1), 0.5, 0.6); Fx.heart(tl, t0, D("trap"), 0.45, 0.6); },
      });

      // ---------- 12. twenty of them on the wet ground: the section goes over in ten seconds; the lunge through it (POV) ----------
      split("fenceFall", D("fenceFall") - 1.0, {
        set: "schoolYard", setOpts: { id: "ff", time: "night", lampX: -300, gate: 0.12, breakAt: 1100 }, dark: 0.55, blur: { far: 2 },
        cam: { keys: [{ t: 0, ...fr(1150, 1100, 1.0, 540, 1000), drift: { s: 0.03 } }, { t: F("fenceFall", 1, 0) - 0.05, ...fr(1100, 1150, 0.9, 540, 1050), r: -3, drift: { s: 0.05, r: 4 } }] },
        shake: (t) => (t > F("fenceFall", 1, 0) ? 10 * Math.sin(t * 25) : 4 * Math.sin(t * 13)),
        actors: [KO(700, 1500, 0.9, [{ t: 0, mode: "guard", eyes: "wide", mouth: "scream" }, { t: F("fenceFall", 1, 0), mode: "run", eyes: "wide", mouth: "scream" }], { prop: "spear1f", flip: true, moveTo: { x: 100, at: F("fenceFall", 1, 0), dur: 1.4 } })],
        captions: capsFrom("fenceFall", 0).filter((c) => c.t < D("fenceFall") - 1.1),
        extra(L) { RAIN(L, { n: 120, op: 0.5 }); },
        fx(tl, id, t0, L) {
          ZF(L, tl, "ff", t0, D("fenceFall") - 1.0, [["ha1", 1200, 0.8, 0], ["ha2", 1300, 0.76, 0.4], ["ha3", 1400, 0.78, 0.2], ["ha1", 1240, 0.74, 0.7], ["ha2", 1360, 0.7, 0.9], ["ha3", 1150, 0.72, 0.5], ["ha1", 1320, 0.77, 0.1]]);
          const Tf = t0 + F("fenceFall", 1, 0);
          tl.fromTo("#ff-fseg", { attr: { transform: "rotate(0 1330 1184)" } }, { attr: { transform: "rotate(-6 1330 1184)" }, duration: 0.08, repeat: 9, yoyo: true, ease: "sine.inOut", immediateRender: false }, Tf - 1.6);
          tl.to("#ff-fseg", { attr: { transform: "rotate(-82 1330 1184)" }, duration: 0.55, ease: "power3.in" }, Tf);
          impact(tl, id, L, Tf + 0.55, 1150, 1180, 1.1); red(tl, Tf + 0.55, 0.8, 0.5); Fx.glitch(tl, `#${id}`, Tf + 0.55, 0.25, 14, 41); THUNDER(tl, Tf + 0.6, 0.6);
          [0, 1, 2, 3, 4, 5, 6].forEach((k) => route(tl, `ff-z${k}`, t0, [{ t: F("fenceFall", 1, 0) + 0.5, x: [1200, 1300, 1400, 1240, 1360, 1150, 1320][k], y: 1180 }, { t: D("fenceFall") - 1.0, x: [900, 1000, 1100, 940, 1060, 850, 1020][k] - 250, y: 1180 }], [0.8, 0.76, 0.78, 0.74, 0.7, 0.72, 0.77][k], true));
          Fx.heart(tl, t0, D("fenceFall") - 1.0, 0.36, 0.8);
        },
      }, {   // first person: one of them over the fallen bars, into the lens
        set: "schoolYard", setOpts: { id: "fz", time: "night", lampX: -300, breakAt: 1100, fallen: true }, dark: 0.5, blur: { far: 6, mid: 4 },
        cam: { keys: [{ t: 0, ...fr(1100, 1200, 1.1, 540, 960), drift: { s: 0.1 } }] },
        shake: (t) => 10 * Math.sin(t * 27),
        extra(L) { RAIN(L, { n: 80, op: 0.4 }); put(L.act, Zom.zLunge("fz-z", 1100, 1250, 0.55).replace(/#b9c4d6/g, "#5a6a4a").replace(/#7b8aa6/g, "#3c4a30").replace(/#97a3b8/g, "#d9c9a0")); },
        fx(tl, id, t0) {
          tl.set("#fz-z", { opacity: 1 }, t0);
          tl.fromTo("#fz-z", { attr: { transform: "translate(1100,1350) scale(0.5)" } }, { attr: { transform: "translate(1100,1250) scale(1.25)" }, duration: 1.0, ease: "power3.in", immediateRender: false }, t0);
          Fx.tunnel(tl, t0, t0 + 1.2, 0.6); red(tl, t0 + 0.75, 0.8, 0.4); Fx.heart(tl, t0, 1.0, 0.3, 0.9);
          tl.fromTo("#flashw", { opacity: 0.6 }, { opacity: 0, duration: 0.1, immediateRender: false }, t0 + 0.9);
        },
      });

      // ---------- 13. "วิ่ง เข้าตึก ประตูหลัง" — ก้อง goes down on the rebar ----------
      add("flee", {
        set: "schoolYard", setOpts: { id: "fl", time: "night", lampX: -300, breakAt: 1100, fallen: true }, dark: 0.55, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(700, 1150, 0.95, 540, 1050), r: 2, drift: { s: 0.06, r: -3, x: -80 } }, { t: vo("flee", 1) - 0.05, ...fr(820, 1250, 1.3, 540, 1100), drift: { s: 0.04 } }] },
        shake: (t) => 7 * Math.sin(t * 19),
        actors: [PI(400, 1500, 0.9, [{ t: 0, mode: "run", eyes: "wide", mouth: "scream" }], { flip: true, moveTo: { x: -300, dur: D("flee"), ease: "power1.in" } }), PU(520, 1500, 0.58, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }], { flip: true, moveTo: { x: -200, dur: D("flee"), ease: "power1.in" } }),
          HO(300, 1500, 0.9, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }], { flip: true, moveTo: { x: -400, dur: D("flee"), ease: "power1.in" } }), PH(640, 1500, 0.9, [{ t: 0, mode: "run", eyes: "wide", mouth: "flat" }], { flip: true, moveTo: { x: -100, dur: D("flee"), ease: "power1.in" } }),
          KO(900, 1500, 0.9, [{ t: 0, mode: "run", eyes: "wide", mouth: "scream" }, { t: vo("flee", 1) - 0.1, mode: "fall", eyes: "closed", mouth: "scream" }, { t: vo("flee", 1) + 0.5, mode: "sitLeg", eyes: "pain", mouth: "scream" }], { prop: "spear1", flip: true, moveTo: { x: 820, dur: vo("flee", 1) - 0.1, ease: "none" } }),
          MA(1050, 1500, 0.9, [{ t: 0, mode: "run", eyes: "wide", mouth: "frown" }, { t: vo("flee", 1) + 0.3, mode: "crouch", eyes: "wide", mouth: "frown" }], { flip: true, moveTo: { x: 960, dur: vo("flee", 1) + 0.3, ease: "none" } })],
        captions: caps("flee", [1]),
        bubbles: [bub("flee", 0, 40, 520, 240)],
        extra(L) { RAIN(L, { n: 120, op: 0.5 }); put(L.act, `<g id="fl-rebar" transform="translate(900,1470) rotate(-30)"><rect x="-10" y="-200" width="18" height="220" fill="#3f454b" stroke="#2e2a26" stroke-width="3"/><path d="M-6,-200l10,-30" stroke="#9a5a2a" stroke-width="6"/></g><g id="fl-blood" opacity="0"><ellipse cx="840" cy="1490" rx="50" ry="12" fill="#7a1414" opacity=".8"/></g>`); },
        fx(tl, id, t0, L) { ZF(L, tl, "fl", t0, D("flee"), [["ha1", 1000, 0.8, 0], ["ha2", 1120, 0.76, 0.4], ["ha3", 1240, 0.78, 0.2], ["ha1", 1060, 0.74, 0.7]], "zrun"); [0, 1, 2, 3].forEach((k) => route(tl, `fl-z${k}`, t0, [{ t: 0, x: [1000, 1120, 1240, 1060][k], y: 1180 }, { t: D("flee"), x: [700, 820, 940, 760][k], y: 1180 }], [0.8, 0.76, 0.78, 0.74][k], true));
          impact(tl, id, L, t0 + vo("flee", 1), 880, 1420, 0.8); red(tl, t0 + vo("flee", 1), 0.8, 0.5); tl.fromTo("#fl-blood", { opacity: 0 }, { opacity: 1, duration: 0.3, immediateRender: false }, t0 + vo("flee", 1) + 0.3); Fx.speed(tl, t0, t0 + vo("flee", 1)); Fx.heart(tl, t0, D("flee"), 0.33, 0.85); },
      });

      // ---------- 14. "ไปก่อน ลุงกันให้" — "ยี่สิบวินาทีนะลุง ครบแล้วปิดประตู" ----------
      add("cover", {
        set: "schoolYard", setOpts: { id: "cv", time: "night", lampX: -300, breakAt: 1100, fallen: true }, dark: 0.55, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(860, 1200, 1.2, 540, 1050), drift: { s: 0.03 } }, { t: voEnd("cover", 0) - 0.1, ...fr(100, 1200, 1.2, 540, 1050), drift: { s: 0.03 } }] },
        shake: (t) => 4 * Math.sin(t * 17),
        actors: [MA(960, 1500, 0.9, [{ t: 0, mode: "grabArm", eyes: "wide", mouth: "frown" }, { t: 0.8, mode: "thrust", eyes: "wide", mouth: "scream" }], { flip: false, prop: "spear1f" }), KO(820, 1500, 0.9, [{ t: 0, mode: "sitLeg", eyes: "pain", mouth: "frown" }, { t: 0.8, mode: "limpRun", eyes: "pain", mouth: "frown" }], { flip: true, moveTo: { x: -200, at: 0.8, dur: D("cover") - 0.8, ease: "power1.in" } }),
          PH(300, 1500, 0.9, [{ t: 0, mode: "reach", eyes: "normal", mouth: "flat" }], { moveTo: { x: 0, dur: D("cover") } }), PI(-60, 1500, 0.9, [{ t: 0, mode: "guard", eyes: "wide", mouth: "frown" }, { t: voEnd("cover", 0), mode: "stopHand", eyes: "wide", mouth: "o" }])],
        bubbles: [bub("cover", 0, 420, 520, 300)],
        extra(L) { RAIN(L, { n: 120, op: 0.5 }); },
        fx(tl, id, t0, L) { ZF(L, tl, "cv", t0, D("cover"), [["ha1", 1300, 0.8, 0], ["ha2", 1420, 0.76, 0.4], ["ha3", 1540, 0.78, 0.2], ["ha1", 1380, 0.74, 0.7], ["ha2", 1480, 0.7, 0.9]], "zrun"); [0, 1, 2, 3, 4].forEach((k) => route(tl, `cv-z${k}`, t0, [{ t: 0, x: [1300, 1420, 1540, 1380, 1480][k], y: 1180 }, { t: 1.2, x: [1120, 1200, 1280, 1160, 1240][k], y: 1180 }], [0.8, 0.76, 0.78, 0.74, 0.7][k], true)); Fx.punch(tl, `#${id} .stage`, t0 + voEnd("cover", 0) - 0.1, 1.05, 0.35); red(tl, t0 + voEnd("cover", 0) + 0.2, 0.5, 0.5); Fx.heart(tl, t0, D("cover"), 0.4, 0.7); },
      });

      // ---------- 15. twenty seconds: he holds the breach with the spear; last time he made it on two — this time it rains ----------
      add("count", {
        set: "schoolYard", setOpts: { id: "cd", time: "night", lampX: -300, breakAt: 1100, fallen: true }, dark: 0.55, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(1000, 1200, 1.1, 540, 1050), drift: { s: 0.03 } }, { t: 3.0, ...fr(1150, 1250, 1.35, 540, 1100), r: -2, drift: { s: 0.04, r: 3 } }, { t: 5.2, glide: 0.8, ...fr(700, 1150, 0.85, 540, 1050), drift: { s: 0.03 } }, { t: D("count"), glide: 2.4, ...fr(1100, 1250, 1.4, 540, 1100) }] },
        shake: (t) => 5 * Math.sin(t * 21),
        actors: [MA(1000, 1500, 0.9, [{ t: 0, mode: "thrust", eyes: "wide", mouth: "scream" }, { t: 5.0, mode: "brace", eyes: "wide", mouth: "frown" }], { prop: "spear1f" })],
        captions: caps("count"),
        ui: [{ type: "countdown", t: 0.2, from: 20, to: 6, tick: 0.55, label: "ประตูหลังปิดใน", warn: 5, end: D("count") - 0.1, top: 60 }],
        extra(L) { RAIN(L, { n: 120, op: 0.5 }); },
        fx(tl, id, t0, L) {
          ZF(L, tl, "cd", t0, D("count"), [["ha1", 1180, 0.8, 0], ["ha2", 1280, 0.76, 0.4], ["ha3", 1380, 0.78, 0.2], ["ha1", 1230, 0.74, 0.7], ["ha2", 1330, 0.7, 0.9], ["ha3", 1430, 0.72, 0.5]]);
          route(tl, `${id}-a0`, t0, [{ t: 0, x: 1000, y: 1500 }, { t: 3.0, x: 1060, y: 1500 }, { t: 5.0, x: 1100, y: 1480 }, { t: D("count"), x: 1100, y: 1480 }], 0.9, false);
          [1.0, 2.2, 3.4, 4.6].forEach((t) => { impact(tl, id, L, t0 + t, 1180, 1250, 0.6); red(tl, t0 + t, 0.3, 0.3); });
          THUNDER(tl, t0 + 5.2, 0.5); THUNDER(tl, t0 + 7.4, 0.6);
          Fx.punch(tl, `#${id} .stage`, t0 + F("count", 1, 2), 1.06, 0.4); red(tl, t0 + F("count", 1, 2), 0.6, 0.6); Fx.glitch(tl, `#${id}`, t0 + F("count", 1, 2), 0.2, 10, 51);
          Fx.heart(tl, t0 + 0.2, D("count") - 0.2, 0.55, 0.55);
        },
      });

      // ---------- 16. the last five: the back door from inside; through the gap he is far away, braced; "ปิดซะ ครู"; 0 = the bar ----------
      add("count2", {
        set: "backDoor", setOpts: { id: "bd", open: 0.3 }, dark: 0.5, blur: { far: 3, mid: 2 },
        cam: { keys: [{ t: 0, ...fr(540, 1000, 0.9, 540, 1000), drift: { s: 0.03 } }, { t: 2.0, glide: 0.6, ...fr(540, 1000, 1.1, 540, 1000), drift: { s: 0.04 } }] },
        shake: (t) => (t < 2.5 ? 6 * Math.sin(t * 21) : 0),
        actors: [PH(160, 1560, 0.95, [{ t: 0, mode: "push", eyes: "normal", mouth: "flat" }]), PI(920, 1560, 0.95, [{ t: 0, mode: "guard", eyes: "wide", mouth: "frown" }, { t: 2.4, mode: "push", eyes: "wide", mouth: "frown" }], { flip: true })],
        captions: caps("count2", [0], { quote: true }),
        ui: [{ type: "countdown", t: 0.0, from: 5, to: 0, tick: 0.5, label: "ประตูหลังปิดใน", warn: 5, end: 3.1, top: 60 }],
        extra(L) { RAIN(L, { n: 60, op: 0.4, splash: false }); },
        fx(tl, id, t0, L) {
          behind(L, tl, "bd-man", "man", 540, 1180, 0.7, false, t0, D("count2"), [{ t: 0, mode: "brace", eyes: "normal", mouth: "frown" }]);
          Camp.attach && Camp.attach("bd-man", "spear1f");
          ZF(L, tl, "bd", t0, D("count2"), [["ha1", 700, 0.5, 0], ["ha2", 440, 0.48, 0.4], ["ha3", 780, 0.5, 0.2]], "shamble");
          document.querySelectorAll(`#${id} .capbox`).forEach((c) => c.classList.add("radio"));
          tl.fromTo("#bd-dl", { attr: { transform: "translate(300,0) scale(0.3,1)" } }, { attr: { transform: "translate(300,0) scale(1,1)" }, duration: 0.4, ease: "power3.in", immediateRender: false }, t0 + 2.05);
          tl.fromTo("#bd-dr", { attr: { transform: "translate(780,0) scale(-0.3,1)" } }, { attr: { transform: "translate(780,0) scale(-1,1)" }, duration: 0.4, ease: "power3.in", immediateRender: false }, t0 + 2.05);
          tl.set("#bd-bar", { opacity: 1 }, t0 + 2.45); tl.fromTo("#bd-bar", { attr: { transform: "translate(0,-500)" } }, { attr: { transform: "translate(0,0)" }, duration: 0.2, ease: "power3.in", immediateRender: false }, t0 + 2.45);
          Fx.heart(tl, t0, 2.5, 0.3, 0.85);
          tl.fromTo("#flashw", { opacity: 0.9 }, { opacity: 0, duration: 0.2, immediateRender: false }, t0 + 2.55); tl.set("#black", { opacity: 1 }, t0 + 2.65);
        },
      });

      // ---------- 17. black; the corridor: the door shut on time — five of them inside ----------
      add("after", {
        set: "backDoor", setOpts: { id: "af", closed: true, barred: true }, dark: 0.7, blur: { far: 4, set: 2 },
        cam: { keys: [{ t: 0, ...fr(540, 1150, 1.0, 540, 1050), drift: { s: 0.02 } }] },
        actors: [PH(160, 1560, 0.95, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }]), PI(900, 1560, 0.95, [{ t: 0, mode: "holdHead", eyes: "closed", mouth: "frown" }], { flip: true }), KO(560, 1560, 0.95, [{ t: 0, mode: "sitLeg", eyes: "pain", mouth: "frown" }], { prop: "spear1" }), HO(-80, 1560, 0.95, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }]), PU(1120, 1560, 0.6, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }], { flip: true })],
        captions: caps("after"),
        fx(tl, id, t0) { tl.set("#black", { opacity: 1 }, t0); tl.to("#black", { opacity: 0, duration: 0.6 }, t0 + 0.5); [0.15, 0.4, 0.9].forEach((t) => tl.fromTo(`#${id} .stage`, { x: 0 }, { x: 10, duration: 0.05, repeat: 3, yoyo: true, immediateRender: false }, t0 + t)); Fx.punch(tl, `#${id} .stage`, t0 + F("after", 0, 1), 1.05, 0.4); red(tl, t0 + F("after", 0, 1), 0.4, 0.6); Fx.heart(tl, t0, D("after"), 0.6, 0.4); },
      });

      // ---------- 18. the tourniquet: the belt over the trouser leg above the wound, the stick twisted till it stops, the time on his arm ----------
      add("tq", {
        set: "woundClose", setOpts: { id: "tq", time: "night" }, dark: 0.45, blur: { far: 2 },
        cam: { keys: [{ t: 0, ...fr(480, 1000, 1.1, 540, 960), drift: { s: 0.02 } }, { t: vo("tq", 1) - 0.05, glide: 0.5, ...fr(300, 900, 1.35, 540, 900), drift: { s: 0.03 } }, { t: vo("tq", 3) - 0.05, glide: 0.5, ...fr(500, 1000, 1.1, 540, 960), drift: { s: 0.02 } }] },
        captions: CLIP([...caps("tq", [0]), ...caps("tq", [2]), ...caps("tq", [3])]),
        bubbles: [bub("tq", 1, 60, 300, 400)],
        ui: [{ type: "tip", t: vo("tq", 2) - 0.1, end: D("tq") - 0.05, ill: "tq", label: "ขันชะเนาะ · MedlinePlus", text: "เหนือแผล [5–7 ซม.] · เลี่ยงข้อ · {จดเวลา}", tone: "warn", top: 230 },
          { type: "src", t: vo("tq", 3), end: D("tq") - 0.05, top: 600, text: MLP + "“The tourniquet should be applied to the limb 2 to 3 in (5 to 7.7 cm) above the bleeding wound. Avoid the joint… always write down the time when the tourniquet was applied.”" }],
        extra(L) {
          // the trouser leg is ก้อง's (blue denim), the gash near the shin, the blood soaking down; the belt + stick above it
          document.querySelectorAll("#tq-flap path, #tq-skin path").forEach(() => {});
          put(L.set, `<g transform="rotate(-18 540 1000)"><g id="tq-soak"><path d="M160,1000Q360,1060 600,1020L640,1240L160,1240Z" fill="#5a0f0f" opacity=".55"/></g>
            <g id="tq-belt" opacity="0"><rect x="-20" y="760" width="420" height="70" rx="10" fill="#3a2e22" stroke="#2e2a26" stroke-width="4" transform="rotate(8 190 795)"/><rect x="150" y="740" width="90" height="110" rx="8" fill="#8d9299" stroke="#2e2a26" stroke-width="4" transform="rotate(8 190 795)"/></g>
            <g id="tq-stick" opacity="0" transform="rotate(0 195 795)"><rect x="100" y="770" width="200" height="34" rx="10" fill="#c9955c" stroke="#2e2a26" stroke-width="4"/></g>
            <g id="tq-time" opacity="0"><rect x="-300" y="500" width="300" height="130" rx="20" fill="#d6a27c" stroke="#2e2a26" stroke-width="4"/><text x="-150" y="590" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="78" fill="#1f1d1a">22:40</text></g></g>`);
          put(L.act, `<g id="tq-hand" transform="translate(900,1500) rotate(-30) scale(0.7)">${Hand.grip(SKIN_PHU)}</g>`);
        },
        fx(tl, id, t0) {
          const Tb = t0 + vo("tq", 1) + 0.2, Tt = t0 + F("tq", 2, 2) + 0.1;
          tl.to("#tq-soak", { opacity: 1, duration: 1.0 }, t0 + 0.2);
          tl.to("#tq-hand", { attr: { transform: "translate(520,1060) rotate(-60) scale(0.7)" }, duration: 0.5, ease: "power2.out" }, Tb - 0.4);
          tl.fromTo("#tq-belt", { opacity: 0 }, { opacity: 1, duration: 0.15, immediateRender: false }, Tb); tl.fromTo("#tq-stick", { opacity: 0 }, { opacity: 1, duration: 0.15, immediateRender: false }, Tb + 0.4);
          for (let k = 0; k < 6; k++) tl.to("#tq-stick", { attr: { transform: `rotate(${(k + 1) * 60} 195 795)` }, duration: 0.25, ease: "power1.inOut" }, Tb + 0.6 + k * 0.28);
          for (let k = 0; k < 6; k++) tl.to("#tq-hand", { attr: { transform: `translate(${520 + 30 * Math.cos(k)},${1060 + 30 * Math.sin(k)}) rotate(-60) scale(0.7)` }, duration: 0.28, ease: "power1.inOut" }, Tb + 0.6 + k * 0.28);
          tl.to("#tq-soak", { opacity: 0.55, duration: 1.2 }, Tb + 1.6);
          tl.to("#tq-hand", { attr: { transform: "translate(-200,900) rotate(-20) scale(0.7)" }, duration: 0.5, ease: "power2.inOut" }, Tt - 0.5);
          tl.fromTo("#tq-time", { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2)", svgOrigin: "-150 565", immediateRender: false }, Tt);
          Fx.punch(tl, `#${id} .stage`, t0 + F("tq", 0, 2), 1.05, 0.35); red(tl, t0 + F("tq", 0, 2), 0.5, 0.5); Fx.punch(tl, `#${id} .stage`, Tt, 1.04, 0.3); Fx.heart(tl, t0, D("tq"), 0.55, 0.45);
        },
      });

      // ---------- 19. in real life: a tourniquet is for when pressure fails — and get to a doctor fast ----------
      add("real", {
        set: "backDoor", setOpts: { id: "rl", closed: true, barred: true }, dark: 0.65, blur: { far: 4, set: 2 },
        cam: { keys: [{ t: 0, ...fr(540, 1150, 1.0, 540, 1050), drift: { s: 0.02 } }] },
        actors: [PH(300, 1560, 0.95, [{ t: 0, mode: "kneelAid", eyes: "normal", mouth: "flat" }]), KO(560, 1560, 0.95, [{ t: 0, mode: "sitLeg", eyes: "normal", mouth: "frown" }]), PI(900, 1560, 0.95, [{ t: 0, mode: "crouch", eyes: "normal", mouth: "frown" }], { flip: true })],
        captions: caps("real"),
        ui: [{ type: "tip", t: F("real", 0, 1) - 0.1, end: D("real") - 0.05, ill: "press", label: "ในชีวิตจริง", text: "กดก่อน → ไม่หยุด = ขันชะเนาะ → {หาหมอ}", tone: "rule", top: 230 },
          { type: "src", t: F("real", 0, 1) + 0.3, end: D("real") - 0.05, top: 600, text: MLP + "“If continuous pressure has not stopped the bleeding, and bleeding is extremely severe (life threatening), a tourniquet can be used until medical help arrives.”" }],
        fx(tl, id, t0) { Fx.punch(tl, `#${id} .stage`, t0 + F("real", 0, 2), 1.05, 0.3); Fx.heart(tl, t0, D("real"), 0.7, 0.3); },
      });

      // ---------- channel signature ----------
      add("sig", {
        set: "schoolYard", setOpts: { id: "sgn", time: "night", lampX: -300, breakAt: 1100, fallen: true }, dark: 0.55, blur: { far: 10, set: 8, mid: 8 },
        cam: { keys: Sig.cam(F, fr(560, 1100, 0.9, 540, 960)) }, shake: Sig.shake(F),
        captions: caps("sig"),
        ui: [Sig.ui(F, "เหลือ 96 วัน · เช็กลิสต์เอาตัวรอด", [["ประกอบอาวุธก่อนมืด", true], ["ขันชะเนาะเหนือแผล", true], ["ปิดประตูหลังตรงเวลา", true], ["???", false]], D("sig"))],
        fx(tl, id, t0) { Sig.fx(tl, id, t0, F, D("sig")); },
      });

      // ---------- 20. the radio: "เก้าสิบห้าวัน… ห้า" — nobody speaks ----------
      split("radio", vo("radio", 1) - 0.1, {
        set: "radioClose", setOpts: { id: "ra2" }, dark: 0.55,
        cam: { keys: [{ t: 0, ...fr(540, 1000, 1.0, 540, 960), drift: { s: 0.02 } }, { t: vo("radio", 0) - 0.3, ...fr(400, 900, 1.5, 540, 960), drift: { s: 0.03 } }] },
        captions: caps("radio", [0], { quote: true }),
        ui: [{ type: "tearCal", t: vo("radio", 0) - 0.4, end: vo("radio", 1) - 0.2, top: 150, label: "เหลือ", unit: "วัน", keys: [{ t: vo("radio", 0) - 0.4, v: 96 }, { t: F("radio", 0, 1), v: 95 }], tag: { t: F("radio", 0, 2), text: "· ห้า" } }],
        fx(tl, id, t0) {
          const on = t0 + vo("radio", 0) - 0.4;
          tl.fromTo(["#ra2-dialw", "#ra2-glow"], { opacity: 0 }, { opacity: 1, duration: 0.05, repeat: 5, yoyo: true, immediateRender: false }, on); tl.set(["#ra2-dialw", "#ra2-glow"], { opacity: 1 }, on + 0.3);
          tl.fromTo("#ra2-needle", { x: 0 }, { x: 180, duration: 0.6, ease: "power1.inOut", immediateRender: false }, on + 0.1);
          for (let t = on + 0.7; t < t0 + vo("radio", 1); t += 0.11) tl.set("#ra2-needle", { x: 180 + ((t * 977) % 9) - 4 }, t);
          document.querySelectorAll(`#${id} .capbox`).forEach((c) => c.classList.add("radio"));
          Fx.punch(tl, `#${id} .stage`, t0 + F("radio", 0, 2), 1.08, 0.5); Fx.glitch(tl, `#${id}`, t0 + F("radio", 0, 2), 0.2, 10, 71); red(tl, t0 + F("radio", 0, 2), 0.6, 0.7);
          Fx.heart(tl, t0 + vo("radio", 0), vo("radio", 1) - vo("radio", 0), 0.5, 0.5);
        },
      }, {
        set: "backDoor", setOpts: { id: "rb", closed: true, barred: true }, dark: 0.7, blur: { far: 4 },
        cam: { keys: [{ t: 0, ...fr(540, 1150, 1.0, 540, 1050), drift: { s: 0.03 } }] },
        actors: [PH(160, 1560, 0.95, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }]), PI(900, 1560, 0.95, [{ t: 0, mode: "holdHead", eyes: "closed", mouth: "frown" }], { flip: true }), KO(560, 1560, 0.95, [{ t: 0, mode: "sitLeg", eyes: "normal", mouth: "frown" }], { prop: "spear1" }), HO(-80, 1560, 0.95, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }]), PU(1120, 1560, 0.6, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }], { flip: true })],
        captions: capsFrom("radio", vo("radio", 1) - 0.1, [1]),
        ui: [{ type: "counter", t: 0.05, end: D("radio") - (vo("radio", 1) - 0.1) - 0.05, label: "คนในค่าย", icon: "people", unit: "คน", max: 6, keys: [{ t: 0, v: 6 }, { t: F("radio", 1, 1) - (vo("radio", 1) - 0.1), v: 5 }], alarm: F("radio", 1, 1) - (vo("radio", 1) - 0.1), top: 150 }],
        fx(tl, id, t0) { const X = t0 + F("radio", 1, 1) - (vo("radio", 1) - 0.1); Fx.punch(tl, `#${id} .stage`, X, 1.06, 0.4); red(tl, X, 0.5, 0.6); Fx.heart(tl, t0, D("radio") - (vo("radio", 1) - 0.1), 0.6, 0.4); },
      });

      // ---------- 21. the ledger: the spear is ก้อง's now ----------
      add("ledger", {
        set: "backDoor", setOpts: { id: "lg", closed: true, barred: true }, dark: 0.65, blur: { far: 4 },
        cam: { keys: [{ t: 0, ...fr(300, 1200, 1.2, 540, 1050), drift: { s: 0.02 } }] },
        actors: [HO(-40, 1560, 0.95, [{ t: 0, mode: "write", eyes: "normal", mouth: "frown" }], { prop: "ledger" }), KO(460, 1560, 0.95, [{ t: 0, mode: "sitLeg", eyes: "normal", mouth: "frown" }, { t: 1.0, mode: "sitHold", eyes: "normal", mouth: "flat" }], { prop: "spear1" })],
        bubbles: [bub("ledger", 0, 40, 520, 160)],
        ui: [{ type: "counter", t: 0.2, end: D("ledger") - 0.05, label: "อาวุธของค่าย", icon: "spear", unit: "ชิ้น", max: 3, sub: "หอกมีด +1 · ของก้อง", keys: [{ t: 0.2, v: 1 }], top: 150, right: true }],
        fx(tl, id, t0) { Fx.heart(tl, t0, D("ledger"), 0.7, 0.3); },
      });

      // ---------- 22. first light: ภู alone at the fallen fence; he takes the little box off the post and puts it in his bag ----------
      add("dawn", {
        set: "schoolYard", setOpts: { id: "dn", time: "morning", level: 0.5, breakAt: 1100, fallen: true }, dark: 0.3, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(800, 1100, 0.8, 540, 1000), drift: { s: 0.015 } }, { t: vo("dawn", 1) - 0.05, glide: 0.8, ...fr(1160, 1200, 1.45, 540, 1050), drift: { s: 0.03 } }] },
        actors: [PH(700, 1500, 0.9, [{ t: 0, mode: "walk", eyes: "normal", mouth: "flat" }, { t: vo("dawn", 1), mode: "reach", eyes: "normal", mouth: "flat" }, { t: vo("dawn", 1) + 1.2, mode: "idle", eyes: "normal", mouth: "flat" }], { prop: "bag", moveTo: { x: 1040, dur: vo("dawn", 1), ease: "none" } })],
        captions: caps("dawn"),
        extra(L) { put(L.set, LUREBOX("dn-box", 1120, 1100, 1.0)); },
        fx(tl, id, t0) { const T = t0 + vo("dawn", 1) + 0.6; tl.to("#dn-box", { attr: { transform: "translate(1120,1100) scale(1.0)" }, duration: 0.01 }, T - 0.02); tl.to("#dn-box", { attr: { transform: "translate(1080,1380) scale(0.6)" }, duration: 0.5, ease: "power2.in" }, T); tl.set("#dn-box", { opacity: 0 }, T + 0.5); Fx.punch(tl, `#${id} .stage`, t0 + F("dawn", 1, 1), 1.05, 0.35); red(tl, t0 + F("dawn", 1, 1), 0.4, 0.5); Fx.heart(tl, t0 + vo("dawn", 1), D("dawn") - vo("dawn", 1), 0.5, 0.5); },
      });

      // ---------- 23. the bag: a radio crackles — "หนองน้ำใส ได้ยินมั้ย รายงานด้วย" ----------
      add("walkie", {
        set: "schoolYard", setOpts: { id: "wk", time: "morning", level: 0.5, breakAt: 1100, fallen: true }, dark: 0.35, blur: { far: 4, set: 2 },
        cam: { keys: [{ t: 0, ...fr(1040, 1320, 1.7, 540, 1150), drift: { s: 0.03 } }, { t: vo("walkie", 1) - 0.05, glide: 0.5, ...fr(1040, 1180, 1.4, 540, 1050), drift: { s: 0.03 } }] },
        actors: [PH(1040, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: vo("walkie", 1), mode: "lookUp", eyes: "normal", mouth: "flat" }], { prop: "bag" })],
        captions: CLIP([...caps("walkie", [0], { quote: true }), ...caps("walkie", [1])]),
        ui: [{ type: "counter", t: F("walkie", 1, 1), end: D("walkie") - 0.05, label: "วิทยุในค่าย", icon: "radio", unit: "เครื่อง", max: 2, keys: [{ t: F("walkie", 1, 1), v: 2 }], alarm: F("walkie", 1, 1), top: 150, right: true }],
        extra(L) { put(L.act, `<g id="wk-led" opacity="0"><circle cx="1010" cy="1400" r="6" fill="#4cff7a"/><circle cx="1010" cy="1400" r="26" fill="#4cff7a" opacity=".25"/></g>`); },
        fx(tl, id, t0) { document.querySelectorAll(`#${id} .capbox`).forEach((c, i) => { if (i < caps("walkie", [0]).length) c.classList.add("radio"); }); for (let t = 0.2; t < voEnd("walkie", 0); t += 0.5) { tl.set("#wk-led", { opacity: 1 }, t0 + t); tl.set("#wk-led", { opacity: 0 }, t0 + t + 0.25); } Fx.punch(tl, `#${id} .stage`, t0 + F("walkie", 1, 1), 1.08, 0.5); Fx.glitch(tl, `#${id}`, t0 + F("walkie", 1, 1), 0.3, 14, 81); red(tl, t0 + F("walkie", 1, 1), 0.7, 0.7); Fx.heart(tl, t0, D("walkie"), 0.45, 0.6); },
      });

      // ---------- 24. the drawing of day 103: ลุง beyond the fence — still standing ----------
      add("drawing", {
        set: "drawing4", setOpts: { id: "dw" }, dark: 0.2,
        cam: { keys: [{ t: 0, ...fr(540, 1000, 1.0, 540, 960), drift: { s: 0.02 } }, { t: F("drawing", 0, 1) - 0.05, glide: 0.6, ...fr(820, 1200, 1.5, 540, 960), drift: { s: 0.03 } }] },
        captions: caps("drawing"),
        fx(tl, id, t0) { Fx.heart(tl, t0 + F("drawing", 0, 1), D("drawing") - F("drawing", 0, 1), 0.55, 0.5); Fx.punch(tl, `#${id} .stage`, t0 + F("drawing", 0, 2), 1.06, 0.4); Fx.glitch(tl, `#${id}`, t0 + F("drawing", 0, 2), 0.2, 10, 91); red(tl, t0 + F("drawing", 0, 2), 0.5, 0.6); },
      });

      // ---------- 25. who turned the crying on? (pulled to "ภู…") — "…เขาเก็บกล่องเสียงไว้" ----------
      add("choice", {
        set: "schoolYard", setOpts: { id: "cho", time: "morning", level: 0.5, breakAt: 1100, fallen: true }, dark: 0.35, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(1000, 1150, 1.0, 540, 1000), drift: { s: 0.02 } }, { t: 1.0, glide: 1.6, ...fr(1040, 1200, 1.6, 540, 1050), r: 2, drift: { s: 0.03, r: 0.8 } }] },
        shake: (t) => shakeH(t) * 2,
        actors: [PH(1040, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }], { prop: "bag", flip: true })],
        ui: [{ type: "choice", t: 0.05, q: "เสียงเด็กร้อง… ใครเปิด?", a: "ภู", b: "คนข้างนอก", secs: 3, top: 300, possessed: { at: 1.0, side: "a", glitch: "ภู…", who: "…เขาเก็บกล่องเสียงไว้" } }],
        fx(tl, id, t0) { Fx.heart(tl, t0, D("choice"), 0.38, 0.85); Fx.tunnel(tl, t0, t0 + D("choice") + 0.5, 0.75); Fx.glitch(tl, `#${id}`, t0 + 1.0, 0.3, 12, 64); Fx.glitch(tl, `#${id}`, t0 + D("choice") - 0.6, 0.4, 18, 65); tl.set("#black", { opacity: 1 }, t0 + D("choice") - 0.2); },
      });

      // ---------- 26. end card: the ledger — the fence is down; tomorrow they leave ----------
      add("next", {
        set: "classroom", setOpts: { id: "nx", night: true, lampX: 540, lampY: 900 }, dark: 0.75, blur: { far: 6, set: 6 },
        cam: { keys: [{ t: 0, ...fr(540, 1000, 1.0, 540, 960), drift: { s: 0.03 } }] },
        ui: [{ type: "nextCard", t: 0.3, big: "ตอนที่ 5", tag: "ถนน… ออกจากโรงเรียน ก่อนมันกลับมา", top: 150 }, { type: "ledger", t: 0.6, day: "เหลือ 95 วัน", rows: [["วิทยุนับถอยหลัง", "96 → 95"], ["คน", "6 → 5", "red"], ["อาวุธ", "หอกมีด +1 (ก้อง)"], ["รั้ว", "ล้ม 1 ช่อง", "red"], ["วิทยุ", "2 เครื่อง?"]], six: "5 = 5", next: "รถ · น้ำมัน 3 ลิตร · ถนนสี่เลน", cta: "กดติดตาม · <em>อ่านหน้าถัดไป</em> ตอนที่ 5", top: 560 }],
        fx(tl, id, t0) { tl.set("#black", { opacity: 0 }, t0 + 0.3); tl.set(`#${id} .stage`, { opacity: 0.3 }, t0 + 0.3); tl.set(`#${id} .stage`, { opacity: 1 }, t0 + 0.45); Fx.glitch(tl, `#${id}`, t0 + 1.9, 0.12, 10, 91); Fx.heart(tl, t0 + 1.2, D("next") - 1.2, 0.7, 0.35); },
      });

      // no source cards and no source names on screen (user, 26 Oct 2026: "เอา ที่มา ออกให้หมด"); the sources live in the pinned comment (CAPTIONS.md)
      shots.forEach((sh) => { if (sh.ui) sh.ui = sh.ui.filter((u) => u.type !== "src").map((u) => (u.label ? { ...u, label: u.label.replace(/ · (NIOSH|MedlinePlus|NHS|CDC|Ready\.gov)$/, "") } : u)); });

      // ---------- the look: depth, haze, light sources per shot ----------
      const DAY = (L) => { Fence.light(L, 760, 300, 900, "#ffe6b0", 0.3); Fence.haze(L, 1120, 460, "#dfe8ea", 0.3); Fence.depth(L, "grass"); };
      const MORN = (L) => { Fence.light(L, 900, 300, 900, "#ffe0b0", 0.4); Fence.haze(L, 1120, 460, "#e8e2d0", 0.35); Fence.depth(L, "grass"); };
      const DUSK = (x) => (L) => { Fence.light(L, x, 1000, 760, "#ff9a40", 0.55); Fence.haze(L, 1150, 420, "#ffb070", 0.28); Fence.depth(L, "grass"); };
      const STORM = (L) => { Fence.haze(L, 1150, 400, "#5a6f90", 0.35); Fence.depth(L, "grass", { col: "#04060a" }); };
      const NIGHTYARD = (L) => { Fence.light(L, 760, 340, 520, "#9fb8d8", 0.28); Fence.haze(L, 1150, 400, "#5a6f90", 0.3); Fence.depth(L, "grass", { col: "#04060a" }); };
      const LAMP = (x, y) => (L) => { Fence.light(L, x, y - 80, 420, "#ffd58a", 0.55, "lampf"); Fence.cone(L, x, y - 40, 700, 800, "#ffd58a", 0.3); Fence.depth(L, "desk", { op: 0.85 }); };
      const HALL = (L) => { Fence.light(L, 540, 400, 600, "#9fb8d8", 0.2); Fence.depth(L, "desk", { op: 0.8 }); };
      const LOOK = {
        hook: (L) => { STORM(L); Fence.depth(L, "bars", { op: 0.75 }); },
        chapter: (L) => { DAY(L); Fence.depth(L, "branch", { op: 0.8 }); }, ask: DAY, phuKnife: DAY, run: DAY,
        craft: (L) => { Fence.light(L, 560, 400, 800, "#fff2c0", 0.35); },
        loud: DUSK(900), rain: (L) => { Fence.haze(L, 1150, 420, "#7a6a60", 0.3); Fence.depth(L, "grass"); },
        "cry#0": LAMP(400, 1100), "cry#1": STORM, peek: STORM, trap: STORM, "fenceFall#0": STORM, "fenceFall#1": STORM, flee: STORM, cover: STORM, count: STORM,
        count2: HALL, after: HALL, tq: (L) => { Fence.light(L, 300, 300, 700, "#ffd58a", 0.35, "lampf"); }, real: HALL,
        sig: NIGHTYARD, "radio#0": (L) => { Fence.depth(L, "post", { x: -200, w: 300, op: 0.85 }); }, "radio#1": HALL, ledger: HALL,
        dawn: MORN, walkie: MORN, drawing: (L) => { Fence.light(L, 540, 320, 640, "#ffd58a", 0.4, "lampf"); Fence.cone(L, 540, 260, 1100, 1300, "#ffd58a", 0.22); },
        choice: (L) => { MORN(L); Fence.depth(L, "bars", { op: 0.75 }); }, next: LAMP(540, 900),
      };
      const seen = {}, depth0 = Fence.depth;
      shots.forEach((sh) => { const n = seen[sh.key] = (seen[sh.key] ?? -1) + 1, look = LOOK[`${sh.key}#${n}`] || (n === 0 ? LOOK[sh.key] : null), e = sh.extra;
        if (look) sh.extra = (L, id) => { if (e) e(L, id); const k0 = (sh.cam && sh.cam.keys && sh.cam.keys[0]) || { x: 0, y: 0, s: 1 }; Fence.depth = (L2, kind, o = {}) => depth0(L2, kind, { cam: k0, ...o }); look(L, id); Fence.depth = depth0; }; });
      shots.forEach((sh) => { const f = sh.fx; sh.fx = (tl, id, t0, L) => { if (f) f(tl, id, t0, L); Zom.zlife(tl, `#${id}`, t0, sh.dur); Fence.flife(tl, `#${id}`, t0, sh.dur); }; });
