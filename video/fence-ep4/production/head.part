<!doctype html>
<html lang="th" data-resolution="portrait">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080, height=1920" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <script src="assets/rig.js"></script>
    <script src="assets/hand.js"></script>
    <script src="assets/sets.js"></script>
    <script src="assets/camp.js"></script>
    <script src="assets/koi.js"></script>
    <script src="assets/zom.js"></script>
    <script src="assets/fence.js"></script>
    <script src="assets/ui.js"></script>
    <script src="assets/gameui.js"></script>
    <script src="assets/sig.js"></script>
    <script src="assets/fx.js"></script>
    <script src="assets/engine.js"></script>
    <style>
      @font-face { font-family: 'Kanit'; font-weight: 400; src: url(assets/fonts/f1.ttf); }
      @font-face { font-family: 'Kanit'; font-weight: 700; src: url(assets/fonts/f2.ttf); }
      @font-face { font-family: 'Kanit'; font-weight: 900; src: url(assets/fonts/f3.ttf); }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1080px; height: 1920px; overflow: hidden; background: #05080a; }
      #root { position: relative; width: 1080px; height: 1920px; overflow: hidden; font-family: Kanit, sans-serif; }
      .clip { position: absolute; inset: 0; overflow: hidden; }
      .stage { position: absolute; inset: 0; }
      .fgblur { filter: blur(7px); }
      .badge { z-index: 56; position: absolute; left: 36px; bottom: 150px; font: 700 26px/1 Kanit; color: #f4ecd8; opacity: .75; letter-spacing: 2px;
        background: rgba(5,8,10,.55); padding: 8px 14px 10px; border-radius: 10px; }
      #vig { z-index: 55; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 80% 64% at 50% 48%, transparent 50%, rgba(3,6,8,.8) 100%); }
      #grain { z-index: 57; position: absolute; inset: -60px; opacity: .11; mix-blend-mode: overlay; pointer-events: none; }
      #flashw { z-index: 60; position: absolute; inset: 0; background: #e8f0ff; opacity: 0; pointer-events: none; }
      #black { z-index: 61; position: absolute; inset: 0; background: #000; opacity: 0; pointer-events: none; }
      /*__UICSS__*/
      /*__GAMECSS__*/
      .capwrap { z-index: 56; top: 1480px; }
      .capbox { background: rgba(12,18,20,.86); color: #f4ecd8; border: 2px solid rgba(244,236,216,.4); border-radius: 22px;
        box-shadow: 0 0 0 4px rgba(10,14,16,.45), 0 14px 30px rgba(0,0,0,.55); font: 900 64px/1.22 Kanit; padding: 12px 34px 18px; }
      .capbox .k { background: #f2c55c; color: #2e2a26; border: 0; border-radius: 10px; padding: 0 .16em; transform: rotate(-1.5deg); }
      .capbox .k.kr, .k.kr { background: #d8443a; color: #fff4ea; }
      .capbox.q { background: rgba(244,236,216,.94); color: #2e2a26; border-color: #2e2a26; }
      .bubble { z-index: 57; white-space: normal !important; max-width: 640px; text-align: center; }
      /* shared HUD pieces (counter, source chip, callback, countdown) */
      .zcount { position: absolute; right: 50px; z-index: 52; padding: 16px 26px; border-radius: 24px; background: rgba(16,20,24,.92); border: 4px solid #8fc3d6; font-family: Kanit; text-align: right; opacity: 0; }
      .zcount .lbl { color: #8fc3d6; font-weight: 900; font-size: 30px; } .zcount .v { color: #f4ecd8; font-weight: 900; font-size: 84px; line-height: 1; } .zcount .v small { font-size: 36px; color: #9aa6ad; }
      .zsrc { position: absolute; left: 60px; right: 60px; z-index: 52; display: flex; justify-content: center; opacity: 0; }
      .zsrc span { display: inline-flex; gap: 12px; align-items: center; padding: 9px 20px 11px; border-radius: 16px; background: rgba(8,12,14,.86); border: 2px solid rgba(143,195,214,.5); color: #d8e8ee; font: 700 27px/1.25 Kanit; box-shadow: 0 10px 24px rgba(0,0,0,.45); }
      .zsrc b { flex: none; width: 34px; height: 34px; border-radius: 50%; background: #8fc3d6; color: #0d171b; font: 900 24px/34px Kanit; text-align: center; }
      .zsrc em { font-style: normal; color: #8fc3d6; font-weight: 900; }
      .zcall { position: absolute; left: 0; right: 0; z-index: 52; text-align: center; opacity: 0; }
      .zcall span { display: inline-flex; align-items: center; gap: 14px; padding: 12px 26px 14px; border-radius: 22px; background: rgba(16,20,21,.92); border: 4px solid #d8322a; color: #f4ecd8; font: 900 50px/1 Kanit; box-shadow: 0 0 0 6px rgba(16,20,21,.5), 0 14px 34px rgba(0,0,0,.55); }
      .zcall small { font: 700 26px/1 Kanit; color: #1fbf6a; letter-spacing: 2px; }
      /* the blackboard chapter card: chalk on the classroom board */
      .fboard { position: absolute; left: 140px; width: 800px; z-index: 52; font-family: Kanit; color: #f4ecd8; opacity: 0; }
      .fboard .ln { position: relative; white-space: nowrap; text-shadow: 0 0 2px rgba(244,236,216,.6), 0 0 14px rgba(244,236,216,.25); letter-spacing: 3px; }
      .fboard .s { font: 700 54px/1.1 Kanit; opacity: .9; } .fboard .b { font: 900 300px/1 Kanit; letter-spacing: 10px; margin: 6px 0 14px; } .fboard .e { font: 900 62px/1.15 Kanit; }
      .fboard .b { position: relative; } .fboard .b .old { position: absolute; left: 470px; top: -70px; font-size: 130px; letter-spacing: 4px; opacity: .3; filter: blur(1.2px); transform: rotate(-8deg); text-decoration: line-through; text-decoration-thickness: 12px; text-decoration-color: rgba(244,236,216,.75); }
      .fboard .b .smear { position: absolute; left: 0; top: 40px; width: 560px; height: 230px; border-radius: 50%; background: radial-gradient(ellipse, rgba(244,236,216,.16), transparent 70%); }
      .fboard .u { font: 700 54px/1.1 Kanit; margin-top: -26px; margin-bottom: 18px; opacity: .9; letter-spacing: 3px; }
      .fboard .tally { display: none; }
      .fboard .tally i { display: block; width: 90px; height: 64px; background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 90 64'><path d='M12,6v52M30,6v52M48,6v52M66,6v52M4,50L80,12' stroke='%23f4ecd8' stroke-width='6' stroke-linecap='round' fill='none'/></svg>") no-repeat; opacity: 0; }
      .fboard .dust { position: absolute; width: 10px; height: 10px; border-radius: 50%; background: #f4ecd8; opacity: 0; }
      .fboard .ep { display: inline-block; margin-top: 8px; padding: 6px 26px 10px; border: 4px solid rgba(244,236,216,.75); border-radius: 50px 40px 46px 52px / 42px 50px 38px 48px; font: 700 46px/1.1 Kanit; }
      /* ครูพิม's rules, written in chalk; the icons are chalk sketches, the "แต่อย่า" words get a chalk underline */
      .frule { position: absolute; left: 90px; width: 900px; z-index: 52; opacity: 0; padding: 28px 36px 32px; border-radius: 18px; background: linear-gradient(135deg, #2f5a46, #1f3f31); border: 14px solid #7a5a3e;
        box-shadow: 0 0 0 4px #5f442d, 0 26px 60px rgba(0,0,0,.6), inset 0 0 60px rgba(0,0,0,.35); font-family: Kanit; }
      .frule::before { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(180deg, rgba(255,255,255,.025) 0 3px, transparent 3px 9px); pointer-events: none; }
      .frule .fr-h { font: 700 36px/1 Kanit; color: #f2c55c; letter-spacing: 4px; margin-bottom: 18px; text-shadow: 0 0 12px rgba(242,197,92,.4); }
      .frule .fr-r { display: flex; align-items: center; gap: 24px; padding: 14px 6px; opacity: 0; border-top: 3px dashed rgba(244,236,216,.25); }
      .frule .fr-r:first-of-type { border-top: 0; }
      .frule .fr-i { flex: none; width: 118px; height: 118px; } .frule .fr-i svg { width: 100%; height: 100%; }
      .frule .fr-t { font: 900 58px/1.15 Kanit; color: #f4ecd8; white-space: nowrap; text-shadow: 0 0 3px rgba(244,236,216,.5), 0 0 16px rgba(244,236,216,.2); letter-spacing: 2px; }
      .frule .fr-t b { color: #f2c55c; } .frule .fr-t u { text-decoration: none; position: relative; }
      .frule .fr-t u::after { content: ""; position: absolute; left: -4px; right: -4px; bottom: -8px; height: 7px; border-radius: 4px; background: #ff8a7a; box-shadow: 0 0 12px rgba(255,138,122,.8); transform: scaleX(var(--k, 0)); transform-origin: 0 50%; }
      .frule .n { display: inline-block; width: 52px; height: 52px; border-radius: 50%; border: 4px solid #f2c55c; color: #f2c55c; font: 900 34px/46px Kanit; text-align: center; margin-right: 10px; vertical-align: 6px; }
      /* the sun HUD: a little arc with the sun sliding down to the horizon, the time, and how long until dark */
      .fsun { position: absolute; right: 44px; z-index: 52; width: 420px; padding: 14px 18px 12px; border-radius: 26px; background: rgba(16,20,24,.92); border: 4px solid #f2c55c; font-family: Kanit; opacity: 0; box-shadow: 0 14px 36px rgba(0,0,0,.5); }
      .fsun svg { width: 100%; height: 150px; display: block; }
      .fsun .row { display: flex; justify-content: space-between; align-items: baseline; }
      .fsun .tm { font: 900 54px/1 Kanit; color: #f4ecd8; } .fsun .lf { font: 700 28px/1.1 Kanit; color: #f2c55c; text-align: right; } .fsun .lf b { display: block; font: 900 40px/1 Kanit; }
      .fsun.late { border-color: #ff5a4a; } .fsun.late .lf { color: #ff8a7a; }
      /* เจ๊หงส์'s ledger page: the end card (and the stock card) — squared paper, red margin, pen handwriting, a muddy thumb */
      .fledger { position: absolute; left: 50%; width: 780px; margin-left: -390px; z-index: 52; opacity: 0; font-family: Kanit; }
      .fledger .page { position: relative; padding: 40px 50px 44px 110px; background: #f7f1e2; color: #1e1d1b; transform: rotate(1.6deg); overflow: hidden;
        background-image: linear-gradient(90deg, transparent 84px, rgba(200,57,43,.55) 84px, rgba(200,57,43,.55) 87px, transparent 87px), repeating-linear-gradient(0deg, transparent 0 46px, rgba(70,90,140,.22) 46px 48px);
        box-shadow: 0 30px 60px rgba(0,0,0,.7), 0 2px 0 rgba(0,0,0,.2); }
      .fledger .rings { position: absolute; left: 14px; top: 30px; bottom: 30px; width: 40px; }
      .fledger .rings i { display: block; width: 34px; height: 34px; border-radius: 50%; border: 6px solid #8a857a; margin-bottom: 46px; background: #3a3330; }
      .fledger .hd { font: 900 54px/1.1 Kanit; color: #2f4a8a; border-bottom: 4px solid #2f4a8a; padding-bottom: 8px; display: flex; justify-content: space-between; align-items: baseline; }
      .fledger .hd small { font: 700 32px/1 Kanit; color: #4a4742; }
      .fledger .r { display: flex; justify-content: space-between; align-items: baseline; font: 700 44px/48px Kanit; color: #2a2a35; opacity: 0; }
      .fledger .r b { font: 900 46px/48px Kanit; } .fledger .r .bar { flex: 1; margin: 0 18px; border-bottom: 3px dotted #8a857a; }
      .fledger .r.red b, .fledger .r.red .six { color: #c8281c; } .fledger .r .strike { position: relative; } .fledger .r .strike::after { content: ""; position: absolute; left: -4px; right: -4px; top: 50%; height: 5px; background: #c8281c; transform: rotate(-6deg) scaleX(var(--k, 0)); transform-origin: 0 50%; }
      .fledger .r .six { font: 900 54px/48px Kanit; margin-left: 14px; opacity: 0; transform: rotate(-8deg); display: inline-block; }
      .fledger .next { margin-top: 26px; font: 700 36px/1.2 Kanit; color: #4a4742; opacity: 0; } .fledger .next b { display: block; font: 900 86px/1.05 Kanit; color: #c8281c; letter-spacing: 1px; }
      .fledger .cta { margin-top: 18px; font: 700 34px/1.3 Kanit; color: #2a2a35; opacity: 0; } .fledger .cta em { font-style: normal; color: #2f4a8a; font-weight: 900; }
      .fledger .thumb { position: absolute; right: 40px; bottom: 30px; width: 150px; height: 190px; border-radius: 50% 50% 46% 46%; background: radial-gradient(ellipse at 50% 40%, rgba(90,60,30,.55), rgba(90,60,30,.15) 70%, transparent 72%); opacity: 0; }
      .fledger .thumb::before { content: ""; position: absolute; inset: 14px; border-radius: inherit; background: repeating-radial-gradient(ellipse at 50% 45%, transparent 0 5px, rgba(60,40,20,.35) 5px 8px); }
      /* the signs on a can: three chalk-free danger rows (bulging, leaking, spurting) */
      .zcd { position: absolute; left: 50%; width: 520px; margin-left: -260px; z-index: 52; padding: 14px 24px 18px; border-radius: 28px; text-align: center; opacity: 0;
        background: rgba(20,8,8,.92); border: 5px solid #e8443a; box-shadow: 0 0 0 8px rgba(20,8,8,.5), 0 20px 50px rgba(0,0,0,.6); font-family: Kanit; }
      .zcd .lbl { color: #ff8a7a; font-weight: 900; font-size: 32px; } .zcd .num { color: #fff1ea; font-weight: 900; font-size: 120px; line-height: 1; letter-spacing: 4px; }
      .fsigns { position: absolute; left: 70px; width: 940px; z-index: 52; font-family: Kanit; }
      .fsigns .row { display: flex; align-items: center; gap: 22px; padding: 16px 26px; margin-bottom: 16px; border-radius: 26px; background: rgba(16,22,26,.93); border: 4px solid #ff8a7a; opacity: 0; box-shadow: 0 18px 40px rgba(0,0,0,.5); }
      .fsigns .ic { flex: none; width: 110px; height: 110px; } .fsigns .ic svg { width: 100%; height: 100%; }
      .fsigns .tx { font: 900 52px/1.1 Kanit; color: #f4ecd8; } .fsigns .tx em { font-style: normal; color: #ff8a7a; }
      .fsigns .bad { position: absolute; right: 26px; font: 900 60px/1 Kanit; color: #ff5a4a; opacity: 0; }
      /* the radio's number: a caption in the style of a tuned-in station */
      .capbox.radio { background: rgba(30,18,6,.9); border-color: #ffb35c; color: #ffd27a; letter-spacing: 6px; text-shadow: 0 0 18px rgba(255,179,92,.7); }

    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="/*__TOTAL__*/" data-width="1080" data-height="1920">
      <svg id="grain" width="1200" height="2040"><filter id="nz"><feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" seed="5" /></filter><rect width="1200" height="2040" filter="url(#nz)" /></svg>
    </div>
    <script>
      const SCHED = /*__SCHEDULE__*/;
      const SH = Object.fromEntries(SCHED.shots.map((s) => [s.key, s]));
      const vo = (k, i = 0) => SH[k].vo[i].t;                       // voice start, relative to the shot
      const voEnd = (k, i = 0) => SH[k].vo[i].t + SH[k].vo[i].dur;
      const F = (k, i = 0, j = 0) => SH[k].vo[i].t + SH[k].vo[i].frags[j]; // start of caption fragment j
      const D = (k) => SH[k].dur;
      const fr = (wx, wy, s, sx = 540, sy = 760, extra = {}) => ({ x: wx - 540 - (sx - 540) / s, y: wy - 960 - (sy - 960) / s, s, ...extra });
      const root = document.getElementById("root");
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });

      // one caption per fragment of the spoken line, on the beat of the voice
      function caps(k, lines, o = {}) {
        const out = [];
        (lines ?? SH[k].vo.map((_, i) => i)).forEach((i) => {
          const v = SH[k].vo[i], fr = v.cap.split(" / ");
          fr.forEach((txt, j) => out.push({ text: o.quote ? `“${txt}”` : txt, t: v.t + v.frags[j] - 0.06,
            end: j + 1 < fr.length ? v.t + v.frags[j + 1] - 0.08 : Math.min(D(k) - 0.06, v.t + v.dur + (o.hold ?? 0.35)) }));
        });
        out.sort((a, b) => a.t - b.t);
        for (let n = 0; n + 1 < out.length; n++) out[n].end = Math.min(out[n].end, out[n + 1].t - 0.03);
        return out;
      }
      const bub = (k, i, x, y, tail, o = {}) => ({ text: `“${SH[k].vo[i].cap.replace(/ \/ /g, " ")}”`, x, y, tail, t: vo(k, i) - 0.05, end: o.end ?? Math.min(D(k) - 0.05, voEnd(k, i) + 0.35) });
      const shakeH = (t) => 7 * Math.sin(t * 2.3) + 3 * Math.sin(t * 7.1);

      // ---------- poses for this story ----------
      Rig.MODES.reach = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -72 + Math.sin(u * 2.3), faF: -12, torso: 6, head: 8 });                  // a hand out to something on a table
      Rig.MODES.reachUp = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -118 + Math.sin(u * 2.3), faF: -22, torso: -6, head: -14, bodyY: -6 });  // a small person reaching up onto a desk
      Rig.MODES.write = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -40, faF: -70 + 2 * Math.sin(u * 9), uaB: -30, faB: -70, torso: 14, head: 22 });     // bent over a ledger, pen moving
      Rig.MODES.still = (u, o) => { const j = Rig.MODES.shamble(u, { period: 9 }); return { ...j, thF: 4, thB: -4, shF: 6, shB: 6, bodyY: 0, rootR: 0 }; }; // one of them standing, swaying, twitching
      Rig.MODES.grabCan = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: -70, faF: -20, uaB: -20, faB: -60, torso: 30, head: 10 });              // crouched at a shelf, sweeping cans into a bag
      Rig.MODES.point = Rig.MODES.point || ((u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -95, faF: -6 }));
      Rig.MODES.guard = (u, o) => { const j = Math.sin(u * 40) * 2; return { ...Rig.MODES.idle(u, o), uaF: -130 + j, faF: -70, uaB: -110 - j, faB: -80, torso: -14, head: -12, thF: -10, shF: 16, thB: 14, bodyY: 8 }; };
      Rig.MODES.stopHand = (u, o) => ({ ...Rig.MODES.idle(u, o), uaB: -70, faB: -60, uaF: -10, faF: -20, head: 10, torso: 4 });
      Rig.MODES.grabArm = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -78, faF: -8, uaB: -40, faB: -60, torso: 8, head: 4 });
      Rig.MODES.pullBolt = (u, o) => { const k = Rig.smooth(u / 0.5); return { ...Rig.MODES.idle(u, o), uaF: Rig.lerp(-60, -20, k), faF: Rig.lerp(-30, -60, k), torso: 10, head: 6, thF: 10, shF: 10, thB: -10 }; };
      Rig.MODES.crouchDraw = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: -30, faF: -40 + 6 * Math.sin(u * 7), uaB: -10, faB: -50, torso: 30, head: 20 });
      Rig.MODES.sitHold = (u, o) => ({ ...Rig.MODES.sit(u, o), uaF: -40, faF: -110, uaB: -16, faB: -100, torso: 12 + Math.sin(u * 4) * 1.5, head: 14 });   // on the floor, winded, holding his arm
      Rig.MODES.sleepSit = (u, o) => ({ ...Rig.MODES.sit(u, o), torso: 6, head: 26 + Math.sin(u * 1.1), uaF: -10, faF: -40, uaB: 4, faB: -30 });
      Rig.MODES.lookUp = (u, o) => ({ ...Rig.MODES.idle(u, o), head: -22, torso: -4 });
      Rig.MODES.pointUp = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -150, faF: -10, head: -16, torso: -4 });
      Camp.hand.sickle = `<g transform="translate(0,118)"><rect x="-8" y="-10" width="16" height="70" rx="6" fill="#6b4a2e" stroke="#2e2a26" stroke-width="3"/><path d="M0,-10C70,-30 120,-110 90,-190C120,-120 60,-50 0,-26Z" fill="#c9ccd0" stroke="#2e2a26" stroke-width="3.5"/></g>`;
      Camp.hand.ledger = `<g transform="translate(0,118)"><rect x="-34" y="-60" width="68" height="90" rx="4" fill="#2f4a8a" stroke="#2e2a26" stroke-width="3"/><rect x="-28" y="-52" width="56" height="76" fill="#f7f1e2"/><path d="M-18,-40h36M-18,-28h36M-18,-16h28" stroke="#8a857a" stroke-width="2.5"/></g>`;
      Camp.hand.bag = `<g transform="translate(0,118)"><path d="M-44,0q-10,-40 0,-70h88q10,30 0,70z" fill="#3d4d45" stroke="#2e2a26" stroke-width="3.5"/><path d="M-30,-70q30,-30 60,0" stroke="#2e2a26" stroke-width="8" fill="none"/></g>`;
      Camp.hand.crayon = `<g transform="translate(0,118)"><rect x="-6" y="-6" width="12" height="50" rx="3" fill="#c8392b" stroke="#2e2a26" stroke-width="2.5" transform="rotate(-30)"/></g>`;
      // ---------- poses for EP.3 ----------
      Rig.MODES.showArms = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -84 + Math.sin(u * 2) * 1.5, faF: -6, uaB: -84, faB: -6, torso: -2, head: 4 });               // both arms held out, palms up: "look, nothing"
      Rig.MODES.kneelAid = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: -52, faF: -34 + 4 * Math.sin(u * 6), uaB: -40, faB: -46, torso: 26, head: 18 });            // kneeling over someone, hands working
      Rig.MODES.press = (u, o) => { const j = Math.sin(u * 14) * 1.5; return { ...Rig.MODES.crouch(u, o), uaF: -34 + j, faF: -12, uaB: -34 - j, faB: -12, torso: 30, head: 14 }; };   // both arms straight down, pressing
      Rig.MODES.cutCloth = (u, o) => ({ ...Rig.MODES.sit(u, o), uaF: -56, faF: -40 + 10 * Math.sin(u * 11), uaB: -30, faB: -70, torso: 22, head: 26 });              // sitting, sawing at a trouser leg
      Rig.MODES.holdArm = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -40, faF: -100, uaB: -30, faB: -70, torso: 10 + Math.sin(u * 3), head: 12 });                  // standing, the hurt arm held against the chest
      Rig.MODES.limp = (u, o) => { const w = Rig.MODES.walk(u, { ...o, period: 1.6 }); return { ...w, thF: w.thF * 0.6, thB: w.thB * 0.6, torso: 10, head: 8, bodyY: 6 + 4 * Math.abs(Math.sin(u * 3.9)) }; };   // a hurt leg
      Rig.MODES.talkOut = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -70 + 3 * Math.sin(u * 1.7), faF: -20, head: -4 + 2 * Math.sin(u * 0.9), torso: 2 });        // at the fence, an arm through the bars, talking
      Camp.hand.knife = `<g transform="translate(0,118) rotate(70) scale(0.42)">${Fence.KNIFE("", 1)}</g>`;
      // ---------- poses for EP.4 ----------
      Rig.MODES.thrust = (u, o) => { const k = Math.abs(Math.sin(u * 2 * Math.PI / (o.period || 0.7))); return { ...Rig.MODES.idle(u, o), uaF: -70 - 40 * k, faF: -20 + 10 * k, uaB: -40, faB: -60, torso: 8 + 10 * k, head: 2, thF: 12, shF: 10, thB: -10, bodyY: 4 }; };   // spear thrusts at something ahead
      Rig.MODES.brace = (u, o) => { const j = Math.sin(u * 30) * 1.5; return { ...Rig.MODES.idle(u, o), uaF: -100 + j, faF: -40, uaB: -90 - j, faB: -50, torso: 24, head: 14, thF: 24, shF: 20, thB: -16, bodyY: 10 }; };   // leaning his whole weight on the spear jammed across the gate
      Rig.MODES.limpRun = (u, o) => { const w = Rig.MODES.run(u, { ...o, period: 0.7 }); return { ...w, thF: w.thF * 0.7, torso: 14, head: 6, bodyY: 10 + 6 * Math.abs(Math.sin(u * 9)) }; };
      Rig.MODES.sitLeg = (u, o) => ({ ...Rig.MODES.sit(u, o), uaF: -30, faF: -80, uaB: -20, faB: -70, torso: 16 + Math.sin(u * 5) * 2, head: 20, thF: -10 });   // sitting against the wall, the bad leg out
      Rig.MODES.tie = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: -60, faF: -20 + 14 * Math.sin(u * 9), uaB: -50, faB: -40 - 10 * Math.sin(u * 9), torso: 28, head: 20 });   // kneeling, twisting the stick
      Rig.MODES.listen = (u, o) => ({ ...Rig.MODES.idle(u, o), head: 10 + 2 * Math.sin(u * 1.2), torso: 2, uaF: -20, faF: -10 });
      // the knife-spear as a hand prop. Two grips, chosen per pose: "spear1" = blade back along the forearm (an arm hanging or sitting → blade up,
      // butt a little below the hand, like a walking staff); "spear1f" = blade on past the hand along the forearm (a raised arm → blade up; a thrust
      // or a brace → blade forward at the enemy). The hand holds it a third of the way up from the butt. +1 version is steel.
      const SPEAR_SVG = (steel, fwd) => `<g transform="translate(0,118) rotate(${fwd ? 90 : -90}) scale(0.5)"><rect x="-350" y="-18" width="864" height="36" rx="12" fill="${steel ? "#b9c0c6" : "#c9955c"}" stroke="#2e2a26" stroke-width="4"/>${steel ? '<path d="M-330,-6h820" stroke="#fff" stroke-width="3" opacity=".5"/>' : ""}<g transform="translate(514,0)">${Fence.KNIFE("", 0.9)}</g>${[340, 374, 408].map((x) => `<rect x="${x}" y="-24" width="26" height="48" rx="4" fill="#1f1d1a" stroke="#2e2a26" stroke-width="3"/>`).join("")}<path d="M-350,-18h40v36h-40z" fill="#1f1d1a" stroke="#2e2a26" stroke-width="3"/></g>`;
      Camp.hand.spear = SPEAR_SVG(false, false); Camp.hand.spearf = SPEAR_SVG(false, true); Camp.hand.spear1 = SPEAR_SVG(true, false); Camp.hand.spear1f = SPEAR_SVG(true, true);
      Camp.hand.broom = `<g transform="translate(0,118) rotate(-70) scale(0.5)"><rect x="-700" y="-18" width="864" height="36" rx="12" fill="#c9955c" stroke="#2e2a26" stroke-width="4"/><path d="M-740,-60q-40,60 0,120h70q10,-60 0,-120z" fill="#e2c988" stroke="#2e2a26" stroke-width="4"/></g>`;
      Camp.hand.tape = `<g transform="translate(0,118)"><circle r="34" fill="#1f1d1a" stroke="#2e2a26" stroke-width="3"/><circle r="14" fill="#f4ecd8"/></g>`;
      Camp.hand.belt = `<g transform="translate(0,118)"><path d="M-10,-20q40,30 0,90" stroke="#3a2e22" stroke-width="12" fill="none" stroke-linecap="round"/><rect x="-16" y="-30" width="22" height="18" rx="3" fill="#8d9299" stroke="#2e2a26" stroke-width="2"/></g>`;
      const PH = (x, y, s, track, extra = {}) => ({ who: "phu", x, y, s, track, ...extra });
      const PI = (x, y, s, track, extra = {}) => ({ who: "pim", x, y, s, track, ...extra });
      const KO = (x, y, s, track, extra = {}) => ({ who: "kong", x, y, s, track, ...extra });
      const MA = (x, y, s, track, extra = {}) => ({ who: "man", x, y, s, track, ...extra });
      const HO = (x, y, s, track, extra = {}) => ({ who: "hong", x, y, s, track, ...extra });
      const PU = (x, y, s, track, extra = {}) => ({ who: "pun", x, y, s, track, ...extra });
      const TOP = (L, el) => L.act.appendChild(el);
      const split = (k, at, A, B) => {
        add(k, A); shots[shots.length - 1].dur = at;
        add(k, B); const sh = shots[shots.length - 1]; sh.start = SH[k].start + at; sh.dur = D(k) - at;
      };
      const capsFrom = (k, at, lines, o) => caps(k, lines, o).filter((c) => c.end > at + 0.05).map((c) => ({ ...c, t: Math.max(0, c.t - at), end: c.end - at }));
      const glow = (L, html) => L.glow.insertAdjacentHTML("beforeend", html);
      // a rig standing behind the set's own drawing (zombies outside the fence): built into the mid layer and driven like an actor
      const behind = (L, tl, aid, who, x, y, s, flip, t0, dur, track) => {
        Rig.build(L.mid, aid, Rig.CAST[who]);
        document.getElementById(aid).insertAdjacentHTML("afterbegin", `<ellipse cy="6" rx="78" ry="15" fill="#000" opacity=".2"/>`);
        document.getElementById(aid).setAttribute("transform", `translate(${x},${y}) scale(${flip ? -s : s},${s})`);
        Rig.drive(tl, aid, t0, dur, track, []);
      };
      // move a rig through keyed points in shot time, with an optional hop arc into a key: [{t, x, y, hop}]
      const route = (tl, aid, t0, keys, s, flip) => {
        const g = document.getElementById(aid), c = { t: keys[0].t }, last = keys[keys.length - 1].t;
        const at = (t) => { let i = 0; while (i + 1 < keys.length && keys[i + 1].t <= t) i++; const a = keys[i], b = keys[i + 1]; if (!b) return [a.x, a.y];
          const k = Math.min(1, Math.max(0, (t - a.t) / (b.t - a.t))); return [a.x + (b.x - a.x) * k, a.y + (b.y - a.y) * k - (b.hop || 0) * 4 * k * (1 - k)]; };
        const put = () => { const [x, y] = at(c.t); g.setAttribute("transform", `translate(${x.toFixed(1)},${y.toFixed(1)}) scale(${flip ? -s : s},${s})`); };
        tl.to(c, { t: last, duration: last - keys[0].t, ease: "none", immediateRender: false, onUpdate: put }, t0 + keys[0].t);
      };
      // a hit: star burst at screen (x, y), white flash, one inverted frame, zoom punch
      const star = (n, R, r) => Array.from({ length: n * 2 }, (_, i) => { const a = (i * Math.PI) / n, q = i % 2 ? r : R * (0.7 + 0.3 * (((i * 7) % 5) / 4)); return `${i ? "L" : "M"}${(Math.cos(a) * q).toFixed(1)},${(Math.sin(a) * q).toFixed(1)}`; }).join("") + "Z";
      let IMPN = 0;
      const impact = (tl, id, L, t, x, y, s = 1) => {
        const k = `${id}-imp${IMPN++}`;
        L.light.insertAdjacentHTML("beforeend", `<g id="${k}" opacity="0" transform="translate(${x},${y})"><g class="in"><path d="${star(13, 230, 70)}" fill="#fff6d8"/><path d="${star(13, 150, 46)}" fill="#ffd25a"/><circle r="38" fill="#fff"/></g></g>`);
        tl.set(`#${k}`, { opacity: 1 }, t);
        tl.fromTo(`#${k} .in`, { scale: 0.3, rotation: 0 }, { scale: 1.4 * s, rotation: 18, transformOrigin: "50% 50%", duration: 0.2, ease: "power2.out", immediateRender: false }, t);
        tl.to(`#${k}`, { opacity: 0, duration: 0.1 }, t + 0.12);
        tl.fromTo("#flashw", { opacity: 0.85 }, { opacity: 0, duration: 0.14, immediateRender: false }, t);
        tl.set(`#${id} .stage`, { filter: "invert(1) contrast(1.3)" }, t); tl.set(`#${id} .stage`, { filter: "none" }, t + 0.05);
        Fx.punch(tl, `#${id} .stage`, t, 1.14, 0.35);
      };
      const red = (tl, t, a = 0.7, d = 0.6) => tl.fromTo("#fxred", { opacity: a }, { opacity: 0, duration: d, immediateRender: false }, t);
      const mmss = (v) => `${Math.floor(v / 60)}:${String(Math.floor(v % 60)).padStart(2, "0")}`;

      // ---------- HUD cards shared with ชั้น 23 ----------
      GameUI.C.src = {
        html: (id, o) => `<div id="${id}" class="zsrc" style="top:${o.top}px"><span><b>i</b><div>${o.text}</div></span></div>`,
        anim(tl, id, t0, o) {
          tl.fromTo(`#${id}`, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.25, ease: "power2.out", immediateRender: false }, t0);
          if (o.end !== undefined) tl.to(`#${id}`, { opacity: 0, duration: 0.15 }, o.t0abs + o.end);
        },
      };
      GameUI.C.callback = {
        html: (id, o) => `<div id="${id}" class="zcall" style="top:${o.top ?? 150}px"><span><small>${o.label}</small>${o.text}</span></div>`,
        anim(tl, id, t0, o) {
          tl.fromTo(`#${id}`, { opacity: 0, scale: 1.3 }, { opacity: 1, scale: 1, duration: 0.2, ease: "power3.out", immediateRender: false }, t0);
          tl.fromTo(`#${id} span`, { borderColor: "#d8322a" }, { borderColor: "#ff8a7a", duration: 0.12, repeat: 7, yoyo: true, immediateRender: false }, t0 + 0.2);
          if (o.end !== undefined) tl.to(`#${id}`, { opacity: 0, duration: 0.15 }, o.t0abs + o.end);
        },
      };
      GameUI.C.counter = { // a number that counts to a value; keys: [{t, v}] in shot time; `alarm` turns it red
        html: (id, o) => `<div id="${id}" class="zcount" style="top:${o.top ?? 150}px;border-color:${o.color || "#8fc3d6"}${o.left ? `;right:auto;left:${o.left}px` : ""}"><div class="lbl" style="color:${o.color || "#8fc3d6"}">${o.label}</div><div class="v"><span class="num">${o.keys[0].v}</span>${o.unit ? ` <small>${o.unit}</small>` : ""}</div></div>`,
        anim(tl, id, t0, o) {
          const el = document.getElementById(id), num = el.querySelector(".num"), c = { t: o.t };
          tl.fromTo(`#${id}`, { opacity: 0, x: 60 }, { opacity: 1, x: 0, duration: 0.3, ease: "back.out(1.6)", immediateRender: false }, t0);
          const at = (t) => { let i = 0; while (i + 1 < o.keys.length && o.keys[i + 1].t <= t) i++; const a = o.keys[i], b = o.keys[i + 1]; if (!b) return a.v; const k = Math.min(1, Math.max(0, (t - a.t) / (b.t - a.t))); return a.v + (b.v - a.v) * k; };
          const draw = () => { const v = at(c.t); num.textContent = Math.round(v); };
          tl.to(c, { t: o.end ?? 30, duration: (o.end ?? 30) - o.t, ease: "none", immediateRender: false, onUpdate: draw }, t0);
          if (o.alarm !== undefined) { tl.to(`#${id}`, { borderColor: "#e8443a", duration: 0.2 }, o.t0abs + o.alarm); tl.to(`#${id} .num`, { color: "#ff5a4a", duration: 0.2 }, o.t0abs + o.alarm); tl.fromTo(`#${id}`, { x: 0 }, { x: 8, duration: 0.05, repeat: 7, yoyo: true, immediateRender: false }, o.t0abs + o.alarm); }
          draw();
          if (o.end !== undefined) tl.to(`#${id}`, { opacity: 0, duration: 0.2 }, o.t0abs + o.end);
        },
      };

      // ---------- the blackboard: "วันที่ 100" chalked on the classroom board (tally marks count up, then the episode title in a chalk circle) ----------
      GameUI.C.board = {
        html: (id, o) => `<div id="${id}" class="fboard" style="top:${o.top ?? 470}px">
          <div class="ln s" id="${id}-s">${o.label || "เหลืออีก"}</div><div class="ln b" id="${id}-b"><span class="smear"></span><span class="old">${o.old}</span>${o.day}</div><div class="ln u" id="${id}-u">${o.unit || "วัน · ตามที่วิทยุนับ"}</div>
          <div class="tally">${Array.from({ length: 5 }, () => `<i></i>`).join("")}</div>
          <div class="ln e" id="${id}-e"><span class="ep">${o.ep}</span></div>
          ${Array.from({ length: 16 }, (_, k) => `<i class="dust" data-i="${k}"></i>`).join("")}</div>`,
        anim(tl, id, t0, o) {
          const el = document.getElementById(id);
          tl.set(`#${id}`, { opacity: 1 }, t0);
          // each line is "written": revealed left to right with a chalk wipe
          [["s", 0.0, 0.3], ["b", 0.3, 0.7], ["u", 1.0, 0.35], ["e", 1.55, 0.6]].forEach(([k, at, d]) =>
            tl.fromTo(`#${id}-${k}`, { clipPath: "inset(-20px 100% -20px -10px)" }, { clipPath: "inset(-20px -10px -20px -10px)", duration: d, ease: "power1.inOut", immediateRender: false }, t0 + at));
          el.querySelectorAll(".tally i").forEach((i, k) => tl.fromTo(i, { opacity: 0, scale: 0.6 }, { opacity: 0.95, scale: 1, duration: 0.12, ease: "power2.out", immediateRender: false }, t0 + 1.1 + k * 0.08));
          el.querySelectorAll(".dust").forEach((d, k) => {
            const at = t0 + 0.35 + (k % 8) * 0.09 + (k > 7 ? 1.2 : 0);
            tl.fromTo(d, { opacity: 0.9, x: 120 + (k % 8) * 70, y: k > 7 ? 460 : 60 + (k % 3) * 40, scale: 0.6 + (k % 3) * 0.3 }, { opacity: 0, x: `+=${(k % 2 ? 30 : -30)}`, y: `+=${40 + (k % 4) * 20}`, duration: 0.6, ease: "power1.out", immediateRender: false }, at);
          });
          if (o.end !== undefined) tl.to(`#${id}`, { opacity: 0, duration: 0.2 }, o.t0abs + o.end);
        },
      };
      // ---------- ครูพิม's three rules on the board; rows appear at o.at[i]; the "แต่อย่า…" gets a red chalk underline ----------
      const CH = "#f4ecd8";
      const RULE_ICONS = [
        `<path d="M20,80h80" stroke="${CH}" stroke-width="6" stroke-linecap="round"/><path d="M34,80a26,26 0 0 1 52,0" fill="none" stroke="${CH}" stroke-width="6"/><circle cx="60" cy="80" r="12" fill="#f2c55c"/>
         <path d="M60,40v-14M34,52l-10,-10M86,52l10,-10" stroke="#f2c55c" stroke-width="5" stroke-linecap="round"/><path d="M96,102l-18,10M96,102l-14,-14" stroke="#ff8a7a" stroke-width="6" fill="none" stroke-linecap="round"/><path d="M96,102H30" stroke="#ff8a7a" stroke-width="6" stroke-linecap="round"/>`,
        `<path d="M26,70q0,-20 18,-20l10,14l10,-14q18,0 18,20v26H26z" fill="none" stroke="${CH}" stroke-width="6" stroke-linejoin="round"/><path d="M44,50V32q0,-10 10,-10t10,10v18" fill="none" stroke="${CH}" stroke-width="6"/>
         <circle cx="92" cy="34" r="18" fill="none" stroke="#ff8a7a" stroke-width="6"/><path d="M80,22l24,24" stroke="#ff8a7a" stroke-width="6" stroke-linecap="round"/><path d="M86,30q6,-4 12,0" stroke="#ff8a7a" stroke-width="3" fill="none"/>`,
        `<path d="M30,100V50l30,-14l30,14v50z" fill="none" stroke="${CH}" stroke-width="6" stroke-linejoin="round"/><path d="M60,36v64M30,70h60" stroke="${CH}" stroke-width="5"/><path d="M80,20l26,-6l-6,26" fill="none" stroke="#ff8a7a" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/><path d="M106,14L72,48" stroke="#ff8a7a" stroke-width="6" stroke-linecap="round"/><circle cx="60" cy="18" r="10" fill="none" stroke="#ff8a7a" stroke-width="5"/><path d="M53,11l14,14" stroke="#ff8a7a" stroke-width="5"/>`,
      ];
      GameUI.C.fRule = {
        html: (id, o) => `<div id="${id}" class="frule" style="top:${o.top ?? 230}px"><div class="fr-h">${o.label}</div>
          ${o.rows.map((txt, i) => `<div class="fr-r" id="${id}-r${i}"><div class="fr-i"><svg viewBox="0 0 120 120">${RULE_ICONS[i]}</svg></div><div class="fr-t"><span class="n">${i + 1}</span>${txt}</div></div>`).join("")}</div>`,
        anim(tl, id, t0, o) {
          const A = (t) => o.t0abs + t, el = document.getElementById(id);
          tl.fromTo(`#${id}`, { opacity: 0, y: -30, scale: 0.96 }, { opacity: 1, y: 0, scale: 1, duration: 0.3, ease: "back.out(1.6)", immediateRender: false }, t0);
          o.at.forEach((at, i) => {
            const r = el.querySelector(`#${id}-r${i}`);
            tl.fromTo(r, { opacity: 0, x: -30 }, { opacity: 1, x: 0, duration: 0.25, ease: "power2.out", immediateRender: false }, A(at));
            tl.fromTo(r.querySelector(".fr-t"), { clipPath: "inset(-20px 100% -20px -10px)" }, { clipPath: "inset(-20px -10px -20px -10px)", duration: 0.55, ease: "power1.inOut", immediateRender: false }, A(at));
            tl.fromTo(r.querySelector(".fr-i svg"), { scale: 0, rotation: -20 }, { scale: 1, rotation: 0, duration: 0.4, ease: "back.out(2.2)", immediateRender: false }, A(at));
            const u = r.querySelector("u"); if (u) tl.fromTo(u, { "--k": 0 }, { "--k": 1, duration: 0.3, ease: "power2.out", immediateRender: false }, A(at) + 0.6);
          });
          if (o.end !== undefined) tl.to(`#${id}`, { opacity: 0, y: -20, duration: 0.25 }, A(o.end));
        },
      };
      // ---------- the sun HUD: the sun on an arc from o.from to o.to (0..1 of the day's arc, 1 = horizon), the clock text, time left ----------
      GameUI.C.sunHud = {
        html: (id, o) => `<div id="${id}" class="fsun" style="top:${o.top ?? 140}px"><svg viewBox="0 0 380 150"><path d="M20,130A170,170 0 0 1 360,130" fill="none" stroke="rgba(244,236,216,.25)" stroke-width="8" stroke-dasharray="4 10"/>
          <path d="M10,130H370" stroke="#ff8a7a" stroke-width="5"/><text x="370" y="120" text-anchor="end" font-family="Kanit" font-weight="700" font-size="22" fill="#ff8a7a">มืด ${o.dark}</text>
          <g id="${id}-sun"><circle r="26" fill="#ffd37a"/><circle r="40" fill="#ffd37a" opacity=".25"/></g></svg>
          <div class="row"><div class="tm" id="${id}-tm">${o.t0}</div><div class="lf">ก่อนมืด<b id="${id}-lf">${o.left0}</b></div></div></div>`,
        anim(tl, id, t0, o) {
          const el = document.getElementById(id), sun = document.getElementById(`${id}-sun`), tm = document.getElementById(`${id}-tm`), lf = document.getElementById(`${id}-lf`), c = { k: 0 };
          const m = (h) => { const [a, b] = h.split(":").map(Number); return a * 60 + b; };
          const A = m(o.t0), B = m(o.t1), DK = m(o.dark), dur = (o.end ?? D("gate")) - o.t;
          tl.fromTo(`#${id}`, { opacity: 0, x: 60 }, { opacity: 1, x: 0, duration: 0.3, ease: "back.out(1.6)", immediateRender: false }, t0);
          const draw = () => {
            const k = c.k, mins = A + (B - A) * k, u = (o.from ?? 0.3) + ((o.to ?? 0.95) - (o.from ?? 0.3)) * k, a = Math.PI * (1 - u);
            sun.setAttribute("transform", `translate(${(190 + Math.cos(a) * 170).toFixed(1)},${(130 - Math.sin(a) * 170).toFixed(1)})`);
            tm.textContent = `${String(Math.floor(mins / 60)).padStart(2, "0")}:${String(Math.floor(mins % 60)).padStart(2, "0")} น.`;
            const left = DK - mins; lf.textContent = left > 0 ? `${Math.floor(left / 60)}:${String(Math.floor(left % 60)).padStart(2, "0")} ชม.` : "เลยเวลา";
            el.classList.toggle("late", left <= 0);
          };
          tl.to(c, { k: 1, duration: dur, ease: "none", immediateRender: false, onUpdate: draw }, t0);
          draw();
          if (o.end !== undefined) tl.to(`#${id}`, { opacity: 0, duration: 0.2 }, o.t0abs + o.end);
        },
      };
      // ---------- the signs on a can: three rows, each stamped with a ✗ as the narrator names it ----------
      const SIGN_ICONS = [
        `<rect x="30" y="40" width="60" height="64" rx="6" fill="#dfe3e6" stroke="#2e2a26" stroke-width="4"/><rect x="30" y="62" width="60" height="24" fill="#c8392b" opacity=".85"/><path class="a-pulse" d="M30,40q30,-34 60,0" fill="#eef2f4" stroke="#2e2a26" stroke-width="4"/>`,
        `<rect x="30" y="30" width="60" height="64" rx="6" fill="#dfe3e6" stroke="#2e2a26" stroke-width="4"/><rect x="30" y="52" width="60" height="24" fill="#2f6fb8" opacity=".85"/><path class="a-bob" d="M62,94c6,12 10,18 4,22c-8,-4 -8,-12 -4,-22z" fill="#7a5a3e"/><path d="M50,98q12,14 24,0" stroke="#7a5a3e" stroke-width="5" fill="none"/>`,
        `<rect x="30" y="46" width="60" height="60" rx="6" fill="#dfe3e6" stroke="#2e2a26" stroke-width="4"/><rect x="30" y="66" width="60" height="22" fill="#e8b830" opacity=".85"/><path d="M30,46h60" stroke="#2e2a26" stroke-width="4"/><g class="a-pulse"><circle cx="46" cy="30" r="7" fill="#f4ecd8"/><circle cx="64" cy="18" r="9" fill="#f4ecd8"/><circle cx="82" cy="30" r="6" fill="#f4ecd8"/><circle cx="60" cy="36" r="5" fill="#f4ecd8"/></g>`,
      ];
      GameUI.C.signs = {
        html: (id, o) => `<div id="${id}" class="fsigns" style="top:${o.top ?? 170}px">${o.items.map((t, i) => `<div class="row" id="${id}-r${i}"><div class="ic"><svg viewBox="0 0 120 120">${SIGN_ICONS[i]}</svg></div><div class="tx">${t}</div><b class="bad">✗</b></div>`).join("")}</div>`,
        anim(tl, id, t0, o) {
          o.at.forEach((at, i) => {
            tl.fromTo(`#${id}-r${i}`, { opacity: 0, x: -40 }, { opacity: 1, x: 0, duration: 0.25, ease: "power2.out", immediateRender: false }, o.t0abs + at);
            tl.fromTo(`#${id}-r${i} .bad`, { opacity: 0, scale: 3 }, { opacity: 1, scale: 1, duration: 0.18, ease: "power4.in", immediateRender: false }, o.t0abs + at + 0.35);
            tl.fromTo(`#${id}-r${i}`, { x: 0 }, { x: 8, duration: 0.05, repeat: 5, yoyo: true, immediateRender: false }, o.t0abs + at + 0.5);
          });
          if (o.end !== undefined) tl.to(`#${id}`, { opacity: 0, duration: 0.2 }, o.t0abs + o.end);
        },
      };
      // ---------- เจ๊หงส์'s ledger page: the end card (rows appear line by line; "คน 5" gets struck through and "6?" scrawled beside it) ----------
      GameUI.C.ledger = {
        html: (id, o) => `<div id="${id}" class="fledger" style="top:${o.top ?? 380}px"><div class="page"><div class="rings">${"<i></i>".repeat(14)}</div>
          <div class="hd"><span>สมุดบัญชี · เจ๊หงส์</span><small>${o.day}</small></div>
          ${o.rows.map(([a, b, cls], i) => `<div class="r ${cls || ""}" id="${id}-r${i}"><span>${a}</span><span class="bar"></span><b class="${cls === "red" ? "strike" : ""}">${b}</b>${cls === "red" ? `<span class="six">${o.six}</span>` : ""}</div>`).join("")}
          <div class="next" id="${id}-n">พรุ่งนี้ต้องหา:<b>${o.next}</b></div>
          <div class="cta" id="${id}-c">${o.cta}</div><i class="thumb" id="${id}-th"></i></div></div>`,
        anim(tl, id, t0, o) {
          tl.fromTo(`#${id}`, { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.3, ease: "power3.out", immediateRender: false }, t0);
          o.rows.forEach((r, i) => {
            tl.fromTo(`#${id}-r${i}`, { opacity: 0, clipPath: "inset(-10px 100% -10px -10px)" }, { opacity: 1, clipPath: "inset(-10px -10px -10px -10px)", duration: 0.3, ease: "power1.inOut", immediateRender: false }, t0 + 0.2 + i * 0.14);
            if (r[2] === "red") { tl.fromTo(`#${id}-r${i} .strike`, { "--k": 0 }, { "--k": 1, duration: 0.25, ease: "power2.in", immediateRender: false }, t0 + 0.2 + i * 0.14 + 0.3); tl.fromTo(`#${id}-r${i} .six`, { opacity: 0, scale: 2 }, { opacity: 1, scale: 1, duration: 0.2, ease: "power4.in", immediateRender: false }, t0 + 0.2 + i * 0.14 + 0.5); }
          });
          const n = t0 + 0.2 + o.rows.length * 0.14 + 0.35;
          tl.fromTo(`#${id}-n`, { opacity: 0, clipPath: "inset(-10px 100% -10px -10px)" }, { opacity: 1, clipPath: "inset(-10px -10px -10px -10px)", duration: 0.5, ease: "power1.inOut", immediateRender: false }, n);
          tl.fromTo(`#${id}-c`, { opacity: 0 }, { opacity: 1, duration: 0.3, immediateRender: false }, n + 0.4);
          tl.fromTo(`#${id}-th`, { opacity: 0, scale: 1.3 }, { opacity: 1, scale: 1, duration: 0.3, ease: "power2.in", immediateRender: false }, n + 0.6);
        },
      };
      Object.assign(GameUI.ILL, {
        toxin: `<circle cx="60" cy="60" r="44" fill="#2a1a1a" stroke="#2e2a26" stroke-width="4"/><path d="M34,52q26,-24 52,0" stroke="#f4ecd8" stroke-width="5" fill="none"/><circle cx="60" cy="50" r="8" fill="#f4ecd8"/><path d="M44,76h32M50,86h20" stroke="#f4ecd8" stroke-width="4" stroke-linecap="round"/>
          <g class="a-pulse"><path d="M12,28l20,20M32,28l-20,20" stroke="#ff5a4a" stroke-width="6" stroke-linecap="round"/></g><path d="M88,24l20,20M108,24l-20,20" stroke="#ff5a4a" stroke-width="6" stroke-linecap="round"/>`,
        trash: `<path d="M30,40h60l-6,66H36z" fill="#5b6066" stroke="#2e2a26" stroke-width="4"/><rect x="22" y="30" width="76" height="12" rx="4" fill="#3a3f45" stroke="#2e2a26" stroke-width="3"/><path d="M48,30v-8h24v8" fill="none" stroke="#2e2a26" stroke-width="4"/>
          <g class="a-bob"><rect x="44" y="-6" width="32" height="40" rx="4" fill="#dfe3e6" stroke="#2e2a26" stroke-width="3"/><path d="M44,-6q16,-16 32,0" fill="#eef2f4" stroke="#2e2a26" stroke-width="3"/></g><path d="M52,62v30M68,62v30" stroke="#2e2a26" stroke-width="3"/>`,
        lungs: `<path d="M60,20v40M60,60q-30,-10 -36,30q-4,20 16,16q22,-6 20,-40M60,60q30,-10 36,30q4,20 -16,16q-22,-6 -20,-40" fill="none" stroke="#f4ecd8" stroke-width="6" stroke-linecap="round"/><g class="a-pulse"><path d="M40,80q10,6 20,0" stroke="#ff5a4a" stroke-width="4" fill="none"/></g>`,
      });

      const shots = [];
      const add = (k, spec) => shots.push({ start: SH[k].start, dur: SH[k].dur, key: k, ...spec });
