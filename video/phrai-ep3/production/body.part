      // ferry hull drawn again on top of whoever sits in it (same outline as Phrai.ferry); flip = bow to the left
      const HULL = `<path d="M-330,-40H300Q370,-44 400,-96Q396,-30 330,10Q300,30 250,32H-300Q-350,26 -362,-10Q-366,-34 -330,-40Z" fill="#5a3b26" stroke="#2e2a26" stroke-width="4" stroke-linejoin="round"/>
          <path d="M-330,-40H300Q370,-44 400,-96" stroke="#8a5f3c" stroke-width="10" fill="none"/><path d="M-300,4H250" stroke="#3b271a" stroke-width="5"/>`;
      const hullFront = (id, x, y, s = 1, flip = false) => `<g id="${id}"><g transform="translate(${x},${y}) scale(${flip ? -s : s},${s})">${HULL}</g></g>`;
      const front = (L, gid) => { const g = document.getElementById(gid); if (g) L.act.appendChild(g); };
      // a stamp in screen space: red ring + slash over the frame
      const noStamp = (id) => `<g id="${id}" opacity="0" transform="translate(540,1000)"><circle r="300" fill="none" stroke="#e0362c" stroke-width="34" opacity=".9"/><path d="M-212,-212L212,212" stroke="#e0362c" stroke-width="34" stroke-linecap="round" opacity=".9"/></g>`;
      // straight down on the river; at water level (the pier off to the left, river all across)
      const RT = (sid, o = {}) => ({ set: "riverTop", setOpts: { id: sid, ...o }, dark: 0.12 });
      const WL = (sid, o = {}) => ({ set: "pierDeck", setOpts: { id: sid, edge: -400, kt: [[1180, WS + 10, 0.5]], lamps: false, ...o }, dark: 0.3 });
      // the face-down swimmer's stroke cycle: arm poses swap, kicks alternate
      const strokes = (tl, sid, t0, dur, p = 0.34) => { for (let t = 0, k = 0; t < dur; t += p, k++) { const a = k % 2 ? 0 : 1;
        tl.set(`#${sid}-stA`, { opacity: a }, t0 + t); tl.set(`#${sid}-stB`, { opacity: 1 - a }, t0 + t); tl.set(`#${sid}-kick`, { opacity: a }, t0 + t); tl.set(`#${sid}-kick2`, { opacity: 1 - a }, t0 + t); } };
      // floating face up: the chest rises and falls; the hands scull (each arm pivots at its shoulder)
      const breathe = (tl, sid, t0, dur, per = 2.6) => tl.fromTo(`#${sid}-chest`, { scaleY: 1 }, { scaleY: 1.05, svgOrigin: "0 -90", duration: per / 2, repeat: Math.ceil(dur / (per / 2)), yoyo: true, ease: "sine.inOut", immediateRender: false }, t0);
      const scull = (tl, sid, t0, dur, amp = 7, per = 0.9) => [["aL", -84], ["aR", 84]].forEach(([a, sx], i) =>
        tl.fromTo(`#${sid}-${a}`, { attr: { transform: `rotate(${-amp * (i ? -1 : 1)} ${sx} -200)` } }, { attr: { transform: `rotate(${amp * (i ? -1 : 1)} ${sx} -200)` }, duration: per / 2, repeat: Math.ceil(dur / (per / 2)), yoyo: true, ease: "sine.inOut", immediateRender: false }, t0));
      const bob = (x, y0, y1, dur, per = 1.2, t0 = 0) => { const p = [{ t: 0, x, y: y0 }]; for (let t = t0 + per / 2, k = 1; t < dur + per; t += per / 2, k++) p.push({ t, x, y: k % 2 ? y1 : y0 }); return p; };

      // ---------- 0. EP.2's last image: แพรว's head above the river, the pale face rising behind her ----------
      add("recap", {
        ...WL("pd0"),
        cam: { keys: [{ t: 0, ...fr(560, 1560, 1.2, 540, 1000), drift: { s: 0.04 } }] },
        actors: [PRAEW(560, WS + 360, 1.0, [{ t: 0, mode: "flail", eyes: "wide", mouth: "o" }])],
        extra(L) { put(L.act, `<g id="pd0-ph" opacity=".7">${Phrai.drownedFace(760, WS + 330, 0.8)}</g>`); },
        fx(tl, id, t0, L) { TOP(L, "pd0"); Fx.heart(tl, t0, D("recap"), 0.38, 0.8); Fx.glitch(tl, `#${id}`, t0 + D("recap") - 0.35, 0.35, 22, 701); },
      });

      // ---------- 1. top-down: thrashing far out, the bank only a line of lights — stamped out · EP.3 ----------
      const H2 = F("hook", 1, 0);
      add("hook", {
        ...RT("rt1", { pose: "prone", x: 540, y: 1300, rot: -8, s: 0.8, bank: -380, kt: [[160, 420, 0.7], [960, 1900, 0.8], [880, 300, 0.5]] }),
        cam: { keys: [{ t: 0, ...fr(540, 820, 0.55, 540, 960), drift: { s: 0.03 } }] },
        captions: caps("hook"),
        extra(L) { put(L.light, noStamp("h1-no")); },
        fx(tl, id, t0) {
          strokes(tl, "rt1", t0, D("hook"), 0.3);
          tl.fromTo("#rt1-swo", { x: 0, y: 0 }, { x: 70, y: -90, duration: D("hook"), ease: "none", immediateRender: false }, t0);
          tl.fromTo("#h1-no", { opacity: 0, scale: 1.6, svgOrigin: "0 0" }, { opacity: 1, scale: 1, svgOrigin: "0 0", duration: 0.18, ease: "power4.in", immediateRender: false }, t0 + H2);
          Fx.punch(tl, `#${id} .stage`, t0 + H2 + 0.18, 1.06, 0.4); Fx.glitch(tl, `#${id}`, t0 + H2 + 0.18, 0.25, 14, 702);
          document.getElementById(id).insertAdjacentHTML("beforeend", `<div class="op" id="${id}-t" style="top:250px"><div class="op-ep"><b>EP.3</b><span>ให้นอนหงาย</span></div></div>`);
          tl.fromTo(`#${id}-t .op-ep`, { opacity: 0, scale: 1.8 }, { opacity: 1, scale: 1, duration: 0.16, ease: "power4.in", immediateRender: false }, t0 + 0.3);
          tl.to(`#${id}-t .op-ep`, { opacity: 0, y: -30, duration: 0.3 }, t0 + 2.6);
          Fx.heart(tl, t0 + 0.5, D("hook") - 0.5, 0.5, 0.4);
        },
      });

      // ---------- 2. top-down close, tracking: freestyle flat out toward the lights ----------
      add("swim", {
        ...RT("rt2", { pose: "prone", x: 540, y: 1150, rot: -3, s: 1.0, kt: [[180, 400, 0.8], [980, 1500, 0.9], [60, 1900, 0.7]] }),
        cam: { keys: [{ t: 0, ...fr(540, 1050, 0.95, 540, 1000), drift: { y: 160, s: 0.01 } }] },
        captions: caps("swim"),
        fx(tl, id, t0) { strokes(tl, "rt2", t0, D("swim"), 0.26); tl.fromTo("#rt2-swo", { y: 0 }, { y: -170 * D("swim") / 0.95, duration: D("swim"), ease: "none", immediateRender: false }, t0); },
      });

      // ---------- 3. water level: her head dipping, water in her mouth ----------
      add("tired", {
        ...WL("pd3"),
        cam: { keys: [{ t: 0, ...fr(560, WS - 120, 1.45, 540, 1000), drift: { s: 0.03 } }] },
        shake: (t) => ({ x: 4 * Math.sin(t * 3.1), y: 14 * Math.sin(t * 2.2), r: 1.2 * Math.sin(t * 1.7) }),
        actors: [PRAEW(560, WS + 380, 1.0, [{ t: 0, mode: "gasp", eyes: "wide", mouth: "o" }, { t: F("tired", 0, 2), mode: "gasp", eyes: "pain", mouth: "scream" }],
          { path: bob(560, WS + 380, WS + 520, D("tired") + 1, 1.1, 0.3) })],
        captions: caps("tired"),
        extra(L) { put(L.act, splash("t3-sp", 560, WS, 0.8) + splash("t3-sp2", 470, WS, 0.6)); },
        fx(tl, id, t0, L) {
          TOP(L, "pd3"); L.act.appendChild(document.getElementById("t3-sp")); L.act.appendChild(document.getElementById("t3-sp2"));
          [0.8, 1.9, 3.0, 4.1].forEach((d, k) => pop(tl, k % 2 ? "#t3-sp2" : "#t3-sp", t0 + d));
          Fx.heart(tl, t0 + F("tired", 0, 1), D("tired") - F("tired", 0, 1), 0.42, 0.55);
        },
      });

      // ---------- 4. under the river looking up: her legs kicking; the drowned woman rising toward them ----------
      add("call", {
        set: "underRiver", setOpts: { id: "ur4", surface: 300 }, dark: 0.12,
        cam: { keys: [{ t: 0, ...fr(540, 1000, 1.0, 540, 960), drift: { s: 0.05 } }] },
        captions: caps("call", undefined, { quote: true }),
        extra(L) {
          const leg = (x0, x1, sid) => `<g id="${sid}"><path d="M${x0},120L${x1},700" stroke="#2e2a26" stroke-width="80" stroke-linecap="round"/><path d="M${x0},120L${x1},700" stroke="#2b3d5e" stroke-width="68" stroke-linecap="round"/>
            <path d="M${x1},690L${x1 + 6},800" stroke="#2e2a26" stroke-width="52" stroke-linecap="round"/><path d="M${x1},690L${x1 + 6},800" stroke="#e8b48a" stroke-width="42" stroke-linecap="round"/><ellipse cx="${x1 + 10}" cy="840" rx="30" ry="46" fill="#e8b48a" stroke="#2e2a26" stroke-width="4"/></g>`;
          put(L.set, `<g opacity=".92">${leg(470, 450, "c4-l1")}${leg(600, 630, "c4-l2")}<rect x="400" y="60" width="290" height="160" rx="60" fill="#f2f0ea" stroke="#2e2a26" stroke-width="4"/></g>`);
          put(L.act, `<g id="c4-face">${Phrai.drownedFace(560, 1500, 1.5)}</g>`);
        },
        fx(tl, id, t0) {
          tl.fromTo("#c4-l1", { rotation: -8, svgOrigin: "470 120" }, { rotation: 8, svgOrigin: "470 120", duration: 0.22, repeat: Math.ceil(D("call") / 0.22), yoyo: true, ease: "sine.inOut", immediateRender: false }, t0);
          tl.fromTo("#c4-l2", { rotation: 8, svgOrigin: "600 120" }, { rotation: -8, svgOrigin: "600 120", duration: 0.22, repeat: Math.ceil(D("call") / 0.22), yoyo: true, ease: "sine.inOut", immediateRender: false }, t0);
          tl.fromTo("#c4-face", { y: 160 }, { y: -560, duration: D("call"), ease: "power1.inOut", immediateRender: false }, t0);
          tl.fromTo("#ur4-arms", { y: 300 }, { y: -120, duration: D("call"), ease: "power1.out", immediateRender: false }, t0);
          Fx.heart(tl, t0 + vo("call"), D("call") - vo("call"), 0.42, 0.6);
          Fx.glitch(tl, `#${id}`, t0 + F("call", 0, 1), 0.2, 10, 704);
        },
      });

      // ---------- 5. under: the pale hand closes on her ankle — and pulls ----------
      const GR = (j) => F("grab", 0, j);
      add("grab", {
        set: "ankleGrab", setOpts: { id: "ag5" }, dark: 0.1,
        cam: { keys: [{ t: 0, ...fr(580, 980, 0.95, 540, 960), drift: { s: 0.05 } }] },
        shake: (t) => (t > GR(2) && t < GR(2) + 0.6 ? 18 * Math.sin(t * 61) * (GR(2) + 0.6 - t) / 0.6 : 0),
        captions: caps("grab"),
        fx(tl, id, t0) {
          tl.fromTo("#ag5-leg", { rotation: -5, svgOrigin: "420 -400" }, { rotation: 5, svgOrigin: "420 -400", duration: 0.2, repeat: Math.ceil(GR(1) / 0.2), yoyo: true, ease: "sine.inOut", immediateRender: false }, t0);
          tl.fromTo("#ag5-hand", { y: 520 }, { y: 0, duration: GR(1) - 0.05, ease: "power2.out", immediateRender: false }, t0);
          tl.fromTo("#ag5-fing", { scaleX: 0.35, svgOrigin: "660 960" }, { scaleX: 1, svgOrigin: "660 960", duration: 0.16, ease: "back.out(2)", immediateRender: false }, t0 + GR(1));
          tl.to(["#ag5-leg", "#ag5-hand"], { y: "+=380", duration: 0.5, ease: "power3.in" }, t0 + GR(2));
          Fx.punch(tl, `#${id} .stage`, t0 + GR(1), 1.08, 0.3); Fx.glitch(tl, `#${id}`, t0 + GR(1), 0.25, 16, 705);
          tl.fromTo("#fxred", { opacity: 0.6 }, { opacity: 0, duration: 0.6, immediateRender: false }, t0 + GR(2));
          Fx.heart(tl, t0 + GR(1), D("grab") - GR(1), 0.36, 0.7);
        },
      });

      // ---------- 6. water level: her face going under ----------
      add("sink", {
        ...WL("pd6"),
        cam: { keys: [{ t: 0, ...fr(560, WS - 80, 1.5, 540, 1000), drift: { s: 0.04 } }] },
        shake: (t) => 8 * Math.sin(t * 40) * Math.max(0, 1 - t),
        actors: [PRAEW(560, WS + 380, 1.0, [{ t: 0, mode: "gasp", eyes: "wide", mouth: "scream" }], { path: [{ t: 0, x: 560, y: WS + 380 }, { t: 0.5, x: 560, y: WS + 430 }, { t: 1.5, x: 560, y: WS + 860 }, { t: 9, x: 560, y: WS + 860 }] })],
        captions: caps("sink"),
        extra(L) { put(L.act, splash("s6-sp", 560, WS, 1.0) + `<g id="s6-bub">${[0, 1, 2, 3, 4, 5].map((k) => `<circle class="bub" data-i="${k}" cx="${520 + (k % 3) * 40}" cy="${WS + 40 + k * 20}" r="${8 + (k % 3) * 5}" fill="none" stroke="#dfeaff" stroke-width="4"/>`).join("")}</g>`); },
        fx(tl, id, t0, L) { TOP(L, "pd6"); front(L, "s6-sp"); front(L, "s6-bub"); pop(tl, "#s6-sp", t0 + 1.2); Fx.heart(tl, t0, D("sink"), 0.36, 0.7); },
      });

      // ---------- 7. flash back to EP.1: ยาย on the porch, the rule card — line three lights up ----------
      add("memory", {
        set: "porch", setOpts: { id: "po7", time: "night", tray: { x: -380 } }, dark: 0.12, blur: { far: 4, mid: 4, set: 3 },
        cam: { keys: [{ t: 0, ...fr(160, 1280, 0.78, 540, 1300), drift: { s: 0.02 } }] },
        actors: [YAI(-60, G, 1.15, [{ t: 0, mode: "sit", eyes: "normal", mouth: "o" }]),
          PRAEW(250, G, 1.1, [{ t: 0, mode: "sit", eyes: "side", mouth: "flat" }], { flip: true }),
          TONG(450, G, 0.85, [{ t: 0, mode: "sit", eyes: "side", mouth: "smile" }], { flip: true })],
        captions: caps("memory", undefined, { quote: true }),
        ui: [{ type: "koiRule", t: 0.05, label: "กฎของยายเพิ่ม", rows: RULE_ROWS("#2e2a26"), at: [0.1, 0.2, F("memory", 0, 1) - 0.05], top: 170 }],
        fx(tl, id, t0) {
          Fx.desat(tl, `#${id} .stage`, t0, undefined, 0.15);
          tl.fromTo(`#${id}`, { opacity: 0.2 }, { opacity: 1, duration: 0.35, immediateRender: false }, t0);
          tl.set(`#${id} .kr-r`, { opacity: 0.35 }, t0 + F("memory", 0, 1) - 0.06);
          tl.fromTo(`#${id}-g0-r2`, { opacity: 0.35, scale: 1 }, { opacity: 1, scale: 1.06, duration: 0.25, ease: "back.out(2)", immediateRender: false }, t0 + F("memory", 0, 1));
          Fx.glitch(tl, `#${id}`, t0 + 0.05, 0.2, 8, 707);
        },
      });

      // ---------- 8. water level: she stops fighting — mouth up out of the water, breathing ----------
      const MO = (j) => F("mouth", 0, j);
      add("mouth", {
        ...WL("pd8"),
        cam: { keys: [{ t: 0, ...fr(560, WS - 80, 1.3, 540, 1100), drift: { s: 0.02 } }] },
        shake: (t) => ({ x: 0, y: 8 * Math.sin(t * 1.6), r: 0.6 * Math.sin(t * 1.1) }),
        actors: [PRAEW(560, WS + 480, 1.0, [{ t: 0, mode: "gasp", eyes: "wide", mouth: "o" }, { t: MO(1), mode: "tread", eyes: "normal", mouth: "o" }, { t: MO(3), mode: "tread", eyes: "closed", mouth: "o" }],
          { path: [{ t: 0, x: 560, y: WS + 480 }, { t: MO(1), x: 560, y: WS + 470 }, { t: MO(2) + 0.6, x: 560, y: WS + 360 }, { t: 9, x: 560, y: WS + 370 }] })],
        captions: caps("mouth"),
        ui: [steps("mouth", "ตกน้ำ", [["noswim", "อย่าเพิ่งรีบว่าย"], ["mouthup", "เอาปากพ้นน้ำ"]], MO(1) - 0.1, D("mouth") - 0.15, { gap: MO(2) - MO(1) })],
        fx(tl, id, t0, L) { TOP(L, "pd8"); },
      });

      // ---------- 9. top-down: over onto her back, arms out, the hands sculling ----------
      const FL = (j) => F("float", 0, j);
      add("float", {
        ...RT("rt9", { pose: "supine", x: 540, y: 1100, rot: 8, s: 1.0, face: "open", kt: [[160, 380, 0.7], [960, 1650, 0.8]] }),
        cam: { keys: [{ t: 0, ...fr(540, 980, 0.9, 540, 1050), drift: { s: 0.025 } }] },
        captions: caps("float"),
        ui: [steps("float", "พลิกตัว", [["floatback", "นอนหงาย ลอยตัว"], ["paddle", "พายมือเบาๆ"]], FL(0) - 0.1, D("float") - 0.15, { gap: FL(2) - FL(0) })],
        extra(L) { put(L.set, `<g id="f9-ring" opacity="0"><ellipse cx="540" cy="1000" rx="300" ry="420" fill="none" stroke="#dfeaff" stroke-width="10"/></g>`); },
        fx(tl, id, t0) {
          tl.fromTo("#f9-ring", { opacity: 0.9, scale: 0.7, svgOrigin: "540 1000" }, { opacity: 0, scale: 1.5, svgOrigin: "540 1000", duration: 1.2, immediateRender: false }, t0);
          tl.fromTo("#rt9-sw", { opacity: 0.4 }, { opacity: 1, duration: 0.4, immediateRender: false }, t0);
          breathe(tl, "rt9", t0, D("float")); scull(tl, "rt9", t0 + FL(2) - 0.1, D("float") - FL(2) + 0.1);
        },
      });

      // ---------- 10. top-down wide: the ladder far off on the bank, a gallon nearer — then swim, hold on, shout ----------
      const TH = (j) => F("then", 0, j);
      add("then", {
        ...RT("rt10", { pose: "supine", x: 600, y: 1320, rot: -14, s: 0.55, face: "open", bank: 200, gal: { x: 180, y: 820, r: 30, s: 0.7 }, kt: [[920, 900, 0.5], [120, 1700, 0.6]] }),
        cam: { keys: [{ t: 0, ...fr(540, 980, 0.62, 540, 980), drift: { s: 0.02 } }] },
        captions: caps("then"),
        extra(L) {
          // a small landing with a ladder sticking out from the bank (seen from above)
          put(L.set, `<g><rect x="760" y="80" width="200" height="300" fill="url(#phPlank)" stroke="#2e2a26" stroke-width="4"/>${[0, 1, 2, 3].map((k) => `<path d="M770,${120 + k * 70}H950" stroke="#241810" stroke-width="5"/>`).join("")}
            <path d="M820,380V470M900,380V470M820,410H900M820,445H900" stroke="#4a3424" stroke-width="10"/></g>`);
          const arrow = (sid, d) => `<path id="${sid}" d="${d}" stroke="#3fb86a" stroke-width="14" fill="none" stroke-linecap="round" stroke-dasharray="1400" stroke-dashoffset="1400"/>`;
          put(L.act, arrow("t10-a1", "M640,1080Q760,760 860,500") + arrow("t10-a2", "M520,1120Q330,1000 230,880"));
        },
        ui: [steps("then", "หายใจได้แล้ว", [["toexit", "ว่ายไปหาทางขึ้น"], ["holdfloat", "หรือของที่ลอยได้"], ["shout", "ร้องขอความช่วยเหลือ"]], TH(1) - 0.1, D("then") - 0.15, { gap: (TH(3) - TH(1)) / 2 }),
          { type: "src", t: TH(3) + 0.3, end: D("then") - 0.05, top: 1640, text: "ที่มา: <em>RLSS UK</em> · ตกน้ำ ให้เอาปากพ้นน้ำ นอนหงายลอยตัวหรือพายมือจนหายใจได้ แล้วว่ายไปหาทางขึ้นหรือของที่ลอยได้ พร้อมร้องขอความช่วยเหลือ" }],
        fx(tl, id, t0) {
          breathe(tl, "rt10", t0, D("then")); scull(tl, "rt10", t0, D("then"));
          tl.to("#t10-a1", { attr: { "stroke-dashoffset": 0 }, duration: 0.6, ease: "power2.out" }, t0 + TH(1));
          tl.to("#t10-a2", { attr: { "stroke-dashoffset": 0 }, duration: 0.6, ease: "power2.out" }, t0 + TH(2));
        },
      });

      // ---------- 11. POV: on her back, the full moon, the river lapping over the lens; breathing ----------
      add("moon", {
        set: "moonPOV", setOpts: { id: "mp11" }, dark: 0.05,
        cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960), drift: { s: 0.012 } }] },
        shake: (t) => ({ x: 6 * Math.sin(t * 0.9), y: 12 * Math.sin(t * 1.5), r: 1.6 * Math.sin(t * 0.8) }),
        captions: caps("moon"),
        fx(tl, id, t0) {
          tl.fromTo("#mp11-lap", { y: 30 }, { y: -40, duration: 1.3, repeat: Math.ceil(D("moon") / 1.3), yoyo: true, ease: "sine.inOut", immediateRender: false }, t0);
          tl.fromTo(`#${id} .stage`, { filter: "brightness(.9)" }, { filter: "brightness(1.08)", duration: 1.3, repeat: Math.ceil(D("moon") / 1.3), yoyo: true, ease: "sine.inOut", immediateRender: false }, t0 + F("moon", 0, 2));
        },
      });

      // ---------- 12. under: the hand lets go and sinks back into the dark ----------
      add("loose", {
        set: "ankleGrab", setOpts: { id: "ag12" }, dark: 0.1,
        cam: { keys: [{ t: 0, ...fr(580, 1040, 0.9, 540, 960), drift: { s: 0.02 } }] },
        captions: caps("loose"),
        fx(tl, id, t0) {
          tl.to("#ag12-fing", { scaleX: 0.3, svgOrigin: "660 960", duration: 1.0, ease: "power1.inOut" }, t0 + F("loose", 0, 1) - 0.3);
          tl.to("#ag12-hand", { y: 900, opacity: 0.15, duration: 1.8, ease: "power1.in" }, t0 + F("loose", 0, 1) + 0.4);
          tl.to(`#${id} .pface`, { opacity: 0, duration: 1.4 }, t0 + F("loose", 0, 1) + 0.4);
        },
      });

      // ---------- 13. top-down: the gallon she threw for โต้ง drifts in; she takes hold ----------
      const GA = (j) => F("gallon", 0, j);
      add("gallon", {
        ...RT("rt13", { pose: "supine", x: 560, y: 1150, rot: 4, s: 0.9, face: "open", gal: { x: 1240, y: 640, r: -30, s: 0.9 }, kt: [[160, 420, 0.7], [180, 1750, 0.6]] }),
        cam: { keys: [{ t: 0, ...fr(640, 1000, 0.8, 540, 1000), drift: { s: 0.02 } }, { t: GA(1), glide: 1.2, ...fr(800, 940, 1.0, 540, 1000), drift: { s: 0.02 } }] },
        captions: caps("gallon"),
        fx(tl, id, t0) {
          breathe(tl, "rt13", t0, D("gallon"));
          tl.fromTo("#rt13-gal", { x: 0, y: 0 }, { x: -320, y: 430, duration: GA(2) + 0.6, ease: "sine.out", immediateRender: false }, t0);
          tf(tl, "#rt13-aR", t0 + GA(2) + 0.2, 0.5, "rotate(-28 84 -200)", "power2.out");
          Fx.heart(tl, t0, D("gallon"), 0.7, 0.25);
        },
      });

      // ---------- 14. water level: arms over the gallon, shouting ----------
      add("help", {
        ...WL("pd14"),
        cam: { keys: [{ t: 0, ...fr(600, WS - 120, 1.25, 540, 1000), drift: { s: 0.04 } }] },
        shake: (t) => ({ x: 0, y: 6 * Math.sin(t * 1.8), r: 0 }),
        actors: [PRAEW(560, WS + 380, 1.0, [{ t: 0, mode: "holdGal", eyes: "wide", mouth: "flat" }, { t: vo("help"), mode: "galWave", eyes: "wide", mouth: "scream" }])],
        captions: caps("help", undefined, { quote: true }),
        extra(L) { put(L.act, `<g id="h14-gal"><g transform="translate(660,${WS - 20})">${Phrai.gallon(0, 0, 1.1, -8)}</g></g>`); },
        fx(tl, id, t0, L) { front(L, "h14-gal"); TOP(L, "pd14"); tl.fromTo("#h14-gal", { y: -6 }, { y: 8, duration: 0.9, repeat: Math.ceil(D("help") / 0.9), yoyo: true, ease: "sine.inOut", immediateRender: false }, t0); Fx.punch(tl, `#${id} .stage`, t0 + vo("help"), 1.05, 0.3); },
      });

      // ---------- 15. out of the dark: the ferry's lamp, ตาเหม holding the oar out to her ----------
      const OA = F("oar", 0, 1);
      add("oar", {
        ...WL("pd15"),
        cam: { keys: [{ t: 0, ...fr(780, WS - 60, 0.85, 540, 1000), drift: { s: 0.03 } }] },
        actors: [PRAEW(420, WS + 380, 0.95, [{ t: 0, mode: "holdGal", eyes: "wide", mouth: "o" }, { t: OA + 0.3, mode: "grabUp", eyes: "wide", mouth: "o" }]),
          MHEM(1180, WS - 40, 0.85, [{ t: 0, mode: "oarOut", eyes: "normal", mouth: "flat" }], { flip: true })],
        captions: caps("oar"),
        extra(L) {
          put(L.set, `<g id="o15-boat"><g transform="translate(1260,${WS + 20}) scale(-1,1)">${Phrai.ferry(0, 0, 1.0, { lamp: true, oar: false })}</g></g>`);
          put(L.act, `<g id="o15-gal"><g transform="translate(500,${WS - 20})">${Phrai.gallon(0, 0, 1.0, -8)}</g></g><g id="o15-oar" opacity="0">${Phrai.bamboo(1060, WS - 230, 560, WS - 150, 16)}</g>` + hullFront("o15-hull", 1260, WS + 20, 1.0, true));
          put(L.glow, `<g id="o15-lg"><circle cx="930" cy="${WS - 150}" r="320" fill="url(#phBulb)"/></g>`);
        },
        fx(tl, id, t0, L) {
          front(L, "o15-gal"); front(L, "o15-oar"); front(L, "o15-hull"); TOP(L, "pd15");
          ["#o15-boat", "#o15-hull", "#o15-lg", `#${id}-a1`].forEach((s) => tl.fromTo(s, { opacity: 0 }, { opacity: 1, duration: 0.9, immediateRender: false }, t0 + 0.1));
          tl.fromTo("#o15-oar", { opacity: 0, x: 220 }, { opacity: 1, x: 0, duration: 0.5, ease: "power2.out", immediateRender: false }, t0 + OA);
        },
      });

      // ---------- 16. ตาเหม close, the lamp under his face: "hold on" ----------
      add("hold", {
        set: "riverNight", setOpts: { id: "r16", kt: [[120, 1240, 0.45], [980, 1300, 0.5], [-60, 1420, 0.6]] }, dark: 0.3, blur: { far: 6, set: 6 },
        cam: { keys: [{ t: 0, ...fr(560, G + 1300 - 530 * 2.3, 1.0, 540, 980), drift: { s: 0.05 } }] },
        actors: [MHEM(560, G + 1300, 2.3, [{ t: 0, mode: "oarOut", eyes: "normal", mouth: "o" }, { t: voEnd("hold"), mode: "oarOut", eyes: "normal", mouth: "flat" }], { flip: true })],
        captions: caps("hold", undefined, { quote: true }),
        extra(L) { put(L.light, `<circle cx="540" cy="1500" r="700" fill="url(#phBulb)" opacity=".55"/>`); },
      });

      // ---------- 17. the hospital landing: she climbs out; the ferry at the steps ----------
      add("land", {
        set: "pierDeck", setOpts: { id: "pd17", boat: { x: 940, lamp: true, oar: false }, props: Phrai3.hosp(G), lamps: false }, dark: 0.22,
        cam: { keys: [{ t: 0, ...fr(260, 1180, 0.58, 540, 1100), drift: { s: 0.025 } }] },
        actors: [PRAEW(E + 40, WS + 200, 1.0, [{ t: 0, mode: "grabUp", eyes: "wide", mouth: "o" }, { t: 1.1, mode: "walk", eyes: "side", mouth: "flat" }, { t: 2.2, mode: "idle", eyes: "side", mouth: "flat" }],
            { flip: true, path: [{ t: 0, x: E + 40, y: WS + 200 }, { t: 1.0, x: E + 20, y: G }, { t: 2.2, x: 260, y: G }, { t: 9, x: 260, y: G }] }),
          MHEM(880, WS - 30, 0.9, [{ t: 0, mode: "sit", eyes: "normal", mouth: "flat" }], { flip: true })],
        captions: caps("land"),
        extra(L) { put(L.act, hullFront("l17-hull", 940, WS + 20, 0.9)); put(L.glow, Phrai3.hospGlow(G)); },
        fx(tl, id, t0, L) { TOP(L, "pd17"); front(L, "l17-hull"); },
      });

      // ---------- 18. the ward at sunrise: ยาย comes in; โต้ง asleep; แพรว on the chair ----------
      const WARD = (sid, o = {}) => ({ set: "ward", setOpts: { id: sid, ...o }, dark: 0.04 });
      const BT = G - 330;
      add("dawn", {
        ...WARD("wd18"),
        cam: { keys: [{ t: 0, ...fr(420, 1080, 0.6, 540, 1080), drift: { s: 0.02 } }] },
        actors: [TONG(700, BT, 0.85, [{ t: 0, mode: "sleep", eyes: "closed", mouth: "flat" }]),
          PRAEW(960, G, 1.0, [{ t: 0, mode: "leanIn", eyes: "closed", mouth: "flat" }, { t: F("dawn", 0, 1) + 0.3, mode: "sitChair", eyes: "side", mouth: "o" }], { flip: true }),
          YAI(-560, G, 1.05, [{ t: 0, mode: "walk", eyes: "wide", mouth: "o" }, { t: 1.9, mode: "idle", eyes: "normal", mouth: "flat" }], { moveTo: { x: -230, y: G, dur: 1.9, at: F("dawn", 0, 1) - 0.4, ease: "power1.out" } })],
        captions: caps("dawn"),
        fx(tl, id, t0, L) { front(L, "wd18-blanket"); L.act.appendChild(document.getElementById(`${id}-a1`)); },
      });

      // ---------- 19. แพรว close: "ตาเหม saved me" ----------
      add("tell", {
        ...WARD("wd19"), blur: { set: 6, mid: 6 },
        cam: { keys: [{ t: 0, ...fr(900, G + 1300 - 530 * 2.3, 1.0, 560, 980), drift: { s: 0.05 } }] },
        actors: [PRAEW(900, G + 1300, 2.3, [{ t: 0, mode: "idle", eyes: "side", mouth: "o" }, { t: voEnd("tell"), mode: "idle", eyes: "side", mouth: "flat" }], { flip: true })],
        captions: caps("tell", undefined, { quote: true }),
      });

      // ---------- 20. ยาย close: "ตาเหม died when I was a girl" ----------
      add("dead", {
        ...WARD("wd20"), blur: { set: 6, mid: 6 },
        cam: { keys: [{ t: 0, ...fr(300, G + 1300 - 530 * 2.3, 1.0, 520, 980), drift: { s: 0.03 } }, { t: F("dead", 0, 1), ...fr(300, G + 1300 - 530 * 2.3, 1.25, 520, 980), drift: { s: 0.04 } }] },
        actors: [YAI(300, G + 1300, 2.3, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }, { t: voEnd("dead"), mode: "idle", eyes: "wide", mouth: "flat" }])],
        captions: caps("dead", undefined, { quote: true }),
        fx(tl, id, t0) { Fx.punch(tl, `#${id} .stage`, t0 + F("dead", 0, 1), 1.06, 0.4); Fx.glitch(tl, `#${id}`, t0 + F("dead", 0, 1), 0.3, 14, 720); tl.fromTo("#fxred", { opacity: 0.45 }, { opacity: 0, duration: 0.6, immediateRender: false }, t0 + F("dead", 0, 1)); Fx.heart(tl, t0 + F("dead", 0, 1), D("dead") - F("dead", 0, 1), 0.45, 0.6); },
      });

      // ---------- 21. shadow puppets: the young ferryman dives in bare-handed; the child clings; both go down ----------
      const LG = (j) => F("legend", 0, j);
      add("legend", {
        set: "mhemLegend", setOpts: { id: "ml" }, dark: 0.05,
        cam: { keys: [{ t: 0, ...fr(540, 450, 1.2, 540, 760), drift: { s: 0.02 } }, { t: LG(2) - 0.1, glide: 0.7, ...fr(540, 2050, 1.2, 540, 760), drift: { s: 0.03 } }] },
        captions: caps("legend"),
        fx(tl, id, t0) {
          Koi.life(tl, `#${id}`, t0, D("legend"));
          tl.fromTo("#ml-kid", { y: 0 }, { y: 18, duration: 0.3, repeat: Math.ceil(LG(2) / 0.3), yoyo: true, immediateRender: false }, t0);
          tf(tl, "#ml-dive", t0 + LG(1), 0.8, "translate(700,560) rotate(70)", "power2.in");
          tl.to("#ml-dive", { opacity: 0, duration: 0.15 }, t0 + LG(1) + 0.8);
          tl.fromTo("#ml-pair", { y: -120 }, { y: 200, duration: D("legend") - LG(2), ease: "sine.in", immediateRender: false }, t0 + LG(2));
          tl.to("#ml-pair", { opacity: 0.25, duration: 1.0 }, t0 + LG(3) + 0.6);
          tl.fromTo("#ml-oar", { x: 0 }, { x: 60, duration: D("legend"), ease: "none", immediateRender: false }, t0);
        },
      });

      // ---------- 22. sunrise on the river: ตาเหม in his ferry lifts a hand — and is gone ----------
      add("every", {
        set: "riverNight", setOpts: { id: "r22", dusk: true, kt: [[120, 1240, 0.45], [980, 1300, 0.5]], boat: { x: 560, y: 1330, s: 1.0, lamp: true, oar: false } }, dark: 0.08,
        cam: { keys: [{ t: 0, ...fr(560, 1180, 0.95, 540, 1050), drift: { s: 0.02 } }] },
        actors: [MHEM(380, 1305, 0.8, [{ t: 0, mode: "sit", eyes: "normal", mouth: "flat" }, { t: F("every", 0, 1), mode: "wave", eyes: "normal", mouth: "smile" }])],
        captions: caps("every"),
        extra(L) { put(L.act, hullFront("e22-hull", 560, 1330, 1.0) + `<g id="e22-oar">${Phrai.bamboo(480, 1100, 820, 1420, 12)}</g>`); },
        fx(tl, id, t0, L) {
          front(L, "e22-oar"); front(L, "e22-hull");
          tl.to(`#${id}-a0`, { opacity: 0, duration: 1.4, ease: "power1.in" }, t0 + D("every") - 1.6);
        },
      });

      // ---------- 23. knowledge again, at the pier in the morning: shout, throw, reach — never go in empty-handed ----------
      const KN = (j) => F("know", 0, j);
      add("know", {
        set: "riverNight", setOpts: { id: "r23", dusk: true, kt: [[980, 1300, 0.5]], pier: { y: 1300, x0: -900, x1: 520 } }, dark: 0.06,
        cam: { keys: [{ t: 0, ...fr(420, 1100, 0.85, 540, 1150), drift: { s: 0.02 } }] },
        actors: [PRAEW(260, 1300, 0.85, [{ t: 0, mode: "idle", eyes: "side", mouth: "flat" }, { t: KN(2), mode: "poleLow", eyes: "normal", mouth: "flat" }])],
        captions: caps("know"),
        extra(L) { put(L.act, `<g id="k23-pole" opacity="0">${Phrai.bamboo(330, 1150, 760, 1420, 14)}</g><g transform="translate(120,1270)">${Phrai.gallon(0, 0, 0.6, 0)}</g>`); },
        ui: [steps("know", "ช่วยคนจมน้ำ", [["shout", "ตะโกน"], ["throw", "โยน"], ["reach", "ยื่น"]], KN(2) - 0.1, D("know") - 0.15, { gap: 0.45 }),
          { type: "src", t: KN(2) + 0.6, end: D("know") - 0.05, top: 640, text: "ที่มา: <em>กรมควบคุมโรค</em> · ช่วยคนตกน้ำจากบนฝั่ง ตะโกน โยน ยื่น อย่ากระโดดลงไปช่วยมือเปล่า" }],
        fx(tl, id, t0) { tl.to("#k23-pole", { opacity: 1, duration: 0.25 }, t0 + KN(2)); },
      });

      // ---------- 24. the ward: โต้ง opens his eyes ----------
      add("wake", {
        ...WARD("wd24"),
        cam: { keys: [{ t: 0, ...fr(560, 1060, 1.05, 540, 1100), drift: { s: 0.035 } }] },
        actors: [TONG(700, BT, 0.85, [{ t: 0, mode: "sleep", eyes: "closed", mouth: "flat" }, { t: 0.7, mode: "sleep", eyes: "normal", mouth: "flat" }]),
          PRAEW(960, G, 1.0, [{ t: 0, mode: "leanIn", eyes: "wide", mouth: "o" }], { flip: true })],
        captions: caps("wake"),
        fx(tl, id, t0, L) { front(L, "wd24-blanket"); L.act.appendChild(document.getElementById(`${id}-a1`)); },
      });

      // ---------- 25. โต้ง close, sitting up, whispering to his sister ----------
      const WH = (j) => F("whisper", 0, j);
      add("whisper", {
        ...WARD("wd25"), blur: { set: 5, mid: 5 },
        cam: { keys: [{ t: 0, ...fr(400, BT - 260, 2.8, 540, 960), drift: { s: 0.02 } }, { t: WH(3), ...fr(400, BT - 270, 3.4, 540, 960), drift: { s: 0.03 } }] },
        actors: [TONG(400, BT, 1.0, [{ t: 0, mode: "sit", eyes: "side", mouth: "o" }, { t: WH(3), mode: "sit", eyes: "wide", mouth: "o" }, { t: voEnd("whisper"), mode: "sit", eyes: "side", mouth: "flat" }], { flip: true })],
        captions: caps("whisper", undefined, { quote: true }),
        extra(L) { put(L.light, `<rect id="w25-dim" x="-200" y="-200" width="1480" height="2320" fill="#05080f" opacity="0"/>`); },
        fx(tl, id, t0) {
          tl.to("#w25-dim", { opacity: 0.45, duration: 1.2 }, t0 + WH(2));
          Fx.heart(tl, t0 + WH(1), D("whisper") - WH(1), 0.5, 0.55);
          Fx.glitch(tl, `#${id}`, t0 + WH(3), 0.3, 14, 725); tl.fromTo("#fxred", { opacity: 0.4 }, { opacity: 0, duration: 0.7, immediateRender: false }, t0 + WH(3));
        },
      });

      // ---------- 26. แพรว's ankle on the sheet: five finger marks ----------
      add("marks", {
        set: "ankleP", setOpts: { id: "ap26", marks: 0 }, dark: 0.04,
        cam: { keys: [{ t: 0, ...fr(560, 860, 0.95, 540, 960), drift: { s: 0.05 } }] },
        captions: caps("marks"),
        fx(tl, id, t0) {
          tl.to("#ap26-marks", { opacity: 1, duration: 0.8 }, t0 + F("marks", 0, 1) - 0.2);
          Fx.punch(tl, `#${id} .stage`, t0 + F("marks", 0, 1), 1.06, 0.4); Fx.heart(tl, t0 + F("marks", 0, 1), D("marks") - F("marks", 0, 1), 0.42, 0.6);
          Fx.glitch(tl, `#${id}`, t0 + F("marks", 0, 2), 0.25, 12, 726);
        },
      });

      // ---------- 27. the river at sunrise: one krathong, its candle out; a pale hand under it — cut to black ----------
      add("last", {
        set: "riverNight", setOpts: { id: "r27", dusk: true, kt: [[540, 1400, 1.5], [140, 1220, 0.45], [960, 1260, 0.5]] }, dark: 0.12,
        cam: { keys: [{ t: 0, ...fr(540, 1300, 1.1, 540, 1050), drift: { s: 0.04 } }] },
        captions: caps("last", undefined, { quote: true }),
        extra(L) { put(L.act, `<rect x="-900" y="1480" width="2900" height="1200" fill="#1d2640" opacity=".55"/><g id="l27-ph" opacity="0">${Phrai.paleHand(560, 1700, 1.3, -6)}</g><g id="l27-face" opacity="0">${Phrai.drownedFace(700, 1880, 1.0)}</g>`); },
        fx(tl, id, t0) {
          tl.set([`#${id} .kflame`, `#${id} .kglw`], { visibility: "hidden" }, t0);
          tl.fromTo("#l27-ph", { opacity: 0, y: 120 }, { opacity: 0.7, y: 0, duration: 1.6, immediateRender: false }, t0 + vo("last"));
          tl.to("#l27-face", { opacity: 0.55, duration: 1.4 }, t0 + F("last", 0, 2) - 0.4);
          Fx.heart(tl, t0, D("last"), 0.4, 0.6); Fx.tunnel(tl, t0 + F("last", 0, 2), t0 + D("last") + 0.3, 0.7);
          Fx.glitch(tl, `#${id}`, t0 + D("last") - 0.5, 0.35, 18, 727);
          tl.set("#black", { opacity: 1 }, t0 + D("last") - 0.15);
        },
      });

      // ---------- 28. end card: the sign by the pier — ตอนจบ ----------
      add("end", {
        set: "pierSign", setOpts: { id: "sg", ep: "ตอนจบ", title: "มือพราย" }, dark: 0.08,
        cam: { keys: [{ t: 0, ...fr(540, 900, 1.0, 540, 900), drift: { s: 0.03 } }] },
        fx(tl, id, t0) {
          tl.set("#black", { opacity: 0 }, t0 + 0.3);
          tl.fromTo("#sg-sign", { attr: { transform: "rotate(-9 540 1000)" } }, { attr: { transform: "rotate(-2 540 1000)" }, duration: 1.6, ease: "elastic.out(1,0.4)", immediateRender: false }, t0 + 0.3);
          Fx.heart(tl, t0 + 0.9, D("end") - 0.9, 0.7, 0.35);
        },
      });

      shots.forEach((sh) => { const f = sh.fx; sh.fx = (tl, id, t0, L) => { if (f) f(tl, id, t0, L); Phrai.life(tl, `#${id}`, t0, sh.dur); }; });
