        shake: Pov.head({ mode: "breath" }),
        captions: caps("rule"),
        ui: [steps("rule", "ไฟไหม้", [["stairs", "ใช้บันได"], ["nolift", "อย่าใช้ลิฟต์"], ["firefighter", "เว้นแต่เจ้าหน้าที่สั่ง"]], F("rule", 0, 0) + 0.1, D("rule") - 0.15, { gap: (vo("rule", 1) - F("rule", 0, 0)) / 2 }),
          { type: "src", t: vo("rule", 1) + 0.2, end: D("rule") - 0.05, top: 640, text: "ที่มา: <em>USFA (FEMA)</em> · ใช้บันไดหนีไฟ อย่าใช้ลิฟต์ เว้นแต่เจ้าหน้าที่ดับเพลิงสั่ง" }],
      });

      // ---------- 7. แพร shoulders open the stairwell door ----------
      add("this", {
        set: "corridorSide", setOpts: { id: "cs7", smokeY: 760 }, dark: 0.45,
