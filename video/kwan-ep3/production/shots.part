        actors: [PRAE(3560, 1720, 1.3, [{ t: 0, mode: "wave", eyes: "side", mouth: "o", torch: true, sweat: true }]), YOU(3180, 1780, 1.32, [{ t: 0, mode: "walk", eyes: "side", mouth: "flat", sweat: true }], { moveTo: { x: 3380, y: 1760, dur: D("this") } })],
        captions: caps("this", undefined, { quote: true }),
        extra(L) { put(L.glow, `<ellipse cx="3700" cy="1720" rx="420" ry="90" fill="url(#pvPoolLit)" opacity=".7"/>`); },
      });

      // ---------- 8. side on, down the stairs: six, five… a burning ceiling panel falls ----------
      add("stairs", {
        set: "stairwell", setOpts: { id: "sw8", smokeY: -200 }, dark: 0.42,
        cam: { keys: [{ t: 0, ...fr(560, 250, 0.72, 540, 900), drift: { y: 120, s: 0.01 } }, { t: F("stairs", 0, 2) - 0.2, glide: 0.5, ...fr(720, 1100, 0.9, 540, 900), drift: { s: 0.03 } }] },
        // feet on the treads (user: "เดินไม่ตรงบันได"): down flight A (right), turn on the half landing, flight B (left), the landing, flight A again
        actors: [PRAE(560, 245, 1.0, [{ t: 0, mode: "walk", eyes: "side", mouth: "flat", torch: true }, { t: 3.5, mode: "tremble", eyes: "wide", mouth: "o", torch: true }],
            { path: [{ t: 0, x: 560, y: 245 }, { t: 0.6, x: 760, y: 450 }, { t: 0.8, x: 850, y: 450, flip: true }, { t: 0.95, x: 760, y: 450, flip: true }, { t: 1.95, x: 320, y: 900, flip: true },
              { t: 2.08, x: 300, y: 900 }, { t: 2.18, x: 320, y: 900 }, { t: 3.05, x: 760, y: 1350 }, { t: 3.35, x: 950, y: 1350 }, { t: 9, x: 950, y: 1350 }] }),
          YOU(330, 10, 1.0, [{ t: 0, mode: "walk", eyes: "side", mouth: "flat", sweat: true }, { t: 3.45, mode: "tremble", eyes: "wide", mouth: "o", sweat: true }],
            { path: [{ t: 0, x: 330, y: 10 }, { t: 1.1, x: 760, y: 450 }, { t: 1.3, x: 840, y: 450, flip: true }, { t: 1.45, x: 760, y: 450, flip: true }, { t: 2.65, x: 320, y: 900, flip: true },
              { t: 2.8, x: 300, y: 900 }, { t: 2.9, x: 320, y: 900 }, { t: 3.45, x: 600, y: 1182 }, { t: 9, x: 600, y: 1182 }] })],
        captions: caps("stairs"),
        fx(tl, id, t0) {
          const fall = t0 + F("stairs", 0, 2);
          // the panel (centre 490,580 in its own space) drops from under the half landing onto แพร's shoulder at x 950, then tumbles to her feet
          tl.set("#sw8-tile", { opacity: 1, attr: { transform: "translate(460,-100) rotate(0,490,580)" } }, fall - 0.4);
          tf(tl, "#sw8-tile", fall - 0.4, 0.5, "translate(460,320) rotate(-16,490,580)", "power2.in");
          tf(tl, "#sw8-tile", fall + 0.1, 0.35, "translate(560,750) rotate(24,490,580)", "power1.in");
          Fx.punch(tl, `#${id} .stage`, fall + 0.15, 1.06, 0.4); tl.fromTo("#flashw", { opacity: 0.35 }, { opacity: 0, duration: 0.2, immediateRender: false }, fall + 0.15);
        },
      });

      // ---------- 9. close: แพร's sleeve is on fire ----------
      add("onfire", {
        set: "stairwell", setOpts: { id: "sw9", smokeY: 0 }, dark: 0.38,
