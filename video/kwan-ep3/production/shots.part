        captions: caps("onfire", undefined, { quote: true }),
        fx(tl, id, t0) {
          const arm = document.getElementById(`${id}-a0-faF`);
          if (arm) arm.insertAdjacentHTML("beforeend", `<g class="flk">${[0, 1, 2, 3].map((k) => `<path d="M${-14 + k * 9},${30 + k * 22}q${-18 + k * 4},-40 ${-4 + k * 3},-80q${18 + k * 2},34 ${10},80z" fill="${k % 2 ? "#ffd24a" : "#ff7a2a"}" opacity=".95"/>`).join("")}</g><circle cx="0" cy="60" r="70" fill="url(#kwFireGlow)"/>`);
          Fx.glitch(tl, `#${id}`, t0 + 0.05, 0.2, 10, 304); tl.fromTo("#fxred", { opacity: 0.8 }, { opacity: 0, duration: 0.6, immediateRender: false }, t0 + 0.05);
        },
      });

      // ---------- 10. knowledge: stop, drop, cover your face, roll ----------
      const SDR = [vo("sdr"), vo("sdr") + SH.sdr.vo[0].frags[1], vo("sdr") + SH.sdr.vo[0].frags[2], vo("sdr", 1)];
      add("sdr", {
        set: "stairwell", setOpts: { id: "sw10", smokeY: 100 }, dark: 0.4,
        cam: { keys: [{ t: 0, ...fr(1180, 1150, 0.95, 540, 1050), drift: { s: 0.02 } }] },
        // flipped so she lies along the half landing (head to the right), not out over the flight
        actors: [PRAE(950, 1350, 1.05, [{ t: 0, mode: "tremble", eyes: "wide", mouth: "o", sweat: true }, { t: SDR[1] - 0.1, mode: "lie", eyes: "pain", mouth: "flat" }, { t: SDR[2], mode: "lie", eyes: "closed", mouth: "flat" }], { flip: true })],
        captions: caps("sdr"),
        ui: [steps("sdr", "เสื้อผ้าติดไฟ", [["stopnow", "หยุด"], ["dropdown", "ล้มตัวลง"], ["coverface", "มือปิดหน้า"], ["rollover", "กลิ้งจนไฟดับ"]], SDR[0] - 0.1, D("sdr") - 0.15, { gap: (SDR[3] - SDR[0]) / 3 }),
          { type: "src", t: SDR[3] + 0.3, end: D("sdr") - 0.05, top: 640, text: "ที่มา: <em>Ready.gov</em> · หยุด ล้มลง เอามือปิดหน้า แล้วกลิ้งไปมาจนไฟดับ" }],
        fx(tl, id, t0) {
          const a0 = `${id}-a0`, g = document.getElementById(a0), flame = `<g id="${id}-fl" class="flk">${[0, 1, 2].map((k) => `<path d="M${-14 + k * 9},${30 + k * 22}q-14,-36 0,-70q16,30 8,70z" fill="${k % 2 ? "#ffd24a" : "#ff7a2a"}"/>`).join("")}</g>`;
          const arm = document.getElementById(`${a0}-faF`); if (arm) arm.insertAdjacentHTML("beforeend", flame);
          // the roll: she rocks side to side on the floor until the flame is out
          for (let i = 0; i < 8; i++) tl.to(`#${a0}`, { attr: { transform: `translate(${950 + (i % 2 ? 120 : -60)},1350) scale(-1.05,1.05)` }, duration: 0.42, ease: "sine.inOut" }, t0 + SDR[3] + i * 0.42);
          tl.to(`#${id}-fl`, { opacity: 0, duration: 1.4 }, t0 + SDR[3] + 0.6);
        },
      });

      // ---------- 11. the fire is out; แพร is all right ----------
      add("out", {
        set: "stairwell", setOpts: { id: "sw11", smokeY: 100 }, dark: 0.42,
        cam: { keys: [{ t: 0, ...fr(1060, 1150, 1.0, 540, 1050), drift: { s: 0.03 } }] },
        actors: [PRAE(1120, 1350, 1.05, [{ t: 0, mode: "sit", eyes: "closed", mouth: "flat", sweat: true }]), YOU(860, 1350, 1.05, [{ t: 0, mode: "crouch", eyes: "side", mouth: "flat", torch: true }])],
        captions: caps("out"),
      });

      // ---------- 12–13. your torch goes up the stairwell well… ดาว hangs upside down — and drops ----------
      add("up", withTorch("up", { keys: [{ t: 0, x: 540, y: 1300, r: 320 }, { t: 2.0, x: 540, y: 820, r: 300 }], dark: 0.7, beam: 0.8, hand: [240, 1720] }, {
        set: "stairwellUp", setOpts: { id: "su" }, dark: 0.3,
        cam: { keys: [{ t: 0, x: 0, y: 200, s: 1.0, drift: { y: -40, s: 0.02 } }] },
        shake: Pov.head({ mode: "breath" }),
        captions: caps("up"),
        fx(tl, id, t0) { tl.set("#su-dao", { opacity: 0 }, t0); tl.to("#su-dao", { opacity: 1, duration: 0.6 }, t0 + D("up") - 0.9); Fx.heart(tl, t0 + 1.5, D("up") - 1.5, 0.42, 0.5); },
      }));
      add("drop", withTorch("drop", { keys: [{ t: 0, x: 540, y: 820, r: 320 }], dark: 0.6, beam: 0.8, hand: [240, 1720], flicker: [[0.6, 0.6]] }, {
        set: "stairwellUp", setOpts: { id: "sd" }, dark: 0.3,
        cam: { keys: [{ t: 0, x: 0, y: 160, s: 1.0, drift: { s: 0.02 } }] },
        shake: (t) => (t > 0.9 && t < 1.4 ? 28 * Math.sin(t * 70) : 2 * Math.sin(t * 20)),
        fx(tl, id, t0) {
          tl.fromTo("#sd-dao", { attr: { transform: "translate(540,640) scale(-0.5,-0.5)" } }, { attr: { transform: "translate(540,560) scale(-0.55,-0.55)" }, duration: 0.6, ease: "sine.inOut", immediateRender: false }, t0);
          tl.set("#sd-d-smile", { opacity: 1 }, t0 + 0.4); tl.set("#sd-d-flat", { opacity: 0 }, t0 + 0.4);
          tf(tl, "#sd-dao", t0 + 0.9, 0.3, "translate(540,1700) scale(-2.6,-2.6)", "power4.in");
          Fx.glitch(tl, `#${id}`, t0 + 0.95, 0.3, 26, 305);
          tl.fromTo("#flashw", { opacity: 0.85 }, { opacity: 0, duration: 0.25, immediateRender: false }, t0 + 1.15);
          tl.fromTo("#fxred", { opacity: 1 }, { opacity: 0, duration: 0.7, immediateRender: false }, t0 + 1.15);
          tl.set("#black", { opacity: 1 }, t0 + 1.25); tl.set("#black", { opacity: 0 }, t0 + D("drop"));
        },
      }));

      // ---------- 14. channel signature ----------
      add("sig", {
        set: "stairwell", setOpts: { id: "sw14", smokeY: 200 }, dark: 0.55, blur: { far: 8, set: 8, fg: 10 },
        cam: { keys: [{ t: 0, ...fr(560, 1300, 0.9, 540, 1000), drift: { s: 0.02 } }, { t: SF(2), ...fr(560, 1300, 0.96, 540, 1000), drift: { s: 0.045 } }, { t: SF(3), ...fr(560, 1300, 1.04, 540, 1000), drift: { s: 0.02 } }] },
        shake: (t) => (t > SF(3) && t < SF(3) + 0.5 ? 14 * Math.sin(t * 63) * (SF(3) + 0.5 - t) / 0.5 : 0),
        captions: caps("sig"),
        ui: [{ type: "sigCard", t: 0.05, title: "ควันหลง · เช็กลิสต์เอาตัวรอด", items: [["ไม่ขึ้นลิฟต์", true], ["ใช้บันไดหนีไฟ", true], ["หยุด ล้ม กลิ้ง", true], ["???", false]],
          show: [SF(0) + 0.05, SF(0) + 0.3, SF(0) + 0.55, SF(2)], mark: [SF(0) + 0.3, SF(0) + 0.62, SF(1) + 0.15, SF(3)], top: 440 }],
        fx(tl, id, t0) {
          Fx.desat(tl, `#${id} .stage`, t0, undefined, 0.2);
          Fx.heart(tl, t0 + SF(2), SF(3) - SF(2), 0.38, 0.45); Fx.tunnel(tl, t0 + SF(2), t0 + SF(3) + 0.35, 0.6);
          Fx.glitch(tl, `#${id}`, t0 + SF(2), 0.12, 8, 73);
          Fx.punch(tl, `#${id} .stage`, t0 + SF(3), 1.1, 0.5); Fx.glitch(tl, `#${id}`, t0 + SF(3), 0.35, 16, 74);
          tl.fromTo("#fxred", { opacity: 0.9 }, { opacity: 0, duration: 0.7, immediateRender: false }, t0 + SF(3));
          tl.fromTo("#flashw", { opacity: 0.5 }, { opacity: 0, duration: 0.12, immediateRender: false }, t0 + SF(3));
          Fx.heart(tl, t0 + SF(3) + 0.2, D("sig") - SF(3) - 0.2, 0.5, 0.5);
        },
      });

      // ---------- 15. the floor signs you passed: six, five, four ----------
      add("signs", withTorch("signs", { keys: [{ t: 0, x: 300, y: 1000, r: 380 }], dark: 0.6, hand: [240, 1720] }, {
        set: "landing", setOpts: { id: "ld15", show: 6 }, dark: 0.35,
        cam: { keys: [{ t: 0, ...fr(400, 980, 1.0, 540, 960), drift: { s: 0.03 } }] },
        shake: Pov.head({ mode: "walk" }),
        captions: caps("signs"),
        fx(tl, id, t0) {
          const fr6 = SH.signs.vo[0].frags, base = vo("signs");
          [[6, base + fr6[1]], [5, base + fr6[1] + 0.9], [4, base + fr6[1] + 1.8]].forEach(([n, t]) => {
            [4, 5, 6, 7].forEach((m) => tl.set(`#ld15-s${m}`, { opacity: m === n ? 1 : 0 }, t0 + t));
            tl.fromTo(`#${id} .stage`, { filter: "blur(6px)" }, { filter: "blur(0px)", duration: 0.25, immediateRender: false }, t0 + t);
          });
        },
      }));

      // ---------- 16. the sign in front of you now: seven ----------
      add("seven", withTorch("seven", { keys: [{ t: 0, x: 300, y: 1000, r: 380 }, { t: F("seven", 0, 2), x: 260, y: 900, r: 460 }], dark: 0.6, hand: [240, 1720], flicker: [[F("seven", 0, 2), 0.5]] }, {
        set: "landing", setOpts: { id: "ld16", show: 7 }, dark: 0.35,
        cam: { keys: [{ t: 0, ...fr(400, 980, 1.0, 540, 960), drift: { s: 0.01 } }, { t: F("seven", 0, 2), ...fr(250, 960, 1.45, 540, 900), drift: { s: 0.05 } }] },
        shake: Pov.head({ mode: "breath", flinch: [F("seven", 0, 2)] }),
        captions: caps("seven"),
        fx(tl, id, t0) {
          [4, 5, 6, 7].forEach((m) => tl.set(`#ld16-s${m}`, { opacity: m === 4 ? 1 : 0 }, t0));
          [4, 5, 6, 7].forEach((m) => tl.set(`#ld16-s${m}`, { opacity: m === 7 ? 1 : 0 }, t0 + F("seven", 0, 2)));
          Fx.glitch(tl, `#${id}`, t0 + F("seven", 0, 2), 0.3, 18, 306); Fx.punch(tl, `#${id} .stage`, t0 + F("seven", 0, 2), 1.08, 0.5);
          tl.fromTo("#fxred", { opacity: 0.8 }, { opacity: 0, duration: 0.6, immediateRender: false }, t0 + F("seven", 0, 2));
          Fx.heart(tl, t0 + F("seven", 0, 2) + 0.3, D("seven") - F("seven", 0, 2) - 0.3, 0.42, 0.55);
        },
      }));

      // ---------- 17. the 714 key on its hook by the door; from behind the door, her voice ----------
      add("key", withTorch("key", { keys: [{ t: 0, x: 760, y: 980, r: 360 }, { t: vo("key", 1) - 0.3, x: 620, y: 860, r: 420 }], dark: 0.55, hand: [240, 1720] }, {
        set: "landing", setOpts: { id: "ld17", show: 7, key: true, under: 0 }, dark: 0.35,
        cam: { keys: [{ t: 0, ...fr(900, 960, 1.3, 540, 960), drift: { s: 0.03 } }, { t: vo("key", 1) - 0.3, glide: 0.8, ...fr(640, 900, 1.25, 540, 960), drift: { s: 0.04 } }] },
        shake: Pov.head({ mode: "breath", modes: [[vo("key", 1), "panic"]] }),
        captions: [...caps("key", [0]), ...caps("key", [1], { quote: true })],
        fx(tl, id, t0) {
          for (let i = 0; i < 6; i++) tl.to("#ld17-key", { attr: { transform: `rotate(${i % 2 ? -10 : 9} 980 850)` }, duration: 0.6, ease: "sine.inOut" }, t0 + i * 0.6);
          tl.to("#ld17-win", { opacity: 1, duration: 0.4 }, t0 + vo("key", 1) + 0.3);
          tl.to("#ld17-under", { opacity: 1, duration: 0.6 }, t0 + vo("key", 1));
          Fx.heart(tl, t0 + vo("key", 1), D("key") - vo("key", 1), 0.42, 0.6); Fx.glitch(tl, `#${id}`, t0 + vo("key", 1) + 0.3, 0.2, 10, 307);
        },
      }));

      // ---------- 18. the choice: open the door / keep going down ----------
      add("choice", withTorch("choice", { keys: [{ t: 0, x: 620, y: 880, r: 420 }], dark: 0.55, flicker: [[0.4, 3]], hand: [240, 1720] }, {
        set: "landing", setOpts: { id: "ld18", show: 7, key: true, under: 1 }, dark: 0.35,
        cam: { keys: [{ t: 0, ...fr(640, 900, 1.35, 540, 960), drift: { s: 0.03 } }] },
        shake: Pov.head({ mode: "panic" }),
        ui: [{ type: "choice", t: 0.05, q: "จะทำยังไง?", a: "เปิดประตู", b: "เดินลงต่อ", secs: 3, top: 280,
          possessed: { at: 1.0, side: "a", glitch: "เปิดประตู…", who: "…มือคุณจับประตูแล้ว" } }],
        fx(tl, id, t0) {
          tl.set("#ld18-win", { opacity: 1 }, t0);
          Fx.heart(tl, t0, D("choice"), 0.38, 0.85); Fx.tunnel(tl, t0, t0 + D("choice") + 0.5, 0.75);
          Fx.glitch(tl, `#${id}`, t0 + 1.0, 0.3, 12, 64); Fx.glitch(tl, `#${id}`, t0 + D("choice") - 0.6, 0.4, 18, 65);
          tl.set("#black", { opacity: 1 }, t0 + D("choice") - 0.2);
        },
      }));

      // ---------- 19. end card: the room key tag ----------
      add("next", {
        set: "keyTag", setOpts: { id: "kt", ep: "ตอนที่ 4", title: "ห้ามกลับ" }, dark: 0.1,
        cam: { keys: [{ t: 0, x: 0, y: 0, s: 1, drift: { s: 0.03 } }] },
        fx(tl, id, t0) {
          tl.set("#black", { opacity: 0 }, t0 + 0.3);
          tl.fromTo("#kt-tag", { attr: { transform: "translate(540,900) rotate(-14)" } }, { attr: { transform: "translate(540,900) rotate(-6)" }, duration: 1.6, ease: "elastic.out(1,0.4)", immediateRender: false }, t0 + 0.3);
          Fx.heart(tl, t0 + 0.9, D("next") - 0.9, 0.7, 0.35);
        },
      });

      shots.forEach((sh) => { const f = sh.fx; sh.fx = (tl, id, t0, L) => { if (f) f(tl, id, t0, L); Pov.life(tl, `#${id}`, t0, sh.dur); }; });
