      // ===== หนวดใส EP.3 (คลิปยาวเท่านั้น) · ความลับเต็ม: สามสิบปีก่อน คืนนั้น → เช้าแรกของเสา · 11 cuts (fbc/plan/shotlist.json) =====
      // Inserted after y05 "แล้วเขาก็ไม่ได้กลับบ้านอีกเลย" (old cut 20 point, EP.3 49.39 s) · the past is graded as a memory like the cold open.
      // the district hospital at night (s01–s04) → the 4 s silence: ลออ alone on the bench → home: ต้น at ten asleep, waiting (s05–s07: the lie)
      // → the next morning: every bottle the market had, the first line of the rhyme painted on a bare post, the first of ten thousand mornings.
      const MEM = (id) => { const c = document.getElementById(id); if (c) c.style.filter = "sepia(.5) saturate(.75) contrast(1.04)"; };
      const bv = (k) => (Rig.CAST[k] && Rig.CAST[k].v2) || {};
      Rig.CAST.jLaorY = { v2: { ...bv("june"), hair: { ...bv("yai").hair, c: "#2a2420", s: "#1a1612", sh: "#4a4440" }, wristband: null,   /* a village mother of about 40, hair in a bun (review r2 S3) */ blush: 0.4, top: { kind: "blouse", c: "#f4e2a8", sleeve: "elbow", trim: "#d8c080" }, print: "", bottom: { kind: "sarong", c: "#2a5a7a", band: "#e8c050", band2: "#d8312a" }, feet: { kind: "bare" }, extra: "" } };
      Rig.CAST.jLaorYBasket = { v2: Rig.CAST.jLaorY.v2, hand: `<g transform="translate(0,112)">${Jelly.basket(0, 110, 0.62, { n: 6 })}</g>`, keep: "F" };
      Rig.CAST.jLaorYBrush = { v2: Rig.CAST.jLaorY.v2, hand: `<g transform="translate(0,108) rotate(-30)"><path d="M0,0V-70" stroke="#8a5a2a" stroke-width="8" stroke-linecap="round"/><path d="M-6,-70h12l-6,-22z" fill="#1e1a16"/></g>`, keep: "F" };
      Rig.CAST.jTon10 = { v2: { ...bv("tang"), top: { kind: "tee", c: "#b8b0a0", sleeve: "short" }, print: "", bottom: { kind: "shorts", c: "#5a4a3a" }, feet: { kind: "bare" }, extra: "" } };
      Rig.CAST.jDoc = { v2: { ...bv("doc") } };
      Rig.MODES.bowHead = (u, o) => ({ ...Rig.MODES.idle(u, o), head: 18, torso: 8, uaF: 4, faF: -10, uaB: 4, faB: -10 });
      Rig.MODES.benchHands = (u, o) => ({ ...Rig.MODES.benchSit(u, o), uaF: -84, faF: -124, uaB: -74, faB: -122, head: 10 + 1.5 * Math.sin(u * 5) });   // on the bench, both hands over her mouth (S4)
      Rig.MODES.handsMouth = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -80, faF: -120, uaB: -70, faB: -120, head: 8 + 2 * Math.sin(u * 7) });
      Rig.MODES.sitUp = (u, o) => ({ ...Rig.MODES.sit(u, o), uaF: -10, faF: -40, head: -8 });
      Rig.MODES.paint = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -100 + 10 * Math.sin(u * 5), faF: -30, head: -6 });
      const NIGHT = { from: "top", rim: "#cfe0ff", rimOp: 0.4, shade: "#10141c", shadeOp: 0.35, cast: { len: 0.4, op: 0.2 }, vol: false };
      const POSTP = (x, y, s, lines) => `<g transform="translate(${x},${y}) scale(${s})"><ellipse cx="0" cy="6" rx="90" ry="16" fill="#5a4a30" opacity=".25"/><path d="M-14,0V-520H14V0Z" fill="#a8703e" stroke="#2e2a26" stroke-width="5"/>
        <rect x="-170" y="-640" width="340" height="190" fill="#c89a5e" stroke="#2e2a26" stroke-width="6"/><g id="pp-txt">${lines}</g></g>`;

      // 1–3 · the district hospital, that night: the long empty corridor, ลออ small on the bench → the doctor: "ญาติคุณเพิ่มใช่ไหมครับ" → ลออ CU: "พี่เพิ่มเป็นไงบ้างคะ"
      add("fb_hosp", { dark: 0.3, light: NIGHT,
        cam: { keys: [{ t: 0, ...fr(560, 1300, 0.85, 540, 980) }, { t: CT(2, "fb_hosp") - 0.01, glide: CT(2, "fb_hosp") - 0.01, ...fr(540, 1320, 0.95, 540, 980) },
          { t: CT(2, "fb_hosp"), ...fr(520, 1380, 1.6, 540, 1000) }, { t: CT(3, "fb_hosp"), ...fr(300, 1260, 3.0, 540, 860) }] },
        actors: [A("jLaorY", 300, 1760, 1.0, [{ t: 0, mode: "benchSit", eyes: "cry", mouth: "flat" }, { t: CT(3, "fb_hosp") - 0.3, mode: "idle", eyes: "wide", mouth: "o" }], { talk: [TALK("fb_hosp", 2, "o")] }),
          A("jDoc", 760, 1770, 1.0, [{ t: 0, mode: "walk", eyes: "worry", mouth: "flat" }, { t: CT(2, "fb_hosp") + 0.6, mode: "idle", eyes: "worry", mouth: "o" }], { flip: true, from: CT(2, "fb_hosp") - 0.01, talk: [TALK("fb_hosp", 1, "o")], moveTo: { x: 640, y: 1770, dur: 0.7, ease: "power1.out" } })],
        captions: capsJ(caps("fb_hosp", [0]), caps("fb_hosp", [1], { quote: true }), caps("fb_hosp", [2], { quote: true })),
        fx(tl, id, t0, L) { MEM(id); HALL(L, `${id}h`, { door: 900, bench: 330 }); } });
      // 4 · the doctor, head bowed: "หมอขอโทษจริงๆ ครับ"
      add("fb_sorry", { dark: 0.3, light: NIGHT, cam: { keys: [{ t: 0, ...fr(640, 1260, 2.8, 540, 880) }, { t: D("fb_sorry"), glide: D("fb_sorry"), ...fr(640, 1260, 3.1, 540, 880) }] },
        actors: [A("jDoc", 640, 1770, 1.0, [{ t: 0, mode: "bowHead", eyes: "closed", mouth: "o" }], { flip: true, talk: [TALK("fb_sorry", 0, "o")] })],
        captions: caps("fb_sorry", undefined, { quote: true }), fx(tl, id, t0, L) { MEM(id); HALL(L, `${id}h`, { door: 900, bench: false }); } });
      // 5 · the 4 s silence: the wide corridor, ลออ alone on the bench, hands over her mouth, a neon tube flickers once
      add("hush", { dark: 0.38, light: NIGHT, cam: { keys: [{ t: 0, ...fr(540, 1300, 0.8, 540, 980) }, { t: D("hush"), glide: D("hush"), ...fr(520, 1320, 0.86, 540, 980) }] },
        actors: [A("jLaorY", 300, 1760, 1.0, [{ t: 0, mode: "benchHands", eyes: "cry", mouth: "flat" }])], captions: [],
        fx(tl, id, t0, L) { MEM(id); HALL(L, `${id}h`, { door: 900, bench: 330 });
          // the one neon tube over the bench, in frame: the flicker has a source (S4)
          put(L.set, `<g transform="translate(420,980)"><path d="M-170,-40V-14M170,-40V-14" stroke="#4a4a48" stroke-width="5"/><rect x="-180" y="-16" width="360" height="26" rx="8" fill="#6a6e70" stroke="#2e2a26" stroke-width="4"/>
            <rect id="hu-tube" x="-168" y="-8" width="336" height="12" rx="6" fill="#f4fbff"/><ellipse id="hu-glow" cx="0" cy="40" rx="420" ry="160" fill="#e8f4ff" opacity=".14"/></g>`);
          put(L.light, `<rect id="hu-fl" x="-660" y="0" width="2400" height="1920" fill="#000" opacity="0"/>`);
          tl.to("#hu-fl", { opacity: 0.35, duration: 0.06, yoyo: true, repeat: 3, immediateRender: false }, t0 + 1.8);
          tl.to(["#hu-tube", "#hu-glow"], { opacity: 0.05, duration: 0.06, yoyo: true, repeat: 3, immediateRender: false }, t0 + 1.8); } });
      // 6–8 · home that night: ต้น at ten asleep on the mat by the door (s05) → he sits up: "แม่… พ่อยังไม่กลับเหรอ" → ลออ CU, the lie: "พ่อทิ้งเราไป"
      add("fb_home", { set: "jellyPorch", setOpts: { id: "jpFB", basket: false }, dark: 0.55, light: NIGHT,
        cam: { keys: [{ t: 0, ...fr(640, 1500, 1.15, 540, 1060) }, { t: CT(7, "fb_home") - 0.01, glide: CT(7, "fb_home") - 0.01, ...fr(640, 1520, 1.3, 540, 1060) },
          { t: CT(7, "fb_home"), ...fr(560, 1600, 2.0, 540, 1100) }, { t: CT(8, "fb_home"), ...fr(1130, 1150, 3.4, 540, 860) }, { t: D("fb_home"), glide: D("fb_home") - CT(8, "fb_home"), ...fr(1130, 1170, 2.9, 540, 860) }] },
        actors: [A("jTon10", 820, 1800, 0.72, [{ t: 0, mode: "lie", eyes: "closed", mouth: "flat" }, { t: CT(7, "fb_home") - 0.2, mode: "sitUp", eyes: "normal", mouth: "o" }], { talk: [TALK("fb_home", 1, "o")], until: CT(7, "fb_home") - 0.2 }),
          A("jTon10", 560, 1800, 0.72, [{ t: 0, mode: "sitUp", eyes: "normal", mouth: "o" }], { from: CT(7, "fb_home") - 0.2, talk: [TALK("fb_home", 1, "o")] }),
          A("jLaorY", 1130, 1680, 1.0, [{ t: 0, mode: "idle", eyes: "cry", mouth: "flat" }], { flip: true, from: window.LANDSCAPE ? CT(8, "fb_home") - 0.01 : CT(7, "fb_home") - 0.01, talk: [TALK("fb_home", 2, "o")] })],
        captions: capsJ(caps("fb_home", [0]), caps("fb_home", [1], { quote: true }), caps("fb_home", [2], { quote: true })),
        fx(tl, id, t0, L) { MEM(id);
          put(L.act, `<g><rect x="300" y="1760" width="560" height="50" rx="8" fill="#c8a46a" stroke="#2e2a26" stroke-width="4"/>${[0, 1, 2, 3, 4].map((k) => `<path d="M${320 + k * 90},1772v46" stroke="#a8844a" stroke-width="4"/>`).join("")}</g>`);
          // 30 years ago, at night: no post on the beach through the window, the glass dark with a moon
          const clip = document.getElementById(id);
          clip.querySelectorAll('g[transform="translate(640,936) scale(.12)"]').forEach((g) => g.setAttribute("display", "none"));
          clip.querySelectorAll('rect[fill="url(#jpFB-dawn)"]').forEach((r) => { if (+r.getAttribute("width") === 420) r.setAttribute("fill", "#141c34"); });
          clip.querySelectorAll('circle[fill="#fff2c8"], circle[fill="#ffe8a8"]').forEach((c) => { c.setAttribute("fill", "#e8ecf6"); c.setAttribute("r", +c.getAttribute("r") * 0.6); });
          put(L.glow, `<circle cx="160" cy="1100" r="260" fill="#ffc870" opacity=".22"/><circle cx="160" cy="1100" r="60" fill="#ffe0a0" opacity=".6"/>`); } });
      // 9–11 · the next morning: ลออ carries every bottle the market had (s08) → she paints the first line on a bare post (s09) → the post through
      // the mornings: the sun up and down, the rack always full, until it is the post of today (s10)
      const BEACHP = (id, x = {}) => BEACH(id, { tower: false, umbrellas: [], life: [], time: "morning", ...x });
      add("fb_post", { set: "jellyBeach", setOpts: BEACHP("jbFP"), dark: 0, light: DAWN,
        cam: { keys: [{ t: 0, ...fr(560, 1350, 1.0, 540, 1000) }, { t: CT(10, "fb_post") - 0.01, glide: CT(10, "fb_post") - 0.01, ...fr(600, 1360, 1.1, 540, 1000) },
          { t: CT(10, "fb_post"), ...fr(700, 1300, 2.0, 540, 960) }, { t: CT(11, "fb_post"), ...fr(700, 1260, 1.25, 540, 960) }, { t: D("fb_post"), glide: D("fb_post") - CT(11, "fb_post"), ...fr(700, 1240, 1.1, 540, 960) }] },
        actors: [A("jLaorYBasket", 180, 1760, 1.0, [{ t: 0, mode: "walk", eyes: "normal", mouth: "flat" }], { until: CT(10, "fb_post"), moveTo: { x: 520, y: 1760, dur: CT(10, "fb_post"), ease: "none" } }),
          A("jLaorYBrush", 520, 1770, 1.0, [{ t: 0, mode: "paint", eyes: "normal", mouth: "o" }], { from: CT(10, "fb_post"), until: CT(11, "fb_post"), talk: [TALK("fb_post", 1, "o")] })],
        captions: capsJ(caps("fb_post", [0]), caps("fb_post", [1], { quote: true }), caps("fb_post", [2])),
        fx(tl, id, t0, L) { MEM(id); const b = CT(10, "fb_post"), c = CT(11, "fb_post");
          const l1 = `<text id="pp-l1" x="0" y="-575" text-anchor="middle" font-family="Sriracha" font-size="44" fill="#2a1a0a">หนวดใสพันขา</text>`, l2 = `<text id="pp-l2" x="0" y="-505" text-anchor="middle" font-family="Sriracha" font-size="44" fill="#2a1a0a">อย่าราดน้ำท่า</text>`;
          put(L.set, `<g id="pp-post">${POSTP(720, 1720, 1.0, l1 + l2)}</g>`);
          tl.set("#pp-post", { opacity: 0 }, 0); tl.set("#pp-post", { opacity: 1 }, t0 + b);
          tl.set("#pp-l1", { opacity: 0 }, 0); tl.set("#pp-l2", { opacity: 0 }, 0);
          tl.to("#pp-l1", { opacity: 1, duration: 0.9, ease: "none", immediateRender: false }, t0 + F("fb_post", 1, 0));
          tl.to("#pp-l2", { opacity: 1, duration: 0.9, ease: "none", immediateRender: false }, t0 + F("fb_post", 1, 0) + 1.6);
          // the mornings: the rack of bottles always full on the post; day and night wash over it, faster and faster (bottles swap each dawn)
          put(L.set, `<g id="pp-rack" opacity="0"><g transform="translate(720,1080) scale(.9)">${[0, 1, 2, 3].map((k) => `<g transform="translate(${-63 + k * 42},0)"><path d="M-13,0V-56Q-13,-64 -6,-70V-80H6V-70Q13,-64 13,-56V0Z" fill="#f6efe0" stroke="#2e2a26" stroke-width="2.2"/><rect x="-13" y="-46" width="26" height="20" fill="#f2c230"/></g>`).join("")}</g></g>`);
          tl.set("#pp-rack", { opacity: 1 }, t0 + c);
          put(L.light, `<rect id="pp-night" x="-660" y="0" width="2400" height="1920" fill="#0a1430" opacity="0"/>`);
          const n = 7, span = D("fb_post") - c - 0.8; let tt = t0 + c + 0.4;
          for (let k = 0; k < n; k++) { const d = span / n * (1 - k * 0.08); tl.to("#pp-night", { opacity: 0.55, duration: d / 2, ease: "sine.inOut", yoyo: true, repeat: 1, immediateRender: false }, tt); tt += d; }
          // the post of today at the end: the painted sign of now over the old board (a dissolve of the board only)
          put(L.set, `<g id="pp-now" opacity="0">${postBoard(720, 1720, 1.0, "ppnb", { full: 1 })}</g>`);
          tl.to("#pp-now", { opacity: 1, duration: 0.8, immediateRender: false }, t0 + D("fb_post") - 1.2);
          tl.to("#pp-post", { opacity: 0, duration: 0.8, immediateRender: false }, t0 + D("fb_post") - 1.2); } });
