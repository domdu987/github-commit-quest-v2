      // ===== หนวดใส EP.3 (คลิปยาวเท่านั้น) · อยู่นิ่งอย่าถู เรียกหมอมาดู · CINEMA BIBLE cut (video/jelly-ep3/production/shotlist.json · 29 cuts) =====
      // the towel at the leg (the lure) → a tentacle still on the welts → the wide: the command → the stranger with the towel → ต้น holds her
      // wrist still → the skin: rubbing fires the stingers → ยาย runs in with her basket, pours, the lifeguard lifts the tentacle off → rule 3 →
      // the ambulance → the hospital corridor: "เสาของแม่" → the shadow screen: thirty years ago (the hold), the jellyfish (the sting), plain
      // water, the empty boat → ต้น: "พ่อทิ้งเราไป…" (the twist) → why: the rhyme, the post every morning → "เพราะผมไล่แม่เอง" → ภูมิ wakes →
      // the four steps on the ER board → dawn: three generations fill the post → the end board.
      const VB = (x, y, s = 1, o = {}) => `<g transform="translate(${x},${y}) scale(${s}) rotate(${o.tilt ?? 0})"><path d="M-36,0Q-40,-4 -40,-14V-130Q-40,-150 -24,-160Q-14,-168 -14,-182V-196H14V-182Q14,-168 24,-160Q40,-150 40,-130V-14Q40,-4 36,0Z" fill="#f6efe0" stroke="#2e2a26" stroke-width="3"/>
        <rect x="-40" y="-118" width="80" height="62" fill="#f2c230" stroke="#2e2a26" stroke-width="2.4"/><text x="0" y="-92" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="15" fill="#7a1a10">น้ำส้มสายชู</text>
        <text x="0" y="-66" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="20" fill="#7a1a10">5%</text>${o.cap === false ? "" : `<rect x="-17" y="-216" width="34" height="22" rx="4" fill="#d8312a" stroke="#2e2a26" stroke-width="2.6"/>`}</g>`;
      const TOWEL = (x, y, s = 1, r = 0) => `<g transform="translate(${x},${y}) rotate(${r}) scale(${s})"><path d="M-90,-40Q-20,-70 80,-50Q110,0 90,50Q0,80 -80,60Q-110,10 -90,-40Z" fill="#f2f0e8" stroke="#2e2a26" stroke-width="4"/>
        ${[0, 1, 2].map((k) => `<path d="M-80,${-24 + k * 30}Q0,${-44 + k * 30} 84,${-30 + k * 30}" stroke="#3a9ad8" stroke-width="7" fill="none" opacity=".8"/>`).join("")}</g>`;
      Rig.CAST.jWomanHat = { v2: { ...Rig.CAST.jWoman.v2, faceTop: `<g transform="translate(0,22)"><path d="M-150,-596Q0,-690 150,-596Q0,-612 -150,-596Z" fill="#d8b878" stroke="#2e2a26" stroke-width="2.6"/><path d="M-80,-620Q0,-700 80,-620" fill="#c8a868" stroke="#2e2a26" stroke-width="2.6"/><path d="M-82,-622Q0,-634 82,-622" stroke="#d8312a" stroke-width="7" fill="none"/></g>` } };
      Rig.CAST.jWomanTowel = { v2: Rig.CAST.jWomanHat.v2, hand: `<g transform="translate(0,104) rotate(10)">${TOWEL(0, 30, 0.55)}</g>`, keep: "F" };
      Rig.CAST.jLaorVin = { v2: Rig.CAST.jLaor.v2, hand: `<g transform="translate(0,104) rotate(150)">${VB(0, 0, 0.5, { cap: false })}</g>`, keep: "F" };
      Rig.CAST.jWanBare2 = Rig.CAST.jWanBare;
      Rig.MODES.kneel = Rig.MODES.kneel || ((u, o) => ({ ...Rig.MODES.idle(u, o), thF: -86, shF: 86, thB: 0, shB: 90, uaF: -10, faF: -30, uaB: 6, faB: -20, torso: 6, head: 4, bodyY: 286 }));
      Rig.MODES.wipe = (u, o) => { const w = 10 * Math.sin(u * 9); return { ...Rig.MODES.kneel(u, o), uaF: -64 + w, faF: -30, uaB: -30, faB: -50, torso: 18, head: 14 }; };
      Rig.MODES.grabWrist = (u, o) => ({ ...Rig.MODES.kneel(u, o), uaF: -84, faF: -6, uaB: 10, faB: -30, torso: 10, head: 4 });
      Rig.MODES.runBasket = (u, o) => ({ ...Rig.MODES.run(u, o), uaF: -40, faF: -60 });
      Rig.MODES.pourKneel = (u, o) => ({ ...Rig.MODES.kneel(u, o), uaF: -66, faF: -24, uaB: -40, faB: -50, torso: 16, head: 18 });
      Rig.MODES.benchSit = (u, o) => ({ ...Rig.MODES.sit(u, o), thF: -84, shF: 86, thB: -82, shB: 84, uaF: -20, faF: -50, uaB: 10, faB: -40, torso: 4, head: 6 + 2 * Math.sin(u * 1.1), bodyY: 150 });
      Rig.MODES.waveBig = Rig.MODES.waveBig || ((u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -160 + 20 * Math.sin(u * 9), faF: -20, uaB: 10, faB: -20, head: -8 }));
      Rig.MODES.fillPost = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -120, faF: -40, uaB: -100, faB: -50, head: -12 });
      const FGB = (L, tl, t0, a, b, fid, svg) => { if (window.LANDSCAPE && (window.LANDSCAPE.noFg || ["fg21", "fg28"]).includes(fid)) return; put(L.light, `<defs><filter id="${fid}-f" x="-.3" y="-.3" width="1.6" height="1.6"><feGaussianBlur stdDeviation="14"/></filter></defs><g id="${fid}" filter="url(#${fid}-f)">${window.LANDSCAPE ? `<g transform="translate(-660,0) scale(2.2222,1)"><rect width="1080" height="1920" opacity="0"/>${svg}</g>` : svg}</g>`);
        tl.set(`#${fid}`, { opacity: 0 }, 0); tl.set(`#${fid}`, { opacity: 1 }, t0 + a); if (b !== undefined) tl.set(`#${fid}`, { opacity: 0 }, t0 + b); };
      const BEACH3 = (id, x = {}) => BEACH(id, { tower: [930, 1270, 0.82], umbrellas: [[90, 1300, 0.8, "#f2c230"], [1040, 1360, 0.85, "#3a9ad8"]], life: [["mat", 330, 1760, 0.95, "#e8482a"], ["cooler", 120, 1350, 0.6]], ...x });
      const MAT = [330, 1760];
      // the hospital corridor outside the ER: tiled wall, the doors with their red sign, a bench, neon tubes
      const HALL = (L, id, o = {}) => { const G = 1720;
        put(L.sky, `<rect x="-1300" y="-900" width="3700" height="3900" fill="#cfd8d2"/>`);
        let s = `<rect x="-1300" y="-200" width="3700" height="${G + 200}" fill="#dfe6e0"/>${Array.from({ length: 30 }, (_, k) => `<path d="M${-1300 + k * 120},-200V${G}" stroke="#c8d2ca" stroke-width="3"/>`).join("")}
          <rect x="-1300" y="${G - 420}" width="3700" height="420" fill="#a8c0b6"/><path d="M-1300,${G - 420}H2400" stroke="#8aa89c" stroke-width="10"/>
          <rect x="-1300" y="${G}" width="3700" height="900" fill="#b8bfb8"/>${Array.from({ length: 10 }, (_, k) => `<path d="M-1300,${G + Math.pow(k / 9, 1.6) * 600}H2400" stroke="#a4aba4" stroke-width="3"/>`).join("")}
          <g transform="translate(${o.door ?? 900},0)"><rect x="-220" y="${G - 900}" width="440" height="900" fill="#7a8a90" stroke="#3a4448" stroke-width="8"/><rect x="-200" y="${G - 860}" width="190" height="560" fill="#b8d8e0" opacity=".7"/><rect x="10" y="${G - 860}" width="190" height="560" fill="#b8d8e0" opacity=".7"/>
            <rect x="-180" y="${G - 1020}" width="360" height="90" rx="10" fill="#d8312a" stroke="#3a1a1a" stroke-width="5"/><text y="${G - 960}" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="46" fill="#fff">ห้องฉุกเฉิน</text></g>
          ${[-200, 500, 1200].map((x) => `<rect x="${x - 160}" y="-40" width="320" height="22" rx="10" fill="#f6fbff"/>`).join("")}`;
        if (o.bench !== false) s += `<g transform="translate(${o.bench ?? 330},${G})"><rect x="-300" y="-250" width="600" height="40" rx="10" fill="#4a7ab0" stroke="#2a3a50" stroke-width="5"/><path d="M-270,-210V0M270,-210V0" stroke="#3a4448" stroke-width="16"/><rect x="-300" y="-430" width="600" height="36" rx="10" fill="#4a7ab0" stroke="#2a3a50" stroke-width="5"/><path d="M-250,-394V-250M250,-394V-250" stroke="#3a4448" stroke-width="12"/></g>`;
        if (o.board) s += `<g id="${id}-board"></g>`;
        put(L.set, s);
        put(L.glow, `${[-200, 500, 1200].map((x) => `<ellipse cx="${x}" cy="-10" rx="420" ry="160" fill="#f6fbff" opacity=".25"/>`).join("")}`); };

      // 1–2 · hook: the towel coming at the calf · ECU the tentacle still on the welts
