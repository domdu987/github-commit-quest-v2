      // ===== หนวดใส คลิปยาว · ฉากเชื่อม A (EP.1 → EP.2) และ B (EP.2 → EP.3) · 8 cuts (brc/plan/shotlist.json) =====
      // A: the lifeguard rings ยาย from the tower, the post empty in front of him → ยาย at her door, the receiver at her ear → "ผู้ชายพาลูกมาสองคน
      //    ใช่ไหม" (push-in) → her hand takes the basket off the floor, the doorway empty.
      // B: the tower: the lifeguard taps the empty rack, ต้น beside him; the old notice board with a faded photo (the clue) → "ป้าคนหนึ่งเติมเอง
      //    มาสามสิบปี" → the photo: a young man by a fishing boat → ต้น: "พ่อผม".
      const PHONE = `<g transform="translate(0,118) rotate(-8)"><rect x="-18" y="-32" width="36" height="64" rx="7" fill="#2a2a32" stroke="#2e2a26" stroke-width="2.2"/><rect x="-14" y="-27" width="28" height="52" rx="4" fill="#5ab8e8"/></g>`;
      Rig.CAST.jGuardPhone = { v2: Rig.CAST.jGuard.v2, hand: PHONE, keep: "F" };
      Rig.CAST.jLaorPhone = { v2: Rig.CAST.jLaor.v2, hand: PHONE.replace("#5ab8e8", "#9ac8a0"), keep: "F" };
      Rig.MODES.phoneEar2 = (u, o) => ({ ...Rig.MODES.phoneEar(u, o), uaF: -95, faF: -130, head: 10 + Math.sin(u * 1.1) * 2 });
      Rig.MODES.tapRack = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -120 + 8 * Math.sin(u * 14), faF: -30, head: -6 });
      // the old notice board by the tower: lost-and-found notes and one faded photo of a young man by a fishing boat
      const PHOTO = (x, y, s = 1) => `<g transform="translate(${x},${y}) scale(${s})"><rect x="-120" y="-150" width="240" height="190" fill="#efe2c0" stroke="#2e2a26" stroke-width="5" transform="rotate(-4)"/>
        <g transform="rotate(-4)"><rect x="-104" y="-136" width="208" height="150" fill="#c8b48a"/><rect x="-104" y="-56" width="208" height="70" fill="#9aa08a"/>
          <path d="M-96,-6Q-30,12 60,6L96,-20L70,-26Q0,-10 -80,-18Z" fill="#6a5a44"/><path d="M10,-26V-110L60,-30Z" fill="#8a7a60"/>
          <g transform="translate(-50,-6)"><circle cx="0" cy="-92" r="15" fill="#7a6248"/><path d="M-22,-112Q0,-130 22,-112Z" fill="#5a4a3a"/><path d="M-16,-76Q0,-80 16,-76L20,-20H-20Z" fill="#b0a080"/><path d="M-12,-20V8M12,-20V8" stroke="#5a4a3a" stroke-width="9"/><path d="M16,-70L40,-96" stroke="#7a6248" stroke-width="9" stroke-linecap="round"/></g>
          <rect x="-104" y="-136" width="208" height="150" fill="#f2e6c8" opacity=".28"/></g>
        <circle cx="-4" cy="-150" r="9" fill="#d8312a" stroke="#2e2a26" stroke-width="2.4"/></g>`;
      const BOARD = (x, y, s = 1) => `<g transform="translate(${x},${y}) scale(${s})"><path d="M-170,0V-560M170,0V-560" stroke="#6a4a2a" stroke-width="22"/>
        <rect x="-210" y="-560" width="420" height="320" fill="#a8703e" stroke="#4a2a14" stroke-width="8"/>${[0, 1, 2, 3].map((k) => `<path d="M-206,${-480 + k * 80}H206" stroke="#7a4a2a" stroke-width="4" opacity=".6"/>`).join("")}
        <rect x="-180" y="-530" width="110" height="80" fill="#f6f0dc" transform="rotate(5,-125,-490)"/><rect x="70" y="-520" width="110" height="130" fill="#e8f0f6" transform="rotate(-6,125,-455)"/>
        ${PHOTO(-10, -300, 0.62)}</g>`;
      // review M9: the bridges use the episodes' post (postBoard: the post + the rhyme board); the set's own post is switched off and drawn here
      const PB = (L, p, pid) => put(L.set, postBoard(p[0], p[1], p[2], pid, { full: p[3] ?? 0 }));
      const NOPOST = (o) => { const p = o.post; return [{ ...o, post: false }, p]; };
      // review M9: bridge A happens three hours after the dawn scene → midday at ยาย's house (daylight, a day sky in the window)
      const DAYWIN = (id, pid) => { const c = document.getElementById(id); if (!c) return;
        c.querySelectorAll(`rect[fill="url(#${pid}-dawn)"]`).forEach((r) => { if (+r.getAttribute("width") === 420) r.setAttribute("fill", "#9ad4f0"); });
        c.querySelectorAll('circle[fill="#fff2c8"], circle[fill="#ffe8a8"]').forEach((e) => e.setAttribute("display", "none")); };
      const BEACHB = (id, x = {}) => BEACH(id, { tower: [900, 1270, 0.82], post: [640, 1330, 0.62, 0], umbrellas: [[90, 1300, 0.8, "#f2c230"]], life: [], ...x });

      const FGB = (L, tl, t0, a, b, fid, svg) => { if (window.LANDSCAPE && (window.LANDSCAPE.noFg || []).includes(fid)) return; put(L.light, `<defs><filter id="${fid}-f" x="-.3" y="-.3" width="1.6" height="1.6"><feGaussianBlur stdDeviation="14"/></filter></defs><g id="${fid}" filter="url(#${fid}-f)">${window.LANDSCAPE ? `<g transform="translate(-660,0) scale(2.2222,1)"><rect width="1080" height="1920" opacity="0"/>${svg}</g>` : svg}</g>`);
        tl.set(`#${fid}`, { opacity: 0 }, 0); tl.set(`#${fid}`, { opacity: 1 }, t0 + a); if (b !== undefined) tl.set(`#${fid}`, { opacity: 0 }, t0 + b); };
      // 1–2 · the lifeguard on his phone at the tower, the empty post in front → ยาย at her door, the receiver at her ear
      add("A1", { set: "jellyBeach", setOpts: NOPOST(BEACHB("jbA1"))[0], dark: 0, light: SUN,
        cam: window.LANDSCAPE ? { keys: [{ t: 0, ...fr(820, 1250, 1.05, 540, 1230) }, { t: D("A1"), glide: D("A1"), ...fr(820, 1255, 1.12, 540, 1230) }] } : { keys: [{ t: 0, ...fr(760, 1380, 1.5, 540, 1100) }, { t: D("A1"), glide: D("A1"), ...fr(770, 1390, 1.62, 540, 1100) }] },
        actors: [A("jGuardPhone", 860, 1640, 0.9, [{ t: 0, mode: "phoneEar2", eyes: "worry", mouth: "o" }], { flip: true, talk: [TALK("A1", 0, "o")] })],
        captions: caps("A1", undefined, { quote: true }),
        fx(tl, id, t0, L) { PB(L, NOPOST(BEACHB("jbA1"))[1], "pbA1"); FGB(L, tl, t0, 0, D("A1"), "fgA1", `<path d="M-60,1980L-60,1500Q120,1440 260,1520L300,1980Z" fill="#c8a870"/>`); } });
      // 2 · ยาย at her door, the receiver at her ear, the basket on the floor by the door
      add("A1b", { set: "jellyPorch", setOpts: { id: "jpA1b", basket: false }, dark: 0, light: SUN,
        cam: { keys: [{ t: 0, ...fr(1150, 1400, 1.5, 540, 1060) }] },
        actors: [A("jLaorPhone", 1130, 1660, 1.0, [{ t: 0, mode: "phoneEar2", eyes: "worry", mouth: "flat" }], { flip: true })],
        captions: caps("A1b", undefined, { quote: true }),
        fx(tl, id, t0, L) { DAYWIN(id, "jpA1b"); put(L.act, `<g transform="translate(1250,1668)">${Jelly.basket(0, 0, 1.2)}</g>`); } });
      // 3–4 · ยาย MCU: "ผู้ชายพาลูกมาสองคน ใช่ไหม" → the basket insert: her hand takes it, the doorway empty
      add("A2", { set: "jellyPorch", setOpts: { id: "jpA2", basket: false }, dark: 0, light: SUN,
        cam: { keys: [{ t: 0, ...fr(1120, 1140, 2.4, 540, 820) }, { t: CT(4, "A2") - 0.01, glide: CT(4, "A2") - 0.01, ...fr(1120, 1130, 2.9, 540, 820) },
          { t: CT(4, "A2"), ...fr(1250, 1560, 2.6, 540, 1000) }] },
        actors: [A("jLaorPhone", 1130, 1660, 1.0, [{ t: 0, mode: "phoneEar2", eyes: "worry", mouth: "o" }, { t: F("A2", 0, 1) - 0.05, mode: "phoneEar2", eyes: "wide", mouth: "o" }], { flip: true, until: CT(4, "A2"), talk: [TALK("A2", 0, "o")] })],
        captions: caps("A2", undefined, { quote: true }),
        fx(tl, id, t0, L) { DAYWIN(id, "jpA2");
          const b = CT(4, "A2");
          put(L.act, `<g transform="translate(1250,1668)"><g id="a2-bk">${Jelly.basket(0, 0, 1.2)}<g id="a2-arm" opacity="0"><path d="M560,-1100L40,-170" stroke="#2e2a26" stroke-width="96" stroke-linecap="round"/><path d="M560,-1100L40,-170" stroke="#f4e2a8" stroke-width="84" stroke-linecap="round"/><path d="M150,-360L40,-170" stroke="#2e2a26" stroke-width="64" stroke-linecap="round"/><path d="M150,-360L40,-170" stroke="#c8946a" stroke-width="52" stroke-linecap="round"/><path d="M170,-395L130,-325" stroke="#d8c080" stroke-width="16" stroke-linecap="round"/><ellipse cx="22" cy="-140" rx="44" ry="34" fill="#c8946a" stroke="#2e2a26" stroke-width="6"/><path d="M-14,-150Q-30,-120 0,-104M10,-112Q30,-96 54,-118" stroke="#2e2a26" stroke-width="6" fill="none" stroke-linecap="round"/></g></g></g></g>`);
          tl.set("#a2-bk", { opacity: 0 }, 0); tl.set("#a2-bk", { opacity: 1 }, t0 + b);
          tl.set("#a2-arm", { opacity: 1 }, t0 + b + 0.25);
          tl.fromTo("#a2-arm", { x: 300, y: -500 }, { x: 0, y: 0, duration: 0.3, ease: "power2.out", immediateRender: false }, t0 + b + 0.25);
          tl.to("#a2-bk", { y: -900, duration: 0.45, ease: "power3.in", immediateRender: false }, t0 + b + 0.7);
        } });
      // 5–6 · the tower: the lifeguard taps the empty rack, ต้น beside him, the notice board with the photo → "ป้าคนหนึ่งเติมเองมาสามสิบปี"
      add("B1", { set: "jellyBeach", setOpts: NOPOST(BEACHB("jbB1", { post: [560, 1500, 0.95, 0] }))[0], dark: 0, light: SUN,
        cam: { keys: [{ t: 0, ...fr(640, 1460, 1.05, 540, 1040) }, { t: CT(6, "B1") - 0.01, glide: CT(6, "B1") - 0.01, ...fr(640, 1450, 1.15, 540, 1040) },
          { t: CT(6, "B1"), ...fr(470, 1130, 2.7, 540, 820) }] },
        actors: [A("jGuard", 470, 1760, 0.95, [{ t: 0, mode: "tapRack", eyes: "worry", mouth: "o" }, { t: CT(6, "B1"), mode: "idle", eyes: "worry", mouth: "o" }], { talk: [TALK("B1", 0, "o")] }),
          A("jTon", 250, 1790, 1.0, [{ t: 0, mode: "kneel", eyes: "worry", mouth: "flat" }]),
          A("jPhum", 120, 1795, 0.95, [{ t: 0, mode: "gasp", eyes: "closed", mouth: "o" }])],   // ภูมิ in his father's arms, waiting for the ambulance (review M9)
        captions: caps("B1", undefined, { quote: true }),
        fx(tl, id, t0, L) { PB(L, NOPOST(BEACHB("jbB1", { post: [560, 1500, 0.95, 0] }))[1], "pbB1"); put(L.set, `<g id="b1-ph">${PHOTO(650, 1450, 0.42)}</g>`); } });
      // 7–8 · the old photo pinned to ยาย's post (push-in) → ต้น CU, ภูมิ in his arms: "พ่อผม" (review S3: the photo belongs to her post)
      add("B2", { set: "jellyBeach", setOpts: NOPOST(BEACHB("jbB2", { post: [560, 1500, 0.95, 0] }))[0], dark: 0, light: SUN,
        cam: { keys: [{ t: 0, ...fr(646, 1405, 5.0, 540, 900) }, { t: CT(8, "B2") - 0.01, glide: CT(8, "B2") - 0.01, ...fr(646, 1405, 5.8, 540, 900) },
          { t: CT(8, "B2"), ...fr(250, 1330, 3.0, 540, 900) }, { t: D("B2"), glide: D("B2") - CT(8, "B2"), ...fr(250, 1330, 3.3, 540, 900) }] },
        actors: [A("jTon", 250, 1790, 1.0, [{ t: 0, mode: "kneel", eyes: "wide", mouth: "o" }], { talk: [TALK("B2", 0, "o")] }),
          A("jPhum", 120, 1795, 0.95, [{ t: 0, mode: "gasp", eyes: "closed", mouth: "o" }])],
        captions: caps("B2", undefined, { quote: true }),
        fx(tl, id, t0, L) { PB(L, NOPOST(BEACHB("jbB2", { post: [560, 1500, 0.95, 0] }))[1], "pbB2"); put(L.set, `<g id="b2-ph">${PHOTO(650, 1450, 0.42)}</g>`); } });

      // ===== คลิปยาวเท่านั้น · cold open (C1–C4, 30 years ago, before the title) and epilogue (E1–E3, a year later) =====
      // The past is graded as a memory (warm, faded: sepia on the clip) and there is no tower and no post on the beach yet.
      const MEM = (id) => { const c = document.getElementById(id); if (c) c.style.filter = "sepia(.5) saturate(.75) contrast(1.04)"; };
      const bv = (k) => (Rig.CAST[k] && Rig.CAST[k].v2) || {};
      const BOWL = (x, y, s = 1) => `<g transform="translate(${x},${y}) scale(${s})"><path d="M-60,0Q-54,46 0,50Q54,46 60,0Z" fill="#c8a24a" stroke="#2e2a26" stroke-width="4"/><path d="M-66,0H66" stroke="#2e2a26" stroke-width="7" stroke-linecap="round"/><path d="M-50,-2Q0,-12 50,-2" stroke="#bfe8ff" stroke-width="6" fill="none"/></g>`;
      Rig.CAST.jLaorY = { v2: { ...bv("june"), hair: { ...bv("yai").hair, c: "#2a2420", s: "#1a1612", sh: "#4a4440" }, wristband: null,   /* a village mother of about 40, hair in a bun (review r2 S3) */ blush: 0.4, top: { kind: "blouse", c: "#f4e2a8", sleeve: "elbow", trim: "#d8c080" }, print: "", bottom: { kind: "sarong", c: "#2a5a7a", band: "#e8c050", band2: "#d8312a" }, feet: { kind: "bare" }, extra: "" } };
      Rig.CAST.jPherm = { v2: { ...bv("keng"), skin: "#a8724a", top: { kind: "tank", c: "#e8e0c8", sleeve: "none" }, print: "", bottom: { kind: "shorts", c: "#3a4a6a" }, feet: { kind: "bare" }, extra: "" } };
      Rig.CAST.jFisher = { v2: { ...bv("boon"), hair: { ...bv("khem").hair, c: "#2a2420", sh: "#4a4440" }, skin: "#9a6a44", top: { kind: "singlet", c: "#c8a878" }, print: "", bottom: { kind: "shorts", c: "#5a3a2a" }, feet: { kind: "bare" }, extra: "" }, hand: `<g transform="translate(0,110) rotate(160)">${BOWL(0, 0, 0.62)}</g>`, keep: "F" };
      Rig.CAST.jKidTour = { v2: { ...bv("tang"), top: { kind: "tee", c: "#3aa86a", sleeve: "short" }, print: "", bottom: { kind: "shorts", c: "#2a3a5a" }, feet: { kind: "sandal", c: "#e85a2a" }, extra: "" }, hand: `<g transform="translate(0,104) rotate(170)">${Jelly.bottle(0, 0, 0.5, { cap: false })}</g>`, keep: "F" };
      Rig.CAST.jPhumBasket = { v2: Rig.CAST.jPhum.v2, hand: `<g transform="translate(0,112)">${Jelly.basket(0, 110, 0.55)}</g>`, keep: "F" };
      Rig.MODES.waveBig = Rig.MODES.waveBig || ((u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -160 + 20 * Math.sin(u * 9), faF: -20, uaB: 10, faB: -20, head: -8 }));
      Rig.MODES.fillPost = Rig.MODES.fillPost || ((u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -120, faF: -40, uaB: -100, faB: -50, head: -12 }));
      Rig.MODES.kneel = Rig.MODES.kneel || ((u, o) => ({ ...Rig.MODES.idle(u, o), thF: -86, shF: 86, thB: 0, shB: 90, uaF: -10, faF: -30, uaB: 6, faB: -20, torso: 6, head: 4, bodyY: 286 }));
      Rig.MODES.gasp = Rig.MODES.gasp || ((u, o) => { const b = Math.sin(u * 2 * Math.PI / 0.55), s = Rig.MODES.sit(u, o); return { ...s, uaF: -20, faF: -90, uaB: 20, faB: -80, torso: -14 + 4 * b, head: -18 + 5 * b, bodyY: (s.bodyY || 0) - 4 * Math.abs(b) }; });
      Rig.MODES.sitShallow = (u, o) => ({ ...Rig.MODES.sit(u, o), uaF: -40 + 4 * Math.sin(u * 3), faF: -60, uaB: 10, faB: -30, head: -6 });
      Rig.MODES.pourStand = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -70, faF: -40, torso: 12, head: 14 });
      Rig.MODES.calmDown = (u, o) => ({ ...Rig.MODES.sit(u, o), uaF: -60, faF: -10, uaB: 10, faB: -30, head: 6 });
      const PAST = (id, x = {}) => BEACH(id, { tower: false, umbrellas: [], life: [], boats: 2, ...x });
      const GLAR = (L, tl, t0, a, b) => { put(L.light, `<rect id="gl-${Math.round(t0 * 10)}" x="-660" y="0" width="2400" height="1920" fill="#000" opacity="0"/>`); tl.to(`#gl-${Math.round(t0 * 10)}`, { opacity: 1, duration: b - a, ease: "power2.in", immediateRender: false }, t0 + a); };

      // 9 · C1 · 30 years ago, the same beach: เพิ่ม in his ngob hat drags his longtail boat up the wet sand, the camera tracking with him;
      // gulls; no tower, no post yet (memory grade, lighter than the rest of the past so the first seconds read bright)
      Rig.CAST.jPhermHat = { v2: { ...Rig.CAST.jPherm.v2, faceTop: `<g transform="translate(0,6)"><path d="M-170,-600L0,-700L170,-600Q0,-622 -170,-600Z" fill="#d8b878" stroke="#2e2a26" stroke-width="3"/><path d="M-120,-616L0,-680L120,-616" stroke="#b8985a" stroke-width="3" fill="none"/></g>` } };
      Rig.MODES.haul = (u, o) => ({ ...Rig.MODES.walk(u * 0.7, o), uaF: 60, faF: -20, uaB: 50, faB: -20, torso: -14, head: 6 });
      const LBOAT = (x, y, s, id) => `<g transform="translate(${x},${y}) scale(${s})"><g id="${id}"><path d="M-300,-10Q-240,70 0,74Q240,70 330,-30L300,-40Q0,0 -280,-26Z" fill="#7a4a2a" stroke="#2e2a26" stroke-width="6"/>
        <path d="M-280,-26Q0,0 300,-40" stroke="#c8a24a" stroke-width="10" fill="none"/><path d="M-250,20Q0,44 280,8" stroke="#3a6a9a" stroke-width="8" fill="none"/><path d="M300,-40Q350,-90 360,-120" stroke="#2e2a26" stroke-width="10" fill="none"/>
        ${[0, 1, 2].map((k) => `<path d="M${330 + k * 6},-118l${8 - k * 8},-30" stroke="${["#d8312a", "#f2c230", "#3aa86a"][k]}" stroke-width="6"/>`).join("")}</g></g>`;
      // 9a · C1p · the cold open starts mid-event: a bowl of plain water tipped over the welts on เพิ่ม's calf (the danger first), the welts flare
      const MEMLITE = (id) => { const c = document.getElementById(id); if (c) c.style.filter = "sepia(.35) saturate(.85) contrast(1.04)"; };
      add("C1p", { set: "jellyBeach", setOpts: PAST("jbC1p"), dark: 0, light: SUN, blur: { set: 5, mid: 6, far: 6 },
        cam: { keys: [{ t: 0, ...fr(820, 1640, 2.3, 540, 1180) }, { t: D("C1p"), glide: D("C1p"), ...fr(820, 1650, 2.55, 540, 1180) }] },
        actors: [], captions: caps("C1p"),
        fx(tl, id, t0, L) { MEMLITE(id);
          put(L.act, `<g><path d="M300,1704Q760,1690 1040,1712L1320,1720" stroke="#2e2a26" stroke-width="66" stroke-linecap="round"/><path d="M300,1704Q760,1690 1040,1712L1320,1720" stroke="#a8724a" stroke-width="54" stroke-linecap="round"/>
            ${[0, 1, 2, 3].map((k) => `<path d="M${650 + k * 70},1688l22,26l22,-26" stroke="#e8495a" stroke-width="9" fill="none"/>`).join("")}
            <g id="c1p-f" opacity="0">${[0, 1, 2, 3].map((k) => `<path d="M${650 + k * 70},1688l22,26l22,-26" stroke="#ff2a3a" stroke-width="12" fill="none"/>`).join("")}</g>
            <path d="M180,1650Q240,1640 330,1660L340,1748Q250,1762 175,1752Z" fill="#2c3e5a" stroke="#2e2a26" stroke-width="6"/><path d="M1300,1690Q1360,1660 1400,1690Q1440,1720 1420,1744Q1360,1752 1310,1742Z" fill="#a8724a" stroke="#2e2a26" stroke-width="6"/><path d="M180,1756Q760,1790 1430,1760" stroke="#bfe0e8" stroke-width="10" fill="none" opacity=".55"/>
            <g transform="translate(800,1560) scale(.75)"><g id="c1p-bowl"><path d="M-90,0Q-80,70 0,74Q80,70 90,0Z" fill="#c8a24a" stroke="#2e2a26" stroke-width="6"/><path d="M-98,0H98" stroke="#2e2a26" stroke-width="9"/><path d="M-60,22Q0,34 60,22" stroke="#e8c870" stroke-width="5" fill="none" opacity=".8"/></g></g>
            <g id="c1p-wat" opacity="0">${[0, 1, 2, 3, 4, 5].map((k) => `<path d="M${750 + k * 12},1590q-5,60 0,110" stroke="#bfe8ff" stroke-width="9" fill="none" opacity=".9"/>`).join("")}</g>
            ${[0, 1, 2, 3, 4, 5, 6].map((k) => `<circle class="c1p-sp" cx="${700 + k * 40}" cy="${1694 - (k % 3) * 14}" r="7" fill="#dff4ff" opacity="0"/>`).join("")}</g>`);
          tl.fromTo("#c1p-bowl", { rotation: 8, svgOrigin: "0 0" }, { rotation: 52, svgOrigin: "0 0", duration: 0.35, ease: "power2.in", immediateRender: false }, t0);
          tl.fromTo("#c1p-wat", { opacity: 0, y: -60 }, { opacity: 1, y: 0, duration: 0.2, ease: "power1.in", immediateRender: false }, t0 + 0.22);
          tl.fromTo(".c1p-sp", { opacity: 0, y: 0 }, { opacity: 0.9, y: -26, duration: 0.3, stagger: 0.04, repeat: 1, yoyo: true, ease: "power1.out", immediateRender: false }, t0 + 0.38);
          tl.fromTo("#c1p-f", { opacity: 0 }, { opacity: 1, duration: 0.45, ease: "power2.in", immediateRender: false }, t0 + 0.45); } });
      // 9b · C1f · เพิ่ม's face as the water lands: the pain (he will smile it off later in C3)
      add("C1f", { set: "jellyBeach", setOpts: PAST("jbC1f"), dark: 0, light: SUN, blur: { set: 3, mid: 4, far: 4 },
        cam: { keys: [{ t: 0, ...fr(740, 1450, 2.7, 540, 860) }, { t: D("C1f"), glide: D("C1f"), ...fr(740, 1450, 3.0, 540, 860) }] },
        actors: [A("jPherm", 740, 1720, 1.0, [{ t: 0, mode: "sitShallow", eyes: "cry", mouth: "scream" }])],
        captions: caps("C1f"),
        fx(tl, id, t0, L) { MEMLITE(id);
          put(L.light, `<g id="c1f-dr">${[0, 1, 2, 3].map((k) => `<path d="M${640 + k * 60},1380q-3,30 0,60" stroke="#dff4ff" stroke-width="6" fill="none" opacity=".8"/>`).join("")}</g>`);
          tl.fromTo("#c1f-dr", { y: -40 }, { y: 80, duration: 0.5, repeat: 1, ease: "power1.in", immediateRender: false }, t0); } });
      add("C1", { set: "jellyBeach", setOpts: PAST("jbC1"), dark: 0, light: SUN,
        cam: { keys: [{ t: 0, ...fr(420, 1500, 1.15, 540, 1000) }, { t: D("C1"), glide: D("C1"), ...fr(620, 1500, 1.22, 540, 1000) }] },
        actors: [A("jPhermHat", 640, 1720, 0.95, [{ t: 0, mode: "haul", eyes: "normal", mouth: "smile" }], { moveTo: { x: 860, y: 1730, dur: D("C1"), ease: "none" } })],
        captions: caps("C1"),
        fx(tl, id, t0, L) { const c = document.getElementById(id); if (c) c.style.filter = "sepia(.3) saturate(.92) brightness(1.04)";
          put(L.act, `<g id="c1-bt">${LBOAT(260, 1700, 0.9, "c1-bb")}</g><path id="c1-rope" d="M560,1680Q600,1700 640,1600" stroke="#c8a878" stroke-width="5" fill="none"/>`);
          tl.fromTo("#c1-bt", { x: 0 }, { x: 220, duration: D("C1"), ease: "none", immediateRender: false }, t0);
          tl.fromTo("#c1-rope", { x: 0 }, { x: 220, duration: D("C1"), ease: "none", immediateRender: false }, t0);
          tl.fromTo("#c1-bb", { rotation: -1.5, svgOrigin: "0 0" }, { rotation: 1.5, svgOrigin: "0 0", duration: 0.5, yoyo: true, repeat: 6, ease: "sine.inOut", immediateRender: false }, t0);
          put(L.far, `<g id="c1-g">${[[200, 700], [380, 640], [820, 720]].map(([x, y]) => `<path d="M${x - 26},${y}q13,-14 26,0q13,-14 26,0" stroke="#2e2a26" stroke-width="5" fill="none"/>`).join("")}</g>`);
          tl.fromTo("#c1-g", { x: -60, y: 10 }, { x: 160, y: -30, duration: D("C1"), ease: "none", immediateRender: false }, t0); } });
      // 10–11 · C2 · the fisherman runs with a bowl of water to เพิ่ม sitting in the shallows → young ลออ runs in: "พี่เพิ่ม! พี่!"
      add("C2", { set: "jellyBeach", setOpts: PAST("jbC2", { jellies: [[860, 1640, 0.55, 0.5], [960, 1610, 0.45, 0.6]] }), dark: 0, light: SUN,
        cam: { keys: [{ t: 0, ...fr(640, 1560, 1.25, 540, 1080) }, { t: CT(13, "C2"), ...fr(420, 1560, 1.9, 540, 1080) }] },
        actors: [A("jPherm", 740, 1720, 1.0, [{ t: 0, mode: "sitShallow", eyes: "wide", mouth: "scream" }]),
          A("jFisher", 300, 1760, 1.0, [{ t: 0, mode: "run", eyes: "wide", mouth: "scream" }], { until: CT(13, "C2"), talk: [TALK("C2", 0, "scream")], moveTo: { x: 560, y: 1760, dur: CT(13, "C2"), ease: "power1.out" } }),
          A("jLaorY", 120, 1780, 1.0, [{ t: 0, mode: "run", eyes: "wide", mouth: "scream" }], { from: CT(13, "C2"), talk: [TALK("C2", 1, "scream")], moveTo: { x: 320, y: 1780, dur: D("C2") - CT(13, "C2"), ease: "power1.out" } })],
        captions: capsJ(caps("C2", [0], { quote: true }), caps("C2", [1], { quote: true })),
        fx(tl, id) { MEM(id); } });
      // 12–13 · C3 · เพิ่ม CU, smiling it off: "ไม่เป็นไร ลออ แค่แสบนิดเดียว" → insert: the bowl of plain water poured over the welts
      add("C3", { set: "jellyBeach", setOpts: PAST("jbC3"), dark: 0, light: SUN, blur: { set: 3, mid: 4, far: 4 },
        cam: { keys: [{ t: 0, ...fr(740, 1470, 2.6, 540, 880) }, { t: CT(15, "C3"), ...fr(820, 1700, 3.2, 540, 960) }] },
        actors: [A("jPherm", 740, 1720, 1.0, [{ t: 0, mode: "calmDown", eyes: "normal", mouth: "smile" }], { until: CT(15, "C3"), talk: [TALK("C3", 0, "smile")] }),
          A("jFisher", 940, 1740, 1.0, [{ t: 0, mode: "pourStand", eyes: "worry", mouth: "o" }], { flip: true, from: CT(15, "C3") - 0.01 })],
        captions: caps("C3", undefined, { quote: true }),
        fx(tl, id, t0, L) { MEM(id); const b = CT(15, "C3");
          put(L.act, `<g id="c3-leg" opacity="0"><path d="M380,1704Q760,1690 900,1712L1260,1722" stroke="#2e2a26" stroke-width="66" stroke-linecap="round"/><path d="M380,1704Q760,1690 900,1712L1260,1722" stroke="#a8724a" stroke-width="54" stroke-linecap="round"/>
            ${[0, 1, 2].map((k) => `<path d="M${690 + k * 55},1690l18,22l18,-22" stroke="#e85a6a" stroke-width="6" fill="none"/>`).join("")}<g id="c3-wat">${[0, 1, 2, 3, 4].map((k) => `<path d="M${760 + k * 12},1560q-4,60 0,120" stroke="#bfe8ff" stroke-width="7" fill="none" opacity=".85"/>`).join("")}</g></g>`);
          show(tl, "#c3-leg", t0 + b); tl.fromTo("#c3-wat", { y: -80, opacity: 0 }, { y: 0, opacity: 1, duration: 0.3, ease: "power1.in", immediateRender: false }, t0 + b + 0.1); } });
      // 14 · C4 · the narrator over the leg: the welts flare redder as the water lands (the stingers fire) → to black for the title
      add("C4", { set: "jellyBeach", setOpts: PAST("jbC4"), dark: 0, light: SUN, blur: { set: 5, mid: 6, far: 6 },
        cam: { keys: [{ t: 0, ...fr(800, 1700, 3.2, 540, 960) }, { t: D("C4"), glide: D("C4"), ...fr(800, 1700, 3.9, 540, 960) }] },
        actors: [], captions: caps("C4"),
        fx(tl, id, t0, L) { MEM(id);
          put(L.act, `<g><path d="M300,1704Q760,1690 1040,1712L1320,1720" stroke="#2e2a26" stroke-width="66" stroke-linecap="round"/><path d="M300,1704Q760,1690 1040,1712L1320,1720" stroke="#a8724a" stroke-width="54" stroke-linecap="round"/>
            <g id="c4-w">${[0, 1, 2, 3].map((k) => `<path d="M${650 + k * 70},1688l22,26l22,-26" stroke="#e85a6a" stroke-width="7" fill="none"/>`).join("")}</g>
            <g id="c4-f" opacity="0">${[0, 1, 2, 3].map((k) => `<path d="M${650 + k * 70},1688l22,26l22,-26" stroke="#ff2a3a" stroke-width="14" fill="none"/>`).join("")}${[0, 1, 2, 3, 4, 5].map((k) => `<circle cx="${660 + k * 50}" cy="${1700 + (k % 2) * 10}" r="5" fill="#fff"/>`).join("")}</g>
            ${[0, 1, 2, 3, 4, 5].map((k) => `<path class="c4-dr" d="M${700 + k * 40},1600q-3,40 0,80" stroke="#bfe8ff" stroke-width="7" fill="none" opacity=".8"/>`).join("")}</g>`);
          tl.fromTo(".c4-dr", { y: -60 }, { y: 30, duration: 0.6, repeat: 6, ease: "power1.in", immediateRender: false }, t0);
          tl.fromTo("#c4-f", { opacity: 0 }, { opacity: 1, duration: 1.6, ease: "power2.in", immediateRender: false }, t0 + F("C4", 0, 1));
          GLAR(L, tl, t0, D("C4") - 0.7, D("C4")); } });

      // 15 · E1 · a year later: dawn, the bay, ภูมิ carries the basket to the post by the tower ("หนึ่งปีต่อมา")
      const NOW = (id, x = {}) => BEACH(id, { tower: [1000, 1270, 0.82], post: [700, 1360, 0.7, 0.25], umbrellas: [], life: [], time: "morning", ...x });
      // the epilogue is dawn (the plan): a low warm sun off right and a blush on the sky, as EP.3 cut 28 (review r2 S6)
      const DAWNWASH = (L, id) => put(L.light, `<defs><radialGradient id="${id}-sun" cx="0.85" cy="0.42" r="0.75"><stop offset="0" stop-color="#ffc070" stop-opacity=".6"/><stop offset=".45" stop-color="#ff9a6a" stop-opacity=".2"/><stop offset="1" stop-color="#ff9a6a" stop-opacity="0"/></radialGradient>
        <linearGradient id="${id}-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff9a7a" stop-opacity=".4"/><stop offset=".5" stop-color="#ffd0a0" stop-opacity=".15"/><stop offset="1" stop-color="#ffb070" stop-opacity=".12"/></linearGradient></defs>
        <rect x="-2400" y="-600" width="6000" height="3200" fill="url(#${id}-sky)" style="mix-blend-mode:multiply"/><rect x="-2400" y="-600" width="6000" height="3200" fill="url(#${id}-sun)" style="mix-blend-mode:screen"/>`);
      add("E1", { set: "jellyBeach", setOpts: NOPOST(NOW("jbE1"))[0], dark: 0, light: DAWN,
        cam: { keys: [{ t: 0, ...fr(600, 1300, 0.8, 540, 960) }, { t: D("E1"), glide: D("E1"), ...fr(620, 1320, 0.86, 540, 960) }] },
        actors: [A("jPhumBasket", 260, 1700, 0.6, [{ t: 0, mode: "walk", eyes: "normal", mouth: "smile" }], { moveTo: { x: 520, y: 1690, dur: D("E1"), ease: "none" } })],
        captions: caps("E1"), fx(tl, id, t0, L) { DAWNWASH(L, "dwE1"); PB(L, NOPOST(NOW("jbE1"))[1], "pbE1"); } });
      // 16–17 · E2 · ภูมิ fills the post himself: "ปีนี้ผมเติมเสาเองครับยาย!" → a tourist kid with an open bottle; ภูมิ: "อย่าเอาน้ำเปล่าราด"
      add("E2", { set: "jellyBeach", setOpts: NOPOST(NOW("jbE2", { post: [640, 1640, 1.0, 0.75] }))[0], dark: 0, light: DAWN,
        cam: { keys: [{ t: 0, ...fr(560, 1360, 1.5, 540, 980) }, { t: CT(19, "E2"), ...fr(620, 1400, 1.45, 540, 980) }] },
        actors: [A("jPhum", 430, 1760, 0.95, [{ t: 0, mode: "fillPost", eyes: "normal", mouth: "laugh" }, { t: CT(19, "E2"), mode: "point", eyes: "normal", mouth: "o" }], { talk: [TALK("E2", 0, "laugh"), TALK("E2", 1, "o")] }),
          A("jKidTour", 820, 1770, 0.78, [{ t: 0, mode: "idle", eyes: "normal", mouth: "o" }], { flip: true, from: CT(19, "E2") - 0.01 })],   // the basket he carried in E1 is on the sand by his feet
        captions: capsJ(caps("E2", [0], { quote: true }), caps("E2", [1], { quote: true })), fx(tl, id, t0, L) { DAWNWASH(L, "dwE2"); put(L.act, Jelly.basket(290, 1772, 0.9)); PB(L, NOPOST(NOW("jbE2", { post: [640, 1640, 1.0, 0.75] }))[1], "pbE2"); } });
      // 18 · E2b · the two of them shout the rhyme at the post: น้ำหวาน "หนวดใสพันขา!" ภูมิ "อย่าราดน้ำท่า!"
      add("E2b", { set: "jellyBeach", setOpts: NOPOST(NOW("jbE2b", { post: [560, 1600, 0.95, 1] }))[0], dark: 0, light: DAWN,
        cam: { keys: [{ t: 0, ...fr(560, 1400, 1.25, 540, 1000) }] },
        actors: [A("jPhum", 380, 1760, 0.95, [{ t: 0, mode: "waveBig", eyes: "normal", mouth: "laugh" }], { talk: [TALK("E2b", 1, "laugh")] }),
          A("jWanBare", 760, 1780, 0.74, [{ t: 0, mode: "point", eyes: "normal", mouth: "laugh" }], { flip: true, talk: [TALK("E2b", 0, "laugh")] })],
        captions: capsJ(caps("E2b", [0], { quote: true }), caps("E2b", [1], { quote: true })), fx(tl, id, t0, L) { DAWNWASH(L, "dwE2b"); PB(L, NOPOST(NOW("jbE2b", { post: [560, 1600, 0.95, 1] }))[1], "pbE2b"); } });
      // 19–20 · E3 · ยาย and ต้น watching from behind: "พ่อแกคงยิ้มอยู่" — "ครับแม่" → the wide: the sea, the full post, held (the credits follow)
      add("E3", { set: "jellyBeach", setOpts: NOPOST(NOW("jbE3", { post: [700, 1360, 0.7, 1] }))[0], dark: 0, light: DAWN,
        cam: { keys: [{ t: 0, ...fr(560, 1420, 1.6, 540, 980) }, { t: CT(22, "E3"), ...fr(600, 1300, 0.78, 540, 940) }, { t: D("E3"), glide: D("E3") - CT(22, "E3"), ...fr(620, 1260, 0.72, 540, 940) }] },
        actors: [A("jLaor", 380, 1760, 1.0, [{ t: 0, mode: "idle", eyes: "normal", mouth: "smile" }], { talk: [TALK("E3", 0, "o")] }),
          A("jTon", 540, 1770, 1.0, [{ t: 0, mode: "idle", eyes: "normal", mouth: "smile" }], { talk: [TALK("E3", 1, "o")] }),   // both turned toward the post (right), not to the lens
          // what they are watching: ภูมิ and น้ำหวาน small at the post (the last wide is the whole family, ≤ 3 readable faces)
          A("jPhum", 660, 1372, 0.4, [{ t: 0, mode: "fillPost", eyes: "normal", mouth: "smile" }], { from: CT(22, "E3") - 0.01 }),
          A("jWanBare", 770, 1376, 0.31, [{ t: 0, mode: "point", eyes: "normal", mouth: "laugh" }], { flip: true, from: CT(22, "E3") - 0.01 })],
        captions: capsJ(caps("E3", [0], { quote: true }), caps("E3", [1], { quote: true })), fx(tl, id, t0, L) { DAWNWASH(L, "dwE3"); PB(L, NOPOST(NOW("jbE3", { post: [700, 1360, 0.7, 1] }))[1], "pbE3"); } });
