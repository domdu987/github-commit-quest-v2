      root.insertAdjacentHTML("beforeend", `<div class="badge" id="badge">ควันหลง · EP.1</div><div id="vig"></div><div id="flashw"></div><div id="black"></div>`);
      Fx.setup(root);
      Engine.build(root, tl, shots);
      // the two-minute ring: from the "timer" shot to ดาว sitting up; off while the signature card and the end cards are up
      KwanUI.countdown(root, tl, SH.timer.start + 0.25, SH.ghost.start + 1.9);
      KwanUI.hide(tl, SH.sig.start, SH.reveal.start); KwanUI.hide(tl, SH.choice.start);

      root.appendChild(document.getElementById("grain"));
      const rnd = (() => { let s = 99; return () => ((s = (s * 1664525 + 1013904223) % 4294967296) / 4294967296); })();
      for (let i = 0; i * 0.083 < SCHED.total; i++) tl.set("#grain", { x: Math.round(-50 + rnd() * 50), y: Math.round(-50 + rnd() * 50) }, i * 0.083);

      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
