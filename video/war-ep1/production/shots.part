      // ---------- แสงกระสือ: helpers ----------
      const tf = (tl, sel, t, dur, to, ease = "power2.inOut") => tl.to(sel, { attr: { transform: to }, duration: dur, ease, immediateRender: false }, t);
      const put = (el, html) => el.insertAdjacentHTML("beforeend", html);
      const split = (k, at, A, B) => {
        add(k, A); shots[shots.length - 1].dur = at;
        add(k, B); const sh = shots[shots.length - 1]; sh.start = SH[k].start + at; sh.dur = D(k) - at;
      };
      const capsFrom = (k, at, lines, o) => caps(k, lines, o).filter((c) => c.end > at + 0.05).map((c) => ({ ...c, t: Math.max(0, c.t - at), end: c.end - at }));
      const steps = (k, label, items, at, endAt, o = {}) => ({ type: "steps", t: at, label, items, gap: o.gap ?? 0.5, top: o.top ?? 210, end: endAt ?? D(k) - 0.2 });
      // ---------- ทางกลับบ้าน EP.1 อย่าวิ่งเข้าไปช่วย ----------
      // grammar: white-out → the mine at โจ้ (deep) / เต๋า + จ่าเม่น (foreground) · the command (closer) · insert 0:04 the crossed bamboo ·
      // โจ้ in the grass · the draw (insert) · home · the rule (field + tag) · the lure · the fix · the field and its signs · the run line ·
      // the steps · the clearance lane · rewind → replay · relief at dusk · the dust and the glint (F6) · choice · end sign
      // the planted mistake: 0:04.5 the crossed bamboo across the path with โจ้'s footprints going round it (clue / reveal)
      const LINE = (k, i, j) => SH[k].vo[i].frags[j], LINES_F = (k, i) => SH[k].vo[i].frags;
      const GOLD = { from: "left", rim: "#ffd08a", rimOp: 0.75, shade: "#2a2048", shadeOp: 0.34, cast: { len: 3.4, op: 0.42 }, vol: false };
      const DUSKL = { from: "left", rim: "#ffa060", rimOp: 0.7, shade: "#2a1838", shadeOp: 0.38, cast: { len: 3.8, op: 0.42 }, vol: false };
      const INL = { from: "left", rim: "#fff2d0", rimOp: 0.5, shade: "#2a2040", shadeOp: 0.3, cast: false, vol: false };
      const GGOLD = { top: "#ffe2b0", bottom: "#5a6a3a", op: 0.16 }, GDUSKR = { top: "#ffb878", bottom: "#4a2a5a", op: 0.22 }, GPAST = { top: "#f2dcb0", bottom: "#6a5a4a", op: 0.24 };
      const GVHS = { top: "#d8d0c0", bottom: "#3a3a4a", op: 0.3 };
      const A = (who, x, y, s, track, extra = {}) => { if (extra.talk) track.talk = extra.talk; return { who, x, y, s, track, blinks: [0.8, 2.4, 4.1], ...extra }; };
      const TALK = (k, i, m = "o") => [vo(k, i), voEnd(k, i), m];
      const QUO = { quote: true };
      const CARD = { dark: 0.1, blur: { sky: 4, far: 8, mid: 8, set: 8, fg: 12 }, light: GOLD, grade: GGOLD };
      const decay = (at, amp, len, f = 60) => (t) => (t > at && t < at + len ? amp * Math.pow(1 - (t - at) / len, 2) * Math.sin(t * f) : 0);
      const hand = (t) => 2.2 * Math.sin(t * 2.3) + 1.4 * Math.sin(t * 3.7);
      const HAND = (t) => ({ x: hand(t), y: hand(t + 1.3) * 0.6, r: 0 });
      const live = (tl, t0, dur, L) => { War.sway(tl, L.set, t0, dur); War.sway(tl, L.fg, t0, dur); War.sway(tl, L.glow, t0, dur); };
      const motes = (tl, t0, dur, L, seed = 4) => RabFX.motes(tl, L.glow, t0, dur, { box: [-100, 600, 1300, 1000], n: 26, seed });
      const push = (k, a, b) => ({ keys: [{ t: 0, ...fr(...a) }, { t: D(k), glide: D(k), ...fr(...b) }] });
      const TONE = ["#4e6a26", "#7a9a3a", "#a8b85a", "#e2dc8a"];
      const FIELD = { time: "day", ground: 1300, lift: 300, sunX: 40, glintX: 860, tree: false };
      // the hook staging, reused by cmd / help / hurt / steps / clear / relief
      const JOE = [300, 1500], TAO = [740, 1790], MEM = [930, 1820];

      // ---------- 1. hook: frame 0 is the white-out ----------
      add("hook", {
        set: "border", setOpts: { ...FIELD, id: "b1", pathX: 160, band: [-300, 900, 1505, 26], wire: [-400, 300, 2010, 1.3], fgH: 0.55 },
        dark: 0, blur: { sky: 1, far: 1.2, mid: 0.8, fg: 7 }, light: GOLD, grade: GGOLD,
        cam: { keys: [{ t: 0, ...fr(560, 1560, 1.2, 540, 1240), drift: { s: 0 } }, { t: 0.14, glide: 0.12, ...fr(480, 1540, 1.36, 540, 1240), drift: { s: 0 } },
          { t: 1.0, glide: 0.8, ...fr(580, 1560, 1.26, 540, 1240), drift: { s: 0.02 } }, { t: D("hook"), glide: D("hook") - 1, ...fr(570, 1560, 1.32, 540, 1240) }] },
        shake: (t) => ({ x: decay(0, 30, 0.8)(t) + hand(t), y: decay(0, 20, 0.8, 47)(t) + hand(t + 1.3) * 0.7, r: decay(0, 1.1, 0.6, 33)(t) }),
        actors: [
          A("joe", JOE[0], JOE[1], 0.5, [{ t: 0, mode: "reachUp", eyes: "wide", mouth: "scream" }], { flip: true }),
          A("tao", 760, 1790, 0.95, [{ t: 0, mode: "startle", eyes: "wide", mouth: "o" }, { t: 0.3, mode: "surge", eyes: "wide", mouth: "scream" }],
            { flip: true, path: [{ t: 0, x: 790, y: 1790 }, { t: 0.3, x: 770, y: 1790 }, { t: 0.55, x: 700, y: 1788 }, { t: 0.8, x: 640, y: 1786 }, { t: 1.1, x: 690, y: 1788 }, { t: 1.5, x: 740, y: 1790 }, { t: 1.8, x: 715, y: 1790 }, { t: 2.2, x: 745, y: 1790 }, { t: 2.6, x: 720, y: 1790 }, { t: 3.2, x: 740, y: 1790 }] }),
          A("mem", 960, 1820, 1.0, [{ t: 0, mode: "startle", eyes: "wide", mouth: "o" }, { t: 0.5, mode: "drag", eyes: "angry", mouth: "scream" }],
            { flip: true, path: [{ t: 0, x: 990, y: 1820 }, { t: 0.5, x: 930, y: 1820 }, { t: 0.8, x: 850, y: 1820 }, { t: 1.1, x: 880, y: 1820 }, { t: 1.5, x: 930, y: 1820 }, { t: 1.8, x: 905, y: 1820 }, { t: 2.2, x: 935, y: 1820 }, { t: 2.6, x: 910, y: 1820 }, { t: 3.2, x: 930, y: 1820 }] }),
        ],
        captions: caps("hook"),
        fx(tl, id, t0, L) {
          live(tl, t0, D("hook"), L);
          { const fw = document.getElementById("flashw"); fw.style.opacity = 1; fw.style.backgroundColor = "#ffffff"; } // frame 0 is already the white-out
          put(L.glow, `<g>${War.grass(-400, 1600, 1805, 70, Pop2.mk(77), TONE, { step: 30, n: 9 })}</g>`);
          War.blast(tl, L, 345, 1495, t0, { id: "bl1", s: 0.95, world: `${id}-world`, bend: `#${id}-glow .wrSway`, linger: true });
          War.glint(tl, "b1", t0, D("hook"), { at: [-0.05, 1.4, 2.5] });
          ["a0", "a1", "a2"].forEach((a) => War.jiggle(tl, `${id}-${a}`, t0, D("hook"), { amp: 14, period: 0.28 }));
          motes(tl, t0, D("hook"), L);
        },
      });
      // ---------- 2. the command: closer on เต๋า straining, จ่าเม่น's grip ----------
      add("cmd", {
        set: "border", setOpts: { ...FIELD, id: "b2", pathX: 160, band: [-300, 900, 1505, 26], fgH: 0.4 },
        dark: 0, blur: { sky: 3, far: 4, mid: 3, set: 2, fg: 9 }, light: GOLD, grade: GGOLD,
        cam: push("cmd", [760, 1430, 2.0, 540, 1000], [740, 1420, 2.15, 540, 1000]), shake: (t) => ({ x: hand(t) * 1.6 + decay(0, 10, 0.6)(t), y: hand(t + 1) * 0.8, r: 0 }),
        actors: [
          A("tao", 700, 1790, 0.95, [{ t: 0, mode: "surge", eyes: "wide", mouth: "scream" }], { flip: true, path: [{ t: 0, x: 700, y: 1790 }, { t: 0.4, x: 660, y: 1790 }, { t: 0.8, x: 700, y: 1790 }, { t: 1.2, x: 670, y: 1790 }, { t: 1.6, x: 695, y: 1790 }] }),
          A("mem", 880, 1820, 1.0, [{ t: 0, mode: "drag", eyes: "angry", mouth: "scream" }], { flip: true, path: [{ t: 0, x: 880, y: 1820 }, { t: 0.4, x: 850, y: 1820 }, { t: 0.8, x: 885, y: 1820 }, { t: 1.2, x: 860, y: 1820 }, { t: 1.6, x: 880, y: 1820 }] }),
        ],
        captions: caps("cmd"),
        fx(tl, id, t0, L) { live(tl, t0, D("cmd"), L); War.column(tl, L, 360, 1470, t0, D("cmd"), { s: 0.8 }); ["a0", "a1"].forEach((a) => War.jiggle(tl, `${id}-${a}`, t0, D("cmd"), { amp: 14, period: 0.26 })); motes(tl, t0, D("cmd"), L, 5); },
      });
      // ---------- 3. insert 0:04: behind a bush, the crossed bamboo across the path; footprints going round it ----------
      add("clue", {
        set: "border", setOpts: { ...FIELD, id: "b3", glint: false, pathX: 380, bamboo: 470, band: [-300, 1500, 1640, 50], fgH: 0.5 },
        dark: 0, blur: { sky: 2, far: 3, mid: 2, fg: 8 }, light: GOLD, grade: GGOLD,
        cam: push("clue", [560, 1560, 1.7, 540, 1150], [520, 1540, 1.85, 540, 1150]), shake: HAND,
        fx(tl, id, t0, L) {
          War.bush(L.set, 230, 1450, 0.8, "", { seed: 31 });
          let fp = ""; [[400, 1650], [380, 1590], [390, 1530], [420, 1470], [560, 1440], [640, 1420], [720, 1400]].forEach(([x, y], k) => { fp += `<ellipse cx="${x + (k % 2 ? 10 : -10)}" cy="${y}" rx="16" ry="7" fill="#5a4028" opacity=".55" transform="rotate(${k < 3 ? -40 : 10} ${x} ${y})"/>`; });
          put(L.set, `<g>${fp}</g>`); live(tl, t0, D("clue"), L); motes(tl, t0, D("clue"), L, 6);
        },
      });
      // ---------- 4. โจ้ in the grass: "ช่วยด้วย!" ----------
      add("help", {
        set: "border", setOpts: { ...FIELD, id: "b4", pathX: 160, band: [-300, 900, 1525, 30], fgH: 0.4 },
        dark: 0, blur: { sky: 3, far: 4, mid: 3, fg: 9 }, light: GOLD, grade: GGOLD,
        cam: push("help", [440, 1460, 2.2, 540, 1050], [430, 1460, 2.4, 540, 1050]), shake: (t) => ({ x: hand(t) * 1.2, y: hand(t + 1) * 0.7, r: 0 }),
        actors: [A("joe", JOE[0], JOE[1], 0.5, [{ t: 0, mode: "reachUp", eyes: "wide", mouth: "scream" }], { flip: true, talk: [TALK("help", 0, "scream")] })],
        captions: caps("help", undefined, QUO),
        fx(tl, id, t0, L) { live(tl, t0, D("help"), L); War.column(tl, L, 330, 1480, t0, D("help"), { s: 0.7, layer: L.set }); War.jiggle(tl, `${id}-a0`, t0, D("help"), { amp: 10 }); motes(tl, t0, D("help"), L, 7); },
      });
      // ---------- 5. three months earlier: the draw ----------
      add("card", {
        set: "draft", setOpts: { id: "d5" }, dark: 0, blur: { sky: 6, far: 10 }, light: false, grade: GPAST,
        cam: push("card", [560, 1150, 1.0, 540, 1000], [560, 1120, 1.12, 540, 1000]),
        captions: caps("card"),
        fx(tl, id, t0, L) {
          QkUI.rewind(tl, L.light, t0, 0.7, { from: "0:05", to: "-3 เดือน" });
          tl.fromTo("#d5-hand", { y: 200, rotation: 0, transformOrigin: "50% 100%" }, { y: -60, rotation: -4, transformOrigin: "50% 100%", duration: 0.9, ease: "power3.out", immediateRender: false }, t0 + vo("card", 0) + 0.6);
          tl.fromTo("#d5-hand", { y: -60 }, { y: -76, duration: 0.5, repeat: 4, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0 + vo("card", 0) + 1.5);
          tl.fromTo("#d5-card", { rotation: 0, transformOrigin: "50% 50%" }, { rotation: -6, transformOrigin: "50% 50%", duration: 0.3, repeat: 7, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0 + vo("card", 0) + 1.4);
          motes(tl, t0, D("card"), L, 8);
        },
      });
      // ---------- 6. home: แม่ hands เต๋า a sticky-rice parcel ----------
      add("mom", {
        set: "home", setOpts: { id: "hm6", flags: false }, dark: 0, blur: { far: 3, mid: 2, fg: 9 }, light: GOLD, grade: GPAST,
        cam: push("mom", [470, 1300, 1.45, 540, 1100], [460, 1290, 1.6, 540, 1100]),
        actors: [A("mom", 360, 1640, 0.95, [{ t: 0, mode: "offer", eyes: "normal", mouth: "smile" }], { talk: [TALK("mom", 0)] }), A("taoBare", 600, 1650, 0.95, [{ t: 0, mode: "idle", eyes: "normal", mouth: "smile" }, { t: 1.0, mode: "offer", eyes: "closed", mouth: "smile" }], { flip: true })],
        captions: caps("mom", undefined, QUO),
        fx(tl, id, t0, L) {
          put(L.glow, `<g transform="translate(480,1270)"><g id="${id}-pk"><path d="M-46,0Q-50,-40 0,-44Q50,-40 46,0Q0,16 -46,0Z" fill="#7aa04a" stroke="#2a2420" stroke-width="3.5"/><path d="M-40,-20Q0,-34 40,-20" stroke="#4e7a34" stroke-width="3" fill="none"/><path d="M0,-44V8" stroke="#c8a87a" stroke-width="5"/></g></g>`);
          tl.fromTo(`#${id}-pk`, { y: 0 }, { y: -6, duration: 0.6, repeat: 5, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0);
          RabFX.motes(tl, L.glow, t0, D("mom"), { box: [100, 700, 900, 900], n: 22, seed: 9 });
        },
      });
      // ---------- 7. the rule: จ่าเม่น on the field edge, then the dog tag ----------
      split("rule", vo("rule", 0) + 1.3, {
        set: "border", setOpts: { ...FIELD, id: "b7", pathX: 520, bags: [100, 1480, 0.8, 4], band: [-300, 1500, 1820, 50], fgH: 0.4 },
        dark: 0, blur: { sky: 2, far: 3, mid: 2, fg: 8 }, light: GOLD, grade: GGOLD,
        cam: { keys: [{ t: 0, ...fr(600, 1440, 1.55, 540, 1100), drift: { s: 0.02 } }] }, shake: HAND,
        actors: [A("tao", 300, 1760, 0.8, [{ t: 0, mode: "kneel", eyes: "normal", mouth: "flat" }]), A("joe", 480, 1770, 0.8, [{ t: 0, mode: "kneel", eyes: "normal", mouth: "smile" }]),
          A("mem", 820, 1800, 0.92, [{ t: 0, mode: "pointAt", eyes: "angry", mouth: "o" }], { flip: true, talk: [TALK("rule", 0)] })],
        captions: caps("rule", undefined, QUO),
        fx(tl, id, t0, L) { live(tl, t0, D("rule"), L); ["a0", "a1", "a2"].forEach((a) => War.jiggle(tl, `${id}-${a}`, t0, 1.6, { amp: 5, period: 0.6 })); motes(tl, t0, D("rule"), L, 10); },
      }, {
        set: "border", setOpts: { ...FIELD, id: "b7c", glint: false, pathX: 520 }, ...CARD, cam: { keys: [{ t: 0, ...fr(540, 1200, 1.0, 540, 1100), drift: { s: 0.02 } }] },
        captions: capsFrom("rule", vo("rule", 0) + 1.3, undefined, QUO),
        fx(tl, id, t0, L) { WarUI.tag(tl, L.light, t0 + 0.02, D("rule") - vo("rule", 0) - 1.3, { active: 0, done: [], y: 820, out: false }); RabFX.motes(tl, L.glow, t0, 3, { n: 20, seed: 11 }); },
      });
      // ---------- 8. the lure: โจ้ by a brass rocket head stuck in the dirt ----------
      add("brag", {
        set: "border", setOpts: { ...FIELD, id: "b8", glint: false, pathX: 300, band: [-300, 1500, 1800, 46], fgH: 0.45 },
        dark: 0, blur: { sky: 3, far: 4, mid: 3, fg: 9 }, light: GOLD, grade: GGOLD,
        cam: push("brag", [640, 1520, 1.7, 540, 1150], [660, 1540, 1.85, 540, 1180]), shake: HAND,
        actors: [A("tao", 870, 1760, 0.85, [{ t: 0, mode: "stop", eyes: "worry", mouth: "o" }], { flip: true }),
          A("joe", 430, 1790, 0.88, [{ t: 0, mode: "kneel", eyes: "normal", mouth: "laugh" }], { talk: [TALK("brag", 0, "laugh")] })],
        captions: caps("brag", undefined, QUO),
        fx(tl, id, t0, L) { War.rocket(L.set, 650, 1790, 1.05, "rk8"); War.sparkle(tl, "#rk8-gl", t0 + 0.2, D("brag")); live(tl, t0, D("brag"), L); motes(tl, t0, D("brag"), L, 12); },
      });
      // ---------- 9. the fix: จ่าเม่น grabs his wrist; leave it to the clearance team ----------
      add("fix", {
        set: "border", setOpts: { ...FIELD, id: "b9", glint: false, pathX: 300, band: [-300, 1500, 1800, 46], fgH: 0.45 },
        dark: 0, blur: { sky: 3, far: 4, mid: 3, fg: 9 }, light: GOLD, grade: GGOLD,
        cam: push("fix", [600, 1500, 1.5, 540, 1150], [620, 1500, 1.6, 540, 1150]), shake: (t) => ({ x: hand(t) + decay(0.2, 8, 0.4)(t), y: hand(t + 1) * 0.6, r: 0 }),
        actors: [A("joe", 380, 1790, 0.88, [{ t: 0, mode: "recoil", eyes: "wide", mouth: "o" }]),
          A("mem", 600, 1800, 0.95, [{ t: 0, mode: "stop", eyes: "angry", mouth: "o" }], { flip: true })],
        captions: caps("fix"),
        fx(tl, id, t0, L) {
          War.rocket(L.set, 780, 1790, 1.05, "rk9"); War.sparkle(tl, "#rk9-gl", t0, D("fix"), 1.2);
          War.spot(tl, L.glow, 760, 1700, t0 + vo("fix", 0) + LINE("fix", 0, 1) - 0.2, D("fix"), { label: "อย่าแตะ", icon: "notouch", r: 140, w: 170, tx: 40 });
          live(tl, t0, D("fix"), L); motes(tl, t0, D("fix"), L, 13);
        },
      });
      // ---------- 10. the field: looks ordinary — then its 4 signs, one by one ----------
      { const F = "field", n6 = vo(F, 1), fr6 = LINES_F(F, 1);
        add(F, {
          set: "border", setOpts: { ...FIELD, id: "b10", ground: 1300, lift: 220, glint: false, pathX: -400, bamboo: 200, tree: 820, treeS: 0.8, notch: true, bones: [1460, 1520, 0.9], band: [-400, 2600, 1700, 50], fgH: 0.45 },
          dark: 0, blur: { sky: 1, far: 1.5, mid: 1, fg: 8 }, light: GOLD, grade: GGOLD,
          cam: { keys: [{ t: 0, ...fr(600, 1380, 0.95, 540, 1150), drift: { s: 0.01 } },
            { t: n6 + fr6[1], glide: 0.8, ...fr(220, 1420, 1.45, 540, 1150), drift: { s: 0 } }, { t: n6 + fr6[1] + 1.3, glide: 0.7, ...fr(800, 1340, 1.3, 540, 1150), drift: { s: 0 } },
            { t: n6 + fr6[2], glide: 0.7, ...fr(1440, 1420, 1.45, 540, 1150), drift: { s: 0 } }, { t: n6 + fr6[2] + 1.2, glide: 0.7, ...fr(1980, 1400, 1.35, 540, 1150), drift: { s: 0.01 } }] },
          shake: HAND,
          actors: [A("joe", 440, 1560, 0.42, [{ t: 0, mode: "walk", eyes: "normal", mouth: "flat" }], { flip: true, path: [{ t: 0, x: 520, y: 1560 }, { t: 3.2, x: 380, y: 1560 }] }),
            A("tao", 610, 1570, 0.42, [{ t: 0, mode: "walk", eyes: "normal", mouth: "flat" }], { flip: true, path: [{ t: 0, x: 690, y: 1570 }, { t: 3.2, x: 550, y: 1570 }] }),
            A("mem", 780, 1580, 0.44, [{ t: 0, mode: "walk", eyes: "normal", mouth: "flat" }], { flip: true, path: [{ t: 0, x: 860, y: 1580 }, { t: 3.2, x: 720, y: 1580 }] })],
          captions: caps(F),
          fx(tl, id, t0, L) {
            put(L.set, `<g>${War.grass(1900, 2140, 1560, 210, Pop2.mk(55), TONE, { step: 22, n: 10, amp: 4 })}</g>`);
            const S = (x, y, t, label, icon, w, dur) => War.spot(tl, L.glow, x, y, t0 + t, dur, { label, icon, r: 130, w, tx: 50, out: true });
            S(200, 1310, n6 + fr6[1] + 0.2, "ไม้ไผ่ปักไขว้", "bamboo", 250, 1.3);
            S(820, 1110, n6 + fr6[1] + 1.5, "กากบาทบนต้นไม้", "treex", 290, 1.3);
            S(1460, 1500, n6 + fr6[2] + 0.2, "ซากสัตว์", "bones", 200, 1.2);
            S(2020, 1500, n6 + fr6[2] + 1.4, "ทุ่งรกร้าง", "weeds", 220, D(F) - n6 - fr6[2] - 1.4);
            live(tl, t0, D(F), L); motes(tl, t0, D(F), L, 14);
          },
        }); }
      // ---------- 11. if someone is hurt: the run line, crossed out ----------
      add("hurt", {
        set: "border", setOpts: { ...FIELD, id: "b11", pathX: 160, band: [-300, 900, 1505, 26], fgH: 0.4 },
        dark: 0, blur: { sky: 1, far: 1.2, mid: 1, fg: 7 }, light: GOLD, grade: GGOLD,
        cam: push("hurt", [560, 1520, 1.05, 540, 1150], [540, 1520, 1.12, 540, 1150]), shake: HAND,
        actors: [A("joe", JOE[0], JOE[1], 0.5, [{ t: 0, mode: "reachUp", eyes: "wide", mouth: "o" }], { flip: true }),
          A("tao", 720, 1790, 0.95, [{ t: 0, mode: "surge", eyes: "wide", mouth: "o" }], { flip: true, path: [{ t: 0, x: 720, y: 1790 }, { t: 0.5, x: 690, y: 1790 }, { t: 1.0, x: 720, y: 1790 }, { t: 1.5, x: 695, y: 1790 }, { t: 2, x: 720, y: 1790 }, { t: 6, x: 715, y: 1790 }] }),
          A("mem", 900, 1820, 1.0, [{ t: 0, mode: "drag", eyes: "angry", mouth: "flat" }], { flip: true })],
        captions: caps("hurt"),
        fx(tl, id, t0, L) { War.runLine(tl, L.glow, [650, 1560], [330, 1480], t0 + vo("hurt", 0) + LINE("hurt", 0, 1) - 0.3, D("hurt") - 1.4, { zr: 200, arc: 120 }); War.column(tl, L, 360, 1470, t0, D("hurt"), { s: 0.8 }); live(tl, t0, D("hurt"), L); motes(tl, t0, D("hurt"), L, 15); },
      });
      // ---------- 12. the steps: stop · warn · call · shout "don't move, we're helping" ----------
      { const K = "steps", f = LINES_F(K, 0), v = vo(K, 0);
        split(K, v + f[2] - 0.1, {
          set: "border", setOpts: { ...FIELD, id: "b12", pathX: 160, band: [-300, 900, 1505, 26], fgH: 0.4 },
          dark: 0, blur: { sky: 2, far: 2, mid: 1.5, fg: 8 }, light: GOLD, grade: GGOLD,
          cam: { keys: [{ t: 0, ...fr(700, 1480, 1.45, 540, 1250), drift: { s: 0.015 } }] }, shake: HAND,
          actors: [A("tao", 640, 1790, 0.95, [{ t: 0, mode: "stop", eyes: "wide", mouth: "flat" }, { t: v + f[1] - 0.2, mode: "whistle", eyes: "wide", mouth: "scream" }], { flip: true }),
            A("mem", 880, 1820, 1.0, [{ t: 0, mode: "raise", eyes: "angry", mouth: "o" }, { t: v + 1.5, mode: "phoneEar", eyes: "angry", mouth: "o" }], { flip: true })],
          captions: caps(K),
          fx(tl, id, t0, L) {
            WarUI.steps(tl, L.light, t0, [{ icon: "still", text: "หยุด", at: v + 0.1, red: true }, { icon: "shout", text: "เตือนคนอื่น", at: v + 0.8 }, { icon: "radio", text: "เรียกคนช่วย", at: v + 1.6 }, { icon: "tell", text: "ตะโกนบอก", at: v + f[1] }], { y: 330, w: 230, dur: D(K) });
            live(tl, t0, D(K), L); ["a0", "a1"].forEach((a) => War.jiggle(tl, `${id}-${a}`, t0, D(K), { amp: 5, period: 0.5 })); motes(tl, t0, D(K), L, 16);
          },
        }, {
          set: "border", setOpts: { ...FIELD, id: "b12b", pathX: 160, band: [-300, 900, 1525, 30], fgH: 0.4 },
          dark: 0, blur: { sky: 3, far: 4, mid: 3, fg: 9 }, light: GOLD, grade: GGOLD,
          cam: { keys: [{ t: 0, ...fr(440, 1460, 2.2, 540, 1050), drift: { s: 0.02 } }] }, shake: HAND,
          actors: [A("joe", JOE[0], JOE[1], 0.5, [{ t: 0, mode: "lie", eyes: "wide", mouth: "flat" }, { t: 0.9, mode: "lie", eyes: "closed", mouth: "flat" }], { flip: true })],
          captions: capsFrom(K, v + f[2] - 0.1),
          fx(tl, id, t0, L) { live(tl, t0, 3, L); War.spot(tl, L.glow, 420, 1440, t0 + 0.25, 2.2, { label: "อย่าขยับ", icon: "still", r: 120, w: 200, tx: 50 }); motes(tl, t0, 3, L, 17); },
        }); }
      // ---------- 13. the clearance team probes and marks a lane to โจ้ ----------
      add("clear", {
        set: "border", setOpts: { ...FIELD, id: "b13", pathX: 160, band: [-300, 900, 1505, 26], fgH: 0.4 },
        dark: 0, blur: { sky: 1, far: 1.5, mid: 1, fg: 8 }, light: GOLD, grade: GGOLD,
        cam: push("clear", [520, 1520, 1.15, 540, 1150], [480, 1510, 1.3, 540, 1150]), shake: HAND,
        actors: [A("joe", JOE[0], JOE[1], 0.5, [{ t: 0, mode: "lie", eyes: "normal", mouth: "flat" }], { flip: true }),
          A("eod", 560, 1560, 0.56, [{ t: 0, mode: "kneel", eyes: "normal", mouth: "flat" }], { flip: true, path: [{ t: 0, x: 640, y: 1600 }, { t: 2.0, x: 560, y: 1560 }, { t: 4.5, x: 480, y: 1530 }] }),
          A("eod", 760, 1640, 0.64, [{ t: 0, mode: "pointAt", eyes: "normal", mouth: "flat" }], { flip: true }),
          A("mem", 980, 1830, 1.0, [{ t: 0, mode: "kneel", eyes: "worry", mouth: "flat" }], { flip: true })],
        captions: caps("clear"),
        fx(tl, id, t0, L) { War.lane(tl, L.set, [[880, 1700], [760, 1650], [640, 1600], [540, 1560], [440, 1530]], t0 + 0.3, D("clear") - 0.4, { s: 0.7 }); live(tl, t0, D("clear"), L); motes(tl, t0, D("clear"), L, 18); },
      });
      // ---------- 14. rewind → 0:04 ----------
      split("rw", vo("rw", 1) - 0.1, {
        set: "border", setOpts: { ...FIELD, id: "b14", pathX: 160, band: [-300, 900, 1505, 26], fgH: 0.5 },
        dark: 0, blur: { sky: 1, far: 1.2, mid: 0.8, fg: 7 }, light: GOLD, grade: GGOLD,
        cam: { keys: [{ t: 0, ...fr(580, 1560, 1.26, 540, 1240), drift: { s: 0.01 } }] }, shake: HAND,
        actors: [A("joe", JOE[0], JOE[1], 0.5, [{ t: 0, mode: "lie", eyes: "normal", mouth: "flat" }], { flip: true }), A("tao", 720, 1790, 0.95, [{ t: 0, mode: "kneel", eyes: "worry", mouth: "flat" }], { flip: true })],
        captions: caps("rw"),
        fx(tl, id, t0, L) { QkUI.rewind(tl, L.light, t0 + vo("rw", 1) - 1.0, 0.9, { from: "0:56", to: "0:04" }); live(tl, t0, 3, L); },
      }, {
        set: "border", setOpts: { ...FIELD, id: "b14b", glint: false, pathX: 380, bamboo: 470, band: [-300, 1500, 1640, 50], fgH: 0.5 },
        dark: 0, blur: { sky: 2, far: 3, mid: 2, fg: 8 }, light: GOLD, grade: GVHS,
        cam: { keys: [{ t: 0, ...fr(560, 1560, 1.7, 540, 1150), drift: { s: 0.03 } }] },
        captions: capsFrom("rw", vo("rw", 1) - 0.1),
        fx(tl, id, t0, L) { War.bush(L.set, 230, 1450, 0.8, "", { seed: 31 }); War.spot(tl, L.glow, 470, 1300, t0 + 0.1, 1.4, { label: "วินาทีที่ 4", icon: "bamboo", r: 130, w: 220, tx: 50 }); },
      });
      // ---------- 15. replay: โจ้ walks round the crossed bamboo into the grass ----------
      add("reveal", {
        set: "border", setOpts: { ...FIELD, id: "b15", glint: false, pathX: 380, bamboo: 470, band: [-300, 1500, 1640, 40], fgH: 0.45 },
        dark: 0, blur: { sky: 1.5, far: 2, mid: 1.5, fg: 8 }, light: GOLD, grade: GVHS,
        cam: push("reveal", [480, 1430, 1.6, 540, 1150], [560, 1420, 1.75, 540, 1150]),
        actors: [A("joe", 400, 1560, 0.5, [{ t: 0, mode: "walk", eyes: "normal", mouth: "smile" }],
          { flip: false, path: [{ t: 0, x: 300, y: 1600, s: 0.52, flip: false }, { t: 1.0, x: 330, y: 1490, s: 0.47, flip: false }, { t: 2.0, x: 600, y: 1470, s: 0.46, flip: false }, { t: 3.6, x: 780, y: 1395, s: 0.42, flip: false }] })],
        captions: caps("reveal"),
        fx(tl, id, t0, L) { War.spot(tl, L.glow, 470, 1300, t0 + 0.15, D("reveal") - 0.2, { label: "ไม้ไผ่ปักไขว้", icon: "bamboo", r: 130, w: 250, tx: 50 }); live(tl, t0, D("reveal"), L); War.jiggle(tl, `${id}-a0`, t0, D("reveal"), { amp: 6, period: 0.48 }); },
      });
      // ---------- 16. two hours later, dusk: โจ้ out on the lane; เต๋า hugs him ----------
      add("relief", {
        set: "border", setOpts: { ...FIELD, id: "b16", time: "dusk", glint: false, pathX: 160, band: [-300, 1500, 1810, 50], fgH: 0.4, sunX: 120 },
        dark: 0.05, blur: { sky: 2, far: 2.5, mid: 2, fg: 8 }, light: DUSKL, grade: GDUSKR,
        cam: push("relief", [560, 1500, 1.5, 540, 1150], [560, 1480, 1.62, 540, 1150]), shake: HAND,
        actors: [A("joe", 420, 1790, 0.9, [{ t: 0, mode: "sit", eyes: "closed", mouth: "smile" }]), A("tao", 610, 1800, 0.92, [{ t: 0, mode: "kneel", eyes: "closed", mouth: "laugh" }], { flip: true }),
          A("mem", 860, 1810, 0.95, [{ t: 0, mode: "shrug", eyes: "closed", mouth: "smile" }], { flip: true }), A("eod", 200, 1640, 0.62, [{ t: 0, mode: "walk", eyes: "normal", mouth: "flat" }], { path: [{ t: 0, x: 200, y: 1640 }, { t: 5, x: -60, y: 1640 }] })],
        captions: caps("relief"),
        fx(tl, id, t0, L) { RabFX.motes(tl, L.glow, t0, D("relief"), { kind: "fly", box: [0, 900, 1080, 900], n: 14, seed: 19 }); live(tl, t0, D("relief"), L); },
      });
      // ---------- 17. the twist: the dust still hanging — up to the ridge, the glint ----------
      add("twist", {
        set: "border", setOpts: { ...FIELD, id: "b17", time: "dusk", glintX: 860, pathX: 160, fgH: 0.4, sunX: 120 },
        dark: 0.06, blur: { sky: 1, far: 1, mid: 1, fg: 8 }, light: DUSKL, grade: GDUSKR,
        cam: { keys: [{ t: 0, ...fr(540, 1400, 1.0, 540, 1150), drift: { s: 0.01 } }, { t: vo("twist", 0) + 2.4, glide: 2.0, ...fr(700, 1040, 1.4, 540, 900), drift: { s: 0.01 } }, { t: D("twist") - 0.2, glide: 1.2, ...fr(860, 960, 3.0, 540, 700) }] },
        captions: caps("twist"),
        fx(tl, id, t0, L) { War.column(tl, L, 340, 1380, t0, D("twist"), { s: 1.2, dusk: true }); War.glint(tl, "b17", t0, D("twist"), { at: [vo("twist", 0) + 1.6, vo("twist", 0) + 2.8, D("twist") - 0.7] }); RabFX.motes(tl, L.glow, t0, D("twist"), { kind: "fly", box: [0, 900, 1080, 900], n: 12, seed: 20 }); live(tl, t0, D("twist"), L); },
      });
      // ---------- 18. choice ----------
      add("choice", {
        set: "border", setOpts: { ...FIELD, id: "b18", time: "dusk", glint: false }, ...CARD, light: DUSKL, grade: GDUSKR, cam: push("choice", [540, 1200, 1.0, 540, 1100], [540, 1200, 1.05, 540, 1100]),
        fx(tl, id, t0, L) { QkUI.choice(tl, L.light, t0, D("choice"), { q: "ถ้าเป็นคุณ จะทำยังไง?", a: { text: "วิ่งไปช่วย", icon: "norush" }, b: { text: "หยุด เรียกคนช่วย", icon: "still" }, secs: 3, pick: "b", pickAt: D("choice") - 1.2, mark: { at: D("choice") - 0.8, wrong: "a" } }); },
      });
      // ---------- 19. end sign + next ----------
      add("next", {
        set: "border", setOpts: { ...FIELD, id: "b19", time: "dusk", glint: false, tree: false }, dark: 0.05, blur: { sky: 3, far: 4, mid: 4, set: 3, fg: 8 }, light: DUSKL, grade: GDUSKR, cam: push("next", [540, 1200, 1.0, 540, 1100], [540, 1200, 1.04, 540, 1100]),
        fx(tl, id, t0, L) { WarUI.endCard(tl, L.light, t0, D("next"), { ep: "ตอนที่ 2 · อย่าหลบหลังพุ่มไม้", next: ["ถ้ากระสุนพุ่งมาหาคุณ…", "จะหลบหลังอะไรดี?"] }); },
      });
