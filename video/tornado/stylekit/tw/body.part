      // ---------- นาคเล่นน้ำ: style frames (owner 4 Nov 2569: "ทำภาพมาก่อน") ----------
      SK.fon = ["#ebc19c", "#c8946e", "#f6d8b8"]; SK.pu = ["#d49c6c", "#a8704a", "#ecc09a"]; SK.bua = ["#c8946a", "#9a6a48", "#e0b48c"];
      Object.assign(SKN, { fon: SK.fon, fonPhone: SK.fon, pu: SK.pu, puCam: SK.pu, yaiBua: SK.bua, taTian: SK.lung });
      Rig.MODES.kWai = (u, o) => ({ ...Rig.MODES.idle(u, o), ...KNEE(o), torso: 10, head: 14, uaF: -22, faF: -148, uaB: -16, faB: -150 });
      Rig.MODES.film = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -112 + 2 * Math.sin(u * 2), faF: -28, uaB: 4, faB: -14, torso: -3, head: -10 });
      Rig.MODES.camEye = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -64, faF: -118, uaB: -50, faB: -112, torso: 2, head: 0 });
      const NSC = (id, o = {}) => ({ ...SC(id, o), set: "ngwScape" });
      const HEARTS = (pts) => pts.map(([x, y, s, c]) => `<path transform="translate(${x},${y}) scale(${s})" d="M0,8C-14,-2 -18,-14 -9,-19C-4,-22 0,-17 0,-14C0,-17 4,-22 9,-19C18,-14 14,-2 0,8Z" fill="${c || "#ff4a6a"}" stroke="#fff" stroke-width="2"/>`).join("");
      Rig.MODES.kCover = (u, o) => ({ ...Rig.MODES.cower(u, o), ...KNEE(o), torso: 24 + 1.5 * Math.sin(u * 40), head: 20, bodyY: o.by ?? 150 });
      Rig.MODES.prone = (u, o) => ({ ...Rig.MODES.lie(u, o), uaF: -172, faF: -104, uaB: 172, faB: 104, head: 18, torso: 0, thF: -2, shF: 4, thB: 2, shB: 2 });
      // ---------- ทอร์นาโดยักษ์ (owner 4 Nov: "ไม่ต้องเอาผี เอาแบบภัยพิบัติใหญ่ ธอนาโดไม่ใช่พายุงวงช้าง") ----------
      const SUNL = { from: "right", rim: "#ffd890", rimOp: 0.9, shade: "#0a0e14", shadeOp: 0.45, cast: false, vol: false }, GSUN = { top: "#16202a", bottom: "#3a2a18", op: 0.18 };
      // ---------- v3 (owner: "คิดว่าดีเท่าทะเลลดยัง"): a bright everyday opening, the warning sign (a freight-train roar with no railway
      // near), ยายบัว's rule board, the choice — the ทะเลลด grammar ----------
      const I = "#1e1a16";
      const coinT = (pic, c = "#f4e8cc") => `<g><circle cx="60" cy="64" r="56" fill="#7a5a38" stroke="${I}" stroke-width="5"/><circle cx="60" cy="60" r="56" fill="${c}" stroke="${I}" stroke-width="5"/><circle cx="60" cy="60" r="46" fill="none" stroke="#c8b48a" stroke-width="3"/>${pic}</g>`;
      const PIC = {
        roar: `<path d="M34,26H86L70,48L74,60L64,74L66,84L60,98L56,84L54,72L46,58L50,46Z" fill="#5a636a" stroke="${I}" stroke-width="3.4" stroke-linejoin="round"/><path d="M40,34H80M48,50H72M52,64H66" stroke="#2e363c" stroke-width="3"/>
          <path d="M84,56q8,8 0,16M90,50q14,14 0,28M96,44q20,20 0,40" stroke="#d8312a" stroke-width="4.5" fill="none" stroke-linecap="round"/>`,
        win: `<path d="M18,74H102V84H18Z" fill="#a8a69c" stroke="${I}" stroke-width="3.4"/><path d="M28,84V100M92,84V100" stroke="${I}" stroke-width="7"/><path d="M22,96h80" stroke="#7a786e" stroke-width="3"/>
          <rect x="32" y="22" width="38" height="40" fill="#9ad0f0" stroke="${I}" stroke-width="3.4"/><path d="M51,22V62M32,42H70M40,30l20,24M60,28l-8,16" stroke="${I}" stroke-width="2.4"/>
          <path d="M76,90h-40M70,94h-30" stroke="#3a7ac8" stroke-width="3.4" stroke-linecap="round"/><path d="M40,86l-6,6l6,6" stroke="#3a7ac8" stroke-width="3.4" fill="none"/>`,
        ditch: `<path d="M12,58H36L46,82H74L84,58H108" stroke="#6a5032" stroke-width="7" fill="none" stroke-linejoin="round"/><path d="M46,82H74" stroke="#4a8ac8" stroke-width="5"/>
          <path d="M50,74H84" stroke="#d8382a" stroke-width="11" stroke-linecap="round"/><circle cx="44" cy="72" r="8" fill="#d49c6c" stroke="${I}" stroke-width="2.4"/><path d="M38,66q8,-12 20,-2M42,64q10,-6 18,4" stroke="#d49c6c" stroke-width="5" fill="none" stroke-linecap="round"/>
          <path d="M60,40q16,-16 32,0" stroke="#5a636a" stroke-width="5" fill="none"/><path d="M84,32l8,8l-10,4" stroke="#5a636a" stroke-width="4" fill="none"/>`,
      };
      TideUI.ICON.twRoar = () => coinT(PIC.roar); TideUI.ICON.twWin = () => coinT(PIC.win); TideUI.ICON.twDitch = () => coinT(PIC.ditch);
      const TW_RULES = [["twRoar", "ได้ยิน<u>ครืน</u> อย่า<u>ยืน</u>ดู"], ["twWin", "ห้อง<u>ใน</u> ไม่<u>ใกล้</u>หน้าต่าง"], ["twDitch", "หนีไม่ทัน<u>ตึก</u> หมอบ<u>ลึก</u>ที่ต่ำ"]];
      const SFXW = (x, y, txt, s = 1, rot = -6) => `<g transform="translate(${x},${y}) rotate(${rot}) scale(${s})"><text text-anchor="middle" font-family="Sriracha" font-size="118" fill="#f6f2e8" stroke="#1e1a16" stroke-width="16" paint-order="stroke" letter-spacing="2">${txt}</text>
        ${[0, 1, 2].map((k) => `<path d="M${330 + k * 34},-80q${30 + k * 10},40 0,${80 + k * 20}" stroke="#f6f2e8" stroke-width="10" fill="none" stroke-linecap="round" opacity="${0.9 - k * 0.25}"/>`).join("")}</g>`;
      const BUBBLE = (x, y, txt, tx = -40, w = 640) => `<g transform="translate(${x},${y})"><rect x="${-w / 2}" y="-80" width="${w}" height="140" rx="44" fill="#fff" stroke="#1e1a16" stroke-width="6"/><path d="M${tx - 20},58L${tx - 44},126L${tx + 34},58Z" fill="#fff" stroke="#1e1a16" stroke-width="6" stroke-linejoin="round"/><path d="M${tx - 18},56H${tx + 32}" stroke="#fff" stroke-width="10"/>
        <text y="16" text-anchor="middle" font-family="Sriracha" font-size="50" fill="#1e1a16">${txt}</text></g>`;
      const HOME = { village: [{ x: 160, y: 1300, s: 0.42 }, { kind: "wat", x: 760, y: 1178, s: 0.24 }, { x: 1150, y: 1306, s: 0.4, flip: 1 }, { x: -320, y: 1296, s: 0.38, flip: 1 }, { x: 1560, y: 1290, s: 0.36 }],
        road: { y: 1560, h: 170 }, poles: { xs: [-700, -260, 180, 620, 1060, 1500, 1940], y: 1550, s: 0.85, tf: [3], sag: 46 } };
      // A · everyday: a hot bright afternoon in the village — ยายบัว's roadside stall, ฝน live with the food, ปู with his little camera;
      // far off on the horizon a thunderstorm is building
      ADD("a0", { set: "ngwScape", setOpts: { id: "a0", mood: "clear", horizon: 1160, wind: 0.2, sunX: 860, farStorm: true, farStormX: 1350, fgRice: false, ...HOME,
          props: () => Rup2.stall(800, 1700, 0.95) + Rup2.moto(200, 1722, 0.85) },
        dark: 0, light: CLEARL, grade: GC, land: { y0: 470 },
        cam: push2("a0", fr(540, 960, 1.0, 540, 960), fr(540, 980, 1.04, 540, 960)),
        actors: [P("yaiBua", 880, 1860, 0.95, "idle", "normal", "smile", { flip: true }), P("fonPhone", 340, 1890, 1.0, "film", "normal", "smile"), P("puCam", 580, 1870, 0.78, "camEye", "normal", "laugh")] });
      // B · the sign: the sky has gone dark and a loud, continuous roar won't fade like thunder — "เสียงรถไฟ? แถวนี้ไม่มีรางนะ"
      ADD("b0", { ...NSC("b0", { horizon: 1160, rain: 0.25, ...HOME, fgRice: false,
          epic: { id: "eb", x: 900, y: 1172, h: 520, wb: 170, wt: 400, tx: 930, sun: 1, seed: 53, tiers: 7, tierW: 90, bolts: [], flashes: [], bigScale: 0.55, subs: [], sunDx: 500 },
          props: () => Rup2.stall(800, 1700, 0.95) + Rup2.moto(200, 1722, 0.85) }),
        land: { y0: 380 },
        cam: push2("b0", fr(540, 960, 1.0, 540, 960), fr(540, 960, 1.05, 540, 960)), shake: rumble(1),
        actors: [P("yaiBua", 880, 1860, 0.95, "point", "wide", "o"), P("fonPhone", 340, 1890, 1.0, "idle", "wide", "o"), P("pu", 580, 1870, 0.78, "idle", "wide", "o")],
        fx: (tl, id, t0, L) => { Ngw.epicLife(tl, "eb", t0, D("b0")); put(L.light, SFXW(470, 470, "ครืนนนนนน…", 1) + BUBBLE(560, 1150, "เสียงรถไฟ? แถวนี้ไม่มีรางนะ", 0)); } });
      // T1 · the monster on the horizon: a wedge tornado under its supercell coming across the plains toward the town; cars stopped on
      // the highway, people out filming it (the mistake), ยายบัว yelling at them to get inside
      ADD("t1", { ...NSC("t1", { horizon: 1200, rain: 0.4, vx: 540,
          epic: { id: "ep1", x: 540, h: 700, wb: 300, wt: 640, tx: 590, sun: 1, seed: 51 },
          village: [{ x: 1110, y: 1210, s: 0.12 }, { x: 1240, y: 1212, s: 0.11, flip: 1 }, { kind: "wat", x: -130, y: 1208, s: 0.2 }],
          road: { y: 1640, h: 160 },
          poles: { xs: [-700, -260, 180, 620, 1060, 1500, 1940], y: 1630, s: 0.8, tf: [3], sag: 46 },
          props: () => Tk.pickup(880, 1735, 0.58) + Rup2.moto(250, 1755, 0.85) + Ngw.sign(1010, 1630, 0.5) }),
        land: { y0: 190 },
        cam: push2("t1", fr(540, 960, 1.0, 540, 960), fr(540, 950, 1.04, 540, 960)),
        actors: [P("fonPhone", 300, 1900, 0.9, "film", "wide", "o"), P("puCam", 540, 1890, 0.7, "camEye", "wide", "o"), P("yaiBua", 830, 1905, 0.88, "yell", "angry", "scream", { flip: true })],
        light: SUNL, grade: GSUN,
        fx: (tl, id, t0) => Ngw.epicLife(tl, "ep1", t0, D("t1")) });
      // extras: two drivers who stopped on the highway
      Rig.CAST.exA = { v2: { ...Rig.CAST.keng.v2, top: { kind: "shirt", c: "#3a6aa8", sleeve: "short", neck: "collar", collar: "#2e5a90", button: "#e8e4d8" }, print: "", bottom: { kind: "jeans", c: "#2a2e38" }, feet: { kind: "sneaker", c: "#e8e4d8" } } };
      Rig.CAST.exB = { v2: { ...Rig.CAST.june.v2, top: { kind: "blouse", c: "#c83a4a", sleeve: "elbow", trim: "#a82a3a" }, print: "", bottom: { kind: "jeans", c: "#3a4a6a" }, feet: { kind: "sandal", c: "#3a2a1a" } } };
      Object.assign(SKN, { exA: SK.medic, exB: SK.fon });
      // C · ยายบัว's rule board over the highway shot, dimmed
      ADD("c0", { ...NSC("c0", { horizon: 1200, rain: 0.3, epic: { id: "ec", x: 540, h: 700, wb: 300, wt: 640, tx: 590, sun: 1, seed: 51, flashes: [] },
          road: { y: 1640, h: 160 }, poles: { xs: [-700, -260, 180, 620, 1060, 1500, 1940], y: 1630, s: 0.8, tf: [3], sag: 46 } }), dark: 0.4,
        land: { y0: 250 },
        cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }] },
        fx: (tl, id, t0, L) => { Ngw.epicLife(tl, "ec", t0, D("c0")); TideUI.rule(tl, L.light, t0, D("c0"), { rules: TW_RULES, title: "กฎของยายบัว", seq: true, at: [0.2, 0.35, 0.5], y: 330 }); } });
      // T2 · it hits the village: roofs tear off and fly into the funnel, a pole snaps with a blue-green flash; ฝน and ปู run for it
      ADD("t2", { ...NSC("t2", { horizon: 1060, rain: 0.8, vx: 540, fgRice: false,
          epic: { id: "e2", x: 400, y: 1240, h: 1000, wb: 470, wt: 860, tx: 470, sun: 1, seed: 55, tiers: 5, tierW: 140, bigScale: 1.7, sunDx: 900, flashes: [[2.2, 0.03]], bolts: [[-1.0, 0.5, 5]] },
          ruins: [{ x: 840, y: 1236, s: 0.34, level: 1, dir: -1 }, { x: 1200, y: 1240, s: 0.3, level: 1, dir: -1, seed: 62 }, { x: 40, y: 1256, s: 0.36, level: 2 }, { x: -340, y: 1246, s: 0.3, level: 2, seed: 64 }],
          road: { y: 1560, h: 220 }, poles: { xs: [-500, 40, 580, 1120, 1660], y: 1550, s: 0.95, tf: [2], lean: [0, 0, -14, 0, 0], sag: 60 },
          props: () => Ngw.debris(-600, 1700, 1330, 1540, 40, 72, 0.8) }),
        land: { y0: 200 },
        cam: push2("t2", fr(540, 960, 1.0, 540, 960), fr(540, 980, 1.05, 540, 960)), shake: rumble(2.5),
        actors: [P("fonPhone", 560, 1890, 1.0, "run", "wide", "o"), P("pu", 820, 1860, 0.78, "run", "wide", "o")],
        light: SUNL, grade: GSUN,
        fx: (tl, id, t0) => Ngw.epicLife(tl, "e2", t0, D("t2"), { flashAt: [0.4, 1.4] }) });
      // T3 · the right move: the bathroom in the middle of the house, no window — down low, cover the head; dust falls, the door bulges
      ADD("t3", { set: "ngwKuti", setOpts: { id: "ku", robeC: "#3a7ac8", robeS: "#2a5a98" }, dark: 0.2, light: GOLDL, grade: { top: "#3a2a1a", bottom: "#0a0806", op: 0.22 },
        land: { y0: 520 },
        cam: push2("t3", fr(540, 1300, 1.0, 540, 1100), fr(540, 1300, 1.04, 540, 1100)), shake: rumble(1.6),
        actors: [P("yaiBua", 190, 1780, 0.95, "kCover", "closed", "frown"), P("fonPhone", 500, 1810, 0.95, "kCover", "wide", "o"), P("taTian", 900, 1760, 0.9, "kCover", "worry", "frown", { flip: true })],
        fx: (tl, id, t0, L) => { Ngw.kutiLife(tl, "ku", t0, D("t3"), [1.2]); put(L.light, `<g opacity=".7">${Array.from({ length: 60 }, (_, k) => `<circle cx="${(k * 97) % 1100}" cy="${200 + (k * 211) % 1500}" r="${2 + (k % 3)}" fill="#c8bca0"/>`).join("")}</g>`); } });
      // T4 · the deadly mistake: drivers crawl up under the highway overpass — the wind squeezes through the gap faster, with the debris in it
      ADD("t4", { ...NSC("t4", { horizon: 1180, rain: 0.9, vx: 540, fgRice: false,
          epic: { id: "e4", x: 620, y: 1190, h: 800, wb: 420, wt: 760, tx: 660, sun: -1, seed: 57, tiers: 4, bolts: [], flashes: [], sunDx: 700 },
          road: { y: 1560, h: 400 }, overpass: { y: 520, h: 150, ground: 1560, pier: 980, slopeX: 560 } }),
        grade: GW,
        land: { y0: 380 },
        cam: push2("t4", fr(540, 960, 1.0, 540, 960), fr(540, 960, 1.05, 540, 960)), shake: rumble(2),
        actors: [P("exA", 470, 900, 0.5, "kCover", "wide", "scream", { flip: true }), P("exB", 370, 1040, 0.5, "kCover", "wide", "scream", { flip: true }), P("taTian", 260, 1190, 0.5, "kCover", "worry", "scream", { flip: true })],
        fx: (tl, id, t0, L) => { Ngw.epicLife(tl, "e4", t0, D("t4")); put(L.light, Ngw.streaks(300, 1300, 760, 1450, 30, 81) + `<g opacity=".95">${Ngw.debris(200, 1200, 800, 1350, 12, 83, 0.55)}</g>`); } });
      // D · the choice: caught on the highway, the tornado coming — under the overpass, or flat in the ditch?
      ADD("d0", { ...NSC("d0", { horizon: 1180, rain: 0.8, epic: { id: "ed", x: 620, y: 1190, h: 800, wb: 420, wt: 760, tx: 660, sun: -1, seed: 57, tiers: 4, bolts: [], flashes: [], sunDx: 700 },
          road: { y: 1560, h: 400 }, overpass: { y: 520, h: 150, ground: 1560, pier: 980, slopeX: 560 } }), dark: 0.35,
        land: { y0: 380 },
        cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }] },
        fx: (tl, id, t0, L) => { Ngw.epicLife(tl, "ed", t0, D("d0"));
          const BR = `<g transform="translate(-60,-70) scale(1.1)">${coinT(PIC.win.split('<rect')[0])}</g>`, DI = `<g transform="translate(-60,-70) scale(1.1)">${coinT(PIC.ditch)}</g>`;
          TideUI.choice(tl, L.light, t0, D("d0"), { q: "จะหลบที่ไหน?", a: { text: "มุดใต้สะพานทางหลวง", icon: BR }, b: { text: "หมอบราบในคูน้ำ", icon: DI }, secs: 3 });
          [...L.light.querySelectorAll("text")].filter((e) => /^\d$/.test(e.textContent.trim())).forEach((e) => e.remove()); } });
      // T5 · caught outside with nowhere to go: ปู flat in the roadside ditch, arms over his head, the monster tearing past
      ADD("t5", { ...NSC("t5", { horizon: 840, rain: 0.9, fgRice: false, ditch: { y: 1450 },
          epic: { id: "e5", x: 600, y: 1236, h: 1120, wb: 500, wt: 940, tx: 680, sun: -1, seed: 59, tiers: 4, tierW: 160, bigScale: 1.6, sunDx: 900, flashes: [[2.0, 0.03]], bolts: [[-1.1, 0.5, 9]] },
          far: () => Rup.tree(110, 880, 220) + Tk.pickup(990, 872, 0.26) }),
        land: { y0: 330 },
        cam: push2("t5", fr(540, 1100, 1.0, 540, 960), fr(540, 1100, 1.04, 540, 960)), shake: rumble(2),
        actors: [P("pu", 880, 1540, 0.9, "prone", "closed", "frown")],
        light: { ...SUNL, from: "left" }, grade: GSUN,
        fx: (tl, id, t0) => Ngw.epicLife(tl, "e5", t0, D("t5")) });
      // T6 · after: the village flattened — broken walls, roofs gone, a pole down, debris everywhere; the storm moving off, the sun
      // breaking through; ยายบัว holds on to ปู, ฝน lowers her phone
      ADD("t6", { set: "ngwScape", setOpts: { id: "t6", mood: "gold", wallX: 360, horizon: 1100, wind: 0.2, fgRice: false, sunX: 900,
          spouts: [{ id: "rope6", kind: "land", x: 140, y: 1104, tx: 60, ty: 640, wb: 14, wt: 120, p: 3, bend: 60, bend2: -30, spray: 40, seed: 5, op: 0.6, rings: [] }],
          ruins: [{ x: 120, y: 1260, s: 0.4, level: 2 }, { x: 560, y: 1250, s: 0.36, level: 2, seed: 66, flip: 1 }, { x: 940, y: 1262, s: 0.4, level: 1, dir: -1, seed: 67 }, { x: 1320, y: 1250, s: 0.34, level: 2, seed: 68 }, { x: -320, y: 1252, s: 0.34, level: 2, seed: 69 }],
          poles: { xs: [-420, 300, 1020, 1740], y: 1420, s: 0.95, lean: [0, 62, 0, 0], sag: 120 },
          props: () => Ngw.debris(-700, 1800, 1300, 1980, 70, 91, 1.1) + Tk.pickup(-120, 1500, 0.5) },
        dark: 0, light: GOLDL, grade: GG,
        land: { y0: 420 },
        cam: push2("t6", fr(540, 960, 1.0, 540, 960), fr(540, 970, 1.04, 540, 960)),
        actors: [P("yaiBua", 400, 1820, 0.95, "kneel", "worry", "frown"), P("pu", 560, 1800, 0.76, "idle", "worry", "frown", { flip: true }), P("fonPhone", 820, 1860, 1.0, "phoneLook", "worry", "frown", { flip: true })] });
      // E · the title, painted on the highway, seen from above; the storm's dark swirl and its dust coming over the top
      ADD("e0", { set: "ngwRoadTop", setOpts: { id: "rt", title: "เสียงรถไฟ", sub: "ตอนที่ 1" }, dark: 0.08, light: false, grade: GSUN, land: { y0: 470 },
        cam: push2("e0", fr(540, 1000, 1.0, 540, 960), fr(540, 1000, 1.08, 540, 960)) });
      // F · ฝน's live: the storm through her phone, the comments split between "หนีเร็ว" and "ถ่ายต่อ" (no viewer numbers)
      ADD("f0", { ...NSC("f0", { horizon: 1200, rain: 0.4, vx: 540, epic: { id: "ef", x: 560, h: 720, wb: 300, wt: 660, tx: 610, sun: 1, seed: 61 },
          village: [{ x: 1110, y: 1210, s: 0.12 }, { x: 1240, y: 1212, s: 0.11, flip: 1 }, { kind: "wat", x: -130, y: 1208, s: 0.2 }],
          road: { y: 1640, h: 160 }, poles: { xs: [-700, -260, 180, 620, 1060, 1500, 1940], y: 1630, s: 0.8, tf: [3], sag: 46 } }), light: SUNL, grade: GSUN,
        land: { y0: 250 },
        cam: push2("f0", fr(540, 960, 1.0, 540, 960), fr(560, 960, 1.06, 540, 960)), shake: rumble(1.2),
        fx: (tl, id, t0, L) => { Ngw.epicLife(tl, "ef", t0, D("f0")); put(L.light, Ngw.liveUI({ name: "ฝนพาเที่ยว", title: "พายุมาแล้ววว", comments: [["ป้าแดง", "ฝน หนีเร็วลูก!!", "#e86a8a"], ["นนท์", "ถ่ายต่อๆ ซูมอีก", "#6a8ac8"], ["มายด์", "นั่นทอร์นาโดจริงเหรอ", "#8ac86a"], ["ลุงชัย", "เข้าบ้านเดี๋ยวนี้!", "#c8a040"]] })); } });
      // G · the knowledge: the house cut open — where to shelter (SPC: lowest floor, small centre room, no windows; CDC: avoid windows)
      ADD("g0", { set: "ngwHouseCut", setOpts: {}, dark: 0, light: false, land: { y0: 310 },
        cam: push2("g0", fr(540, 960, 1.0, 540, 960), fr(540, 980, 1.03, 540, 960)) });
