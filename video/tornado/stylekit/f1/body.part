      // 27 · ตาเทียน drives at the overpass ("จับไว้!") — QA: ปู crouched in the bed gripping the side, not standing; then close on him for
      //      "ตา… ใต้สะพานปลอดภัยจริงๆ ใช่ไหม"
      Rig.MODES.rideHold = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: -34 + 3 * Math.sin(u * 29), faF: -76, uaB: 22, faB: -88, torso: 20, head: -10 + 3 * Math.sin(u * 17), bodyY: o.by ?? 160 });
      { const c = SH.truck.vo[1].t - 0.12, TR = (id, eid) => NSC(id, { horizon: 1180, rain: 0.9, vx: 540, fgRice: false, epic: { id: eid, x: 300, y: 1190, h: 800, wb: 420, wt: 760, tx: 340, sun: -1, seed: 57, tiers: 4, bolts: [], flashes: [], sunDx: 700 },
