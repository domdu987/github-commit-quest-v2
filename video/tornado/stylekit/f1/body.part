        SPLITN("truck", [c], [
          { ...TR("tr", "e27"), land: { y0: 380 }, cam: PUSHD(c, fr(560, 1300, 1.2, 540, 1000), fr(600, 1300, 1.27, 540, 1000)), shake: rumble(2),
            actors: [P("pu", 300, 1762, 0.72, "rideHold", "fear", "o")], fx: (tl, id, t0) => Ngw.epicLife(tl, "e27", t0, c) },
          { ...TR("tr2", "e27b"), blur: { sky: 5, far: 5, mid: 5, set: 3 }, land: { y0: 380 }, cam: PUSHD(D("truck") - c, fr(300, 1480, 2.3, 540, 1050), fr(300, 1480, 2.45, 540, 1050)), shake: rumble(2.4),
            actors: [P("pu", 300, 1762, 0.72, "rideHold", "fear", "o", { talk: [[0.12, 0.12 + SH.truck.vo[1].dur, "o"]] })], fx: (tl, id, t0) => Ngw.epicLife(tl, "e27b", t0, D("truck") - c) }]); }
      // 28 · the choice, pulled toward the bridge → black
      ADD("choice", { ...NSC("chs", { horizon: 1180, rain: 0.9, vx: 540, fgRice: false, epic: { id: "e28", x: 620, y: 1190, h: 800, wb: 420, wt: 760, tx: 660, sun: -1, seed: 57, tiers: 4, bolts: [], flashes: [], sunDx: 700 },
          road: { y: 1560, h: 400 }, overpass: { y: 520, h: 150, ground: 1560, pier: 980, slopeX: 560 } }), dark: 0.35, captions: caps("choice"), land: { y0: 380 },
