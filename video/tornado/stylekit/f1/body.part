      // ---------- นาคเล่นน้ำ: style frames (owner 4 Nov 2569: "ทำภาพมาก่อน") ----------
      SK.fon = ["#ebc19c", "#c8946e", "#f6d8b8"]; SK.pu = ["#d49c6c", "#a8704a", "#ecc09a"]; SK.bua = ["#c8946a", "#9a6a48", "#e0b48c"];
      Object.assign(SKN, { fon: SK.fon, fonPhone: SK.fon, pu: SK.pu, puCam: SK.pu, yaiBua: SK.bua, taTian: SK.lung });
      Rig.MODES.kWai = (u, o) => ({ ...Rig.MODES.idle(u, o), ...KNEE(o), torso: 10, head: 14, uaF: -22, faF: -148, uaB: -16, faB: -150 });
      Rig.MODES.film = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -112 + 2 * Math.sin(u * 2), faF: -28, uaB: 4, faB: -14, torso: -3, head: -10 });
      Rig.MODES.camEye = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -64, faF: -118, uaB: -50, faB: -112, torso: 2, head: 0 });
      const NSC = (id, o = {}) => ({ ...SC(id, o), set: "ngwScape" });
      const HEARTS = (pts) => pts.map(([x, y, s, c]) => `<path transform="translate(${x},${y}) scale(${s})" d="M0,8C-14,-2 -18,-14 -9,-19C-4,-22 0,-17 0,-14C0,-17 4,-22 9,-19C18,-14 14,-2 0,8Z" fill="${c || "#ff4a6a"}" stroke="#fff" stroke-width="2"/>`).join("");
      Rig.MODES.kCover = (u, o) => ({ ...Rig.MODES.cower(u, o), ...KNEE(o), torso: 24 + 1.5 * Math.sin(u * 40), head: 20, bodyY: o.by ?? 150 });
      Rig.MODES.prone = (u, o) => ({ ...Rig.MODES.lie(u, o), uaF: -172, faF: -104, uaB: 172, faB: 104, head: 18, torso: 0, thF: -2, shF: 4, thB: 2, shB: 2 });
      const SUNL = { from: "right", rim: "#ffd890", rimOp: 0.9, shade: "#0a0e14", shadeOp: 0.45, cast: false, vol: false }, GSUN = { top: "#16202a", bottom: "#3a2a18", op: 0.18 };
      // ---------- v3 (owner: "คิดว่าดีเท่าทะเลลดยัง"): a bright everyday opening, the warning sign (a freight-train roar with no railway
      // near), ยายบัว's rule board, the choice — the ทะเลลด grammar ----------
      const I = "#1e1a16";
      const coinT = (pic, c = "#f4e8cc") => `<g><circle cx="60" cy="64" r="56" fill="#7a5a38" stroke="${I}" stroke-width="5"/><circle cx="60" cy="60" r="56" fill="${c}" stroke="${I}" stroke-width="5"/><circle cx="60" cy="60" r="46" fill="none" stroke="#c8b48a" stroke-width="3"/>${pic}</g>`;
      const PIC = {
        roar: `<path d="M34,26H86L70,48L74,60L64,74L66,84L60,98L56,84L54,72L46,58L50,46Z" fill="#5a636a" stroke="${I}" stroke-width="3.4" stroke-linejoin="round"/><path d="M40,34H80M48,50H72M52,64H66" stroke="#2e363c" stroke-width="3"/>
          <path d="M84,56q8,8 0,16M90,50q14,14 0,28M96,44q20,20 0,40" stroke="#d8312a" stroke-width="4.5" fill="none" stroke-linecap="round"/>`,
        win: `<path d="M18,74H102V84H18Z" fill="#a8a69c" stroke="${I}" stroke-width="3.4"/><path d="M28,84V100M92,84V100" stroke="${I}" stroke-width="7"/><path d="M22,96h80" stroke="#7a786e" stroke-width="3"/>
          <rect x="32" y="22" width="38" height="40" fill="#9ad0f0" stroke="${I}" stroke-width="3.4"/><path d="M51,22V62M32,42H70M40,30l20,24M60,28l-8,16" stroke="${I}" stroke-width="2.4"/>
          <path d="M76,90h-40M70,94h-30" stroke="#3a7ac8" stroke-width="3.4" stroke-linecap="round"/><path d="M40,86l-6,6l6,6" stroke="#3a7ac8" stroke-width="3.4" fill="none"/>`,
        ditch: `<path d="M12,58H36L46,82H74L84,58H108" stroke="#6a5032" stroke-width="7" fill="none" stroke-linejoin="round"/><path d="M46,82H74" stroke="#4a8ac8" stroke-width="5"/>
          <path d="M50,74H84" stroke="#d8382a" stroke-width="11" stroke-linecap="round"/><circle cx="44" cy="72" r="8" fill="#d49c6c" stroke="${I}" stroke-width="2.4"/><path d="M38,66q8,-12 20,-2M42,64q10,-6 18,4" stroke="#d49c6c" stroke-width="5" fill="none" stroke-linecap="round"/>
          <path d="M60,40q16,-16 32,0" stroke="#5a636a" stroke-width="5" fill="none"/><path d="M84,32l8,8l-10,4" stroke="#5a636a" stroke-width="4" fill="none"/>`,
      };
      TideUI.ICON.twRoar = () => coinT(PIC.roar); TideUI.ICON.twWin = () => coinT(PIC.win); TideUI.ICON.twDitch = () => coinT(PIC.ditch);
      const TW_RULES = [["twRoar", "ได้ยิน<u>ครืน</u> อย่า<u>ยืน</u>ดู"], ["twWin", "ห้อง<u>ใน</u> ไม่<u>ใกล้</u>หน้าต่าง"], ["twDitch", "หนีไม่ทัน<u>ตึก</u> หมอบ<u>ลึก</u>ที่ต่ำ"]];
      const SFXW = (x, y, txt, s = 1, rot = -6) => `<g transform="translate(${x},${y}) rotate(${rot}) scale(${s})"><text text-anchor="middle" font-family="Sriracha" font-size="118" fill="#f6f2e8" stroke="#1e1a16" stroke-width="16" paint-order="stroke" letter-spacing="2">${txt}</text>
        ${[0, 1, 2].map((k) => `<path d="M${330 + k * 34},-80q${30 + k * 10},40 0,${80 + k * 20}" stroke="#f6f2e8" stroke-width="10" fill="none" stroke-linecap="round" opacity="${0.9 - k * 0.25}"/>`).join("")}</g>`;
      const BUBBLE = (x, y, txt, tx = -40, w = 640) => `<g transform="translate(${x},${y})"><rect x="${-w / 2}" y="-80" width="${w}" height="140" rx="44" fill="#fff" stroke="#1e1a16" stroke-width="6"/><path d="M${tx - 20},58L${tx - 44},126L${tx + 34},58Z" fill="#fff" stroke="#1e1a16" stroke-width="6" stroke-linejoin="round"/><path d="M${tx - 18},56H${tx + 32}" stroke="#fff" stroke-width="10"/>
        <text y="16" text-anchor="middle" font-family="Sriracha" font-size="50" fill="#1e1a16">${txt}</text></g>`;
      const HOME = { village: [{ x: 160, y: 1300, s: 0.42 }, { kind: "wat", x: 760, y: 1178, s: 0.24 }, { x: 1150, y: 1306, s: 0.4, flip: 1 }, { x: -320, y: 1296, s: 0.38, flip: 1 }, { x: 1560, y: 1290, s: 0.36 }],
        road: { y: 1560, h: 170 }, poles: { xs: [-700, -260, 180, 620, 1060, 1500, 1940], y: 1550, s: 0.85, tf: [3], sag: 46 } };
      Rig.CAST.exA = { v2: { ...Rig.CAST.keng.v2, top: { kind: "shirt", c: "#3a6aa8", sleeve: "short", neck: "collar", collar: "#2e5a90", button: "#e8e4d8" }, print: "", bottom: { kind: "jeans", c: "#2a2e38" }, feet: { kind: "sneaker", c: "#e8e4d8" } } };
      Rig.CAST.exB = { v2: { ...Rig.CAST.june.v2, top: { kind: "blouse", c: "#c83a4a", sleeve: "elbow", trim: "#a82a3a" }, print: "", bottom: { kind: "jeans", c: "#3a4a6a" }, feet: { kind: "sandal", c: "#3a2a1a" } } };
      Object.assign(SKN, { exA: SK.medic, exB: SK.fon });

      // ================= เสียงรถไฟ EP.1 (owner 4 Nov 2569: "ทำเลย") — hook A "อย่ายกมือถือขึ้นถ่าย" =================
      // QA ("plank arms"): the pointing / grabbing / yelling arms bend at the elbow and move with the words; the free hand rests on the hip
      Rig.MODES.point = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -80 + 3 * Math.sin(u * 6), faF: -26 + 5 * Math.sin(u * 6 + 0.6), uaB: 28, faB: -96, torso: 3, head: -4 + 1.5 * Math.sin(u * 6) });
      Rig.MODES.grab = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -76, faF: -20 + 3 * Math.sin(u * 9), uaB: 14, faB: -30, torso: 10, head: 4 });
      Rig.MODES.yell = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -96 + 4 * Math.sin(u * 7), faF: -34 + 6 * Math.sin(u * 7 + 0.5), uaB: 10, faB: -26, torso: -4, head: -8 + 2 * Math.sin(u * 14) });
      { const b0 = Engine.build; Engine.build = (root, tl, shots) => { b0(root, tl, shots); Ngw.addFaces(root); }; }   // mouths "shout", "fear"; eyes "fear"
      Rig.MODES.kPanic = (u, o) => ({ ...Rig.MODES.idle(u, o), ...KNEE(o), torso: 8, head: -8 + 9 * Math.sin(u * 4.2), uaF: -46 + 6 * Math.sin(u * 9), faF: -36, uaB: -152, faB: -150 });   // the far hand to her head, the near one reaching out, looking round   // kneeling, hands to her head, looking round
      Rig.MODES.kYell = (u, o) => ({ ...Rig.MODES.idle(u, o), ...KNEE(o), torso: 4, head: -12 + 2 * Math.sin(u * 13), uaF: -66 + 5 * Math.sin(u * 9), faF: -24, uaB: 26, faB: -64 });   // kneeling, calling out, one arm out to the door
      Rig.MODES.selfieUp = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -60 + 2 * Math.sin(u * 1.7), faF: -40, uaB: 8, faB: -16, head: 2 + 2 * Math.sin(u * 2.3), torso: -2 });
      Rig.MODES.reachWin = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -130, faF: -20, uaB: -20, faB: -30, torso: -4, head: -8 });
      Rig.MODES.countF = (u, o) => ({ ...Rig.MODES.idle(u, o), ...KNEE(o), torso: 8, head: 6, uaF: -70 + 10 * Math.sin(u * 6), faF: -60, uaB: -30, faB: -40 });
      Rig.MODES.hold = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -150, faF: -10, uaB: -140, faB: -14, torso: 4, head: -6 + 3 * Math.sin(u * 9) });
      const VILL = [{ x: 1110, y: 1210, s: 0.12 }, { x: 1240, y: 1212, s: 0.11, flip: 1 }, { kind: "wat", x: -130, y: 1208, s: 0.2 }];
      const ROADV = (id, o = {}) => NSC(id, { horizon: 1200, rain: 0.4, vx: 540, village: VILL, road: { y: 1640, h: 160 }, poles: { xs: [-700, -260, 180, 620, 1060, 1500, 1940], y: 1630, s: 0.8, tf: [3], sag: 46 }, ...o });
      const STALLSET = (id, o = {}) => ({ set: "ngwScape", setOpts: { id, mood: "clear", horizon: 1160, wind: 0.2, sunX: 860, farStorm: false, noRainbow: true, haze: true, tower: { x: o.fx ?? 1350, h: o.th ?? 380, dark: o.td ?? 0, id: id + "-cb" }, fgRice: false, ...HOME,
          props: () => Rup2.stall(800, 1700, 0.95) + Rup2.moto(200, 1722, 0.85) + (o.props ? o.props() : ""), ...(o.so || {}) }, dark: 0, light: CLEARL, grade: GC });
      const STALLDARK = (id, o = {}) => NSC(id, { horizon: 1160, rain: o.rain ?? 0.25, ...HOME, fgRice: false, props: () => (o.bulbs === false ? Rup2.stall(800, 1700, 0.95) : Rup2.stall(800, 1700, 0.95, { bulbs: true, id: `${id}st` }) + STALLGLOW(800, 1700, 0.95)) + Rup2.moto(200, 1722, 0.85) + (o.props ? o.props() : ""), ...(o.so || {}) });
      const EPF = (id, x, o = {}) => ({ id, x, h: 720, wb: 300, wt: 660, tx: x + 50, sun: 1, seed: 61, ...o });
      const STILL = (k, f) => ({ keys: [{ t: 0, ...f }] });
      const LIVE_BIG = [["ป้าแดง", "ฝน หนีเร็วลูก!!", "#e86a8a"], ["นนท์", "ถ่ายต่อๆ ซูมอีก", "#6a8ac8"], ["มายด์", "นั่นทอร์นาโดจริงเหรอ", "#8ac86a"], ["ลุงชัย", "เข้าบ้านเดี๋ยวนี้!", "#c8a040"]];
      // lit = headlights (warm beam), tail lights and the orange hazard lights (.ngw-hz, blinked by withHands) — the storm's practical lights
      const LAMPS = (x, y, s) => `<g><path d="M${x - 470 * s},${y - 140 * s}L${x - 1500 * s},${y - 300 * s}V${y + 80 * s}L${x - 470 * s},${y - 90 * s}Z" fill="url(#ngwBeam)" opacity=".55"/>
        <circle cx="${x - 462 * s}" cy="${y - 118 * s}" r="${24 * s}" fill="#fff6d8"/><circle cx="${x - 462 * s}" cy="${y - 118 * s}" r="${90 * s}" fill="url(#ngwBulb)"/><rect x="${x + 482 * s}" y="${y - 130 * s}" width="${16 * s}" height="${44 * s}" fill="#ff3a2a"/>
        <g class="ngw-hz"><circle cx="${x - 452 * s}" cy="${y - 78 * s}" r="${15 * s}" fill="#ffae3a"/><circle cx="${x - 452 * s}" cy="${y - 78 * s}" r="${60 * s}" fill="url(#ngwBulb)"/><circle cx="${x + 488 * s}" cy="${y - 160 * s}" r="${15 * s}" fill="#ffae3a"/><circle cx="${x + 488 * s}" cy="${y - 160 * s}" r="${60 * s}" fill="url(#ngwBulb)"/></g></g>`;
      const PICK = (x, y, s = 0.62, flip = 0, lit = 0, c) => `<g transform="translate(${x},${y}) scale(${flip ? -1 : 1},1) translate(${-x},${-y})">${Tk.pickup(x, y, s, c ? { c } : {})}${lit ? LAMPS(x, y, s) : ""}</g>`;   // c: another family's truck (ตาเทียน's stays white)
      const STALLGLOW = (x, y, s) => `<g>${Array.from({ length: 9 }, (_, k) => { const bx = -200 + k * 50, by = -284 + Math.sin(k * 0.9) * 10 + (k > 0 && k < 8 ? 16 : 0); return `<circle cx="${Math.round(x + bx * s)}" cy="${Math.round(y + (by + 16) * s)}" r="${Math.round(50 * s)}" fill="url(#ngwBulb)"/>`; }).join("")}<ellipse cx="${x}" cy="${Math.round(y - 230 * s)}" rx="${Math.round(320 * s)}" ry="${Math.round(160 * s)}" fill="url(#ngwBulb)" opacity=".4"/></g>`;

      // ---------- the full 16:9 story (owner 4 Nov: "ทำรวมเป็นเรื่องเดียว ขนาด 16:9"): helpers used by the re-cut EP.1 shots and the ending ----------
      const PUSHD = (d, a, b) => ({ keys: [{ t: 0, ...a }, { t: d, glide: d, ...b }] });
      const WB = (L, tx, ty, sc) => { const g = document.createElementNS("http://www.w3.org/2000/svg", "g"); g.setAttribute("transform", `translate(${tx},${ty}) scale(${sc})`); L.set.appendChild(g); return g; };
      // 1 · the title on the highway, ฝน's live on the giant tornado (the lure)
      ADD("open", { ...ROADV("op", { epic: EPF("e01", 560), road: { y: 1300, h: 170 }, poles: { xs: [-700, -260, 180, 620, 1060, 1500, 1940], y: 1290, s: 0.7, tf: [3], sag: 40 }, roadTitle: { y: 1385, text: "เสียงรถไฟ", sub: "", k: 0.42, fs: 190 } }), light: SUNL, grade: GSUN, captions: caps("open"), land: { y0: 450 },
        cam: push2("open", fr(540, 960, 1.0, 540, 960), fr(540, 980, 1.06, 540, 960)), shake: rumble(1.2),
        fx: (tl, id, t0, L) => { Ngw.epicLife(tl, "e01", t0, D("open"), { boltAt: 1.3 }); StormFX.flash(tl, t0 + 1.3, 0.24, 2); put(L.light, Ngw.liveUIL({ id: "lvo", y0: 450, title: "พายุมาแล้ววว", viewers: "9.8K" })); Ngw.liveLifeL(tl, "lvo", t0, D("open")); } });
      // 2 · cut: ฝน raising her phone, the tornado behind — "อย่ายกมือถือขึ้นถ่าย"
      ADD("hook", { ...ROADV("hk", { epic: EPF("e02", 700, { bolts: [], seed: 67, h: 680, wb: 280, wt: 700 }) }), light: SUNL, grade: GSUN, captions: caps("hook"), land: { y0: 600 },
        cam: push2("hook", fr(540, 960, 1.0, 540, 960), fr(500, 1000, 1.08, 540, 960)), shake: kick(0, 0.35, 10),
        actors: [P("fonPhone", 380, 2020, 1.55, "film", "wide", "smile")], fx: (tl, id, t0) => Ngw.epicLife(tl, "e02", t0, D("hook")) });
      // 3 · wide: the plain, the highway, no railway anywhere — the roar
      ADD("norail", { ...STALLDARK("nr", { so: { epic: { id: "e03", x: 900, y: 1172, h: 520, wb: 170, wt: 400, tx: 930, sun: 1, seed: 53, tiers: 7, tierW: 90, bolts: [], flashes: [], bigScale: 0.55, subs: [], sunDx: 500 } } }), captions: caps("norail"), land: { y0: 380 },
        cam: push2("norail", fr(540, 1000, 0.9, 540, 960), fr(540, 1000, 0.96, 540, 960)), shake: rumble(1),
        fx: (tl, id, t0, L) => { Ngw.epicLife(tl, "e03", t0, D("norail")); put(L.light, SFXW(470, 470, "ครืนนนนนน…", 0.9)); } });
      // 4 · the stall clock spins back an hour
      ADD("clock", { set: "ngwClock", setOpts: { id: "ck1", h: 15, wall: true }, dark: 0, light: false, captions: caps("clock"), land: { y0: 225 },
        cam: push2("clock", fr(540, 900, 1.0, 540, 900), fr(540, 900, 1.06, 540, 900)), fx: (tl, id, t0) => Ngw.clockSpin(tl, "ck1", t0 + 0.1, D("clock") - 0.3, 15, 14) });
      // 5 · bright afternoon: ยายบัว's grill stall by the highway
      ADD("stall", { ...STALLSET("st", { th: 340 }), captions: caps("stall"), land: { y0: 570 },
        cam: push2("stall", fr(540, 1000, 0.92, 540, 960), fr(540, 1000, 1.0, 540, 960)),
        fx: (tl, id, t0, L) => Ngw.ctaTag(tl, L.light, t0 + 0.2, D("stall") - 0.2),   // owner 4 Nov: the follow tag where most viewers still are (0:10)
        actors: [P("yaiBua", 880, 1860, 0.95, "idle", "normal", "smile", { flip: true }), P("fonPhone", 340, 1890, 1.0, "selfieUp", "normal", "smile"), P("puCam", 580, 1870, 0.78, "camEye", "normal", "laugh")] });
      // 6 · ฝน live, selling the chicken (her front camera: her face, the stall behind)
      ADD("live", { ...STALLSET("lv", { th: 360 }), captions: caps("live"), land: { y0: 700 },
        cam: push2("live", fr(500, 1450, 1.6, 540, 1150), fr(500, 1450, 1.7, 540, 1150)),
        actors: [P("yaiBua", 880, 1860, 0.95, "wave", "normal", "smile", { flip: true }), P("fon", 470, 1960, 1.2, "selfie", "normal", "smile", { talk: [TALK("live", 0, "laugh"), TALK("live", 1, "o")] })],
        fx: (tl, id, t0, L) => { put(L.light, Ngw.liveUIL({ id: "lvl", y0: 700, title: "ไก่ย่างยายบัว", viewers: "1.1K", comments: [["ป้าแดง", "น่ากินมากกก", "#e86a8a"], ["นนท์", "ส่งถึงกรุงเทพไหม", "#6a8ac8"], ["มายด์", "ยายบัวน่ารัก", "#8ac86a"]] })); Ngw.liveLifeL(tl, "lvl", t0, D("live")); } });
      // 7 · ปู boasting with his little camera; ยายบัว laughs at him
      { const c = SH.pu.vo[1].t - 0.12;   // QA pacing: close on ปู's boast, then the two-shot for ยายบัว's answer
        SPLITN("pu", [c], [
          { ...STALLSET("pu0", { th: 400 }), blur: { sky: 4, far: 4, mid: 3 }, land: { y0: 570 }, cam: PUSHD(c, fr(520, 1450, 2.0, 540, 1060), fr(520, 1450, 2.12, 540, 1060)),
            actors: [P("puCam", 520, 1880, 0.95, "camEye", "wide", "laugh", { talk: TALK("pu", 0, "laugh") }), P("yaiBua", 850, 1880, 1.0, "laugh", "normal", "smile", { flip: true })] },
          { ...STALLSET("pu", { th: 400 }), land: { y0: 640 }, cam: PUSHD(D("pu") - c, fr(640, 1500, 1.5, 540, 1000), fr(640, 1500, 1.58, 540, 1000)),
            actors: [P("puCam", 520, 1880, 0.95, "camEye", "normal", "laugh"), P("yaiBua", 850, 1880, 1.0, "laugh", "normal", "smile", { flip: true, talk: [[0.12, 0.12 + SH.pu.vo[1].dur, "laugh"]] })] }]); }
      // 7b · (the full story only) ปู films from the roadside ditch; ยายบัว: "เล่นในคูอีกแล้ว… จำไว้นะปู พายุมา หนีไม่ทันตึก หมอบลึกที่ต่ำ"
      //      — rule 3 planted for the ending's "ยายบอก…"; three cuts on the caption beats, and ปู ducks down into the ditch on "หมอบลึก"
      { const v = SH.ditch.vo[0], c1 = v.t + v.frags[1] - 0.04, c2 = v.t + v.frags[2] - 0.04;
        // the water in front of ปู's shins and the near bank are drawn in L.glow (parallax 1, like the actors): the ditch's own near bank lives in
        // L.fg, whose stronger parallax slid it up over the water and over ปู at these camera heights
        const DFRONT = () => { let gr = ""; for (let x = -1400; x < 2600; x += 11) gr += `M${x},${2196 + 8 * Math.sin(x * 0.01)}q${6 + (x % 7)},${-30 - (x % 13) * 5} ${12 + (x % 5) * 3},${-60 - (x % 11) * 8}`;
          return `<path d="M-1400,1990H2600V2260H-1400Z" fill="#2a3432" opacity=".93"/><path d="M-1400,1990H2600" stroke="#a8b8b6" stroke-width="5" opacity=".6"/><path d="M-1400,2008H2600" stroke="#8a9a98" stroke-width="9" opacity=".22"/>
            <ellipse cx="560" cy="1994" rx="86" ry="14" fill="none" stroke="#c8d8d6" stroke-width="4" opacity=".7"/><ellipse cx="560" cy="1996" rx="130" ry="22" fill="none" stroke="#c8d8d6" stroke-width="3" opacity=".35"/>
