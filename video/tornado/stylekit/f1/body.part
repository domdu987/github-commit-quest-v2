      ADD("where", { set: "ngwKuti", setOpts: { id: "ku2", robeC: "#3a7ac8", robeS: "#2a5a98" }, dark: 0.2, light: GOLDL, grade: { top: "#3a2a1a", bottom: "#0a0806", op: 0.22 }, captions: caps("where"), land: { y0: 700 },
        cam: push2("where", fr(720, 1390, 2.3, 540, 1000), fr(720, 1390, 2.45, 540, 1000)), shake: kick(0, 0.4, 8),
