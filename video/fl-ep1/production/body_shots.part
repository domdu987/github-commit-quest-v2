      // ---------- คนเดินดิน EP.1 · the vertical city, the boy with 0%, the iron stairs, the dimming ring ----------
      const KID_TEA = (() => { Rig.CAST.flKidTea = { v2: Rig.CAST.flKid2.v2, hand: FL.TEA, keep: "F" }; Flat.SPEC.flKidTea = Flat.SPEC.flKid2; Rig.CAST.flKidSpray = { v2: Rig.CAST.flKid3.v2, hand: FL.SPRAY, keep: "F" }; Flat.SPEC.flKidSpray = Flat.SPEC.flKid3; return 1; })();
      const gauge = (pct, c = "#d8352a") => `<g transform="translate(0,230)"><path d="M-220,0A220,220 0 0,1 220,0" stroke="#d8d4c8" stroke-width="44" fill="none"/><path d="M-220,0A220,220 0 0,1 220,0" stroke="url(#flGold)" stroke-width="44" fill="none" stroke-dasharray="${(pct / 100) * 691} 691"/>
        ${[0, 25, 50, 75, 100].map((p) => { const a = Math.PI * (1 - p / 100); return `<text x="${(Math.cos(a) * 270).toFixed(0)}" y="${(-Math.sin(a) * 270 + 10).toFixed(0)}" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="28" fill="#6a5a4a">${p}</text>`; }).join("")}
        <g class="flNeedle" transform="rotate(${-90 + pct * 1.8})"><path d="M0,10L0,-200" stroke="${c}" stroke-width="12" stroke-linecap="round"/></g><circle r="22" fill="#2e2a26"/><text y="110" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="120" fill="${c}">${pct}%</text></g>`;
      const GRAPH = (id, o = {}) => `<g transform="translate(0,40)"><rect x="-300" y="0" width="600" height="340" fill="#fbf7ee"/>${[0, 1, 2, 3].map((k) => `<path d="M-280,${60 + k * 80}H280" stroke="#e0d8c8" stroke-width="2"/>`).join("")}<path d="M-280,320V20M-280,320H280" stroke="#2e2a26" stroke-width="5" stroke-linecap="round"/>
        <text x="-250" y="-6" font-family="Kanit" font-weight="800" font-size="26" fill="#6a5a4a">แสงวงแหวน (%)</text><text x="250" y="350" text-anchor="end" font-family="Kanit" font-weight="800" font-size="24" fill="#6a5a4a">วัน →</text>
        <path id="${id}-gl" d="M-260,60H-60L-20,70L20,90L70,120L120,160L170,200L220,250L260,300" stroke="#d8352a" stroke-width="8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        ${o.marker ? `<g id="${id}-mk"><path d="M-60,30V320" stroke="#2a3a6a" stroke-width="4" stroke-dasharray="10 8"/><rect x="-70" y="-2" width="20" height="20" fill="#e8b830"/><text x="-40" y="16" font-family="Kanit" font-weight="900" font-size="26" fill="#2a3a6a">กัปตันสุริยา เปิดตัว</text></g>` : ""}
        ${o.rate ? `<g id="${id}-rt"><rect x="60" y="180" width="200" height="60" rx="12" fill="#d8352a"/><text x="160" y="222" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="40" fill="#fff"">−1% / วัน</text></g>` : ""}</g>`;
      const drawPath = (tl, sel, at, dur) => { const el = document.querySelector(sel); if (!el) return; const len = el.getTotalLength(); tl.fromTo(el, { strokeDasharray: len, strokeDashoffset: len }, { strokeDashoffset: 0, duration: dur, ease: "power1.inOut", immediateRender: false }, at); };

      // ---------- f01 hook: the vertical city ----------
      shot("f01", { ...city("f01", { flyers: 10, ringNear: { x: 540, y: -420, r: 240 } }), cam: JKC.move(fr(540, -120, 0.62, 540, 520), fr(760, 1000, 0.92, 540, 1000), 2.85, 2.5),
        actors: [ME("flYou", 760, 1400, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }]), FLY("flKid1", -300, 700, 1500, 400, 2.4, { s: 0.75 }), FLY("flKidTea", 1700, 300, -200, 650, 2.8, { s: 0.7, extra: { from: 0.4 } }), FLY("flDad", 200, -300, 1500, -500, 2.6, { s: 0.6, extra: { from: 0.9 } })],
        fx(tl, id, t0, L) { trailAt(tl, L, -300, 700, 1500, 400, t0, 2.4); trailAt(tl, L, 1700, 300, -200, 650, t0 + 0.4, 2.8); trailAt(tl, L, 200, -300, 1500, -500, t0 + 0.9, 2.6);
          const g = grp(L.light); g.innerHTML = `<g transform="translate(540,1560)"><rect x="-260" y="-56" width="520" height="112" rx="26" fill="#2e2a26" opacity=".85"/><text x="0" y="18" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="54" fill="#f4ecd8">คนคนนั้น… คือ<tspan fill="#f2c55c">คุณ</tspan></text></g>`;
          pop(tl, g, t0 + F("f01", 0, 1) + 0.6, { origin: "540 1560", from: 0.6 }); } });

      // ---------- f02 the ring, five-year-olds rising ----------
      shot("f02", { ...city("f02", { flyers: 6, ringNear: { x: 540, y: 330, r: 190 } }), camAt: fr(540, 760, 0.95, 540, 760), push: 0.012,
        actors: [FLY("flKid1", 300, 1400, 360, -300, 1.8, { s: 0.7, ang: 0, flip: false, extra: { from: 1.0 } }), FLY("flKid2", 620, 1400, 700, -300, 1.8, { s: 0.7, ang: 0, flip: false, extra: { from: 1.5 } }), FLY("flTot", 860, 1400, 900, -300, 1.6, { s: 0.55, ang: 0, flip: false, extra: { from: 2.1 } }),
          A("flMum", 460, 1400, 0.9, [{ t: 0, mode: "idle", eyes: "happy", mouth: "smile" }, { t: 1.0, mode: "cheer", eyes: "happy", mouth: "laugh" }])],
        fx(tl, id, t0, L) { hud(id, [["พลัง", "ตอน 5 ขวบ", "#f2c55c"], ["ต้นทาง", "วงแหวน"]]); shadows(L, id, act("f02").slice(3)); [[300, 1.0], [620, 1.5], [860, 2.1]].forEach(([x, a]) => trailAt(tl, L, x, 1400, x + 50, -300, t0 + a, 1.8, "#ffe8a0"));
          FLI.badge(tl, L.light, t0, D("f02"), { kind: "ring", x: 840, y: 560, tone: "yellow", label: "วงแหวนให้พลัง", at: F("f02", 0, 1) + 0.1 });
          loop(tl, `#${SID.city("f02")}-set .flRing`, { scale: 1, svgOrigin: "540 330" }, { scale: 1.04, svgOrigin: "540 330" }, 1.2, t0, D("f02")); } });

      // ---------- f03 the nest: the toddler drops a metre, then shoots up ----------
      shot("f03", { ...city("f03", { nest: true, flyers: 5 }), camAt: fr(180, 980, 1.25, 540, 860), push: 0.01, shake: JKC.impact(F("f03", 0, 2), 0.3, 6),
        actors: [A("flDad", -40, 980, 0.92, [{ t: 0, mode: "idle", eyes: "happy", mouth: "smile" }, { t: F("f03", 0, 1), mode: "startle", eyes: "wide", mouth: "o" }, { t: F("f03", 0, 2) + 0.2, mode: "cheer", eyes: "happy", mouth: "laugh" }]),
          A("flMum", 160, 980, 0.9, [{ t: 0, mode: "point", eyes: "happy", mouth: "smile" }, { t: F("f03", 0, 1), mode: "startle", eyes: "wide", mouth: "o" }, { t: F("f03", 0, 2) + 0.2, mode: "cheer", eyes: "happy", mouth: "laugh" }]),
          A("flTot", 440, 980, 0.55, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: F("f03", 0, 1), mode: "fall", eyes: "wide", mouth: "scream" }, { t: F("f03", 0, 2), mode: "fly", eyes: "happy", mouth: "laugh", ang: 0 }],
            { path: [{ t: 0, x: 440, y: 980 }, { t: F("f03", 0, 1), x: 440, y: 980 }, { t: F("f03", 0, 1) + 0.4, x: 470, y: 1090 }, { t: F("f03", 0, 2), x: 470, y: 1090 }, { t: F("f03", 0, 2) + 0.5, x: 520, y: -500 }] })],
        fx(tl, id, t0, L) { hud(id, [["พลัง", "ตอน 5 ขวบ", "#f2c55c"], ["วิธี", "ปล่อยมือ"]]); trailAt(tl, L, 470, 1090, 520, -500, t0 + F("f03", 0, 2), 0.5, "#ffe8a0");
          const fl = grp(L.glow); fl.innerHTML = `<g style="mix-blend-mode:screen"><circle cx="470" cy="1060" r="260" fill="url(#flRingG)"/></g>`; tl.set(fl, { opacity: 0 }, 0); tl.fromTo(fl, { opacity: 1, scale: 0.3, svgOrigin: "470 1060" }, { opacity: 0, scale: 1.6, svgOrigin: "470 1060", duration: 0.6, immediateRender: false }, t0 + F("f03", 0, 2));
          const g = grp(L.act); g.innerHTML = `<g transform="translate(560,1000)"><path d="M0,0V100" stroke="#f2c55c" stroke-width="4" stroke-dasharray="8 6"/><text x="12" y="60" font-family="Kanit" font-weight="800" font-size="30" fill="#f2c55c">1 ม.</text></g>`; tl.set(g, { opacity: 0 }, 0); tl.set(g, { opacity: 1 }, t0 + F("f03", 0, 1) + 0.3); tl.set(g, { opacity: 0 }, t0 + F("f03", 0, 2)); } });

      // ---------- f04 your first flight day ----------
      shot("f04", { ...city("f04", { nest: true, mattress: { x: 300 }, flyers: 4 }), cam: { keys: [{ t: 0, ...fr(300, 1000, 1.15, 540, 820), drift: { s: 0.01 } }, { t: F("f04", 0, 1) + 0.55, ...fr(320, 1150, 1.3, 540, 960), glide: 0.5 }] },
        shake: JKC.impact(F("f04", 0, 1) + 0.6, 0.45, 14), sfxText: [{ text: "ตุ้บ!", x: 600, y: 760, size: 140, rot: -6, color: "#f6d36a", t: F("f04", 0, 1) + 0.62, end: F("f04", 0, 1) + 1.7 }],
        actors: [ME("flYou", 440, 980, [{ t: 0, mode: "idle", eyes: "worry", mouth: "flat" }, { t: F("f04", 0, 0) + 1.0, mode: "raise", eyes: "squint", mouth: "grit" }, { t: F("f04", 0, 1), mode: "fall", eyes: "wide", mouth: "scream" }, { t: F("f04", 0, 1) + 0.62, mode: "sit", eyes: "closed", mouth: "pout" }],
            { path: [{ t: 0, x: 440, y: 980 }, { t: F("f04", 0, 1), x: 440, y: 980 }, { t: F("f04", 0, 1) + 0.15, x: 400, y: 940 }, { t: F("f04", 0, 1) + 0.62, x: 330, y: 1224 }] }),
          A("flGran", 90, 1400, 0.95, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: F("f04", 0, 1) + 0.7, mode: "nod", eyes: "closed", mouth: "smile" }], { flip: false })],
        fx(tl, id, t0, L) { hud(id, H_ZERO()); shadows(L, id, act("f04").slice(1)); Rig.squash(tl, `${id}-a0`, t0 + F("f04", 0, 1) + 0.63, 0.22);
          const d = grp(L.act); d.innerHTML = [0, 1, 2, 3].map((k) => `<circle cx="${260 + k * 50}" cy="1230" r="${20 + k * 4}" fill="#e8d8c8" opacity=".7"/>`).join(""); tl.set(d, { opacity: 0 }, 0); tl.fromTo(d, { opacity: 0.9, scale: 0.4, svgOrigin: "330 1230" }, { opacity: 0, scale: 1.7, svgOrigin: "330 1230", duration: 0.7, immediateRender: false }, t0 + F("f04", 0, 1) + 0.62);
          FLI.badge(tl, L.light, t0, D("f04"), { kind: "zero", x: 840, y: 440, tone: "red", label: "บินไม่ได้", at: F("f04", 0, 1) + 0.9 }); } });

      // ---------- f05 the meter ----------
      shot("f05", { ...city("f05", { nest: true, mattress: { x: 300 }, flyers: 3 }), camAt: fr(330, 1120, 2.0, 300, 1100), push: 0.02, blur: { far: 6, mid: 5 },
        actors: [ME("flYou", 330, 1224, [{ t: 0, mode: "sit", eyes: "sad", mouth: "pout" }, { t: F("f05", 0, 1), mode: "sit", eyes: "wide", mouth: "o" }]), A("flGran", 90, 1400, 0.95, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }])],
        fx(tl, id, t0, L) { hud(id, H_ZERO()); const g = card(L, 640, 620, 640, 620, "เครื่องวัดพลัง", gauge(0), { band: "#2e2a26" }); pop(tl, g, t0 + 0.1, { origin: "640 620", from: 0.7 });
          tl.fromTo(g.querySelector(".flNeedle"), { rotation: 40, svgOrigin: "0 0" }, { rotation: -90, svgOrigin: "0 0", duration: 0.6, ease: "elastic.out(1,0.4)", immediateRender: false }, t0 + F("f05", 0, 1) - 0.1); } });

      // ---------- f06 no stairs anywhere · ยายแย้ม welds the iron stairs ----------
      shot("f06", { ...city("f06", { stairs: true, step1: true, school: true, flyers: 6 }), cam: { keys: [{ t: 0, ...fr(1040, 1240, 1.0, 540, 1000), drift: { s: 0.008 } }, { t: F("f06", 0, 1) + 2.4, ...fr(1150, -700, 0.36, 540, 760), glide: 2.2 }] },
        actors: [A("flGranWeld", 900, 1400, 0.95, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: F("f06", 0, 1) - 0.1, mode: "weld", eyes: "squint", mouth: "grit" }]), ME("flYou", 700, 1400, [{ t: 0, mode: "idle", eyes: "side", mouth: "flat" }, { t: F("f06", 0, 1), mode: "think", eyes: "wide", mouth: "o" }])],
        fx(tl, id, t0, L) { hud(id, H_ZERO()); shadows(L, id, act("f06"));
          const sid = SID.city("f06"); tl.set(`#${sid}-stairs`, { scaleY: 0.02, svgOrigin: "1065 1400" }, 0); tl.to(`#${sid}-stairs`, { scaleY: 1, duration: 2.8, ease: "power1.in" }, t0 + F("f06", 0, 1));
          arc(tl, L, 1022, 1312, t0 + F("f06", 0, 1) - 0.05, 2.2, { s: 0.9 });
          FLI.badge(tl, L.light, t0, D("f06"), { kind: "stairs", x: 300, y: 520, tone: "yellow", label: "บันไดอันเดียวในโลก", at: F("f06", 0, 2) }); } });

      // ---------- f07 the first step: the graffiti ----------
      shot("f07", { ...city("f07", { stairs: true, step1: true, flyers: 2 }), camAt: fr(1065, 1330, 2.0, 620, 980), push: 0.02, blur: { far: 8, mid: 6 },
        actors: [A("flKidSpray", 850, 1400, 0.9, [{ t: 0, mode: "spray", eyes: "squint", mouth: "smirk" }, { t: F("f07", 0, 1) + 1.2, mode: "run", eyes: "happy", mouth: "laugh" }], { flip: false, moveTo: { x: -400, dur: 1.2, at: F("f07", 0, 1) + 1.2 } })],
        fx(tl, id, t0, L) { hud(id, H_ZERO()); const sid = SID.city("f07"); tl.to(`#${sid}-graf`, { opacity: 1, duration: 0.5 }, t0 + F("f07", 0, 1) - 0.2);
          const sp = grp(L.act); sp.innerHTML = `<g transform="translate(1040,1360)">${LT.sparks(14, 70, 21, "#ff5a2a")}</g>`; tl.set(sp, { opacity: 0 }, 0); loop(tl, sp, { opacity: 1, scale: 0.6, svgOrigin: "1040 1360" }, { opacity: 0.2, scale: 1.1, svgOrigin: "1040 1360" }, 0.12, t0 + 0.2, F("f07", 0, 1) + 0.6); tl.set(sp, { opacity: 0 }, t0 + F("f07", 0, 1) + 0.9); } });

      // ---------- f08 812 steps every morning · ฟ้า upside down ----------
      shot("f08", { ...city("f08", { stairs: true, step1: true, flyers: 8 }), camAt: fr(1120, 1040, 1.25, 540, 900), push: 0.01,
        actors: [ME("flYou", 1000, 1390, [{ t: 0, mode: "walk", eyes: "normal", mouth: "flat", period: 1.1, stride: 10 }, { t: F("f08", 0, 2), mode: "idle", eyes: "side", mouth: "flat" }, { t: F("f08", 0, 2) + 1.2, mode: "walk", eyes: "normal", mouth: "pout", period: 1.1, stride: 10 }],
            { path: [{ t: 0, x: 1000, y: 1390 }, { t: F("f08", 0, 2), x: 1080, y: 1300 }, { t: F("f08", 0, 2) + 1.2, x: 1080, y: 1300 }, { t: D("f08"), x: 1130, y: 1240 }] }),
          A("flFa", 1290, 270, 0.9, [{ t: 0, mode: "hang", eyes: "happy", mouth: "smile" }, { t: F("f08", 0, 2) + 1.0, mode: "hang", eyes: "normal", mouth: "flat" }], { from: F("f08", 0, 1) - 0.3, flip: true }),
          FLY("flKidTea", -300, 500, 2000, 300, 2.6, { s: 0.7, extra: { from: 0.2 } }), FLY("flKid1", 2100, 200, -300, 700, 3.0, { s: 0.65, extra: { from: 1.4 } })],
        fx(tl, id, t0, L) { hud(id, H_STEPS(812)); trailAt(tl, L, -300, 500, 2000, 300, t0 + 0.2, 2.6); trailAt(tl, L, 2100, 200, -300, 700, t0 + 1.4, 3.0);
          const fa = `#${id}-a1`; tl.fromTo(fa, { y: -30 }, { y: 30, duration: 1.3, repeat: Math.ceil(D("f08") / 1.3), yoyo: true, ease: "sine.inOut" }, t0);
          const wh = grp(L.glow); wh.innerHTML = `<g style="mix-blend-mode:screen"><circle cx="1290" cy="280" r="120" fill="url(#flRingG)" opacity=".5"/></g>`; tl.set(wh, { opacity: 0 }, 0); tl.set(wh, { opacity: 1 }, t0 + F("f08", 0, 1) - 0.3);
          FLI.counter(tl, L.light, t0, D("f08"), { icon: "stairs", x: 44, y: 250, from: 812, unit: "ขั้น", at: F("f08", 0, 0) + 0.2, tone: "yellow", steps: [[F("f08", 0, 0) + 1.2, 811], [F("f08", 0, 0) + 2.0, 810], [F("f08", 0, 3), 812]] }); } });

      // ---------- f09 the room at night: the homemade telescope ----------
      shot("f09", { ...room("f09"), cam: { keys: [{ t: 0, ...fr(560, 980, 1.15, 540, 900), drift: { s: 0.01 } }, { t: F("f09", 0, 1) + 0.3, ...fr(700, 900, 1.3, 540, 880), glide: 0.6 }] },
        actors: [ME("flYou", 640, 1400, [{ t: 0, mode: "scope", eyes: "closed", mouth: "flat" }, { t: F("f09", 0, 1), mode: "idle", eyes: "wide", mouth: "o" }], { flip: true })],
        fx(tl, id, t0, L) { hud(id, H_ZERO()); const g = card(L, 540, 620, 680, 520, "สมุดวัดแสง", GRAPH(id, { rate: true }), { band: "#2a3a6a" }); tl.set(g, { opacity: 0 }, 0); pop(tl, g, t0 + F("f09", 0, 1) + 0.1, { origin: "540 620", from: 0.7 });
          drawPath(tl, `#${id}-gl`, t0 + F("f09", 0, 1) + 0.4, 1.6); tl.set(`#${id}-rt`, { opacity: 0 }, 0); tl.fromTo(`#${id}-rt`, { opacity: 0, scale: 1.8, svgOrigin: "160 210" }, { opacity: 1, scale: 1, svgOrigin: "160 210", duration: 0.25, ease: "power3.in", immediateRender: false }, t0 + F("f09", 0, 2) + 0.1); } });

      // ---------- f10 the graph: the drop began the day the captain appeared ----------
      shot("f10", { ...room("f10"), camAt: fr(560, 900, 1.1, 540, 900), push: 0.01, blur: { set: 6 }, dark: 0.45,
        fx(tl, id, t0, L) { hud(id, H_ZERO()); const g = card(L, 540, 700, 700, 560, "สมุดวัดแสง", GRAPH(id, { marker: true }), { band: "#2a3a6a" }); pop(tl, g, t0 + 0.05, { origin: "540 700", from: 0.85 });
          tl.set(`#${id}-mk`, { opacity: 0 }, 0); tl.fromTo(`#${id}-mk`, { opacity: 0, x: -40 }, { opacity: 1, x: 0, duration: 0.3, immediateRender: false }, t0 + F("f10", 0, 1));
          FLI.badge(tl, L.light, t0, D("f10"), { kind: "captain", x: 840, y: 1180, tone: "yellow", label: "กัปตันสุริยา", at: F("f10", 0, 1) + 0.2 }); } });

      // ---------- f11 seven days · the festival poster ----------
      shot("f11", { ...city("f11", { flyers: 12 }), camAt: fr(540, 760, 0.9, 540, 760), push: 0.01,
        actors: [FLY("flKid1", 200, 1400, 260, -300, 2.2, { s: 0.7, ang: 0, flip: false, extra: { from: F("f11", 0, 2) } }), FLY("flDad", 520, 1400, 560, -300, 2.2, { s: 0.8, ang: 0, flip: false, extra: { from: F("f11", 0, 2) + 0.2 } }), FLY("flMum", 820, 1400, 860, -300, 2.2, { s: 0.75, ang: 0, flip: false, extra: { from: F("f11", 0, 2) + 0.4 } })],
        fx(tl, id, t0, L) { hud(id, H_DAYS(7)); ringDim(tl, id, t0 + F("f11", 0, 1), 0.35, 0.8); tl.to(`#${id}-dark`, { opacity: 0.35, duration: 0.8 }, t0 + F("f11", 0, 1));
          chip(tl, L, [[t0 + F("f11", 0, 0) + 0.2, "7"]], { id: `${id}-ch`, x: 900, y: 420, label: "อีกกี่วัน" });
          const g = card(L, 540, 1000, 700, 460, "เทศกาลเหนือเมฆ", `<g transform="translate(0,60)"><text y="60" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="110" fill="#2a3a6a">3,000 ม.</text><text y="130" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="40" fill="#6a5a4a">ทั้งเมืองบินขึ้นพร้อมกัน</text><text y="200" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="34" fill="#d8352a">ทำลายสถิติโลก · อีก 7 วัน</text></g>`, { band: "#e8b830", titleC: "#2a2a34" });
          tl.set(g, { opacity: 0 }, 0); pop(tl, g, t0 + F("f11", 0, 2) - 0.2, { origin: "540 1000", from: 0.7 }); [[200, 0], [520, 0.2], [820, 0.4]].forEach(([x, d]) => trailAt(tl, L, x, 1400, x + 40, -300, t0 + F("f11", 0, 2) + d, 2.2, "#ffe8a0")); } });

      // ---------- f12 the classroom: the laser-eyed teacher burns the graph ----------
      shot("f12", { ...klass("f12"), camAt: fr(660, 940, 1.0, 540, 880), push: 0.01,
        actors: [A("flTeacher", 1000, 1400, 0.98, [{ t: 0, mode: "idle", eyes: "angry", mouth: "frown" }, { t: F("f12", 0, 1), mode: "point", eyes: "angry", mouth: "frown" }, { t: F("f12", 0, 2), mode: "idle", eyes: "angry", mouth: "o" }], { flip: true, talk: [[F("f12", 0, 2), D("f12") - 0.2, "o"]] }),
          ME("flYouBook", 560, 1400, [{ t: 0, mode: "raise", eyes: "normal", mouth: "flat" }, { t: F("f12", 0, 1) + 0.3, mode: "cower", eyes: "worry", mouth: "frown" }]),
          A("flKid1", 300, 1400, 0.95, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: F("f12", 0, 2), mode: "laugh", eyes: "happy", mouth: "laugh" }]), A("flKid2", 780, 1400, 0.95, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: F("f12", 0, 2) + 0.1, mode: "laugh", eyes: "happy", mouth: "laugh" }])],
        sfxText: [{ text: "ฮ่าๆๆ", x: 140, y: 560, size: 100, rot: -8, color: "#f6d36a", t: F("f12", 0, 2) + 0.2, end: D("f12") - 0.1 }],
        fx(tl, id, t0, L) { hud(id, H_DAYS(7)); const sid = SID.klass("f12"); const bg = document.getElementById(`${sid}-boardG`);
          bg.innerHTML = `<g transform="translate(380,250)"><path d="M-300,200V-180M-300,200H300" stroke="#f4f0e8" stroke-width="5" stroke-linecap="round"/><path id="${id}-ch" d="M-280,-100H-80L-40,-90L0,-70L50,-40L100,0L150,50L200,110L260,180" stroke="#f4f0e8" stroke-width="7" fill="none" stroke-linecap="round"/><text x="-280" y="-150" font-family="Kanit" font-weight="800" font-size="30" fill="#f4f0e8">แสงวงแหวน</text>
            <g id="${id}-x" opacity="0"><path d="M-260,-160L260,170M260,-160L-260,170" stroke="#ff5a2a" stroke-width="18" stroke-linecap="round"/><path d="M-260,-160L260,170M260,-160L-260,170" stroke="#ffd0a0" stroke-width="6" stroke-linecap="round"/></g>
            <g id="${id}-sm" opacity="0">${[-120, 0, 120].map((x) => `<path d="M${x},-120q-30,-60 0,-120q30,-60 0,-120" stroke="#8a8a90" stroke-width="12" fill="none" stroke-linecap="round" opacity=".7"/>`).join("")}</g></g>`;
          tl.to(`#${id}-a0 .flLaser`, { opacity: 1, duration: 0.1 }, t0 + F("f12", 0, 1)); tl.to(`#${id}-a0 .flLaser`, { opacity: 0, duration: 0.2 }, t0 + F("f12", 0, 1) + 1.1);
          tl.fromTo(`#${id}-x`, { opacity: 0, scale: 0.3, svgOrigin: "0 0" }, { opacity: 1, scale: 1, svgOrigin: "0 0", duration: 0.5, ease: "power3.out", immediateRender: false }, t0 + F("f12", 0, 1) + 0.15);
          tl.fromTo(`#${id}-sm`, { opacity: 0, y: 40 }, { opacity: 1, y: -60, duration: 1.4, ease: "power1.out", immediateRender: false }, t0 + F("f12", 0, 1) + 0.6);
          const fl = WHITE(L); tl.fromTo(fl, { opacity: 0.5 }, { opacity: 0, duration: 0.3, immediateRender: false }, t0 + F("f12", 0, 1) + 0.1); } });

      // ---------- f13 the night square: the captain live · only the dog barks ----------
      shot("f13", { ...city("f13", { time: "night", screen: true, crowd: true, flyers: 3 }), cam: { keys: [{ t: 0, ...fr(230, 600, 0.95, 540, 640), drift: { s: 0.01 } }, { t: F("f13", 0, 2) + 0.2, ...fr(620, 1120, 0.95, 540, 1000), glide: 0.7 }] },
        actors: [ME("flYou", 760, 1400, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: F("f13", 0, 3), mode: "idle", eyes: "side", mouth: "flat" }], { flip: false }), A("flFa", 580, 1400, 0.9, [{ t: 0, mode: "cheer", eyes: "happy", mouth: "laugh" }], { from: F("f13", 0, 2) })],
        extra(L, id) { const sc = document.getElementById(`${SID.city("f13")}-screen`); const w = document.createElementNS("http://www.w3.org/2000/svg", "g"); w.setAttribute("transform", "translate(240,850) scale(1.08)"); sc.appendChild(w); Rig.build(w, `${id}-cap`, Rig.CAST.flCaptain);
          const dg = grp(L.act); dg.innerHTML = `<g transform="translate(900,1400) scale(1.1)">${FL.DOG(`${id}-dog`)}</g>`; },
        fx(tl, id, t0, L) { hud(id, H_DAYS(7)); shadows(L, id, act("f13").slice(0, 1)); Rig.drive(tl, `${id}-cap`, t0, D("f13"), [{ t: 0, mode: "point", eyes: "normal", mouth: "smile", talk: [[F("f13", 0, 1), F("f13", 0, 2), "o"]] }], [1.1, 3.0, 5.2]);
          tl.fromTo(`#${id}-cap`, { y: -8 }, { y: 8, duration: 1.4, repeat: Math.ceil(D("f13") / 1.4), yoyo: true, ease: "sine.inOut" }, t0);
          const barks = [0.3, 0.75, 1.2, 1.9].map((d) => t0 + F("f13", 0, 3) + d); dogLife(tl, `#${id}-dog`, t0, D("f13"), barks);
          const cheer = grp(L.light); cheer.innerHTML = `<g transform="translate(560,1180)">${[[-300, -40], [-120, 20], [80, -30], [260, 10]].map(([x, y]) => `<text x="${x}" y="${y}" font-family="Kanit" font-weight="900" font-size="54" fill="#f6d36a" transform="rotate(${(x / 40).toFixed(0)} ${x} ${y})">เย้!</text>`).join("")}</g>`;
          tl.set(cheer, { opacity: 0 }, 0); tl.fromTo(cheer, { opacity: 0, y: 30 }, { opacity: 1, y: -30, duration: 0.5, immediateRender: false }, t0 + F("f13", 0, 2)); tl.to(cheer, { opacity: 0, duration: 0.3 }, t0 + F("f13", 0, 3) - 0.1);
          FLI.badge(tl, L.light, t0, D("f13"), { kind: "dog", x: 300, y: 560, tone: "yellow", label: "โฮ่ง!", at: F("f13", 0, 3) + 0.3 }); } });

