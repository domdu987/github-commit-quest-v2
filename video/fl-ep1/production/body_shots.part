          const gl = grp(L.glow); gl.innerHTML = `<g style="mix-blend-mode:screen"><ellipse cx="540" cy="1292" rx="90" ry="14" fill="url(#flRingG)" opacity=".9"/></g>`;
          const g = grp(L.act); g.innerHTML = `<g transform="translate(540,1292)"><path d="M-120,-4H-60M60,-4H120" stroke="#f2c55c" stroke-width="5"/><path d="M-60,-16V8M60,-16V8" stroke="#f2c55c" stroke-width="5"/><text x="150" y="4" font-family="Kanit" font-weight="900" font-size="34" fill="#f2c55c">1 ซม.</text></g>`; tl.set(g, { opacity: 0 }, 0); tl.fromTo(g, { opacity: 0 }, { opacity: 1, duration: 0.2, immediateRender: false }, t0 + F("f14", 0, 2));
