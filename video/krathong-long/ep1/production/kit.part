        face: `<path d="M-30,-520q34,16 66,0" stroke="#3a2a1a" stroke-width="4" fill="none" opacity=".45"/>` } };

      // น้าหมาน 55: thin, white stubble, a faded mustard tee, กางเกงเล, a flat woven hat; sits on the land-side steps with three gallons
      const nmHat = `<g transform="translate(0,-598)"><ellipse cx="0" cy="4" rx="96" ry="16" fill="#d8b878" ${kln(2.4)}/><path d="M-48,4Q-46,-34 0,-36Q46,-34 48,4Z" fill="#e2c488" ${kln(2.4)}/><path d="M-44,-6Q0,2 44,-6" stroke="#8a5a2a" stroke-width="6" fill="none"/>${Array.from({ length: 10 }, (_, i) => `<path d="M${-84 + i * 18},2l8,8" stroke="#b8945a" stroke-width="1.6"/>`).join("")}</g>`;
      const nmStubble = `<g fill="#f2f0e8" opacity=".9">${Array.from({ length: 30 }, (_, i) => { const a = Math.PI * (0.15 + 0.7 * (i / 29)); return `<circle cx="${k1(4 + Math.cos(a) * 40)}" cy="${k1(-528 + Math.sin(a) * 30)}" r="1.8"/>`; }).join("")}</g><path d="M-10,-514q14,6 28,0" stroke="#f2f0e8" stroke-width="4" fill="none"/>`;
      KC.naMan = { v2: { skin: "#9a6a44", iris: "#2a1a12", blush: 0.1, bags: true, w: 0.9, limb: 0.94, brow: "#e8e4dc",
