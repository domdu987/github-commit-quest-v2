      // ---------------- passengers (rig v2, nobody named) ----------------
      const pxShort = (h) => `<path d="M-46,-556C-50,-604 -20,-622 3,-622C28,-622 52,-604 48,-556Q44,-580 30,-590Q4,-598 -22,-590Q-40,-580 -46,-556Z" fill="${h.c}" ${kln()}/><path d="M-30,-608Q4,-622 34,-606" stroke="${h.sh}" stroke-width="5" fill="none" opacity=".45" stroke-linecap="round"/>`;
