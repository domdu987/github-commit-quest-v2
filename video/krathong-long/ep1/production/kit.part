      const PX = (o) => ({ v2: { iris: "#2e1c12", blush: 0.5, ...o, hair: { c: o.hc || "#1e1612", s: "#080606", sh: "#6a5a50", front: (x) => (o.bob || o.pony ? pxBob : pxShort)(x.hair), back: o.bob ? (x) => pxBobB(x.hair) : o.pony ? (x) => pxPony(x.hair) : undefined } } });
      KC.pxA = PX({ skin: "#e8b892", lash: true, bob: true, top: { kind: "tee", c: "#f27ab0", sleeve: "short" }, bottom: { kind: "jeans", c: "#3a5a8a" }, feet: { kind: "sneaker", c: "#f2f2ee" } });
      KC.pxA.hand = KC.maprangPhone.hand; KC.pxA.keep = "F";
      KC.pxB = PX({ skin: "#b07a52", w: 1.1, top: { kind: "shirt", c: "#c8302a", sleeve: "short", neck: "collar", collar: "#a8241e" }, bottom: { kind: "shorts", c: "#3a3e4a" }, feet: { kind: "sandal", c: "#2a2a2a" } });
      KC.pxC = PX({ skin: "#d49c6c", w: 0.95, top: { kind: "tank", c: "#f2c83a", sleeve: "none" }, bottom: { kind: "shorts", c: "#2e7ab0" }, feet: { kind: "sandal", c: "#f2f2ee" } });
      KC.pxD = PX({ skin: "#c8946a", bags: true, hc: "#b8b2a8", pony: true, top: { kind: "blouse", c: "#4a9a6a", sleeve: "elbow" }, bottom: { kind: "sarong", c: "#8a3a2a", band: "#f2c84a", band2: "#3a1a10" }, feet: { kind: "sandal", c: "#5a3a22" } });
      KC.pxE = PX({ skin: "#e2b088", w: 1.05, top: { kind: "shirt", c: "#f2f0e8", sleeve: "long", neck: "collar", collar: "#e2e0d8", button: "#c8c4b8" }, bottom: { kind: "jeans", c: "#2a2e3a" }, feet: { kind: "sneaker", c: "#3a3a3a" } });
      KC.pxF = PX({ skin: "#e8b892", lash: true, pony: true, top: { kind: "tee", c: "#7ac0f2", sleeve: "short" }, bottom: { kind: "shorts", c: "#f2e2c0" }, feet: { kind: "sandal", c: "#e86a9a" } });
      // มะปราง soaked: wet strands stuck across her forehead and cheek, drops running down
      const mpWet = `<path d="M-30,-600Q-36,-566 -26,-540M-12,-604Q-16,-570 -6,-548M14,-600Q8,-576 18,-552M-44,-580Q-50,-540 -40,-512" stroke="#1e1414" stroke-width="7" fill="none" stroke-linecap="round"/>
        <g fill="#dfeeff" stroke="${Rig2.LINE}" stroke-width="1">${[[-34, -522], [28, -560], [40, -520], [-8, -506], [12, -590]].map(([x, y]) => `<path d="M${x},${y}q4,7 0,11q-4,-4 0,-11z"/>`).join("")}</g>`;
      KC.maprangWet = { v2: { ...KC.maprang.v2, faceTop: mpWet, top: { kind: "blouse", c: "#d8ccb4", sleeve: "long", trim: "#b8a88a" } } };

      // ---------------- the frames ----------------
      // seated, one arm reaching out (มะปราง reaching for ข้าวปั้น's hand from the bench)
      Rig.MODES.reachSit = (u, o) => ({ ...Rig.MODES.sitChair(u, o), uaF: -70 + 3 * Math.sin(u * 2.3), faF: -18, torso: 6, head: -8 });
      // passengers on a tilted boat: feet inside the hull at (bx + dx, by + 20 + dx·sin(tilt)), the hull drawn again over them (act layer)
      const onBoat = (bx, by, tilt, list) => list.map(([who, dx, s, mode, eyes, mouth, flip, extra]) => A(who, bx + dx, by + 22 + dx * Math.sin(tilt / 57.3), s, [{ t: 0, mode, eyes, mouth, ...(extra || {}) }], flip ? { flip: true } : {}));
      const hullOver = (svg) => svg.replace(/<path d="M-430[^>]*\/>/, "");

