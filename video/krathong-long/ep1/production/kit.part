      // ลุงหมึก 46: big, a faded cap, a plaid shirt with the sleeves rolled, ผ้าขาวม้า round the waist, a brass whistle on a cord
      const lmCap = `<g transform="translate(0,-600)"><path d="M-52,6C-54,-40 -20,-56 4,-56C30,-56 54,-40 52,6Z" fill="#7a8a6a" ${kln()}/><path d="M30,0Q70,-2 92,10Q66,18 30,12Z" fill="#6a7a5a" ${kln(2.2)}/><path d="M-40,-20Q0,-36 40,-22" stroke="#a8b894" stroke-width="5" fill="none" opacity=".6"/><circle cx="4" cy="-54" r="5" fill="#6a7a5a"/></g>`;
