      });
      // ---------- then · 3 cuts: น้าหมาน, quiet: "fifty years ago… I was five, on that boat" (CU) → the past: the capsized boat, a mother and her boy in the water (WS)
      // → her hands pushing him up onto the empty oil drum: "hold on, son" (CU) ----------
      const TH1 = vo("then", 1) - 0.4, TH2 = vo("then", 1) + 3.0;
      add("then", {
        extra(L) { waterLevel(L, { hz: 560, moon: [1300, 170], tx: 1200, n: 40, seed: 62, hull: [900, 1240, 0.8] }); },
        ...NIGHT, light: MOONL, blur: { sky: 1, far: 1, fg: 5 },
        cam: { keys: [{ t: 0, ...frL(-560, 905, 4.4) }, { t: TH1 - 0.05, glide: TH1, ...frL(-560, 910, 4.7) },
          { t: TH1, ...frL(560, 1220, 1.3) }, { t: TH2, ...frL(470, 1330, 3.0) }, { t: D("then"), glide: D("then") - TH2, ...frL(470, 1330, 3.2) }] },
        land: { y0: LY0 },
        actors: [
          A("naMan", -560, 1080, 0.38, [{ t: 0, mode: "sit", eyes: "side", mouth: "flat" }], { talk: [TK("then", 0, "flat"), TK("then", 1, "flat")] }),
          A("momOld", 420, 1560, 0.42, [{ t: 0, mode: "raise", eyes: "worry", mouth: "o" }], { from: TH1 }),
          A("manBoy", 560, 1430, 0.3, [{ t: 0, mode: "cling", eyes: "wide", mouth: "o" }], { from: TH1 }),
        ],
        captions: capsQ("then"),
        fx(tl, id, t0, L) {
          // the present (his CU) sits on the landing; the past (the river) only after the cut, in sepia
          put(L.act, `<g id="${id}-past" opacity="0">${oilDrum(560, 1470, 0.5, -6)}</g>`);
          tl.set(`#${id}-past`, { opacity: 1 }, t0 + TH1);
          put(L.set, `<g id="${id}-st"><rect x="-1500" y="1080" width="1500" height="900" fill="#5a3a1e"/><rect x="-1500" y="1060" width="1500" height="30" fill="#9a6a3e" ${KOUT2}/></g>`);
          tl.set([`#${id}-st`, `#${id}-a0`], { opacity: 0 }, t0 + TH1);
          put(L.act, `<g id="${id}-wl" opacity="0"><path d="M-1500,1500${Array.from({ length: 75 }, () => `q20,-10 40,0`).join("")}V2400H-1500Z" fill="url(#kWater)" opacity=".92"/></g>`);
          tl.set(`#${id}-wl`, { opacity: 1 }, t0 + TH1);
          put(L.light, `<g id="${id}-pw" opacity="0"><rect x="-1500" y="-900" width="4100" height="3900" fill="#8a5a2a" opacity=".3" style="mix-blend-mode:color"/><rect x="-1500" y="-900" width="4100" height="3900" fill="#2a1a0a" opacity=".12"/></g>`);
          tl.set(`#${id}-pw`, { opacity: 1 }, t0 + TH1);
          // her push: the boy rises onto the drum
          tl.fromTo(`#${id}-a2`, { y: 30 }, { y: -20, duration: 0.8, ease: "power2.out", immediateRender: false }, t0 + TH2 + 0.4);
        },
      });
      // ---------- gone · 1 cut: the boy alone on the drum; where she was, only rings on the water (WS, the past) ----------
      add("gone", {
        extra(L) { waterLevel(L, { hz: 560, moon: [1300, 170], tx: 1200, n: 34, seed: 63 }); },
        ...NIGHT, light: MOONL, blur: { sky: 1, far: 1, fg: 5 },
        cam: { keys: [{ t: 0, ...frL(560, 1300, 1.8) }, { t: D("gone"), glide: D("gone"), ease: "power1.inOut", ...frL(560, 1300, 1.55) }] },
        land: { y0: LY0 },
        actors: [A("manBoy", 600, 1430, 0.3, [{ t: 0, mode: "cling", eyes: "wide", mouth: "o" }])],
        captions: capsQ("gone"),
        fx(tl, id, t0, L) {
          put(L.act, oilDrum(600, 1470, 0.5, -6));
          put(L.act, `<g id="${id}-rg">${[1, 2, 3].map((i) => `<ellipse cx="380" cy="1500" rx="${40 * i}" ry="${10 * i}" fill="none" stroke="#cfe2ff" stroke-width="4" opacity="${(0.8 - i * 0.2).toFixed(2)}"/>`).join("")}</g>`);
          tl.fromTo(`#${id}-rg`, { scale: 0.5, svgOrigin: "380 1500", opacity: 1 }, { scale: 2.2, svgOrigin: "380 1500", opacity: 0, duration: D("gone"), ease: "power1.out", immediateRender: false }, t0);
          put(L.act, `<path d="M-1500,1500${Array.from({ length: 75 }, () => `q20,-10 40,0`).join("")}V2400H-1500Z" fill="url(#kWater)" opacity=".92"/>`);
          pastWash(L);
        },
      });
      // ---------- hush · 1 cut, 4 s of silence (the long silence of the film): น้าหมาน on the steps today, not looking at anyone (CU, held) ----------
      add("hush", {
        extra(L) { stepsSet(L, { seed: 64 }); },
        ...NIGHT, light: { ...WARML, rim: "#9ab8ff", rimOp: 0.7 }, blur: { sky: 4, far: 4, mid: 3, fg: 6 },
        cam: { keys: [{ t: 0, ...frL(-560, 915, 4.6) }, { t: D("hush"), glide: D("hush"), ...frL(-560, 918, 4.75) }] },
        land: { y0: LY0 },
        actors: [A("naMan", -560, 1080, 0.38, [{ t: 0, mode: "sit", eyes: "closed", mouth: "flat" }, { t: 2.2, mode: "sit", eyes: "side", mouth: "flat" }])],
        captions: [],
      });
      // ---------- cans · 2 cuts: his three empty gallons by the steps, caps on, a little water in each (insert) → น้าหมาน: "in case someone needs them" (MS) ----------
      const CA1 = 2.6;
      add("cans", {
        extra(L) { stepsSet(L, { seed: 65 }); put(L.set, gallon(-430, 1162, 0.62, { water: true }) + gallon(-380, 1170, 0.62, { rot: 4, water: true }) + gallon(-470, 1176, 0.62, { rot: -3, water: true })); },
        ...NIGHT, light: WARML, blur: { sky: 4, far: 4, mid: 3, fg: 6 },
        cam: { keys: [{ t: 0, ...frL(-430, 1130, 5.0) }, { t: CA1 - 0.05, glide: CA1, ...frL(-430, 1130, 5.3) },
          { t: CA1, ...frL(-500, 1010, 2.4) }, { t: D("cans"), glide: D("cans") - CA1, ...frL(-500, 1010, 2.55) }] },
        land: { y0: LY0 },
        actors: [A("naMan", -560, 1080, 0.38, [{ t: 0, mode: "sit", eyes: "side", mouth: "flat" }, { t: 4.0, mode: "sit", eyes: "normal", mouth: "smile" }], { talk: [TK("cans", 0, "flat")] })],
        captions: capsQ("cans"),
      });
      // ---------- pier · 3 cuts: ยาย today: "that night I was on the landing… I saw Maan floating with the drum" (CU) → the past: หยิบ at eighteen on the landing,
      // looking down at the boy on the drum (WS) → ยาย holds the rule paddle: "the first rhyme… I made it that very night" (the paddle, rule 1 lit) ----------
      const PI1 = 1.9, PI2 = vo("pier", 1) - 0.1;
      add("pier", {
        extra(L) { pier(L, { seed: 66, noBoat: true }); },
        ...NIGHT, light: WARML, blur: { sky: 3, far: 3, mid: 2, fg: 5 },
        cam: { keys: [{ t: 0, ...frL(-150, 905, 4.2) }, { t: PI1 - 0.05, glide: PI1, ...frL(-150, 908, 4.4) },
          { t: PI1, ...frL(150, 1150, 1.4) }, { t: PI2, ...frL(-150, 905, 4.2) }, { t: D("pier"), glide: D("pier") - PI2, ...frL(-150, 908, 4.35) }] },
        land: { y0: LY0 },
        actors: [
          A("yaiYib", -150, 1084, 0.4, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }], { talk: [TK("pier", 0), TK("pier", 1)] }),
          A("yibYoung", -150, 1084, 0.4, [{ t: 0, mode: "holdHead", eyes: "wide", mouth: "o" }], { from: PI1 }),
          A("manBoy", 520, 1430, 0.3, [{ t: 0, mode: "cling", eyes: "wide", mouth: "o" }], { from: PI1 }),
        ],
        captions: capsQ("pier"),
        fx(tl, id, t0, L) {
          tl.set(`#${id}-a0`, { opacity: 0 }, t0 + PI1); tl.set(`#${id}-a0`, { opacity: 1 }, t0 + PI2);
          tl.set([`#${id}-a1`, `#${id}-a2`], { opacity: 0 }, t0 + PI2);
          put(L.act, `<g id="${id}-dr" opacity="0">${oilDrum(520, 1470, 0.5, -6)}<path d="M-1500,1490${Array.from({ length: 75 }, () => `q20,-10 40,0`).join("")}V2400H-1500Z" fill="url(#kWater)" opacity=".9"/></g>`);
          tl.set(`#${id}-dr`, { opacity: 1 }, t0 + PI1); tl.set(`#${id}-dr`, { opacity: 0 }, t0 + PI2);
          put(L.light, `<g id="${id}-pw" opacity="0"><rect x="-1500" y="-900" width="4100" height="3900" fill="#8a5a2a" opacity=".3" style="mix-blend-mode:color"/><rect x="-1500" y="-900" width="4100" height="3900" fill="#2a1a0a" opacity=".12"/></g>`);
          tl.set(`#${id}-pw`, { opacity: 1 }, t0 + PI1); tl.set(`#${id}-pw`, { opacity: 0 }, t0 + PI2);
          rulePaddle(L, `${id}-pd`, 0, []); paddleIn(tl, `${id}-pd`, t0 + PI2 + 1.0);
        },
      });
      // ---------- shame · 2 cuts: มะปราง: "and everyone still calls you a drunk…" (CU) → น้าหมาน smiles: "it's fine… as long as everyone gets ashore" (CU) ----------
      const SHC = vo("shame", 1) - 0.15;
      add("shame", {
        extra(L) { stepsSet(L, { seed: 67 }); },
        ...NIGHT, light: WARML, blur: { sky: 4, far: 4, mid: 3, fg: 6 },
        cam: { keys: [{ t: 0, ...frL(-380, 905, 4.2) }, { t: SHC - 0.05, glide: SHC, ...frL(-380, 905, 4.4) },
          { t: SHC, ...frL(-570, 910, 4.0) }, { t: D("shame"), glide: D("shame") - SHC, ...frL(-570, 912, 4.2) }] },
        land: { y0: LY0 },
        actors: [
          A("maprangWet", -380, 1084, 0.4, [{ t: 0, mode: "sit", eyes: "worry", mouth: "flat" }], { flip: true, talk: [TK("shame", 0)] }),
          A("naMan", -580, 1080, 0.38, [{ t: 0, mode: "sit", eyes: "side", mouth: "flat" }, { t: SHC + 1.0, mode: "sit", eyes: "normal", mouth: "smile" }], { talk: [TK("shame", 1, "smile")] }),
        ],
        captions: capsQ("shame"),
      });
      // ---------- 21–22 · accuse: a blanket-wrapped passenger points at ลุง (MS, low) → ลุง pulls the brass whistle out of his shirt (CU) ----------
      const AC1 = 3.1;
      add("accuse", {
        extra(L) { pier(L, { seed: 11 }); },
        ...NIGHT, light: WARML, blur: { sky: 3, far: 3, mid: 2, fg: 5 },
        cam: { keys: [{ t: 0, ...fr(160, 1190, 2.2, 540, 1000) }, { t: AC1 - 0.05, glide: AC1, ...fr(170, 1190, 2.3, 540, 1000) },
          { t: AC1, ...fr(440, 1130, 3.4, 540, 900) }, { t: D("accuse"), glide: D("accuse") - AC1, ...fr(440, 1150, 3.6, 540, 900) }] },
        actors: [
          A("pxB", 160, 1334, 0.44, [{ t: 0, mode: "point", eyes: "angry", mouth: "scream" }], { talk: [TK("accuse", 0, "scream")] }),
          A("lungMuek", 440, 1330, 0.46, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }, { t: AC1 + 0.4, mode: "stick", eyes: "worry", mouth: "o" }], { flip: true, talk: [TK("accuse", 1)] }),
        ],
        captions: capsQ("accuse"),
        fx(tl, id, t0, L) {
          put(L.act, `<g transform="translate(160,1240)"><path d="M-70,-60Q-90,40 -60,80H70Q90,40 70,-60Q0,-90 -70,-60Z" fill="#b84a2a" opacity=".85" ${KOUT2}/></g>`);
          put(L.act, `<g id="${id}-bw" opacity="0"><g transform="translate(410,1150) scale(.3)"><rect x="-30" y="-24" width="130" height="48" rx="22" fill="#d8a83a" ${KOUT}/><circle cx="84" r="12" fill="#5a3a1e"/></g></g>`);
          put(L.glow, `<circle id="${id}-bg" cx="430" cy="1150" r="40" fill="url(#kBulb)" opacity="0"/>`);
          tl.set(`#${id}-bw`, { opacity: 1 }, t0 + AC1 + 0.6); tl.fromTo(`#${id}-bg`, { opacity: 0 }, { opacity: 0.9, duration: 0.3, yoyo: true, repeat: 3, immediateRender: false }, t0 + AC1 + 0.7);
        },
      });
      // ---------- 23–24 · reveal (the twist): silence, the bass cut — the camera sinks down to ข้าวปั้น's fist still round the orange whistle (ECU, pull out) → his face, sobbing (CU) ----------
      const RV1 = 4.3;
      add("reveal", {
        extra(L) { pier(L, { seed: 12 }); },
        ...NIGHT, light: { ...MOONL, rim: "#9ab8ff", rimOp: 0.8 }, blur: { sky: 4, far: 4, mid: 3, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(210, 1250, 4.0, 540, 960) }, { t: RV1 - 0.05, glide: RV1, ease: "power1.inOut", ...fr(210, 1250, 3.3, 540, 960) },
          { t: RV1, ...fr(210, 1170, 3.4, 540, 900) }, { t: D("reveal"), glide: D("reveal") - RV1, ...fr(210, 1180, 3.1, 540, 900) }] },
        actors: [
          A("khaopan", 210, 1336, 0.34, [{ t: 0, mode: "idle", eyes: "worry", mouth: "flat" }, { t: RV1 + 0.2, mode: "holdHead", eyes: "closed", mouth: "o" }], { talk: [TK("reveal", 1, "o")] }),
        ],
        captions: capsQ("reveal"),
        fx(tl, id, t0, L) {
          put(L.act, `<g id="${id}-f">${fist(222, 1258, 0.12)}${orangeWhistle(232, 1254, 0.07)}</g>`);
          tl.set(`#${id}-f`, { opacity: 0 }, t0 + RV1);
          tl.fromTo(`#${id}-f`, { x: 0 }, { x: 1.2, duration: 0.08, yoyo: true, repeat: 40, ease: "none", immediateRender: false }, t0);
        },
      });
      // ---------- 25–26 · hug: ยาย kneels and holds him, both faces in frame (MS) → ลุง takes off his hat, looks at the "12 คน" sign (MS) ----------
      const HU1 = 7.35;
      add("hug", {
        extra(L) { pier(L, { seed: 13 }); },
        ...NIGHT, light: WARML, blur: { sky: 3, far: 3, mid: 2, fg: 5 },
        cam: { keys: [{ t: 0, ...fr(170, 1250, 2.9, 540, 960) }, { t: HU1 - 0.05, glide: HU1, ...fr(170, 1250, 3.1, 540, 960) },
          { t: HU1, ...fr(820, 1180, 2.2, 540, 960) }, { t: D("hug"), glide: D("hug") - HU1, ...fr(860, 1180, 2.3, 540, 960) }] },
        actors: [
          A("yaiYib", 130, 1336, 0.42, [{ t: 0, mode: "crouch", eyes: "worry", mouth: "o" }], { talk: [TK("hug", 0)] }),
          A("khaopan", 230, 1336, 0.34, [{ t: 0, mode: "holdHead", eyes: "closed", mouth: "o" }, { t: 4.0, mode: "idle", eyes: "worry", mouth: "flat" }], { flip: true }),
          A("lungMuek", 820, 1330, 0.46, [{ t: 0, mode: "idle", eyes: "worry", mouth: "flat" }, { t: HU1 + 0.6, mode: "holdHead", eyes: "worry", mouth: "flat" }], { flip: true, talk: [TK("hug", 1)] }),
        ],
        captions: capsQ("hug"),
        fx(tl, id, t0, L) {
          // ยาย's arm round him
          put(L.act, `<path d="M118,1218Q170,1190 236,1226" stroke="#e8e0d0" stroke-width="12" stroke-linecap="round" fill="none"/>`);
          // the "ผู้โดยสาร 12 คน" sign leaning on the post beside ลุง
          put(L.set, `<g transform="translate(980,1240) rotate(6)"><rect x="-80" y="-40" width="160" height="78" rx="7" fill="#f6f2e4" ${KOUT2}/><text x="0" y="-8" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="22" fill="#1e1a14">ผู้โดยสาร</text><text x="0" y="26" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="30" fill="#c8241e">12 คน</text></g>`);
        },
      });
