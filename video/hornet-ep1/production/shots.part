        fx(tl, id, t0, L) { HnFx.yard(tl, L, t0, D("fine"), { leaves: 4 }); put(L.glow, `<g id="e16d">${[[1480, 1180], [1492, 1205], [1470, 1220], [1505, 1235], [1485, 1250], [1560, 1190], [1575, 1215], [1552, 1232], [1568, 1252]].map(([x, y]) => `<circle cx="${x}" cy="${y}" r="7" fill="#ff7a6a" opacity=".55"/><circle cx="${x}" cy="${y}" r="2.6" fill="#a01e18"/>`).join("")}</g>`); } });
      // ---------- 22. next ----------
      add("next", { ...Y2("e17"), captions: [], fx(tl, id, t0, L) { HnFx.yard(tl, L, t0, D("next"), { leaves: 4 }); HnUI.nextBoard(tl, L.light, t0, D("next"), { l1: "ตอนที่ 2 (ตอนจบ)", l2: "ตาบอกว่าไม่เป็นไร", l3: "กดติดตาม แล้วพาตาไปหาหมอด้วยกัน" }); } });
