
      // ======================================================================================================
      // v2 look: muted cinematic grade + cream "field notebook" HUD (stat chips, rule cards, title, end card)
      // ======================================================================================================
      window.GRADE = { filter: "saturate(.6) brightness(.84) contrast(1.1)", tint: "#8a9cb0", tintOp: 0.22 };
      const PK_INK = "#1e1d1b", PK_RED = "#d9342b", PK_GOLD = "#c8a24a", PK_GREEN = "#3f9a6e";
      document.head.insertAdjacentHTML("beforeend", `<style>
        /* captions: white bold on a soft dark pill; [yellow words], {red box words} */
        .capwrap { top: 1470px; }
        .capbox { background: rgba(8,10,14,.6); color: #f6f3ec; border: 0; border-radius: 18px; box-shadow: 0 10px 30px rgba(0,0,0,.35); font: 900 56px/1.2 Kanit; padding: 10px 30px 14px; backdrop-filter: blur(4px); letter-spacing: .5px; }
        .capbox .k { background: none; color: #f2c55c; border: 0; padding: 0; transform: none; box-shadow: none; }
        .capbox .k.kr, .k.kr { background: ${PK_RED}; color: #fff; border-radius: 10px; padding: 0 .18em; box-shadow: 0 6px 18px rgba(217,52,43,.45); transform: none; }
        .capbox.q { background: rgba(243,238,227,.94); color: ${PK_INK}; border: 0; }
        .capbox.radio { background: rgba(30,18,6,.86); border: 2px solid #ffb35c; color: #ffd27a; letter-spacing: 6px; }
        .bubble { background: #f3eee3; border: 0; border-radius: 22px; color: ${PK_INK}; font: 900 42px/1.2 Kanit; box-shadow: 0 12px 30px rgba(0,0,0,.45); padding: 14px 24px 18px; }
        .bubble:after { border: 0; background: #f3eee3; bottom: -26px; }
        .badge { font: 700 24px/1 Kanit; opacity: .6; background: none; padding: 0; letter-spacing: 3px; }
        /* stat chip (top-left): icon, small label, big number, segments */
        .pks { position: absolute; left: 36px; top: 150px; z-index: 52; opacity: 0; display: flex; gap: 16px; align-items: center; padding: 12px 22px 12px 14px; border-radius: 18px;
          background: #f3eee3; color: ${PK_INK}; font-family: Kanit; box-shadow: 0 14px 34px rgba(0,0,0,.45), inset 6px 0 0 ${PK_GOLD}; }
        .pks.right { left: auto; right: 36px; }
        .pks .ic { width: 64px; height: 64px; border-radius: 16px; background: #e6dfcd; display: grid; place-items: center; flex: none; } .pks .ic svg { width: 48px; height: 48px; }
        .pks .lbl { font: 700 22px/1 Kanit; color: #6b675f; letter-spacing: 1px; margin-bottom: 2px; }
        .pks .v { font: 900 58px/1 Kanit; color: ${PK_INK}; } .pks .v small { font: 700 26px/1 Kanit; color: #6b675f; margin-left: 6px; }
        .pks .seg { display: flex; gap: 3px; margin-top: 6px; } .pks .seg i { width: 14px; height: 10px; border-radius: 2px; background: ${PK_GREEN}; } .pks .seg i.off { background: #cfc8b6; }
        .pks.alarm { box-shadow: 0 14px 34px rgba(0,0,0,.45), inset 6px 0 0 ${PK_RED}; } .pks.alarm .v { color: ${PK_RED}; } .pks.alarm .seg i { background: ${PK_RED}; } .pks.alarm .seg i.off { background: #cfc8b6; }
        .pks .sub { margin-top: 6px; display: inline-block; font: 700 20px/1 Kanit; color: #6b675f; background: #e6dfcd; padding: 5px 10px 6px; border-radius: 10px; }
        /* title card: red series pill, the big count, the radio chip, the episode line */
        .pkt { position: absolute; left: 0; right: 0; top: 150px; z-index: 52; text-align: center; font-family: Kanit; color: #f6f3ec; opacity: 0; }
        .pkt .pill { display: inline-block; font: 700 30px/1 Kanit; letter-spacing: 2px; background: ${PK_RED}; color: #fff; padding: 10px 24px 12px; border-radius: 12px; box-shadow: 0 8px 24px rgba(217,52,43,.4); }
        .pkt .big { font: 900 150px/1.05 Kanit; margin-top: 14px; text-shadow: 0 6px 30px rgba(0,0,0,.6); letter-spacing: 1px; }
        .pkt .big b { color: #f2c55c; }
        .pkt .chip { display: inline-flex; align-items: center; gap: 10px; margin-top: 10px; font: 700 26px/1 Kanit; color: ${PK_INK}; background: #f3eee3; padding: 9px 18px 10px; border-radius: 30px; }
        .pkt .chip svg { width: 30px; height: 30px; }
        .pkt .ep { margin-top: 14px; font: 700 30px/1 Kanit; color: rgba(246,243,236,.75); letter-spacing: 2px; }
        /* rule card: cream, red edge, "กฎข้อ N" pill, two-line title, red rule, icon pills */
        .pkr { position: absolute; left: 50%; width: 760px; margin-left: -380px; top: 200px; z-index: 52; font-family: Kanit; }
        .pkr .card { position: absolute; left: 0; right: 0; top: 0; padding: 26px 30px 26px 36px; border-radius: 18px; background: #f3eee3; color: ${PK_INK}; text-align: center; opacity: 0;
          box-shadow: 0 20px 50px rgba(0,0,0,.5), inset 10px 0 0 ${PK_RED}; }
        .pkr .n { display: inline-flex; align-items: center; gap: 8px; font: 700 26px/1 Kanit; letter-spacing: 2px; color: #f6f3ec; background: #2b2a27; padding: 8px 18px 9px; border-radius: 30px; }
        .pkr .n svg { width: 24px; height: 24px; }
        .pkr .t { font: 900 62px/1.15 Kanit; margin-top: 14px; } .pkr .t b { color: ${PK_RED}; } .pkr .t u { text-decoration: none; color: ${PK_RED}; }
        .pkr .line { width: 220px; height: 5px; border-radius: 3px; background: ${PK_RED}; margin: 16px auto 14px; }
        .pkr .ics { display: flex; justify-content: center; gap: 14px; } .pkr .ics span { width: 56px; height: 56px; border-radius: 50%; border: 3px solid #cfc8b6; display: grid; place-items: center; } .pkr .ics svg { width: 34px; height: 34px; }
        /* end card: "ตอนต่อไป" pill + big "ตอนที่ 2" above the ledger page */
        .pkn { position: absolute; left: 0; right: 0; top: 150px; z-index: 52; text-align: center; font-family: Kanit; color: #f6f3ec; opacity: 0; }
        .pkn .pill { display: inline-flex; align-items: center; gap: 10px; font: 700 26px/1 Kanit; letter-spacing: 2px; background: rgba(243,238,227,.14); color: #f6f3ec; padding: 9px 20px 10px; border-radius: 30px; border: 2px solid rgba(243,238,227,.3); }
        .pkn .pill i { width: 14px; height: 14px; border-radius: 50%; background: ${PK_RED}; box-shadow: 0 0 12px ${PK_RED}; }
        .pkn .big { font: 900 120px/1.05 Kanit; margin-top: 10px; text-shadow: 0 6px 30px rgba(0,0,0,.6); }
        .pkn .tag { font: 900 40px/1.2 Kanit; color: #ff8a7a; margin-top: 4px; }
        /* the rest of the HUD on cream */
        .zsrc span { background: #f3eee3; border: 0; color: ${PK_INK}; font: 700 25px/1.25 Kanit; box-shadow: 0 10px 24px rgba(0,0,0,.4); backdrop-filter: none; } .zsrc b { background: ${PK_GOLD}; color: #fff; box-shadow: none; } .zsrc em { color: ${PK_RED}; }
        .zcall span { background: ${PK_RED}; border: 0; color: #fff; font: 900 48px/1 Kanit; box-shadow: 0 12px 34px rgba(217,52,43,.45); backdrop-filter: none; padding: 12px 28px 16px; border-radius: 14px; } .zcall small { color: #ffd6d0; }
        .fsun { background: #f3eee3; border: 0; box-shadow: 0 14px 34px rgba(0,0,0,.45), inset 6px 0 0 ${PK_GOLD}; backdrop-filter: none; border-radius: 18px; width: 400px; }
        .fsun .tm { color: ${PK_INK}; } .fsun .lf { color: #6b675f; } .fsun .lf b { color: ${PK_INK}; } .fsun.late { box-shadow: 0 14px 34px rgba(0,0,0,.45), inset 6px 0 0 ${PK_RED}; } .fsun.late .lf b { color: ${PK_RED}; }
        .fsigns .row { background: #f3eee3; border: 0; box-shadow: 0 14px 34px rgba(0,0,0,.45), inset 8px 0 0 ${PK_RED}; backdrop-filter: none; border-radius: 18px; padding: 14px 26px; }
        .fsigns .ic { background: #e6dfcd; } .fsigns .tx { color: ${PK_INK}; font-size: 48px; } .fsigns .tx em { color: ${PK_RED}; } .fsigns .bad { color: ${PK_RED}; }
        .gui.tip { background: #f3eee3; border: 0; color: ${PK_INK}; box-shadow: 0 20px 50px rgba(0,0,0,.5), inset 10px 0 0 ${PK_RED}; border-radius: 18px; }
        .gui.tip.rule { box-shadow: 0 20px 50px rgba(0,0,0,.5), inset 10px 0 0 ${PK_GOLD}; }
        .gui.tip .txt { color: ${PK_INK}; } .gui.tip .med { background: #e6dfcd; border-color: #cfc8b6; box-shadow: none; } .gui .k { background: ${PK_RED}; color: #fff; transform: none; border-radius: 8px; }
        .gui .bar { background: rgba(30,29,27,.12); } .gui .bar i { background: ${PK_RED}; }
        .choice .q, .choice .opt { background: #f3eee3; border: 0; color: ${PK_INK}; box-shadow: 0 16px 40px rgba(0,0,0,.5); } .choice .key { background: #2b2a27; color: #f6f3ec; box-shadow: none; }
        .choice .who { color: #ff8a7a; } .choice .who2 { color: #f2c55c; }
        .fledger .page { box-shadow: 0 30px 60px rgba(0,0,0,.7); }
      </style>`);
      const PK_ICON = {
        people: `<circle cx="17" cy="16" r="8" fill="${PK_INK}"/><circle cx="33" cy="18" r="7" fill="${PK_INK}" opacity=".7"/><path d="M4,42c0,-12 7,-17 13,-17s13,5 13,17z" fill="${PK_INK}"/><path d="M26,42c1,-8 5,-13 9,-13c5,0 9,4 9,13z" fill="${PK_INK}" opacity=".7"/>`,
        can: `<rect x="12" y="10" width="24" height="30" rx="4" fill="#dcd6c4" stroke="${PK_INK}" stroke-width="3"/><rect x="12" y="20" width="24" height="10" fill="${PK_RED}"/><path d="M12,10q12,-7 24,0" fill="#eee9da" stroke="${PK_INK}" stroke-width="3"/>`,
        rice: `<path d="M12,42q-6,-18 6,-26h12q12,8 6,26z" fill="#e2d4a8" stroke="${PK_INK}" stroke-width="3"/><path d="M16,16q8,4 16,0" stroke="${PK_INK}" stroke-width="3" fill="none"/><path d="M19,30q5,-4 10,0" stroke="${PK_INK}" stroke-width="2.5" fill="none"/>`,
        radio: `<rect x="6" y="16" width="36" height="24" rx="4" fill="#8a6a42" stroke="${PK_INK}" stroke-width="3"/><rect x="11" y="21" width="16" height="10" rx="2" fill="#ffb35c"/><circle cx="34" cy="26" r="4" fill="${PK_INK}"/><path d="M30,16L40,6" stroke="${PK_INK}" stroke-width="3"/>`,
        thermo: `<rect x="20" y="6" width="8" height="26" rx="4" fill="#fff" stroke="${PK_INK}" stroke-width="3"/><circle cx="24" cy="36" r="7" fill="${PK_RED}" stroke="${PK_INK}" stroke-width="3"/><rect x="22" y="18" width="4" height="16" fill="${PK_RED}"/>`,
        water: `<path d="M24,6c8,12 14,18 14,26a14,14 0 0 1 -28,0c0,-8 6,-14 14,-26z" fill="#6fb3d6" stroke="${PK_INK}" stroke-width="3"/>`,
        sun: `<circle cx="24" cy="24" r="9" fill="#f2c55c" stroke="${PK_INK}" stroke-width="3"/><path d="M24,4v8M24,36v8M4,24h8M36,24h8M9,9l6,6M33,33l6,6M39,9l-6,6M15,33l-6,6" stroke="${PK_INK}" stroke-width="3" stroke-linecap="round"/>`,
        shield: `<path d="M12,5L3,8v6c0,6 4,9 9,11c5,-2 9,-5 9,-11V8z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>`,
        clock: `<circle cx="15" cy="15" r="11" fill="none" stroke="${PK_INK}" stroke-width="2.6"/><path d="M15,8v7l5,3" stroke="${PK_INK}" stroke-width="2.6" fill="none" stroke-linecap="round"/>`,
      };
      // stat chip: keys [{t, v}] in shot time; `max` draws segments; `alarm` turns it red; `right` docks it right
      GameUI.C.counter = {
        html: (id, o) => `<div id="${id}" class="pks${o.right ? " right" : ""}" style="top:${o.top ?? 150}px"><div class="ic"><svg viewBox="0 0 48 48">${PK_ICON[o.icon || "can"]}</svg></div>
          <div><div class="lbl">${o.label}</div><div class="v"><span class="num">${o.keys[0].v}</span>${o.unit ? `<small>${o.unit}</small>` : ""}</div>
          ${o.max ? `<div class="seg">${Array.from({ length: o.max }, (_, k) => `<i class="${k < o.keys[0].v ? "" : "off"}"></i>`).join("")}</div>` : ""}${o.sub ? `<div class="sub">${o.sub}</div>` : ""}</div></div>`,
        anim(tl, id, t0, o) {
          const el = document.getElementById(id), num = el.querySelector(".num"), segs = el.querySelectorAll(".seg i"), c = { t: o.t };
          tl.fromTo(`#${id}`, { opacity: 0, x: -40 }, { opacity: 1, x: 0, duration: 0.3, ease: "back.out(1.6)", immediateRender: false }, t0);
          const at = (t) => { let i = 0; while (i + 1 < o.keys.length && o.keys[i + 1].t <= t) i++; const a = o.keys[i], b = o.keys[i + 1]; if (!b) return a.v; const k = Math.min(1, Math.max(0, (t - a.t) / (b.t - a.t))); return a.v + (b.v - a.v) * k; };
          const draw = () => { const v = at(c.t); num.textContent = Math.round(v); segs.forEach((s, k) => s.classList.toggle("off", k >= Math.round(v))); };
          tl.to(c, { t: o.end ?? 30, duration: (o.end ?? 30) - o.t, ease: "none", immediateRender: false, onUpdate: draw }, t0);
          if (o.alarm !== undefined) { tl.set(`#${id}`, { className: `pks${o.right ? " right" : ""} alarm` }, o.t0abs + o.alarm); tl.fromTo(`#${id}`, { x: 0 }, { x: 8, duration: 0.05, repeat: 7, yoyo: true, immediateRender: false }, o.t0abs + o.alarm); }
          draw();
          if (o.end !== undefined) tl.to(`#${id}`, { opacity: 0, duration: 0.2 }, o.t0abs + o.end);
        },
      };
      // title card for the chapter beat
      GameUI.C.board = {
        html: (id, o) => `<div id="${id}" class="pkt" style="top:${o.top ?? 150}px"><div class="pill" id="${id}-p">${o.series || "เอาชีวิตรอด 99 วัน"}</div>
          <div class="big" id="${id}-b">${o.label || "เหลือ"} <b>${o.day}</b> ${o.unit0 || "วัน"}</div>
          <div class="chip" id="${id}-c"><svg viewBox="0 0 48 48">${PK_ICON.radio}</svg>${o.unit || "ตามที่วิทยุนับ"}</div>
          <div class="ep" id="${id}-e">${o.ep}</div></div>`,
        anim(tl, id, t0, o) {
          tl.set(`#${id}`, { opacity: 1 }, t0);
          [["p", 0, 0.25], ["b", 0.18, 0.4], ["c", 0.6, 0.3], ["e", 0.85, 0.3]].forEach(([k, at, d]) => tl.fromTo(`#${id}-${k}`, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: d, ease: "power3.out", immediateRender: false }, t0 + at));
          tl.fromTo(`#${id}-b b`, { scale: 1.6, color: "#fff" }, { scale: 1, color: "#f2c55c", duration: 0.45, ease: "back.out(1.4)", transformOrigin: "50% 60%", immediateRender: false }, t0 + 0.3);
          if (o.end !== undefined) tl.to(`#${id}`, { opacity: 0, duration: 0.2 }, o.t0abs + o.end);
        },
      };
      // the rules: one card per rule, each replacing the last at o.at[i]
      const PK_RULE_ICONS = [
        [`<circle cx="17" cy="17" r="7" fill="#f2c55c" stroke="${PK_INK}" stroke-width="2.4"/><path d="M4,28h26" stroke="${PK_INK}" stroke-width="2.4" stroke-linecap="round"/>`, `<path d="M17,5v6M9,8l3,4M25,8l-3,4" stroke="${PK_INK}" stroke-width="2.4" stroke-linecap="round"/><path d="M8,26l9,-14l9,14z" fill="${PK_INK}"/>`],
        [`<path d="M8,20q0,-6 5,-6l4,4l4,-4q5,0 5,6v8H8z" fill="none" stroke="${PK_INK}" stroke-width="2.4" stroke-linejoin="round"/><path d="M13,14V9q0,-4 4,-4t4,4v5" fill="none" stroke="${PK_INK}" stroke-width="2.4"/>`, `<circle cx="17" cy="17" r="11" fill="none" stroke="${PK_RED}" stroke-width="2.6"/><path d="M9,9l16,16" stroke="${PK_RED}" stroke-width="2.6" stroke-linecap="round"/>`],
        [`<path d="M6,28V12l11,-6l11,6v16z" fill="none" stroke="${PK_INK}" stroke-width="2.4" stroke-linejoin="round"/><path d="M17,6v22M6,19h22" stroke="${PK_INK}" stroke-width="2"/>`, `<path d="M8,26L26,8M20,8h6v6" fill="none" stroke="${PK_RED}" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="17" cy="17" r="12" fill="none" stroke="${PK_RED}" stroke-width="2.6"/>`],
      ];
      GameUI.C.fRule = {
        html: (id, o) => `<div id="${id}" class="pkr" style="top:${o.top ?? 200}px">${o.rows.map((txt, i) => `<div class="card" id="${id}-r${i}"><div class="n"><svg viewBox="0 0 24 24" style="color:#f2c55c">${PK_ICON.shield}</svg>กฎข้อ ${i + 1}</div>
          <div class="t">${txt}</div><div class="line"></div><div class="ics">${PK_RULE_ICONS[i].map((ic) => `<span><svg viewBox="0 0 34 34">${ic}</svg></span>`).join("")}</div></div>`).join("")}</div>`,
        anim(tl, id, t0, o) {
          const A = (t) => o.t0abs + t;
          o.at.forEach((at, i) => {
            tl.fromTo(`#${id}-r${i}`, { opacity: 0, y: 40, scale: 0.94 }, { opacity: 1, y: 0, scale: 1, duration: 0.3, ease: "back.out(1.5)", immediateRender: false }, A(at));
            tl.fromTo(`#${id}-r${i} .line`, { scaleX: 0 }, { scaleX: 1, duration: 0.35, ease: "power2.out", transformOrigin: "50% 50%", immediateRender: false }, A(at) + 0.25);
            tl.fromTo(`#${id}-r${i} .ics span`, { scale: 0 }, { scale: 1, duration: 0.3, stagger: 0.08, ease: "back.out(2)", immediateRender: false }, A(at) + 0.35);
            if (i) tl.to(`#${id}-r${i - 1}`, { opacity: 0, y: -40, duration: 0.2, ease: "power2.in" }, A(at) - 0.05);
          });
          if (o.end !== undefined) tl.to(`#${id}`, { opacity: 0, y: -20, duration: 0.25 }, A(o.end));
        },
      };
      // "ตอนต่อไป · ตอนที่ 2" header for the end card
      GameUI.C.nextCard = {
        html: (id, o) => `<div id="${id}" class="pkn" style="top:${o.top ?? 150}px"><div class="pill" id="${id}-p"><i></i>ตอนต่อไป</div><div class="big" id="${id}-b">${o.big}</div><div class="tag" id="${id}-t">${o.tag}</div></div>`,
        anim(tl, id, t0, o) {
          tl.set(`#${id}`, { opacity: 1 }, t0);
          [["p", 0, 0.25], ["b", 0.15, 0.4], ["t", 0.5, 0.3]].forEach(([k, at, d]) => tl.fromTo(`#${id}-${k}`, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: d, ease: "power3.out", immediateRender: false }, t0 + at));
          tl.fromTo(`#${id}-p i`, { opacity: 0.3 }, { opacity: 1, duration: 0.5, repeat: 9, yoyo: true, immediateRender: false }, t0);
        },
      };
