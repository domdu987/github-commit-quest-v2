
      // ======================================================================================================
      // v2 look: muted cinematic grade + cream "field notebook" HUD (stat chips, rule cards, title, end card)
      // ======================================================================================================
      window.GRADE = { filter: "saturate(.6) brightness(.84) contrast(1.1)", tint: "#8a9cb0", tintOp: 0.22 };
      const PK_INK = "#1e1d1b", PK_RED = "#d9342b", PK_GOLD = "#c8a24a", PK_GREEN = "#3f9a6e";
      document.head.insertAdjacentHTML("beforeend", `<style>
        /* captions: white bold on a soft dark pill; [yellow words], {red box words} */
        .capwrap { top: 1470px; }
        .capbox { background: rgba(8,10,14,.6); color: #f6f3ec; border: 0; border-radius: 18px; box-shadow: 0 10px 30px rgba(0,0,0,.35); font: 900 56px/1.2 Kanit; padding: 10px 30px 14px; backdrop-filter: blur(4px); letter-spacing: .5px; }
        .capbox .k { background: none; color: #f2c55c; border: 0; padding: 0; transform: none; box-shadow: none; }
        .capbox .k.kr, .k.kr { background: ${PK_RED}; color: #fff; border-radius: 10px; padding: 0 .18em; box-shadow: 0 6px 18px rgba(217,52,43,.45); transform: none; }
        .capbox.q { background: rgba(243,238,227,.94); color: ${PK_INK}; border: 0; }
        .capbox.radio { background: rgba(30,18,6,.86); border: 2px solid #ffb35c; color: #ffd27a; letter-spacing: 6px; }
        .bubble { background: #f3eee3; border: 0; border-radius: 22px; color: ${PK_INK}; font: 900 42px/1.2 Kanit; box-shadow: 0 12px 30px rgba(0,0,0,.45); padding: 14px 24px 18px; }
        .bubble:after { border: 0; background: #f3eee3; bottom: -26px; }
        .badge { font: 700 24px/1 Kanit; opacity: .6; background: none; padding: 0; letter-spacing: 3px; }
        /* stat chip (top-left): icon, small label, big number, segments */
        .pks { position: absolute; left: 36px; top: 150px; z-index: 52; opacity: 0; display: flex; gap: 16px; align-items: center; padding: 12px 22px 12px 14px; border-radius: 18px;
          background: #f3eee3; color: ${PK_INK}; font-family: Kanit; box-shadow: 0 14px 34px rgba(0,0,0,.45), inset 6px 0 0 ${PK_GOLD}; }
        .pks.right { left: auto; right: 36px; }
        .pks .ic { width: 64px; height: 64px; border-radius: 16px; background: #e6dfcd; display: grid; place-items: center; flex: none; } .pks .ic svg { width: 48px; height: 48px; }
        .pks .lbl { font: 700 22px/1 Kanit; color: #6b675f; letter-spacing: 1px; margin-bottom: 2px; }
        .pks .v { font: 900 58px/1 Kanit; color: ${PK_INK}; } .pks .v small { font: 700 26px/1 Kanit; color: #6b675f; margin-left: 6px; }
        .pks .seg { display: flex; gap: 3px; margin-top: 6px; } .pks .seg i { width: 14px; height: 10px; border-radius: 2px; background: ${PK_GREEN}; } .pks .seg i.off { background: #cfc8b6; }
        .pks.alarm { box-shadow: 0 14px 34px rgba(0,0,0,.45), inset 6px 0 0 ${PK_RED}; } .pks.alarm .v { color: ${PK_RED}; } .pks.alarm .seg i { background: ${PK_RED}; } .pks.alarm .seg i.off { background: #cfc8b6; }
        .pks .sub { margin-top: 6px; display: inline-block; font: 700 20px/1 Kanit; color: #6b675f; background: #e6dfcd; padding: 5px 10px 6px; border-radius: 10px; }
        /* title card: red series pill, the big count, the radio chip, the episode line */
        .pkt { position: absolute; left: 0; right: 0; top: 150px; z-index: 52; text-align: center; font-family: Kanit; color: #f6f3ec; opacity: 0; }
        .pkt .pill { display: inline-block; font: 700 30px/1 Kanit; letter-spacing: 2px; background: ${PK_RED}; color: #fff; padding: 10px 24px 12px; border-radius: 12px; box-shadow: 0 8px 24px rgba(217,52,43,.4); }
        .pkt .big { font: 900 150px/1.05 Kanit; margin-top: 14px; text-shadow: 0 6px 30px rgba(0,0,0,.6); letter-spacing: 1px; }
        .pkt .big b { color: #f2c55c; }
        .pkt .chip { display: inline-flex; align-items: center; gap: 10px; margin-top: 10px; font: 700 26px/1 Kanit; color: ${PK_INK}; background: #f3eee3; padding: 9px 18px 10px; border-radius: 30px; }
        .pkt .chip svg { width: 30px; height: 30px; }
        .pkt .ep { margin-top: 14px; font: 700 30px/1 Kanit; color: rgba(246,243,236,.75); letter-spacing: 2px; }
        /* rule card: cream, red edge, "กฎข้อ N" pill, two-line title, red rule, icon pills */
        .pkr { position: absolute; left: 50%; width: 760px; margin-left: -380px; top: 200px; z-index: 52; font-family: Kanit; }
        .pkr .card { position: absolute; left: 0; right: 0; top: 0; padding: 26px 30px 26px 36px; border-radius: 18px; background: #f3eee3; color: ${PK_INK}; text-align: center; opacity: 0;
          box-shadow: 0 20px 50px rgba(0,0,0,.5), inset 10px 0 0 ${PK_RED}; }
        .pkr .n { display: inline-flex; align-items: center; gap: 8px; font: 700 26px/1 Kanit; letter-spacing: 2px; color: #f6f3ec; background: #2b2a27; padding: 8px 18px 9px; border-radius: 30px; }
        .pkr .n svg { width: 24px; height: 24px; }
        .pkr .t { font: 900 62px/1.15 Kanit; margin-top: 14px; } .pkr .t b { color: ${PK_RED}; } .pkr .t u { text-decoration: none; color: ${PK_RED}; }
        .pkr .line { width: 220px; height: 5px; border-radius: 3px; background: ${PK_RED}; margin: 16px auto 14px; }
        .pkr .ics { display: flex; justify-content: center; gap: 14px; } .pkr .ics span { width: 56px; height: 56px; border-radius: 50%; border: 3px solid #cfc8b6; display: grid; place-items: center; } .pkr .ics svg { width: 34px; height: 34px; }
        /* end card: "ตอนต่อไป" pill + big "ตอนที่ 2" above the ledger page */
        .pkn { position: absolute; left: 0; right: 0; top: 150px; z-index: 52; text-align: center; font-family: Kanit; color: #f6f3ec; opacity: 0; }
        .pkn .pill { display: inline-flex; align-items: center; gap: 10px; font: 700 26px/1 Kanit; letter-spacing: 2px; background: rgba(243,238,227,.14); color: #f6f3ec; padding: 9px 20px 10px; border-radius: 30px; border: 2px solid rgba(243,238,227,.3); }
        .pkn .pill i { width: 14px; height: 14px; border-radius: 50%; background: ${PK_RED}; box-shadow: 0 0 12px ${PK_RED}; }
        .pkn .big { font: 900 120px/1.05 Kanit; margin-top: 10px; text-shadow: 0 6px 30px rgba(0,0,0,.6); }
        .pkn .tag { font: 900 40px/1.2 Kanit; color: #ff8a7a; margin-top: 4px; }
        /* the rest of the HUD on cream */
        .zsrc span { background: #f3eee3; border: 0; color: ${PK_INK}; font: 700 25px/1.25 Kanit; box-shadow: 0 10px 24px rgba(0,0,0,.4); backdrop-filter: none; } .zsrc b { background: ${PK_GOLD}; color: #fff; box-shadow: none; } .zsrc em { color: ${PK_RED}; }
        .zcall span { background: ${PK_RED}; border: 0; color: #fff; font: 900 48px/1 Kanit; box-shadow: 0 12px 34px rgba(217,52,43,.45); backdrop-filter: none; padding: 12px 28px 16px; border-radius: 14px; } .zcall small { color: #ffd6d0; }
        .fsun { background: #f3eee3; border: 0; box-shadow: 0 14px 34px rgba(0,0,0,.45), inset 6px 0 0 ${PK_GOLD}; backdrop-filter: none; border-radius: 18px; width: 400px; }
        .fsun .tm { color: ${PK_INK}; } .fsun .lf { color: #6b675f; } .fsun .lf b { color: ${PK_INK}; } .fsun.late { box-shadow: 0 14px 34px rgba(0,0,0,.45), inset 6px 0 0 ${PK_RED}; } .fsun.late .lf b { color: ${PK_RED}; }
        .fsigns .row { background: #f3eee3; border: 0; box-shadow: 0 14px 34px rgba(0,0,0,.45), inset 8px 0 0 ${PK_RED}; backdrop-filter: none; border-radius: 18px; padding: 14px 26px; }
        .fsigns .ic { background: #e6dfcd; } .fsigns .tx { color: ${PK_INK}; font-size: 48px; } .fsigns .tx em { color: ${PK_RED}; } .fsigns .bad { color: ${PK_RED}; }
        .gui.tip { background: #f3eee3; border: 0; color: ${PK_INK}; box-shadow: 0 20px 50px rgba(0,0,0,.5), inset 10px 0 0 ${PK_RED}; border-radius: 18px; }
        .gui.tip.rule { box-shadow: 0 20px 50px rgba(0,0,0,.5), inset 10px 0 0 ${PK_GOLD}; }
        .gui.tip .txt { color: ${PK_INK}; } .gui.tip .med { background: #e6dfcd; border-color: #cfc8b6; box-shadow: none; } .gui .k { background: ${PK_RED}; color: #fff; transform: none; border-radius: 8px; }
        .gui .bar { background: rgba(30,29,27,.12); } .gui .bar i { background: ${PK_RED}; }
        .choice .q, .choice .opt { background: #f3eee3; border: 0; color: ${PK_INK}; box-shadow: 0 16px 40px rgba(0,0,0,.5); } .choice .key { background: #2b2a27; color: #f6f3ec; box-shadow: none; }
        .choice .who { color: #ff8a7a; } .choice .who2 { color: #f2c55c; }
        .fledger .page { box-shadow: 0 30px 60px rgba(0,0,0,.7); }
      </style>`);
      const PK_ICON = {
        people: `<circle cx="17" cy="16" r="8" fill="${PK_INK}"/><circle cx="33" cy="18" r="7" fill="${PK_INK}" opacity=".7"/><path d="M4,42c0,-12 7,-17 13,-17s13,5 13,17z" fill="${PK_INK}"/><path d="M26,42c1,-8 5,-13 9,-13c5,0 9,4 9,13z" fill="${PK_INK}" opacity=".7"/>`,
        can: `<rect x="12" y="10" width="24" height="30" rx="4" fill="#dcd6c4" stroke="${PK_INK}" stroke-width="3"/><rect x="12" y="20" width="24" height="10" fill="${PK_RED}"/><path d="M12,10q12,-7 24,0" fill="#eee9da" stroke="${PK_INK}" stroke-width="3"/>`,
        rice: `<path d="M12,42q-6,-18 6,-26h12q12,8 6,26z" fill="#e2d4a8" stroke="${PK_INK}" stroke-width="3"/><path d="M16,16q8,4 16,0" stroke="${PK_INK}" stroke-width="3" fill="none"/><path d="M19,30q5,-4 10,0" stroke="${PK_INK}" stroke-width="2.5" fill="none"/>`,
        radio: `<rect x="6" y="16" width="36" height="24" rx="4" fill="#8a6a42" stroke="${PK_INK}" stroke-width="3"/><rect x="11" y="21" width="16" height="10" rx="2" fill="#ffb35c"/><circle cx="34" cy="26" r="4" fill="${PK_INK}"/><path d="M30,16L40,6" stroke="${PK_INK}" stroke-width="3"/>`,
        thermo: `<rect x="20" y="6" width="8" height="26" rx="4" fill="#fff" stroke="${PK_INK}" stroke-width="3"/><circle cx="24" cy="36" r="7" fill="${PK_RED}" stroke="${PK_INK}" stroke-width="3"/><rect x="22" y="18" width="4" height="16" fill="${PK_RED}"/>`,
        water: `<path d="M24,6c8,12 14,18 14,26a14,14 0 0 1 -28,0c0,-8 6,-14 14,-26z" fill="#6fb3d6" stroke="${PK_INK}" stroke-width="3"/>`,
        sun: `<circle cx="24" cy="24" r="9" fill="#f2c55c" stroke="${PK_INK}" stroke-width="3"/><path d="M24,4v8M24,36v8M4,24h8M36,24h8M9,9l6,6M33,33l6,6M39,9l-6,6M15,33l-6,6" stroke="${PK_INK}" stroke-width="3" stroke-linecap="round"/>`,
        shield: `<path d="M12,5L3,8v6c0,6 4,9 9,11c5,-2 9,-5 9,-11V8z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>`,
        clock: `<circle cx="15" cy="15" r="11" fill="none" stroke="${PK_INK}" stroke-width="2.6"/><path d="M15,8v7l5,3" stroke="${PK_INK}" stroke-width="2.6" fill="none" stroke-linecap="round"/>`,
      };
      // stat chip: keys [{t, v}] in shot time; `max` draws segments; `alarm` turns it red; `right` docks it right
      GameUI.C.counter = {
        html: (id, o) => `<div id="${id}" class="pks${o.right ? " right" : ""}" style="top:${o.top ?? 150}px"><div class="ic"><svg viewBox="0 0 48 48">${PK_ICON[o.icon || "can"]}</svg></div>
          <div><div class="lbl">${o.label}</div><div class="v"><span class="num">${o.keys[0].v}</span>${o.unit ? `<small>${o.unit}</small>` : ""}</div>
          ${o.max ? `<div class="seg">${Array.from({ length: o.max }, (_, k) => `<i class="${k < o.keys[0].v ? "" : "off"}"></i>`).join("")}</div>` : ""}${o.sub ? `<div class="sub">${o.sub}</div>` : ""}</div></div>`,
        anim(tl, id, t0, o) {
          const el = document.getElementById(id), num = el.querySelector(".num"), segs = el.querySelectorAll(".seg i"), c = { t: o.t };
          tl.fromTo(`#${id}`, { opacity: 0, x: -40 }, { opacity: 1, x: 0, duration: 0.3, ease: "back.out(1.6)", immediateRender: false }, t0);
          tl.fromTo(`#${id} .ic svg`, { scale: 0, rotation: -40 }, { scale: 1, rotation: 0, duration: 0.45, ease: "back.out(2.4)", transformOrigin: "50% 50%", immediateRender: false }, t0 + 0.08);
          if (segs.length) tl.fromTo(`#${id} .seg i`, { scaleY: 0 }, { scaleY: 1, duration: 0.2, stagger: 0.03, ease: "power2.out", transformOrigin: "50% 100%", immediateRender: false }, t0 + 0.2);
          const at = (t) => { let i = 0; while (i + 1 < o.keys.length && o.keys[i + 1].t <= t) i++; const a = o.keys[i], b = o.keys[i + 1]; if (!b) return a.v; const k = Math.min(1, Math.max(0, (t - a.t) / (b.t - a.t))); return a.v + (b.v - a.v) * k; };
          const draw = () => { const v = at(c.t); num.textContent = Math.round(v); segs.forEach((s, k) => s.classList.toggle("off", k >= Math.round(v))); };
          tl.to(c, { t: o.end ?? 30, duration: (o.end ?? 30) - o.t, ease: "none", immediateRender: false, onUpdate: draw }, t0);
          if (o.alarm !== undefined) { tl.set(`#${id}`, { className: `pks${o.right ? " right" : ""} alarm` }, o.t0abs + o.alarm); tl.fromTo(`#${id}`, { x: 0 }, { x: 8, duration: 0.05, repeat: 7, yoyo: true, immediateRender: false }, o.t0abs + o.alarm);
            tl.fromTo(`#${id} .ic svg`, { rotation: -12 }, { rotation: 12, duration: 0.08, repeat: 5, yoyo: true, transformOrigin: "50% 50%", immediateRender: false }, o.t0abs + o.alarm); tl.set(`#${id} .ic svg`, { rotation: 0 }, o.t0abs + o.alarm + 0.5);
            tl.fromTo(`#${id} .v`, { scale: 1.35 }, { scale: 1, duration: 0.35, ease: "back.out(2)", transformOrigin: "0% 50%", immediateRender: false }, o.t0abs + o.alarm); }
          draw();
          if (o.end !== undefined) tl.to(`#${id}`, { opacity: 0, duration: 0.2 }, o.t0abs + o.end);
        },
      };
      // title card for the chapter beat
      GameUI.C.board = {
        html: (id, o) => `<div id="${id}" class="pkt" style="top:${o.top ?? 150}px"><div class="pill" id="${id}-p">${o.series || "เอาชีวิตรอด 99 วัน"}</div>
          <div class="big" id="${id}-b">${o.label || "เหลือ"} <b>${o.day}</b> ${o.unit0 || "วัน"}</div>
          <div class="chip" id="${id}-c"><svg viewBox="0 0 48 48">${PK_ICON.radio}</svg>${o.unit || "ตามที่วิทยุนับ"}</div>
          <div class="ep" id="${id}-e">${o.ep}</div></div>`,
        anim(tl, id, t0, o) {
          tl.set(`#${id}`, { opacity: 1 }, t0);
          [["p", 0, 0.25], ["b", 0.18, 0.4], ["c", 0.6, 0.3], ["e", 0.85, 0.3]].forEach(([k, at, d]) => tl.fromTo(`#${id}-${k}`, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: d, ease: "power3.out", immediateRender: false }, t0 + at));
          tl.fromTo(`#${id}-c svg`, { rotation: -15 }, { rotation: 15, duration: 0.12, repeat: 5, yoyo: true, transformOrigin: "50% 50%", immediateRender: false }, t0 + 0.7); tl.set(`#${id}-c svg`, { rotation: 0 }, t0 + 1.45);
          tl.fromTo(`#${id}-b b`, { scale: 1.6, color: "#fff" }, { scale: 1, color: "#f2c55c", duration: 0.45, ease: "back.out(1.4)", transformOrigin: "50% 60%", immediateRender: false }, t0 + 0.3);
          if (o.end !== undefined) tl.to(`#${id}`, { opacity: 0, duration: 0.2 }, o.t0abs + o.end);
        },
      };
      // the rules: one card per rule, each replacing the last at o.at[i]
      const PK_RULE_ICONS = [
        [`<circle cx="17" cy="17" r="7" fill="#f2c55c" stroke="${PK_INK}" stroke-width="2.4"/><path d="M4,28h26" stroke="${PK_INK}" stroke-width="2.4" stroke-linecap="round"/>`, `<path d="M17,5v6M9,8l3,4M25,8l-3,4" stroke="${PK_INK}" stroke-width="2.4" stroke-linecap="round"/><path d="M8,26l9,-14l9,14z" fill="${PK_INK}"/>`],
        [`<path d="M8,20q0,-6 5,-6l4,4l4,-4q5,0 5,6v8H8z" fill="none" stroke="${PK_INK}" stroke-width="2.4" stroke-linejoin="round"/><path d="M13,14V9q0,-4 4,-4t4,4v5" fill="none" stroke="${PK_INK}" stroke-width="2.4"/>`, `<circle cx="17" cy="17" r="11" fill="none" stroke="${PK_RED}" stroke-width="2.6"/><path d="M9,9l16,16" stroke="${PK_RED}" stroke-width="2.6" stroke-linecap="round"/>`],
        [`<path d="M6,28V12l11,-6l11,6v16z" fill="none" stroke="${PK_INK}" stroke-width="2.4" stroke-linejoin="round"/><path d="M17,6v22M6,19h22" stroke="${PK_INK}" stroke-width="2"/>`, `<path d="M8,26L26,8M20,8h6v6" fill="none" stroke="${PK_RED}" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="17" cy="17" r="12" fill="none" stroke="${PK_RED}" stroke-width="2.6"/>`],
      ];
      GameUI.C.fRule = {
        html: (id, o) => `<div id="${id}" class="pkr" style="top:${o.top ?? 200}px">${o.rows.map((txt, i) => `<div class="card" id="${id}-r${i}"><div class="n"><svg viewBox="0 0 24 24" style="color:#f2c55c">${PK_ICON.shield}</svg>กฎข้อ ${i + 1}</div>
          <div class="t">${txt}</div><div class="line"></div><div class="ics">${PK_RULE_ICONS[i].map((ic) => `<span><svg viewBox="0 0 34 34">${ic}</svg></span>`).join("")}</div></div>`).join("")}</div>`,
        anim(tl, id, t0, o) {
          const A = (t) => o.t0abs + t;
          o.at.forEach((at, i) => {
            tl.fromTo(`#${id}-r${i}`, { opacity: 0, y: 40, scale: 0.94 }, { opacity: 1, y: 0, scale: 1, duration: 0.3, ease: "back.out(1.5)", immediateRender: false }, A(at));
            tl.fromTo(`#${id}-r${i} .line`, { scaleX: 0 }, { scaleX: 1, duration: 0.35, ease: "power2.out", transformOrigin: "50% 50%", immediateRender: false }, A(at) + 0.25);
            tl.fromTo(`#${id}-r${i} .ics span`, { scale: 0 }, { scale: 1, duration: 0.3, stagger: 0.08, ease: "back.out(2)", immediateRender: false }, A(at) + 0.35);
            if (i) tl.to(`#${id}-r${i - 1}`, { opacity: 0, y: -40, duration: 0.2, ease: "power2.in" }, A(at) - 0.05);
          });
          if (o.end !== undefined) tl.to(`#${id}`, { opacity: 0, y: -20, duration: 0.25 }, A(o.end));
        },
      };
      // "ตอนต่อไป · ตอนที่ 2" header for the end card
      GameUI.C.nextCard = {
        html: (id, o) => `<div id="${id}" class="pkn" style="top:${o.top ?? 150}px"><div class="pill" id="${id}-p"><i></i>ตอนต่อไป</div><div class="big" id="${id}-b">${o.big}</div><div class="tag" id="${id}-t">${o.tag}</div></div>`,
        anim(tl, id, t0, o) {
          tl.set(`#${id}`, { opacity: 1 }, t0);
          [["p", 0, 0.25], ["b", 0.15, 0.4], ["t", 0.5, 0.3]].forEach(([k, at, d]) => tl.fromTo(`#${id}-${k}`, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: d, ease: "power3.out", immediateRender: false }, t0 + at));
          tl.fromTo(`#${id}-p i`, { opacity: 0.3 }, { opacity: 1, duration: 0.5, repeat: 9, yoyo: true, immediateRender: false }, t0);
        },
      };

      // ======================================================================================================
      // icons with depth and life: gradient + highlight + shadow, and a looping micro-motion while the card is up
      // ======================================================================================================
      const PKG = `<defs>
        <linearGradient id="pkg-tin" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#f7f8fa"/><stop offset=".45" stop-color="#c3c9cf"/><stop offset="1" stop-color="#6e767e"/></linearGradient>
        <linearGradient id="pkg-red" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#ff7a68"/><stop offset=".5" stop-color="#d9342b"/><stop offset="1" stop-color="#8e1d16"/></linearGradient>
        <linearGradient id="pkg-blue" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#7cc3ea"/><stop offset=".5" stop-color="#2f6fb8"/><stop offset="1" stop-color="#1b4475"/></linearGradient>
        <linearGradient id="pkg-yel" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#ffe08a"/><stop offset=".5" stop-color="#e8b830"/><stop offset="1" stop-color="#a37d12"/></linearGradient>
        <linearGradient id="pkg-sack" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f3e4bb"/><stop offset="1" stop-color="#b08f4e"/></linearGradient>
        <linearGradient id="pkg-wood" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#b5844f"/><stop offset="1" stop-color="#5a3a1e"/></linearGradient>
        <radialGradient id="pkg-glow"><stop offset="0" stop-color="#ffd27a"/><stop offset="1" stop-color="#ff9a3c" stop-opacity=".2"/></radialGradient>
        <radialGradient id="pkg-skin" cx=".35" cy=".3" r=".8"><stop offset="0" stop-color="#ffd9b8"/><stop offset="1" stop-color="#c98a5e"/></radialGradient>
        <radialGradient id="pkg-sun" cx=".4" cy=".35" r=".7"><stop offset="0" stop-color="#fff5c8"/><stop offset=".6" stop-color="#ffcf5a"/><stop offset="1" stop-color="#f08a2a"/></radialGradient>
        <linearGradient id="pkg-water" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#aee3fb"/><stop offset=".6" stop-color="#3b93cf"/><stop offset="1" stop-color="#1c4f80"/></linearGradient>
        <linearGradient id="pkg-glass" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#ffffff"/><stop offset=".5" stop-color="#dfe8ee"/><stop offset="1" stop-color="#9fb0bb"/></linearGradient>
        <radialGradient id="pkg-dark" cx=".35" cy=".3" r=".8"><stop offset="0" stop-color="#5a4a4a"/><stop offset="1" stop-color="#1a1212"/></radialGradient>
        <linearGradient id="pkg-bin" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#8c949c"/><stop offset=".5" stop-color="#5b6066"/><stop offset="1" stop-color="#2f3337"/></linearGradient>
      </defs>`;
      const SHADOW = (cx, cy, rx) => `<ellipse cx="${cx}" cy="${cy}" rx="${rx}" ry="${rx * 0.22}" fill="#000" opacity=".28"/>`;
      const CAN3 = (x, y, w, h, band, cls = "a-wob") => `<g class="${cls}" style="transform-origin:${x + w / 2}px ${y + h}px">${SHADOW(x + w / 2, y + h + 2, w * 0.6)}<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="${w * 0.1}" fill="url(#pkg-tin)" stroke="${PK_INK}" stroke-width="2"/><rect x="${x}" y="${y + h * 0.36}" width="${w}" height="${h * 0.32}" fill="url(#${band})"/><rect x="${x + w * 0.12}" y="${y + 3}" width="${w * 0.12}" height="${h - 6}" rx="2" fill="#fff" opacity=".45"/><ellipse cx="${x + w / 2}" cy="${y}" rx="${w / 2}" ry="${w * 0.14}" fill="#eef1f3" stroke="${PK_INK}" stroke-width="2"/><ellipse cx="${x + w / 2}" cy="${y}" rx="${w * 0.34}" ry="${w * 0.08}" fill="#fff" opacity=".6"/></g>`;
      Object.assign(PK_ICON, {
        can: `${PKG}${CAN3(13, 10, 24, 34, "pkg-red")}`,
        people: `${PKG}${SHADOW(24, 45, 20)}<g class="a-bob"><circle cx="16" cy="16" r="8" fill="url(#pkg-skin)" stroke="${PK_INK}" stroke-width="1.5"/><path d="M3,42c0,-12 6,-17 13,-17s13,5 13,17z" fill="url(#pkg-blue)" stroke="${PK_INK}" stroke-width="1.5"/></g><g class="a-bob2"><circle cx="33" cy="19" r="7" fill="url(#pkg-skin)" stroke="${PK_INK}" stroke-width="1.5"/><path d="M22,42c0,-10 5,-14 11,-14s11,4 11,14z" fill="url(#pkg-red)" stroke="${PK_INK}" stroke-width="1.5"/></g>`,
        rice: `${PKG}${SHADOW(24, 44, 18)}<g class="a-pulse" style="transform-origin:24px 42px"><path d="M11,42q-7,-20 7,-27h12q14,7 7,27z" fill="url(#pkg-sack)" stroke="${PK_INK}" stroke-width="2"/><path d="M16,15q8,5 16,0" stroke="#7a5a2e" stroke-width="3" fill="none" stroke-linecap="round"/><path d="M17,13l-3,-6M31,13l3,-6" stroke="#7a5a2e" stroke-width="2.5" stroke-linecap="round"/><path d="M15,30q9,-6 18,0" stroke="#7a5a2e" stroke-width="2" fill="none" opacity=".6"/><text x="24" y="37" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="9" fill="#7a5a2e">ข้าว</text></g>`,
        radio: `${PKG}${SHADOW(24, 44, 20)}<rect x="5" y="16" width="38" height="25" rx="4" fill="url(#pkg-wood)" stroke="${PK_INK}" stroke-width="2"/><rect x="10" y="21" width="17" height="11" rx="2" fill="#1a1208"/><rect class="a-glow" x="10" y="21" width="17" height="11" rx="2" fill="url(#pkg-glow)"/><rect class="a-jit" x="17" y="22" width="1.6" height="9" fill="#ff3b30"/><circle cx="35" cy="27" r="4.5" fill="#d9c08a" stroke="${PK_INK}" stroke-width="1.5"/><path d="M31,16L42,5" stroke="${PK_INK}" stroke-width="2.5" stroke-linecap="round"/><circle cx="42" cy="5" r="2" fill="#ff3b30" class="a-pulse"/>`,
        thermo: `${PKG}${SHADOW(24, 45, 10)}<rect x="19" y="5" width="10" height="28" rx="5" fill="url(#pkg-glass)" stroke="${PK_INK}" stroke-width="2"/><rect class="a-merc" x="22" y="12" width="4" height="22" rx="2" fill="#e8302a" style="transform-origin:24px 34px"/><circle cx="24" cy="37" r="7" fill="url(#pkg-red)" stroke="${PK_INK}" stroke-width="2"/><circle cx="21.5" cy="34.5" r="2" fill="#fff" opacity=".6"/><path d="M31,12h4M31,18h3M31,24h4" stroke="${PK_INK}" stroke-width="1.5"/>`,
        water: `${PKG}${SHADOW(24, 45, 12)}<g class="a-bob"><path d="M24,5c8,12 14,18 14,26a14,14 0 0 1 -28,0c0,-8 6,-14 14,-26z" fill="url(#pkg-water)" stroke="${PK_INK}" stroke-width="2"/><ellipse cx="18" cy="26" rx="3" ry="6" fill="#fff" opacity=".55" transform="rotate(-20 18 26)"/></g>`,
        sun: `${PKG}<g class="a-spin" style="transform-origin:24px 24px"><path d="M24,3v7M24,38v7M3,24h7M38,24h7M9,9l5,5M34,34l5,5M39,9l-5,5M14,34l-5,5" stroke="#f08a2a" stroke-width="3" stroke-linecap="round"/></g><circle cx="24" cy="24" r="10" fill="url(#pkg-sun)" stroke="${PK_INK}" stroke-width="1.5"/>`,
      });
      // a looping micro-motion driver for the pk cards (classes a-*), active from t0 to t1
      function pkLoops(tl, root, t0, t1) {
        const D = Math.max(0.5, t1 - t0), rep = (p) => Math.ceil(D / p) + 1, q = (c) => root.querySelectorAll(c);
        const T = (el, from, to, p, extra = {}) => tl.fromTo(el, from, { ...to, duration: p, repeat: rep(p), yoyo: true, ease: "sine.inOut", immediateRender: false, ...extra }, t0);
        q(".a-pulse").forEach((el) => T(el, { scale: 1 }, { scale: 1.12, transformOrigin: "50% 50%" }, 0.45));
        q(".a-bob").forEach((el) => T(el, { y: -2 }, { y: 3 }, 0.6)); q(".a-bob2").forEach((el) => T(el, { y: 3 }, { y: -2 }, 0.6));
        q(".a-wob").forEach((el) => T(el, { rotation: -6 }, { rotation: 6 }, 0.7));
        q(".a-jit").forEach((el) => T(el, { x: -1.5 }, { x: 1.5 }, 0.07, { ease: "none" }));
        q(".a-merc").forEach((el) => T(el, { scaleY: 0.72 }, { scaleY: 1 }, 0.9));
        q(".a-glow").forEach((el) => T(el, { opacity: 0.35 }, { opacity: 1 }, 0.7));
        q(".a-bulge").forEach((el) => T(el, { scaleY: 1 }, { scaleY: 1.5, transformOrigin: "50% 100%" }, 0.5));
        q(".a-spin").forEach((el) => tl.fromTo(el, { rotation: 0 }, { rotation: 360, duration: 6, repeat: rep(6), ease: "none", transformOrigin: "50% 50%", immediateRender: false }, t0));
        q(".a-drip").forEach((el, i) => tl.fromTo(el, { y: 0, opacity: 1 }, { y: 18, opacity: 0, duration: 0.9, repeat: rep(0.9), ease: "power1.in", immediateRender: false }, t0 + i * 0.3));
        q(".a-rise").forEach((el, i) => tl.fromTo(el, { y: 0, opacity: 0.9 }, { y: -16, opacity: 0, duration: 0.8, repeat: rep(0.8), ease: "power1.out", immediateRender: false }, t0 + i * 0.25));
      }
      // stat chip: bigger icon tile + the loops
      {
        const base = GameUI.C.counter.anim;
        GameUI.C.counter.anim = function (tl, id, t0, o) { base.call(this, tl, id, t0, o); pkLoops(tl, document.getElementById(id), t0, o.t0abs + (o.end ?? o.t + 30)); };
      }
      {
        const base = GameUI.C.board.anim;
        GameUI.C.board.anim = function (tl, id, t0, o) { base.call(this, tl, id, t0, o); pkLoops(tl, document.getElementById(id), t0 + 0.7, o.t0abs + (o.end ?? o.t + 4)); };
      }
      // the signs on a can: three can icons that do the thing (lid doming, a drip, fizz)
      const SIGN3 = [
        `${PKG}${SHADOW(60, 104, 34)}<rect x="32" y="44" width="56" height="58" rx="6" fill="url(#pkg-tin)" stroke="${PK_INK}" stroke-width="3"/><rect x="32" y="64" width="56" height="20" fill="url(#pkg-red)"/><rect x="37" y="47" width="7" height="52" rx="2" fill="#fff" opacity=".4"/><path class="a-bulge" d="M32,44q28,-26 56,0z" fill="url(#pkg-glass)" stroke="${PK_INK}" stroke-width="3" style="transform-origin:60px 44px"/>`,
        `${PKG}${SHADOW(60, 104, 34)}<rect x="32" y="30" width="56" height="60" rx="6" fill="url(#pkg-tin)" stroke="${PK_INK}" stroke-width="3"/><rect x="32" y="50" width="56" height="20" fill="url(#pkg-blue)"/><rect x="37" y="33" width="7" height="54" rx="2" fill="#fff" opacity=".4"/><ellipse cx="60" cy="30" rx="28" ry="7" fill="#eef1f3" stroke="${PK_INK}" stroke-width="3"/><path d="M48,90q12,8 24,0" stroke="#6b4a2e" stroke-width="5" fill="none" opacity=".8"/>${[0, 1, 2].map((k) => `<path class="a-drip" d="M${56 + k * 6},92c5,8 7,13 2,16c-6,-3 -6,-8 -2,-16z" fill="#7a5a3e"/>`).join("")}`,
        `${PKG}${SHADOW(60, 104, 34)}<rect x="32" y="46" width="56" height="56" rx="6" fill="url(#pkg-tin)" stroke="${PK_INK}" stroke-width="3"/><rect x="32" y="66" width="56" height="20" fill="url(#pkg-yel)"/><rect x="37" y="49" width="7" height="50" rx="2" fill="#fff" opacity=".4"/><path d="M32,46h56" stroke="${PK_INK}" stroke-width="3"/>${[[46, 36, 7], [60, 28, 9], [76, 36, 6], [54, 18, 5], [68, 14, 6]].map(([x, y, r]) => `<circle class="a-rise" cx="${x}" cy="${y}" r="${r}" fill="#fff8e0" stroke="${PK_INK}" stroke-width="2"/>`).join("")}`,
      ];
      GameUI.C.signs = {
        html: (id, o) => `<div id="${id}" class="fsigns" style="top:${o.top ?? 170}px">${o.items.map((t, i) => `<div class="row" id="${id}-r${i}"><div class="ic"><svg viewBox="0 0 120 120" style="overflow:visible">${SIGN3[i]}</svg></div><div class="tx">${t}</div><b class="bad">✗</b></div>`).join("")}</div>`,
        anim(tl, id, t0, o) {
          o.at.forEach((at, i) => {
            tl.fromTo(`#${id}-r${i}`, { opacity: 0, x: -40 }, { opacity: 1, x: 0, duration: 0.25, ease: "power2.out", immediateRender: false }, o.t0abs + at);
            tl.fromTo(`#${id}-r${i} .ic svg`, { scale: 0, rotation: -25 }, { scale: 1, rotation: 0, duration: 0.45, ease: "back.out(2.2)", transformOrigin: "50% 50%", immediateRender: false }, o.t0abs + at + 0.05);
            tl.fromTo(`#${id}-r${i} .bad`, { opacity: 0, scale: 3 }, { opacity: 1, scale: 1, duration: 0.18, ease: "power4.in", immediateRender: false }, o.t0abs + at + 0.35);
            tl.fromTo(`#${id}-r${i}`, { x: 0 }, { x: 8, duration: 0.05, repeat: 5, yoyo: true, immediateRender: false }, o.t0abs + at + 0.5);
            pkLoops(tl, document.getElementById(`${id}-r${i}`), o.t0abs + at + 0.5, o.t0abs + (o.end ?? o.at[i] + 4));
          });
          if (o.end !== undefined) tl.to(`#${id}`, { opacity: 0, duration: 0.2 }, o.t0abs + o.end);
        },
      };
      // the tip medallions with depth (animated by GameUI's own loops: a-pulse / a-bob / a-sway)
      Object.assign(GameUI.ILL, {
        toxin: `${PKG}${SHADOW(60, 108, 34)}<circle cx="60" cy="58" r="40" fill="url(#pkg-dark)" stroke="${PK_INK}" stroke-width="3"/><ellipse cx="46" cy="40" rx="12" ry="7" fill="#fff" opacity=".18" transform="rotate(-30 46 40)"/>
          <g class="a-pulse" style="transform-origin:60px 56px"><path d="M38,46l14,14M52,46l-14,14M68,46l14,14M82,46l-14,14" stroke="#ff5a4a" stroke-width="6" stroke-linecap="round"/></g><path d="M48,78q12,-8 24,0" stroke="#f4ecd8" stroke-width="4" fill="none" stroke-linecap="round"/><path d="M52,74v8M60,76v8M68,74v8" stroke="#f4ecd8" stroke-width="3" stroke-linecap="round"/>
          <g class="a-bob"><circle cx="24" cy="22" r="7" fill="#8ff0a0" opacity=".9"/><circle cx="98" cy="18" r="5" fill="#8ff0a0" opacity=".9"/><circle cx="90" cy="34" r="3.5" fill="#8ff0a0" opacity=".9"/></g>`,
        trash: `${PKG}${SHADOW(60, 110, 34)}<path d="M30,42h60l-6,64H36z" fill="url(#pkg-bin)" stroke="${PK_INK}" stroke-width="3"/><path d="M36,45h8l-4,58" fill="#fff" opacity=".2"/><path d="M50,54v44M70,54v44" stroke="#1e1d1b" stroke-width="3" opacity=".5"/>
          <g class="a-bob"><rect x="22" y="30" width="76" height="12" rx="4" fill="url(#pkg-bin)" stroke="${PK_INK}" stroke-width="3"/><path d="M48,30v-8h24v8" fill="none" stroke="${PK_INK}" stroke-width="4"/></g>
          <g class="a-sway" style="transform-origin:60px 10px">${CAN3(46, -8, 28, 36, "pkg-red", "")}</g>`,
      });
      // the sun card: a window of sky in the cream card, the sun sliding down to a red horizon over dark hills
      GameUI.C.sunHud = {
        html: (id, o) => `<div id="${id}" class="fsun" style="top:${o.top ?? 140}px"><svg viewBox="0 0 380 150" style="border-radius:14px;overflow:hidden">${PKG}<defs><linearGradient id="${id}-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1f3657"/><stop offset=".55" stop-color="#9a5a62"/><stop offset=".86" stop-color="#f29a4a"/><stop offset="1" stop-color="#ffd37a"/></linearGradient></defs>
          <rect width="380" height="150" fill="url(#${id}-sky)"/><path d="M65,150A125,125 0 0 1 315,150" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="3" stroke-dasharray="4 10"/>
          <path d="M0,150V128L40,118L90,126L140,110L200,122L250,106L300,118L340,108L380,120V150Z" fill="#1a1412"/><path d="M0,128H380" stroke="#ff5a4a" stroke-width="3" stroke-dasharray="10 8"/>
          <g id="${id}-sun"><circle class="a-glow" r="36" fill="url(#pkg-glow)" opacity=".8"/><circle r="17" fill="url(#pkg-sun)"/></g>
          <text x="370" y="118" text-anchor="end" font-family="Kanit" font-weight="700" font-size="22" fill="#ffd6c8">มืด ${o.dark}</text></svg>
          <div class="row"><div class="tm" id="${id}-tm">${o.t0}</div><div class="lf">ก่อนมืด<b id="${id}-lf">${o.left0}</b></div></div></div>`,
        anim(tl, id, t0, o) {
          const el = document.getElementById(id), sun = document.getElementById(`${id}-sun`), tm = document.getElementById(`${id}-tm`), lf = document.getElementById(`${id}-lf`), c = { k: 0 };
          const m = (h) => { const [a, b] = h.split(":").map(Number); return a * 60 + b; };
          const A = m(o.t0), B = m(o.t1), DK = m(o.dark), dur = (o.end ?? D("gate")) - o.t;
          tl.fromTo(`#${id}`, { opacity: 0, x: 60 }, { opacity: 1, x: 0, duration: 0.3, ease: "back.out(1.6)", immediateRender: false }, t0);
          const draw = () => {
            const k = c.k, mins = A + (B - A) * k, u = (o.from ?? 0.3) + ((o.to ?? 0.95) - (o.from ?? 0.3)) * k, a = Math.PI * (1 - u);
            sun.setAttribute("transform", `translate(${(190 + Math.cos(a) * 125).toFixed(1)},${(150 - Math.sin(a) * 125).toFixed(1)})`);   // the arc fits the 150-high window (the old 180 radius put the sun above the frame)
            tm.textContent = `${String(Math.floor(mins / 60)).padStart(2, "0")}:${String(Math.floor(mins % 60)).padStart(2, "0")} น.`;
            const left = DK - mins; lf.textContent = left > 0 ? `${Math.floor(left / 60)}:${String(Math.floor(left % 60)).padStart(2, "0")} ชม.` : "เลยเวลา";
            el.classList.toggle("late", left <= 0);
          };
          tl.to(c, { k: 1, duration: dur, ease: "none", immediateRender: false, onUpdate: draw }, t0);
          draw();
          pkLoops(tl, el, t0, o.t0abs + (o.end ?? o.t + dur));
          if (o.end !== undefined) tl.to(`#${id}`, { opacity: 0, duration: 0.2 }, o.t0abs + o.end);
        },
      };
      // the source chip's badge breathes
      {
        const base = GameUI.C.src.anim;
        GameUI.C.src.anim = function (tl, id, t0, o) { base.call(this, tl, id, t0, o); tl.fromTo(`#${id} b`, { scale: 1 }, { scale: 1.18, duration: 0.5, repeat: Math.ceil(((o.end ?? o.t + 4) - o.t) / 0.5) + 1, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0); };
      }
      document.head.insertAdjacentHTML("beforeend", `<style>
        .pks .ic { width: 80px; height: 80px; border-radius: 20px; background: radial-gradient(circle at 35% 28%, #ffffff, #e6dfcd 72%); box-shadow: inset 0 -3px 0 rgba(0,0,0,.08), 0 4px 10px rgba(0,0,0,.18); }
        .pks .ic svg { width: 68px; height: 68px; overflow: visible; filter: drop-shadow(0 3px 3px rgba(0,0,0,.35)); }
        .fsigns .ic { width: 118px; height: 118px; background: radial-gradient(circle at 35% 28%, #ffffff, #e6dfcd 72%); box-shadow: inset 0 -3px 0 rgba(0,0,0,.08), 0 4px 10px rgba(0,0,0,.18); }
        .fsigns .ic svg { overflow: visible; filter: drop-shadow(0 3px 3px rgba(0,0,0,.35)); }
        .gui.tip .med { background: radial-gradient(circle at 35% 28%, #ffffff, #e6dfcd 72%); box-shadow: inset 0 -3px 0 rgba(0,0,0,.08), 0 4px 10px rgba(0,0,0,.18); } .gui.tip .med svg { overflow: visible; filter: drop-shadow(0 3px 3px rgba(0,0,0,.35)); }
        .pkt .chip svg, .pkr .ics svg { overflow: visible; filter: drop-shadow(0 2px 2px rgba(0,0,0,.3)); }
        .fsun { padding: 12px 14px 10px; } .fsun svg { height: 150px; box-shadow: inset 0 0 0 2px rgba(0,0,0,.25); }
        .fsun .tm, .fsun .lf { margin-top: 6px; }
        .zsrc b { transform-origin: 50% 50%; }
      </style>`);
