          <rect width="380" height="150" fill="url(#${id}-sky)"/><path d="M65,150A125,125 0 0 1 315,150" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="3" stroke-dasharray="4 10"/>
          <path d="M0,150V128L40,118L90,126L140,110L200,122L250,106L300,118L340,108L380,120V150Z" fill="#1a1412"/><path d="M0,128H380" stroke="#ff5a4a" stroke-width="3" stroke-dasharray="10 8"/>
          <g id="${id}-sun"><g class="a-spin" style="transform-origin:0px 0px"><path d="${Array.from({ length: 8 }, (_, k) => { const a = (k * Math.PI) / 4; return `M${(Math.cos(a) * 22).toFixed(1)},${(Math.sin(a) * 22).toFixed(1)}L${(Math.cos(a) * 34).toFixed(1)},${(Math.sin(a) * 34).toFixed(1)}`; }).join("")}" stroke="#ffcf5a" stroke-width="3" stroke-linecap="round" opacity=".7"/></g><circle class="a-glow" r="36" fill="url(#pkg-glow)" opacity=".8"/><circle r="17" fill="url(#pkg-sun)"/></g>
          <text x="370" y="118" text-anchor="end" font-family="Kanit" font-weight="700" font-size="26" fill="#ffd6c8">มืด ${o.dark}</text></svg><div class="scan"></div></div>
          <div class="row"><div class="tm" id="${id}-tm">${o.t0}</div><div class="gg">${GAUGE([PK_GREEN, PK_GOLD, "#c0352a"])}</div><div class="lf">ก่อนมืด<b id="${id}-lf">${o.left0}</b></div></div></div>`,
        anim(tl, id, t0, o) {
          const el = document.getElementById(id), sun = document.getElementById(`${id}-sun`), tm = document.getElementById(`${id}-tm`), lf = document.getElementById(`${id}-lf`), nd = el.querySelector(".nd"), c = { k: 0 };
          const m = (h) => { const [a, b] = h.split(":").map(Number); return a * 60 + b; };
          const A = m(o.t0), B = m(o.t1), DK = m(o.dark), dur = (o.end ?? D("gate")) - o.t, end = o.t0abs + (o.end ?? o.t + dur), span = Math.max(1, DK - A);
          plateFx(tl, el, t0, end, { from: "right", out: o.end !== undefined });
          const draw = () => {
            const k = c.k, el_ = k * dur, mins = A + (B - A) * k, u = (o.from ?? 0.3) + ((o.to ?? 0.95) - (o.from ?? 0.3)) * k, a = Math.PI * (1 - u);
            sun.setAttribute("transform", `translate(${(190 + Math.cos(a) * 125).toFixed(1)},${(150 - Math.sin(a) * 125).toFixed(1)})`);
            tm.textContent = `${String(Math.floor(mins / 60)).padStart(2, "0")}:${String(Math.floor(mins % 60)).padStart(2, "0")} น.`;
            const left = DK - mins; lf.textContent = left > 0 ? `${Math.floor(left / 60)}:${String(Math.floor(left % 60)).padStart(2, "0")} ชม.` : "เลยเวลา";
            el.classList.toggle("late", left <= 0);
            // the needle: flicks in from the left stop with overshoot, then follows the time, trembling
            const e = Math.min(1, Math.max(0, (el_ - 0.25) / 0.7)), ob = 1 + 2.7 * Math.pow(e - 1, 3) + 1.7 * Math.pow(e - 1, 2), target = -125 + 250 * (1 - Math.min(1, Math.max(0, left / span)));
            const ang = -125 + (target + 125) * Math.max(0, ob) + Math.sin(el_ * 57) * 1.1;
            nd.setAttribute("transform", `rotate(${ang.toFixed(2)} 48 46)`);
          };
          tl.to(c, { k: 1, duration: dur, ease: "none", immediateRender: false, onUpdate: draw }, t0); draw();
          const kl = (DK - A) / (B - A); if (kl > 0 && kl < 1) plateAlarm(tl, el, t0 + kl * dur, end);
          pkLoops(tl, el, t0, end);
        },
      };
      // ---------- captions pop in a chunk at a time: wrap space-separated chunks (keeping [..] / {..} marks whole) and stagger them after the box ----------
      Ui.caption = (id, text) => {
        const out = []; let buf = "", open = 0;
        text.split(" ").forEach((tk) => { buf = buf ? `${buf} ${tk}` : tk; open += (tk.match(/[\[{]/g) || []).length - (tk.match(/[\]}]/g) || []).length; if (open <= 0) { out.push(buf); buf = ""; open = 0; } });
        if (buf) out.push(buf);
        return `<div id="${id}" class="capbox">${out.map((w) => `<span class="w">${Ui.mark(w)}</span>`).join(" ")}</div>`;
      };
      {
        const base = Engine.build;
        Engine.build = function (root, tl, shots) {
          base(root, tl, shots);
          shots.forEach((sh, i) => (sh.captions || []).forEach((cp, k) => { const ws = document.querySelectorAll(`#s${i}-c${k} .w`);
            if (ws.length > 1) tl.fromTo(ws, { opacity: 0, y: 18, scale: 0.7 }, { opacity: 1, y: 0, scale: 1, duration: 0.18, stagger: 0.06, ease: "back.out(2.5)", immediateRender: false }, sh.start + cp.t + 0.02); }));
        };
      }

      // ======================================================================================================
      // story gimmicks in the icons: pasted-paper digits that fly off when the count drops, cans tumbling out of
      // the chip, a sixth shadow joining the head count, the rice sack deflating
      // ======================================================================================================
      document.head.insertAdjacentHTML("beforeend", `<style>
        .pdig { display: inline-flex; gap: .08em; vertical-align: top; position: relative; }
        .pd { position: relative; width: .72em; height: 1.1em; }
        .pd .sh { position: absolute; inset: 0; border-radius: .05em; display: grid; place-items: center; color: #1e1d1b; font: 900 1em/1 Kanit; letter-spacing: 0;
          background: linear-gradient(170deg, #f6efdc, #e6dcc2); box-shadow: 0 .06em .14em rgba(0,0,0,.55), inset 0 0 0 1px rgba(0,0,0,.08); transform-origin: 50% 20%; }
        .pd .sh.u { transform: rotate(2deg); background: linear-gradient(170deg, #efe6cf, #d9ceb0); }
        .pd .sh b { font-weight: 900; }
        .pd .tp { position: absolute; left: 20%; top: -.12em; width: 60%; height: .2em; background: rgba(230,214,160,.75); border-left: 1px dashed rgba(0,0,0,.2); border-right: 1px dashed rgba(0,0,0,.2); transform: rotate(-3deg); box-shadow: 0 1px 2px rgba(0,0,0,.3); }
        .tc .big { font: 900 118px/1.1 Kanit; display: flex; align-items: center; gap: 22px; justify-content: center; }
        .tc .big .pdig { font-size: 150px; }
        .tc .tag6 { position: absolute; right: 34px; top: 50%; margin-top: -40px; font: 900 64px/1 Kanit; color: ${PK_HOT}; border: 5px double ${PK_HOT}; border-radius: 10px; padding: 4px 18px 8px; transform: rotate(-8deg); opacity: 0; letter-spacing: 2px; text-shadow: 0 0 14px rgba(255,90,72,.6); }
        .mc .fall { position: absolute; left: 28px; top: 26px; width: 56px; height: 56px; z-index: 5; pointer-events: none; opacity: 0; filter: drop-shadow(0 3px 3px rgba(0,0,0,.5)); overflow: visible; }
        .mc .grain { position: absolute; left: 60px; top: 70px; width: 7px; height: 9px; border-radius: 50%; background: #f1e3b8; z-index: 5; opacity: 0; }
      </style>`);
      const PAPER = (seq) => `<span class="pd">${seq.slice().reverse().map((d, i, arr) => `<i class="sh${i < arr.length - 1 ? " u" : ""}" data-v="${d}"><b>${d}</b>${i === arr.length - 1 ? '<i class="tp"></i>' : ""}</i>`).join("")}</span>`;   // sheets stacked: first value on top
      const PAPERS = (vals) => { const strs = vals.map((v) => String(v)), n = Math.max(...strs.map((s) => s.length)); return `<span class="pdig">${Array.from({ length: n }, (_, i) => PAPER(strs.map((s) => s.padStart(n, "0")[i]))).join("")}</span>`; };
      // a sheet peels at the tape and flutters away up-right; the sheet beneath jolts
      function flyOff(tl, sh, t) {
        tl.fromTo(sh, { rotation: 0 }, { rotation: -9, duration: 0.14, yoyo: true, repeat: 1, ease: "sine.inOut", immediateRender: false }, t);
        tl.to(sh, { x: 220, y: -300, rotation: 48, opacity: 0, duration: 0.75, ease: "power2.in" }, t + 0.26);
        tl.fromTo(sh, { scaleX: 1 }, { scaleX: 0.6, duration: 0.18, yoyo: true, repeat: 3, ease: "sine.inOut", immediateRender: false }, t + 0.3);
        const under = sh.previousElementSibling; if (under) tl.fromTo(under, { rotation: 2, y: 0 }, { rotation: -2, y: 4, duration: 0.3, ease: "elastic.out(1,.4)", immediateRender: false }, t + 0.4);
      }
      const slapIn = (tl, sheets, t, gap = 0.14) => Array.from(sheets).forEach((sh, k) => { tl.fromTo(sh, { opacity: 0, scale: 2.1, rotation: -18, y: -40 }, { opacity: 1, scale: 1, rotation: 0, y: 0, duration: 0.22, ease: "power4.in", immediateRender: false }, t + k * gap);
        tl.fromTo(sh, { scaleX: 1.12, scaleY: 0.9 }, { scaleX: 1, scaleY: 1, duration: 0.45, ease: "elastic.out(1,.4)", immediateRender: false }, t + k * gap + 0.22); });
      // ---------- tear-off count plate: "เหลือ [9][9] วัน" — a sheet flies off whenever a digit changes; `tag` stamps a second number in ----------
      GameUI.C.tearCal = {
        html: (id, o) => `<div id="${id}" class="mp mb tc" style="top:${o.top ?? 150}px">${PLATE}<div class="big" id="${id}-b"><span>${o.label || "เหลือ"}</span>${PAPERS(o.keys.map((k) => k.v))}<span>${o.unit || "วัน"}</span></div>${o.tag ? `<div class="tag6" id="${id}-t">${o.tag.text}</div>${SPLAT}` : ""}</div>`,
        anim(tl, id, t0, o) {
          const el = document.getElementById(id), end = o.t0abs + (o.end ?? o.t + 6), digs = [...el.querySelectorAll(".pd")];
          plateFx(tl, el, t0, end, { from: "top", out: o.end !== undefined });
          tl.fromTo(`#${id}-b`, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.3, ease: "power3.out", immediateRender: false }, t0 + 0.25);
          slapIn(tl, el.querySelectorAll(".pd .sh:last-child"), t0 + 0.3);
          const strs = o.keys.map((k) => String(k.v)), n = Math.max(...strs.map((s) => s.length));
          o.keys.forEach((k, i) => { if (!i) return; const a = strs[i - 1].padStart(n, "0"), b = strs[i].padStart(n, "0"), T = o.t0abs + k.t;
            digs.forEach((pd, j) => { if (a[j] === b[j]) return; const top = pd.querySelector(`.sh[data-v="${a[j]}"]:last-child`) || [...pd.querySelectorAll(".sh")].reverse().find((s) => s.dataset.v === a[j]); if (top) flyOff(tl, top, T); }); });
          if (o.tag) { const T = o.t0abs + o.tag.t; tl.fromTo(`#${id}-t`, { opacity: 0, scale: 2.4, rotation: 10 }, { opacity: 1, scale: 1, rotation: -8, duration: 0.2, ease: "power4.in", immediateRender: false }, T);
            tl.fromTo(`#${id}-t`, { x: 0 }, { x: 7, duration: 0.04, repeat: 5, yoyo: true, immediateRender: false }, T + 0.2); splat(tl, el, T + 0.18); tl.fromTo(`#${id} .fl`, { opacity: 0.6 }, { opacity: 0, duration: 0.4, immediateRender: false }, T + 0.2); }
          pkLoops(tl, el, t0 + 0.5, end);
        },
      };
      // ---------- the title plate now pastes its "99" as paper sheets ----------
      {
        const base = GameUI.C.board;
        GameUI.C.board = {
          html: (id, o) => base.html(id, o).replace(FLIPS(`${id}-fl`, String(o.day), 150), `<span id="${id}-fl">${PAPERS([o.day])}</span>`),
          anim(tl, id, t0, o) { base.anim.call(this, tl, id, t0, o); const el = document.getElementById(id); slapIn(tl, el.querySelectorAll(".pd .sh:last-child"), t0 + 0.45, 0.16); },
        };
      }
      // ---------- counter gimmicks: cans tumble out, a shadow joins the head count, the sack deflates ----------
      PK_ICON.people = PK_ICON.people.replace(`<g class="a-bob2">`, `<g class="ghost" opacity="0"><circle cx="25" cy="9" r="8" fill="#1a1212" stroke="#3a2424" stroke-width="1.5"/><path d="M12,42c0,-15 5,-23 13,-23s13,8 13,23z" fill="#1a1212" stroke="#3a2424" stroke-width="1.5"/><circle cx="22" cy="8.5" r="1.9" fill="#ff3b30"/><circle cx="28" cy="8.5" r="1.9" fill="#ff3b30"/><circle cx="22" cy="8.5" r="4" fill="#ff3b30" opacity=".25"/><circle cx="28" cy="8.5" r="4" fill="#ff3b30" opacity=".25"/></g><g class="a-bob2">`);
      {
        const base = GameUI.C.counter.anim;
        GameUI.C.counter.anim = function (tl, id, t0, o) {
          base.call(this, tl, id, t0, o);
          const el = document.getElementById(id), icon = o.icon || "can";
          o.keys.forEach((b, i) => { if (!i) return; const a = o.keys[i - 1]; if (a.v === b.v) return; const tb = o.t0abs + b.t;
            if (icon === "can" && b.v < a.v) { const n = Math.min(3, Math.round(a.v - b.v)); for (let k = 0; k < n; k++) { el.insertAdjacentHTML("beforeend", `<svg class="fall" viewBox="0 0 48 48">${PK_ICON.can}</svg>`); const f = el.lastElementChild;
              tl.fromTo(f, { x: 0, y: 0, rotation: 0, opacity: 1 }, { x: 40 + k * 34, y: 320, rotation: 280 + k * 70, opacity: 0, duration: 0.95, ease: "power1.in", immediateRender: false }, tb - 0.1 + k * 0.13);
              tl.fromTo(f, { scale: 1 }, { scale: 0.7, duration: 0.95, ease: "none", immediateRender: false }, tb - 0.1 + k * 0.13); } }
            if (icon === "people" && b.v > a.v) { const g = el.querySelector(".ghost"); if (g) { [0, 0.08, 0.16, 0.3].forEach((d, k) => tl.set(g, { opacity: k % 2 ? 0 : 0.85 }, tb + d)); tl.to(g, { opacity: 1, duration: 0.3 }, tb + 0.4); tl.fromTo(g, { x: 0 }, { x: 1.5, duration: 0.06, repeat: 9, yoyo: true, immediateRender: false }, tb); } }
            if (icon === "rice" && b.v < a.v) { const sack = el.querySelector(".ic svg g"); if (sack) tl.fromTo(sack, { scaleY: 1, scaleX: 1 }, { scaleY: 0.72, scaleX: 1.14, duration: 0.5, ease: "elastic.out(1,.45)", transformOrigin: "50% 100%", immediateRender: false }, tb);
              for (let k = 0; k < 5; k++) { el.insertAdjacentHTML("beforeend", `<i class="grain"></i>`); const gr = el.lastElementChild; tl.fromTo(gr, { x: 0, y: 0, opacity: 1 }, { x: -20 + k * 11, y: 90 + (k % 2) * 30, opacity: 0, duration: 0.6, ease: "power1.in", immediateRender: false }, tb + k * 0.05); } }
          });
        };
      }


      // ---------- the series opening plate (EP.1 of every series): title, the paper "99 วัน", a red "EP.1" stamp ----------
      document.head.insertAdjacentHTML("beforeend", `<style>
        .mo { left: 50%; width: 900px; margin-left: -450px; text-align: center; padding: 36px 30px 44px; }
        .mo .ser { font: 900 96px/1.05 Kanit; color: ${PK_BONE}; letter-spacing: 2px; text-shadow: 0 2px 0 rgba(255,255,255,.1), 0 -1px 0 #000, 0 10px 24px rgba(0,0,0,.6); opacity: 0; }
        .mo .ser2 { font: 900 150px/1.1 Kanit; color: ${PK_BONE}; display: flex; justify-content: center; align-items: center; gap: 22px; margin-top: 6px; opacity: 0; }
        .mo .ser2 .pdig { font-size: 170px; }
        .mo .ep { margin-top: 18px; }
      </style>`);
      GameUI.C.openTitle = {
        html: (id, o) => `<div id="${id}" class="mp mo" style="top:${o.top ?? 520}px">${PLATE}<div class="ser" id="${id}-s">${o.series}</div><div class="ser2" id="${id}-b">${PAPERS([o.days])}<span>วัน</span></div><div class="ep">${STAMP2(o.ep, "big")}</div></div>`,
        anim(tl, id, t0, o) {
          const el = document.getElementById(id), end = o.t0abs + (o.end ?? o.t + 3);
          plateFx(tl, el, t0, end, { from: "top", out: o.end !== undefined });
          tl.fromTo(`#${id}-s`, { opacity: 0, y: -30, scale: 1.3 }, { opacity: 1, y: 0, scale: 1, duration: 0.35, ease: "power3.out", immediateRender: false }, t0 + 0.25);
          tl.fromTo(`#${id}-b`, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.3, ease: "power3.out", immediateRender: false }, t0 + 0.35);
          slapIn(tl, el.querySelectorAll(".pd .sh:last-child"), t0 + 0.45, 0.16);
          slam2(tl, el, t0 + 0.95, { punch: el, rot: -5 });
          pkLoops(tl, el, t0 + 0.6, end);
        },
      };
