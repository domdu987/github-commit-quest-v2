      // ======================================================================================================
      // เอาชีวิตรอด 99 วัน · EP.7 (ใหม่) "เสียงเรียกฝูง" — the same night as EP.6's cliff: the trucks, the torches, the horde
      // ======================================================================================================
      const put = (el, html) => el.insertAdjacentHTML("beforeend", html);
      const ZF = (L, tl, pre, t0, dur, list, mode = "shamble", y = 1180) => list.forEach(([w, x, s, ph, flip], k) => behind(L, tl, `${pre}-z${k}`, w, x, y, s, flip ?? true, t0, dur, [{ t: 0, mode, eyes: "dead", mouth: "snarl", opts: { period: 1.9 + ph } }]));
      const CLIP = (list) => { list.sort((a, b) => a.t - b.t); for (let n = 0; n + 1 < list.length; n++) list[n].end = Math.min(list[n].end, list[n + 1].t - 0.03); return list; };
      const split3 = (k, a1, a2, A, B, C) => {
        add(k, A); shots[shots.length - 1].dur = a1;
        add(k, B); let sh = shots[shots.length - 1]; sh.start = SH[k].start + a1; sh.dur = a2 - a1; sh.vo = (SH[k].vo || []).map((v) => ({ ...v, t: v.t - a1 }));
        add(k, C); sh = shots[shots.length - 1]; sh.start = SH[k].start + a2; sh.dur = D(k) - a2; sh.vo = (SH[k].vo || []).map((v) => ({ ...v, t: v.t - a2 }));
      };
      const capsAt = (k, a, b, lines, o) => caps(k, lines, o).filter((c) => c.end > a + 0.05 && c.t < b - 0.05).map((c) => ({ ...c, t: Math.max(0, c.t - a), end: Math.min(b - a - 0.03, c.end - a) }));
      const bubAt = (bb, a, b) => ({ ...bb, t: Math.max(0.02, bb.t - a), end: Math.min(b - a - 0.05, bb.end - a) });
      const FA = (k, a, i = 0, j = 0) => F(k, i, j) - a;
      const VA = (k, a, i = 0) => vo(k, i) - a;
      const GD = (x, y, s, track, extra = {}) => ({ who: "guard", x, y, s, track, ...extra });
      const HA = (who, x, y, s, track, extra = {}) => ({ who, x, y, s, blinks: [], track, ...extra });
      const NOBLINK = { blinks: [] };
      // looking out from the roof, a hand shading the eyes
      Rig.MODES.lookOut = (u, o) => ({ ...Rig.MODES.idle(u, o), head: -6 + Math.sin(u * 0.8), torso: -4, uaF: -120, faF: -60, uaB: 10, faB: -20 });
      // GSAP x/y on an element with a transform attribute replaces it: wrap it in a plain group and move the wrapper
      const wrapEl = (sel) => { const a = document.querySelector(sel), w = document.createElementNS("http://www.w3.org/2000/svg", "g"); a.parentNode.insertBefore(w, a); w.appendChild(a); return w; };
      // the sandbags along the canopy edge (the guard's nest), and the five rules painted on the canopy face
      const BAGS = (xs) => `<g>${xs.map((x) => `<rect x="${x}" y="692" width="130" height="74" rx="20" fill="#a5895a" stroke="#2e2a26" stroke-width="4"/>`).join("")}</g>`;
      const RULEWALL = (id) => `<g id="${id}-rules" transform="translate(-620,790)">${["1 เงียบ", "2 อยู่สูง", "3 เดินตอนแดด", "4 กักน้ำฝน", "5 ห้ามถือไฟ"].map((t, k) => `<text x="${k * 390}" y="60" font-family="Kanit" font-weight="900" font-size="62" fill="#c8392b" opacity=".92" transform="rotate(${-1 + (k % 2) * 2} ${k * 390} 60)">${t}</text>`).join("")}</g>`;
      // the trucks on the forecourt at night: two pickups facing left with headlight cones and a horn speaker on the first cab
      const HEADLIGHTS = (id, x, y) => `<g id="${id}"><path d="M${x},${y}L${x - 1500},${y - 260}L${x - 1500},${y + 220}Z" fill="#fff6d0" opacity=".42"/><circle cx="${x}" cy="${y}" r="40" fill="#fff6d0" opacity=".9"/></g>`;
      const HORN = (x, y) => `<g transform="translate(${x},${y})"><path d="M0,0l-70,-30v60z" fill="#3a3f45" stroke="#2e2a26" stroke-width="3"/><rect x="-10" y="-14" width="30" height="28" rx="6" fill="#5b6066" stroke="#2e2a26" stroke-width="3"/></g>`;

      // ---------- icons for this episode's cards (120-space) ----------
      const I3 = `stroke="${PK_INK}" stroke-width="3"`;
      const RIC = {
        quiet: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<circle cx="60" cy="58" r="34" fill="#f3d6b8" ${I3}/><path d="M46,52q4,4 8,0M66,52q4,4 8,0" stroke="${PK_INK}" stroke-width="3" fill="none" stroke-linecap="round"/><path d="M44,74h32" stroke="${PK_INK}" stroke-width="4" stroke-linecap="round"/><g class="a-wob" style="transform-origin:78px 86px"><path d="M78,60v26" stroke="#f3d6b8" stroke-width="12" stroke-linecap="round"/><path d="M78,60v26" stroke="${PK_INK}" stroke-width="2" fill="none"/></g>`,
        high: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<path d="M20,100V40h80v60" fill="#e8e2d4" ${I3}/><rect x="20" y="30" width="80" height="14" fill="#c8392b" ${I3}/><g class="a-bob"><circle cx="60" cy="22" r="9" fill="#f3d6b8" ${I3}/><path d="M60,31v16M50,40h20" stroke="${PK_INK}" stroke-width="4" stroke-linecap="round"/></g><path d="M40,100V60M46,100V60M40,70h6M40,82h6M40,94h6" stroke="#8d9299" stroke-width="3"/>`,
        sun: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<circle class="a-spin" style="transform-origin:60px 50px" cx="60" cy="50" r="22" fill="#f2c55c" ${I3}/><path d="M60,10v12M60,78v12M20,50h12M88,50h12M32,22l8,8M80,78l8,8M88,22l-8,8M32,78l8,-8" stroke="#e8a030" stroke-width="4" stroke-linecap="round"/>`,
        rain: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<path d="M34,50h52l-6,52H40z" fill="#2f6fb8" ${I3}/><path d="M38,60h44M40,76h40" stroke="#9fc0e0" stroke-width="3"/><g class="a-rise"><path d="M50,20v16M60,14v22M70,20v16" stroke="#7ab0e0" stroke-width="4" stroke-linecap="round"/></g>`,
        nolight: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<rect x="48" y="40" width="24" height="60" rx="6" fill="#3a3f45" ${I3}/><path d="M44,40h32l6,-16H38z" fill="#5b6066" ${I3}/><path d="M24,24L96,100" stroke="#c8392b" stroke-width="8" stroke-linecap="round"/>`,
        down: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<path d="M20,30h80" stroke="#8d9299" stroke-width="6"/><g class="a-bob"><path d="M60,36v44M46,66l14,16l14,-16" stroke="#c8392b" stroke-width="8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></g><path d="M20,100h80" stroke="#8d9299" stroke-width="6"/>`,
      };

      // the station at night, straight on from EP.5: the group under the canopy, the guard on the roof edge
      const NIGHT = (id, extra = {}) => ({ set: "station", setOpts: { id, time: "night", lampX: 300 }, dark: 0.5, blur: { far: 5 }, ...extra });
      const GROUP = (o = {}) => [HO(120, 1520, 0.9, o.ho || [{ t: 0, mode: "sit", eyes: "worry", mouth: "frown" }], { prop: "ledger", cu: false }),
        KS(380, 1520, 0.9, o.ks || [{ t: 0, mode: "sitLeg", eyes: "sad", mouth: "flat" }], { prop: "spear1", cu: false }),
        PI(620, 1520, 0.9, o.pi || [{ t: 0, mode: "sit", eyes: "worry", mouth: "flat" }], { flip: true, cu: false }),
        PH(860, 1520, 0.9, o.ph || [{ t: 0, mode: "sit", eyes: "squint", mouth: "flat" }], { flip: true, cu: false }),
        PU(-80, 1520, 0.55, o.pu || [{ t: 0, mode: "sleepSit", eyes: "closed", mouth: "flat" }], { cu: false })];

      // คุณวิน's men (the EP.5 guard's rig in the estate's dark blue) and rule six for the wall
      Rig.CAST.man1 = { ...Rig.CAST.guard, top: "#2c3e6b", topS: "#1f2d4e", sleeve: "#2c3e6b", sleeveS: "#1f2d4e" };
      Rig.CAST.man2 = { ...Rig.CAST.guard, top: "#3a3f45", topS: "#2a2e33", sleeve: "#3a3f45", sleeveS: "#2a2e33", skin: "#b07a52", skinS: "#8f5f3c" };
      const M1 = (x, y, s, track, extra = {}) => ({ who: "man1", x, y, s, track, ...extra });
      const M2 = (x, y, s, track, extra = {}) => ({ who: "man2", x, y, s, track, ...extra });
      const RULE6 = (id) => `<g id="${id}-rule6" transform="translate(1330,790)"><text x="0" y="60" font-family="Kanit" font-weight="900" font-size="62" fill="#c8392b" opacity=".95" transform="rotate(-2 0 60)">6 ไฟ = เหยื่อ</text></g>`;
      // a hand torch beam from an actor's hand toward (tx, ty): a soft cone in the glow layer
      const BEAM = (id, x, y, tx, ty, op = 0.5) => { const dx = tx - x, dy = ty - y, L2 = Math.hypot(dx, dy), nx = -dy / L2 * 70, ny = dx / L2 * 70; return `<g id="${id}" opacity="${op}"><path d="M${x},${y}L${tx + nx},${ty + ny}L${tx - nx},${ty - ny}Z" fill="#fff6d0"/><circle cx="${tx}" cy="${ty}" r="60" fill="#fff6d0" opacity=".5"/></g>`; };
      const RAIN = (L, o) => Fence.rain(L, o);

      // ---------- 1. hook: the trucks' lights seen from the roof; the flash of the swarm on the headlights ----------
      split("hook", vo("hook", 1) - 0.1, {
        ...NIGHT("hk", { dark: 0.55 }), cu: false,
        cam: { keys: [{ t: 0, ...fr(700, 900, 0.95, 540, 1000), drift: { s: 0.025 } }] },
        actors: [PI(400, 762, 0.75, [{ t: 0, mode: "lookOut", eyes: "wide", mouth: "o" }], { flip: true }), KS(760, 762, 0.75, [{ t: 0, mode: "point", eyes: "wide", mouth: "o" }], { prop: "spear1", flip: true }),
          PH(560, 762, 0.75, [{ t: 0, mode: "idle", eyes: "squint", mouth: "flat" }], { flip: true }), HO(220, 762, 0.75, [{ t: 0, mode: "sit", eyes: "worry", mouth: "frown" }]), PU(120, 762, 0.5, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }])],
        captions: capsAt("hook", 0, vo("hook", 1) - 0.1, [0]),
        fx(tl, id, t0, L) { put(L.set, RULEWALL("hk")); put(L.act, BAGS([620, 740, 900])); put(L.mid, `<g id="hk-tr">${Road.TRUCK("hk-t1", { col: "#3a3f45" })}</g>`); document.getElementById("hk-tr").setAttribute("transform", "translate(1500,1240) scale(-0.9,0.9)"); put(L.glow, HEADLIGHTS("hk-hl", 1150, 1100)); Fx.heart(tl, t0, D("hook"), 0.5, 0.6); },
      }, {
        ...NIGHT("hk2", { dark: 0.55 }), cu: false,
        cam: { keys: [{ t: 0, ...fr(1150, 1250, 1.15, 540, 1000), drift: { s: 0.04 } }] },
        shake: (t) => 3 * Math.sin(t * 8.3) + 1.5 * Math.sin(t * 15),
        captions: capsAt("hook", vo("hook", 1) - 0.1, D("hook"), [1]),
        actors: [HA("ha1", 1250, 1540, 0.95, [{ t: 0, mode: "lunge", eyes: "dead", mouth: "snarl" }], { flip: true, cast: false }), HA("ha3", 1500, 1540, 0.9, [{ t: 0, mode: "lunge", eyes: "dead", mouth: "snarl", opts: { period: 1.1 } }], { cast: false }),
          M1(1380, 1540, 0.9, [{ t: 0, mode: "torch", eyes: "wide", mouth: "scream", torch: true }, { t: 1.2, mode: "handsUp", eyes: "wide", mouth: "scream" }], { cu: false })],
        fx(tl, id, t0, L) {
          put(L.mid, `<g id="hk2-tr">${Road.TRUCK("hk2-t1", { col: "#3a3f45" })}</g>`); document.getElementById("hk2-tr").setAttribute("transform", "translate(1500,1240) scale(-0.9,0.9)"); put(L.glow, HEADLIGHTS("hk2-hl", 1150, 1100));
          ZF(L, tl, "hk2", t0, D("hook") - (vo("hook", 1) - 0.1), [["ha2", 900, 0.62, 0.3, false], ["ha1", 1100, 0.6, 0.1, false], ["ha3", 1700, 0.64, 0.5], ["ha2", 1900, 0.6, 0.7]], "zrun", 1180);
          const X = t0 + FA("hook", vo("hook", 1) - 0.1, 1, 2); impact(tl, id, L, X, 1380, 1300, 0.7); Fx.punch(tl, `#${id} .stage`, X, 1.08, 0.5); Fx.glitch(tl, `#${id}`, X, 0.2, 12, 77); red(tl, X, 0.6, 0.6);
          tl.fromTo("#hk2-hl", { opacity: 1 }, { opacity: 0.2, duration: 0.08, repeat: 9, yoyo: true, immediateRender: false }, X); Fx.heart(tl, t0, D("hook") - (vo("hook", 1) - 0.1), 0.42, 0.8);
        },
      });

      // ---------- 2. the count to ten: the loudspeaker; rule two is for the dead; "ปิดไฟทุกดวง… นิ่ง" — the lamp goes out ----------
      split("count", vo("count", 1) - 0.2, {
        ...NIGHT("ct", { dark: 0.5 }), cu: false,
        cam: { keys: [{ t: 0, ...fr(1100, 1200, 1.1, 540, 1000), drift: { s: 0.03 } }] },
        shake: (t) => 1.5 * Math.sin(t * 6.1),
        captions: capsAt("count", 0, vo("count", 1) - 0.2, [0], { quote: true }),
        actors: [M1(1000, 1540, 0.9, [{ t: 0, mode: "torch", eyes: "squint", mouth: "flat", torch: true }], { cu: false }), M2(1200, 1540, 0.9, [{ t: 0, mode: "torch", eyes: "squint", mouth: "flat", torch: true }], { flip: true, cu: false }),
          GD(760, 1540, 0.9, [{ t: 0, mode: "aim", eyes: "squint", mouth: "frown" }], { prop: "rifle", cu: false })],
        fx(tl, id, t0, L) {
          put(L.mid, `<g id="ct-tr">${Road.TRUCK("ct-t1", { col: "#3a3f45" })}</g>`); document.getElementById("ct-tr").setAttribute("transform", "translate(1600,1240) scale(-0.9,0.9)"); put(L.glow, HEADLIGHTS("ct-hl", 1250, 1100)); put(L.act, HORN(1320, 990));
          put(L.glow, BEAM("ct-b1", 1000, 1360, 700, 900, 0.45) + BEAM("ct-b2", 1200, 1360, 1000, 800, 0.4));
          document.querySelectorAll(`#${id} .capbox`).forEach((c) => c.classList.add("radio"));
          Fx.punch(tl, `#${id} .stage`, t0 + F("count", 0, 2), 1.05, 0.4); Fx.heart(tl, t0, vo("count", 1) - 0.2, 0.45, 0.7);
        },
      }, {
        ...NIGHT("ct2", { dark: 0.6 }),
        cam: { keys: [{ t: 0, ...fr(560, 700, 1.5, 540, 900), drift: { s: 0.025 } }] },
        actors: [PH(560, 762, 0.75, [{ t: 0, mode: "idle", eyes: "squint", mouth: "flat" }, { t: 0.2, mode: "point", eyes: "squint", mouth: "flat" }], { flip: true }),
          PI(400, 762, 0.75, [{ t: 0, mode: "lookOut", eyes: "worry", mouth: "flat" }, { t: VA("count", vo("count", 1) - 0.2, 1) + 1.6, mode: "stopHand", eyes: "squint", mouth: "flat" }], { flip: true }),
          KS(760, 762, 0.75, [{ t: 0, mode: "guard", eyes: "wide", mouth: "o" }], { prop: "spear1", flip: true, cu: false }), HO(220, 762, 0.75, [{ t: 0, mode: "sit", eyes: "worry", mouth: "frown" }], { cu: false }), PU(120, 762, 0.5, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }], { cu: false })],
        bubbles: [bubAt(bub("count", 1, 440, 400, 560, { br: true }), vo("count", 1) - 0.2, D("count"))],
        ui: [{ type: "signs", t: FA("count", vo("count", 1) - 0.2, 1, 2) + 0.9, items: ["ปิดไฟทุกดวง", "<em>นิ่ง</em>"], icons: [RIC.nolight, RIC.quiet], ok: [1, 1], at: [FA("count", vo("count", 1) - 0.2, 1, 2) + 0.9, FA("count", vo("count", 1) - 0.2, 1, 2) + 1.3], end: D("count") - (vo("count", 1) - 0.2) - 0.05, top: 150 }],
        fx(tl, id, t0, L) {
          put(L.set, RULEWALL("ct2")); put(L.act, BAGS([620, 740, 900])); put(L.glow, HEADLIGHTS("ct2-hl", 1500, 1000));
          // the hurricane lamp goes out on "นิ่ง": the glow layer's lamp fades, the shot darkens
          const T = t0 + FA("count", vo("count", 1) - 0.2, 1, 2) + 1.3; tl.to("#ct2-lamp", { opacity: 0, duration: 0.3, immediateRender: false }, T); tl.to(`#${id} .stage`, { filter: "brightness(0.55)", duration: 0.4, immediateRender: false }, T);
          Fx.heart(tl, t0, D("count") - (vo("count", 1) - 0.2), 0.45, 0.7);
        },
      });

      // ---------- 3. adapted eyes: the dark yard rises out of the black; the men below are blind outside their beams ----------
      add("dark", {
        ...NIGHT("dk", { dark: 0.7, blur: { far: 3 } }), cu: false,
        cam: { keys: [{ t: 0, ...fr(900, 1250, 1.0, 540, 1000), drift: { s: 0.02 } }] },
        captions: caps("dark"),
        actors: [M1(1000, 1540, 0.9, [{ t: 0, mode: "torch", eyes: "squint", mouth: "flat", torch: true }], { cu: false }), M2(1250, 1540, 0.9, [{ t: 0, mode: "torch", eyes: "squint", mouth: "flat", torch: true }], { flip: true, cu: false }),
          GD(760, 1540, 0.9, [{ t: 0, mode: "aim", eyes: "squint", mouth: "frown" }], { prop: "rifle", cu: false })],
        fx(tl, id, t0, L) {
          put(L.glow, BEAM("dk-b1", 1000, 1360, 600, 1200, 0.5) + BEAM("dk-b2", 1250, 1360, 1500, 1250, 0.45)); put(L.glow, HEADLIGHTS("dk-hl", 1600, 1100));
          tl.fromTo("#dk-b1", { rotation: -10, transformOrigin: "1000px 1360px" }, { rotation: 14, duration: 1.3, yoyo: true, repeat: 5, ease: "sine.inOut", immediateRender: false }, t0);
          // what the adapted eye sees: the black lifts a little over the shot (the viewer is on the roof)
          tl.fromTo(`#${id} .stage`, { filter: "brightness(0.35)" }, { filter: "brightness(0.9)", duration: D("dark") - 0.5, ease: "power1.inOut", immediateRender: false }, t0);
          Fx.heart(tl, t0, D("dark"), 0.5, 0.6);
        },
      });

      // ---------- 4. what followed the engines arrives before ten; "ข้างหลัง! ส่องไปข้างหลัง!" ----------
      add("arrive", {
        ...NIGHT("ar", { dark: 0.55, blur: { far: 2 } }), cu: false,
        cam: { keys: [{ t: 0, ...fr(1000, 1250, 0.95, 540, 1000), drift: { s: 0.03 } }, { t: F("arrive", 0, 1) - 0.2, glide: 0.4, ...fr(1150, 1300, 1.3, 540, 1000), drift: { s: 0.04 } }] },
        shake: (t) => 2 * Math.sin(t * 7.3),
        captions: caps("arrive", [0]),
        actors: [GD(760, 1540, 0.9, [{ t: 0, mode: "aim", eyes: "squint", mouth: "frown" }, { t: F("arrive", 0, 1) - 0.3, mode: "point", eyes: "wide", mouth: "scream" }], { prop: "rifle", cu: false }),
          M1(1000, 1540, 0.9, [{ t: 0, mode: "torch", eyes: "squint", mouth: "flat", torch: true }, { t: F("arrive", 0, 1), mode: "torch", eyes: "wide", mouth: "o", torch: true }], { cu: false }), M2(1250, 1540, 0.9, [{ t: 0, mode: "torch", eyes: "squint", mouth: "flat", torch: true }, { t: F("arrive", 0, 1) + 0.2, mode: "torch", eyes: "wide", mouth: "scream", torch: true }], { flip: true, cu: false }),
          HA("ha2", 2100, 1540, 0.95, [{ t: 0, mode: "zrun", eyes: "dead", mouth: "snarl" }], { flip: true, moveTo: { x: 1500, dur: D("arrive") - 0.4, ease: "none" }, cast: false }), HA("ha3", 2300, 1545, 0.9, [{ t: 0, mode: "zrun", eyes: "dead", mouth: "snarl", opts: { period: 1.1 } }], { flip: true, moveTo: { x: 1700, dur: D("arrive") - 0.2, ease: "none" }, cast: false })],
        fx(tl, id, t0, L) {
          put(L.mid, `<g id="ar-tr">${Road.TRUCK("ar-t1", { col: "#3a3f45" })}</g>`); document.getElementById("ar-tr").setAttribute("transform", "translate(1600,1240) scale(-0.9,0.9)"); put(L.glow, HEADLIGHTS("ar-hl", 1250, 1100));
          ZF(L, tl, "ar", t0, D("arrive"), [["ha1", 1300, 0.6, 0, false], ["ha2", 1560, 0.62, 0.3, false], ["ha3", 1820, 0.6, 0.5, false], ["ha1", 2080, 0.58, 0.2, false]], "zrun", 1180);
          put(L.glow, BEAM("ar-b1", 1000, 1360, 600, 1200, 0.45)); const bw = wrapEl("#ar-b1"); tl.to(bw, { rotation: -150, transformOrigin: "1000px 1360px", duration: 0.4, ease: "power2.inOut", immediateRender: false }, t0 + F("arrive", 0, 1) + 0.2);
          const X = t0 + F("arrive", 0, 1); Fx.punch(tl, `#${id} .stage`, X, 1.08, 0.4); red(tl, X, 0.5, 0.6); Fx.heart(tl, t0, D("arrive"), 0.4, 0.85);
        },
      });

      // ---------- 5. every torch turns to them, and they turn to every torch; on the roof: "มันไม่มองเราเลย" / "ปล่อยให้แสงพาไป" ----------
      split("lights", vo("lights", 1) - 0.2, {
        ...NIGHT("lt", { dark: 0.55, blur: { far: 2 } }), cu: false,
        cam: { keys: [{ t: 0, ...fr(1100, 1300, 1.1, 540, 1000), drift: { s: 0.035 } }] },
        shake: (t) => 2.5 * Math.sin(t * 8.1),
        captions: capsAt("lights", 0, vo("lights", 1) - 0.2, [0]),
        actors: [M1(1000, 1540, 0.9, [{ t: 0, mode: "torch", eyes: "wide", mouth: "scream", torch: true }], { cu: false }), M2(1300, 1540, 0.9, [{ t: 0, mode: "torch", eyes: "wide", mouth: "scream", torch: true }], { flip: true, cu: false }),
          HA("ha2", 1700, 1540, 0.95, [{ t: 0, mode: "zrun", eyes: "dead", mouth: "snarl" }, { t: 1.6, mode: "lunge", eyes: "dead", mouth: "snarl" }], { flip: true, moveTo: { x: 1420, dur: 1.6, ease: "none" }, cast: false }),
          HA("ha1", 500, 1540, 0.92, [{ t: 0, mode: "zrun", eyes: "dead", mouth: "snarl", opts: { period: 1.1 } }, { t: 1.9, mode: "lunge", eyes: "dead", mouth: "snarl" }], { moveTo: { x: 880, dur: 1.9, ease: "none" }, cast: false })],
        fx(tl, id, t0, L) {
          put(L.mid, `<g id="lt-tr">${Road.TRUCK("lt-t1", { col: "#3a3f45" })}</g>`); document.getElementById("lt-tr").setAttribute("transform", "translate(1600,1240) scale(-0.9,0.9)"); put(L.glow, HEADLIGHTS("lt-hl", 1250, 1100));
          put(L.glow, BEAM("lt-b1", 1000, 1360, 560, 1300, 0.5) + BEAM("lt-b2", 1300, 1360, 1700, 1300, 0.5));
          ZF(L, tl, "lt", t0, vo("lights", 1) - 0.2, [["ha3", 1400, 0.6, 0.1, false], ["ha2", 1900, 0.62, 0.4, false], ["ha1", 2150, 0.58, 0.7, false]], "zrun", 1180);
          const X = t0 + F("lights", 0, 1); impact(tl, id, L, X + 1.5, 900, 1320, 0.6); Fx.punch(tl, `#${id} .stage`, X, 1.06, 0.4); red(tl, X + 1.5, 0.5, 0.5); Fx.heart(tl, t0, vo("lights", 1) - 0.2, 0.4, 0.85);
        },
      }, {
        ...NIGHT("lt2", { dark: 0.62 }),
        cam: { keys: [{ t: 0, ...fr(600, 700, 1.5, 540, 900), drift: { s: 0.025 } }] },
        actors: [KS(760, 762, 0.75, [{ t: 0, mode: "guard", eyes: "wide", mouth: "o" }], { prop: "spear1", flip: true }), PI(400, 762, 0.75, [{ t: 0, mode: "stopHand", eyes: "squint", mouth: "flat" }], { flip: true }),
          PH(560, 762, 0.75, [{ t: 0, mode: "crouch", eyes: "squint", mouth: "flat" }], { flip: true, cu: false }), HO(220, 762, 0.75, [{ t: 0, mode: "sit", eyes: "closed", mouth: "frown" }], { cu: false }), PU(120, 762, 0.5, [{ t: 0, mode: "crouch", eyes: "wide", mouth: "o" }], { cu: false })],
        bubbles: [bubAt(bub("lights", 1, 380, 420, 400, { br: true }), vo("lights", 1) - 0.2, D("lights"))],
        fx(tl, id, t0, L) { put(L.set, RULEWALL("lt2")); put(L.act, BAGS([620, 740, 900])); put(L.glow, HEADLIGHTS("lt2-hl", 1500, 1000)); tl.set("#lt2-lamp", { opacity: 0 }, t0); Fx.heart(tl, t0, D("lights") - (vo("lights", 1) - 0.2), 0.45, 0.7); },
      });

      // ---------- 6. the ladder: the guard climbs (they cannot), claws under him; ภู hauls him over the edge; "เพราะเรานับได้หก" ----------
      split("ladder", vo("ladder", 1) - 0.2, {
        ...NIGHT("la", { dark: 0.58, blur: { far: 3 } }), cu: false,
        cam: { keys: [{ t: 0, ...fr(1250, 1050, 1.35, 540, 1000), drift: { s: 0.03 } }] },
        shake: (t) => 2 * Math.sin(t * 7.7),
        captions: capsAt("ladder", 0, vo("ladder", 1) - 0.2, []),
        bubbles: [bubAt(bub("ladder", 0, 860, 420, 1200, { br: true }), 0, vo("ladder", 1) - 0.2)],
        actors: [PH(1200, 762, 0.75, [{ t: 0, mode: "crouch", eyes: "squint", mouth: "flat" }, { t: 0.4, mode: "reach", eyes: "squint", mouth: "grit" }], { flip: true, cu: false }),
          GD(1320, 1540, 0.9, [{ t: 0, mode: "run", eyes: "wide", mouth: "scream" }, { t: 0.6, mode: "reachUp", eyes: "wide", mouth: "o" }], { cu: false, moveTo: { x: 1320, y: 1540, dur: 0.1 } }),
          HA("ha1", 1600, 1540, 0.95, [{ t: 0, mode: "zrun", eyes: "dead", mouth: "snarl" }, { t: 1.0, mode: "lunge", eyes: "dead", mouth: "snarl" }], { flip: true, moveTo: { x: 1430, dur: 1.0, ease: "none" }, cast: false }),
          HA("ha2", 1050, 1540, 0.92, [{ t: 0, mode: "zrun", eyes: "dead", mouth: "snarl", opts: { period: 1.1 } }, { t: 1.4, mode: "lunge", eyes: "dead", mouth: "snarl" }], { moveTo: { x: 1230, dur: 1.4, ease: "none" }, cast: false })],
        fx(tl, id, t0, L) {
          // the guard goes up the ladder (the rig slides up the rungs), the claws reach the bottom rung and no further
          const gw = wrapEl(`#${id}-a1`); tl.to(gw, { y: -700, duration: 1.6, ease: "power1.inOut", immediateRender: false }, t0 + 0.6);
          put(L.glow, HEADLIGHTS("la-hl", 1700, 1100)); Fx.punch(tl, `#${id} .stage`, t0 + 1.0, 1.05, 0.4); Fx.heart(tl, t0, vo("ladder", 1) - 0.2, 0.4, 0.85);
        },
      }, {
        ...NIGHT("la2", { dark: 0.6 }),
        cam: { keys: [{ t: 0, ...fr(1000, 700, 1.5, 540, 900), drift: { s: 0.025 } }] },
        actors: [GD(1180, 762, 0.75, [{ t: 0, mode: "sit", eyes: "closed", mouth: "o" }, { t: 0.5, mode: "sit", eyes: "worry", mouth: "o" }], { cu: false }),
          PH(1000, 762, 0.75, [{ t: 0, mode: "crouch", eyes: "squint", mouth: "flat" }], { flip: true, cu: false }), PI(780, 762, 0.75, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: VA("ladder", vo("ladder", 1) - 0.2, 2), mode: "idle", eyes: "squint", mouth: "flat", look: 8 }], { flip: true }),
          KS(560, 762, 0.75, [{ t: 0, mode: "guard", eyes: "squint", mouth: "flat" }], { prop: "spear1", flip: true, cu: false })],
        bubbles: [bubAt(bub("ladder", 1, 760, 420, 1180, { br: true, end: vo("ladder", 2) - 0.05 }), vo("ladder", 1) - 0.2, D("ladder")), bubAt(bub("ladder", 2, 560, 400, 780, { br: true }), vo("ladder", 1) - 0.2, D("ladder"))],
        react: [{ a: 0, t: VA("ladder", vo("ladder", 1) - 0.2, 2) + 0.9, dur: 1.2 }],
        fx(tl, id, t0, L) { put(L.set, RULEWALL("la2")); put(L.act, BAGS([620, 740, 900])); tl.set("#la2-lamp", { opacity: 0 }, t0); put(L.glow, HEADLIGHTS("la2-hl", 1500, 1000)); Fx.heart(tl, t0, D("ladder") - (vo("ladder", 1) - 0.2), 0.55, 0.5); },
      });

      // ---------- 7. the trucks: "ถอย… ถอย!" — two trucks, two pairs of lights, one loudspeaker: everything a horde wants; the lights die one by one ----------
      add("trucks", {
        ...NIGHT("tr", { dark: 0.55, blur: { far: 2 } }), cu: false,
        cam: { keys: [{ t: 0, ...fr(1300, 1250, 0.9, 540, 1000), drift: { s: 0.03 } }, { t: vo("trucks", 0) + 1.0, glide: 1.2, ...fr(1300, 1150, 1.1, 540, 1000), drift: { s: 0.02 } }] },
        shake: (t) => 3 * Math.sin(t * 9.3) + 1.5 * Math.sin(t * 17),
        captions: caps("trucks", [0]),
        actors: [HA("ha1", 1150, 1540, 0.95, [{ t: 0, mode: "lunge", eyes: "dead", mouth: "snarl" }], { cast: false }), HA("ha2", 1450, 1540, 0.92, [{ t: 0, mode: "lunge", eyes: "dead", mouth: "snarl", opts: { period: 1.3 } }], { flip: true, cast: false }),
          HA("ha3", 1300, 1560, 0.98, [{ t: 0, mode: "zrun", eyes: "dead", mouth: "snarl" }, { t: 0.8, mode: "lunge", eyes: "dead", mouth: "snarl" }], { moveTo: { x: 1320, dur: 0.8 }, cast: false })],
        fx(tl, id, t0, L) {
          put(L.mid, `<g id="tr-tr">${Road.TRUCK("tr-t1", { col: "#3a3f45" })}</g><g id="tr-tr2">${Road.TRUCK("tr-t2", { col: "#2f3b4a" })}</g>`); document.getElementById("tr-tr").setAttribute("transform", "translate(1600,1240) scale(-0.9,0.9)"); document.getElementById("tr-tr2").setAttribute("transform", "translate(2100,1230) scale(-0.82,0.82)");
          put(L.glow, `${HEADLIGHTS("tr-hl1", 1250, 1100)}${HEADLIGHTS("tr-hl2", 1750, 1090)}`); put(L.act, HORN(1320, 990));
          ZF(L, tl, "tr", t0, D("trucks"), [["ha2", 1500, 0.62, 0.3, false], ["ha1", 1750, 0.6, 0.1, false], ["ha3", 2000, 0.64, 0.5, false], ["ha2", 2250, 0.6, 0.7, false], ["ha1", 1000, 0.58, 0.9, false]], "lunge", 1180);
          const X = t0 + 0.25; Fx.punch(tl, `#${id} .stage`, X, 1.08, 0.5); Fx.glitch(tl, `#${id}`, X + 0.1, 0.2, 12, 51); red(tl, X, 0.6, 0.6);
          // the lights go out one by one over the narration
          const T1 = t0 + F("trucks", 0, 1) + 0.6; tl.to("#tr-hl2", { opacity: 0, duration: 0.15, immediateRender: false }, T1); tl.to("#tr-hl1", { opacity: 0, duration: 0.15, immediateRender: false }, T1 + 1.1);
          tl.to(`#${id} .stage`, { filter: "brightness(0.45)", duration: 0.6, immediateRender: false }, T1 + 1.1);
          Fx.heart(tl, t0, D("trucks"), 0.4, 0.85);
        },
      });

      // ---------- 8. dawn: no trucks, no lights, no sound; the guard's lie; เจ๊หงส์'s message ----------
      split("dawn", vo("dawn", 1) - 0.3, {
        set: "station", setOpts: { id: "dw", time: "dusk", sunX: 1500 }, dark: 0.22, blur: { far: 3 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(700, 1150, 0.85, 540, 1000), drift: { s: 0.015 } }] },
        captions: capsAt("dawn", 0, vo("dawn", 1) - 0.3, [0]),
        fx(tl, id, t0, L) {
          put(L.set, RULEWALL("dw")); put(L.act, BAGS([620, 740, 900]));
          // the wrecked trucks, doors open, glass out, no one in them
          put(L.mid, `<g id="dw-tr">${Road.TRUCK("dw-t1", { col: "#3a3f45" })}</g><g id="dw-tr2">${Road.TRUCK("dw-t2", { col: "#2f3b4a" })}</g>`); document.getElementById("dw-tr").setAttribute("transform", "translate(1500,1240) rotate(-6) scale(-0.9,0.9)"); document.getElementById("dw-tr2").setAttribute("transform", "translate(2000,1230) scale(-0.82,0.82)");
          put(L.set, `<path d="M1240,1300q60,-20 120,10M1400,1330q80,-30 160,0" stroke="#5a1a14" stroke-width="14" stroke-linecap="round" fill="none" opacity=".55"/>`);
          tl.fromTo(`#${id} .stage`, { opacity: 0.3 }, { opacity: 1, duration: 0.6, immediateRender: false }, t0); Fx.heart(tl, t0, vo("dawn", 1) - 0.3, 0.9, 0.25);
        },
      }, {
        set: "station", setOpts: { id: "dw2", time: "dusk", sunX: 1500 }, dark: 0.22, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(700, 700, 1.3, 540, 900), drift: { s: 0.02 } }] },
        actors: [GD(1100, 762, 0.75, [{ t: 0, mode: "idle", eyes: "sad", mouth: "flat" }, { t: 0.2, mode: "point", eyes: "squint", mouth: "flat", look: -8 }], { flip: true }),
          PI(780, 762, 0.75, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }], { flip: true, cu: false }), HO(420, 762, 0.75, [{ t: 0, mode: "sit", eyes: "squint", mouth: "flat" }, { t: VA("dawn", vo("dawn", 1) - 0.3, 2), mode: "sit", eyes: "squint", mouth: "smile", look: 10 }], { prop: "ledger" }),
          KS(600, 762, 0.75, [{ t: 0, mode: "guard", eyes: "normal", mouth: "flat" }, { t: VA("dawn", vo("dawn", 1) - 0.3, 2) + 1.2, mode: "idle", eyes: "squint", mouth: "smileOpen" }], { prop: "spear1", flip: true, cu: false }), PU(260, 762, 0.5, [{ t: 0, mode: "idle", eyes: "normal", mouth: "smile" }], { cu: false })],
        bubbles: [bubAt(bub("dawn", 1, 760, 400, 1100, { br: true, end: vo("dawn", 2) - 0.05 }), vo("dawn", 1) - 0.3, D("dawn")), bubAt(bub("dawn", 2, 520, 420, 420, { br: true }), vo("dawn", 1) - 0.3, D("dawn"))],
        react: [{ a: 3, t: VA("dawn", vo("dawn", 1) - 0.3, 2) + 1.2, dur: 1.1, fast: true }],
        fx(tl, id, t0, L) { put(L.set, RULEWALL("dw2")); put(L.act, BAGS([620, 740, 900])); Fx.heart(tl, t0, D("dawn") - (vo("dawn", 1) - 0.3), 0.9, 0.25); },
      });

      // ---------- 9. rule six on the wall: ปั้น paints it; the card ----------
      add("rule6", {
        set: "station", setOpts: { id: "r6", time: "dusk", sunX: 1500 }, dark: 0.2, blur: { far: 3 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(1150, 860, 1.25, 540, 900), drift: { s: 0.015 } }] },
        actors: [PU(1240, 762, 0.5, [{ t: 0, mode: "reachUp", eyes: "normal", mouth: "smile" }], { flip: true, prop: "marker" })],
        captions: caps("rule6"),
        ui: [{ type: "signs", t: F("rule6", 0, 1), items: ["เงียบ", "อยู่สูง", "เดินตอนแดด", "กักน้ำฝน", "ห้ามถือไฟตอนกลางคืน", "คนที่ถือไฟ = <em>เหยื่อล่อ</em>"], icons: [RIC.quiet, RIC.high, RIC.sun, RIC.rain, RIC.nolight, RIC.nolight], ok: [1, 1, 1, 1, 1, 1],
          at: [F("rule6", 0, 1), F("rule6", 0, 1) + 0.12, F("rule6", 0, 1) + 0.24, F("rule6", 0, 1) + 0.36, F("rule6", 0, 1) + 0.48, F("rule6", 0, 2) + 0.2], end: D("rule6") - 0.05, top: 120 }],
        fx(tl, id, t0, L) { put(L.set, RULEWALL("r6")); put(L.set, RULE6("r6")); tl.fromTo("#r6-rule6", { opacity: 0 }, { opacity: 1, duration: 0.3, immediateRender: false }, t0 + F("rule6", 0, 2)); put(L.act, BAGS([620, 740, 900])); Fx.heart(tl, t0, D("rule6"), 0.8, 0.3); },
      });

      // ---------- 10. twenty days later: rain every night; the radio counts them as nought; "ดี" ----------
      split("later", vo("later", 1) - 0.4, {
        ...NIGHT("lr", { dark: 0.6, blur: { far: 4 } }), cu: false,
        cam: { keys: [{ t: 0, ...fr(600, 800, 1.1, 540, 950), drift: { s: 0.02 } }] },
        captions: capsAt("later", 0, vo("later", 1) - 0.4, [0]),
        actors: [PI(400, 762, 0.75, [{ t: 0, mode: "sit", eyes: "normal", mouth: "flat" }], { flip: true }), KS(760, 762, 0.75, [{ t: 0, mode: "sitLeg", eyes: "squint", mouth: "flat" }], { prop: "spear1", flip: true }), PH(560, 762, 0.75, [{ t: 0, mode: "sit", eyes: "squint", mouth: "flat" }], { flip: true }),
          HO(220, 762, 0.75, [{ t: 0, mode: "sit", eyes: "worry", mouth: "frown" }], { prop: "ledger" }), PU(120, 762, 0.5, [{ t: 0, mode: "sleepSit", eyes: "closed", mouth: "flat" }])],
        fx(tl, id, t0, L) { put(L.set, RULEWALL("lr")); put(L.set, RULE6("lr")); put(L.act, BAGS([620, 740, 900])); RAIN(L, { n: 110, op: 0.5 }); tl.set("#lr-lamp", { opacity: 0.4 }, t0); Fx.heart(tl, t0, vo("later", 1) - 0.4, 0.8, 0.3); },
      }, {
        set: "radioClose", setOpts: { id: "ra7" }, dark: 0.55,
        cam: { keys: [{ t: 0, ...fr(540, 1000, 1.0, 540, 960), drift: { s: 0.02 } }, { t: VA("later", vo("later", 1) - 0.4, 2) - 0.2, ...fr(400, 900, 1.5, 540, 960), drift: { s: 0.03 } }] },
        captions: capsAt("later", vo("later", 1) - 0.4, D("later"), [1], { quote: true }),
        bubbles: [bubAt(bub("later", 2, 540, 1500, 400, { up: true, br: true }), vo("later", 1) - 0.4, D("later"))],
        ui: [{ type: "tearCal", t: 0.1, end: D("later") - (vo("later", 1) - 0.4) - 0.05, top: 150, label: "เหลือ", unit: "วัน", keys: [{ t: 0.1, v: 84 }, { t: FA("later", vo("later", 1) - 0.4, 1, 1), v: 64 }], tag: { t: FA("later", vo("later", 1) - 0.4, 1, 2), text: "· ศูนย์" } }],
        fx(tl, id, t0) {
          const on = t0 + 0.1;
          tl.fromTo(["#ra7-dialw", "#ra7-glow"], { opacity: 0 }, { opacity: 1, duration: 0.05, repeat: 5, yoyo: true, immediateRender: false }, on); tl.set(["#ra7-dialw", "#ra7-glow"], { opacity: 1 }, on + 0.3);
          tl.fromTo("#ra7-needle", { x: 0 }, { x: 180, duration: 0.6, ease: "power1.inOut", immediateRender: false }, on + 0.1);
          document.querySelectorAll(`#${id} .capbox`).forEach((c) => c.classList.add("radio"));
          const X = t0 + FA("later", vo("later", 1) - 0.4, 1, 2); Fx.punch(tl, `#${id} .stage`, X, 1.08, 0.5); Fx.glitch(tl, `#${id}`, X, 0.2, 10, 71); red(tl, X, 0.6, 0.7);
          Fx.heart(tl, t0, D("later") - (vo("later", 1) - 0.4), 0.55, 0.5);
        },
      });



      // ---------- 13. the cliff: ปั้น's question in the storm; below the roof, more of them than ever, standing in the rain; black ----------
      add("cliff", {
        ...NIGHT("cl", { dark: 0.62, blur: { far: 3 } }), cu: false,
        cam: { keys: [{ t: 0, ...fr(300, 760, 1.4, 540, 900), drift: { s: 0.02 } }, { t: vo("cliff", 0) + 2.2, glide: 1.4, ...fr(700, 1150, 0.85, 540, 1000), drift: { s: 0.03 } }] },
        shake: (t) => 1.5 * Math.sin(t * 5.3),
        actors: [PU(120, 762, 0.5, [{ t: 0, mode: "idle", eyes: "worry", mouth: "flat" }, { t: vo("cliff", 0), mode: "lookUp", eyes: "worry", mouth: "o" }]), PI(300, 762, 0.75, [{ t: 0, mode: "sit", eyes: "normal", mouth: "flat" }, { t: vo("cliff", 0) + 1.5, mode: "sit", eyes: "worry", mouth: "flat", look: -10 }], { flip: true, cu: false }),
          HO(500, 762, 0.75, [{ t: 0, mode: "sit", eyes: "worry", mouth: "frown" }], { cu: false })],
        bubbles: [bub("cliff", 0, 420, 400, 120, { br: true })],
        fx(tl, id, t0, L) {
          put(L.set, RULEWALL("cl")); put(L.set, RULE6("cl")); put(L.act, BAGS([620, 740, 900])); RAIN(L, { n: 130, op: 0.55 }); tl.set("#cl-lamp", { opacity: 0.3 }, t0);
          ZF(L, tl, "cl", t0, D("cliff"), [["ha1", -300, 0.62, 0, false], ["ha2", -60, 0.6, 0.3, false], ["ha3", 200, 0.64, 0.5, false], ["ha1", 460, 0.6, 0.2, false], ["ha2", 720, 0.58, 0.7, false], ["ha3", 980, 0.62, 0.1, false], ["ha1", 1240, 0.6, 0.4, false], ["ha2", 1500, 0.56, 0.9, false], ["ha3", 1760, 0.6, 0.6, false]], "shamble", 1180);
          const X = t0 + D("cliff") - 1.4; Fx.punch(tl, `#${id} .stage`, X, 1.04, 0.4); red(tl, X, 0.4, 0.6); tl.set("#black", { opacity: 1 }, t0 + D("cliff") - 0.08);
          Fx.heart(tl, t0, D("cliff"), 0.5, 0.7);
        },
      });

      // ---------- 11. sig ----------
      add("sig", {
        ...NIGHT("sg", { dark: 0.6, blur: { far: 10, set: 8, mid: 8 } }),
        cam: { keys: Sig.cam(F, fr(400, 1100, 0.8, 540, 960)) }, shake: Sig.shake(F),
        captions: caps("sig"),
        ui: [Sig.ui(F, "เหลือ 64 วัน · กฎโลกซอมบี้", [["ปิดไฟ นิ่ง", true], ["ปล่อยให้แสงพาไป", true], ["มันปีนบันไดไม่เป็น", true], ["???", false]], D("sig"))],
        fx(tl, id, t0) { tl.set("#black", { opacity: 0 }, t0); Sig.fx(tl, id, t0, F, D("sig")); },
      });

      // ---------- ตอนที่ 8: the tease and the CTA ----------
      add("next", {
        ...NIGHT("nx", { dark: 0.75, blur: { far: 10, set: 8, mid: 8 } }), cu: false,
        cam: { keys: [{ t: 0, ...fr(560, 1100, 0.85, 540, 960), drift: { s: 0.01 } }] },
        ui: [{ type: "nextCard", t: 0.1, big: "ตอนที่ 8", tag: "วิทยุบอกว่าศูนย์… ฝนหยุด แล้วทุกตัวในทุ่ง หยุดเดิน · กดติดตาม แล้วมารอดวันที่ 0 ไปด้วยกัน", end: 3.5 }],
        fx(tl, id, t0) { tl.set("#black", { opacity: 0 }, t0); Fx.heart(tl, t0, D("next"), 0.7, 0.4); tl.set("#black", { opacity: 1 }, t0 + D("next") - 0.06); },
      });

      // ---------- 14. end: black ----------
      add("end", { ...NIGHT("en", { dark: 1 }), cu: false, cam: { keys: [{ t: 0, ...fr(560, 1100, 0.85, 540, 960) }] }, fx(tl, id, t0) { tl.set("#black", { opacity: 1 }, t0); } });

      // no source cards on screen (user, 26 Oct 2026)
      shots.forEach((sh) => { if (sh.ui) sh.ui = sh.ui.filter((u) => u.type !== "src"); });

      // ---------- the look ----------
      const DUSKS = (L) => { Fence.light(L, 1500, 1000, 900, "#ff9a40", 0.5); Fence.haze(L, 1180, 400, "#ffb070", 0.28); };
      const NIGHTS = (L) => { Fence.light(L, 300, 1100, 520, "#ffd58a", 0.5, "lampf"); Fence.haze(L, 1180, 400, "#5a6f90", 0.3); };
      const TRUCKL = (L) => { Fence.light(L, 1250, 1100, 700, "#fff6d0", 0.55); Fence.haze(L, 1180, 400, "#5a6f90", 0.3); };
      const DARKL = (L) => { Fence.haze(L, 1180, 400, "#2a3550", 0.35); };
      const LOOK = {
        "hook#0": TRUCKL, "hook#1": TRUCKL, "count#0": TRUCKL, "count#1": TRUCKL, dark: TRUCKL, arrive: TRUCKL, "lights#0": TRUCKL, "lights#1": DARKL, "ladder#0": TRUCKL, "ladder#1": DARKL, trucks: TRUCKL,
        "dawn#0": DUSKS, "dawn#1": DUSKS, rule6: DUSKS, "later#0": DARKL, "later#1": (L) => { Fence.depth(L, "post", { x: -200, w: 300, op: 0.85 }); }, cliff: DARKL, sig: NIGHTS, next: NIGHTS, end: () => {},
      };
      const seen = {}, depth0 = Fence.depth;
      shots.forEach((sh) => { const n = seen[sh.key] = (seen[sh.key] ?? -1) + 1, look = LOOK[`${sh.key}#${n}`] || (n === 0 ? LOOK[sh.key] : null), e = sh.extra;
        if (look) sh.extra = (L, id) => { if (e) e(L, id); const k0 = (sh.cam && sh.cam.keys && sh.cam.keys[0]) || { x: 0, y: 0, s: 1 }; Fence.depth = (L2, kind, o = {}) => depth0(L2, kind, { cam: k0, ...o }); look(L, id); Fence.depth = depth0; }; });
      shots.forEach((sh) => { const f = sh.fx; sh.fx = (tl, id, t0, L) => { if (f) f(tl, id, t0, L); Zom.zlife(tl, `#${id}`, t0, sh.dur); Fence.flife(tl, `#${id}`, t0, sh.dur); }; });
