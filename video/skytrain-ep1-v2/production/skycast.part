      // ---------- ซอมบี้รถไฟฟ้า: the cast (rig v2) ----------
      //   may      เมย์ 24, office worker ("คุณ"): high ponytail, a light-blue shirt, navy skirt, the staff lanyard, a backpack strap, black flats
      //   nat      นัท 17, her cousin: a yellow hoodie, white over-ear headphones round the neck, a phone on a selfie stick (props), jeans, sneakers
      //   cherd    ลุงเชิด 63, retired metro technician: a grey work shirt with a patch, a navy cap, a grey moustache, a toolbox (prop)
      //   suit     the man in the suit, 40: black suit, loose red tie, slick hair
      //   staffZ   the station staff turned: navy uniform + orange vest, grey skin, milky eyes (eyes "dead"), no blood
      //   zOffice / zStudent / zAuntie  passengers turned: grey-green skin, torn sleeves, no blood
      //   rescue   a line staff on the walkway: orange vest, hard hat with a lamp, a torch
      // poses: hold (back against a door, arms spread) · press (an arm out to the wall at shoulder height: the bell) · yank (both hands
      //   high on a lever, leaning back) · grabArm (holding someone's forearm, leaning back) · slamZ (zombie: both palms forward, punching)
      //   · film (exists) · gasp (hands on knees, panting) · hug · torchWalk
      (function () {
        const C = Rig.CAST, LN = "#3a2622", ln = (w = 2.6) => `stroke="${LN}" stroke-width="${w}" stroke-linejoin="round" stroke-linecap="round"`;
        const pony = (h) => `<path d="M-50,-548C-56,-604 -26,-628 2,-628C32,-628 58,-604 50,-548Q46,-586 4,-592Q-38,-588 -50,-548Z" fill="${h.c}" ${ln()}/><path d="M-26,-616Q4,-626 30,-612" stroke="${h.sh}" stroke-width="5" fill="none" opacity=".5"/>`;
        const ponyB = () => `<path d="M30,-618Q78,-612 70,-560Q66,-520 84,-480Q50,-500 46,-548Q42,-590 24,-606Z" fill="#1c1410" ${ln()}/><circle cx="34" cy="-612" r="9" fill="#e8603a" ${ln(2)}/>`;
        const lanyard = `<path d="M-30,-488L-4,-400M30,-488L4,-400" stroke="#2f6fd0" stroke-width="5"/><rect x="-16" y="-402" width="32" height="42" rx="4" fill="#fdfaf2" ${ln(2)}/><rect x="-10" y="-394" width="20" height="10" fill="#7ab0e0"/>
          <path d="M-48,-478L-40,-300" stroke="#3a3f4a" stroke-width="12"/>`;
        C.may = { v2: { skin: "#ebc19c", iris: "#3a2016", lash: true, blush: 0.6, lip: "#c8525a", w: 0.96, headScale: 1.1,
          hair: { c: "#1c1410", s: "#08060a", sh: "#6a5446", front: (x) => pony(x.hair), back: ponyB },
          top: { kind: "coat", c: "#9cc4ec", sleeve: "long" }, print: lanyard,
          bottom: { kind: "sarong", c: "#1d2c5e", band: "#1d2c5e" }, feet: { kind: "boot", c: "#1a1a1e" } } };
        const fringe = (h) => `<path d="M-52,-546C-58,-604 -26,-630 4,-630C36,-630 60,-602 52,-546Q48,-570 36,-578Q20,-560 6,-576Q-8,-560 -24,-576Q-36,-562 -52,-546Z" fill="${h.c}" ${ln()}/>`;
        const hood = `<path d="M-46,-490Q0,-450 46,-490L40,-462Q0,-430 -40,-462Z" fill="#e0a820" ${ln(2)}/><path d="M-12,-450v40M12,-450v40" stroke="#fdfaf2" stroke-width="4"/>
          <path d="M-40,-482Q0,-452 40,-482" stroke="#f4f4f0" stroke-width="9" fill="none"/><rect x="-52" y="-494" width="18" height="30" rx="8" fill="#f4f4f0" ${ln(2)}/><rect x="34" y="-494" width="18" height="30" rx="8" fill="#f4f4f0" ${ln(2)}/>
          <rect x="-34" y="-330" width="68" height="40" rx="10" fill="#e0a820" ${ln(2)}/>`;
        const natV2 = { skin: "#d9a07a", iris: "#2a1a12", blush: 0.5, headScale: 1.14, w: 1.0,
          hair: { c: "#1a1412", s: "#060406", sh: "#5a4a40", front: (x) => fringe(x.hair) },
          top: { kind: "coat", c: "#f4c430", sleeve: "long" }, print: hood,
          bottom: { kind: "jeans", c: "#3b4a63" }, feet: { kind: "sneaker", c: "#f2f0ea", sole: "#3a3530", lace: "#8a8e94" } };
        C.nat = { v2: natV2 };
        // headphones ON (noise-cancelling, he hears nothing): the band over the head, the cups on the ears, a blue light
        const cups = `<path d="M-58,-552C-62,-646 62,-646 58,-552" stroke="#f4f4f0" stroke-width="12" fill="none"/><path d="M-58,-552C-62,-646 62,-646 58,-552" stroke="${LN}" stroke-width="2" fill="none" opacity=".5"/>
          <rect x="-72" y="-576" width="24" height="48" rx="11" fill="#f4f4f0" ${ln(2.4)}/><rect x="48" y="-576" width="24" height="48" rx="11" fill="#f4f4f0" ${ln(2.4)}/><circle cx="-60" cy="-548" r="4" fill="#3ad0ff"/>`;
        C.natPhones = { v2: { ...natV2, print: hood.replace(/<path d="M-40,-482Q0,-452 40,-482"[^>]*\/>/, "").replace(/<rect x="-52" y="-494"[^>]*\/>/, "").replace(/<rect x="34" y="-494"[^>]*\/>/, ""), faceTop: cups } };
        const cap = `<path d="M-56,-566C-58,-628 58,-628 56,-566Z" fill="#1d2c5e" ${ln(2.6)}/><path d="M20,-572Q76,-574 92,-560Q60,-552 18,-556Z" fill="#14204a" ${ln(2.4)}/><circle cy="-602" r="6" fill="#f4c430"/>`;
        C.cherd = { v2: { skin: "#c8946a", iris: "#2a1a12", blush: 0.3, headScale: 1.08, w: 1.04, bags: true, brow: "#d8d4cc",
          hair: { c: "#d8d4cc", s: "#8a8680", sh: "#ffffff", front: () => `<path d="M-50,-540Q-54,-570 -46,-580M50,-540Q54,-570 46,-580" stroke="#d8d4cc" stroke-width="10" stroke-linecap="round"/>` },
          faceTop: cap, extra: `<path d="M-22,-520Q0,-530 22,-520Q12,-510 0,-514Q-12,-510 -22,-520Z" fill="#d8d4cc" ${ln(1.6)}/>`,
          top: { kind: "coat", c: "#7a8490", sleeve: "long" }, print: `<rect x="14" y="-450" width="30" height="20" rx="3" fill="#e8603a" ${ln(1.4)}/><path d="M-6,-490V-260" stroke="#5a626e" stroke-width="3"/>${[-450, -400, -350, -300].map((y) => `<circle cx="-12" cy="${y}" r="4" fill="#d8d4cc"/>`).join("")}`,
          bottom: { kind: "trousers", c: "#3a3f4a" }, feet: { kind: "boot", c: "#2a221c" } } };
        const slick = (h) => `<path d="M-50,-548C-54,-606 -20,-626 4,-626C34,-626 58,-606 50,-548Q44,-590 -10,-592Q-34,-584 -50,-548Z" fill="${h.c}" ${ln()}/><path d="M-30,-610Q10,-622 40,-604" stroke="${h.sh}" stroke-width="6" fill="none" opacity=".6"/>`;
        C.suit = { v2: { skin: "#e0b088", iris: "#2a1a12", blush: 0.3, headScale: 1.06, w: 1.06, bags: true,
          hair: { c: "#141010", s: "#000", sh: "#6a6a7a", front: (x) => slick(x.hair) },
          top: { kind: "coat", c: "#24262e", sleeve: "long" }, print: `<path d="M-14,-490L-6,-420H6L14,-490Z" fill="#f6f4ee"/><path d="M-4,-470L4,-470L10,-330L0,-318L-10,-330Z" fill="#c8302a" ${ln(1.6)} transform="rotate(8,0,-470)"/><path d="M-30,-488L-6,-420M30,-488L6,-420" stroke="#14161c" stroke-width="5"/>`,
          bottom: { kind: "trousers", c: "#24262e" }, feet: { kind: "boot", c: "#0e0e10" } } };
        // the turned: grey-green skin; torn hems; no blood
        const torn = (c) => `<path d="M-50,-300l12,22l10,-18l12,20l10,-16l12,18l10,-20l14,22l10,-18" stroke="${c}" stroke-width="6" fill="none"/><path d="M-20,-430l10,30M24,-380l-8,26" stroke="#3a3f3a" stroke-width="3" opacity=".6"/>`;
        const zBase = (o) => ({ skin: o.skin || "#9aa88e", iris: "#c8d0c0", blush: 0, headScale: 1.1, w: o.w || 1.0, bags: true, brow: "#4a5444",
          hair: { c: o.hair || "#2a2420", s: "#0a0808", sh: "#5a5048", front: (x) => o.front ? o.front(x) : slick(x.hair) },
          top: { kind: "coat", c: o.top, sleeve: "long" }, print: (o.print || "") + torn("#2a2e2a"),
          bottom: { kind: o.bottom || "trousers", c: o.bc || "#3a3f4a", band: o.bc }, feet: { kind: "boot", c: "#1a1a1e" } });
        C.staffZ = { v2: zBase({ top: "#1d2c5e", print: `<path d="M-50,-486L-56,-300H-10L-14,-480ZM50,-486L56,-300H10L14,-480Z" fill="#ff7a1a" ${ln(2.2)}/><path d="M-54,-380h40M14,-380h40" stroke="#e8f0f4" stroke-width="6"/>`, front: (x) => cap }) };
        C.zOffice = { v2: zBase({ top: "#e8e4dc", skin: "#a4b096", bc: "#2a2e3a", print: `<path d="M-4,-470L4,-470L10,-330L0,-318L-10,-330Z" fill="#2f5fa8" ${ln(1.4)}/>` }) };
        C.zStudent = { v2: zBase({ top: "#f6f6f2", skin: "#9aa890", bottom: "sarong", bc: "#1d2c5e", hair: "#1a1410", front: (x) => pony(x.hair), print: `<path d="M-20,-490L0,-460L20,-490" stroke="#1d2c5e" stroke-width="6" fill="none"/>` }) };
        C.zAuntie = { v2: zBase({ top: "#c8507a", skin: "#a0ac94", bottom: "sarong", bc: "#5a3a6a", hair: "#3a3030", w: 1.08 }) };
        C.rescue = { v2: { skin: "#c88a5a", iris: "#2a1a12", blush: 0.4, headScale: 1.1, w: 1.06,
          hair: { c: "#1a1410", s: "#000", sh: "#4a3a30", front: () => "" },
          faceTop: `<path d="M-58,-560C-64,-640 64,-640 58,-560Z" fill="#f4c430" ${ln(2.6)}/><path d="M-62,-560H62" stroke="#c89a20" stroke-width="8"/><circle cx="0" cy="-600" r="12" fill="#fffbe0" ${ln(2)}/>`,
          top: { kind: "coat", c: "#1d2c5e", sleeve: "long" }, print: `<path d="M-50,-486L-56,-300H-10L-14,-480ZM50,-486L56,-300H10L14,-480Z" fill="#ff7a1a" ${ln(2.2)}/><path d="M-54,-380h40M14,-380h40" stroke="#e8f0f4" stroke-width="6"/>`,
          bottom: { kind: "trousers", c: "#1d2c5e" }, feet: { kind: "boot", c: "#2a221c" } } };
        const M = Rig.MODES;
        M.hold = (u, o) => { const j = Math.sin(u * 13) * 3; return { ...M.idle(u, o), torso: -12 + j, head: -6 + j, uaF: -100 - j * 2, faF: -10, uaB: 100 + j * 2, faB: 10, thF: 14, shF: 6, thB: -18, shB: 10, bodyY: 10 }; };
        M.press = (u, o) => ({ ...M.idle(u, o), torso: 6, head: -2, uaF: -86, faF: -4, uaB: 14, faB: -30 });
        M.yank = (u, o) => { const j = Math.sin(u * 12) * 6; return { ...M.idle(u, o), torso: -18 + j * 0.5, head: -10, uaF: -150 + j, faF: -20, uaB: -140 - j, faB: -24, thF: 18, shF: 10, thB: -20, shB: 14, bodyY: 12 }; };
        M.grabArm = (u, o) => { const j = Math.sin(u * 11) * 4; return { ...M.idle(u, o), torso: -14 + j * 0.4, head: -6, uaF: -78 + j, faF: -10, uaB: -60 - j, faB: -20, thF: 16, shF: 8, thB: -16, shB: 10, bodyY: 10 }; };
        M.slamZ = (u, o) => { const p = Math.max(0, Math.sin(u * 15)), q = Math.max(0, Math.sin(u * 15 + 2)); return { ...M.idle(u, o), torso: 14 + 4 * p, head: 16, uaF: -92 + 18 * p, faF: -12 - 20 * p, uaB: -80 + 18 * q, faB: -16 - 20 * q, bodyY: 4 }; };
        M.gasp = (u, o) => { const b = Math.sin(u * 7) * 3; return { ...M.idle(u, o), torso: 34 + b, head: 10 + b, uaF: 24, faF: -20, uaB: 18, faB: -24, thF: -10, shF: 20, thB: -14, shB: 18, bodyY: 40 }; };
        M.hug = (u, o) => ({ ...M.idle(u, o), torso: 6 + Math.sin(u * 2), head: 8, uaF: -64, faF: -70, uaB: -40, faB: -80 });
        M.torchWalk = (u, o) => ({ ...M.walk(u, o), uaF: -70, faF: -6 });
        M.bob = (u, o) => { const b = Math.sin(u * 9); return { ...M.idle(u, o), head: 6 * b, torso: 2 * b, uaF: -20, faF: -60 + 6 * b, uaB: 10, faB: -20, bodyY: -3 * Math.abs(b) }; };
        M.hugPole = (u, o) => { const j = Math.sin(u * 12) * 2; return { ...M.idle(u, o), torso: 10 + j, head: 4, uaF: -70 + j, faF: -70, uaB: -60 - j, faB: -80, thF: 6, shF: 10, thB: -10, shB: 8 }; };
        M.shrink = (u, o) => { const j = Math.sin(u * 14) * 2; return { ...M.idle(u, o), torso: -16 + j, head: -10, uaF: -120 + j * 2, faF: -110, uaB: -100, faB: -120, thF: 20, shF: 30, thB: -6, shB: 20, bodyY: 30 }; };
        M.strapLook = (u, o) => ({ ...M.idle(u, o), torso: -4, head: -8 + 2 * Math.sin(u * 3), uaF: -168, faF: -10, uaB: 8, faB: -16 });
        M.reachLever = (u, o) => { const j = Math.sin(u * 10) * 3; return { ...M.idle(u, o), torso: 12 + j * 0.3, head: -4, uaF: -84 + j, faF: -24, uaB: 20, faB: -30, thF: 10, shF: 6, thB: -14, shB: 8 }; };
        M.turnZ = (u, o) => ({ ...M.idle(u, o), torso: 10 + 2 * Math.sin(u * 3), head: 18 + 4 * Math.sin(u * 2.3), uaF: 12, faF: -6, uaB: 8, faB: -4 });
      })();
