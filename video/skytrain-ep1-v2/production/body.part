          put(L.set, `<g transform="translate(${GX + 70},${TF - 380}) rotate(80)"><g id="cn-hand">${Sky.zPalm("cn-hp", 0.42)}</g></g>`);
          tl.fromTo("#cn-hand", { x: -60, rotation: -20, svgOrigin: "0 0" }, { x: 30, rotation: 10, svgOrigin: "0 0", duration: 0.3, yoyo: true, repeat: Math.ceil(D("bend") / 0.3), ease: "sine.inOut", immediateRender: false }, t0 + 0.3);
          tl.fromTo("#cn-gap", { scaleX: 0.2, svgOrigin: `${GX + 52} 0` }, { scaleX: 1, svgOrigin: `${GX + 52} 0`, duration: 0.5, ease: "power3.out", immediateRender: false }, t0 + F("bend", 0, 1)); } });
