      // ---------- 18. outside: the train slows into a dark station (silence before the doors) ----------
      add("arrive", { set: "viaduct", setOpts: { id: "va", time: "night", trainX: -1200, power: false }, dark: 0.12, light: false, grade: { top: "#3a4a6a", bottom: "#05060c", op: 0.25 }, blur: { far: 1.5, mid: 0.6, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(700, 900, 0.85, 540, 900) }] },
        fx(tl, id, t0, L) { tl.fromTo("#va-train", { x: -500 }, { x: 0, duration: D("arrive"), ease: "power3.out", immediateRender: false }, t0); } });
      // ---------- 19. out: the doors open, everyone pours onto the platform; เมย์ on her knees ----------
      add("out", { set: "platform", setOpts: { id: "po", closed: true, dim: true, signX: 1500 }, dark: 0.1, light: DEAD, grade: GDEAD,
