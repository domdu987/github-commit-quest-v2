        actors: [A("suit", 160, 1500 + 120, S, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }], { moveTo: { x: -300, y: 1500 + 160, dur: 1.4, ease: "power1.out" } }),
          A("nat", 440, 1500 + 100, S, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }, { t: 0.9, mode: "gasp", eyes: "closed", mouth: "o" }], { moveTo: { x: 250, y: 1500 + 170, dur: 0.9, ease: "power2.out" } }),
          A("may", 640, 1500 + 100, S, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }, { t: 0.8, mode: "gasp", eyes: "closed", mouth: "smile" }], { moveTo: { x: 560, y: 1500 + 210, dur: 0.8, ease: "power2.out" }, talk: [TALK("out", 0, "smile")] }),
          A("cherd", 980, 1500 + 70, S * 0.9, [{ t: 0, mode: "walk", eyes: "worry", mouth: "flat" }], { flip: true, moveTo: { x: 900, y: 1500 + 110, dur: 1.2, ease: "power1.out" } })],
        captions: caps("out", undefined, QUO),
