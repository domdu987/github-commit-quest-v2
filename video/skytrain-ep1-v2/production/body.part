        actors: [A("staffZ", 1400, 1500 + 130, S, [{ t: 0, mode: "turnZ", eyes: "closed", mouth: "flat" }]), A("staffZ", 1400, 1500 + 130, S, [{ t: 0, mode: "slamZ", eyes: "dead", mouth: "snarl" }], { flip: true }),
          A("may", 520, 1500 + 200, S, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }]), A("nat", 380, 1500 + 170, S, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }])],
