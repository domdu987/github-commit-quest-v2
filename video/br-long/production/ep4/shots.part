      // ---------- แสงกระสือ: helpers ----------
      const tf = (tl, sel, t, dur, to, ease = "power2.inOut") => tl.to(sel, { attr: { transform: to }, duration: dur, ease, immediateRender: false }, t);
      const put = (el, html) => el.insertAdjacentHTML("beforeend", html);
      const split = (k, at, A, B) => {
        add(k, A); shots[shots.length - 1].dur = at;
        add(k, B); const sh = shots[shots.length - 1]; sh.start = SH[k].start + at; sh.dur = D(k) - at;
      };
      const capsFrom = (k, at, lines, o) => caps(k, lines, o).filter((c) => c.end > at + 0.05).map((c) => ({ ...c, t: Math.max(0, c.t - at), end: c.end - at }));
      const steps = (k, label, items, at, endAt, o = {}) => ({ type: "steps", t: at, label, items, gap: o.gap ?? 0.5, top: o.top ?? 210, end: endAt ?? D(k) - 0.2 });
      // ---------- บางระจัน แบต 3% EP.1 · storytelling clip (lane A) · the channel look (slender cast, lit sets) ----------
      Rig.FLAT = true;
      Engine.look = { ...(Engine.look || {}), vignette: 0.5, grain: 0.05 };
      const NS = "http://www.w3.org/2000/svg";
      const A = (who, x, y, s, track, extra = {}) => { if (extra.talk) track.talk = extra.talk; return { who, x, y, s, track, blinks: [0.8, 2.4, 4.1], ...extra }; };
      const ID = fr(540, 960, 1.0, 540, 960);
      const grp = (parent) => { const g = document.createElementNS(NS, "g"); parent.appendChild(g); return g; };
      const pop = (tl, g, at, o = {}) => tl.fromTo(g, { opacity: 0, scale: o.from ?? 0.8, y: o.dy ?? -18, svgOrigin: o.origin || "540 960" },
        { opacity: 1, scale: 1, y: 0, svgOrigin: o.origin || "540 960", duration: o.dur ?? 0.4, ease: o.ease || "back.out(2.2)" }, at);
      const out = (tl, g, at, d = 0.18) => tl.to(g, { opacity: 0, duration: d }, at);
      const swingG = (tl, sel, t0, dur, amp = 3, org = "0 0") => tl.fromTo(sel, { rotation: -amp, svgOrigin: org }, { rotation: amp, svgOrigin: org, duration: 1.2, repeat: Math.ceil(dur / 1.2), yoyo: true, ease: "sine.inOut" }, t0);
      const shake = (tl, g, t0, dur, a = 3, p = 0.05) => tl.fromTo(g, { x: -a }, { x: a, duration: p, repeat: Math.ceil(dur / p), yoyo: true, ease: "none" }, t0);
      const DAY = { dark: 0.02, light: { from: "right", rim: "#fff0d0", rimOp: 0.6, rimW: 4, shade: "#3a2440", shadeOp: 0.25, shadeW: 26, soft: 9, vol: false }, blur: { fg: 0 },
        grade: { top: "#fff2d8", bottom: "#4a3a50", op: 0.16 } };
      const NIGHT = { dark: 0.1, light: { from: "right", rim: "#ffd9a0", rimOp: 0.55, rimW: 4, shade: "#1a1430", shadeOp: 0.32, shadeW: 26, soft: 9, vol: false }, blur: { fg: 0 },
        grade: { top: "#ffe2b0", bottom: "#1a1428", op: 0.24 } };
      const spec = (k, o) => ({ ...(o.night ? NIGHT : DAY), cam: o.cam || { keys: [{ t: 0, ...(o.camAt || ID), drift: { s: o.push ?? 0.012 } }] }, captions: o.captions ?? caps(k), ...o });
      const shot = (k, o) => add(k, spec(k, o));
      const talk = (k, i, m = "o") => [[vo(k, i), voEnd(k, i), m]];
      const swap = (tl, id, t, a = 0, b = 1, d = 0.12) => { tl.set(`#${id}-a${b}`, { opacity: 0 }, 0); tl.to(`#${id}-a${a}`, { opacity: 0, duration: d }, t); tl.to(`#${id}-a${b}`, { opacity: 1, duration: d }, t); };
      const tagAt = (tl, L, x, y, text, at, o = {}) => { const g = grp(L.act); g.innerHTML = Lot.tag(x, y, text, o); pop(tl, g, at, { origin: `${x} ${y}`, from: 0.5 }); return g; };
      const capAt = (id, y) => { const c = document.getElementById(`${id}-caps`); if (c) c.style.setProperty("top", `${y}px`, "important"); };
      const ink = Lot.INK;
      // a counter chip in the corner (screen space): "1/5"
      const chip = (tl, L, steps, o = {}) => { const x = o.x ?? 900, y = o.y ?? 250;
        const g = grp(L.light); g.innerHTML = `<g transform="translate(${x},${y})"><circle r="78" fill="#fbf7ee" stroke="${ink}" stroke-width="7"/>
          ${steps.map(([, txt], i) => `<text id="${o.id}-c${i}" x="0" y="20" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="58" fill="${ink}" opacity="0">${txt}</text>`).join("")}
          <text x="0" y="-36" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="22" fill="#a8305a">${o.label || "ที่ซ่อน"}</text></g>`;
        steps.forEach(([at], i) => { tl.set(`#${o.id}-c${i}`, { opacity: 1 }, at); if (i + 1 < steps.length) tl.set(`#${o.id}-c${i}`, { opacity: 0 }, steps[i + 1][0]);
          tl.fromTo(g, { scale: 1.25, svgOrigin: `${x} ${y}` }, { scale: 1, svgOrigin: `${x} ${y}`, duration: 0.25, ease: "back.out(3)", immediateRender: false }, at); });
        return g; };
      const sparkle = (x, y, r = 22) => `<path d="M${x},${y - r}Q${x + 4},${y - 4} ${x + r},${y}Q${x + 4},${y + 4} ${x},${y + r}Q${x - 4},${y + 4} ${x - r},${y}Q${x - 4},${y - 4} ${x},${y - r}Z" fill="#fff6b0" stroke="${ink}" stroke-width="2.5"/>`;


      // the status bar (top left), per shot: [[label, value, colour]]
      document.head.insertAdjacentHTML("beforeend", `<style>
        .sghud { position: absolute; z-index: 58; left: 44px; top: 120px; display: flex; flex-direction: row; white-space: nowrap; width: max-content; align-items: center; gap: 16px;
          padding: 12px 22px; border-radius: 18px; background: rgba(18,20,30,.7); border: 1.5px solid rgba(244,236,216,.2); box-shadow: 0 8px 24px rgba(0,0,0,.35); font-family: Kanit; color: #f4ecd8; }
        .sghud b { font: 800 34px/1 Kanit; } .sghud small { font: 600 19px/1 Kanit; opacity: .65; } .sghud i { width: 1.5px; height: 30px; background: rgba(244,236,216,.25); }
        .capbox { font: 800 54px/1.25 Kanit !important; }
      </style>`);
      const hud = (id, items) => { const el = document.getElementById(id); if (!el) return;
        el.insertAdjacentHTML("beforeend", `<div class="sghud">${items.map(([l, v, c], i) => `${i ? "<i></i>" : ""}<small>${l}</small><b style="color:${c || "#f4ecd8"}">${v}</b>`).join("")}</div>`); };
      const ears = (tl, aid, at, on = true, d = 0.25) => tl.to(`#${aid} .jkEar`, { opacity: on ? 1 : 0, duration: d }, at);
      // ---------- looks per world ----------
      const act = (k) => (shots.find((x) => x.key === k) || {}).actors || [];
      const DAWN = { dark: 0.04, light: { from: "right", rim: "#ffe0b0", rimOp: 0.7, rimW: 4, shade: "#3a2a50", shadeOp: 0.28, shadeW: 26, soft: 9, vol: false }, grade: { top: "#ffd8b0", bottom: "#4a3a60", op: 0.18 } };
      const DAYC = { dark: 0.02, light: { from: "left", rim: "#fff4d8", rimOp: 0.6, rimW: 4, shade: "#3a2a30", shadeOp: 0.24, shadeW: 26, soft: 9, vol: false }, grade: { top: "#fff6e0", bottom: "#5a4a40", op: 0.14 } };
      const ROOMN = { dark: 0.52, light: { from: "right", rim: "#9ad8ff", rimOp: 0.7, rimW: 4, shade: "#101428", shadeOp: 0.4, shadeW: 26, soft: 9, vol: false }, grade: { top: "#1a2448", bottom: "#06080f", op: 0.5 } };
      const field = (k, o = {}) => ({ ...DAWN, set: "brField", setOpts: { id: `bf${k}`, ...o } });
      const camp = (k, o = {}) => ({ ...DAYC, set: "brCamp", setOpts: { id: `bc${k}`, pole: true, drum: true, ...o } });
      const room = (k, o = {}) => ({ ...ROOMN, set: "brRoom", setOpts: { id: `br${k}`, ...o } });
      const shadows = (L, id, actors, sh = -0.4) => NkL.cast(L, id, actors, { k: 0.3, sh, op: 0.35 });
      const loop = NkV.loop;
      const H_BAT = (pct = 3) => [["แบต", `${pct}%`, "#ff8a7a"], ["ปลุก", "07:00", "#f2c55c"]];
      const H_NIGHT = [["เวลา", "03:00", "#9ad8ff"], ["แบต", "3%", "#ff8a7a"]];
      const ME = (who, x, y, track, extra = {}) => A(who, x, y, 0.95, track, extra);
      const face = (x, y = 1400, s = 3.2, flip = false, sx = 540, sy = 760, k = 0.95) => fr(x + (flip ? -2 : 2) * k, y - 546 * k, s, sx, sy);
      const KENG = 760;   // the tying pole
      const CHANNEL = "Rod Mai Club";   // ← เปลี่ยนเป็นชื่อช่องใหม่เมื่อเจ้าของตั้งชื่อแล้ว (จุดเดียว)
      const BUSH = (L) => { const g = grp(L.act); g.innerHTML = BRS.bush(1300, 1400, 0.9, "#3e7e34"); return g; };   // a copy of bush 2 over the cast: the kids stand in it
      // ไอ้ดำ: BR.buffalo faces right; left = true mirrors it. lick(): the tongue laps, the head bobs (down/tilt lower the muzzle to the face)
      const buffalo = (L, x, y, s = 1, left = false) => { const g = grp(L.act); g.innerHTML = BR.buffalo(); g.setAttribute("transform", `translate(${x},${y}) scale(${left ? -s : s},${s})`); return g; };
      const lick = (tl, g, t0, dur, o = {}) => { const tg = g.querySelector(".brTongue"), hd = g.querySelector(".brBufHead");
        tl.fromTo(tg, { scaleY: 0.5, rotation: -10, transformOrigin: "50% 0%" }, { scaleY: 1.25, rotation: 12, transformOrigin: "50% 0%", duration: 0.26, repeat: Math.ceil(dur / 0.26), yoyo: true, ease: "sine.inOut" }, t0);
        tl.fromTo(hd, { y: -176 + (o.down ?? 0), rotation: o.tilt ?? 0, transformOrigin: "0% 50%" }, { y: -176 + (o.down ?? 0) + 14, rotation: (o.tilt ?? 0) + 4, transformOrigin: "0% 50%", duration: 0.7, repeat: Math.ceil(dur / 0.7), yoyo: true, ease: "sine.inOut" }, t0); };
      // rope loops around the torso of the one tied to the pole (drawn over the cast)
      const rope = (L, x, s = 0.95, y0 = 1400, id = "rp") => { const g = grp(L.act);
        g.innerHTML = [-448, -414, -380, -346].map((yy, k) => `<g id="${id}-rp${k}"><ellipse cx="${x}" cy="${(y0 + yy * s).toFixed(1)}" rx="${(60 * s).toFixed(1)}" ry="${(9 * s).toFixed(1)}" fill="none" stroke="#caa66a" stroke-width="11"/>
          <ellipse cx="${x}" cy="${(y0 + yy * s).toFixed(1)}" rx="${(60 * s).toFixed(1)}" ry="${(9 * s).toFixed(1)}" fill="none" stroke="#8a6a3a" stroke-width="3" stroke-dasharray="8 10"/></g>`).join(""); return g; };
      // the phone's lock screen (screen space): status bar, the big 3%, the alarm row, a new-message banner (its text blurred: nobody reads it yet)
      const phoneUI = (L, id, o = {}) => { const g = grp(L.light), x = o.x ?? 540, y = o.y ?? 760, s = o.s ?? 0.72;
        g.innerHTML = `<g transform="translate(${x},${y}) scale(${s})"><rect x="-300" y="-550" width="600" height="1100" rx="60" fill="#1a1a22"/><rect x="-272" y="-522" width="544" height="1044" rx="44" fill="#0b0d16"/>
          <rect x="-90" y="-512" width="180" height="34" rx="17" fill="#1a1a22"/>
          <g id="${id}-ui"><text x="-236" y="-452" font-family="Kanit" font-weight="700" font-size="30" fill="#f4ecd8" opacity=".85">${o.time || "06:21"}</text>
            <g transform="translate(236,-466)"><rect x="-60" y="-14" width="54" height="28" rx="6" fill="none" stroke="#f4ecd8" stroke-width="3"/><rect x="-5" y="-6" width="5" height="12" rx="1.5" fill="#f4ecd8"/><rect x="-55" y="-9" width="4" height="18" rx="1" fill="#ff5a4a"/></g>
            <text x="166" y="-456" text-anchor="end" font-family="Kanit" font-weight="800" font-size="30" fill="#ff8a7a">${o.pct ?? 3}%</text>
            <g id="${id}-big"><text x="0" y="-130" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="230" fill="#ff5a4a">${o.pct ?? 3}%</text><text x="0" y="-50" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="42" fill="#f4ecd8" opacity=".85">แบตเตอรี่ใกล้หมด</text></g>
            <g id="${id}-al"><rect x="-236" y="60" width="472" height="170" rx="30" fill="#1c2236"/><g transform="translate(-176,145) scale(1.1)"><path d="M-21,12Q-23,-24 0,-27Q23,-24 21,12Z" fill="#f2c55c"/><path d="M-28,12H28" stroke="#f2c55c" stroke-width="5" stroke-linecap="round"/><circle cy="21" r="5.5" fill="#f2c55c"/></g>
              <text x="-120" y="120" font-family="Kanit" font-weight="800" font-size="36" fill="#f4ecd8">นาฬิกาปลุก</text><text x="-120" y="196" font-family="Kanit" font-weight="900" font-size="74" fill="#f2c55c">07:00</text><text x="214" y="122" text-anchor="end" font-family="Kanit" font-weight="700" font-size="32" fill="#9ad8ff">พรุ่งนี้</text></g>
            <g id="${id}-msg"><rect x="-250" y="-400" width="500" height="150" rx="30" fill="#f4ecd8"/><rect x="-226" y="-376" width="80" height="80" rx="20" fill="#3a9c66"/><path d="M-206,-350h40v26h-22l-8,8v-8h-10z" fill="#fff"/>
              <text x="-124" y="-352" font-family="Kanit" font-weight="800" font-size="30" fill="#2e2a26">ข้อความใหม่</text><text x="226" y="-352" text-anchor="end" font-family="Kanit" font-weight="600" font-size="24" fill="#8a8a8a">ตอนนี้</text>
              <g filter="url(#brBlur)"><text x="-124" y="-300" font-family="Kanit" font-weight="700" font-size="34" fill="#2e2a26">ยายซ่อนมะนาวไว้ใต้ยุ้ง</text></g></g></g>
          <rect id="${id}-off" x="-272" y="-522" width="544" height="1044" rx="44" fill="#07080c" opacity="0"/><rect id="${id}-flash" x="-272" y="-522" width="544" height="1044" rx="44" fill="#ffffff" opacity="0"/></g>`; return g; };
      // the camp rules on a hanging wooden board (screen space); rows: [icon, tone, line 1, line 2]
      const plank = (L, id, rows, title) => { const g = grp(L.light);
        const row = (y, n, ic, tone, a, b) => `<g id="${id}-rr${n}">${JKI.coin(ic, -290, y, 0.66, `${id}-ic${n}`, tone)}<text x="-222" y="${y - 8}" font-family="Kanit" font-weight="900" font-size="48" fill="#fbefd4">${a}</text><text x="-222" y="${y + 46}" font-family="Kanit" font-weight="800" font-size="40" fill="#f6d36a">${b}</text></g>`;
        g.innerHTML = `<g id="${id}-pl" transform="translate(540,736)"><path d="M-250,-640V-390M250,-640V-390" stroke="#caa66a" stroke-width="12"/><path d="M-250,-640V-390M250,-640V-390" stroke="#8a6a3a" stroke-width="3" stroke-dasharray="8 12"/>
          <rect x="-390" y="-392" width="780" height="784" rx="14" fill="#5a3a1c"/><rect x="-376" y="-376" width="752" height="752" rx="10" fill="#a8743a"/>
          ${[-300, -200, -100, 0, 100, 200, 300].map((yy, k) => `<path d="M-360,${yy}q180,${k % 2 ? 12 : -12} 720,0" stroke="#8a5a2e" stroke-width="3" fill="none" opacity=".55"/>`).join("")}
          ${[[-352, -352], [352, -352], [-352, 352], [352, 352]].map(([x, y]) => `<circle cx="${x}" cy="${y}" r="9" fill="#3a2a1a"/><circle cx="${x - 2}" cy="${y - 2}" r="4" fill="#9a9088"/>`).join("")}
          <rect x="-300" y="-350" width="600" height="104" rx="12" fill="#5a3a1c"/><text x="0" y="-278" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="58" fill="#f6d36a">${title}</text>
          ${rows.map(([ic, tone, a, b], n) => row(-150 + n * 200, n + 1, ic, tone, a, b)).join("")}</g>`; return g; };
      const BLACK = (L) => { const g = grp(L.light); g.innerHTML = `<rect x="-200" y="-200" width="1480" height="2320" fill="#000"/>`; return g; };

      // ---------- EP.4 helpers: looks for the last night, the dawn and the morning; the chat screens; a second status bar ----------
      const hud2 = (id, items, cls) => { const el = document.getElementById(id); if (!el) return;
        el.insertAdjacentHTML("beforeend", `<div class="sghud ${cls}">${items.map(([l, v, c], i) => `${i ? "<i></i>" : ""}<small>${l}</small><b style="color:${c || "#f4ecd8"}">${v}</b>`).join("")}</div>`); };
      const hudSwap = (tl, id, t0, at, a, b) => { hud2(id, a, "hA"); hud2(id, b, "hB"); tl.set(`#${id} .sghud.hB`, { opacity: 0 }, 0); tl.set(`#${id} .sghud.hA`, { opacity: 0 }, t0 + at); tl.set(`#${id} .sghud.hB`, { opacity: 1 }, t0 + at);
        tl.fromTo(`#${id} .sghud.hB`, { scale: 1.25 }, { scale: 1, duration: 0.3, ease: "back.out(3)", immediateRender: false }, t0 + at); };
      const LASTNIGHT = (k, o = {}) => ({ ...camp(k, { night: true, fog: true, torches: true, limes: true, ...o }), dark: 0.22, light: { from: "left", rim: "#ffd9a0", rimOp: 0.5, rimW: 4, shade: "#0a0e24", shadeOp: 0.4, shadeW: 26, soft: 9, vol: false }, grade: { top: "#2a3a70", bottom: "#06081a", op: 0.34 } });
      const DAWNCAMP = (k, o = {}) => ({ ...camp(k, { limes: true, torches: true, ...o }), ...DAWN });
      const ROOMD = (k, o = {}) => ({ ...room(k, o), dark: 0.04, light: DAYC.light, grade: { top: "#fff6e0", bottom: "#c8b090", op: 0.12 } });
      const H_MORN = [["เวลา", "07:00", "#9ad8ff"], ["แบต", "3%", "#ff8a7a"]];
      const UNDER = 1600;   // the granary (floor y 1000); the room underneath is 1450…1750
      // the message screens (screen space): the day-one message opened, then the same words typed and sent back
      const chatUI = (L, id, o = {}) => { const g = grp(L.light), x = o.x ?? 540, y = o.y ?? 760, s = o.s ?? 0.72;
        g.innerHTML = `<g transform="translate(${x},${y}) scale(${s})"><rect x="-300" y="-550" width="600" height="1100" rx="60" fill="#1a1a22"/><rect x="-272" y="-522" width="544" height="1044" rx="44" fill="#0b0d16"/><rect x="-90" y="-512" width="180" height="34" rx="17" fill="#1a1a22"/>
          <text x="-236" y="-452" font-family="Kanit" font-weight="700" font-size="30" fill="#f4ecd8" opacity=".85">${o.time || "05:52"}</text>
          <g transform="translate(-180,-470)"><rect x="-10" y="4" width="8" height="12" rx="2" fill="${o.bars ? "#8ad87a" : "#3a3a44"}"/><rect x="2" y="-2" width="8" height="18" rx="2" fill="#3a3a44"/><rect x="14" y="-8" width="8" height="24" rx="2" fill="#3a3a44"/></g>
          <text x="166" y="-456" text-anchor="end" font-family="Kanit" font-weight="800" font-size="30" fill="${o.pct > 1 ? "#8ad87a" : "#ff8a7a"}">${o.pct ?? 1}%</text>
          <rect x="-272" y="-430" width="544" height="120" fill="#141826"/><circle cx="-196" cy="-370" r="36" fill="#2a7ad8"/><text x="-196" y="-356" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="40" fill="#fff">ก</text>
          <text x="-140" y="-382" font-family="Kanit" font-weight="800" font-size="36" fill="#f4ecd8">${o.name || "เก่ง"}</text><g id="${id}-own"><text x="-140" y="-340" font-family="Kanit" font-weight="700" font-size="26" fill="#f2c55c">${o.sub || "เบอร์ของคุณเอง"}</text></g>
          <g id="${id}-in"><rect x="-240" y="-260" width="400" height="150" rx="30" fill="#f4ecd8"/><text x="-212" y="-200" font-family="Kanit" font-weight="800" font-size="34" fill="#2e2a26">ยายซ่อนมะนาว</text><text x="-212" y="-150" font-family="Kanit" font-weight="800" font-size="34" fill="#2e2a26">ไว้ใต้ยุ้ง</text><text x="150" y="-128" text-anchor="end" font-family="Kanit" font-weight="600" font-size="20" fill="#8a8a8a">${o.when || "วันแรก · 06:23"}</text></g>
          <g id="${id}-out"><rect x="-160" y="-60" width="400" height="150" rx="30" fill="#3a9c66"/><text id="${id}-typed" x="-132" y="0" font-family="Kanit" font-weight="800" font-size="34" fill="#fff"></text><text id="${id}-typed2" x="-132" y="50" font-family="Kanit" font-weight="800" font-size="34" fill="#fff"></text><text id="${id}-sent" x="230" y="72" text-anchor="end" font-family="Kanit" font-weight="600" font-size="20" fill="#dff" opacity="0">${o.sentAs || "ส่งแล้ว · คืนแรก"}</text></g>
          <g id="${id}-box"><rect x="-240" y="380" width="380" height="80" rx="40" fill="#1c2236"/><text id="${id}-box-t" x="-212" y="432" font-family="Kanit" font-weight="700" font-size="30" fill="#f4ecd8"></text><circle id="${id}-send" cx="200" cy="420" r="40" fill="#3a9c66"/><path d="M186,404L220,420L186,436L194,420Z" fill="#fff"/></g></g>`; return g; };
      const typeIn = (tl, sel, text, at, per = 0.07) => { for (let i = 1; i <= text.length; i++) tl.set(sel, { textContent: text.slice(0, i) }, at + i * per); return at + text.length * per; };
      const WHITE = (L) => { const g = grp(L.light); g.innerHTML = `<rect x="-200" y="-200" width="1480" height="2320" fill="#fff"/>`; return g; };

      // ---------- e01–e02 the dead phone, no way home ----------
