      // ---------- EP.4 helpers: looks for the last night, the dawn and the morning; the chat screens; a second status bar ----------
      const hud2 = (id, items, cls) => { const el = document.getElementById(id); if (!el) return;
        el.insertAdjacentHTML("beforeend", `<div class="sghud ${cls}">${items.map(([l, v, c], i) => `${i ? "<i></i>" : ""}<small>${l}</small><b style="color:${c || "#f4ecd8"}">${v}</b>`).join("")}</div>`); };
      const hudSwap = (tl, id, t0, at, a, b) => { hud2(id, a, "hA"); hud2(id, b, "hB"); tl.set(`#${id} .sghud.hB`, { opacity: 0 }, 0); tl.set(`#${id} .sghud.hA`, { opacity: 0 }, t0 + at); tl.set(`#${id} .sghud.hB`, { opacity: 1 }, t0 + at);
        tl.fromTo(`#${id} .sghud.hB`, { scale: 1.25 }, { scale: 1, duration: 0.3, ease: "back.out(3)", immediateRender: false }, t0 + at); };
      const LASTNIGHT = (k, o = {}) => ({ ...camp(k, { night: true, fog: true, torches: true, limes: true, ...o }), dark: 0.22, light: { from: "left", rim: "#ffd9a0", rimOp: 0.5, rimW: 4, shade: "#0a0e24", shadeOp: 0.4, shadeW: 26, soft: 9, vol: false }, grade: { top: "#2a3a70", bottom: "#06081a", op: 0.34 } });
      const DAWNCAMP = (k, o = {}) => ({ ...camp(k, { limes: true, torches: true, ...o }), ...DAWN });
      const ROOMD = (k, o = {}) => ({ ...room(k, o), dark: 0.04, light: DAYC.light, grade: { top: "#fff6e0", bottom: "#c8b090", op: 0.12 } });
      const H_MORN = [["เวลา", "07:00", "#9ad8ff"], ["แบต", "3%", "#ff8a7a"]];
      const UNDER = 1600;   // the granary (floor y 1000); the room underneath is 1450…1750
      // the message screens (screen space): the day-one message opened, then the same words typed and sent back
      const chatUI = (L, id, o = {}) => { const g = grp(L.light), x = o.x ?? 540, y = o.y ?? 760, s = o.s ?? 0.72;
        g.innerHTML = `<g transform="translate(${x},${y}) scale(${s})"><rect x="-300" y="-550" width="600" height="1100" rx="60" fill="#1a1a22"/><rect x="-272" y="-522" width="544" height="1044" rx="44" fill="#0b0d16"/><rect x="-90" y="-512" width="180" height="34" rx="17" fill="#1a1a22"/>
          <text x="-236" y="-452" font-family="Kanit" font-weight="700" font-size="30" fill="#f4ecd8" opacity=".85">${o.time || "05:52"}</text>
          <g transform="translate(-180,-470)"><rect x="-10" y="4" width="8" height="12" rx="2" fill="${o.bars ? "#8ad87a" : "#3a3a44"}"/><rect x="2" y="-2" width="8" height="18" rx="2" fill="#3a3a44"/><rect x="14" y="-8" width="8" height="24" rx="2" fill="#3a3a44"/></g>
          <text x="166" y="-456" text-anchor="end" font-family="Kanit" font-weight="800" font-size="30" fill="${o.pct > 1 ? "#8ad87a" : "#ff8a7a"}">${o.pct ?? 1}%</text>
          <rect x="-272" y="-430" width="544" height="120" fill="#141826"/><circle cx="-196" cy="-370" r="36" fill="#2a7ad8"/><text x="-196" y="-356" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="40" fill="#fff">ก</text>
          <text x="-140" y="-382" font-family="Kanit" font-weight="800" font-size="36" fill="#f4ecd8">${o.name || "เก่ง"}</text><g id="${id}-own"><text x="-140" y="-340" font-family="Kanit" font-weight="700" font-size="26" fill="#f2c55c">${o.sub || "เบอร์ของคุณเอง"}</text></g>
          <g id="${id}-in"><rect x="-240" y="-260" width="400" height="150" rx="30" fill="#f4ecd8"/><text x="-212" y="-200" font-family="Kanit" font-weight="800" font-size="34" fill="#2e2a26">ยายซ่อนมะนาว</text><text x="-212" y="-150" font-family="Kanit" font-weight="800" font-size="34" fill="#2e2a26">ไว้ใต้ยุ้ง</text><text x="150" y="-128" text-anchor="end" font-family="Kanit" font-weight="600" font-size="20" fill="#8a8a8a">${o.when || "วันแรก · 06:23"}</text></g>
          <g id="${id}-out"><rect x="-160" y="-60" width="400" height="150" rx="30" fill="#3a9c66"/><text id="${id}-typed" x="-132" y="0" font-family="Kanit" font-weight="800" font-size="34" fill="#fff"></text><text id="${id}-typed2" x="-132" y="50" font-family="Kanit" font-weight="800" font-size="34" fill="#fff"></text><text id="${id}-sent" x="230" y="72" text-anchor="end" font-family="Kanit" font-weight="600" font-size="20" fill="#dff" opacity="0">${o.sentAs || "ส่งแล้ว · คืนแรก"}</text></g>
          <g id="${id}-box"><rect x="-240" y="380" width="380" height="80" rx="40" fill="#1c2236"/><text id="${id}-box-t" x="-212" y="432" font-family="Kanit" font-weight="700" font-size="30" fill="#f4ecd8"></text><circle id="${id}-send" cx="200" cy="420" r="40" fill="#3a9c66"/><path d="M186,404L220,420L186,436L194,420Z" fill="#fff"/></g></g>`; return g; };
      const typeIn = (tl, sel, text, at, per = 0.07) => { for (let i = 1; i <= text.length; i++) tl.set(sel, { textContent: text.slice(0, i) }, at + i * per); return at + text.length * per; };
      const WHITE = (L) => { const g = grp(L.light); g.innerHTML = `<rect x="-200" y="-200" width="1480" height="2320" fill="#fff"/>`; return g; };

      // ---------- e01–e02 the dead phone, no way home ----------
      shot("e01", { ...LASTNIGHT("e01"), camAt: fr(UNDER, 1230, 1.4, 540, 940), push: 0.02, blur: { far: 4 },
        actors: [ME("brKengPhone", UNDER, 1400, [{ t: 0, mode: "hugKnees", eyes: "sad", mouth: "frown" }])],
        fx(tl, id, t0, L) { hud(id, H_BAT(0)); tl.set(`#${id}-a0 .brScrOff`, { opacity: 1 }, 0); BRI.badge(tl, L.light, t0, D("e01"), { kind: "phone", x: 300, y: 520, tone: "grey", label: "ดับสนิท", at: F("e01", 0, 0) + 0.3 });
          BRI.badge(tl, L.light, t0, D("e01"), { kind: "alarm", x: 800, y: 520, tone: "grey", label: "ไม่มีทางกลับบ้าน", at: F("e01", 0, 1) + 0.1 }); } });
      shot("e02", { ...LASTNIGHT("e02"), camAt: fr(UNDER + 6, 1400 - (546 - 196) * 0.95 - 20, 2.4, 540, 820), push: 0.02, blur: { far: 7, mid: 6, set: 3 }, dark: 0.3,
        actors: [ME("brKengPhone", UNDER, 1400, [{ t: 0, mode: "hugKnees", eyes: "sad", mouth: "frown" }, { t: F("e02", 0, 1), mode: "hugKnees", eyes: "closed", mouth: "pout" }])],
        fx(tl, id, t0, L) { hud(id, H_BAT(0)); tl.set(`#${id}-a0 .brScrOff`, { opacity: 1 }, 0); const ph = phoneUI(L, `${id}-ph`, { time: "--:--", pct: 0 }); tl.set(ph, { opacity: 0 }, 0); tl.set(`#${id}-ph-big, #${id}-ph-msg`, { opacity: 0 }, 0);
          tl.set(`#${id}-ph-off`, { opacity: 0.55 }, 0); pop(tl, ph, t0 + F("e02", 0, 1) - 0.1, { origin: "540 760", from: 0.75, dur: 0.35 });
          const x = grp(L.light); x.innerHTML = `<g transform="translate(540,${(760 + 145 * 0.72).toFixed(0)})"><path d="M-170,-55L170,55M170,-55L-170,55" stroke="#ff4a3a" stroke-width="16" stroke-linecap="round"/></g>`; pop(tl, x, t0 + F("e02", 0, 1) + 1.0, { origin: "540 864", from: 2, dur: 0.2, ease: "power3.in" }); } });

      // ---------- e03–e07 จุก sits down; the secret; the limes under the granary ----------
      shot("e03", { ...LASTNIGHT("e03"), camAt: fr(UNDER + 40, 1210, 1.35, 540, 940), push: 0.015, blur: { far: 4 },
        actors: [ME("brKengPhone", UNDER, 1400, [{ t: 0, mode: "hugKnees", eyes: "sad", mouth: "frown" }, { t: F("e03", 0, 1) + 1.0, mode: "hugKnees", eyes: "side", mouth: "flat" }]),
          A("brJukSword", 1250, 1400, 0.68, [{ t: 0, mode: "walk", eyes: "normal", mouth: "smile" }, { t: F("e03", 0, 1) + 0.9, mode: "sit", eyes: "normal", mouth: "smile" }], { moveTo: { x: UNDER + 120, dur: 1.0, at: F("e03", 0, 1) - 0.1 } })],
        fx(tl, id, t0, L) { hud(id, H_BAT(0)); tl.set(`#${id}-a0 .brScrOff`, { opacity: 1 }, 0); tagAt(tl, L, UNDER + 150, 1150, "จุก", t0 + F("e03", 0, 1) + 1.3, { s: 0.9 }); } });
      shot("e04", { ...LASTNIGHT("e04"), camAt: fr(UNDER + 120 - 2, 1400 - (546 - 290) * 0.68, 2.6, 540, 820), push: 0.02, blur: { far: 7, mid: 6, set: 3 }, captions: caps("e04", null, { quote: false }),
        actors: [A("brJukSword", UNDER + 120, 1400, 0.68, [{ t: 0, mode: "sit", eyes: "side", mouth: "flat" }, { t: F("e04", 0, 1), mode: "sit", eyes: "squint", mouth: "smile" }], { talk: [[vo("e04"), voEnd("e04"), "o"]] })],
        fx(tl, id, t0, L) { hud(id, H_BAT(0)); } });
      shot("e05", { ...LASTNIGHT("e05"), camAt: fr(UNDER + 60, 1230, 1.5, 540, 940), push: 0.012, blur: { far: 6, mid: 5 }, captions: caps("e05", null, { quote: false }),
        actors: [ME("brKengPhone", UNDER, 1400, [{ t: 0, mode: "hugKnees", eyes: "side", mouth: "flat" }, { t: F("e05", 0, 1) + 0.6, mode: "hugKnees", eyes: "wide", mouth: "o" }]), A("brJukSword", UNDER + 120, 1400, 0.68, [{ t: 0, mode: "sit", eyes: "normal", mouth: "o" }], { talk: [[vo("e05"), voEnd("e05"), "o"]] })],
        fx(tl, id, t0, L) { hud(id, H_BAT(0)); tl.set(`#${id}-a0 .brScrOff`, { opacity: 1 }, 0); const g = grp(L.light); g.innerHTML = `<g transform="translate(540,640) rotate(-3)"><rect x="-330" y="-80" width="660" height="160" rx="30" fill="#f4ecd8" stroke="#2e2a26" stroke-width="6"/>
            <rect x="-306" y="-56" width="70" height="70" rx="18" fill="#3a9c66"/><path d="M-290,-34h38v24h-20l-8,8v-8h-10z" fill="#fff"/><text x="-216" y="-22" font-family="Kanit" font-weight="700" font-size="26" fill="#8a8a8a">ข้อความวันแรก</text><text x="-216" y="34" font-family="Kanit" font-weight="900" font-size="44" fill="#2e2a26">ยายซ่อนมะนาวไว้ใต้ยุ้ง</text></g>`;
          pop(tl, g, t0 + F("e05", 0, 1), { origin: "540 640", from: 0.6, dur: 0.4 }); const sp = grp(L.light); sp.innerHTML = sparkle(230, 580, 22) + sparkle(860, 700, 16); tl.set(sp, { opacity: 0 }, 0); tl.fromTo(sp, { opacity: 0, scale: 0.3, svgOrigin: "540 640" }, { opacity: 1, scale: 1, svgOrigin: "540 640", duration: 0.3, immediateRender: false }, t0 + F("e05", 0, 1) + 0.3); } });
      shot("e06", { ...LASTNIGHT("e06"), cam: JKC.move(fr(UNDER + 60, 1230, 1.5, 540, 940), fr(1250, 1060, 1.5, 540, 940), F("e06", 0, 1) - 0.4, 0.8),
        actors: [ME("brKengPhone", UNDER, 1400, [{ t: 0, mode: "hugKnees", eyes: "wide", mouth: "o" }, { t: 0.4, mode: "hugKnees", eyes: "side", mouth: "flat" }]), A("brJukSword", UNDER + 120, 1400, 0.68, [{ t: 0, mode: "sit", eyes: "side", mouth: "flat" }]),
          A("brPhaeoLadle", 1250, 1400, 0.9, [{ t: 0, mode: "idle", eyes: "side", mouth: "flat" }, { t: F("e06", 0, 1) - 0.2, mode: "whistle", eyes: "closed", mouth: "o" }], { flip: true })],
        sfxText: [{ text: "ฟิ้ววว~", x: 120, y: 560, size: 84, rot: -6, color: "#f6d36a", t: F("e06", 0, 1), end: D("e06") - 0.1 }],
        fx(tl, id, t0, L) { hud(id, H_BAT(0)); shadows(L, id, act("e06"), 0.3); tl.set(`#${id}-a0 .brScrOff`, { opacity: 1 }, 0); } });
      shot("e07", { ...LASTNIGHT("e07"), camAt: fr(UNDER, 1280, 1.4, 540, 960), push: 0.02, blur: { far: 4 }, shake: JKC.impact(F("e07", 0, 1), 0.6, 6),
        actors: [ME("brKengPhone", UNDER, 1400, [{ t: 0, mode: "hugKnees", eyes: "side", mouth: "flat" }, { t: F("e07", 0, 1), mode: "hugKnees", eyes: "wide", mouth: "o" }]), A("brJukSword", UNDER + 120, 1400, 0.68, [{ t: 0, mode: "sit", eyes: "normal", mouth: "smile" }])],
        fx(tl, id, t0, L) { hud(id, H_BAT(0)); tl.set(`#${id}-a0 .brScrOff`, { opacity: 1 }, 0); const lm = grp(L.act); const rr = (() => { let q = 7; return () => ((q = (q * 1664525 + 1013904223) % 4294967296) / 4294967296); })();
          lm.innerHTML = [...Array(34)].map((_, k) => `<g id="${id}-lm${k}">${BR.LIME(UNDER - 120 + rr() * 240, 1370 + rr() * 40, 0.8 + rr() * 0.3)}</g>`).join("");
          [...Array(34)].forEach((_, k) => { const dx = -300 + rr() * 600, a = t0 + F("e07", 0, 1) + rr() * 0.6; tl.set(`#${id}-lm${k}`, { opacity: 0 }, 0); tl.fromTo(`#${id}-lm${k}`, { opacity: 1, x: 0, y: -60 }, { x: dx, y: 0, duration: 0.5 + rr() * 0.3, ease: "bounce.out", immediateRender: false }, a); });
          BRI.counter(tl, L.light, t0, D("e07"), { icon: "lime", x: 44, y: 330, w: 360, from: 0, to: 100, unit: "ลูก", at: F("e07", 0, 1) + 0.2, rollAt: F("e07", 0, 1) + 0.5, count: 1.2, tone: "green", plus: true }); } });

      // ---------- e08–e12 before dawn: the lime battery again; 1%; one bar; the message from your own number ----------
      shot("e08", { ...DAWNCAMP("e08"), cam: { keys: [{ t: 0, ...fr(900, 900, 0.8, 540, 800), drift: { s: 0.005 } }, { t: F("e08", 0, 1) - 0.3, ...fr(700, 1150, 1.2, 540, 960), glide: 1.0 }] },
        actors: [ME("brKeng", 820, 1400, [{ t: 0, mode: "crouch", eyes: "normal", mouth: "flat" }]), A("brJukSword", 980, 1400, 0.68, [{ t: 0, mode: "crouch", eyes: "wide", mouth: "o" }], { flip: true }), A("brTaeng", 1100, 1400, 0.82, [{ t: 0, mode: "walk", eyes: "squint", mouth: "flat" }, { t: 1.6, mode: "crouch", eyes: "squint", mouth: "flat" }], { flip: true, moveTo: { x: 1080, dur: 1.5, at: 0 } }),
          A("brMan2", 1240, 1400, 1.0, [{ t: 0, mode: "crouch", eyes: "normal", mouth: "flat" }], { flip: true }), A("brPhaeoLadle", 560, 1400, 0.9, [{ t: 0, mode: "foldX", eyes: "angry", mouth: "frown" }, { t: F("e08", 0, 1) + 0.9, mode: "crouch", eyes: "normal", mouth: "flat" }])],
        sfxText: [{ text: "เฮ้อ…", x: 150, y: 640, size: 80, rot: -6, color: "#f6d36a", t: F("e08", 0, 1) - 0.1, end: F("e08", 0, 1) + 1.1 }],
        fx(tl, id, t0, L) { hud(id, H_BAT(0)); shadows(L, id, act("e08"), -0.5); } });
      shot("e09", { ...DAWNCAMP("e09"), camAt: fr(760, 1300, 2.4, 540, 1000), push: 0.03, blur: { far: 9, mid: 8, set: 3 }, dark: 0.18,
        fx(tl, id, t0, L) { hudSwap(tl, id, t0, F("e09", 0, 0) + 1.0, H_BAT(0), H_BAT(1)); const tr = grp(L.act); tr.innerHTML = `<g transform="translate(760,1392)"><ellipse rx="92" ry="24" fill="#6a4a2a"/><ellipse cy="-6" rx="82" ry="19" fill="#c8a860"/><g transform="translate(0,-36) rotate(-8)"><rect x="-22" y="-44" width="44" height="88" rx="6" fill="#1a1a22"/><rect x="-18" y="-38" width="36" height="70" rx="4" fill="#101016"/></g><path d="M-60,-40Q-140,-60 -200,-20M60,-40Q140,-60 200,-20" stroke="#d8352a" stroke-width="4" fill="none"/></g>`;
          const ph = chatUI(L, `${id}-ch`, { time: "05:48", pct: 1, bars: true }); tl.set(ph, { opacity: 0 }, 0); tl.set(`#${id}-ch-in, #${id}-ch-out, #${id}-ch-box, #${id}-ch-own`, { opacity: 0 }, 0); pop(tl, ph, t0 + 0.1, { origin: "540 760", from: 0.75, dur: 0.35 });
          tl.set(`#${id}-ch-own`, { opacity: 0 }, 0); const big = grp(L.light); big.innerHTML = `<g transform="translate(540,900)"><text id="${id}-pct" x="0" y="0" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="170" fill="#8ad87a" opacity="0">1%</text></g>`;
          tl.fromTo(`#${id}-pct`, { opacity: 0, scale: 1.6, svgOrigin: "540 900" }, { opacity: 1, scale: 1, svgOrigin: "540 900", duration: 0.35, ease: "back.out(2.5)", immediateRender: false }, t0 + F("e09", 0, 0) + 1.0);
          const sig = grp(L.light); sig.innerHTML = `<g transform="translate(410,420)"><circle r="54" fill="#1c2236" stroke="#8ad87a" stroke-width="5"/><rect x="-24" y="2" width="12" height="20" rx="3" fill="#8ad87a"/><rect x="-6" y="-8" width="12" height="30" rx="3" fill="#3a3a44"/><rect x="12" y="-18" width="12" height="40" rx="3" fill="#3a3a44"/></g>`;
          pop(tl, sig, t0 + (F("e09", 0, 1) + 1.3), { origin: "410 420", from: 0.3, dur: 0.4 }); BRI.badge(tl, L.light, t0, D("e09"), { kind: "msg", x: 800, y: 520, tone: "green", label: "หนึ่งขีด", at: (F("e09", 0, 1) + 1.3) + 0.2 }); } });
      shot("e10", { ...DAWNCAMP("e10"), camAt: fr(820, 1000, 1.6, 540, 900), push: 0.015, blur: { far: 9, mid: 8, set: 5, act: 3 }, dark: 0.22,
        actors: [ME("brKengPhone", 820, 1400, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }])],
        fx(tl, id, t0, L) { hud(id, H_BAT(1)); const ph = chatUI(L, `${id}-ch`, { time: "05:51", pct: 1, bars: true }); tl.set(`#${id}-ch-out, #${id}-ch-box, #${id}-ch-own`, { opacity: 0 }, 0); pop(tl, ph, t0 + 0.05, { origin: "540 760", from: 0.8, dur: 0.3 });
          tl.fromTo(`#${id}-ch-in`, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.3, immediateRender: false }, t0 + F("e10", 0, 0) + 0.4);
          tl.fromTo(`#${id}-ch-own`, { opacity: 0, scale: 1.6, svgOrigin: "-140 -350" }, { opacity: 1, scale: 1, svgOrigin: "-140 -350", duration: 0.35, ease: "back.out(2.5)", immediateRender: false }, t0 + (F("e10", 0, 1) + 1.1));
          const ring = grp(L.light); ring.innerHTML = `<g transform="translate(540,${(760 - 382 * 0.72).toFixed(0)})"><rect x="-150" y="-40" width="300" height="80" rx="20" fill="none" stroke="#f2c55c" stroke-width="7"/></g>`; tl.set(ring, { opacity: 0 }, 0); tl.fromTo(ring, { opacity: 0 }, { opacity: 1, duration: 0.15, repeat: 3, yoyo: true, immediateRender: false }, t0 + F("e10", 0, 1) + 0.2); } });
      shot("e11", { ...DAWNCAMP("e11"), camAt: face(820, 1400, 2.9, false, 540, 820), push: 0.03, blur: { far: 8, mid: 7, set: 4 },
        actors: [ME("brKengPhone", 820, 1400, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: F("e11", 0, 0) + 0.5, mode: "idle", eyes: "wide", mouth: "o" }, { t: F("e11", 0, 0) + 1.3, mode: "idle", eyes: "happy", mouth: "smile" }])],
        fx(tl, id, t0, L) { hud(id, H_BAT(1)); BRI.badge(tl, L.light, t0, D("e11"), { kind: "msg", x: 300, y: 520, tone: "yellow", label: "เข้าใจแล้ว", at: F("e11", 0, 0) + 0.7 }); const gl = grp(L.glow); gl.innerHTML = `<g style="mix-blend-mode:screen"><ellipse cx="860" cy="980" rx="200" ry="150" fill="url(#brPhoneGlow)"/></g>`; } });
      shot("e12", { ...DAWNCAMP("e12"), camAt: fr(820, 1000, 1.6, 540, 900), push: 0.012, blur: { far: 9, mid: 8, set: 5, act: 3 }, dark: 0.22, captions: caps("e12"),
        actors: [ME("brKengPhone", 820, 1400, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: F("e12", 0, 2), mode: "idle", eyes: "happy", mouth: "smile" }])],
        fx(tl, id, t0, L) { hud(id, H_BAT(1)); const ph = chatUI(L, `${id}-ch`, { time: "05:53", pct: 1, bars: true }); tl.set(`#${id}-ch-out, #${id}-ch-sent`, { opacity: 0 }, 0); pop(tl, ph, t0 + 0.05, { origin: "540 760", from: 0.8, dur: 0.3 });
          const t1 = typeIn(tl, `#${id}-ch-box-t`, "ยายซ่อนมะนาวไว้ใต้ยุ้ง", t0 + F("e12", 0, 0) + 0.3, 0.06); const send = Math.max(t1 + 0.2, t0 + F("e12", 0, 2));
          tl.fromTo(`#${id}-ch-send`, { scale: 1, transformOrigin: "50% 50%" }, { scale: 0.7, transformOrigin: "50% 50%", duration: 0.1, yoyo: true, repeat: 1, immediateRender: false }, send); tl.set(`#${id}-ch-box-t`, { textContent: "" }, send + 0.1);
          tl.set(`#${id}-ch-typed`, { textContent: "ยายซ่อนมะนาว" }, send + 0.1); tl.set(`#${id}-ch-typed2`, { textContent: "ไว้ใต้ยุ้ง" }, send + 0.1);
