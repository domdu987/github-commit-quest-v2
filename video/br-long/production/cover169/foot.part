      const Q = new URLSearchParams(location.search), V = Q.get("v") || "mitr";
      const FF = { kanit: "Kanit", mitr: "Mitr", prompt: "Prompt", chakra: "Chakra Petch", kod: "Kodchasan" }[V] || "Kanit";
      const SC = { kanit: 1, mitr: 0.97, prompt: 0.95, chakra: 0.94, kod: 0.88 }[V] || 1;   // width differs per font; keep the title inside the frame
      const px = (n) => Math.round(n * SC) + "px";
      document.head.insertAdjacentHTML("beforeend", `<style>
        @font-face { font-family: 'Mitr'; font-weight: 700; src: url(assets/fonts/Mitr.ttf); }
        @font-face { font-family: 'Prompt'; font-weight: 900; src: url(assets/fonts/Prompt.ttf); }
        @font-face { font-family: 'Chakra Petch'; font-weight: 700; src: url(assets/fonts/ChakraPetch.ttf); }
        @font-face { font-family: 'Kodchasan'; font-weight: 700; src: url(assets/fonts/Kodchasan.ttf); }
        ${V === "kanit" || V === "old" ? "" : `#stage text { font-family: "${FF}" !important; }`}
        .cv { position: absolute; z-index: 70; font-family: "${FF}", Kanit; font-weight: 900; text-align: center; pointer-events: none; }
        .ol { position: relative; display: inline-block; z-index: 0; filter: drop-shadow(0 10px 0 rgba(0,0,0,.5)); }
        .ol::before { content: attr(data-t); position: absolute; left: 0; top: 0; z-index: -1; color: transparent; -webkit-text-stroke: 16px #15101c; }
        .cv-shade { position: absolute; z-index: 69; top: 0; bottom: 0; right: 0; width: 980px; background: linear-gradient(90deg, rgba(10,8,14,0) 0%, rgba(10,8,14,.55) 28%, rgba(10,8,14,.9) 60%); pointer-events: none; }
        .cv-col { top: 0; bottom: 0; right: 40px; width: 760px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 0; }
        .cv-title { font-size: ${px(102)}; line-height: 1.05; color: #ffd84a; letter-spacing: -2px; }
        .cv-title .ol { text-shadow: 0 0 30px rgba(255,214,74,.55); }
        .cv-ep { margin-top: 26px; font-size: 46px; line-height: 1; color: #fff; }
        .cv-ep .pill { display: inline-block; background: #e2382e; color: #fff; padding: 6px 22px 10px; border-radius: 16px; margin-right: 16px; box-shadow: 0 0 0 6px #15101c, 0 8px 0 6px rgba(0,0,0,.4); }
        .cv-ep .ol::before { -webkit-text-stroke-width: 11px; }
        .cv-l1 { margin-top: 78px; font-size: ${px(100)}; line-height: 1.1; color: #fff; }
        .cv-cmd { display: inline-block; margin-top: 22px; font-size: ${px(96)}; line-height: 1; color: #fff; background: #e2382e; padding: 18px 50px 30px; border-radius: 28px; transform: rotate(-2deg); box-shadow: 0 0 0 10px #15101c, 0 16px 0 10px rgba(0,0,0,.45); text-shadow: 0 6px 0 rgba(0,0,0,.35); }
      </style>`);
      const OLD = `<div class="cv cv-top"><div class="cv-brand">ROD MAI CLUB</div><div class="cv-title">สกิลจอมโกหก</div><div class="cv-ep"><span class="pill">EP.1</span>การ์ดกากสุด</div></div>
        <div class="cv cv-bot"><div class="cv-setup">ตายแล้วเกิดใหม่<br>ได้สกิล<b>กากสุด</b></div><div class="cv-cmd">โกหกจนได้ที่ 1</div></div>`;
      const LEAN = `<div class="cv-shade"></div><div class="cv cv-col"><div class="cv-title"><span class="ol" data-t="บางระจัน แบต 3%">บางระจัน แบต 3%</span></div><div class="cv-ep"><span class="pill">เรื่องเต็ม</span><span class="ol" data-t="4 ตอนจบ">4 ตอนจบ</span></div>
        <div class="cv-l1"><span class="ol" data-t="ตื่นมาปี 2309">ตื่นมาปี 2309</span></div><div class="cv-cmd">แบตเหลือ 3% !?</div></div>`;
      root.insertAdjacentHTML("beforeend", `<div id="vig"></div><div id="flashw"></div><div id="black"></div>` + (V === "old" ? OLD : LEAN));
      Fx.setup(root);
      Engine.build(root, tl, shots);
      root.appendChild(document.getElementById("grain"));
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
