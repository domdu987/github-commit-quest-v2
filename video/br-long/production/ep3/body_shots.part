      // ---------- EP.3 helpers: a second status bar, the lemon-battery clip card, the buffalo gallop, the enemy line ----------
      const hud2 = (id, items, cls) => { const el = document.getElementById(id); if (!el) return;
        el.insertAdjacentHTML("beforeend", `<div class="sghud ${cls}">${items.map(([l, v, c], i) => `${i ? "<i></i>" : ""}<small>${l}</small><b style="color:${c || "#f4ecd8"}">${v}</b>`).join("")}</div>`); };
      const hudSwap = (tl, id, t0, at, a, b) => { hud2(id, a, "hA"); hud2(id, b, "hB"); tl.set(`#${id} .sghud.hB`, { opacity: 0 }, 0); tl.set(`#${id} .sghud.hA`, { opacity: 0 }, t0 + at); tl.set(`#${id} .sghud.hB`, { opacity: 1 }, t0 + at);
        tl.fromTo(`#${id} .sghud.hB`, { scale: 1.25 }, { scale: 1, duration: 0.3, ease: "back.out(3)", immediateRender: false }, t0 + at); };
      const NIGHTF = (k, o = {}) => ({ ...camp(k, { night: true, fog: true, torches: true, enemy: 5, fenceFront: true, ...o }), dark: 0.2, light: { from: "left", rim: "#ffd9a0", rimOp: 0.5, rimW: 4, shade: "#0a0e24", shadeOp: 0.4, shadeW: 26, soft: 9, vol: false }, grade: { top: "#2a3a70", bottom: "#06081a", op: 0.34 } });
      const gallop = (tl, g, t0, dur) => { const lg = g.querySelector(".brBufLeg"), bd = g.querySelector(".brBuf");
        tl.fromTo(lg, { rotation: -16, transformOrigin: "50% 0%" }, { rotation: 16, transformOrigin: "50% 0%", duration: 0.13, repeat: Math.ceil(dur / 0.13), yoyo: true, ease: "sine.inOut" }, t0);
        tl.fromTo(bd, { y: 0 }, { y: -22, duration: 0.13, repeat: Math.ceil(dur / 0.13), yoyo: true, ease: "sine.inOut" }, t0); };
      const enemyMove = (tl, id, t0, at, dx, dur, ease = "power1.inOut") => tl.to(`#${id}-enemy`, { x: dx, duration: dur, ease }, t0 + at);
      const dust = (tl, L, x, y, at, n = 6) => { const d = grp(L.act); d.innerHTML = [...Array(n)].map((_, k) => `<circle cx="${x - 60 + k * 26}" cy="${y - 10}" r="${18 + (k % 3) * 8}" fill="#cfc0a0" opacity=".7"/>`).join("");
        tl.set(d, { opacity: 0 }, 0); tl.fromTo(d, { opacity: 0.9, scale: 0.5, svgOrigin: `${x} ${y}` }, { opacity: 0, scale: 1.6, svgOrigin: `${x} ${y}`, duration: 0.8, immediateRender: false }, at); return d; };
      const clipCard = (L, id) => { const g = grp(L.light);
        g.innerHTML = `<g transform="translate(540,720)"><rect x="-330" y="-380" width="660" height="760" rx="40" fill="#1a1a22"/><rect x="-306" y="-356" width="612" height="712" rx="28" fill="#0b0d16"/>
          <rect x="-306" y="-356" width="612" height="420" rx="28" fill="#f6efdf"/><rect x="-306" y="-100" width="612" height="164" fill="#f6efdf"/>
          <g transform="translate(-150,-170)">${BR.LIME(0, 0, 2.2)}<path d="M-6,-84V-130" stroke="#8a8f98" stroke-width="10"/><path d="M-6,-130Q100,-210 260,-120" stroke="#d8352a" stroke-width="8" fill="none"/><path d="M60,-20Q160,-40 260,-80" stroke="#2e2a26" stroke-width="8" fill="none"/><rect x="40" y="-40" width="20" height="60" fill="#c8a040" transform="rotate(-20 50 -10)"/></g>
          <g transform="translate(170,-150)"><rect x="-60" y="-110" width="120" height="200" rx="18" fill="#1a1a22"/><rect x="-48" y="-96" width="96" height="160" rx="10" fill="#243a66"/><text x="0" y="-10" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="54" fill="#9ad8ff">⚡</text></g>
          <text x="0" y="40" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="54" fill="#2e2a26">มะนาวทำแบตได้!?</text>
          <rect x="-306" y="64" width="612" height="292" rx="28" fill="#0b0d16"/><text x="-270" y="130" font-family="Kanit" font-weight="700" font-size="32" fill="#f4ecd8">เคล็ดลับ DIY · 1.2M วิว</text>
          <circle cx="0" cy="250" r="56" fill="#fff" opacity=".9"/><path d="M-16,222L30,250L-16,278Z" fill="#1a1a22"/><text x="0" y="334" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="26" fill="#9aa0a6">คลิปที่เคยดูเมื่อคืน</text></g>`; return g; };

      // ---------- d01–d03 1%: the lime idea, rule three ----------
      shot("d01", { ...camp("d01", { limes: true }), camAt: fr(820, 1080, 1.2, 540, 940), push: 0.025, blur: { far: 3 },
        actors: [ME("brKengLime", 760, 1400, [{ t: 0, mode: "raise", eyes: "wide", mouth: "o" }]), A("brJukSword", 940, 1400, 0.68, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }], { flip: true }), A("brTaeng", 1040, 1400, 0.82, [{ t: 0, mode: "foldX", eyes: "squint", mouth: "flat" }], { flip: true }),
          A("brMan2", 560, 1400, 1.0, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }])],
        fx(tl, id, t0, L) { hud(id, H_BAT(1)); shadows(L, id, act("d01"), -0.5); JKI.ring(tl, L.light, t0, D("d01"), { x: 300, y: 520, from: 1, at: 0.1, tone: "red", label: "แบต", labelAt: 0.4, flashAt: F("d01", 0, 0) + 0.6 });
          BRI.badge(tl, L.light, t0, D("d01"), { kind: "lime", x: 800, y: 520, tone: "green", label: "ชาร์จด้วยอะไร?", at: F("d01", 0, 2) }); } });
      shot("d02", { ...camp("d02", { limes: true }), camAt: fr(760, 1000, 1.3, 540, 960), push: 0.01, blur: { far: 9, mid: 9, set: 8, act: 6 }, dark: 0.3,
        actors: [ME("brKengLime", 760, 1400, [{ t: 0, mode: "think", eyes: "side", mouth: "flat" }])],
        fx(tl, id, t0, L) { hud(id, H_BAT(1)); const g = clipCard(L, id); pop(tl, g, t0 + 0.1, { origin: "540 720", from: 0.7, dur: 0.4 }); tl.fromTo(g, { rotation: -3, svgOrigin: "540 720" }, { rotation: 2, svgOrigin: "540 720", duration: 1.4, repeat: 3, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0 + 0.5); } });
      shot("d03", { ...camp("d03", { limes: true }), camAt: fr(760, 1000, 1.25, 540, 960), push: 0.008, blur: { far: 10, mid: 10, set: 9, act: 8 }, dark: 0.3, shake: JKC.impact(F("d03", 0, 0) + 0.5, 0.3, 10),
        actors: [ME("brKengLime", 760, 1400, [{ t: 0, mode: "raise", eyes: "wide", mouth: "smile" }])],
        fx(tl, id, t0, L) { hud(id, H_BAT(1)); const g = plank(L, id, [["rope", "red", "คนแปลกหน้า", "มัดไว้ก่อน"], ["phone", "yellow", "ของวาวรอน", "อย่าให้ควายเห็น"], ["lime", "green", "ตำน้ำพริกไม่เป็น", "ห้ามแตะมะนาว"]], "กฎของค่าย ๓ ข้อ");
          pop(tl, g, t0 + 0.05, { origin: "540 736", from: 0.9, dur: 0.3 }); [1, 2].forEach((n) => tl.set(`#${id}-rr${n}`, { opacity: 0.35 }, 0));
          const st = grp(L.light); st.innerHTML = `<g transform="translate(540,990) rotate(-12)"><rect x="-200" y="-70" width="400" height="140" rx="18" fill="none" stroke="#d8352a" stroke-width="14"/><text x="0" y="30" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="86" fill="#d8352a">ฝ่ากฎ!</text></g>`;
          pop(tl, st, t0 + F("d03", 0, 0) + 0.5, { origin: "540 990", from: 2.4, dur: 0.22, ease: "power3.in" }); } });

      // ---------- d04–d08 two hundred limes for one percent ----------
      shot("d04", { ...camp("d04", { limes: true }), cam: { keys: [{ t: 0, ...fr(900, 820, 0.7, 540, 700), drift: { s: 0.004 } }, { t: F("d04", 0, 1) - 0.2, ...fr(760, 1200, 1.1, 540, 1000), glide: 1.2 }] },
        actors: [ME("brKeng", 820, 1400, [{ t: 0, mode: "crouch", eyes: "normal", mouth: "smile" }]), A("brMan2", 1200, 1400, 1.0, [{ t: 0, mode: "walk", eyes: "normal", mouth: "flat" }, { t: 2.3, mode: "crouch", eyes: "normal", mouth: "flat" }], { flip: true, moveTo: { x: 1000, dur: 2.2, at: 0.1 } }),
          A("brWom1Bowl", 380, 1400, 0.96, [{ t: 0, mode: "walk", eyes: "normal", mouth: "flat" }, { t: 2.0, mode: "idle", eyes: "normal", mouth: "flat" }], { moveTo: { x: 600, dur: 1.9, at: 0.2 } }), A("brJukSword", 1340, 1400, 0.68, [{ t: 0, mode: "walk", eyes: "wide", mouth: "o" }, { t: 2.6, mode: "crouch", eyes: "wide", mouth: "o" }], { flip: true, moveTo: { x: 1120, dur: 2.5, at: 0.1 } }),
          A("brTaeng", 200, 1400, 0.82, [{ t: 0, mode: "walk", eyes: "squint", mouth: "flat" }, { t: 2.2, mode: "foldX", eyes: "squint", mouth: "flat" }], { moveTo: { x: 440, dur: 2.1, at: 0.3 } })],
        fx(tl, id, t0, L) { hud(id, H_BAT(1)); shadows(L, id, act("d04"), -0.5); BRI.counter(tl, L.light, t0, D("d04"), { icon: "lime", x: 44, y: 330, w: 360, from: 0, to: 200, unit: "ลูก", at: F("d04", 0, 0) + 0.2, rollAt: F("d04", 0, 1) - 0.4, count: 1.6, tone: "green" }); } });
      shot("d05", { ...camp("d05", { limes: true }), camAt: fr(760, 1300, 2.4, 540, 1000), push: 0.03, blur: { far: 9, mid: 8, set: 3 }, dark: 0.22,
        fx(tl, id, t0, L) { hudSwap(tl, id, t0, F("d05", 0, 1) + 0.3, H_BAT(1), H_BAT(2)); const tr = grp(L.act); tr.innerHTML = `<g transform="translate(760,1392)"><ellipse rx="92" ry="24" fill="#6a4a2a"/><ellipse cy="-6" rx="82" ry="19" fill="#c8a860"/>
            <g transform="translate(0,-36) rotate(-8)"><rect x="-22" y="-44" width="44" height="88" rx="6" fill="#1a1a22"/><rect x="-18" y="-38" width="36" height="70" rx="4" fill="#101016"/></g><path d="M-60,-40Q-140,-60 -200,-20M60,-40Q140,-60 200,-20" stroke="#d8352a" stroke-width="4" fill="none"/></g>`;
          const ph = phoneUI(L, `${id}-ph`, { time: "16:02", pct: 1 }); tl.set(ph, { opacity: 0 }, 0); tl.set(`#${id}-ph-al, #${id}-ph-msg`, { opacity: 0 }, 0); pop(tl, ph, t0 + 0.1, { origin: "540 760", from: 0.75, dur: 0.35 });
          tl.fromTo(`#${id}-ph-flash`, { opacity: 0 }, { opacity: 0.7, duration: 0.07, repeat: 7, yoyo: true, immediateRender: false }, t0 + F("d05", 0, 0) + 0.3);
          const big = document.querySelector(`#${id}-ph-big text:first-child`); tl.set(big, { textContent: "2%", fill: "#8ad87a" }, t0 + F("d05", 0, 1) + 0.3); tl.set(`#${id}-ph-big text:last-child`, { textContent: "กำลังชาร์จ…" }, t0 + F("d05", 0, 1) + 0.3);
          tl.fromTo(`#${id}-ph-big`, { scale: 1.5, svgOrigin: "0 -130" }, { scale: 1, svgOrigin: "0 -130", duration: 0.4, ease: "back.out(2.5)", immediateRender: false }, t0 + F("d05", 0, 1) + 0.3);
          JKI.ring(tl, L.light, t0, D("d05"), { x: 300, y: 520, from: 1, at: 0.1, steps: [[F("d05", 0, 1) + 0.3, 2]], count: 0.5, tone: "green", label: "แบต", labelAt: 0.4, flashAt: F("d05", 0, 1) + 0.8 }); } });
      shot("d06", { ...camp("d06", { limes: true, drum: true }), camAt: fr(900, 1080, 1.05, 540, 940), push: 0.015, shake: JKC.pov(6, 7),
        actors: [A("brMan2", 1040, 1400, 1.0, [{ t: 0, mode: "cheer", eyes: "happy", mouth: "laugh" }], { flip: true }), A("brMan1", 560, 1400, 0.98, [{ t: 0, mode: "cheer", eyes: "happy", mouth: "laugh" }]), ME("brKeng", 760, 1400, [{ t: 0, mode: "cheer", eyes: "happy", mouth: "laugh" }]),
          A("brJukSword", 660, 1400, 0.68, [{ t: 0, mode: "cheer", eyes: "happy", mouth: "laugh" }]), A("brTaeng", 1180, 1400, 0.82, [{ t: 0, mode: "cheer", eyes: "happy", mouth: "smile" }], { flip: true }), A("brWom1", 1300, 1400, 0.96, [{ t: 0, mode: "cheer", eyes: "happy", mouth: "laugh" }], { flip: true })],
        sfxText: [{ text: "ตุ้ม ตุ้ม ตุ้ม!", x: 90, y: 560, size: 92, rot: -6, color: "#f6d36a", t: (vo("d06") + 0.9) - 0.1, end: D("d06") - 0.1 }],
        fx(tl, id, t0, L) { hud(id, H_BAT(2)); shadows(L, id, act("d06"), -0.5); BRI.badge(tl, L.light, t0, D("d06"), { kind: "drum", x: 820, y: 500, tone: "yellow", label: "งานวัด", at: (vo("d06") + 0.9) + 0.2 }); } });
