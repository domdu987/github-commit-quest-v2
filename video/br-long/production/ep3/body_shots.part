      shot("d13", { ...NIGHTF("d13", { enemy: 0 }), cam: { keys: [{ t: 0, ...fr(600, 1130, 1.2, 540, 940), drift: { s: 0.01 } }, { t: F("d13", 0, 1) + 0.3, ...fr(1400, 1130, 1.0, 540, 940), glide: 1.4 }] }, shake: JKC.impact(F("d13", 0, 1), 1.2, 9),
