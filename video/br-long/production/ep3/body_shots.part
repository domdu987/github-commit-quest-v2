          BRI.badge(tl, L.light, t0, D("d11"), { kind: "buffalo", x: 800, y: 520, tone: "red", label: "อย่าให้ควายเห็น", at: F("d11", 0, 1) + 0.5 }); } });
      shot("d12", { ...NIGHTF("d12", { enemy: 0 }), cam: { keys: [{ t: 0, ...fr(1240, 1060, 1.3, 540, 940), drift: { s: 0.01 } }, { t: F("d12", 0, 1), ...fr(1700, 1080, 1.1, 540, 940), glide: 1.2 }] },
