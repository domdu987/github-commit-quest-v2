          tl.set(gl, { opacity: 0 }, 0); tl.to(gl, { opacity: 1, duration: 0.08 }, on); tl.to(`#${id}-lamp`, { attr: { cx: 1960 }, duration: 1.6, ease: "none" }, t0 + F("d12", 0, 1) - 0.1);
