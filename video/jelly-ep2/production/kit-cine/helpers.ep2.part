      const SUN = { from: "right", rim: "#fff6dc", rimOp: 0.8, shade: "#2a2440", shadeOp: 0.26, cast: { len: 1.3, op: 0.28 }, vol: false };
      const DAWN = { from: "right", rim: "#ffd8a0", rimOp: 0.85, shade: "#2a1a30", shadeOp: 0.3, cast: { len: 1.0, op: 0.25 }, vol: false };
      const GBR = { top: "#fff4d8", bottom: "#c8eef8", op: 0.1 }, GDAWN = { top: "#ffe0b0", bottom: "#d89a7a", op: 0.12 };
      const BRK = { "แล้วไปดูเรื่องเต็มได้ที่ช่องยูทูบของเรา": "แล้วไปดูเรื่องเต็ม\nได้ที่ช่องยูทูบของเรา" };
      const brk = (t) => { if (BRK[t]) return BRK[t]; const plain = t.replace(/[\[\]{}“”]/g, ""); if (plain.length <= 24) return t; let d = 0, best = -1, bd = 1e9;
        for (let i = 0; i < t.length; i++) { const ch = t[i]; if (ch === "[" || ch === "{") d++; else if (ch === "]" || ch === "}") d--; else if (ch === " " && d === 0) { const m = Math.abs(i - t.length / 2); if (m < bd) { bd = m; best = i; } } }
        return best < 0 ? t : t.slice(0, best) + "\n" + t.slice(best + 1); };
      const caps0 = caps; caps = (k, lines, o) => caps0(k, lines, o).filter((c) => c.end > 0.05).map((c) => ({ ...c, t: Math.max(0, c.t), text: brk(c.text) }));
      const A = (who, x, y, s, track, extra = {}) => { if (extra.talk) track.talk = extra.talk; return { who, x, y, s, track, blinks: [0.8, 2.9], ...extra }; };
      const TALK = (k, i, m) => [vo(k, i), voEnd(k, i), m];
      const UW = (L, sy) => put(L.fg, `<rect x="-900" y="${sy + 6}" width="2900" height="2000" fill="#2aa0bc" opacity=".3"/>`);
      const show = (tl, sel, a, b) => { tl.set(sel, { opacity: 0 }, 0); tl.set(sel, { opacity: 1 }, a); if (b !== undefined) tl.set(sel, { opacity: 0 }, b); };
      const pop = (tl, sel, t, o = {}) => { tl.set(sel, { opacity: 0 }, 0); tl.fromTo(sel, { opacity: 0, scale: o.s0 ?? 0.4, svgOrigin: o.origin || "0 0" }, { opacity: 1, scale: 1, svgOrigin: o.origin || "0 0", duration: o.d ?? 0.45, ease: o.ease || "back.out(2.6)", immediateRender: false }, t); };
      // the source chip, bottom right (in-world tone: a foam-white slab with a red-cross badge); 16:9 moves it with the .ui layer
      const SRC = (L, tl, t0, dur, text) => { const id = `src${Math.round(t0 * 100)}`, w = 19 * text.length + 70;
        put(L.light, `<g transform="translate(${1050 - w},1790)"><g id="${id}" class="ui pagepos"><rect x="4" y="-24" width="${w}" height="52" rx="14" fill="#0a1a24" opacity=".28"/><rect x="0" y="-28" width="${w}" height="52" rx="14" fill="#fffaf0" stroke="#2a2420" stroke-width="3"/>
          <g transform="translate(28,-2)"><circle r="15" fill="#d8312a" stroke="#2a2420" stroke-width="2.4"/><path d="M-7,0h14M0,-7v14" stroke="#fff" stroke-width="4.4" stroke-linecap="round"/></g>
          <text x="54" y="6" font-family="Kanit" font-weight="700" font-size="25" fill="#1e2a3a">${text}</text></g></g>`);
        pop(tl, `#${id}`, t0, { s0: 0.6, d: 0.35, origin: `${w} 0` }); tl.to(`#${id}`, { opacity: 0, duration: 0.2, immediateRender: false }, t0 + dur - 0.2); };
      // extra poses
      Rig.MODES.holdNose = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -118, faF: -150, uaB: 10, faB: -30, torso: -5, head: -10 + 2 * Math.sin(u * 7), bodyY: -2 });
      Rig.MODES.grabShin = (u, o) => { const j = Math.sin(u * 47) * 1.6; return { ...Rig.MODES.idle(u, o), thF: -78, shF: 96, thB: 2, shB: 4, torso: 10 + j * 0.5, head: -14 + j, uaF: -24 + j, faF: -14, uaB: 40 - j, faB: -80, bodyY: 0 }; };
      Rig.MODES.reachBottle = (u, o) => { const j = (o.shake ?? 1) * (Math.sin(u * 31) * 2.2 + Math.sin(u * 53) * 1.2); return { ...Rig.MODES.crouch(u, o), uaF: -70 + j, faF: -30 + j, uaB: -30, faB: -40, torso: 24, head: -10 }; };
      Rig.MODES.setDown = (u, o) => { const k = Math.min(1, u / 0.9); return { ...Rig.MODES.crouch(u, o), uaF: -70 + 50 * k, faF: -30 + 20 * k, uaB: -30, faB: -40, torso: 24 + 6 * k, head: -10 - 8 * k }; };
      Rig.MODES.basketDown = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: -44, faF: -8, uaB: -38, faB: -12, torso: 26, head: -16 });
      Rig.MODES.pourLow = (u, o) => { const j = Math.sin(u * 31) * 1.2; return { ...Rig.MODES.crouch(u, o), uaF: -34 + j, faF: -22 + j, uaB: -20, faB: -40, torso: 34, head: 26 }; };
      Rig.MODES.crouchLow = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: 8, faF: -30, uaB: -10, faB: -30, torso: 16, head: -4 });
      Rig.MODES.sing = (u, o) => { const b = Math.sin(u * 2 * Math.PI / 0.7); return { ...Rig.MODES.idle(u, o), uaF: -130 + 18 * b, faF: -30, uaB: 120 - 18 * b, faB: 30, torso: 4 * b, head: 8 * b, bodyY: -10 * Math.abs(b) }; };
      Rig.MODES.recite = (u, o) => { const b = Math.sin(u * 2 * Math.PI / 1.4); return { ...Rig.MODES.idle(u, o), uaF: -100 + 6 * b, faF: -60 + 10 * b, uaB: 4, faB: -12, torso: 1, head: 3 * b }; };
      // ต้น's arm from the top-left, the fist closed round the bottle's middle, its open neck aimed at the leg (rot: the neck's direction, deg)
      const holdBottle = (gid, cx, cy, rot, s = 1.25) => { const a = rot * Math.PI / 180, mx = cx + Math.sin(a) * 92 * s, my = cy - Math.cos(a) * 92 * s;
        return { mouth: [mx, my], svg: `<g id="${gid}"><path d="M${cx},${cy}L${cx - 330},${cy - 560}" stroke="#1e1a16" stroke-width="${92 * s}" stroke-linecap="round"/><path d="M${cx},${cy}L${cx - 330},${cy - 560}" stroke="#5aa8d8" stroke-width="${84 * s}" stroke-linecap="round"/>
          <path d="M${cx - 40},${cy - 70}L${cx - 330},${cy - 560}" stroke="#4a90c0" stroke-width="${24 * s}" stroke-linecap="round" opacity=".6"/><circle cx="${cx}" cy="${cy}" r="${40 * s}" fill="#c08a5e" stroke="#1e1a16" stroke-width="4"/>
          <g transform="translate(${cx},${cy}) rotate(${rot})"><g transform="scale(${s}) translate(0,100)">${Jelly.bottle(0, 0, 1, { cap: false })}</g>
            <rect x="${-50 * s}" y="${-34 * s}" width="${100 * s}" height="${62 * s}" rx="${24 * s}" fill="#c08a5e" stroke="#1e1a16" stroke-width="4"/>
            ${[-30, -10, 10, 30].map((x) => `<path d="M${x * s},${-30 * s}V${24 * s}" stroke="#8a5a3a" stroke-width="3"/>`).join("")}<path d="M${-48 * s},${-6 * s}Q${-62 * s},${-30 * s} ${-40 * s},${-40 * s}" stroke="#1e1a16" stroke-width="3" fill="#c08a5e"/></g></g>` }; };
      // the vinegar post with ยายลออ's rhyme board hung from a bamboo arm lashed across it (in the world) · ids `${pid}-on`, `${pid}-tick`
      const postBoard = (x, y, s, pid, o = {}) => { const k = 0.3 * s, py = y - 226 * s, by = py + 122 * k;
        return `<g>${Jelly.post(x, y, s, { full: o.full ?? 0 })}<path d="M${x - 300 * k},${py}H${x + 300 * k}" stroke="#1e1a16" stroke-width="${16 * s}" stroke-linecap="round"/><path d="M${x - 300 * k},${py - 2 * s}H${x + 300 * k}" stroke="#c8b070" stroke-width="${10 * s}" stroke-linecap="round"/>
          ${[-1, 1].map((d) => `<path d="M${x + d * 250 * k},${py - 6 * s}v${12 * s}" stroke="#8a6a3a" stroke-width="${6 * s}"/>`).join("")}<path d="M${x - 16 * s},${py - 10 * s}l${32 * s},${20 * s}M${x + 16 * s},${py - 10 * s}l${-32 * s},${20 * s}" stroke="#8a6a3a" stroke-width="${5 * s}"/>
          <g transform="translate(${x},${by}) scale(${k})">${Jelly.ruleBoard(0, 0, { active: -1 })}
            <g id="${pid}-on" opacity="0"><g transform="translate(0,136)"><rect x="-350" y="-10" width="700" height="132" rx="16" fill="#f2c230" opacity=".6" stroke="#1e1a16" stroke-width="4"/></g></g>
            <g transform="translate(300,192)"><g id="${pid}-tick" opacity="0"><circle r="34" fill="#3aa86a" stroke="#1e1a16" stroke-width="5"/><path d="M-16,0l10,12l21,-24" stroke="#fff" stroke-width="8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></g></g></g></g>`; };
      const POST = [700, 1330, 0.62], TOWER = [900, 1270, 0.82];
      const BEACH = (id, x = {}) => ({ id, seed: 5, boats: 2, tower: TOWER, rock: [160, 690, 0.5],
        umbrellas: [[90, 1300, 0.8, "#f2c230"], [1040, 1360, 0.85, "#3a9ad8"], [430, 1240, 0.55, "#d8312a"]],
        life: [["mat", 120, 1380, 0.8, "#e8482a"], ["cooler", 250, 1350, 0.6], ["towel", 1000, 1420, 0.8, "#3aa86a"], ["castle", 560, 1480, 0.7], ["flops", 860, 1560, 0.8]], ...x });
      Rig.CAST.jWanBare = { v2: { ...Rig.CAST.jWan.v2, extra: "" } };
      Rig.CAST.jWomanBottle = { v2: Rig.CAST.jWoman.v2, hand: `<g transform="translate(0,104) rotate(150)">${Jelly.bottle(0, 0, 0.5, { cap: false })}</g>`, keep: "F" };
      Rig.CAST.jManBottle = { v2: { ...Rig.CAST.jGuard.v2, top: { kind: "tee", c: "#f2c230", sleeve: "short" }, print: "", bottom: { kind: "shorts", c: "#2a3a5a" } }, hand: `<g transform="translate(0,104) rotate(170)">${Jelly.bottle(0, 0, 0.5, { cap: false })}</g>`, keep: "F" };
      // the duck ring lying at someone's feet (the ring has slipped)
      const ringAt = (x, y, s, rid) => `<g id="${rid}">${TideCast.duckRing(x, y, s, {})}</g>`;
      const SURF = 730;   // the waterline at 38 % of the frame
      // ภูมิ sitting on the sand, his stung shin across the front (welts + a tentacle still on it), in the world
      const shin = (x, y, s) => `<g transform="translate(${x},${y}) scale(${s})">${Jelly.ladder([[146, -12], [200, 4], [264, 20]], { w: 7 })}${Jelly.ladder([[156, 16], [180, -14], [212, 16], [240, -10], [260, 14]], { w: 5 })}
        <path d="M264,20Q300,46 294,76Q286,106 324,114" stroke="#f2feff" stroke-width="3.4" fill="none" stroke-linecap="round"/><path d="M264,20Q300,46 294,76Q286,106 324,114" stroke="#a88ae8" stroke-width="1.4" fill="none" stroke-dasharray="2 5"/></g>`;
      // ---------- 12. the crowd: a woman pushes a bottle and says rub it; ภูมิ begs; น้ำหวาน recites the rhyme to her father ----------
      // an arm reaching in from the edge with a water bottle held out (screen space · from (ex, ey) to the hand at (hx, hy))
      const edgeArm = (ex, ey, hx, hy, sleeve, skin = "#c08a5e") => { const a = Math.atan2(hy - ey, hx - ex) * 180 / Math.PI;
        return `<path d="M${ex},${ey}L${hx},${hy}" stroke="#1e1a16" stroke-width="64" stroke-linecap="round"/><path d="M${ex},${ey}L${hx},${hy}" stroke="${sleeve}" stroke-width="56" stroke-linecap="round"/>
          <path d="M${(ex + hx * 2) / 3},${(ey + hy * 2) / 3}L${hx},${hy}" stroke="${skin}" stroke-width="44" stroke-linecap="round"/><g transform="translate(${hx},${hy}) rotate(${a + 90})"><g transform="translate(0,40) scale(.6)">${Jelly.bottle(0, 0, 1, { cap: false })}</g>
          <rect x="-30" y="-24" width="60" height="44" rx="18" fill="${skin}" stroke="#1e1a16" stroke-width="3.4"/></g>`; };
      const SURF2 = 520;
      const NOG = { grade: null, shake: null };
      // captions from several caps() calls, sorted and trimmed so one never overlaps the next (the real-file sheet caught 1:41)
      const capsJ = (...lists) => { const out = lists.flat().sort((a, b) => a.t - b.t); for (let n = 0; n + 1 < out.length; n++) out[n].end = Math.min(out[n].end, out[n + 1].t - 0.03); return out; };
      const hide = (tl, sel, at) => tl.set(sel, { opacity: 0 }, at);
      // a screen-space insert (ECU) over a plain backdrop, shown [a, b) seconds into the piece
      const insert = (L, tl, t0, iid, a, b, svg, z = 1.06) => {
        put(L.light, `<g id="${iid}"><g id="${iid}-z">${svg}</g></g>`);
        tl.set(`#${iid}`, { opacity: 0 }, 0); tl.set(`#${iid}`, { opacity: 1 }, t0 + a); tl.set(`#${iid}`, { opacity: 0 }, t0 + b);
        tl.fromTo(`#${iid}-z`, { scale: 1, svgOrigin: "540 900" }, { scale: z, svgOrigin: "540 900", duration: b - a, ease: "none", immediateRender: false }, t0 + a);
      };
      const SAND = (sid) => `<defs><linearGradient id="${sid}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#d8c69e"/><stop offset="1" stop-color="#bfa97e"/></linearGradient></defs><rect x="-100" y="-100" width="1280" height="2200" fill="url(#${sid})"/>
        ${Array.from({ length: 40 }, (_, k) => `<ellipse cx="${(k * 137) % 1080}" cy="${(k * 263) % 1920}" rx="${4 + (k % 4)}" ry="${2 + (k % 3)}" fill="#a8946a" opacity=".5"/>`).join("")}`;
