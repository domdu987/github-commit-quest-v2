          tl.fromTo("#kn-m1", { scaleX: 1, svgOrigin: "0 900" }, { scaleX: 1.12, svgOrigin: "0 900", duration: 0.22, repeat: Math.floor((b - 0.8) / 0.22), yoyo: true, ease: "sine.inOut", immediateRender: false }, t0 + 0.8);
          tl.to("#kn-vein", { strokeDashoffset: 0, duration: 1.4, ease: "power1.in", immediateRender: false }, t0 + b + 0.1);
          tl.fromTo("#kn-hrt", { scale: 1, svgOrigin: "0 0" }, { scale: 1.3, svgOrigin: "0 0", duration: 0.16, repeat: 9, yoyo: true, ease: "power2.out", immediateRender: false }, t0 + b + 1.3);
          pop(tl, "#kn-st", t0 + b + 1.6, { s0: 2.2, d: 0.3, ease: "power3.in" });
          SRC(L, tl, t0 + 0.4, D("c_know") - 0.5, "ที่มา: กรมควบคุมโรค");
