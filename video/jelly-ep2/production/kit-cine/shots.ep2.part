            <g transform="translate(650,1660)">${Jelly.ladder([[-30, -20], [0, 0], [30, -16]], { w: 6 })}</g>
            <g transform="translate(540,1360) rotate(-8)"><g id="kn-st"><rect x="-230" y="-70" width="460" height="140" rx="20" fill="none" stroke="#b8241e" stroke-width="12"/><text y="34" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="96" fill="#b8241e">อยู่นิ่งๆ</text></g></g></g>`;
          put(L.set, g);
          show(tl, "#kn-a", t0, t0 + b); show(tl, "#kn-b", t0 + b);
