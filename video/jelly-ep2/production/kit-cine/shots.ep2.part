            [[200, 900, 0.9], [520, 760, 1.1], [860, 940, 0.95], [360, 1250, 1.2], [760, 1300, 1.0], [120, 1500, 0.8], [980, 1520, 0.9], [560, 1580, 0.75]].map(([x, y, s], k) =>
              `<g filter="url(#sh-sil)" class="sh-j">${Jelly.box(x, y, s, { seed: 60 + k, len: 340, per: k % 2 ? 5 : 1, sway: k % 2 ? 1 : -1 })}</g>`).join("");
