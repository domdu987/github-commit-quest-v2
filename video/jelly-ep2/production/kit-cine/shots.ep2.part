          A("jTon", 720, 1760, 1.0, [{ t: 0, mode: "idle", eyes: "worry", mouth: "o" }, { t: voEnd("c_leave", 0), mode: "run", eyes: "wide", mouth: "flat" }], { talk: [TALK("c_leave", 0, "o")], moveTo: { x: 1500, y: 1760, at: voEnd("c_leave", 0), dur: 0.6, ease: "power2.in" } }),
        ],
