        fx(tl, id, t0, L) { put(L.act, shin(MAT[0] + 40, MAT[1] + 10, 0.95));
          FGB(L, tl, t0, 0, D("c_leave"), "fg10", `<path d="M640,-60Q900,40 1180,-20V260Q1000,200 820,220Q720,120 640,-60Z" fill="#c8a868"/><path d="M700,20Q900,90 1160,60" stroke="#d8312a" stroke-width="22" fill="none"/>`); } });
