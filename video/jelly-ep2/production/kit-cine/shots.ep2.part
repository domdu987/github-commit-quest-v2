          A("jWanVin", 860, 1600, 0.66, [{ t: 0, mode: "walk", eyes: "normal", mouth: "o" }, { t: CT(16, "c_back"), mode: "idle", eyes: "closed", mouth: "smile" }], { flip: true, talk: [TALK("c_back", 0, "o")], moveTo: { x: 590, y: 1760, s: 0.74, dur: CT(16, "c_back"), ease: "none" } }),
