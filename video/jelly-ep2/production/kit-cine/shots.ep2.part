      // ===== หนวดใส EP.2 · น้ำส้มราดไว้ นับสามสิบไป · CINEMA BIBLE cut (video/jelly-ep2/production/shotlist.json · 30 cuts) =====
      // frame 0 picks up EP.1's last image (the empty duck ring over the swarm) → ภูมิ's hand clawing the sand to get up → the wide: the
      // command → ต้น looks out to sea → "พ่ออย่าทิ้งผม" / ต้น still / hands press him down → the leg cut open: still vs moving → he leaves
      // him with a stranger → the foam edge: "อย่าลงไป!" → the swarm in the shallows (the sting) → held back → this morning: the loose ring →
      // "พ่อ!" น้ำหวาน walks down from the tower with a vinegar bottle → her arm, the empty post → she sings rule 2 → the board → the kitchen
      // shelf, 4–6 %, 30 s → the pour and the count → ต้น's shame → "ตาก็ไม่เชื่อกลอน" and ภูมิ arching behind → can't breathe → the empty
      // road → the hand on the chest, the phone on speaker (the hold) → the skin: vinegar stops the stingers → the ambulance on the map → the
      // choice → black → the end board.
      // cine.js grades / vignettes / grains / freezes or breathes the camera per cut (Cine.episode in foot.part); no per-shot grade.
      // vinegar bottle (cream plastic, yellow label, red cap) · (x, y) = the base
      const VB = (x, y, s = 1, o = {}) => `<g transform="translate(${x},${y}) scale(${s}) rotate(${o.tilt ?? 0})"><path d="M-36,0Q-40,-4 -40,-14V-130Q-40,-150 -24,-160Q-14,-168 -14,-182V-196H14V-182Q14,-168 24,-160Q40,-150 40,-130V-14Q40,-4 36,0Z" fill="#f6efe0" stroke="#2e2a26" stroke-width="3"/>
        <rect x="-40" y="-118" width="80" height="62" fill="#f2c230" stroke="#2e2a26" stroke-width="2.4"/><text x="0" y="-92" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="15" fill="#7a1a10">น้ำส้มสายชู</text>
        <text x="0" y="-66" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="20" fill="#7a1a10">5%</text><path d="M-28,-140Q-30,-60 -26,-20" stroke="#fff" stroke-width="5" fill="none" opacity=".7" stroke-linecap="round"/>
        ${o.cap === false ? `<ellipse cx="0" cy="-197" rx="13" ry="4" fill="#f6efe0" stroke="#2e2a26" stroke-width="2"/>` : `<rect x="-17" y="-216" width="34" height="22" rx="4" fill="#d8312a" stroke="#2e2a26" stroke-width="2.6"/>`}</g>`;
      Rig.CAST.jWanVin = { v2: { ...Rig.CAST.jWan.v2, extra: "" }, hand: `<g transform="translate(0,104) rotate(178)">${VB(0, 0, 0.5)}</g>`, keep: "F" };
      Rig.CAST.jTonVin = { v2: Rig.CAST.jTon.v2, hand: `<g transform="translate(0,104) rotate(150)">${VB(0, 0, 0.5, { cap: false })}</g>`, keep: "F" };
      Rig.CAST.jWomanPhone = { v2: null, hand: `<g transform="translate(0,118) rotate(-8)"><rect x="-18" y="-32" width="36" height="64" rx="7" fill="#2a2a32" stroke="#2e2a26" stroke-width="2.2"/><rect x="-14" y="-27" width="28" height="50" rx="3" fill="#7ad0a0"/></g>`, keep: "F" };
      Rig.CAST.jWomanHat = { v2: { ...Rig.CAST.jWoman.v2, faceTop: `<g transform="translate(0,22)"><path d="M-150,-596Q0,-690 150,-596Q0,-612 -150,-596Z" fill="#d8b878" stroke="#2e2a26" stroke-width="2.6"/><path d="M-80,-620Q0,-700 80,-620" fill="#c8a868" stroke="#2e2a26" stroke-width="2.6"/><path d="M-82,-622Q0,-634 82,-622" stroke="#d8312a" stroke-width="7" fill="none"/></g>` } };
      Rig.CAST.jWomanPhone.v2 = Rig.CAST.jWomanHat.v2;   // the same stranger as cuts 3 and 10: straw hat, no glasses
      Rig.MODES.claw = (u, o) => { const s = Rig.MODES.sit(u, o); return { ...s, uaF: 40, faF: 30, torso: 18 + 4 * Math.sin(u * 6), head: -6, bodyY: (s.bodyY || 0) - 10 - 6 * Math.abs(Math.sin(u * 5)) }; };
      Rig.MODES.reach = (u, o) => { const j = Math.sin(u * 9) * 3; return { ...Rig.MODES.sit(u, o), uaF: -70 + j, faF: -30, uaB: -50 - j, faB: -30, torso: 10, head: -12 }; };
      Rig.MODES.pressDown = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: -60, faF: -50, uaB: -50, faB: -60, torso: 30, head: 10 });
      Rig.MODES.gasp = (u, o) => { const b = Math.sin(u * 2 * Math.PI / 0.55), s = Rig.MODES.sit(u, o); return { ...s, uaF: -20, faF: -90, uaB: 20, faB: -80, torso: -14 + 4 * b, head: -18 + 5 * b, bodyY: (s.bodyY || 0) - 4 * Math.abs(b) }; };
      Rig.MODES.armUp = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -150, faF: -20, uaB: 10, faB: -20, head: -6 });
      // one knee down: front thigh level and its shin straight down to the planted foot, back knee on the sand, the shin lying behind
      Rig.MODES.kneel = (u, o) => ({ ...Rig.MODES.idle(u, o), thF: -86, shF: 86, thB: 0, shB: 90, uaF: -10, faF: -30, uaB: 6, faB: -20, torso: 6, head: 4, bodyY: 286 });
      Rig.MODES.pourKneel = (u, o) => ({ ...Rig.MODES.kneel(u, o), uaF: -66, faF: -24, uaB: -40, faB: -50, torso: 16, head: 18 });
      Rig.MODES.hug = (u, o) => ({ ...Rig.MODES.kneel(u, o), uaF: -58, faF: -88, uaB: -50, faB: -96, torso: 14, head: 12 });
      Rig.MODES.count = (u, o) => { const b = Math.floor(u / 1.25) % 2; return { ...Rig.MODES.idle(u, o), uaF: -96 + 8 * b, faF: -90, uaB: 10, faB: -20, head: 6 }; };
      Rig.MODES.heldBack = (u, o) => { const j = Math.sin(u * 23) * 3; return { ...Rig.MODES.idle(u, o), uaF: -120 + j, faF: -30, uaB: -110 - j, faB: -40, torso: -14 + j * 0.3, head: -10 }; };
      Rig.MODES.waveBig = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -160 + 20 * Math.sin(u * 9), faF: -20, uaB: 10, faB: -20, head: -8 });

      const FGB = (L, tl, t0, a, b, fid, svg) => { put(L.light, `<defs><filter id="${fid}-f" x="-.3" y="-.3" width="1.6" height="1.6"><feGaussianBlur stdDeviation="14"/></filter></defs><g id="${fid}" filter="url(#${fid}-f)">${window.LANDSCAPE ? `<g transform="translate(-660,0) scale(2.2222,1)"><rect width="1080" height="1920" opacity="0"/>${svg}</g>` : svg}</g>`);
        tl.set(`#${fid}`, { opacity: 0 }, 0); tl.set(`#${fid}`, { opacity: 1 }, t0 + a); if (b !== undefined) tl.set(`#${fid}`, { opacity: 0 }, t0 + b); };
      const RING_FAR = [880, 690, 0.24];
      // the beach of the episode: the tower on the right, the vinegar post next to it, the mat where ภูมิ sits
      const BEACH2 = (id, x = {}) => BEACH(id, { tower: [930, 1270, 0.82], umbrellas: [[90, 1300, 0.8, "#f2c230"], [1040, 1360, 0.85, "#3a9ad8"]], life: [["mat", 330, 1760, 0.95, "#e8482a"], ["cooler", 120, 1350, 0.6], ["flops", 860, 1560, 0.8]], ...x });
      const MAT = [330, 1760];
      const PEAK = [
        [160, 980, 0.38, 1, 0], [380, 1060, 0.32, 5, 0], [820, 1000, 0.36, 1, 0], [960, 1150, 0.3, 5, 0], [600, 1180, 0.34, 1, 0], [240, 1300, 0.3, 5, 0],
        [300, 1180, 0.72, 5, 1], [720, 1260, 0.8, 1, 1], [500, 1460, 0.75, 5, 1], [900, 1500, 0.7, 5, 1], [130, 1560, 0.68, 1, 1],
        [80, 1180, 1.5, 5, 2], [1010, 1720, 1.6, 1, 2], [620, 1900, 1.4, 5, 2]];
      const swarm = (tl, t0, L, pid, o = {}) => { const lay = { 0: L.mid, 1: L.set, 2: L.fg };
        put(L.mid, `<defs><filter id="${pid}-blur"><feGaussianBlur stdDeviation="2.2"/></filter>${o.sil ? `<filter id="${pid}-sil"><feColorMatrix type="matrix" values="0 0 0 0 .02  0 0 0 0 .08  0 0 0 0 .12  0 0 0 .92 0"/></filter>` : ""}</defs>`);
        PEAK.forEach(([x, y, sc, per, dp], k) => {
          put(lay[dp], `<g id="${pid}-${k}" opacity="${o.sil ? [0.7, 0.9, 1][dp] : [0.45, 0.85, 0.95][dp]}"${o.sil ? ` filter="url(#${pid}-sil)"` : dp === 0 ? ` filter="url(#${pid}-blur)"` : ""}>${Jelly.box(x, y + (o.dy || 0), sc, { seed: 40 + k, per, len: [260, 300, 340][dp] + 30 * (k % 3), lit: [1.0, 1.3, 1.5][dp], glow: !o.sil && dp > 0, sway: k % 2 ? 0.9 : -0.9 })}</g>`);
          tl.fromTo(`#${pid}-${k}`, { y: 0 }, { y: -(20 + 14 * dp) - (k % 4) * 6, duration: 1.1 + (k % 5) * 0.27, repeat: 5, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0 + (k % 7) * 0.13); }); };

      // 1 · hook: EP.1's last image — the empty duck ring rocking on the surface, the swarm under it
      add("c_h1", { set: "jellySplit", setOpts: { id: "jh1", surf: 520, floor: 2100, seed: 9, towerX: 300 }, dark: 0, blur: { fg: 0, set: 0, mid: 0, far: 0 }, light: SUN,
        cam: { keys: [{ t: 0, ...fr(540, 980, 1.25, 540, 900) }] }, captions: caps("c_h1"),
        fx(tl, id, t0, L) {
          put(L.set, `<defs><linearGradient id="h1-deep" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0a2a30" stop-opacity="0"/><stop offset=".55" stop-color="#0c2a2c" stop-opacity=".55"/><stop offset="1" stop-color="#081c1e" stop-opacity=".82"/></linearGradient></defs><rect x="-900" y="530" width="2900" height="2200" fill="url(#h1-deep)"/>`);
          swarm(tl, t0, L, "h1");
          put(L.set, `<ellipse cx="540" cy="524" rx="230" ry="44" fill="#fff6c8" opacity=".5"/><g transform="translate(540,544)"><g id="h1-ring">${TideCast.duckRing(0, 0, 1.6, { water: true })}</g></g>`);
          tl.fromTo("#h1-ring", { y: -6, rotation: -3, svgOrigin: "0 0" }, { y: 6, rotation: 3, svgOrigin: "0 0", duration: 0.45, repeat: 2, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0);
        } });
      // 2 · hook: ECU ภูมิ's fingers digging into the sand by his stung calf — he is getting up
      add("c_h2", { set: "jellyHook", setOpts: { id: "jh2", title: " ", sub: " ", seed: 4 }, dark: 0, blur: { fg: 0, set: 0, act: 0 }, light: false,
        cam: { keys: [{ t: 0, ...fr(560, 1000, 1.15, 540, 980) }] }, captions: caps("c_h2"),
        fx(tl, id, t0, L) {
          document.getElementById("jh2-bt").setAttribute("display", "none");
          put(L.act, `<g transform="translate(560,560)"><g id="h2-hd"><path d="M-260,-560L-60,-120L60,-150L-120,-600Z" fill="#2a7ad0" stroke="#2e2a26" stroke-width="5"/>
            <path d="M-90,-170Q-150,-120 -140,-40Q-120,40 -40,60L120,50Q170,20 150,-40Q130,-120 60,-160Z" fill="#c08a5e" stroke="#2e2a26" stroke-width="5"/>
            ${[-110, -50, 10, 70].map((x, k) => `<path d="M${x},${30 - (k % 2) * 6}Q${x - 6},${90} ${x + 4},${130 + (k % 2) * 10}" stroke="#2e2a26" stroke-width="44" stroke-linecap="round" fill="none"/><path d="M${x},${30 - (k % 2) * 6}Q${x - 6},${90} ${x + 4},${130 + (k % 2) * 10}" stroke="#c08a5e" stroke-width="36" stroke-linecap="round" fill="none"/>`).join("")}
            <path d="M-170,140Q-40,120 140,150Q60,180 -40,176Q-120,174 -170,140Z" fill="#c8b48a" opacity=".9"/>${[0, 1, 2, 3, 4, 5].map((k) => `<circle id="h2-g${k}" cx="${-120 + k * 50}" cy="${150}" r="${5 + (k % 3) * 2}" fill="#bfa97e" stroke="#8a7650" stroke-width="1.4"/>`).join("")}</g></g>`);
          tl.fromTo("#h2-hd", { y: -40, rotation: -3, svgOrigin: "560 700" }, { y: 10, rotation: 2, svgOrigin: "560 700", duration: D("c_h2"), ease: "power2.out", immediateRender: false }, t0);
          [0, 1, 2, 3, 4, 5].forEach((k) => tl.fromTo(`#h2-g${k}`, { x: 0, y: 0 }, { x: (k - 2.5) * 22, y: -60 - (k % 3) * 20, duration: 0.5, ease: "power2.out", immediateRender: false }, t0 + 0.12 + k * 0.04));
        } });
      // 3–4 · the wide (the command, still) → MS: ต้น looks out to sea, ภูมิ's hand on his wrist; slow push-in
      add("c_h3", { set: "jellyBeach", setOpts: BEACH2("jb3", { ring: RING_FAR, post: [760, 1300, 0.62, 0] }), dark: 0, light: SUN,
        cam: { keys: [{ t: 0, ...fr(560, 1360, 1.0, 540, 1000) }, { t: CT(4, "c_h3"), ...fr(470, 1340, 1.95, 540, 900) }, { t: D("c_h3"), glide: D("c_h3") - CT(4, "c_h3"), ...fr(475, 1345, 2.2, 540, 900) }] },
        actors: [
          A("jPhum", MAT[0] + 40, MAT[1] + 10, 0.95, [{ t: 0, mode: "claw", eyes: "cry", mouth: "scream" }, { t: CT(4, "c_h3"), mode: "reach", eyes: "cry", mouth: "o" }]),
          A("jTon", 520, 1740, 1.0, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }]),
          A("jWomanHat", 820, 1700, 0.9, [{ t: 0, mode: "idle", eyes: "worry", mouth: "o" }], { flip: true }),
        ],
        captions: capsJ(caps("c_h3", [0]), caps("c_h3", [1])),
        fx(tl, id, t0, L) { put(L.act, shin(MAT[0] + 40, MAT[1] + 10, 0.95));
          tl.fromTo(`#jb3-ring`, { y: -4, rotation: -3, svgOrigin: `${RING_FAR[0]} ${RING_FAR[1]}` }, { y: 4, rotation: 3, svgOrigin: `${RING_FAR[0]} ${RING_FAR[1]}`, duration: 0.9, repeat: 6, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0); } });
      // 5–7 · "พ่อ อย่าทิ้งผม!" ภูมิ close (high) → ต้น close, still (the choice) → the hands press him down: "ห้ามลุก!"
      add("c_stay", { set: "jellyBeach", setOpts: BEACH2("jb4", { tower: false, umbrellas: [[1040, 1360, 0.85, "#3a9ad8"]] }), dark: 0, blur: { set: 3, mid: 4, far: 4 }, light: SUN,
        cam: { keys: [{ t: 0, ...fr(MAT[0] + 58, 1515, window.LANDSCAPE ? 1.6 : 2.6, 540, window.LANDSCAPE ? 880 : 880) }, { t: CT(6, "c_stay"), ...fr(605, 1300, 3.3, 540, 1020) }] },
        actors: [
          A("jPhum", MAT[0] + 40, MAT[1] + 10, 0.95, [{ t: 0, mode: "reach", eyes: "cry", mouth: "scream" }], { talk: [TALK("c_stay", 0, "scream")] }),
          A("jTon", 720, 1740, 1.0, [{ t: 0, mode: "idle", eyes: "worry", mouth: "flat" }], { flip: true, until: CT(6, "c_stay") }),
          A("jTon", 560, 1740, 1.0, [{ t: 0, mode: "idle", eyes: "worry", mouth: "flat" }, { t: vo("c_stay", 1), mode: "point", eyes: "angry", mouth: "o" }], { flip: true, from: CT(6, "c_stay"), talk: [TALK("c_stay", 1, "o")] }),
        ],
        captions: caps("c_stay", undefined, { quote: true }),
        fx(tl, id, t0, L) { put(L.act, shin(MAT[0] + 40, MAT[1] + 10, 0.95));
          FGB(L, tl, t0, CT(6, "c_stay"), CT(7, "c_stay"), "fg6", `<path d="M-60,1500Q60,1380 260,1400Q330,1520 300,2000H-60Z" fill="#2a7ad0"/>`);
          const a = CT(7, "c_stay");
          insert(L, tl, t0, "st-pr", a, D("c_stay"), SAND("st-s") + `<path d="M-100,1300Q540,1120 1180,1300V2100H-100Z" fill="#2a7ad0" stroke="#1e1a16" stroke-width="6"/><path d="M380,1180Q540,1120 700,1180L680,1260Q540,1220 400,1260Z" fill="#c08a5e" stroke="#1e1a16" stroke-width="5"/>
            <path d="M-100,1400Q540,1240 1180,1400" stroke="#4a90c0" stroke-width="14" fill="none" opacity=".6"/>
            ${[[230, 1150, -18], [850, 1150, 18]].map(([x, y, r]) => `<g transform="translate(${x},${y}) rotate(${r})"><g class="st-hand"><path d="M-40,-700L-60,-120L80,-120L60,-700Z" fill="#5aa8d8" stroke="#1e1a16" stroke-width="6"/><path d="M-80,-140Q-120,0 -60,80H100Q140,0 110,-140Z" fill="#c08a5e" stroke="#1e1a16" stroke-width="6"/>
              ${[-50, -10, 30, 70].map((fx) => `<path d="M${fx},40V140" stroke="#1e1a16" stroke-width="40" stroke-linecap="round"/><path d="M${fx},40V140" stroke="#c08a5e" stroke-width="32" stroke-linecap="round"/>`).join("")}</g></g>`).join("")}`, 1.05);
          put(L.light, `<g transform="translate(540,0)"><g id="fsg2"><path d="M-150,-10V70M150,-10V70" stroke="#8a6a3a" stroke-width="6"/>
            <path d="M-260,70Q-266,64 -250,62H250Q266,64 262,76L258,190Q258,204 244,204H-246Q-262,202 -260,188Z" fill="#a88454" stroke="#1e1a16" stroke-width="5"/>
            <rect x="-238" y="88" width="220" height="62" rx="31" fill="#d8312a" stroke="#1e1a16" stroke-width="4"/><text x="-128" y="130" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="34" fill="#fff">กดติดตาม</text>
            <rect x="0" y="88" width="238" height="62" rx="14" fill="#fffaf0" stroke="#1e1a16" stroke-width="4"/><path d="M20,100L50,119L20,138Z" fill="#d8312a"/><text x="140" y="130" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="30" fill="#1e2a3a">เรื่องเต็ม</text>
            <text x="0" y="186" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="24" fill="#2a1a0a">ดูเรื่องเต็มที่ช่อง YouTube</text></g></g>`);
          const f3 = 10.3 - SH["c_stay"].start;
          tl.set("#fsg2", { opacity: 0 }, 0);
          tl.fromTo("#fsg2", { opacity: 0, y: -230 }, { opacity: 1, y: 20, duration: 0.5, ease: "back.out(1.8)", immediateRender: false }, t0 + f3);
          tl.to("#fsg2", { rotation: 1.6, svgOrigin: "0 0", duration: 0.6, yoyo: true, repeat: 3, ease: "sine.inOut", immediateRender: false }, t0 + f3 + 0.5);
          tl.to("#fsg2", { opacity: 0, y: -230, duration: 0.4, ease: "power2.in", immediateRender: false }, t0 + f3 + 2.7);
          tl.fromTo("#st-pr .st-hand", { y: -60 }, { y: 0, duration: 0.25, ease: "power3.out", immediateRender: false }, t0 + a);
        } });
      // 8–9 · the leg cut open: still → venom seeps slowly · moving → the muscle squeezes the vein, venom runs · up to the chest, the stamp
      add("c_know", { dark: 0, light: false,
        cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }, { t: CT(9, "c_know") - 0.01, glide: CT(9, "c_know") - 0.01, ...fr(540, 990, 1.08, 540, 960) }, { t: CT(9, "c_know"), ...fr(540, 960, 1.0, 540, 960) }] },
        captions: caps("c_know"),
        fx(tl, id, t0, L) {
          const b = CT(9, "c_know");
          let g = `<defs><linearGradient id="kn-bg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e8f6fa"/><stop offset="1" stop-color="#bfe4ee"/></linearGradient>
            <radialGradient id="kn-v"><stop offset="0" stop-color="#8a3ad8" stop-opacity=".9"/><stop offset="1" stop-color="#a85ae8" stop-opacity="0"/></radialGradient></defs>
            <rect x="-200" y="-200" width="1480" height="2400" fill="url(#kn-bg)"/>`;
          // A: two calves side by side, each cut open: skin / muscle / the vein; left still (นิ่ง), right moving (ขยับ)
          const calf = (cx, tag, lab) => `<g transform="translate(${cx},0)"><text x="0" y="300" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="58" fill="${lab}">${tag}</text>
            <path d="M-150,380Q-170,800 -120,1240Q-100,1420 -150,1560H150Q100,1420 120,1240Q170,800 150,380Z" fill="#e8b08a" stroke="#1e1a16" stroke-width="6"/>
            <g id="kn-m${tag === "นิ่ง" ? 0 : 1}"><path d="M-110,420Q-140,800 -90,1220Q-60,1300 -100,1520H100Q60,1300 90,1220Q140,800 110,420Z" fill="#d8665a" stroke="#a83a30" stroke-width="4"/>
              ${[0, 1, 2, 3, 4].map((k) => `<path d="M-90,${520 + k * 200}Q0,${490 + k * 200} 90,${520 + k * 200}" stroke="#b8443a" stroke-width="4" fill="none" opacity=".6"/>`).join("")}</g>
            <path d="M0,1540V420" stroke="#5a2a8a" stroke-width="40" stroke-linecap="round"/><path d="M0,1540V420" stroke="#8a4ab8" stroke-width="26" stroke-linecap="round"/>
            ${[0, 1, 2, 3, 4, 5].map((k) => `<circle class="kn-d${tag === "นิ่ง" ? 0 : 1}" cx="0" cy="${1460 - k * 40}" r="12" fill="#c8a0ff" stroke="#3a1a6a" stroke-width="3"/>`).join("")}
            <g transform="translate(0,1500)">${Jelly.ladder([[-120, -40], [-40, 0], [60, -30], [130, 10]], { w: 7 })}</g></g>`;
          g += `<g id="kn-a">${calf(290, "นิ่ง", "#1e6a4a")}${calf(790, "ขยับ", "#b8241e")}
            <g transform="translate(790,1680)"><path d="M-90,0h-60M90,0h60" stroke="#b8241e" stroke-width="10" stroke-linecap="round"/><path d="M-150,0l22,-16v32zM150,0l-22,-16v32z" fill="#b8241e"/></g>
            <g transform="translate(290,1680)"><rect x="-90" y="-30" width="180" height="60" rx="30" fill="#fffaf0" stroke="#1e1a16" stroke-width="4"/><text y="12" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="32" fill="#1e6a4a">ช้า</text></g>
            <g transform="translate(540,200)"><text text-anchor="middle" font-family="Kanit" font-weight="800" font-size="46" fill="#1e2a3a">พิษในเส้นเลือด</text></g></g>`;
          // B: the body outline, the vein from the calf up to the chest, the heart pulsing, the stamp
          g += `<g id="kn-b"><path d="M540,300Q620,300 620,380Q620,450 560,470L700,520Q760,560 770,700L790,1040H700L690,760L680,1100L700,1700H600L560,1180H520L480,1700H380L400,1100L390,760L380,1040H290L310,700Q320,560 380,520L520,470Q460,450 460,380Q460,300 540,300Z" fill="#f2d8c0" stroke="#1e1a16" stroke-width="6"/>
