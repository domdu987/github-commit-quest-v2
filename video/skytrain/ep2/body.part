      // ---------- ซอมบี้รถไฟฟ้า EP.2 ข้ามตู้ (ตอนจบ) ----------
      // grammar: the turned staff lunges → back into the train, the bell → the suit wants the track; the third rail, other trains → the end car's
      // bent door → ลุงเชิด: ข้ามตู้ กั้นประตู → through the gangway, the pile against the door → control: can't move, cutting power → the pile slides
      // → the suit pries the side door, ลุง blocks him: รอคนนำทาง → power off, the walkway → torches → the staff → the pile falls as the front opens →
      // the file along the walkway → ประตูเมือง, the crowd, relief → the rail lamps come back → the empty train starts by itself → นัท → here
      const A = (who, x, y, s, track, extra = {}) => { if (extra.talk) track.talk = extra.talk; return { who, x, y, s, track, blinks: [0.7, 2.6, 4.4], ...extra }; };
      const TALK = (k, i, m) => [vo(k, i), voEnd(k, i), m];
      const QUO = { quote: true };
      const CALM = { from: "right", rim: "#ffd9a0", rimOp: 0.5, shade: "#1a1430", shadeOp: 0.32, cast: false, vol: false };
      const ALRM = { from: "left", rim: "#ff6a5a", rimOp: 0.6, shade: "#1a0a14", shadeOp: 0.45, cast: false, vol: false };
      const DUSK = { from: "left", rim: "#ffb080", rimOp: 0.55, shade: "#141a2a", shadeOp: 0.42, cast: false, vol: false };
      const DEAD = { from: "right", rim: "#9ab8ff", rimOp: 0.45, shade: "#06080e", shadeOp: 0.55, cast: false, vol: false };
      const GCALM = { top: "#ffe2c0", bottom: "#2a2040", op: 0.1 }, GALR = { top: "#c8202a", bottom: "#12040a", op: 0.3 }, GDEAD = { top: "#3a4a6a", bottom: "#05060c", op: 0.3 };
      const S = 0.8, Y = TF - 6;
      const shk = (amp = 12) => (t) => ({ x: amp * Math.sin(t * 61), y: amp * 0.7 * Math.sin(t * 47), r: 0.5 * Math.sin(t * 37) });
      const rattle = (amp = 3) => (t) => ({ x: amp * Math.sin(t * 23), y: amp * 0.8 * Math.sin(t * 31), r: 0.15 * Math.sin(t * 7) });
      const noSh = (tl, id, n = 2) => { for (let i = 0; i < n; i++) tl.set(`#${id}-a${i}-shadow`, { opacity: 0 }, 0); };
      const CAR = (id, state, extra = {}) => ({ set: "carCut", setOpts: { id, state, ...extra }, dark: state === "calm" ? 0 : 0.26, light: state === "calm" ? CALM : ALRM, grade: state === "calm" ? GCALM : GALR, blur: { far: 2, mid: 1, fg: 6 } });
      const ZEND = (x, who, mode = "slamZ", flip = false) => A(who, x, Y, S, [{ t: 0, mode, eyes: "dead", mouth: "snarl" }], { flip });
      // a hand (sleeve + fingers) gripping the lever handle, drawn at the lever box's handle (world)
      const LVX = DX - 280, LVY = TF - 470, BLX = DX + 290, BLY = TF - 450;
      const gripHand = (id, skin = "#e0b088", sleeve = "#24262e") => `<g id="${id}"><path d="M-210,190Q-120,120 -40,70L-10,96Q-90,150 -170,236Z" fill="${sleeve}" ${SO2(4)}/><path d="M-50,60Q-20,30 14,40Q40,48 40,80Q40,110 10,118Q-30,124 -46,96Z" fill="${skin}" ${SO2(4)}/>
        ${[0, 1, 2, 3].map((k) => `<path d="M${-6 + k * 12},${44 + k * 4}q22,-6 26,14" stroke="#3a2622" stroke-width="3" fill="none"/>`).join("")}</g>`;

      const ARTX = { tower: `<g><rect x="-34" y="-74" width="68" height="140" fill="#5a6a8a" stroke="#1b1714" stroke-width="5"/>${Array.from({ length: 10 }, (_, k) => `<rect x="${-24 + (k % 2) * 28}" y="${-62 + Math.floor(k / 2) * 26}" width="20" height="14" fill="#ffe08a"/>`).join("")}<path d="M-70,68H70" stroke="#1b1714" stroke-width="7"/>
        <path d="M54,-76v140" stroke="#e8382c" stroke-width="7" stroke-dasharray="12 8"/><path d="M42,-64l12,-14l12,14M42,52l12,14l12,-14" stroke="#e8382c" stroke-width="7" fill="none"/></g>`,
        bolt: `<path d="M12,-78L-40,8H-4L-18,78L42,-14H6Z" fill="#ffd84a" stroke="#1b1714" stroke-width="6" stroke-linejoin="round"/>`,
        train: `<g><rect x="-66" y="-56" width="132" height="98" rx="24" fill="#eef0f2" stroke="#1b1714" stroke-width="6"/><rect x="-48" y="-40" width="96" height="40" rx="8" fill="#1a2a3a"/><circle cx="-34" cy="24" r="11" fill="#fff6c8" stroke="#1b1714" stroke-width="3"/><circle cx="34" cy="24" r="11" fill="#fff6c8" stroke="#1b1714" stroke-width="3"/><path d="M-80,60H80" stroke="#1b1714" stroke-width="8"/></g>` };
      const RULESK = [{ text: "<u>กดกระดิ่ง</u> อย่าวิ่งลงราง", art: IconFX.ART.bell }, { text: "<u>ข้ามตู้</u> กั้นประตู รอคนนำทาง", art: IconFX.ART.gangway }];
      const PY = 1500 + 140;
      // ---------- 1. hook: close, the turned staff lunges at the camera on the dark platform; then everyone runs back to the open doors ----------
      const HX = 0.8;
      split("hook", HX, { set: "platform", setOpts: { id: "hz", closed: true, dim: true, signX: -300 }, dark: 0.1, light: DEAD, grade: GDEAD,
        cam: { keys: [{ t: 0, ...fr(610, 1300, 2.3, 540, 960) }, { t: HX, glide: HX, ...fr(610, 1290, 2.7, 540, 960) }] },
        shake: shk(10),
        actors: [A("staffZ", 600, PY, S, [{ t: 0, mode: "lunge", eyes: "dead", mouth: "snarl" }], { flip: true })],
        captions: caps("hook"),
        fx(tl, id, t0, L) { noSh(tl, id, 1); SU.flash(tl, L.light, t0 + 0.05, "#ffffff", 0.3); } },
        { set: "platform", setOpts: { id: "hb", closed: true, dim: true, signX: 1400 }, dark: 0.1, light: DEAD, grade: GDEAD,
        cam: { keys: [{ t: 0, ...fr(560, 1250, 1.0, 540, 1080) }, { t: D("hook") - HX, glide: D("hook") - HX, ...fr(480, 1250, 1.08, 540, 1080) }] },
        shake: rattle(3),
        actors: [A("staffZ", 1180, PY, S, [{ t: 0, mode: "zrun", eyes: "dead", mouth: "snarl" }], { flip: true, moveTo: { x: 900, y: PY, dur: D("hook") - HX, ease: "none" } }),
          A("may", 640, PY, S, [{ t: 0, mode: "run", eyes: "wide", mouth: "scream" }], { flip: true, moveTo: { x: 300, y: 1500 + 40, dur: 1.4, ease: "power1.in" } }),
          A("nat", 480, PY + 20, S, [{ t: 0, mode: "run", eyes: "wide", mouth: "scream" }], { flip: true, moveTo: { x: 120, y: 1500 + 40, dur: 1.2, ease: "power1.in" } }),
          A("cherd", 820, PY, S, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }], { flip: true, moveTo: { x: 520, y: 1500 + 40, dur: 1.6, ease: "power1.in" } })],
        captions: capsFrom("hook", HX),
        fx(tl, id, t0, L) { noSh(tl, id, 4); SkyUI.title(tl, L.light, t0 + 0.05, D("hook") - HX + 1.3, "ซอมบี้รถไฟฟ้า", "EP.2 ข้ามตู้ · ตอนจบ"); } });
      // ---------- 2. the command: the suit at the edge over the empty track → red ----------
      add("cmd", { set: "platform", setOpts: { id: "pc", closed: true, dim: true, train: false, signX: -400 }, dark: 0.1, light: DEAD, grade: GDEAD,
        cam: { keys: [{ t: 0, ...fr(540, 1440, 1.7, 540, 1100) }, { t: D("cmd"), glide: D("cmd"), ...fr(540, 1450, 1.9, 540, 1100) }] },
        shake: rattle(3),
        actors: [A("suit", 560, 1500 + 20, S, [{ t: 0, mode: "crouch", eyes: "wide", mouth: "o" }])],
        captions: caps("cmd"),
        fx(tl, id, t0, L) { noSh(tl, id, 1); SU.flash(tl, L.light, t0 + F("cmd", 0, 0) + 0.02, "#ff3b2e", 0.35); } });
      // ---------- 3. back inside: เมย์ on the bell, the doors closing ----------
      add("back", { ...CAR("cb", "alarm", { end: "zombies", crack: 3, bent: true, station: "dead" }), blur: { far: 4, mid: 1.5, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(BLX - 140, 1140, 1.9, 540, 1000) }, { t: D("back"), glide: D("back"), ...fr(BLX - 120, 1130, 2.1, 540, 1000) }] },
        shake: rattle(3),
        actors: [A("may", BLX - 250, Y, S, [{ t: 0, mode: "press", eyes: "angry", mouth: "scream" }], { talk: [TALK("back", 0, "scream")] }),
          A("nat", DX - 100, Y, S, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }], { moveTo: { x: DX - 420, y: Y, dur: 0.8, ease: "power2.out" } })],
        captions: caps("back", undefined, QUO),
        fx(tl, id, t0, L) { noSh(tl, id); Sky.carLife(tl, "cb", t0, D("back"), { stopped: true });
          tl.fromTo("#cb-bl-gl circle", { opacity: 0.2 }, { opacity: 1, duration: 0.18, yoyo: true, repeat: Math.ceil(D("back") / 0.18), ease: "none", immediateRender: false }, t0); } });
      // ---------- 4. the suit at the doors: "ลงราง!" ----------
      add("jump", { ...CAR("cj", "alarm", { end: "zombies", crack: 3, bent: true, station: "dead" }), blur: { far: 4, mid: 1.5, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(DX, 1130, 1.8, 540, 1000) }, { t: D("jump"), glide: D("jump"), ...fr(DX, 1120, 2.0, 540, 1000) }] },
        shake: rattle(4),
        actors: [A("suit", DX - 40, Y, S, [{ t: 0, mode: "point", eyes: "wide", mouth: "scream" }], { talk: [TALK("jump", 0, "scream")] }),
          A("cherd", DX - 300, Y, S, [{ t: 0, mode: "grabArm", eyes: "angry", mouth: "flat" }])],
        captions: caps("jump", undefined, QUO),
        fx(tl, id, t0, L) { noSh(tl, id); Sky.carLife(tl, "cj", t0, D("jump"), { stopped: true }); } });
      // ---------- 5. the track: the third rail, another train's lights far off; two medals (≤ 2 s) ----------
      add("track", { set: "platform", setOpts: { id: "pk", closed: true, dim: true, train: false, signX: 1600 }, dark: 0.08, light: DEAD, grade: GDEAD,
        cam: { keys: [{ t: 0, ...fr(400, 1300, 1.3, 540, 1100) }, { t: D("track"), glide: D("track"), ...fr(700, 1320, 1.45, 540, 1100) }] },
        captions: caps("track"),
        fx(tl, id, t0, L) { put(L.glow, `<g id="pk-far" transform="translate(1500,1300)"><circle r="160" fill="url(#skTorch)"/><circle cx="-40" r="12" fill="#fffbe0"/><circle cx="40" r="12" fill="#fffbe0"/></g>`);
          tl.fromTo("#pk-far", { scale: 0.4, svgOrigin: "0 0", opacity: 0.4 }, { scale: 1.1, svgOrigin: "0 0", opacity: 1, duration: D("track"), ease: "power1.in", immediateRender: false }, t0);
          tl.fromTo("#pk-third", { opacity: 0.7 }, { opacity: 1, duration: 0.25, yoyo: true, repeat: Math.ceil(D("track") / 0.25), ease: "none", immediateRender: false }, t0);
          IconFX.enter(tl, L.light, { theme: "zombie", art: ARTX.bolt, x: 300, y: 620, r: 150, t: t0 + F("track", 0, 1) - 0.4, from: "left", label: "รางอาจมีไฟ", idle: 1.2, exit: "fly" }); IconFX.enter(tl, L.light, { theme: "zombie", art: ARTX.train, x: 780, y: 620, r: 150, t: t0 + F("track", 0, 2) - 0.3, from: "right", label: "รถขบวนอื่น", idle: Math.max(0.3, D("track") - F("track", 0, 2) - 0.8), exit: "fly" }); } });
      // ---------- 6. the end car: the bent door, hands through ----------
      add("end", { ...CAR("ce", "alarm", { end: "zombies", crack: 3, bent: true, station: "dead" }),
        cam: { keys: [{ t: 0, ...fr(GX + 40, 1180, 1.25, 540, 1000) }, { t: D("end"), glide: D("end"), ...fr(GX + 60, 1170, 1.5, 540, 1000) }] },
        shake: shk(5),
        actors: [ZEND(GX - 150, "zOffice"), ZEND(GX - 330, "zStudent"), ZEND(GX - 520, "zAuntie", "shamble")],
        captions: caps("end"),
        fx(tl, id, t0, L) { noSh(tl, id, 3); Sky.carLife(tl, "ce", t0, D("end"), { stopped: true, knock: true, flicker: true });
          put(L.set, `<g transform="translate(${GX + 70},${TF - 380}) rotate(80)"><g id="ce-hand">${Sky.zPalm("ce-hp", 0.42)}</g></g>`);
          tl.fromTo("#ce-hand", { x: -40, rotation: -20, svgOrigin: "0 0" }, { x: 30, rotation: 10, svgOrigin: "0 0", duration: 0.3, yoyo: true, repeat: Math.ceil(D("end") / 0.3), ease: "sine.inOut", immediateRender: false }, t0); } });
      // ---------- 7. ลุงเชิด: "ข้ามตู้! กั้นประตู!" ----------
      add("cross", { ...CAR("cx", "alarm", { end: "zombies", crack: 3, bent: true, station: "dead" }), blur: { far: 3, mid: 1, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(DX - 200, 1120, 1.7, 540, 1000) }, { t: D("cross"), glide: D("cross"), ...fr(DX - 160, 1110, 1.85, 540, 1000) }] },
        shake: rattle(3),
        actors: [A("cherd", DX - 260, Y, S, [{ t: 0, mode: "point", eyes: "angry", mouth: "scream" }], { talk: [TALK("cross", 0, "scream")] }),
          A("may", DX - 520, Y, S, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }]), A("nat", DX + 20, Y, S, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }], { flip: true })],
        captions: caps("cross", undefined, QUO),
        fx(tl, id, t0, L) { noSh(tl, id, 3); Sky.carLife(tl, "cx", t0, D("cross"), { stopped: true }); } });
      // ---------- 8. through the next gangway; bags against the door (the front car: the partition now on the left, the middle car behind it) ----------
      add("move", { ...CAR("cv", "alarm", { end: "empty", station: "dead" }),
        cam: { keys: [{ t: 0, ...fr(GX + 260, 1200, 1.1, 540, 1000) }, { t: D("move"), glide: D("move"), ...fr(GX + 220, 1190, 1.3, 540, 1000) }] },
        shake: rattle(2),
        actors: [A("may", GX + 120, Y, S, [{ t: 0, mode: "walk", eyes: "angry", mouth: "flat" }], { moveTo: { x: GX + 420, y: Y, dur: 1.2, ease: "power1.out" } }),
          A("cherd", GX + 80, Y, S, [{ t: 0, mode: "push", eyes: "angry", mouth: "flat" }], { flip: true }),
          A("suit", GX + 600, Y, S, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }], { flip: true })],
        captions: caps("move"),
        fx(tl, id, t0, L) { noSh(tl, id, 3); Sky.carLife(tl, "cv", t0, D("move"), { stopped: true });
          put(L.set, `<g transform="translate(${GX + 60},${TF})">${Sky.barricade("cv-bar")}</g>`); tl.set("#cv-bar-b3", { opacity: 0 }, t0);
          ["b0", "b1", "b2"].forEach((k, j) => tl.fromTo(`#cv-bar-${k}`, { y: -260, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, ease: "bounce.out", immediateRender: false }, t0 + 0.8 + j * 0.5)); } });
      // ---------- 9. นัท jams his scooter in ----------
      add("block", { ...CAR("ck", "alarm", { end: "empty", station: "dead" }), blur: { far: 3, mid: 1, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(GX + 200, 1250, 1.7, 540, 1000) }, { t: D("block"), glide: D("block"), ...fr(GX + 200, 1250, 1.85, 540, 1000) }] },
        shake: rattle(3),
        actors: [A("nat", GX + 470, Y, S, [{ t: 0, mode: "push", eyes: "angry", mouth: "scream" }], { flip: true, talk: [TALK("block", 0, "scream")] })],
        captions: caps("block", undefined, QUO),
        fx(tl, id, t0, L) { noSh(tl, id, 1); Sky.carLife(tl, "ck", t0, D("block"), { stopped: true, knock: true });
          put(L.set, `<g transform="translate(${GX + 60},${TF})">${Sky.barricade("ck-bar")}</g>`);
          tl.fromTo("#ck-bar-b3", { x: 260, rotation: 30, svgOrigin: "0 0" }, { x: 0, rotation: 0, svgOrigin: "0 0", duration: 0.45, ease: "back.out(2)", immediateRender: false }, t0 + 0.5); } });
      // ---------- 10. the bell: "รถออกไม่ได้ครับ…" ----------
      add("occ", { ...CAR("co", "alarm", { end: "empty", station: "dead" }), blur: { far: 4, mid: 1.5, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(BLX - 60, BLY + 20, 2.4, 540, 960) }, { t: D("occ"), glide: D("occ"), ...fr(BLX - 40, BLY + 10, 2.7, 540, 960) }] },
        actors: [A("may", BLX - 250, Y, S, [{ t: 0, mode: "press", eyes: "worry", mouth: "o" }])],
        captions: caps("occ", undefined, QUO),
        fx(tl, id, t0, L) { noSh(tl, id, 1); Sky.carLife(tl, "co", t0, D("occ"), { stopped: true });
          tl.fromTo("#co-bl-gl circle", { opacity: 0.3 }, { opacity: 1, duration: 0.2, yoyo: true, repeat: Math.ceil(D("occ") / 0.2), ease: "none", immediateRender: false }, t0); } });
      // ---------- 11. close: the pile slides an inch at a time ----------
      add("slide", { ...CAR("cs", "alarm", { end: "zombies", station: "dead", crack: 2 }), blur: { far: 3, mid: 1, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(GX + 120, 1330, 2.0, 540, 1000) }, { t: D("slide"), glide: D("slide"), ...fr(GX + 140, 1330, 2.3, 540, 1000) }] },
        shake: shk(4),
        actors: [ZEND(GX - 150, "zOffice")],
        captions: caps("slide"),
        fx(tl, id, t0, L) { noSh(tl, id, 1); Sky.carLife(tl, "cs", t0, D("slide"), { stopped: true, knock: true, flicker: true });
          put(L.set, `<g transform="translate(${GX + 60},${TF})">${Sky.barricade("cs-bar")}</g>`);
          for (let k = 0; k < 5; k++) tl.to("#cs-bar", { x: 14 + k * 14, duration: 0.12, ease: "power4.out" }, t0 + 0.4 + k * 0.6);
          tl.fromTo("#cs-gdoor", { rotation: 0, svgOrigin: `${GX + 52} ${TF}` }, { rotation: 4, svgOrigin: `${GX + 52} ${TF}`, duration: D("slide"), ease: "power1.in", immediateRender: false }, t0); } });
      // ---------- 12. the suit pries the side door ----------
      add("walk", { ...CAR("cw", "alarm", { end: "empty", station: "dead" }), blur: { far: 3, mid: 1, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(DX, 1150, 1.8, 540, 1000) }, { t: D("walk"), glide: D("walk"), ...fr(DX, 1140, 2.0, 540, 1000) }] },
        shake: rattle(3),
        actors: [A("suit", DX - 80, Y, S, [{ t: 0, mode: "yank", eyes: "angry", mouth: "scream" }], { talk: [TALK("walk", 0, "scream")] })],
        captions: caps("walk", undefined, QUO),
        fx(tl, id, t0, L) { noSh(tl, id, 1); Sky.carLife(tl, "cw", t0, D("walk"), { stopped: true }); } });
      // ---------- 13. ลุงเชิด blocks him: "รอคนนำทาง!"; the rule card ----------
      add("wait", { ...CAR("ct", "alarm", { end: "empty", station: "dead" }), blur: { far: 3, mid: 1, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(DX - 140, 1150, 1.6, 540, 1080) }, { t: D("wait"), glide: D("wait"), ...fr(DX - 140, 1140, 1.75, 540, 1080) }] },
        shake: rattle(3),
        actors: [A("suit", DX - 40, Y, S, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }], { flip: true }),
          A("cherd", DX - 300, Y, S, [{ t: 0, mode: "grabArm", eyes: "angry", mouth: "scream" }], { talk: [TALK("wait", 0, "scream")] })],
        captions: caps("wait", undefined, QUO),
        fx(tl, id, t0, L) { noSh(tl, id); Sky.carLife(tl, "ct", t0, D("wait"), { stopped: true }); IconFX.board(tl, L.light, { skin: "clipboard", title: "กฎของลุงเชิด", sub: "ใบงานซ่อม · ช่างรถไฟฟ้า 30 ปี", t: t0 + 0.05, dur: D("wait") - 0.05, y: 200, active: 1, done: [0], at: [0.3, 0.45], items: RULESK }); } });
      // ---------- 14. outside: power off (rail lamps dark), the emergency walkway ----------
      add("evac", { set: "viaduct", setOpts: { id: "ve", time: "night", trainX: -300, power: false }, dark: 0.1, light: false, grade: GDEAD, blur: { far: 1.5, mid: 0.6, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(700, 1050, 0.95, 540, 1000) }, { t: D("evac"), glide: D("evac"), ...fr(900, 1060, 1.1, 540, 1000) }] },
        captions: caps("evac"),
        fx(tl, id, t0, L) { put(L.light, `<g transform="translate(540,1240)"><g id="ve-ring" opacity="0"><rect x="-520" y="-40" width="1040" height="90" rx="40" fill="none" stroke="${SU.yellow}" stroke-width="10"/></g></g>`);
          tl.fromTo("#ve-ring", { opacity: 0, scale: 1.4, svgOrigin: "0 0" }, { opacity: 1, scale: 1, svgOrigin: "0 0", duration: 0.35, ease: "back.out(2.4)", immediateRender: false }, t0 + F("evac", 0, 2));
          tl.to("#ve-ring", { opacity: 0, duration: 0.3 }, t0 + D("evac") - 0.3); } });
      // ---------- 15. torches on the walkway, coming closer ----------
      add("torch", { set: "viaduct", setOpts: { id: "vt", time: "night", trainX: -300, power: false, lights: 3 }, dark: 0.12, light: false, grade: GDEAD, blur: { far: 1.5, mid: 0.6, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(1300, 980, 1.3, 540, 1000) }, { t: D("torch"), glide: D("torch"), ...fr(1200, 980, 1.45, 540, 1000) }] },
        captions: caps("torch"),
        fx(tl, id, t0, L) { for (let k = 0; k < 3; k++) { tl.fromTo(`#vt-tc${k}`, { x: 600 }, { x: 0, duration: D("torch"), ease: "power1.out", immediateRender: false }, t0);
          tl.fromTo(`#vt-tc${k}`, { y: 0 }, { y: -10, duration: 0.3, yoyo: true, repeat: Math.ceil(D("torch") / 0.3), ease: "sine.inOut", immediateRender: false }, t0 + k * 0.1); } } });
      // ---------- 16. the line staff at the front door: "ทางนี้ครับ!" ----------
      add("staff", { set: "viaduct", setOpts: { id: "vs", time: "night", trainX: -1500, power: false, lights: 1 }, dark: 0.1, light: DEAD, grade: GDEAD, blur: { far: 1.5, mid: 0.6, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(1600, 900, 1.9, 540, 1000) }, { t: D("staff"), glide: D("staff"), ...fr(1600, 900, 2.1, 540, 1000) }] },
        actors: [A("rescue", 1600, 1080 - 30, S, [{ t: 0, mode: "wave", eyes: "normal", mouth: "scream" }], { flip: true, talk: [TALK("staff", 0, "scream")] })],
        captions: caps("staff", undefined, QUO),
        fx(tl, id, t0, L) { noSh(tl, id, 1); } });
      // ---------- 17. the pile topples as the front door opens ----------
      add("fall", { ...CAR("cf", "alarm", { end: "zombies", station: "dead", crack: 3, bent: true }),
        cam: { keys: [{ t: 0, ...fr(GX + 300, 1220, 1.15, 540, 1000) }, { t: D("fall"), glide: D("fall"), ...fr(GX + 420, 1210, 1.0, 540, 1000) }] },
        shake: shk(6),
        actors: [ZEND(GX - 150, "zOffice"), ZEND(GX - 330, "zStudent"),
          A("may", DX - 120, Y, S, [{ t: 0, mode: "run", eyes: "wide", mouth: "scream" }], { moveTo: { x: DX + 160, y: Y, dur: 1.4, ease: "power1.in" } }),
          A("nat", DX - 320, Y, S, [{ t: 0, mode: "run", eyes: "wide", mouth: "scream" }], { moveTo: { x: DX + 60, y: Y, dur: 1.6, ease: "power1.in" } })],
        captions: caps("fall"),
        fx(tl, id, t0, L) { noSh(tl, id, 4); Sky.carLife(tl, "cf", t0, D("fall"), { stopped: true, knock: true, flicker: true });
          put(L.set, `<g transform="translate(${GX + 60},${TF})">${Sky.barricade("cf-bar")}</g>`);
          const tf = t0 + F("fall", 0, 0) + 0.3; ["b2", "b1", "b0", "b3"].forEach((k, j) => tl.to(`#cf-bar-${k}`, { x: 120 + j * 40, y: j === 0 ? 120 : 0, rotation: 70 + j * 15, svgOrigin: "0 0", duration: 0.4, ease: "power2.in" }, tf + j * 0.08));
          put(L.glow, `<rect id="cf-open" x="${DX - 200}" y="${WALLT + 40}" width="400" height="${TF - WALLT - 40}" fill="#fffbe0" opacity="0"/>`);
          tl.to("#cf-open", { opacity: 0.6, duration: 0.3 }, tf); } });
      // ---------- 18. the file along the walkway ----------
      add("file", { set: "viaduct", setOpts: { id: "vf", time: "night", trainX: -1000, power: false, lights: 2 }, dark: 0.1, light: DEAD, grade: GDEAD, blur: { far: 1.5, mid: 0.6, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(800, 900, 1.1, 540, 1000) }, { t: D("file"), glide: D("file"), ...fr(1000, 900, 1.15, 540, 1000) }] },
        actors: [A("rescue", 1250, 1050, S, [{ t: 0, mode: "torchWalk", eyes: "normal", mouth: "flat" }], { moveTo: { x: 1600, y: 1050, dur: D("file"), ease: "none" } }),
          A("may", 1050, 1050, S, [{ t: 0, mode: "walk", eyes: "worry", mouth: "flat" }], { moveTo: { x: 1400, y: 1050, dur: D("file"), ease: "none" } }),
          A("nat", 870, 1050, S, [{ t: 0, mode: "walk", eyes: "worry", mouth: "flat" }], { moveTo: { x: 1220, y: 1050, dur: D("file"), ease: "none" } }),
          A("cherd", 690, 1050, S, [{ t: 0, mode: "walk", eyes: "normal", mouth: "flat" }], { moveTo: { x: 1040, y: 1050, dur: D("file"), ease: "none" } }),
          A("suit", 510, 1050, S, [{ t: 0, mode: "walk", eyes: "worry", mouth: "flat" }], { moveTo: { x: 860, y: 1050, dur: D("file"), ease: "none" } })],
        captions: caps("file"),
        fx(tl, id, t0, L) { noSh(tl, id, 5); tl.fromTo("#vf-tc0", { x: 0 }, { x: 350, duration: D("file"), ease: "none", immediateRender: false }, t0); } });
      // ---------- 19. ประตูเมือง: the evening crowd; เมย์ hugs นัท ----------
      add("safe", { set: "platform", setOpts: { id: "pb", name: "ประตูเมือง", crowd: true, train: false, signX: 540 }, dark: 0, light: CALM, grade: GCALM,
        cam: { keys: [{ t: 0, ...fr(560, 1250, 1.15, 540, 1080) }, { t: D("safe"), glide: D("safe"), ...fr(560, 1250, 1.3, 540, 1080) }] },
        actors: [A("may", 500, PY + 120, S, [{ t: 0, mode: "hug", eyes: "closed", mouth: "smile" }], { talk: [TALK("safe", 0, "smile")] }), A("nat", 640, PY + 120, S, [{ t: 0, mode: "hug", eyes: "closed", mouth: "smile" }], { flip: true }),
          A("cherd", 260, PY + 100, S, [{ t: 0, mode: "idle", eyes: "normal", mouth: "smile" }])],
        captions: caps("safe", undefined, QUO),
        fx(tl, id, t0, L) { noSh(tl, id, 3); } });
      // ---------- 20. the rail lamps come back on ----------
      add("power", { set: "viaduct", setOpts: { id: "vp", time: "night", trainX: -300, lit: false, redEnd: true }, dark: 0.08, light: false, grade: GDEAD, blur: { far: 1.5, mid: 0.6, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(700, 980, 0.9, 540, 1000) }, { t: D("power"), glide: D("power"), ...fr(760, 980, 0.95, 540, 1000) }] },
        captions: caps("power"),
        fx(tl, id, t0, L) { for (let k = 0; k < 14; k++) tl.fromTo(`#vp-lp${k}`, { opacity: 0 }, { opacity: 0.7, duration: 0.08, ease: "none", immediateRender: false }, t0 + 0.4 + k * 0.06); } });
      // ---------- 21. the empty train starts by itself; red in its end car ----------
      add("moves", { set: "viaduct", setOpts: { id: "vm", time: "night", trainX: -300, lit: false, redEnd: true }, dark: 0.08, light: false, grade: GDEAD, blur: { far: 1.5, mid: 0.6, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(300, 900, 1.3, 540, 1000) }, { t: D("moves"), glide: D("moves"), ...fr(700, 900, 1.15, 540, 1000) }] },
        shake: rattle(2),
        captions: caps("moves"),
        fx(tl, id, t0, L) { tl.fromTo("#vm-train", { x: 0 }, { x: 900, duration: D("moves"), ease: "power2.in", immediateRender: false }, t0 + 0.3); } });
      // ---------- 22. นัท's face ----------
      add("nat", { set: "platform", setOpts: { id: "pn", name: "ประตูเมือง", crowd: true, train: false, signX: 2000 }, dark: 0.05, light: CALM, grade: GCALM, blur: { far: 4, mid: 3, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(560, 1360, 2.3, 540, 1000) }, { t: D("nat"), glide: D("nat"), ...fr(560, 1350, 2.6, 540, 1000) }] },
        actors: [A("nat", 560, PY + 120, S, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }], { flip: true, talk: [TALK("nat", 0, "o")] })],
        captions: caps("nat", undefined, QUO),
        fx(tl, id, t0, L) { noSh(tl, id, 1); } });
      // ---------- 23. the crowd; headlights growing out of the dark ----------
      add("here", { set: "platform", setOpts: { id: "ph", name: "ประตูเมือง", crowd: true, train: false, signX: -200 }, dark: 0.05, light: CALM, grade: GCALM,
        cam: { keys: [{ t: 0, ...fr(700, 1250, 0.95, 540, 1080) }, { t: D("here"), glide: D("here"), ...fr(1200, 1300, 1.25, 540, 1080) }] },
        captions: caps("here"),
        fx(tl, id, t0, L) { put(L.glow, `<g id="ph-hl" transform="translate(1700,1340)"><circle r="260" fill="url(#skTorch)"/><circle cx="-60" r="18" fill="#fffbe0"/><circle cx="60" r="18" fill="#fffbe0"/></g>`);
          tl.fromTo("#ph-hl", { scale: 0.2, svgOrigin: "0 0", opacity: 0.3 }, { scale: 1.6, svgOrigin: "0 0", opacity: 1, duration: D("here"), ease: "power2.in", immediateRender: false }, t0);
          SU.flash(tl, L.light, t0 + D("here") - 0.2, "#ffffff", 0.5); } });
      // ---------- 24. the series end card ----------
      add("end2", { dark: 0, light: false, cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960), drift: { s: 0.01 } }] },
        fx(tl, id, t0, L) { SkyUI.next(tl, L.light, t0, D("end2"), { l1: "ซอมบี้รถไฟฟ้า · ครบ 2 ตอน", l2: "กดกระดิ่ง อย่าวิ่งลงราง", l3: "ข้ามตู้ กั้นประตู รอคนนำทาง", cta: "แชร์ให้คนที่นั่งรถไฟฟ้าทุกวัน", end: true }); } });
