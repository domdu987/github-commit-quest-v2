        actors: [ME("brKeng", 1000, 1400, [{ t: 0, mode: "sit", eyes: "worry", mouth: "o" }]), A("brJukSword", 1250, 1400, 0.68, [{ t: 0, mode: "pointSword", eyes: "wide", mouth: "scream" }], { flip: true })],
