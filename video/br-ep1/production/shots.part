      // ---------- b12 the three rules on the board · b13 tied, rule one ----------
      shot("b12", { ...camp("b12"), camAt: fr(700, 1000, 1.25, 540, 960), push: 0.008, blur: { far: 10, mid: 10, set: 9, act: 8 }, dark: 0.3,
