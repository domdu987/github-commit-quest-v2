          tl.set(tg, { scaleY: 1, transformOrigin: "50% 0%" }, 0); tl.to(tg, { scaleY: 0.1, duration: 0.1 }, t0 + vo("b09") + 0.18); tl.to(`#${id} .brBrow`, { opacity: 1, duration: 0.08 }, t0 + vo("b09") + 0.3); } });

      // ---------- b10 dragged into the camp; ยายแผ้ว at the pot (p03_2 "ยายไม่หันมามอง" is kept for the long cut only if needed) ----------
      const WALKIN = (who, x0, x1, s, track, extra = {}) => A(who, x0, 1400, s, track, { flip: true, moveTo: { x: x1, dur: 3.0, at: 0.1 }, ...extra });
      shot("b10", { ...camp("b10"), cam: { keys: [{ t: 0, ...fr(1100, 820, 0.72, 540, 720), drift: { s: 0.004 } }, { t: F("b10", 0, 1) - 0.3, ...fr(560, 1120, 1.15, 540, 960), glide: 1.1 }] },
        actors: [WALKIN("brManSpear", 1120, 600, 0.98, [{ t: 0, mode: "walk", eyes: "angry", mouth: "frown" }, { t: 3.1, mode: "idle", eyes: "angry", mouth: "frown" }]),
