          JKI.ring(tl, L.light, t0, D("b15"), { x: 790, y: 520, from: 3, at: vo("b15", 1), steps: [[F("b15", 1, 0) + 0.3, 0]], count: 0.9, tone: "red", label: "แบตหมด", labelAt: F("b15", 1, 1) - 0.2, flashAt: F("b15", 1, 1) });
          tl.to(`#${id}-dark`, { opacity: 0.5, duration: 0.7 }, t0 + F("b15", 1, 1) - 0.1); tl.to(`#${id}-grade`, { opacity: 0.45, duration: 0.7 }, t0 + F("b15", 1, 1) - 0.1); } });

      // ---------- b16–b17 the chin, the screen, the message nobody reads ----------
