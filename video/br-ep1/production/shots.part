        fx(tl, id, t0, L) { hud(id, H_BAT()); const g = plank(L, id, [["rope", "red", "คนแปลกหน้า", "มัดไว้ก่อน"], ["phone", "yellow", "ของวาวรอน", "อย่าให้ควายเห็น"], ["lime", "green", "ตำน้ำพริกไม่เป็น", "ห้ามแตะมะนาว"]], "กฎของค่าย ๓ ข้อ");
          pop(tl, g, t0 + 0.05, { origin: "540 736", from: 0.85, dur: 0.35 }); swingG(tl, `#${id}-pl`, t0 + 0.4, D("b12") - 0.4, 1.1, "540 96");
          const ats = [F("b12", 0, 1), vo("b12", 1), vo("b12", 2)], kinds = ["rope", "phone", "lime"];
