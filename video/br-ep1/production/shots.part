          tl.to(`#${id}-ph-big`, { opacity: 1, duration: 0.1 }, on + 0.1); const gl = grp(L.glow); gl.innerHTML = `<g style="mix-blend-mode:screen"><ellipse cx="${KENG + 30}" cy="${1400 - 500 * 0.95}" rx="200" ry="150" fill="url(#brPhoneGlow)"/></g>`; tl.set(gl, { opacity: 0 }, 0); tl.to(gl, { opacity: 0.9, duration: 0.1 }, on);
