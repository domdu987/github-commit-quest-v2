      shot("b13", { ...camp("b13"), camAt: fr(790, 1070, 1.35, 540, 920), push: 0.012, shake: JKC.impact(vo("b13") + 0.25, 0.9, 5),
        actors: [ME("brKeng", KENG, 1400, [{ t: 0, mode: "tiedStruggle", eyes: "worry", mouth: "frown" }, { t: vo("b13") + 1.3, mode: "tied", eyes: "sad", mouth: "pout" }]), A("brMan1", 590, 1400, 0.98, [{ t: 0, mode: "foldX", eyes: "angry", mouth: "frown" }]),
