      // ---------- b01 hook: tied to the pole, ไอ้ดำ wants the pocket, แบต 3% ----------
      shot("b01", { ...camp("b01"), camAt: fr(840, 1060, 1.2, 540, 900), push: 0.03, shake: JKC.impact(F("b01", 0, 2), 0.4, 8),
