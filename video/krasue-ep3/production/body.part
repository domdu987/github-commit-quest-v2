      // ---------- แสงกระสือ EP.3 ห้ามขาน (ตอนจบ: ไม่มีซิกเนเจอร์ ไม่มีตัวเลือก) ----------
      // many camera angles: the door bolt close up, the window, dawn over the flood, the morning-after kitchen, the burnt outlet,
      // top-down on ป้าแช่ม's mat, the field at night
      const FON = (x, y, s, track, extra = {}) => ({ who: "fon", x, y, s, track, blinks: [0.9, 3.1, 5.4], ...extra });
      const PIAK = (x, y, s, track, extra = {}) => ({ who: "piak", x, y, s, track, blinks: [0.7, 2.6, 4.9], ...extra });
      const G = 1480, W = 1250, WL = G - 170;
      const FX = -250, DX = 1700, WX = 1150; // the fridge, the front door, the window (moved next to the door for this episode)
      const TOP = (L, id) => { const w = document.getElementById(`${id}-wfront`) || document.getElementById(`${id}-water`); if (w) L.act.appendChild(w); };
      const NIGHT = (id, o = {}) => ({ id, level: WL, fridgeX: FX, doorX: DX, windowX: WX, ...o });
      const DAY = (id, o = {}) => ({ id, level: G + 40, fridgeX: FX, doorX: DX, windowX: WX, day: true, mud: true, ...o });
      const lightsOff = (hid) => { const t = document.getElementById(`${hid}-tubeg`); if (t) { t.classList.remove("ktube"); t.setAttribute("opacity", "0"); } };
      const elec = (id) => { const c = document.getElementById(`${id}-g0`); if (c) c.classList.add("elec"); };
      const IK = "#2e2a26";
      const ROW1 = [`<circle cx="40" cy="44" r="28" fill="#7dff6a" opacity=".35"/><circle cx="40" cy="44" r="13" fill="#eaffd8" stroke="${IK}" stroke-width="3"/><path d="M34,58q-4,16 4,30M46,58q6,12 0,24" stroke="#3dbf5a" stroke-width="4" fill="none"/>
          <g class="kw"><path d="M66,58h38q8,0 8,8v18q0,8 -8,8h-20l-10,10v-10h-8q-8,0 -8,-8v-18q0,-8 8,-8z" fill="#f4ecd8" stroke="${IK}" stroke-width="4"/><path d="M70,62L106,96" stroke="#e0362c" stroke-width="7" stroke-linecap="round"/></g>`,
        `<span style="font-size:54px">แสงลอยผ่าน <u>อย่าขาน</u></span>`];
      // the green light under the door (glow layer) for the night shots at the door
      const under = (sid, op = 1) => `<g id="${sid}-under" opacity="${op}"><ellipse cx="${DX + 190}" cy="${WL + 6}" rx="420" ry="60" fill="url(#ksGlow)"/><rect x="${DX + 10}" y="${WL - 8}" width="360" height="14" rx="6" fill="#bfff96" opacity=".7"/></g>`;
      const knocks = (tl, sel, t0, n, gap = 0.32, amp = 7) => { for (let k = 0; k < n; k++) tl.fromTo(sel, { x: 0 }, { x: amp, duration: 0.05, yoyo: true, repeat: 1, immediateRender: false }, t0 + k * gap); };

      // ---------- 0. EP.2's last image: the door, green light seeping under it ----------
      add("recap", {
        set: "houseIn", setOpts: NIGHT("h0"), dark: 0.6,
        cam: { keys: [{ t: 0, ...fr(1880, G - 640, 1.2, 540, 1150), drift: { s: 0.04 } }] },
        extra(L) { lightsOff("h0"); put(L.glow, under("h0")); },
        fx(tl, id, t0, L) { TOP(L, "h0"); Fx.glitch(tl, `#${id}`, t0, 0.3, 14, 801); Fx.heart(tl, t0, D("recap"), 0.4, 0.6); },
      });

      // ---------- 1. flash-forward: morning; a hand pushing the main switch up — cut ----------
      add("hook", {
        set: "switchClose", setOpts: { id: "sc1" }, dark: 0.04,
        cam: { keys: [{ t: 0, ...fr(540, 1000, 1.0, 540, 960), drift: { s: 0.05 } }] },
        captions: caps("hook"),
        fx(tl, id, t0) {
          tl.set("#sc1-lever", { attr: { transform: "matrix(1 0 0 -1 0 2100)" } }, t0);
          tl.set("#sc1-hand", { y: 640 }, t0);
          const up = t0 + D("hook") - 1.4;
          tl.to("#sc1-lever", { attr: { transform: "matrix(1 0 0 1 0 0)" }, duration: 0.9, ease: "power1.inOut" }, up);
          tl.to("#sc1-hand", { y: 0, duration: 0.9, ease: "power1.inOut" }, up);
          Fx.heart(tl, up, 1.4, 0.42, 0.5);
          Fx.glitch(tl, `#${id}`, t0 + D("hook") - 0.5, 0.3, 18, 802); Fx.punch(tl, `#${id} .stage`, t0 + D("hook") - 0.5, 1.08, 0.4);
          tl.fromTo("#flashw", { opacity: 0.8 }, { opacity: 0, duration: 0.25, immediateRender: false }, t0 + D("hook") - 0.45);
        },
      });

      // ---------- 2. close: ฝน's hand on the door bolt, green between the planks ----------
      add("latch", {
        set: "latchClose", setOpts: { id: "lc2" }, dark: 0.45,
        cam: { keys: [{ t: 0, ...fr(560, 940, 1.15, 540, 960), drift: { s: 0.06 } }] },
        captions: caps("latch"),
        fx(tl, id, t0) {
          tl.fromTo("#lc2-bolt", { x: 0 }, { x: -30, duration: 0.8, ease: "power1.inOut", immediateRender: false }, t0 + 0.3);
          tl.fromTo("#lc2-hand", { x: 0 }, { x: -30, duration: 0.8, ease: "power1.inOut", immediateRender: false }, t0 + 0.3);
          tl.fromTo("#lc2-gaps", { opacity: 0.6 }, { opacity: 1, duration: 0.4, repeat: Math.ceil(D("latch") / 0.4), yoyo: true, immediateRender: false }, t0);
          Fx.heart(tl, t0, D("latch"), 0.42, 0.5);
        },
      });

      // ---------- 3. the door from inside: "เปิดสิลูก… ป้าเอง…" ----------
      add("open", {
        set: "houseIn", setOpts: NIGHT("h3"), dark: 0.58,
        cam: { keys: [{ t: 0, ...fr(1600, G - 700, 0.9, 540, 1000), drift: { s: 0.04 } }] },
        captions: caps("open", undefined, { quote: true }),
        extra(L) { lightsOff("h3"); put(L.glow, under("h3")); },
        fx(tl, id, t0, L) { TOP(L, "h3"); knocks(tl, "#h3-door", t0 + 0.05, 2, 0.3, 5); Fx.heart(tl, t0, D("open"), 0.42, 0.55); },
      });

      // ---------- 4. the rule card, row one — ฝน freezes on the stairs ----------
      add("rule1", {
        set: "houseIn", setOpts: NIGHT("h4"), dark: 0.5,
        cam: { keys: [{ t: 0, ...fr(1300, G - 600, 0.85, 540, 1350), drift: { s: 0.03 } }] },
        actors: [FON(1415, G - 630, 1.4, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }, { t: vo("rule1", 1), mode: "idle", eyes: "closed", mouth: "flat" }], { flip: true })],
        captions: caps("rule1", [0]).concat(caps("rule1", [1], { quote: true })),
        ui: [{ type: "koiRule", t: vo("rule1", 1) - 0.15, label: "กฎของลุงเปี๊ยก", rows: [ROW1], at: [vo("rule1", 1)], top: 300 }],
        extra(L) { lightsOff("h4"); put(L.glow, under("h4")); put(L.glow, `<ellipse cx="1380" cy="${G - 1000}" rx="380" ry="420" fill="url(#ksTube)" opacity=".5"/>`); },
        fx(tl, id, t0, L) { TOP(L, "h4"); elec(id); Fx.desat(tl, `#${id} .stage`, t0 + vo("rule1", 1), undefined, 0.2); Fx.glitch(tl, `#${id}`, t0 + vo("rule1", 1), 0.2, 10, 803); },
      });

      // ---------- 5. ฝน close, her hand over her mouth: silent ----------
      add("silent", {
        set: "houseIn", setOpts: NIGHT("h5"), dark: 0.55, blur: { far: 8, set: 8 },
        cam: { keys: [{ t: 0, ...fr(300, G + 1300 - 530 * 2.3, 1.0, 540, 1000), drift: { s: 0.06 } }] },
        actors: [FON(300, G + 1300, 2.3, [{ t: 0, mode: "whistle", eyes: "wide", mouth: "flat" }], { flip: true })],
        captions: caps("silent"),
        extra(L) { lightsOff("h5"); put(L.glow, `<ellipse cx="900" cy="${G + 600}" rx="600" ry="500" fill="url(#ksGlow)" opacity=".7"/>`); },
        fx(tl, id, t0) { Fx.heart(tl, t0, D("silent"), 0.38, 0.6); },
      });

      // ---------- 6. the door: knocking, the green brighter: "ฝน… ทำไมไม่ตอบป้า…" ----------
      add("why", {
        set: "houseIn", setOpts: NIGHT("h6"), dark: 0.58,
        cam: { keys: [{ t: 0, ...fr(1890, G - 650, 1.1, 540, 980), drift: { s: 0.07 } }] },
        shake: (t) => (t < 1.2 ? 4 * Math.sin(t * 40) : 0),
        captions: caps("why", undefined, { quote: true }),
        extra(L) { lightsOff("h6"); put(L.glow, under("h6")); },
        fx(tl, id, t0, L) {
          TOP(L, "h6"); knocks(tl, "#h6-door", t0 + 0.05, 4, 0.26, 9);
          tl.fromTo("#h6-under", { opacity: 0.6 }, { opacity: 1, duration: 0.35, repeat: Math.ceil(D("why") / 0.35), yoyo: true, immediateRender: false }, t0);
          Fx.heart(tl, t0, D("why"), 0.38, 0.6);
        },
      });

      // ---------- 7. the light lifts from under the door to the window ----------
      add("rise", {
        set: "houseIn", setOpts: NIGHT("h7"), dark: 0.6,
        cam: { keys: [{ t: 0, ...fr(1600, G - 600, 0.85, 540, 1000), drift: { s: 0.02 } }, { t: 1.4, glide: 2.0, ...fr(1330, G - 940, 1.05, 540, 900), drift: { s: 0.03 } }] },
        captions: caps("rise"),
        extra(L) { lightsOff("h7"); put(L.glow, under("h7")); put(L.glow, `<g id="o7g">${Krasue.orbGlow(1890, WL - 40, 1.4)}</g>`); },
        fx(tl, id, t0, L) {
          TOP(L, "h7");
          tl.to("#h7-under", { opacity: 0, duration: 0.8 }, t0 + 0.6);
          tl.fromTo("#o7g", { x: 0, y: 0 }, { x: 1330 - 1890, y: (G - 940) - (WL - 40), duration: 2.4, ease: "sine.inOut", immediateRender: false }, t0 + 0.6);
          Fx.heart(tl, t0, D("rise"), 0.42, 0.5);
        },
      });

      // ---------- 8. the window close: a face against the glass — with a bun ----------
      const FC = F("face", 0, 1) - 0.2;
      add("face", {
        set: "houseIn", setOpts: NIGHT("h8"), dark: 0.62,
        cam: { keys: [{ t: 0, ...fr(1330, G - 940, 1.6, 540, 900), drift: { s: 0.04 } }, { t: FC, glide: 2.2, ...fr(1330, G - 960, 2.1, 540, 900), drift: { s: 0.03 } }] },
        shake: (t) => (t > D("face") - 0.55 && t < D("face") - 0.3 ? 12 * Math.sin(t * 61) : 0),
        captions: caps("face"),
        extra(L) {
          lightsOff("h8");
          put(L.set, `<defs><clipPath id="h8clip"><rect x="${WX}" y="${G - 1150}" width="360" height="420"/></clipPath></defs>
            <g clip-path="url(#h8clip)"><rect x="${WX}" y="${G - 1150}" width="360" height="420" fill="#0e1a24"/>
              <g id="k8" opacity="0" transform="translate(0,0)">${Krasue.lurk(WX + 180, G - 960, 0.8, { bun: true, heart: 0.7 })}</g>
              <rect x="${WX}" y="${G - 1150}" width="360" height="420" fill="#9fb8c8" opacity=".08"/>${[0, 1, 2].map((k) => `<path d="M${WX + 40 + k * 110},${G - 1140}l-30,140" stroke="#cfe6ee" stroke-width="5" opacity=".18"/>`).join("")}</g>
            <path d="M${WX + 180},${G - 1150}v420M${WX},${G - 940}h360" stroke="#3a3028" stroke-width="10"/><rect x="${WX}" y="${G - 1150}" width="360" height="420" fill="none" stroke="${IK}" stroke-width="4"/>`);
        },
        fx(tl, id, t0) {
          const hit = t0 + D("face") - 0.55;
          tl.fromTo("#k8", { opacity: 0 }, { opacity: 1, duration: 1.1, ease: "power1.in", immediateRender: false }, t0 + FC - 0.2);
          tl.to("#k8", { attr: { transform: `translate(${-(WX + 180) * 1.3},${-(G - 960) * 1.3}) scale(2.3)` }, duration: 0.12, ease: "power4.in" }, hit);
          Fx.glitch(tl, `#${id}`, hit + 0.08, 0.2, 14, 804);
          Fx.heart(tl, t0 + FC, D("face") - FC - 0.6, 0.45, 0.6);
          tl.set("#black", { opacity: 1 }, hit + 0.24);
          tl.set("#black", { opacity: 0 }, t0 + D("face"));
        },
      });

      // ---------- 9. dawn over the flood, a rooster; the light floats back to the house next door ----------
      add("dawn", {
        set: "floodVillage", setOpts: { id: "f9", dusk: true, houses: [[-150, 1.0, { dark: true }], [980, 0.8, { dark: true }]], seed: 309 }, dark: 0.06,
        cam: { keys: [{ t: 0, ...fr(560, 1000, 0.72, 540, 1000), drift: { x: 40, s: 0.02 } }] },
        captions: caps("dawn"),
        extra(L) { put(L.set, `<g id="o9">${Krasue.orb(980, 760, 0.8)}</g>`); put(L.glow, `<g id="o9g">${Krasue.orbGlow(980, 760, 0.8)}</g>`); },
        fx(tl, id, t0) {
          tl.fromTo(["#o9", "#o9g"], { x: 0, y: 0 }, { x: -1000, y: 120, duration: D("dawn") - 0.4, ease: "sine.in", immediateRender: false }, t0 + F("dawn", 0, 1));
          tl.to(["#o9", "#o9g"], { opacity: 0, duration: 0.5 }, t0 + D("dawn") - 0.8);
        },
      });

      // ---------- 10. morning inside: the water gone, mud, the tide line on the walls ----------
      add("morning", {
        set: "houseIn", setOpts: DAY("h10"), dark: 0.05,
        cam: { keys: [{ t: 0, ...fr(560, G - 520, 0.66, 540, 1100), drift: { x: -40, s: 0.02 } }] },
        captions: caps("morning"),
        extra(L) { lightsOff("h10"); put(L.glow, `<ellipse cx="${WX + 180}" cy="${G - 600}" rx="700" ry="900" fill="url(#ksLamp)" opacity=".5"/>`); },
      });

      // ---------- 11. ฝน on the stairs reaching for the lever ----------
      add("reach", {
        set: "houseIn", setOpts: DAY("h11"), dark: 0.05,
        cam: { keys: [{ t: 0, ...fr(1000, G - 820, 1.0, 540, 900), drift: { s: 0.04 } }] },
        actors: [FON(1085, G - 270, 1.4, [{ t: 0, mode: "idle", eyes: "side", mouth: "flat" }, { t: 0.9, mode: "raise", eyes: "normal", mouth: "flat" }], { flip: true })],
        captions: caps("reach"),
        extra(L) { lightsOff("h11"); },
      });

      // ---------- 12. ลุงเปี๊ยก in the doorway: "อย่า! ปลั๊กมันจมน้ำมาทั้งคืน" ----------
      add("stop", {
        set: "houseIn", setOpts: DAY("h12"), dark: 0.05, blur: { far: 6, set: 6 },
        cam: { keys: [{ t: 0, ...fr(1880, G + 1300 - 530 * 2.3, 1.0, 540, 980), drift: { x: -30, s: 0.07 } }] },
        shake: (t) => (t < 0.5 ? 10 * Math.sin(t * 50) * (0.5 - t) : 0),
        actors: [PIAK(1880, G + 1300, 2.3, [{ t: 0, mode: "point", eyes: "wide", mouth: "scream" }, { t: F("stop", 0, 1), mode: "point", eyes: "normal", mouth: "frown" }], { flip: true })],
        captions: caps("stop", undefined, { quote: true }),
        extra(L) { lightsOff("h12"); },
        fx(tl, id, t0) { Fx.punch(tl, `#${id} .stage`, t0 + 0.05, 1.08, 0.3); },
      });

      // ---------- 13–15. after the flood (verbatim sources) ----------
      add("know1", {
        set: "houseIn", setOpts: DAY("h13"), dark: 0.05,
        cam: { keys: [{ t: 0, ...fr(940, G - 1120, 1.3, 540, 1250), drift: { s: 0.03 } }] },
        captions: caps("know1"),
        ui: [steps("know1", "หลังน้ำท่วม", [["callelec", "ช่างตรวจก่อน ค่อยเปิดไฟ"]], F("know1", 0, 1) - 0.1, D("know1") - 0.15),
          { type: "src", t: F("know1", 0, 2) + 0.2, end: D("know1") - 0.05, top: 640, text: "ที่มา: <em>CDC สหรัฐฯ</em> · อย่าเปิดไฟกลับเอง จนกว่าช่างไฟที่มีคุณสมบัติจะตรวจอุปกรณ์ไฟฟ้า" }],
        extra(L) { lightsOff("h13"); },
      });
      add("know2", {
        set: "houseIn", setOpts: DAY("h14"), dark: 0.05,
        cam: { keys: [{ t: 0, ...fr(0, G - 420, 1.15, 540, 1300), drift: { s: 0.03 } }] },
        captions: caps("know2"),
        ui: [steps("know2", "เครื่องใช้ไฟฟ้าที่จมน้ำ", [["drydevice", "ต้องแห้งสนิท"], ["callelec", "ช่างตรวจก่อนใช้"]], F("know2", 0, 1) - 0.1, D("know2") - 0.15, { gap: F("know2", 0, 2) - F("know2", 0, 1) }),
          { type: "src", t: F("know2", 0, 2) + 0.3, end: D("know2") - 0.05, top: 640, text: "ที่มา: <em>CDC สหรัฐฯ</em> · ต้องแห้งสนิทก่อนใช้ · <em>MEA</em> · ควรตรวจสอบเครื่องใช้ไฟฟ้าโดยช่างผู้ชำนาญก่อนใช้งานอีกครั้ง" }],
        extra(L) { lightsOff("h14"); },
      });
      add("know3", {
        set: "switchClose", setOpts: { id: "sc15" }, dark: 0.05,
        cam: { keys: [{ t: 0, ...fr(540, 1060, 0.9, 540, 1300), drift: { s: 0.03 } }] },
        captions: caps("know3"),
        ui: [steps("know3", "เปิดไฟแล้วผิดปกติ", [["smelloff", "สับคัตเอาต์ลงทันที"]], F("know3", 0, 1) - 0.1, D("know3") - 0.15),
          { type: "src", t: F("know3", 0, 2) + 0.2, end: D("know3") - 0.05, top: 640, text: "ที่มา: <em>CDC สหรัฐฯ</em> · เห็นสายไฟชำรุด ประกายไฟ หรือได้กลิ่นไหม้ ให้ตัดไฟที่เบรกเกอร์หลักทันที" }],
        fx(tl, id, t0) {
          tl.fromTo("#sc15-spark", { opacity: 0 }, { opacity: 0.9, duration: 0.08, yoyo: true, repeat: 3, immediateRender: false }, t0 + F("know3", 0, 0) + 0.3);
          tl.to("#sc15-lever", { attr: { transform: "matrix(1 0 0 -1 0 2100)" }, duration: 0.4, ease: "power2.in" }, t0 + F("know3", 0, 2));
          tl.to("#sc15-hand", { y: 640, duration: 0.4, ease: "power2.in" }, t0 + F("know3", 0, 2));
        },
      });

      // ---------- 16. the outlet behind the fridge, burnt black; the tester stays dark ----------
      add("outlet", {
        set: "outletClose", setOpts: { id: "oc16" }, dark: 0.08,
        cam: { keys: [{ t: 0, ...fr(700, 900, 0.8, 540, 960), drift: { s: 0.02 } }, { t: F("outlet", 0, 1) - 0.1, glide: 0.8, ...fr(520, 920, 1.3, 540, 960), drift: { s: 0.04 } }] },
        captions: caps("outlet"),
        fx(tl, id, t0) {
          tl.fromTo("#oc16-tester", { x: 200, y: 160 }, { x: 0, y: 0, duration: 1.0, ease: "power2.out", immediateRender: false }, t0 + 0.2);
          Fx.punch(tl, `#${id} .stage`, t0 + F("outlet", 0, 2), 1.05, 0.3);
        },
      });

      // ---------- 17. ลุงเปี๊ยก close: "ไฟรั่วตรงนี้แหละ ที่ดูดไอ้เต้ยเมื่อคืน" ----------
      add("here", {
        set: "houseIn", setOpts: DAY("h17"), dark: 0.05, blur: { far: 5, set: 5 },
        cam: { keys: [{ t: 0, ...fr(300, G - 530 * 1.7, 1.0, 640, 900), drift: { s: 0.05 } }] },
        actors: [PIAK(300, G, 1.7, [{ t: 0, mode: "idle", eyes: "side", mouth: "frown" }, { t: 0.3, mode: "point", eyes: "normal", mouth: "o" }], { flip: true })],
        captions: caps("here", undefined, { quote: true }),
        extra(L) { lightsOff("h17"); },
      });

      // ---------- 18. the switch close up: a long black hair caught on the lever ----------
      add("who", {
        set: "switchClose", setOpts: { id: "sc18", hand: false }, dark: 0.1,
        cam: { keys: [{ t: 0, ...fr(540, 960, 0.95, 540, 960), drift: { s: 0.02 } }, { t: F("who", 0, 1) - 0.2, glide: 1.6, ...fr(560, 760, 1.9, 540, 960), drift: { s: 0.04 } }] },
        captions: caps("who"),
        extra(L) { put(L.act, `<path id="hair18" d="M440,730C520,700 600,760 640,740C700,700 640,820 700,900C760,980 720,1060 780,1160" stroke="#050706" stroke-width="5" fill="none" stroke-linecap="round" opacity="0"/>`); },
        fx(tl, id, t0) {
          tl.set("#sc18-lever", { attr: { transform: "matrix(1 0 0 -1 0 2100)" } }, t0);
          tl.set("#hair18", { attr: { d: "M440,1370C520,1400 600,1340 640,1360C700,1400 640,1280 700,1200C760,1120 720,1040 780,940" } }, t0);
          tl.to("#hair18", { opacity: 1, duration: 0.6 }, t0 + F("who", 0, 1) - 0.2);
          Fx.heart(tl, t0 + F("who", 0, 1), D("who") - F("who", 0, 1), 0.42, 0.5);
          Fx.glitch(tl, `#${id}`, t0 + F("who", 0, 1) + 0.8, 0.2, 10, 805);
        },
      });

      // ---------- 19. ฝน walking along the porch with the pot ----------
      add("pot", {
        set: "porchFlood", setOpts: { id: "p19", dusk: true }, dark: 0.04,
        cam: { keys: [{ t: 0, ...fr(100, G - 300, 0.8, 540, 1150), drift: { x: -60, s: 0.02 } }] },
        actors: [FON(500, G, 1.1, [{ t: 0, mode: "walk", eyes: "side", mouth: "flat" }], { flip: true, moveTo: { x: -350, y: G, dur: D("pot"), ease: "none" } })],
        captions: caps("pot"),
        extra(L) { put(L.act, `<g id="pt19"><g transform="translate(0,${G - 300}) scale(0.9)"><path d="M-70,-90H70L60,-10Q58,0 46,0H-46Q-58,0 -60,-10Z" fill="#9aa4a8" stroke="${IK}" stroke-width="4"/><rect x="-80" y="-104" width="160" height="18" rx="6" fill="#b8c0c4" stroke="${IK}" stroke-width="4"/></g></g>`); },
        fx(tl, id, t0) { tl.fromTo("#pt19", { x: 420 }, { x: -430, duration: D("pot"), ease: "none", immediateRender: false }, t0); },
      });

      // ---------- 20–23. top-down: ป้าแช่ม asleep on the mat; the rag; she wakes and smiles; her eyes flash green ----------
      add("mat", {
        set: "chaemTop", setOpts: { id: "ct20" }, dark: 0.1,
        cam: { keys: [{ t: 0, ...fr(540, 1100, 0.78, 540, 1000), drift: { s: 0.03 } }] },
        captions: caps("mat"),
      });
      add("rag", {
        set: "chaemTop", setOpts: { id: "ct21" }, dark: 0.1,
        cam: { keys: [{ t: 0, ...fr(380, 640, 1.2, 540, 960), drift: { s: 0.02 } }, { t: F("rag", 0, 1) - 0.1, glide: 0.8, ...fr(220, 560, 2.0, 540, 960), drift: { s: 0.04 } }] },
        captions: caps("rag"),
        fx(tl, id, t0) { Fx.heart(tl, t0 + F("rag", 0, 1), D("rag") - F("rag", 0, 1), 0.42, 0.5); },
      });
      const WK = vo("wake", 0) + 0.3;
      add("wake", {
        set: "chaemTop", setOpts: { id: "ct22", smile: true }, dark: 0.1,
        cam: { keys: [{ t: 0, ...fr(540, 600, 1.9, 540, 900), drift: { s: 0.05 } }] },
        captions: caps("wake", [0]).concat(caps("wake", [1], { quote: true })),
        fx(tl, id, t0) {
          tl.set("#ct22-smile", { opacity: 0 }, t0);
          tl.to("#ct22-shut", { opacity: 0, duration: 0.1 }, t0 + WK); tl.to("#ct22-open", { opacity: 1, duration: 0.1 }, t0 + WK);
          tl.to("#ct22-smile", { opacity: 1, duration: 0.3 }, t0 + F("wake", 0, 1));
          Fx.heart(tl, t0, D("wake"), 0.45, 0.45);
        },
      });
      add("glint", {
        set: "chaemTop", setOpts: { id: "ct23", smile: true }, dark: 0.12,
        cam: { keys: [{ t: 0, ...fr(540, 610, 2.3, 540, 900), drift: { s: 0.06 } }] },
        captions: caps("glint"),
        fx(tl, id, t0) {
          tl.set("#ct23-shut", { opacity: 0 }, t0); tl.set("#ct23-open", { opacity: 1 }, t0);
          const g = t0 + F("glint", 0, 1) + 0.35;
          tl.set("#ct23-eyes", { opacity: 1 }, g); tl.set("#ct23-eyes", { opacity: 0 }, g + 0.16);
          Fx.heart(tl, g, D("glint") - F("glint", 0, 1) - 0.35, 0.45, 0.5);
        },
      });

      add("night", {
        set: "floodVillage", setOpts: { id: "f24", lights: [[1200, 900, 0.8]], seed: 324 }, dark: 0.16,
        cam: { keys: [{ t: 0, ...fr(560, 1000, 0.72, 540, 1000), drift: { x: 60, s: 0.03 } }] },
        captions: caps("night"),
        fx(tl, id, t0) { tl.fromTo(["#f24-l0", "#f24-lg0"], { x: 0 }, { x: -700, duration: D("night"), ease: "none", immediateRender: false }, t0); },
      });

      // ---------- 25. the light close: the face, calling "ฝน… เต้ย… มานี่สิลูก…" ----------
      add("call", {
        set: "floodVillage", setOpts: { id: "f25", dark: true, seed: 325 }, dark: 0.55,
        cam: { keys: [{ t: 0, ...fr(560, 900, 1.0, 540, 900), drift: { s: 0.02 } }, { t: 0.4, glide: D("call") - 2.0, ...fr(560, 880, 1.25, 540, 900), drift: { s: 0.02 } }] },
        captions: caps("call", undefined, { quote: true }),
        extra(L) { put(L.act, Krasue.lurk(600, 880, 0.42, { id: "k25", heart: 0.8 })); put(L.light, Krasue.lensFace("k25f")); },
        fx(tl, id, t0) {
          const out = t0 + voEnd("call") + 0.1, hit = t0 + D("call") - 0.5;
          Fx.heart(tl, t0, voEnd("call"), 0.5, 0.55);
          tl.to("#k25", { opacity: 0, duration: 0.08 }, out);
          tl.to(`#${id}-dark`, { opacity: 0.9, duration: 0.3 }, out);
          tl.fromTo("#k25f", { opacity: 0, scale: 1.25, transformOrigin: "50% 47%" }, { opacity: 1, scale: 1, duration: 0.09, ease: "power4.out", immediateRender: false }, hit);
          Fx.glitch(tl, `#${id}`, hit + 0.05, 0.18, 16, 807);
          tl.set("#black", { opacity: 1 }, hit + 0.24);
        },
      });

      // ---------- 26. black, one green light far off; the rule ----------
      add("last", {
        set: "floodVillage", setOpts: { id: "f26", dark: true, lights: [[560, 980, 0.5]], seed: 326 }, dark: 0.6,
        cam: { keys: [{ t: 0, ...fr(560, 1000, 1.0, 540, 960), drift: { s: 0.02 } }] },
        captions: caps("last"),
        fx(tl, id, t0) {
          tl.set("#black", { opacity: 0 }, t0 + 0.5);
          tl.to(`#${id}-dark`, { opacity: 0.92, duration: F("last", 0, 2) }, t0);
          tl.to(["#f26-l0", "#f26-lg0"], { opacity: 0, duration: 0.6 }, t0 + D("last") - 1.0);
          Fx.heart(tl, t0, D("last") - 0.6, 0.6, 0.4);
          tl.set("#black", { opacity: 1 }, t0 + D("last") - 0.2);
        },
      });

      // ---------- 27. end card: the sign on the pole — the end ----------
      add("end", {
        set: "poleSign", setOpts: { id: "sg", ep: "ตอนจบ", title: "แสงกระสือ" }, dark: 0.08,
        cam: { keys: [{ t: 0, ...fr(540, 900, 1.0, 540, 900), drift: { s: 0.03 } }] },
        fx(tl, id, t0) {
          tl.set("#black", { opacity: 0 }, t0 + 0.3);
          tl.fromTo("#sg-sign", { attr: { transform: "rotate(-9 540 900)" } }, { attr: { transform: "rotate(-2 540 900)" }, duration: 1.6, ease: "elastic.out(1,0.4)", immediateRender: false }, t0 + 0.3);
        },
      });

      shots.forEach((sh) => { const f = sh.fx; sh.fx = (tl, id, t0, L) => { if (f) f(tl, id, t0, L); Krasue.life(tl, `#${id}`, t0, sh.dur); }; });
