      // ---------- ต่อหัวเสือ EP.1 อย่าปัดมัน ----------
      // grammar: hook wide (the lure: a hornet at the lens) → the planted mistake (0:04 stone hits the nest's branch) → card → nest close → map →
      // cast in the yard (name tags) → tilt up to the nest (the audience sees it first) → ยาย + rule board → shadow-screen legend → เตย scoffs →
      // ลุงสิงห์ in long sleeves → the first hornet → ภูมิ stands still (the turn) → เตย swats → ↺ 0:04 → the soldiers pour out → next card
      const SUN = { from: "left", rim: "#fff6dc", rimOp: 0.8, shade: "#2a2440", shadeOp: 0.26, cast: { len: 1.3, op: 0.28 }, vol: false };
      const GDAY = { top: "#fff3d6", bottom: "#cfe6f4", op: 0.1 }, GHOT = { top: "#fff0c0", bottom: "#f4d8a0", op: 0.16 };
      const A = (who, x, y, s, track, extra = {}) => { if (extra.talk) track.talk = extra.talk; return { who, x, y, s, track, blinks: [0.8, 2.9], ...extra }; };
      const TALK = (k, i, m = "o") => [vo(k, i), voEnd(k, i), m];
      const QUO = { quote: true };
      const G = 1320, TX = 760, NX = 910, NY = 454;           // the yard's ground, the tamarind, the nest's hanging point (Hn.NEST)
      const Y0 = (id, o = {}) => ({ set: "hnYard", setOpts: { id, ...o }, dark: 0, light: SUN, grade: GDAY, blur: { far: 1, fg: 6 } });
      const BLUR = { sky: 4, far: 6, mid: 6, set: 5, act: 5, fg: 8 };
      const sway = (tl, id, t0, a = 9, n = 3) => { for (let k = 0; k < n; k++) tl.to(`#${id}-nest`, { rotation: (k % 2 ? -a : a) * (1 - k / (n + 1)), svgOrigin: `${NX} ${NY}`, duration: 0.32, ease: "sine.inOut" }, t0 + k * 0.32);
        tl.to(`#${id}-nest`, { rotation: 0, svgOrigin: `${NX} ${NY}`, duration: 0.4, ease: "sine.out" }, t0 + n * 0.32); };
      // the slingshot stone: from (x0,y0) up to a pod, glances off to the nest's branch (screen-world coords of the yard)
      const stone = (L, tl, id, t0, x0, y0) => {
        put(L.glow, `<g id="${id}-st"><circle r="9" fill="#8a8a84" stroke="#2e2a26" stroke-width="3"/></g>`);
        tl.set(`#${id}-st`, { opacity: 0 }, 0); tl.set(`#${id}-st`, { opacity: 1, x: x0, y: y0 }, t0);
        tl.to(`#${id}-st`, { x: 700, y: 640, duration: 0.28, ease: "none" }, t0);
        tl.to(`#${id}-st`, { x: NX - 70, y: NY - 70, duration: 0.2, ease: "none" }, t0 + 0.28);
        tl.to(`#${id}-st`, { x: NX - 160, y: 900, opacity: 0, duration: 0.5, ease: "power1.in" }, t0 + 0.48);
        put(L.glow, `<g id="${id}-hit" opacity="0" transform="translate(${NX - 70},${NY - 70})"><path d="M-30,0H30M0,-30V30M-20,-20L20,20M20,-20L-20,20" stroke="#fff6c8" stroke-width="6" stroke-linecap="round"/></g>`);
        tl.set(`#${id}-hit`, { opacity: 0 }, 0); tl.fromTo(`#${id}-hit`, { opacity: 1, scale: 0.4, svgOrigin: `${NX - 70} ${NY - 70}` }, { opacity: 0, scale: 1.4, svgOrigin: `${NX - 70} ${NY - 70}`, duration: 0.3, immediateRender: false }, t0 + 0.48);
      };
      const buzz = (tl, layer, id, t0, dur, cx, cy, s = 0.9, rx = 90, ry = 60, n = 1, seed = 3) => Hn.swarm(tl, layer, { id, n, s, cx, cy, rx, ry, t0, dur, seed });

      // ---------- 1. hook: the yard at noon; a hornet right at the lens, the nest in the tamarind, the title plank ----------
      add("hook", {
        ...Y0("y0", { title: { x: 420, y: 1560, s: 1.55, sub: "EP.1 อย่าปัดมัน" } }),
        cam: { keys: [{ t: 0, ...fr(600, 1180, 0.74, 540, 980) }, { t: D("hook"), glide: D("hook"), ...fr(640, 1100, 0.86, 540, 980) }] },
        captions: caps("hook"),
        fx(tl, id, t0, L) {
          buzz(tl, L.glow, "h0s", t0, D("hook"), NX, NY + 200, 0.32, 110, 80, 7, 5);
          // the hero hornet hovering in front of the lens, drifting and turning
          put(L.light, `<g id="h0h"><g id="h0hf"><g transform="rotate(-14)">${Hn.hornet({ s: 3.6 })}</g></g></g>`);
          tl.fromTo("#h0h", { x: 1180, y: 600 }, { x: 760, y: 760, duration: 0.9, ease: "power2.out", immediateRender: false }, t0);
          tl.to("#h0h", { x: 640, y: 720, duration: 0.9, yoyo: true, repeat: 2, ease: "sine.inOut" }, t0 + 0.9);
          tl.to("#h0hf", { y: 18, duration: 0.11, yoyo: true, repeat: Math.ceil(D("hook") / 0.11), ease: "sine.inOut" }, t0);
          tl.to("#h0h .hnw > g", { scaleY: 0.25, svgOrigin: "0 0", duration: 0.02, yoyo: true, repeat: Math.ceil(D("hook") / 0.02) }, t0);
        },
      });
      // ---------- 2. the command, over the planted mistake: ภูมิ's stone clacks off a pod and hits the nest's branch (0:04) ----------
      add("cmd", {
        ...Y0("y1"), cam: { keys: [{ t: 0, ...fr(640, 1000, 0.92, 540, 900) }] },
        actors: [A("phumSling", 360, 1500, 0.78, [{ t: 0, mode: "aim", eyes: "normal", mouth: "smile" }, { t: 0.95, mode: "idle", eyes: "normal", mouth: "smile" }])],
        captions: caps("cmd"),
        fx(tl, id, t0, L) { stone(L, tl, "c1", t0 + 0.7, 470, 1080); sway(tl, "y1", t0 + 1.18, 7, 3); buzz(tl, L.glow, "c1s", t0, D("cmd"), NX, NY + 220, 0.32, 110, 80, 6, 7); },
      });
      // ---------- 3. why: stand still ✓ / swatting gets you stung ✗ ----------
      add("why", { ...Y0("y2"), blur: BLUR, cam: { keys: [{ t: 0, ...fr(700, 1000, 1.1, 540, 960) }] }, captions: caps("why"),
        fx(tl, id, t0, L) { HnUI.still(tl, L.light, t0 + 0.1, D("why") - 0.1, { y: 330 }); } });
      // ---------- 4. the whole nest behind it ----------
      add("nest", { set: "hnNest", setOpts: { id: "n4" }, dark: 0, light: false, grade: GDAY,
        cam: { keys: [{ t: 0, ...fr(560, 900, 0.8, 540, 960) }, { t: D("nest"), glide: D("nest"), ...fr(600, 1250, 1.25, 540, 960) }] }, captions: caps("nest"),
        fx(tl, id, t0, L) { buzz(tl, L.glow, "n4s", t0, D("nest"), 560, 1500, 1.0, 380, 200, 9, 11); } });
      // ---------- 5. the trip: Bangkok → บ้านโนนมะขาม (Isan) ----------
      const MP = { x: 90, y: 300, s: 1 }, PB = Maps.P(100.52, 13.75), PV = Maps.P(102.6, 15.6);
      const mw = (p) => [MP.x + p[0] * MP.s, MP.y + p[1] * MP.s], WB = mw(PB), WV = mw(PV);
      add("map", {
        set: "mapTH", setOpts: { id: "mp", ...MP, region: [103.2, 15.6, 230, "อีสาน"], route: [[100.52, 13.75], [100.9, 14.3], [101.6, 14.9], [102.1, 15.0], [102.6, 15.6]],
          from: "กรุงเทพฯ", to: "บ้านโนนมะขาม", vehicle: "van", toIcon: `<g transform="translate(0,-16) scale(.12)">${Hn.hornet({ s: 1 })}</g>`, labDx: [40, -30] },
        dark: 0, light: false, grade: GDAY,
        cam: { keys: [{ t: 0, ...fr((WB[0] + WV[0]) / 2, (WB[1] + WV[1]) / 2, 1.5, 540, 900) }, { t: D("map") - 0.2, glide: 1.4, ...fr(WV[0], WV[1], 2.6, 540, 880) }] },
        captions: caps("map"),
        fx(tl, id, t0) { Maps.route(tl, "mp", t0, { go: [0.4, D("map") - 1.5] }); },
      });
      // ---------- 6. ภูมิ aims at the pods ----------
      add("phum", { ...Y0("y6"), cam: { keys: [{ t: 0, ...fr(470, 1180, 1.35, 540, 1100) }, { t: D("phum"), glide: D("phum"), ...fr(470, 1160, 1.45, 540, 1100) }] },
        actors: [A("phumSling", 420, 1500, 0.8, [{ t: 0, mode: "aim", eyes: "normal", mouth: "smile" }], { talk: [TALK("phum", 0)] })],
        captions: caps("phum", undefined, QUO),
        fx(tl, id, t0, L) { HnUI.tag(tl, L.light, t0 + 0.3, D("phum") - 0.3, { x: 330, y: 560, text: "ภูมิ 10 ขวบ", c: "#d8302a" }); } });
      // ---------- 7. เตย and her phone ----------
      add("toey", { ...Y0("y7", { tree: 1500, shrine: 1440, pond: false }), cam: { keys: [{ t: 0, ...fr(560, 1150, 1.4, 540, 1100) }] },
        actors: [A("toeyPhone", 560, 1500, 0.86, [{ t: 0, mode: "raise", eyes: "worry", mouth: "frown" }], { talk: [TALK("toey", 0, "frown")] })],
        captions: caps("toey", undefined, QUO),
        fx(tl, id, t0, L) { HnUI.tag(tl, L.light, t0 + 0.2, D("toey") - 0.2, { x: 760, y: 520, text: "พี่เตย 15", c: "#ec5e9e" }); } });
      // ---------- 8. the reveal: from the shrine up the trunk to the nest (the kids never look up) ----------
      add("reveal", { ...Y0("y8"),
        cam: { keys: [{ t: 0, ...fr(700, 1300, 1.25, 540, 1100) }, { t: F("reveal", 0, 1) + 0.1, glide: 1.6, ...fr(880, 560, 1.5, 540, 800) }] },
        actors: [A("phumSling", 400, 1500, 0.78, [{ t: 0, mode: "aim", eyes: "normal", mouth: "smile" }]), A("toeyPhone", 1080, 1480, 0.86, [{ t: 0, mode: "phoneLook", eyes: "side", mouth: "flat" }], { flip: true })],
        captions: caps("reveal"),
        fx(tl, id, t0, L) { buzz(tl, L.glow, "r8s", t0, D("reveal"), NX, NY + 230, 0.34, 110, 80, 10, 13); } });
      // ---------- 9. ยาย at the shrine → the rule board ----------
      split("rule", 1.9, { ...Y0("y9"), cam: { keys: [{ t: 0, ...fr(640, 1180, 1.5, 540, 1100) }] },
        actors: [A("yaiBua", 520, 1470, 0.92, [{ t: 0, mode: "wagFinger", eyes: "normal", mouth: "flat" }], { talk: [TALK("rule", 0)] }),
          A("phum", 880, 1500, 0.72, [{ t: 0, mode: "idle", eyes: "side", mouth: "flat" }], { flip: true })],
        captions: caps("rule", undefined, QUO),
        fx(tl, id, t0, L) { HnUI.tag(tl, L.light, t0 + 0.2, 1.6, { x: 300, y: 560, text: "ยายบัว 68", c: "#a888c8" }); } },
      { ...Y0("y9b"), blur: BLUR, cam: { keys: [{ t: 0, ...fr(700, 1100, 1.2, 540, 980) }] }, captions: capsFrom("rule", 1.9, [0], QUO),
        fx(tl, id, t0, L) { HnUI.rules(tl, L.light, t0, D("rule") - 1.9, { active: 0, y: 380 }); } });
      // ---------- 10. the legend: the เจ้าที่ and his soldiers ----------
      add("legend", { set: "hnLegend", setOpts: { id: "lg" }, dark: 0, light: false, grade: GDAY,
        cam: { keys: [{ t: 0, ...fr(540, 900, 1, 540, 960) }, { t: D("legend"), glide: D("legend"), ...fr(540, 960, 1.08, 540, 960) }] }, captions: caps("legend"),
        fx(tl, id, t0, L) { Hn.legend(tl, "lg", t0 + vo("legend", 1) - 0.3, D("legend") - vo("legend", 1) + 0.3, L); } });
      // ---------- 11. เตย scoffs ----------
      add("dismiss", { ...Y0("y11", { tree: 1500, shrine: 1440 }), cam: { keys: [{ t: 0, ...fr(560, 1080, 1.9, 540, 1000) }] },
        actors: [A("toeyPhone", 560, 1500, 0.86, [{ t: 0, mode: "phoneLook", eyes: "side", mouth: "smile" }], { talk: [TALK("dismiss", 0, "smile")] })],
        captions: caps("dismiss", undefined, QUO) });
      // ---------- 12. ลุงสิงห์: long sleeves, a hat, boots, under a blazing sun ----------
      add("sing", { ...Y0("y12", { house: [-200, 0.9], tree: 1700, shrine: 1640, pond: false, fence: [-300], sunX: 900, sunY: 260 }), grade: GHOT,
        cam: { keys: [{ t: 0, ...fr(560, 1180, 1.6, 540, 1100) }, { t: D("sing"), glide: D("sing"), ...fr(560, 1160, 1.75, 540, 1100) }] },
        actors: [A("lungSing", 560, 1480, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }], { flip: true })],
        captions: caps("sing"),
        fx(tl, id, t0, L) { HnUI.tag(tl, L.light, t0 + 0.3, D("sing") - 0.3, { x: 780, y: 600, text: "ลุงสิงห์ ข้างบ้าน", c: "#6a8aa8" });
          put(L.glow, `<g id="s12h">${[0, 1, 2].map((k) => `<path d="M${380 + k * 110},${1000 - k * 30}q20,-30 0,-60q-20,-30 0,-60" stroke="#fff6dc" stroke-width="6" fill="none" opacity=".45"/>`).join("")}</g>`);
          tl.fromTo("#s12h", { y: 0, opacity: 0.8 }, { y: -60, opacity: 0.2, duration: 1.2, repeat: 4, ease: "none", immediateRender: false }, t0); } });
      // ---------- 13. "ลุงบ้าแน่เลย" ----------
      add("crazy", { ...Y0("y13", { tree: 1500, shrine: 1440 }), cam: { keys: [{ t: 0, ...fr(560, 1120, 1.55, 540, 1080) }] },
        actors: [A("phum", 420, 1500, 0.74, [{ t: 0, mode: "idle", eyes: "side", mouth: "laugh" }], { talk: [TALK("crazy", 0, "smile")] }),
          A("toeyPhone", 700, 1490, 0.86, [{ t: 0, mode: "phoneLook", eyes: "side", mouth: "smile" }], { flip: true })],
        captions: caps("crazy", undefined, QUO) });
      // ---------- 14. the first hornet circles ภูมิ's face ----------
      add("first", { ...Y0("y14"), cam: { keys: [{ t: 0, ...fr(460, 1060, 2.0, 540, 1080) }, { t: D("first"), glide: D("first"), ...fr(460, 1060, 2.25, 540, 1080) }] },
        actors: [A("phumSling", 460, 1500, 0.8, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }])],
        captions: caps("first"),
        fx(tl, id, t0, L) { buzz(tl, L.glow, "f14", t0, D("first"), 470, 1080, 0.85, 120, 60, 1, 17); } });
      // ---------- 15. ภูมิ stands still — the turn ----------
      add("still", { ...Y0("y15"), cam: { keys: [{ t: 0, ...fr(460, 1110, 2.6, 540, 1080), drift: { s: 0.03 } }] },
        actors: [A("phumSling", 460, 1500, 0.8, [{ t: 0, mode: "tremble", eyes: "wide", mouth: "flat" }])],
        captions: caps("still"),
        fx(tl, id, t0, L) { buzz(tl, L.glow, "f15", t0, D("still"), 470, 1080, 0.85, 110, 50, 1, 19); } });
      // ---------- 16. เตย swats — and is stung ----------
      add("swat", { ...Y0("y16"), cam: { keys: [{ t: 0, ...fr(600, 1140, 1.5, 540, 1080) }] },
        shake: (t) => (t > 1.0 && t < 1.3 ? { x: 10 * Math.sin(t * 70), y: 6 * Math.sin(t * 61), r: 0 } : 0),
        actors: [A("phumSling", 440, 1500, 0.78, [{ t: 0, mode: "tremble", eyes: "wide", mouth: "flat" }]),
          A("toeyPhone", 720, 1490, 0.86, [{ t: 0, mode: "swat", eyes: "angry", mouth: "snarl" }, { t: 1.05, mode: "scratch", eyes: "pain", mouth: "scream" }], { flip: true })],
        captions: caps("swat"),
        fx(tl, id, t0, L) { buzz(tl, L.glow, "f16", t0, D("swat"), 640, 1100, 0.6, 140, 70, 3, 23);
          put(L.light, `<rect id="s16r" width="1080" height="1920" fill="#ff2a1a" opacity="0"/>`); tl.set("#s16r", { opacity: 0 }, 0);
          tl.fromTo("#s16r", { opacity: 0.4 }, { opacity: 0, duration: 0.35, immediateRender: false }, t0 + 1.05); } });
      // ---------- 17. ↺ 0:04 — the stone hit the nest's branch ----------
      split("rw", 3.4, { ...Y0("y17"), cam: { keys: [{ t: 0, ...fr(640, 1000, 0.92, 540, 900) }, { t: 3.4, glide: 2.4, ...fr(NX - 60, NY + 100, 1.8, 540, 820) }] },
        actors: [A("phumSling", 360, 1500, 0.78, [{ t: 0, mode: "aim", eyes: "normal", mouth: "smile" }, { t: 0.6, mode: "idle", eyes: "normal", mouth: "smile" }])],
        captions: caps("rw", [0]),
        fx(tl, id, t0, L) { rewind(L, tl, t0, 3.4, "0:04"); stone(L, tl, "r17", t0 + 0.35, 470, 1080); sway(tl, "y17", t0 + 0.83, 7, 3); } },
      { ...Y0("y17b"), cam: { keys: [{ t: 0, ...fr(NX - 60, NY + 60, 2.2, 540, 900) }] }, captions: capsFrom("rw", 3.4, [1]),
        fx(tl, id, t0, L) { const d = D("rw") - 3.4; stone(L, tl, "r17b", t0 + 0.4, 520, 820); sway(tl, "y17b", t0 + 0.88, 9, 4);
          buzz(tl, L.glow, "r17s", t0, d, NX, NY + 200, 0.5, 120, 80, 8, 29); } });
      // ---------- 18. the soldiers wake ----------
      add("wake", { set: "hnNest", setOpts: { id: "n18", crawl: 14 }, dark: 0, light: false, grade: GDAY,
        cam: { keys: [{ t: 0, ...fr(600, 1300, 1.2, 540, 960) }, { t: D("wake"), glide: D("wake"), ...fr(600, 1330, 1.5, 540, 960) }] },
        shake: (t) => 3 * Math.sin(t * 40),
        captions: caps("wake"),
        fx(tl, id, t0, L) { Hn.swarm(tl, L.glow, { id: "w18", n: 40, s: 1.0, path: [[0, 610, 1330], [D("wake"), 560, 1500]], rx: 420, ry: 420, grow: [0.1, 1.8], t0, dur: D("wake"), seed: 31 }); } });
      // ---------- 19. next ----------
      add("next", { ...Y0("y19"), captions: [], fx(tl, id, t0, L) { HnUI.nextBoard(tl, L.light, t0, D("next"), { l1: "ตอนที่ 2", l2: "ต่อรุม อย่าลงน้ำ" }); } });
