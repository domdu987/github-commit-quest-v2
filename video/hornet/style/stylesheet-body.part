          HnUI.tag(tl, L.light, t, d, { x: 720, y: 770, text: "พี่เตย 15", c: "#ec5e9e" }); HnUI.tag(tl, L.light, t, d, { x: 960, y: 880, text: "ลุงสิงห์", c: "#6a8aa8" }); } });
