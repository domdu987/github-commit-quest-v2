        actors: [A("toey", 640, 1520, 0.85, [{ t: 0, mode: "runCover", eyes: "wide", mouth: "scream" }], { flip: true, moveTo: { x: 900, y: 1560, dur: 3 } })],
        fx(tl, id, t0, L) { Hn.swarm(tl, L.glow, { id: "s3", n: 30, s: 0.45, path: [[0, 520, 1050], [3, 760, 1080]], rx: 200, ry: 150, chase: 0.5, t0, dur: D("swerve"), seed: 9 }); } });
