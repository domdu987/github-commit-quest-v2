      // ---------- ต่อหัวเสือ EP.2 ต่อรุม อย่าลงน้ำ ----------
      // grammar: chase wide (the swarm on เตย, the pond ahead) → the command at the pond's edge over the planted mistake (0:03: ยาย's door open behind
      // her) → pond section card → wide run → เตย's cry → ยาย's voice → rule board 2 → card indoors → one/still vs swarm/run → ลุงสิงห์ grabs her →
      // the shed door slams → inside → the scars (clue) → ภูมิ up the stairs → the empty room → ↺ 0:03 → ยาย at the shrine → "ยายไม่เป็นไรหรอก" → next
      const SUN = { from: "left", rim: "#fff6dc", rimOp: 0.8, shade: "#2a2440", shadeOp: 0.26, cast: { len: 1.3, op: 0.28 }, vol: false };
      const DIM = { from: "right", rim: "#ffe0a8", rimOp: 0.6, shade: "#1a120c", shadeOp: 0.45, cast: false, vol: false };
      const GDAY = { top: "#fff3d6", bottom: "#cfe6f4", op: 0.1 }, GIN = { top: "#3a2a1a", bottom: "#120c08", op: 0.25 };
      const A = (who, x, y, s, track, extra = {}) => { if (extra.talk) track.talk = extra.talk; return { who, x, y, s, track, blinks: [0.8, 2.9], ...extra }; };
      const TALK = (k, i, m = "o") => [vo(k, i), voEnd(k, i), m];
      const QUO = { quote: true };
      const G = 1320, HX = -100, HS = 0.9;            // ยาย's house; its doorway (world) ≈ x 35–129, y 654–897; the stairs from (278,1320) up to (143,897)
      const DOOR = [82, 780], STB = [300, 1330], STT = [150, 900];
      const Y2 = (id, o = {}) => ({ set: "hnYard", setOpts: { id, house: [HX, HS], door: "open", tree: 1400, shrine: 1330, pond: 820, shed: [1900, 1], ...o }, dark: 0, light: SUN, grade: GDAY, blur: { far: 1, fg: 6 } });
      const BLUR = { sky: 4, far: 6, mid: 6, set: 5, act: 5, fg: 8 };
      const swarmOn = (tl, L, id, t0, dur, path, o = {}) => Hn.swarm(tl, L.glow, { id, n: o.n || 28, s: o.s || 0.45, path, rx: o.rx || 170, ry: o.ry || 120, chase: o.chase ?? 0.45, t0, dur, seed: o.seed || 9 });
      // a towel thrown over เตย's head (world coords at her head), follows her with the same tween as the actor
      const towel = (L, id, x, y, s) => put(L.glow, `<g id="${id}"><g transform="translate(${x},${y}) scale(${s})"><path d="M-70,-60C-60,-110 60,-110 70,-60L90,90Q0,110 -90,90Z" fill="#f4f0e4" stroke="#2e2a26" stroke-width="4"/>
        <path d="M-60,40h120M-64,60h128" stroke="#c8402a" stroke-width="6"/></g></g>`);

      // ---------- 1. hook: the yard, เตย running for the pond, the swarm behind ----------
      add("hook", { ...Y2("e0"),
        cam: { keys: [{ t: 0, ...fr(420, 1180, 0.8, 540, 1000) }, { t: D("hook"), glide: D("hook"), ...fr(440, 1220, 0.92, 540, 1000) }] },
        actors: [A("toey", 60, 1520, 0.8, [{ t: 0, mode: "runCover", eyes: "wide", mouth: "scream" }], { moveTo: { x: 430, y: 1540, dur: D("hook") + 0.4, ease: "none" } })],
        captions: caps("hook"),
        fx(tl, id, t0, L) { swarmOn(tl, L, "e0s", t0, D("hook") + 2, [[0, -40, 1060], [D("hook") + 0.4, 360, 1080], [D("hook") + 2, 400, 1080]]); } });
      // ---------- 2. the command at the pond's edge; ยาย's door open behind her (0:03) ----------
      add("cmd", { ...Y2("e1"), cam: { keys: [{ t: 0, ...fr(270, 1180, 1.0, 540, 1040) }] },
        actors: [A("toey", 430, 1540, 0.8, [{ t: 0, mode: "cover", eyes: "wide", mouth: "scream" }])],
        captions: caps("cmd"),
        fx(tl, id, t0, L) { swarmOn(tl, L, "e1s", t0, D("cmd"), [[0, 400, 1100], [D("cmd"), 430, 1110]], { rx: 150, ry: 90 }); } });
      // ---------- 3. the pond in section ----------
      add("why", { ...Y2("e2"), blur: BLUR, cam: { keys: [{ t: 0, ...fr(820, 1400, 1.2, 540, 1000) }] }, captions: caps("why"),
        fx(tl, id, t0, L) { HnUI.water(tl, L.light, t0 + 0.1, D("why") - 0.1, { y: 260 }); } });
      // ---------- 4. wide: เตย along the pond, ภูมิ breaks for the house ----------
      add("run", { ...Y2("e3"), cam: { keys: [{ t: 0, ...fr(600, 1200, 0.62, 540, 1000) }] },
        actors: [A("toey", 430, 1560, 0.8, [{ t: 0, mode: "runCover", eyes: "wide", mouth: "scream" }], { moveTo: { x: 900, y: 1640, dur: D("run"), ease: "none" } }),
          A("phum", 720, 1500, 0.66, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }], { flip: true, moveTo: { x: 330, y: 1400, dur: D("run"), ease: "none" } })],
        captions: caps("run"),
        fx(tl, id, t0, L) { swarmOn(tl, L, "e3s", t0, D("run"), [[0, 380, 1110], [D("run"), 840, 1190]], { n: 34 }); } });
      // ---------- 5. "สระ! โดดน้ำ!" ----------
      add("toey", { ...Y2("e4"), cam: { keys: [{ t: 0, ...fr(900, 1260, 1.8, 540, 1060) }] },
        actors: [A("toey", 900, 1640, 0.8, [{ t: 0, mode: "point", eyes: "wide", mouth: "scream" }], { talk: [TALK("toey", 0, "scream")] })],
        captions: caps("toey", undefined, QUO),
        fx(tl, id, t0, L) { swarmOn(tl, L, "e4s", t0, D("toey"), [[0, 900, 1220]], { rx: 160, ry: 90, n: 14, s: 0.8 }); } });
      // ---------- 6. ยาย's voice from somewhere → the rule board (rule 2) ----------
      split("rule", 1.1, { ...Y2("e5"), cam: { keys: [{ t: 0, ...fr(900, 1240, 1.8, 540, 1060) }] },
        actors: [A("toey", 900, 1640, 0.8, [{ t: 0, mode: "cover", eyes: "side", mouth: "o" }])], captions: caps("rule", undefined, QUO),
        fx(tl, id, t0, L) { swarmOn(tl, L, "e5s", t0, 1.1, [[0, 900, 1220]], { rx: 160, ry: 90, n: 14, s: 0.8 }); } },
      { ...Y2("e5b"), blur: BLUR, cam: { keys: [{ t: 0, ...fr(1300, 1100, 1.2, 540, 980) }] }, captions: capsFrom("rule", 1.1, [0], QUO),
        fx(tl, id, t0, L) { HnUI.rules(tl, L.light, t0, D("rule") - 1.1, { active: 1, done: [0], y: 380 }); } });
      // ---------- 7. open ground ✗ / indoors ✓ ----------
      add("know", { ...Y2("e6"), blur: BLUR, cam: { keys: [{ t: 0, ...fr(200, 1100, 1.1, 540, 980) }] }, captions: caps("know"),
        fx(tl, id, t0, L) { HnUI.indoors(tl, L.light, t0 + 0.1, D("know") - 0.1, { y: 360 }); } });
      // ---------- 8. one → stand still · a swarm → run ----------
      split("one", F("one", 0, 1) - 0.05, { ...Y2("e7", { door: false, house: [-700, 0.9] }), cam: { keys: [{ t: 0, ...fr(520, 1100, 2.2, 540, 1060) }] },
        actors: [A("phum", 520, 1500, 0.78, [{ t: 0, mode: "tremble", eyes: "wide", mouth: "flat" }])], captions: caps("one"),
        fx(tl, id, t0, L) { Hn.swarm(tl, L.glow, { id: "e7s", n: 1, s: 0.85, cx: 530, cy: 1080, rx: 110, ry: 50, t0, dur: 2, seed: 17 }); } },
      { ...Y2("e7b"), cam: { keys: [{ t: 0, ...fr(600, 1200, 0.7, 540, 1000) }] }, captions: capsFrom("one", F("one", 0, 1) - 0.05),
        actors: [A("phum", 700, 1500, 0.66, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }], { flip: true, moveTo: { x: 340, y: 1400, dur: 2, ease: "none" } })],
        fx(tl, id, t0, L) { swarmOn(tl, L, "e7c", t0, 2, [[0, 820, 1060], [2, 420, 1000]], { n: 30 }); } });
      // ---------- 9. ลุงสิงห์ throws his towel over เตย and hauls her off the bank ----------
      add("grab", { ...Y2("e8", { shed: [1450, 1] }), cam: { keys: [{ t: 0, ...fr(1000, 1250, 1.05, 540, 1060) }, { t: D("grab"), glide: D("grab"), ...fr(1150, 1250, 1.05, 540, 1060) }] },
        actors: [A("toey", 900, 1640, 0.8, [{ t: 0, mode: "cover", eyes: "closed", mouth: "scream" }], { moveTo: { x: 1250, y: 1440, dur: D("grab") - 0.6, ease: "power1.in", at: 0.6 } }),
          A("lungSing", 1120, 1600, 0.92, [{ t: 0, mode: "push", eyes: "angry", mouth: "flat" }], { flip: true, moveTo: { x: 1360, y: 1420, dur: D("grab") - 0.6, ease: "power1.in", at: 0.6 } })],
        captions: caps("grab"),
        fx(tl, id, t0, L) { swarmOn(tl, L, "e8s", t0, D("grab"), [[0, 900, 1250], [D("grab"), 1100, 1150]], { n: 26 });
          towel(L, "e8t", 900, 1640 - 0.8 * 560, 0.8); tl.set("#e8t", { opacity: 0 }, 0); tl.fromTo("#e8t", { opacity: 1, y: -160 }, { y: 0, duration: 0.3, ease: "power2.in", immediateRender: false }, t0 + 0.2);
          tl.to("#e8t", { x: 350, y: -200, duration: D("grab") - 0.6, ease: "power1.in" }, t0 + 0.6); } });
      // ---------- 10. the shed door slams; hornets thud on the screen ----------
      add("shed", { ...Y2("e9", { shed: [600, 1.25], shedOpen: true, house: [-900, 0.9], tree: 1700, shrine: 1640, pond: false }),
        cam: { keys: [{ t: 0, ...fr(600, 1150, 1.25, 540, 1080) }] },
        shake: (t) => (t > 0.55 && t < 0.8 ? { x: 9 * Math.sin(t * 80), y: 6 * Math.sin(t * 71), r: 0 } : 0),
        captions: caps("shed", undefined, QUO),
        fx(tl, id, t0, L) {
          put(L.glow, `<g id="e9c"><path d="M${600 - 170 * 1.25},${1360 - 300 * 1.25}h${150 * 1.25}v${300 * 1.25}h-${150 * 1.25}z" fill="#7a4a28" stroke="#2e2a26" stroke-width="4"/><circle cx="${600 - 40 * 1.25}" cy="${1360 - 150 * 1.25}" r="8" fill="#d8b46a"/></g>`);
          tl.set("#e9c", { opacity: 0 }, 0); tl.set("#e9c", { opacity: 1 }, t0 + 0.55);
          Hn.swarm(tl, L.glow, { id: "e9s", n: 22, s: 0.5, cx: 600 + 130 * 1.25, cy: 1360 - 260 * 1.25, rx: 180, ry: 110, t0, dur: D("shed"), seed: 41 }); } });
      // ---------- 11. inside the shed: เตย shaking under the towel ----------
      const shedIn = (L) => { put(L.set, `<rect x="-600" y="-200" width="2300" height="2400" fill="#3a2614"/>${Array.from({ length: 30 }, (_, k) => `<path d="M${-600 + k * 80},-200V2200" stroke="#2a1a0c" stroke-width="5"/>`).join("")}
          <rect x="-600" y="1500" width="2300" height="700" fill="#4a3420"/><g transform="translate(760,700)"><rect x="-140" y="-120" width="280" height="240" fill="#e8f0e0" opacity=".85" stroke="#2e2a26" stroke-width="6"/>
          ${Array.from({ length: 14 }, (_, k) => `<path d="M${-140 + k * 20},-120v240M-140,${-120 + k * 17}h280" stroke="#6a6a6a" stroke-width="1.6"/>`).join("")}</g>
          <path d="M620,820L300,1700H1100L900,820Z" fill="#fff0c8" opacity=".14"/><rect x="200" y="1360" width="220" height="150" fill="#6a4a2a" stroke="#2e2a26" stroke-width="4"/>`); };
      add("thanks", { set: "hnYard", setOpts: { id: "e10", nest: false, pond: false, shrine: false, house: false }, dark: 0.1, light: DIM, grade: GIN, cam: { keys: [{ t: 0, ...fr(520, 1180, 1.25, 540, 1060) }] },
        extra(L) { shedIn(L); }, captions: caps("thanks", undefined, QUO),
        actors: [A("toey", 310, 1510, 0.86, [{ t: 0, mode: "sitChair", eyes: "closed", mouth: "frown" }], { talk: [TALK("thanks", 0, "frown")] }),
          A("lungSing", 760, 1560, 0.92, [{ t: 0, mode: "idle", eyes: "side", mouth: "flat" }], { flip: true })],
        fx(tl, id, t0, L) { Hn.swarm(tl, L.glow, { id: "e10s", n: 8, s: 0.6, cx: 760, cy: 700, rx: 120, ry: 90, t0, dur: D("thanks"), seed: 43 }); } });
      // ---------- 12. insert: the back of ลุงสิงห์'s hand on the door bar — old scars ----------
      add("scars", { set: "hnYard", setOpts: { id: "e11", nest: false, pond: false, shrine: false, house: false }, dark: 0, light: false, grade: GIN, cam: { keys: [{ t: 0, ...fr(540, 960, 1, 540, 960) }, { t: D("scars"), glide: D("scars"), ...fr(560, 1000, 1.12, 540, 960) }] },
        extra(L) { shedIn(L); put(L.act, `<g transform="translate(540,1000)"><rect x="-700" y="-40" width="1400" height="80" fill="#8a5a30" stroke="#2e2a26" stroke-width="5"/>
          <path d="M-520,330L-200,120" stroke="#6a8aa8" stroke-width="170" stroke-linecap="round"/><path d="M-560,360L-250,160" stroke="#5a7a98" stroke-width="40" stroke-linecap="round"/>
          <path d="M-220,140C-160,40 -40,0 80,-10C150,-14 200,10 210,40C220,70 180,90 130,80L60,70C40,110 -60,170 -150,190Z" fill="#a8744a" stroke="#2e2a26" stroke-width="5"/>
          ${[[90, -60], [150, -50], [205, -36], [250, -20]].map(([x, y], k) => `<path d="M${x - 70},${y + 50}Q${x - 20},${y - 10} ${x + 10},${y - 40}Q${x + 30},${y - 50} ${x + 30},${y - 20}L${x + 10},${y + 40}" fill="#a8744a" stroke="#2e2a26" stroke-width="4"/>`).join("")}
          ${[[-120, 120, 40], [-60, 80, 30], [0, 60, 34], [-90, 40, 26], [30, 20, 22], [-150, 70, 20]].map(([x, y, w]) => `<path d="M${x},${y}q${w / 2},-8 ${w},2" stroke="#e8c8a8" stroke-width="7" fill="none" stroke-linecap="round"/><circle cx="${x + w / 2}" cy="${y - 2}" r="4" fill="#c89878"/>`).join("")}</g>`); },
        captions: caps("scars") });
      // ---------- 13. ภูมิ up ยาย's stairs and in ----------
      add("phum", { ...Y2("e12"), cam: { keys: [{ t: 0, ...fr(220, 1100, 1.15, 540, 1060) }] },
        actors: [A("phum", 470, 1500, 0.66, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }], { flip: true, path: [{ t: 0, x: 470, y: 1500 }, { t: 0.8, x: STB[0], y: STB[1] }, { t: 2.0, x: STT[0], y: STT[1] }, { t: 2.4, x: DOOR[0], y: STT[1] }] })],
        captions: caps("phum"),
        fx(tl, id, t0, L) { swarmOn(tl, L, "e12s", t0, D("phum"), [[0, 600, 1100], [2.4, 260, 760]], { n: 14, chase: 0.8 }); } });
      // ---------- 14. the empty room: "ยาย! ยายอยู่ไหน?" ----------
      add("where", { set: "hnYard", setOpts: { id: "e13", nest: false, pond: false, shrine: false, house: false }, dark: 0.05, light: DIM, grade: GIN, cam: { keys: [{ t: 0, ...fr(540, 1150, 1.2, 540, 1060) }] },
        extra(L) { put(L.set, `<rect x="-600" y="-200" width="2300" height="2400" fill="#6a4630"/>${Array.from({ length: 30 }, (_, k) => `<rect x="${-600 + k * 80}" y="-200" width="80" height="1700" fill="${k % 2 ? "#7a5236" : "#704a30"}"/>`).join("")}
          <rect x="-600" y="1500" width="2300" height="700" fill="#8a6440"/><rect x="200" y="760" width="240" height="300" fill="#cfe6f4" stroke="#2e2a26" stroke-width="6"/><path d="M320,760v300M200,910h240" stroke="#2e2a26" stroke-width="5"/>
          <rect x="700" y="1260" width="380" height="60" rx="8" fill="#5a3a22" stroke="#2e2a26" stroke-width="4"/><path d="M720,1320v180M1060,1320v180" stroke="#4a2e1a" stroke-width="14"/>
          <g transform="translate(860,560)"><rect x="-90" y="-60" width="180" height="120" fill="#e8dcc4" stroke="#2e2a26" stroke-width="5"/><text y="12" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="30" fill="#5a3a22">ยายบัว</text></g>`); },
        actors: [A("phum", 480, 1520, 0.8, [{ t: 0, mode: "point", eyes: "wide", mouth: "scream" }], { talk: [TALK("where", 0, "scream")] })],
        captions: caps("where", undefined, QUO) });
      // ---------- 15. ↺ 0:03 — the door was open behind her ----------
      split("rw", 3.0, { ...Y2("e14"), cam: { keys: [{ t: 0, ...fr(270, 1180, 1.0, 540, 1040) }, { t: 3.0, glide: 2.2, ...fr(DOOR[0] + 20, DOOR[1] + 40, 2.1, 540, 900) }] },
        actors: [A("toey", 430, 1540, 0.8, [{ t: 0, mode: "cover", eyes: "wide", mouth: "scream" }])], captions: caps("rw", [0]),
        fx(tl, id, t0, L) { rewind(L, tl, t0, 3.0, "0:03"); swarmOn(tl, L, "e14s", t0, 3, [[0, 400, 1100]], { rx: 150, ry: 90 }); } },
      { ...Y2("e14b"), cam: { keys: [{ t: 0, ...fr(DOOR[0] + 60, DOOR[1] + 140, 1.45, 540, 960) }] }, captions: capsFrom("rw", 3.0, [1]),
        actors: [A("toey", 430, 1540, 0.8, [{ t: 0, mode: "cover", eyes: "wide", mouth: "scream" }])],
        fx(tl, id, t0, L) { put(L.glow, `<g id="e14r"><ellipse cx="${DOOR[0]}" cy="${DOOR[1]}" rx="110" ry="160" fill="none" stroke="#ff3a2a" stroke-width="10" stroke-dasharray="1 1" pathLength="1"/></g>`);
          tl.fromTo("#e14r ellipse", { attr: { "stroke-dashoffset": 1 } }, { attr: { "stroke-dashoffset": 0 }, duration: 0.6, immediateRender: false }, t0 + 0.3); } });
      // ---------- 16. ยาย at the shrine all along ----------
      add("shrine", { ...Y2("e15", { tree: 760, shrine: 700, pond: 1600, house: [-700, 0.9], door: false }), cam: { keys: [{ t: 0, ...fr(760, 1000, 1.0, 540, 980) }, { t: D("shrine"), glide: D("shrine"), ...fr(780, 1180, 1.35, 540, 1040) }] },
        extra(L) { put(L.set, Hn.bench(880, 1340, 0.8)); },
        actors: [A("yaiBua", 880, 1462, 0.86, [{ t: 0, mode: "cover", eyes: "closed", mouth: "frown" }], { flip: true })],
        captions: caps("shrine"),
        fx(tl, id, t0, L) { Hn.swarm(tl, L.glow, { id: "e15s", n: 16, s: 0.4, cx: 910, cy: 700, rx: 160, ry: 120, t0, dur: D("shrine"), seed: 51 }); } });
      // ---------- 17. "ยายไม่เป็นไรหรอก" — her arms dotted with stings ----------
      add("fine", { ...Y2("e16", { tree: 760, shrine: 700, pond: 1600, house: [-700, 0.9], door: false }), cam: { keys: [{ t: 0, ...fr(880, 1090, 2.4, 540, 1000), drift: { s: 0.02 } }] },
        extra(L) { put(L.set, Hn.bench(880, 1340, 0.8)); },
        actors: [A("yaiBua", 880, 1462, 0.86, [{ t: 0, mode: "sitChair", eyes: "closed", mouth: "smile" }], { flip: true, talk: [TALK("fine", 0, "smile")] })],
        captions: caps("fine", undefined, QUO),
        fx(tl, id, t0, L) { put(L.glow, `<g id="e16d">${[[840, 1180], [852, 1205], [830, 1220], [865, 1235], [845, 1250], [920, 1190], [935, 1215], [912, 1232], [928, 1252]].map(([x, y]) => `<circle cx="${x}" cy="${y}" r="7" fill="#ff7a6a" opacity=".55"/><circle cx="${x}" cy="${y}" r="2.6" fill="#a01e18"/>`).join("")}</g>`); } });
      // ---------- 18. next ----------
      add("next", { ...Y2("e17"), captions: [], fx(tl, id, t0, L) { HnUI.nextBoard(tl, L.light, t0, D("next"), { l1: "ตอนที่ 3 (ตอนจบ)", l2: "ยายบอกว่าไม่เป็นไร", l3: "กดติดตาม แล้วพายายไปหาหมอด้วยกัน" }); } });
