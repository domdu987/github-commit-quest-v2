        captions: [], fx(tl, id, t0, L) {
          ["uaF", "uaB"].forEach((j) => document.getElementById(`${id}-a0-${j}`).setAttribute("display", "none"));
          put(L.act, PopL.ghost(780, 1430, 0.78, { face: "greedy", hold: `<g transform="rotate(-20)"><ellipse cx="0" cy="-40" rx="30" ry="18" fill="#b8bec4" ${OL(3)}/><path d="M0,-24v70" stroke="#9aa0a6" stroke-width="10"/></g>` }));
          const V = Rig.CAST.lungThid.v2, sk = V.skin;
          const cleaver = `<g transform="rotate(90)"><rect x="-9" y="-46" width="18" height="60" rx="6" fill="#4a3424" ${OL(2.4)}/><path d="M-50,10H40V64Q-6,80 -50,66Z" fill="#c8ced4" ${OL(2.6)}/><path d="M-42,22H32" stroke="#fff" stroke-width="5" opacity=".7"/><path d="M-50,60Q-6,74 40,60" stroke="#8a9096" stroke-width="3" fill="none"/></g>`;
          put(L.act, `<g transform="translate(500,1330)"><rect x="-330" y="0" width="660" height="400" fill="#6a4630" ${OL(5)}/><rect x="-330" y="0" width="660" height="40" fill="#8a5e3e" ${OL(4)}/>
            <ellipse cx="0" cy="-6" rx="250" ry="60" fill="#8a5a34" ${OL(4)}/><ellipse cx="0" cy="-16" rx="232" ry="50" fill="#a8743e"/>
            <path d="M-150,-24Q0,-90 150,-24Q60,-2 0,0Q-80,-2 -150,-24Z" fill="#a8323a" ${OL(3)}/>${[[-80, -40], [-30, -56], [40, -50], [100, -34]].map(([a, b2]) => `<circle cx="${a}" cy="${b2}" r="7" fill="#f2b0b6"/>`).join("")}</g>
            ${PopL.arm([424, 1165], [338, 1246], [318, 1160], { skin: sk, w: 24, hand: "grip", hs: 1.25, ha: -90, hold: cleaver })}
