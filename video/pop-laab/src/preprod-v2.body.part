          put(L.light, `<g transform="translate(1100,640) rotate(-38) scale(1.55)">${PopL.ghost(0, 0, 1, { face: "lick", arm: false, flip: true, id: "pgb" })}</g><radialGradient id="hbV"><stop offset=".55" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".55"/></radialGradient><rect width="1080" height="1920" fill="url(#hbV)"/>`);
          hookUI(L, "ถ้าวันหนึ่ง… ผีปอบมาร่วมวงลาบหมูดิบกับคุณ", "อย่ากินหมูดิบ", { y: 1360 }); } });
      // ===== HOOK C: the two-shot — ลุงทิด minces raw pork bare-handed (a plaster on a cut finger); the ghost over his shoulder, spoon ready =====
      add("hC", { ...KIT("hc"), blur: { far: 4, mid: 3, set: 2, fg: 8 }, cam: { keys: [{ t: 0, ...fr(560, 1180, 1.5, 540, 1000) }] },
