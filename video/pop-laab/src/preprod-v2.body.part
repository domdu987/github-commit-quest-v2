          { who: "prae", x: 930, y: 1620, s: 0.84, flip: true, blinks: [9], track: [{ t: 0, mode: "sitX", eyes: "worry", mouth: "o" }] },
          { who: "tonkla", x: 760, y: 1760, s: 0.84, flip: true, blinks: [9], track: [{ t: 0, mode: "sitX", eyes: "normal", mouth: "laugh" }] }],
        captions: [], fx(tl, id, t0, L) { put(L.set, PopL.mat(540, 1560, 1700, 420));
          PopL.seat(id, 0, "yaiBua", { legs: "fold", F: [[100, -390], [140, -330], "rest"], B: [[-100, -385], [-130, -325], "rest"] });
          PopL.seat(id, 1, "lungThid", { F: [[150, -390], [120, -470], "pinch", { hold: PopL.bite(0.5) }], B: [[-125, -385], [-150, -320], "rest"] });
          PopL.seat(id, 2, "prae", { legs: "fold", F: [[110, -390], [150, -330], "rest"], B: [[-104, -385], [-120, -320], "rest"] });
          PopL.seat(id, 3, "tonkla", { F: [[140, -395], [190, -440], "open"], B: [[-125, -385], [-150, -320], "rest"] }); put(L.act, PopL.tray(520, 1800, 1.0)); put(L.act, PopL.ghost(560, 1600, 0.62, { face: "grin", hold: PopL.bite(1.3) })); bulbs(L, -200, 1280, 300); } });
      // ===== STYLE FRAME 3: the ghost sheet — four faces (grin · greedy · lick · deaf, ears drooping) on a shadow-play legend panel =====
      add("sf3", { set: "kitchen2", setOpts: { id: "s3", time: "late" }, dark: 0.2, light: false, grade: GN, cam: { keys: [{ t: 0, ...fr(540, 960, 1, 540, 960) }] },
        captions: [], fx(tl, id, t0, L) {
          put(L.light, `<rect x="40" y="120" width="1000" height="1660" rx="40" fill="#f2e2b8" stroke="#6a4424" stroke-width="10"/><rect x="70" y="150" width="940" height="1600" rx="28" fill="none" stroke="#c8963a" stroke-width="4" stroke-dasharray="18 10"/>
            <text x="540" y="240" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="64" fill="#5a2a1a">ปอบ · สายกินดิบตัวพ่อ</text>
            ${[["grin", 300, 760, 0], ["greedy", 780, 760, 0], ["lick", 300, 1460, 0], ["huh", 780, 1460, 0.9]].map(([f, x, y, d]) => PopL.ghost(x, y, 0.62, { face: f, droop: d, id: `sh${f}` })).join("")}
            ${[["ยิ้มกว้าง", 300, 820], ["ตาเป็นมัน", 780, 820], ["เลียปาก", 300, 1520], ["หูดับ หูตก", 780, 1520]].map(([t, x, y]) => `<text x="${x}" y="${y}" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="40" fill="#5a2a1a">${t}</text>`).join("")}
            <text x="540" y="1680" text-anchor="middle" font-family="Mali" font-weight="700" font-size="30" fill="#7a3a2a">ตัวกลมหัวโต · หูใหญ่ (ยิ่งกินดิบ หูยิ่งตก) · ผ้าขาวม้าพันคอ</text>`); } });
