          PopL.seat(id, 1, "lungThid", { F: [[140, -400], [110, -470], "pinch", { hold: PopL.bite(0.5) }], B: [[-125, -385], [-150, -320], "rest"] });
          put(L.act, PopL.tray(450, 1640, 0.95));
          put(L.act, PopL.ghost(900, 1660, 0.95, { face: "greedy", arm: false, id: "pga" }));
          // the reach: the arm comes out of the ghost's shoulder TOWARD the lens — foreshortened, widening, the hand and the bite big and close
          put(L.act, `<path d="M796,1468C760,1500 720,1540 676,1560L612,1548C660,1520 720,1470 760,1430Z" fill="#b9cc9a" ${OL(4)}/><path d="M770,1470C740,1500 700,1528 660,1546" stroke="#8a96a6" stroke-width="14" fill="none" opacity=".35"/>
            <g transform="translate(590,1600) rotate(-8)"><ellipse cx="0" cy="70" rx="150" ry="40" fill="#000" opacity=".18"/>
              <path d="M-130,30Q-136,96 -60,116Q0,128 60,116Q136,96 130,30Q80,62 0,66Q-80,62 -130,30Z" fill="#b9cc9a" ${OL(4)}/>
              <g transform="translate(0,-8) scale(3)"><ellipse cx="0" cy="4" rx="44" ry="32" fill="#f6f0dc" ${OL(1.4)}/>${[[-24, 14], [-6, 20], [14, 16], [28, 8]].map(([a, b2]) => `<ellipse cx="${a}" cy="${b2}" rx="5" ry="3" fill="#fffaf0" stroke="#d8ccb0" stroke-width=".8"/>`).join("")}
                <path d="M-42,0Q-42,-40 -6,-46Q36,-46 42,-4Q24,8 0,6Q-22,10 -42,0Z" fill="#a8323a" ${OL(1.4)}/><path d="M-30,-20Q0,-40 30,-22" stroke="#c84a50" stroke-width="5" fill="none" opacity=".7"/>
                ${[[-26, -12, "#f2b0b6"], [-12, -30, "#8a1e2a"], [4, -18, "#f2b0b6"], [20, -30, "#8a1e2a"], [28, -12, "#f2b0b6"], [-4, -4, "#8a1e2a"], [12, -6, "#e8302a"], [-18, -24, "#e8302a"]].map(([a, b2, c]) => `<circle cx="${a}" cy="${b2}" r="3" fill="${c}"/>`).join("")}
                <path d="M-8,-44l9,-12l7,11zM10,-40l12,-6l-2,10z" fill="#4aa04a" stroke="#2a5a2a" stroke-width=".8"/></g>
              ${[-92, -40, 12, 64].map((fx2, k) => `<path d="M${fx2},${70 - Math.abs(k - 1.5) * 4}q8,-34 26,-38q14,2 12,18q-6,18 -10,30" fill="#b9cc9a" ${OL(3.4)}/>`).join("")}<path d="M124,40q30,-26 20,-56q-14,-8 -24,8q-6,24 -14,40" fill="#b9cc9a" ${OL(3.4)}/>
              <path d="M-90,70Q0,96 90,70" stroke="#8a96a6" stroke-width="10" fill="none" opacity=".35"/></g>`);
          hookUI(L, "ถ้าวันหนึ่ง… ผีปอบมาร่วมวงลาบหมูดิบกับคุณ", "อย่ากินหมูดิบ", { y: 1420 }); } });
      // ===== HOOK B: the macro — the raw laab fills the frame; a long tongue slides in from the dark; one glowing eye at the edge =====
      add("hB", { ...KIT("hb"), blur: { sky: 8, far: 8, mid: 8, set: 6, fg: 10 }, cam: { keys: [{ t: 0, ...fr(540, 1500, 1.9, 540, 1050) }] },
