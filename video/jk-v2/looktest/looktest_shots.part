        fx(tl, id, t0, L) { const g = grp(L.light); g.innerHTML = ["A", "B", "C", "D"].map((k, i) => `<text x="${120 + i * 276}" y="640" font-family="Kanit" font-weight="900" font-size="60" fill="#fff">${k}</text>`).join(""); } });
