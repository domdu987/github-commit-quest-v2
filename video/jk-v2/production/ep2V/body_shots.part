          earBlinkV(tl, L, `${id}-a0`, HX, HY, 0.95, true, t0 + tE, D("m08") - tE); earSpill(tl, L, HX + 10, HY + 6, t0 + tE, D("m08") - tE, 0.28, 0.6); brakeBadge(tl, L, id, t0 + F("m08", 0, 3), D("m08") - F("m08", 0, 3), 800, 380); } });
