          const sp = grp(L.set); sp.innerHTML = `<ellipse cx="700" cy="1402" rx="40" ry="10" fill="#000" opacity=".1" style="filter:blur(6px)"/>`; tl.fromTo(sp.firstChild, { attr: { rx: 40, ry: 10 }, opacity: 0.1 }, { attr: { rx: 150, ry: 30 }, opacity: 0.4, duration: 0.95, ease: "power2.in", immediateRender: false }, t0);
