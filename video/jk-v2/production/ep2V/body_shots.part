        actors: [...CROWD(), ME2([{ t: 0, mode: "prone", eyes: "worry", mouth: "pout" }, { t: KEN_ARRIVE, mode: "prone", eyes: "wide", mouth: "o" }]), KEN2(-260, [{ t: 0, mode: "walk", eyes: "angry", mouth: "frown" }, { t: KEN_ARRIVE, mode: "idle", eyes: "angry", mouth: "frown" }], { moveTo: { x: 556, dur: KEN_ARRIVE - 0.1, at: 0.05 } })],
        fx(tl, id, t0, L) { hud(id, HUD2(0)); shadowsV(L, id, act("m04"), 0.55, 0.3); DEPTH(L, { haze: "#f0b8a0", far: 0.2, mid: 0.08, floorY: 1560 }); LANTERNS(L); crowdRow(L, { n: 18, x0: -300, y: 1300 }); vHeads(L, 0.85); const bg4 = grp(L.set); bg4.innerHTML = bagSvg(BAGX, HY); tl.to(bg4, { scaleY: 0.72, scaleX: 1.08, svgOrigin: `${BAGX} ${HY}`, duration: 0.12, ease: "power2.in" }, t0 + KEN_ARRIVE - 0.05);
