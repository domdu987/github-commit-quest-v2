      shot("m07", { ...TOWN2("m07"), blur: { far: 8, mid: 4 }, cam: { keys: [{ t: 0, ...fr(640, 1000, 0.95, 540, 960), drift: { s: 0.012 } }, { t: F("m07", 0, 2) + 0.2, ...fr(690, 820, 1.6, 540, 760), glide: 0.5 }] }, actors: RAISED,
        fx(tl, id, t0, L) { const t1 = F("m07", 0, 1), t2 = F("m07", 0, 2); hudSwap(id, tl, t0, [[0, 0], [t1 + 0.3, 15], [t1 + 0.9, 42], [t1 + 1.5, 64]]); shadowsV(L, id, RAISED, 0.55, 0.3); DEPTH(L, { haze: "#f0b8a0", far: 0.2, mid: 0.08, floorY: 1560 }); LANTERNS(L); crowdRow(L, { n: 18, x0: -300, y: 1300 }); vHeads(L, 0.8);
