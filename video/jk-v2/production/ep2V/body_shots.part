          const st = grp(L.act); st.innerHTML = [0, 1, 2, 3, 4, 5].map((k) => `<ellipse id="${id}-st${k}" cx="${640 + k * 24}" cy="${1394 + (k % 2) * 4}" rx="${9 + (k % 3) * 2}" ry="${6 + (k % 2) * 2}" fill="#8a8078"/>`).join(""); tl.set(st, { opacity: 0 }, 0); tl.set(st, { opacity: 1 }, t0 + F("m06", 0, 1) - 0.3);
          [0, 1, 2, 3, 4, 5].forEach((k) => tl.to(`#${id}-st${k}`, { attr: { cx: BAGX + 4, cy: 1360 }, duration: 0.3, ease: "power1.in", delay: k * 0.12 }, t0 + F("m06", 0, 1) + 0.2)); tl.to(st, { opacity: 0, duration: 0.05 }, t0 + F("m06", 0, 1) + 1.2);
          const hb = grp(L.act); hb.innerHTML = `<path d="M700,1385q-30,-10 -60,0" stroke="#c68b60" stroke-width="10" stroke-linecap="round" fill="none" opacity="0"/>`; tl.fromTo(hb.firstChild, { opacity: 0.9, x: 40 }, { x: -40, duration: 0.35, repeat: 3, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0 + F("m06", 0, 1) + 0.1); tl.to(hb, { opacity: 0, duration: 0.05 }, t0 + F("m06", 0, 1) + 1.5);
          const sh = grp(L.light); sh.innerHTML = `<text x="380" y="330" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="66" fill="#f6d36a" stroke="#3a2a10" stroke-width="10" paint-order="stroke" transform="rotate(-6 380 330)">ทองคำ 100 เหรียญ!</text>`; tl.set(sh, { opacity: 0 }, 0); pop(tl, sh, t0 + F("m06", 0, 4) + 0.2, { origin: "380 330", from: 0.6, dur: 0.3 }); out(tl, sh, t0 + D("m06") - 0.3); } });
