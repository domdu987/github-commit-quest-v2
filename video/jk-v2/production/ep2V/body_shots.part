        actors: [...CROWD(), ME2([{ t: 0, mode: "prone", eyes: "sad", mouth: "frown" }, { t: F("m02", 0, 1), mode: "prone", eyes: "worry", mouth: "pout" }])],
        fx(tl, id, t0, L) { hud(id, HUD2(0)); shadowsV(L, id, act("m02"), 0.55, 0.3); DEPTH(L, { haze: "#f0b8a0", far: 0.2, mid: 0.08, floorY: 1560 }); LANTERNS(L); crowdRow(L, { n: 18, x0: -300, y: 1300 }); put(L.set, bagSvg(BAGX, HY)); } });
      // ---------- m03 · the ranking board: Ken at 10, you at 9,999 — ท้ายสุด ----------
      const BY = (k) => 1180 + (-500 + k * 70 + (k === 4 ? 20 : 0)) + 28;   // world y of a board row's centre (rows at -500 + 70k, the last one 20 lower)
      shot("m03", { ...TOWN2("m03"), blur: { far: 9, mid: 5 }, cam: { keys: [{ t: 0, ...fr(1000, 860, 1.25, 540, 760), drift: { s: 0.006 } }, { t: F("m03", 0, 1) + 0.1, ...fr(1000, BY(3) + 10, 2.3, 540, 900), glide: 0.5 }, { t: F("m03", 0, 3) + 0.1, ...fr(1000, BY(4) + 10, 2.5, 540, 900), glide: 0.45 }] },
        fx(tl, id, t0, L) { hud(id, HUD2(0)); DEPTH(L, { haze: "#f0b8a0", far: 0.2, mid: 0.08 }); LANTERNS(L);
          const hl = grp(L.set); hl.innerHTML = `<rect id="${id}-h10" x="765" y="${BY(3) - 32}" width="470" height="62" rx="12" fill="none" stroke="#f6d36a" stroke-width="7"/><rect id="${id}-h99" x="765" y="${BY(4) - 32}" width="470" height="62" rx="12" fill="none" stroke="#d8352a" stroke-width="7"/>`;
          tl.set(`#${id}-h10`, { opacity: 0 }, 0); tl.set(`#${id}-h99`, { opacity: 0 }, 0); tl.fromTo(`#${id}-h10`, { opacity: 0 }, { opacity: 1, duration: 0.2, repeat: 3, yoyo: true, immediateRender: false }, t0 + F("m03", 0, 1) + 0.3); tl.to(`#${id}-h10`, { opacity: 0, duration: 0.2 }, t0 + F("m03", 0, 3));
