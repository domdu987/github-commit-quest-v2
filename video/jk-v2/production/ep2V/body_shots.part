        actors: [...CROWD(), ME2([{ t: 0, mode: "prone", eyes: "wide", mouth: "o" }, { t: F("m05", 0, 3), mode: "duck", eyes: "sad", mouth: "scream" }]), KEN2(540, [{ t: 0, mode: "point", eyes: "angry", mouth: "frown" }], { talk: [[0.2, F("m05", 0, 3) - 0.2, "o"]] }), KENLS(540, [{ t: 0, mode: "raise", eyes: "angry", mouth: "scream" }], { from: F("m05", 0, 3), talk: [[0.3, D("m05") - F("m05", 0, 3) - 0.6, "o"]] })],
