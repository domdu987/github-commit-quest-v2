          const st = grp(L.act); st.innerHTML = `<g transform="translate(1110,${BY(4) + 6}) rotate(-8)"><rect x="-80" y="-32" width="160" height="64" rx="10" fill="none" stroke="#d8352a" stroke-width="7"/><text x="0" y="15" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="40" fill="#d8352a">ท้ายสุด</text></g>`;
