      // ---------- EP.2 · องก์ 2 (part 1): rank 9,999 in front of the guild, Ken's threat, the first lie, the ear, the sword at the throat ----------
      const BAGX = 590;   // HX/HY/KX come from the shared helpers
      // sitting on one knee, dejected: the kneelUp legs (verified in EP.1) with the arms resting low on the knee
      Rig.MODES.kneelDown = (u, o) => { const j = Math.sin(u * 2.4) * 1.2; return { ...Rig.MODES.idle(u, o), thF: -84, shF: 96, thB: -14, shB: 92, torso: 12 + j * 0.3, head: 6 + j, uaF: -30 + j, faF: -34, uaB: 22 - j, faB: -24, bodyY: 216 }; };
      const HUD2 = (n) => [["อันดับ", "9,999", "#ff8a7a"], ["คนเชื่อ", `${n}/100`, "#f2c55c"]];
      // several HUD states in one shot: hudSwap(id, tl, t0, [[t, n], …]) shows the panel for n from t on
      const hudSwap = (id, tl, t0, states) => { states.forEach(([, n]) => hud(id, HUD2(n))); const els = [...document.querySelectorAll(`#${id} .sghud`)]; els.forEach((e, i) => tl.set(e, { opacity: i === 0 ? 1 : 0 }, 0));
        states.forEach(([t], i) => { if (i === 0) return; tl.set(els[i - 1], { opacity: 0 }, t0 + t); tl.set(els[i], { opacity: 1 }, t0 + t); }); };
      // the briefcase on the ground (closed, or open with the insurance paper showing — planted for act 4)
      const bagSvg = (x, y, open = false) => `<g transform="translate(${x},${y})"><ellipse cx="4" cy="4" rx="48" ry="9" fill="#000" opacity=".3" style="filter:blur(4px)"/>${open ? `<rect x="-36" y="-70" width="72" height="22" rx="4" fill="#3a281c" transform="rotate(-24 -36 -48)"/><rect x="-30" y="-50" width="60" height="14" fill="#2a1a10"/><g transform="translate(-4,-56) rotate(-10)"><rect x="-20" y="-16" width="40" height="26" rx="2" fill="#f4ecd8"/><rect x="-20" y="-16" width="40" height="6" fill="#2a4a8a"/><path d="M-14,-4h28M-14,2h20" stroke="#8a8a92" stroke-width="2"/></g>` : ""}<rect x="-38" y="-54" width="76" height="${open ? 40 : 54}" rx="6" fill="#4a3426" transform="translate(0,${open ? 14 : 0})"/><rect x="-38" y="-54" width="76" height="12" fill="#3a281c" opacity="${open ? 0 : 1}"/><path d="M-12,-54v-12h24v12" stroke="#3a281c" stroke-width="5" fill="none" opacity="${open ? 0 : 1}"/><rect x="-5" y="-38" width="10" height="8" fill="#c8a040"/><rect x="-38" y="-14" width="76" height="14" fill="url(#jkdAO)" opacity=".5"/></g>`;
      // a crowd of onlookers upstage (flat figures in the plaza plane, behind the cast)
      const crowdRow = (L, o = {}) => { const r = (() => { let s = o.seed || 5; return () => { s = (s * 16807) % 2147483647; return (s - 1) / 2147483646; }; })(); const cols = ["#6a4a3a", "#4a5a7a", "#7a5a4a", "#5a6a4a", "#8a6a5a", "#4a4a5a", "#9a7a5a"]; let h = "";
        for (let i = 0; i < (o.n ?? 16); i++) { const x = (o.x0 ?? -200) + i * (o.gap ?? 95) + r() * 30, y = (o.y ?? 1310) + r() * 20, s = (o.s ?? 0.62) + r() * 0.1, c = cols[Math.floor(r() * cols.length)], sk = ["#e8b890", "#d4a07a", "#c68b60"][Math.floor(r() * 3)];
          h += `<g transform="translate(${x.toFixed(0)},${y.toFixed(0)}) scale(${s.toFixed(2)})"><ellipse cy="4" rx="40" ry="8" fill="#000" opacity=".25"/><rect x="-26" y="-230" width="52" height="150" rx="18" fill="${c}"/><rect x="-26" y="-230" width="52" height="150" rx="18" fill="url(#flV)"/><rect x="-18" y="-90" width="14" height="90" rx="6" fill="#3a3040"/><rect x="4" y="-90" width="14" height="90" rx="6" fill="#3a3040"/><circle cy="-262" r="34" fill="${sk}"/><path d="M-34,-266C-36,-300 -10,-306 0,-306C14,-306 36,-298 34,-266Q20,-280 0,-280Q-20,-280 -34,-266Z" fill="${["#2a1a14", "#4a3a2a", "#1a1410", "#6a4a2a"][Math.floor(r() * 4)]}"/>${r() < 0.3 ? `<path d="M-40,-290h80" stroke="#8a6a3a" stroke-width="10" stroke-linecap="round"/><rect x="-24" y="-322" width="48" height="34" rx="8" fill="#8a6a3a"/>` : ""}</g>`; }
        put(L.set, `<g class="ep2Crowd" opacity=".95">${h}</g>`); };
      const ME2 = (track, extra = {}) => ME("jkYou", HX, HY, track, { flip: true, ...extra });
      const KEN2 = (x, track, extra = {}) => A("jkKen", x, HY, 0.95, track, extra);
      const KENLS = (x, track, extra = {}) => A("jkKenLS", x, HY, 0.95, track, extra);
      const TOWN2 = (k, o = {}) => town(k, { dusk: true, ...o });

      // ---------- m01 · hook: the fall onto the plaza (the EP.1 landing, noon) ----------
      const LAND2 = [...CROWD(true), ME("jkYou", HX, HY, [{ t: 0, mode: "fall", eyes: "wide", mouth: "scream" }, { t: 1.0, mode: "crouch", eyes: "worry", mouth: "o" }, { t: 1.7, mode: "prone", eyes: "sad", mouth: "frown" }], { path: [{ t: 0, x: 600, y: -300 }, { t: 0.95, x: HX, y: HY }] })];
      shot("m01", { ...town("m01"), blur: { far: 8, mid: 4 }, cam: { keys: [{ t: 0, ...fr(620, 520, 0.72, 540, 560), drift: { s: 0.02 } }, { t: 1.3, ...fr(640, 1000, 0.7, 540, 900), glide: 1.3 }] }, shake: JKC.impact(1.0, 0.5, 18), actors: LAND2,
