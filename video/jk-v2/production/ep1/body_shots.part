      // ---------- LOOK TEST · o01 the opening (sword at the throat) · o02 the hall · o03 heaven · o04 the old street ----------
      const HERO_Z = 0.25, HERO_X = 700, KEN_X = 400;
      VPY(880); const [hx, hy, hk] = PJ(HERO_X, HERO_Z), [kx, ky, kk] = PJ(KEN_X, HERO_Z);
      shot("k01", { ...square("k01", { crowd: true, time: "mauve", fgHeads: true }), blur: { set: 2, mid: 6, far: 9 }, captions: [{ text: "ถ้าคุณเกิดใหม่พร้อม{สกิลที่กากที่สุด}…", t: 0.2, end: 2.6 }, { text: "แล้วกำลังจะโดนผู้กล้า{ฟันคอขาด}อยู่ตรงหน้า", t: 2.7, end: 5.8 }],
        cam: { keys: [{ t: 0, ...fr((hx + kx) / 2, hy - 300 * hk, 1.75, 540, 860), drift: { s: 0.03 } }, { t: 2.2, ...fr(hx + 10 * hk, hy - 330 * hk, 3.0, 560, 780), drift: { s: 0.03 } }, { t: 3.4, ...fr(560, 880, 0.88, 540, 720), drift: { s: 0.01 } }, { t: 5.2, ...fr(540, 1180, 1.15, 540, 1000), glide: 1.6 }] },
        actors: [AT("jkYou", HERO_X, HERO_Z, [{ t: 0, mode: "kneelUp", eyes: "wide", mouth: "scream" }], { flip: true }), AT("jkKenLS", KEN_X, HERO_Z, [{ t: 0, mode: "lunge", eyes: "angry", mouth: "grit" }]),
          AT("jkMan1", 1500, 1.6, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }], { flip: true }), AT("jkWom1", 1750, 2.0, [{ t: 0, mode: "coverEars", eyes: "wide", mouth: "o" }], { flip: true }), AT("jkAunt", -380, 1.8, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }]), AT("jkMan2", -620, 2.4, [{ t: 0, mode: "point", eyes: "wide", mouth: "o" }])],
        fx(tl, id, t0, L) { hud(id, [["คนเชื่อ", "0/100", "#ff8a7a"], ["สกิล", "จอมโกหก · F", "#f2c55c"]]); shadows(L, id, act("k01"), 0.6, 0.3); earBlink(tl, L, `${id}-a0`, hx, hy, 0.95 * hk, true, t0, D("k01"));
          beliefBar(tl, L, t0, [[0.3, 0]], { id: `${id}-bb`, y: 330 }); } });
            // the brake-light badge (screen space), blinking in sync with the ear
      const brakeBadge = (tl, L, id, at, dur, x = 800, y = 600) => { const bl = grp(L.light); bl.innerHTML = `<g transform="translate(${x},${y})"><rect x="-170" y="-80" width="340" height="160" rx="34" fill="rgba(18,20,30,.78)" stroke="rgba(244,236,216,.25)" stroke-width="2"/><rect x="-140" y="-52" width="160" height="74" rx="18" fill="#4a0c0c"/><rect id="${id}-lamp" x="-140" y="-52" width="160" height="74" rx="18" fill="#ff2e2e"/><path d="M-122,-32h124" stroke="#fff" stroke-width="7" stroke-linecap="round" opacity=".55"/><text x="100" y="-4" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="32" fill="#f4ecd8">ไฟ</text><text x="100" y="38" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="32" fill="#ff8a7a">เบรก</text></g>`;
        tl.set(bl, { opacity: 0 }, 0); pop(tl, bl, at, { origin: `${x} ${y}`, from: 0.5, dur: 0.3 }); loop(tl, `#${id}-lamp`, { opacity: 1 }, { opacity: 0.12 }, 0.28, at, dur); return bl; };
      // k02 · h2: the hero's face with the blade under his chin (Ken's shoulder as a soft occluder at the left edge), then a whip onto the ear blinking like a brake light; a rewind beat at the end
      VPY(1000); const [hx2, hy2, hk2] = PJ(HERO_X, HERO_Z);
      const EAR = [hx2 + 31 * hk2, hy2 - 308 * hk2];   // the kneeling hero's ear (facing left): 33 px behind the face, 540−216 above the feet, ×0.95
      shot("k02", { ...square("k02", { crowd: true, time: "mauve" }), blur: { set: 2, mid: 6, far: 9 }, captions: caps("k02"),
