            const lip = grp(L.act); lip.innerHTML = `<rect x="${(YH11[0] - 240).toFixed(1)}" y="${(YH11[1] + 24).toFixed(1)}" width="480" height="1400" fill="#eae4f0"/>${[...Array(6)].map((_, i) => `<circle cx="${(YH11[0] - 220 + i * 85).toFixed(1)}" cy="${(YH11[1] + 40).toFixed(1)}" r="46" fill="#ffffff"/>`).join("")}`; tl.set(lip, { opacity: 0 }, 0); tl.set(lip, { opacity: 1 }, t0 + F("k11", 0, 0) + 0.2); } }),
