      shot("k03", { ...street("k03", { manhole: true, fgLamp: true }), blur: { far: 8, mid: 3 }, cam: { keys: [{ t: 0, ...fr(1000, 1060, 1.25, 540, 980), drift: { s: 0.025, x: -38 } }, { t: F("k03", 0, 2) - 0.1, ...face(YB[0], YB[1], 2.2, false, 480, 800, 0.95 * YB[2]), glide: 0.5 }] },
        actors: [AT("jkYouBag", 760, 0.3, [{ t: 0, mode: "point", eyes: "normal", mouth: "smile" }, { t: F("k03", 0, 2), mode: "shrug", eyes: "worry", mouth: "flat" }], { talk: [[0.2, F("k03", 0, 2) - 0.2, "o"]] }), AT("jkAunt", 1150, 0.35, [{ t: 0, mode: "idle", eyes: "side", mouth: "flat" }], { flip: true })],
        fx(tl, id, t0, L) { hud(id, HUD_OLD); shadows(L, id, act("k03"), 0.5, 0.3); JKC.whipIn(tl, id, t0, 1);
          chip(tl, L, [[t0 + F("k03", 0, 1), "0"]], { id: `${id}-ch`, label: "กรมธรรม์", x: 880, y: 300 }); } });
