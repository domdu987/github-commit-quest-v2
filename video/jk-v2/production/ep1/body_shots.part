        fx(tl, id, t0, L) { hud(id, [["คนเชื่อ", "0/100", "#ff8a7a"], ["สกิล", "จอมโกหก · F", "#f2c55c"]]); shadows(L, id, act("k02"), 0.6, 0.3); const tW = F("k02", 0, 2), tE = F("k02", 0, 3);
          earBlink(tl, L, `${id}-a0`, hx2, hy2, 0.95 * hk2, true, t0 + tE, D("k02") - tE, 0.28, 216); JKC.whipIn(tl, id, t0 + tW - 0.1, 1);
          const sh = grp(L.light); sh.innerHTML = `<g filter="url(#j3Soft)" opacity=".86"><ellipse cx="-80" cy="1500" rx="460" ry="900" fill="#2a1a24"/><circle cx="20" cy="420" r="290" fill="#2a1a24"/></g>`;
          tl.to(sh, { x: -820, duration: 0.3, ease: "power2.in" }, t0 + tW - 0.3);
          brakeBadge(tl, L, id, t0 + tE, D("k02") - tE);
