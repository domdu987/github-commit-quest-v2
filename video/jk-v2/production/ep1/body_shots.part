          tl.set(rw, { opacity: 0 }, 0); tl.set(rw, { opacity: 1 }, t0 + D("k02") - 0.8); loop(tl, rw, { opacity: 1 }, { opacity: 0.3 }, 0.1, t0 + D("k02") - 0.8, 0.65); JKC.whipOut(tl, id, t0 + D("k02") - 0.18, 1); } });

      // ---------- the old world: the street at dusk (k03–k05) ----------
