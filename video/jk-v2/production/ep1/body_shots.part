      const RULE3 = "พูดเล่นหรือประชด… ก็นับ";
      const RULES = (id) => { const row = (y, n, a, b) => `<g id="${id}-rr${n}">${JKI.coin(n === 1 ? "believer" : "percent", -300, y, 0.66, `${id}-ic${n}`, n === 1 ? "blue" : "green")}<text x="-238" y="${y - 6}" font-family="Kanit" font-weight="900" font-size="46" fill="#2e2a26">${a}</text><text x="-238" y="${y + 44}" font-family="Kanit" font-weight="700" font-size="34" fill="#6a5a4a">${b}</text></g>`;
