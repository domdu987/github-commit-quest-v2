          tl.set(lens, { opacity: 0 }, 0); tl.fromTo(lens, { opacity: 0, x: 260, y: -60 }, { opacity: 1, x: 0, y: 0, duration: 0.3, ease: "power2.out", immediateRender: false }, a3 + 0.2); tl.to(lens, { x: 420, y: 160, rotation: 30, opacity: 0, duration: 0.35, ease: "power2.in" }, t0 + F("k10", 0, 3) + 0.1);
