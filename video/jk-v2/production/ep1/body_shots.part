      const FCARD = `<rect x="-160" y="-230" width="320" height="460" rx="28" fill="#b8bcc4"/><rect x="-148" y="-218" width="296" height="436" rx="22" fill="#8e939c"/><rect x="-148" y="-218" width="296" height="436" rx="22" fill="url(#flV)" opacity=".5"/><rect x="-124" y="-194" width="248" height="388" rx="16" fill="#d0d4da"/><text x="0" y="-120" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="44" fill="#5a5e68">จอมโกหก</text><text x="0" y="110" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="250" fill="#3a3d46">F</text><text x="0" y="170" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="30" fill="#6a6e78">ระดับ F</text>`;
