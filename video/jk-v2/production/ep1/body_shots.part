          const card = grp(L.light); card.innerHTML = `<g transform="translate(540,760) rotate(-5)">${FCARD}</g>`; pop(tl, card, t0 + F("k08", 0, 3) - 0.05, { origin: "540 760", from: 0.5, dur: 0.4 });
          const st = grp(L.light); st.innerHTML = `<g transform="translate(600,940) rotate(-12)"><rect x="-170" y="-64" width="340" height="128" rx="18" fill="none" stroke="#d8352a" stroke-width="12"/><rect x="-156" y="-50" width="312" height="100" rx="12" fill="none" stroke="#d8352a" stroke-width="4"/><text x="0" y="30" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="80" fill="#d8352a">กากสุด</text></g>`;
