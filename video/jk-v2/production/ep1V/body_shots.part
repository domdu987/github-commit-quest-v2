      // ---------- EP.1 in the look of the clip the owner picked (the 5 Nov sets jkTown / jkCity / jkCloud), with a depth-and-light pass (owner 11 Nov: "ทำแสงให้มีมิติ") ----------
      const VOL = new URLSearchParams(location.search).get("vol") === "1";   // ?vol=1: the engine's sculpted (diffuse-lit) shading on the cast, for the look test
      const LT = (from, rim, rimOp, shade, shadeOp, cast) => ({ from, rim, rimOp, rimW: 5, shade, shadeOp, shadeW: 30, soft: 9, vol: VOL ? undefined : false, cast });
      const DUSK_V = { dark: 0.08, light: LT("right", "#ffd0a0", 0.9, "#2a1c40", 0.38, { len: 2.6, op: 0.42, ao: 0.4 }), grade: { top: "#ffd8a8", bottom: "#3a2a50", op: 0.24 } };
      const HEAVEN_V = { dark: 0.02, light: LT("left", "#fffbe8", 0.85, "#7a84b8", 0.3, { len: 2.4, op: 0.36, ao: 0.36 }), grade: { top: "#fff8e8", bottom: "#c0d0ee", op: 0.16 } };
      const TOWN_V = { dark: 0.03, light: LT("left", "#fff0d0", 0.85, "#3a2440", 0.34, { len: 2.8, op: 0.42, ao: 0.4 }), grade: { top: "#fff2d8", bottom: "#4a3a50", op: 0.18 } };
      const TOWN_DUSK = { dark: 0.1, light: LT("left", "#ffc080", 0.95, "#241a44", 0.42, { len: 2.6, op: 0.42, ao: 0.4 }), grade: { top: "#ff9a60", bottom: "#1e1438", op: 0.3 } };
      const city = (k, o = {}) => ({ ...DUSK_V, set: "jkCity", setOpts: { id: `jc${k}`, ...o } });
      const cloud = (k, o = {}) => ({ ...HEAVEN_V, set: "jkCloud", setOpts: { id: `jq${k}`, ...o } });
      const ROWS = [[1, "เซอร์อาเธอร์ผู้ไม่เคยแพ้", 0], [2, "แม่มดดอกไม้เหล็ก", 0], [3, "ยักษ์ใจดีแห่งภูเขา", 0], [10, "เคน · ดาบแสง", 1], [9999, "คุณ · จอมโกหก (F)", 2]];
      const town = (k, o = {}) => ({ ...(o.dusk ? TOWN_DUSK : TOWN_V), set: "jkTown", setOpts: { id: `jt${k}`, rows: ROWS, ...o } });
      const shadowsV = (L, id, actors, sh = -0.4, op = 0.32) => NkL.cast(L, id, actors, { k: 0.5, sh, op });
      // ----- the depth-and-light pass -----
      Sets.DEFS += `<radialGradient id="vSpill"><stop offset="0" stop-color="#ff5a3a" stop-opacity=".7"/><stop offset=".5" stop-color="#ff3a2a" stop-opacity=".25"/><stop offset="1" stop-color="#ff2a1a" stop-opacity="0"/></radialGradient>
        <linearGradient id="vFloor" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".55"/></linearGradient>
        <filter id="vSoft" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="18"/></filter><filter id="vSoft2" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="4"/></filter>`;
      // atmospheric depth: the far layer fades toward the sky, the mid layer a little, the floor darkens toward the camera, soft bokeh in front
      const DEPTH = (L, o = {}) => {
        put(L.far, `<rect x="-3000" y="-1400" width="8000" height="3000" fill="${o.haze || "#ffe8d0"}" opacity="${o.far ?? 0.22}"/>`);
        put(L.mid, `<rect x="-3000" y="-1400" width="8000" height="3000" fill="${o.haze || "#ffe8d0"}" opacity="${o.mid ?? 0.1}"/>`);
        put(L.set, `<rect x="-3000" y="${o.floorY ?? 1500}" width="8000" height="1400" fill="url(#vFloor)" opacity="${o.floor ?? 0.5}"/>`);
        if (o.bokeh) put(L.fg, `<g filter="url(#vSoft2)" opacity="${o.bokehOp ?? 0.5}">${[[120, 260, 40], [300, 180, 56], [880, 330, 64], [1000, 620, 44], [160, 1420, 58], [960, 1560, 48], [60, 900, 36]].map(([x, y, r]) => `<circle cx="${x}" cy="${y}" r="${r}" fill="${o.bokehCol || "#fff2c8"}"/>`).join("")}</g>`);
      };
      // the backs of heads in the front row (soft, dark) for the wide shots of the plaza
      const vHeads = (L, op = 0.9) => put(L.fg, `<g filter="url(#j3Soft)" opacity="${op}">${[[60, 0], [330, 30], [640, -10], [930, 40], [1180, 10]].map(([x, dy]) => `<circle cx="${x}" cy="${1700 + dy}" r="96" fill="#1a0e1c"/><ellipse cx="${x}" cy="${1900 + dy}" rx="190" ry="130" fill="#1a0e1c"/>`).join("")}</g>`);
      // the red ear: the ear itself blinks (rig .jkEar); a SMALL glow sits behind the head (L.set, not over the face) and the ground beside the hero catches a little red (owner 11 Nov: "หูแดงไปปิดหน้าตัวละคร")
      const earBlinkV = (tl, L, aid, ax, ay, s, flip, at, dur, p = 0.28, dy = 0) => { const g = earBlink(tl, L, aid, ax, ay, s, flip, at, dur, p, dy); const c = g.querySelector("circle"); if (c) c.setAttribute("r", (60 * s).toFixed(0)); L.set.appendChild(g); return g; };
      const earSpill = (tl, L, x, y, at, dur, p = 0.28, s = 1, earDy = 513) => { const g = grp(L.set); g.innerHTML = `<g style="mix-blend-mode:screen"><ellipse cx="${x}" cy="${y}" rx="${(220 * s).toFixed(0)}" ry="${(60 * s).toFixed(0)}" fill="url(#vSpill)" opacity=".7"/></g>`;   // behind the cast (L.set): it lights the wall and the ground, not the face
        tl.set(g, { opacity: 0 }, 0); tl.set(g, { opacity: 1 }, at); loop(tl, g, { opacity: 1 }, { opacity: 0.08 }, p, at, dur); return g; };
      // sun shafts through the scene (screen), breathing
      const RAYS = (tl, L, t0, dur, o = {}) => NkL.beams(tl, L.glow, t0, dur, { src: o.src || [500, -200, 1100, -200], dst: o.dst || [-300, 1500, 900, 1500], n: o.n ?? 5, op: o.op ?? 0.2, col: o.col || "#fff4d0", blur: 16, seed: o.seed || 7 });
      // ----- HUDs (plain words) -----
      const HUD_SQ = [["คนเชื่อ", "0/100", "#ff8a7a"], ["สกิล", "จอมโกหก · F", "#f2c55c"]], HUD_OLD = [["โลกเก่า", "เซลส์ประกัน", "#9ad0ff"], ["ยอดขาย", "0 ใบ", "#ff8a7a"]];
      const HUD_HV = [["สถานะ", "ตายแล้ว", "#c8d0ff"], ["สกิล", "ยังไม่สุ่ม", "#f2c55c"]], HUD_F = [["สถานะ", "ตายแล้ว", "#c8d0ff"], ["สกิล", "จอมโกหก · F", "#f2c55c"]];
      // the brake-light badge (screen space), blinking in sync with the ear
      const brakeBadge = (tl, L, id, at, dur, x = 800, y = 600) => { const bl = grp(L.light); bl.innerHTML = `<g transform="translate(${x},${y})"><rect x="-170" y="-80" width="340" height="160" rx="34" fill="rgba(18,20,30,.78)" stroke="rgba(244,236,216,.25)" stroke-width="2"/><rect x="-140" y="-52" width="160" height="74" rx="18" fill="#4a0c0c"/><rect id="${id}-lamp" x="-140" y="-52" width="160" height="74" rx="18" fill="#ff2e2e"/><path d="M-122,-32h124" stroke="#fff" stroke-width="7" stroke-linecap="round" opacity=".55"/><text x="100" y="-4" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="32" fill="#f4ecd8">ไฟ</text><text x="100" y="38" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="32" fill="#ff8a7a">เบรก</text></g>`;
        tl.set(bl, { opacity: 0 }, 0); pop(tl, bl, at, { origin: `${x} ${y}`, from: 0.5, dur: 0.3 }); loop(tl, `#${id}-lamp`, { opacity: 1 }, { opacity: 0.12 }, 0.28, at, dur); return bl; };

      // ---------- k01 · the plaza in front of the guild at dusk: the sword at the throat (two-shot at neck height → the hero's face → wide over the crowd) ----------
      const HX = 700, HY = 1400, KX = 400;
      // the briefcase in the BACK hand so the front hand can point at the customer without shoving the bag in her face; a reading gait for the book walk
      Rig.CAST.jkYouBagB = { ...Rig.CAST.jkYouBag, keep: "B" }; Flat.SPEC.jkYouBagB = Flat.SPEC.jkYouBag;
      Rig.MODES.readWalk = (u, o) => ({ ...Rig.MODES.walk(u, o), uaF: -52 + Math.sin(u * 1.1), faF: -92, uaB: 4, faB: -12, head: 12 });
      // plaza bystanders: not the insurance customer (she belongs to the old world); the pointing man looks up in the fall, stays idle at the sword scene
      const CROWD = (up = false) => [A("jkMan2", -20, 1300, 0.72, [{ t: 0, mode: up ? "raise" : "idle", eyes: "wide", mouth: "o" }]), A("jkMan3", 40, 1330, 0.78, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }]),
        A("jkWom1", 1290, 1310, 0.74, [{ t: 0, mode: "coverEars", eyes: "wide", mouth: "o" }], { flip: true }), A("jkMan1", 1230, 1340, 0.8, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }], { flip: true })];
      const LEADS = (you, ken) => [ME("jkYou", HX, HY, you, { flip: true }), A("jkKenLS", KX, HY, 0.95, ken)];
      const BLADE = (L) => { NkL.pool(L.set, 688, 1160, 170, 80, "#bfe8ff", 0.55); NkL.pool(L.glow, 700, 1060, 110, 100, "#bfe8ff", 0.22); };   // the light sword lights the hero's neck and face
      const LANTERNS = (L) => { NkL.pool(L.set, 670, 1196, 280, 60, "#ffd9a0", 0.34); NkL.pool(L.set, 1330, 1196, 280, 60, "#ffd9a0", 0.34); };   // the guild lanterns pool on the plaza
      shot("k01", { ...town("k01", { dusk: true }), blur: { far: 7, mid: 4 }, captions: caps("k01"),
        cam: { keys: [{ t: 0, ...fr((HX + KX) / 2, HY - 300 * 0.95, 1.75, 540, 860), drift: { s: 0.03 } }, { t: 2.2, ...fr(HX + 10 * 0.95, HY - 330 * 0.95, 3.0, 560, 780), drift: { s: 0.03 } }, { t: 3.4, ...fr(600, 900, 0.86, 540, 720), drift: { s: 0.01 } }, { t: 5.2, ...fr(560, 1180, 1.15, 540, 1000), glide: 1.6 }] },
        actors: [...CROWD(), ...LEADS([{ t: 0, mode: "kneelUp", eyes: "wide", mouth: "scream" }], [{ t: 0, mode: "lunge", eyes: "angry", mouth: "frown" }])],
        fx(tl, id, t0, L) { hud(id, HUD_SQ); shadowsV(L, id, act("k01"), 0.55, 0.3); DEPTH(L, { haze: "#f0b8a0", far: 0.2, mid: 0.08, floorY: 1560 }); LANTERNS(L); BLADE(L); vHeads(L);
          earBlinkV(tl, L, `${id}-a4`, HX, HY, 0.95, true, t0, D("k01"), 0.28, 216); earSpill(tl, L, HX + 20, HY + 6, t0, D("k01"), 0.28, 0.9, 293); } });
      // ---------- k02 · the hero's face with the blade under his chin (Ken's shoulder as a soft occluder), whip to the ear blinking like a brake light, then the rewind ----------
      const EAR = [HX + 3 * 0.95, HY - 316 * 0.95];
      shot("k02", { ...town("k02", { dusk: true }), blur: { far: 9, mid: 6, set: 3 }, captions: caps("k02"),
        cam: { keys: [{ t: 0, ...fr(HX, HY - 330 * 0.95, 3.2, 700, 800), drift: { s: 0.03 } }, { t: F("k02", 0, 2) - 0.1, ...fr(EAR[0], EAR[1], 5.0, 600, 860), glide: 0.35 }] },
        actors: LEADS([{ t: 0, mode: "kneelUp", eyes: "wide", mouth: "scream" }, { t: F("k02", 0, 2), mode: "kneelUp", eyes: "side", mouth: "o" }], [{ t: 0, mode: "lunge", eyes: "angry", mouth: "frown" }]),
        fx(tl, id, t0, L) { hud(id, HUD_SQ); shadowsV(L, id, act("k02"), 0.55, 0.3); DEPTH(L, { haze: "#f0b8a0", far: 0.2, mid: 0.08, bokeh: true, bokehCol: "#ffc890", bokehOp: 0.3 }); LANTERNS(L); BLADE(L); const tW = F("k02", 0, 2), tE = F("k02", 0, 3);
          earBlinkV(tl, L, `${id}-a0`, HX, HY, 0.95, true, t0 + tE, D("k02") - tE, 0.28, 216); earSpill(tl, L, HX + 20, HY + 6, t0 + tE, D("k02") - tE, 0.28, 0.6, 293); JKC.whipIn(tl, id, t0 + tW - 0.1, 1);
          const sh = grp(L.light); sh.innerHTML = `<g filter="url(#j3Soft)" opacity=".86"><ellipse cx="-80" cy="1500" rx="460" ry="900" fill="#2a1a24"/><circle cx="20" cy="420" r="290" fill="#2a1a24"/></g>`; tl.to(sh, { x: -820, duration: 0.3, ease: "power2.in" }, t0 + tW - 0.3);
          brakeBadge(tl, L, id, t0 + tE, D("k02") - tE);
          const rw = grp(L.light); rw.innerHTML = `<g><text x="110" y="340" font-family="Kanit" font-weight="900" font-size="96" fill="#ffffff" opacity=".9">◀◀</text><text x="330" y="336" font-family="Kanit" font-weight="800" font-size="40" fill="#ffffff" opacity=".8">ชาติก่อน</text>${[...Array(7)].map((_, i) => `<rect x="-20" y="${200 + i * 240}" width="1120" height="${8 + (i % 3) * 6}" fill="#ffffff" opacity=".16"/>`).join("")}</g>`;
          const tR = Math.min(t0 + voEnd("k02", 0), t0 + D("k02") - 0.45); tl.set(rw, { opacity: 0 }, 0); tl.set(rw, { opacity: 1 }, tR); loop(tl, rw, { opacity: 1 }, { opacity: 0.3 }, 0.1, tR, t0 + D("k02") - 0.2 - tR); JKC.whipOut(tl, id, t0 + D("k02") - 0.18, 1); } });

      // ---------- the old world: the street at dusk (k03–k05) · the office at x 860–1260, the café table 520–760, the lamp at 380, the manhole at 1180 ----------
      const YX = 860, AX = 600;
      const CITYLIGHT = (tl, L, t0, dur) => { NkL.pool(L.set, 420, 1412, 320, 72, "#ffd9a0", 0.55); NkL.pool(L.set, 1060, 1424, 380, 84, "#ffe0a0", 0.42); NkL.beams(tl, L.glow, t0, dur, { src: [470, 640, 530, 640], dst: [140, 1420, 760, 1420], n: 4, op: 0.16, col: "#ffd9a0", blur: 16, seed: 5 }); };
      shot("k03", { ...city("k03", { manhole: true }), blur: { far: 8, mid: 3 }, cam: { keys: [{ t: 0, ...fr(820, 760, 0.95, 540, 760), drift: { s: 0.02, x: -30 } }, { t: F("k03", 0, 2) - 0.1, ...face(YX, 1400, 2.2, true, 480, 800), glide: 0.5 }] },
        actors: [A("jkAunt", AX, 1400, 0.95, [{ t: 0, mode: "idle", eyes: "side", mouth: "flat" }]), ME("jkYouBagB", YX, 1400, [{ t: 0, mode: "point", eyes: "normal", mouth: "smile" }, { t: F("k03", 0, 2), mode: "shrug", eyes: "worry", mouth: "flat" }], { flip: true, talk: [[0.2, F("k03", 0, 2) - 0.2, "o"]] })],
        fx(tl, id, t0, L) { hud(id, HUD_OLD); shadowsV(L, id, act("k03"), -0.5, 0.3); DEPTH(L, { haze: "#f6c8a0", far: 0.24, mid: 0.08, floorY: 1560 }); CITYLIGHT(tl, L, t0, D("k03")); JKC.whipIn(tl, id, t0, 1);
          chip(tl, L, [[t0, "0"]], { id: `${id}-ch`, label: "ใบประกัน", x: 880, y: 300 }); } });
      shot("k04", { ...city("k04", { manhole: true }), blur: { far: 9, mid: 5 }, cam: { keys: [{ t: 0, ...face(YX, 1400, 3.0, true, 520, 800), drift: { s: 0.02 } }, { t: F("k04", 0, 2) - 0.1, ...fr(760, 1060, 1.1, 540, 980), glide: 0.45 }] },
        actors: [A("jkAunt", AX, 1400, 0.95, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }, { t: F("k04", 0, 2) - 0.2, mode: "startle", eyes: "wide", mouth: "o" }, { t: F("k04", 0, 2) + 0.3, mode: "walk", eyes: "angry", mouth: "frown" }], { flip: true, moveTo: { x: -300, dur: 1.4, at: F("k04", 0, 2) + 0.3 } }),
          ME("jkYouBagB", YX, 1400, [{ t: 0, mode: "idle", eyes: "worry", mouth: "flat", sweat: true }, { t: F("k04", 0, 2) + 0.5, mode: "facepalm", eyes: "closed", mouth: "frown" }], { flip: true, talk: [[0.1, F("k04", 0, 1), "o"]] })],
        fx(tl, id, t0, L) { hud(id, HUD_OLD); shadowsV(L, id, act("k04"), -0.5, 0.3); DEPTH(L, { haze: "#f6c8a0", far: 0.24, mid: 0.08, bokeh: true, bokehCol: "#ffd9a0", bokehOp: 0.28 }); CITYLIGHT(tl, L, t0, D("k04")); const tE = F("k04", 0, 0) + 0.6;
          earBlinkV(tl, L, `${id}-a1`, YX, 1400, 0.95, true, t0 + tE, D("k04") - tE); earSpill(tl, L, YX + 10, 1406, t0 + tE, D("k04") - tE, 0.28, 0.6); brakeBadge(tl, L, id, t0 + F("k04", 0, 1), D("k04") - F("k04", 0, 1), 800, 380); } });
      shot("k05", { ...city("k05", { manhole: true, dark: true }), grade: { top: "#c8a0c0", bottom: "#1a1430", op: 0.3 }, dark: 0.16, blur: { far: 8, mid: 3 }, captions: caps("k05").filter((c) => !/^ตุ้บ/.test(c.text || "")),
        cam: { keys: [{ t: 0, ...fr(420, 1050, 1.05, 540, 1000), drift: { x: 160, s: 0.004 } }, { t: F("k05", 0, 3) - 0.4, ...fr(1120, 1150, 1.15, 540, 1000), glide: 0.6 }] }, shake: JKC.impact(F("k05", 0, 4), 0.55, 16, JKC.dutch(5)),
        actors: [ME("jkYouBook", 200, 1520, [{ t: 0, mode: "readWalk", eyes: "side", mouth: "flat" }, { t: F("k05", 0, 3) + 0.25, mode: "fall", eyes: "wide", mouth: "scream" }],
          { path: [{ t: 0, x: 200, y: 1520 }, { t: F("k05", 0, 3) + 0.2, x: 1180, y: 1520 }, { t: F("k05", 0, 3) + 0.35, x: 1185, y: 1560 }, { t: F("k05", 0, 3) + 0.75, x: 1185, y: 2500 }] })],
        sfxText: [{ text: "ตุ้บ!", x: 380, y: 760, size: 150, rot: -6, color: "#f6d36a", t: F("k05", 0, 4), end: D("k05") - 0.1 }],
        fx(tl, id, t0, L) { hud(id, HUD_OLD); shadowsV(L, id, act("k05"), -0.5, 0.3); DEPTH(L, { haze: "#c8a0c0", far: 0.26, mid: 0.1, floorY: 1600 }); CITYLIGHT(tl, L, t0, D("k05")); capAt(id, 1040);
          const g = grp(L.light); g.innerHTML = `<g transform="translate(760,520) rotate(4)"><rect x="-150" y="-200" width="300" height="400" rx="12" fill="#d8352a"/><rect x="-150" y="-200" width="40" height="400" fill="#a8241c"/><text x="20" y="-90" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="46" fill="#f6d36a">พูดให้</text><text x="20" y="-34" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="42" fill="#f6d36a">คนเชื่อใน</text><text x="20" y="90" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="120" fill="#fff2c8">7</text><text x="20" y="150" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="40" fill="#fff2c8">วัน</text></g>`;
          pop(tl, g, t0 + F("k05", 0, 2) - 0.05, { origin: "760 520", from: 0.6, dur: 0.35 }); out(tl, g, t0 + F("k05", 0, 3) - 0.1);
          const lip = grp(L.act); lip.innerHTML = `<path d="M1088,1520A92,18 0 0,0 1272,1520H1340V2700H1020V1520Z" fill="#b8aca0"/><path d="M1068,1520A112,24 0 0,0 1292,1520" stroke="#3a3a40" stroke-width="10" fill="none"/>`;
          const bk = BLACK(L); tl.set(bk, { opacity: 0 }, 0); tl.to(bk, { opacity: 1, duration: 0.45 }, t0 + D("k05") - 0.5); } });

      // ---------- heaven (k06–k11A): the queue on the clouds, the giant gacha (dome 820,860 · crank 650,1170 · chute 820,1290), the goddess behind the counter at 1262, the hole under x 440 ----------
      const YQ = 440, GX = 1262;
      const QV = (me = [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }], ken = [{ t: 0, mode: "idle", eyes: "normal", mouth: "smile" }], souls = [{ t: 0, mode: "idle", eyes: "side", mouth: "flat" }], god = [{ t: 0, mode: "idle", eyes: "tired", mouth: "flat" }]) => [
        A("jkSoul3", -60, 1400, 0.92, souls), A("jkSoul2", 120, 1400, 0.9, souls), A("jkSoul1", 280, 1400, 0.95, souls), ME("jkYou", YQ, 1400, me), A("jkKen", 590, 1400, 0.92, ken), A("jkGod", GX, 1400, 0.95, god)];
      const HEAVENLIGHT = (tl, L, t0, dur) => { RAYS(tl, L, t0, dur, { src: [-60, -200, 660, -200], dst: [520, 1500, 1300, 1500], n: 5, op: 0.2 }); DEPTH(L, { haze: "#fff6e8", far: 0.06, mid: 0.04, floorY: 1620, floor: 0.3 }); };
      shot("k06", { ...cloud("k06"), blur: { far: 6, mid: 4 }, cam: { keys: [{ t: 0, ...face(YQ, 1400, 2.8, false, 540, 760), drift: { s: 0.01 } }, { t: 1.5, ...fr(640, 1000, 0.85, 540, 980), glide: 0.9, drift: { s: 0.012, x: 22 } }, { t: F("k06", 0, 3), ...fr(GX, 1400 - 380 * 0.95, 1.6, 600, 980), glide: 0.6 }] },
