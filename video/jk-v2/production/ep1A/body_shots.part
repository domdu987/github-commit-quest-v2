      // the brake-light badge, blinking in sync with the ear
      const brakeBadge = (tl, L, id, at, dur, x = 800, y = 600) => { const bl = grp(L.light); bl.innerHTML = `<g transform="translate(${x},${y})"><rect x="-170" y="-80" width="340" height="160" rx="34" fill="rgba(18,20,30,.78)" stroke="rgba(244,236,216,.25)" stroke-width="2"/><rect x="-140" y="-52" width="160" height="74" rx="18" fill="#4a0c0c"/><rect id="${id}-lamp" x="-140" y="-52" width="160" height="74" rx="18" fill="#ff2e2e"/><path d="M-122,-32h124" stroke="#fff" stroke-width="7" stroke-linecap="round" opacity=".55"/><text x="100" y="-4" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="32" fill="#f4ecd8">ไฟ</text><text x="100" y="38" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="32" fill="#ff8a7a">เบรก</text></g>`;
        tl.set(bl, { opacity: 0 }, 0); pop(tl, bl, at, { origin: `${x} ${y}`, from: 0.5, dur: 0.3 }); loop(tl, `#${id}-lamp`, { opacity: 1 }, { opacity: 0.12 }, 0.28, at, dur); return bl; };
      const CROWD_SQ = [A("jkMan1", 1000, 1215, 0.5, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }], { flip: true }), A("jkWom1", 1060, 1190, 0.44, [{ t: 0, mode: "coverEars", eyes: "wide", mouth: "o" }], { flip: true }), A("jkAunt", 110, 1225, 0.5, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }]), A("jkMan2", 30, 1195, 0.44, [{ t: 0, mode: "point", eyes: "wide", mouth: "o" }])];
