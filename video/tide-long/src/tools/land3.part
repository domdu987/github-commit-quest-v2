      // ---------- ทะเลลด EP.3 long version (YouTube 16:9): landscape-only shot fixes ----------
      landFix({
        // bridge B: the band high enough for the tower blaring over the hotel and the shop; ยาย's face clear of the caption
        // (yai0 is now the shop interior, review fix B1: the band at 380 puts her face in the upper third, the counter across the bottom)
        brB: { land: { y0: 250 } }, yai0: { land: { y0: 380 } },
        // ยาย on the hotel's outside stair: the camera a little left, so she climbs right of the fitted rule board (it hid her)
        stair: { cam: { keys: [{ t: 0, ...fr(330, 1400, 2.5, 540, 1300) }, { t: D("stair"), glide: D("stair"), ...fr(330, 1300, 2.5, 540, 1300) }] } },
        // the inserts: the band lower, so the old photo and the clipping (its own caption line too) sit above the caption
        photo: { land: { y0: 120 } }, clip: { land: { y0: 150 } },
        // the last card at full width: not fitted as a vertical strip; the hill continued to both edges
        end: { land: { fit: false, y0: 300 } },
        // the callback siren test (วันพุธถัดมา): as in EP.1's "test", open on the tower's speakers as they sound, then tilt down to
        // ตาจุ่น, ตั้ง and แพรว on the beach by 1.8 s and the original slow push-in
        wed: { cam: { keys: [{ t: 0, ...fr(800, 726, 1.15, 540, 900) }, { t: 1.8, glide: 1.6, ease: "power2.inOut", ...fr(760, 1196, 1.17, 540, 900) },
          { t: D("wed"), glide: D("wed") - 1.8, ...fr(760, 1180, 1.25, 540, 900) }] } },
      });
      afterFx("end", (tl, id, t0, L) => endWide(L.light));
