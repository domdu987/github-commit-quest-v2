+      // in the wide frame it sat as a phone-width column in the middle, its header cropped off above the band and its comment rows in
+      // the caption band. Here: the header to the top left; the comment stack, pinned comment and input bar down the left edge; the
+      // buttons, hearts and gift down the right edge; everything above the caption band. y0 = the shot's land.y0 (set for these shots).
+      const liveL = (layer, y0) => {
+        const NS = "http://www.w3.org/2000/svg";
+        const root = [...layer.children].find((g) => g.id && document.getElementById(`${g.id}-top`));
+        if (!root) return;
+        const lid = root.id, ui = document.getElementById(`${lid}-ui`) || root;
+        const grp = (dx, dy) => { const g = document.createElementNS(NS, "g"); g.setAttribute("transform", `translate(${dx},${dy})`); return g; };
+        const left = grp(-615, y0 - 668), right = grp(645, y0 - 656);   // ~60 px from the page edges
+        const isRow = new RegExp(`^${lid}-c\\d+$`), isHeart = new RegExp(`^${lid}-h\\d+$`), isBtn = new RegExp(`^${lid}-b\\d+$`);
+        [...ui.children].forEach((n) => {
+          const nid = n.id || "", kid = (n.firstElementChild && n.firstElementChild.id) || "", tr = (n.getAttribute("transform") || "").replace(/\s/g, "");
