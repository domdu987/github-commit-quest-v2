          tl.set("#t6cup", { opacity: 0 }, 0); tl.fromTo("#t6cup", { opacity: 0, scale: 0.5, svgOrigin: "540 900" }, { opacity: 1, scale: 1, svgOrigin: "540 900", duration: 0.45, ease: "back.out(2)", immediateRender: false }, t0);
          tl.to("#t6cup", { opacity: 0, duration: 0.2 }, t0 + d - 0.2); } });
