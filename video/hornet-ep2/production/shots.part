      // ---------- 10. danger signs → 1669 ----------
      add("danger", { ...Y3("t9", { time: "night", house: [200, 0.9], door: "open", tree: 1500, shrine: 1430, pond: false }), dark: 0.1, light: NIGHTL, grade: GNT, blur: BLUR,
