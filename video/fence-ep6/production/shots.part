      // ======================================================================================================
      // เอาชีวิตรอด 99 วัน · EP.6 (ใหม่ · ตัดสั้น ~90 วิ) "กฎบนหลังคา" — narrator-led, a red card closes every beat, HUD numbers, the drop before the twist
      // ======================================================================================================
      const put = (el, html) => el.insertAdjacentHTML("beforeend", html);
      const ZF = (L, tl, pre, t0, dur, list, mode = "shamble", y = 1180) => list.forEach(([w, x, s, ph, flip], k) => behind(L, tl, `${pre}-z${k}`, w, x, y, s, flip ?? true, t0, dur, [{ t: 0, mode, eyes: "dead", mouth: "snarl", opts: { period: 1.9 + ph } }]));
      const CLIP = (list) => { list.sort((a, b) => a.t - b.t); for (let n = 0; n + 1 < list.length; n++) list[n].end = Math.min(list[n].end, list[n + 1].t - 0.03); return list; };
      const split3 = (k, a1, a2, A, B, C) => {
        add(k, A); shots[shots.length - 1].dur = a1;
        add(k, B); let sh = shots[shots.length - 1]; sh.start = SH[k].start + a1; sh.dur = a2 - a1; sh.vo = (SH[k].vo || []).map((v) => ({ ...v, t: v.t - a1 }));
        add(k, C); sh = shots[shots.length - 1]; sh.start = SH[k].start + a2; sh.dur = D(k) - a2; sh.vo = (SH[k].vo || []).map((v) => ({ ...v, t: v.t - a2 }));
      };
      const capsAt = (k, a, b, lines, o) => caps(k, lines, o).filter((c) => c.end > a + 0.05 && c.t < b - 0.05).map((c) => ({ ...c, t: Math.max(0, c.t - a), end: Math.min(b - a - 0.03, c.end - a) }));
      const bubAt = (bb, a, b) => ({ ...bb, t: Math.max(0.02, bb.t - a), end: Math.min(b - a - 0.05, bb.end - a) });
      const FA = (k, a, i = 0, j = 0) => F(k, i, j) - a;
      const VA = (k, a, i = 0) => vo(k, i) - a;
      const GD = (x, y, s, track, extra = {}) => ({ who: "guard", x, y, s, track, ...extra });
      const HA = (who, x, y, s, track, extra = {}) => ({ who, x, y, s, blinks: [], track, ...extra });
      const NOBLINK = { blinks: [] };
      // looking out from the roof, a hand shading the eyes
      Rig.MODES.lookOut = (u, o) => ({ ...Rig.MODES.idle(u, o), head: -6 + Math.sin(u * 0.8), torso: -4, uaF: -120, faF: -60, uaB: 10, faB: -20 });
      // GSAP x/y on an element with a transform attribute replaces it: wrap it in a plain group and move the wrapper
      const wrapEl = (sel) => { const a = document.querySelector(sel), w = document.createElementNS("http://www.w3.org/2000/svg", "g"); a.parentNode.insertBefore(w, a); w.appendChild(a); return w; };
      // the sandbags along the canopy edge (the guard's nest), and the five rules painted on the canopy face
      const BAGS = (xs) => `<g>${xs.map((x) => `<rect x="${x}" y="692" width="130" height="74" rx="20" fill="#a5895a" stroke="#2e2a26" stroke-width="4"/>`).join("")}</g>`;
      const RULEWALL = (id) => `<g id="${id}-rules" transform="translate(-620,790)">${["1 เงียบ", "2 อยู่สูง", "3 เดินตอนแดด", "4 กักน้ำฝน", "5 ห้ามถือไฟ"].map((t, k) => `<text x="${k * 390}" y="60" font-family="Kanit" font-weight="900" font-size="62" fill="#c8392b" opacity=".92" transform="rotate(${-1 + (k % 2) * 2} ${k * 390} 60)">${t}</text>`).join("")}</g>`;
      // the trucks on the forecourt at night: two pickups facing left with headlight cones and a horn speaker on the first cab
      const HEADLIGHTS = (id, x, y) => `<g id="${id}"><path d="M${x},${y}L${x - 1500},${y - 260}L${x - 1500},${y + 220}Z" fill="#fff6d0" opacity=".42"/><circle cx="${x}" cy="${y}" r="40" fill="#fff6d0" opacity=".9"/></g>`;
      const HORN = (x, y) => `<g transform="translate(${x},${y})"><path d="M0,0l-70,-30v60z" fill="#3a3f45" stroke="#2e2a26" stroke-width="3"/><rect x="-10" y="-14" width="30" height="28" rx="6" fill="#5b6066" stroke="#2e2a26" stroke-width="3"/></g>`;

      // ---------- icons for this episode's cards (120-space) ----------
      const I3 = `stroke="${PK_INK}" stroke-width="3"`;
      const RIC = {
        quiet: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<circle cx="60" cy="58" r="34" fill="#f3d6b8" ${I3}/><path d="M46,52q4,4 8,0M66,52q4,4 8,0" stroke="${PK_INK}" stroke-width="3" fill="none" stroke-linecap="round"/><path d="M44,74h32" stroke="${PK_INK}" stroke-width="4" stroke-linecap="round"/><g class="a-wob" style="transform-origin:78px 86px"><path d="M78,60v26" stroke="#f3d6b8" stroke-width="12" stroke-linecap="round"/><path d="M78,60v26" stroke="${PK_INK}" stroke-width="2" fill="none"/></g>`,
        high: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<path d="M20,100V40h80v60" fill="#e8e2d4" ${I3}/><rect x="20" y="30" width="80" height="14" fill="#c8392b" ${I3}/><g class="a-bob"><circle cx="60" cy="22" r="9" fill="#f3d6b8" ${I3}/><path d="M60,31v16M50,40h20" stroke="${PK_INK}" stroke-width="4" stroke-linecap="round"/></g><path d="M40,100V60M46,100V60M40,70h6M40,82h6M40,94h6" stroke="#8d9299" stroke-width="3"/>`,
        sun: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<circle class="a-spin" style="transform-origin:60px 50px" cx="60" cy="50" r="22" fill="#f2c55c" ${I3}/><path d="M60,10v12M60,78v12M20,50h12M88,50h12M32,22l8,8M80,78l8,8M88,22l-8,8M32,78l8,-8" stroke="#e8a030" stroke-width="4" stroke-linecap="round"/>`,
        rain: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<path d="M34,50h52l-6,52H40z" fill="#2f6fb8" ${I3}/><path d="M38,60h44M40,76h40" stroke="#9fc0e0" stroke-width="3"/><g class="a-rise"><path d="M50,20v16M60,14v22M70,20v16" stroke="#7ab0e0" stroke-width="4" stroke-linecap="round"/></g>`,
        nolight: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<rect x="48" y="40" width="24" height="60" rx="6" fill="#3a3f45" ${I3}/><path d="M44,40h32l6,-16H38z" fill="#5b6066" ${I3}/><path d="M24,24L96,100" stroke="#c8392b" stroke-width="8" stroke-linecap="round"/>`,
        down: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<path d="M20,30h80" stroke="#8d9299" stroke-width="6"/><g class="a-bob"><path d="M60,36v44M46,66l14,16l14,-16" stroke="#c8392b" stroke-width="8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></g><path d="M20,100h80" stroke="#8d9299" stroke-width="6"/>`,
      };

      // the station at night, straight on from EP.5: the group under the canopy, the guard on the roof edge
      const NIGHT = (id, extra = {}) => ({ set: "station", setOpts: { id, time: "night", lampX: 300 }, dark: 0.5, blur: { far: 5 }, ...extra });
      const GROUP = (o = {}) => [HO(120, 1520, 0.9, o.ho || [{ t: 0, mode: "sit", eyes: "worry", mouth: "frown" }], { prop: "ledger", cu: false }),
        KS(380, 1520, 0.9, o.ks || [{ t: 0, mode: "sitLeg", eyes: "sad", mouth: "flat" }], { prop: "spear1", cu: false }),
        PI(620, 1520, 0.9, o.pi || [{ t: 0, mode: "sit", eyes: "worry", mouth: "flat" }], { flip: true, cu: false }),
        PH(860, 1520, 0.9, o.ph || [{ t: 0, mode: "sit", eyes: "squint", mouth: "flat" }], { flip: true, cu: false }),
        PU(-80, 1520, 0.55, o.pu || [{ t: 0, mode: "sleepSit", eyes: "closed", mouth: "flat" }], { cu: false })];


      // ---------- BEAT 0 · hook: the lit nest at night ("คนที่พาคุณรอดมาทั้งทาง / เคยเป็นคนของอีกฝ่าย"); then "อย่าเพิ่งไล่เขาไป" on the guard's torch finding ภู ----------
      split("hook", vo("hook", 2) - 0.1, {
        ...NIGHT("hk"), cu: false,
        cam: { keys: [{ t: 0, ...fr(400, 1150, 0.85, 540, 1000), drift: { s: 0.03 } }, { t: vo("hook", 1) - 0.1, glide: 0.4, ...fr(760, 1350, 1.5, 540, 1000), drift: { s: 0.03 } }] },
        actors: [...GROUP(), GD(820, 762, 0.75, [{ t: 0, mode: "torch", eyes: "squint", mouth: "frown", torch: true }], { flip: true, prop: "rifle" })],
        captions: capsAt("hook", 0, vo("hook", 2) - 0.1, [0, 1]),
        fx(tl, id, t0, L) { put(L.act, BAGS([620, 740, 900])); const X = t0 + vo("hook", 1); Fx.punch(tl, `#${id} .stage`, X, 1.06, 0.4); red(tl, X, 0.5, 0.5); Fx.heart(tl, t0, D("hook"), 0.55, 0.5); },
      }, {
        ...NIGHT("hk2", { dark: 0.55 }), cu: false,
        cam: { keys: [{ t: 0, ...fr(640, 1250, 1.05, 540, 1150), drift: { s: 0.02 } }] },
        actors: [PI(180, 1520, 0.9, [{ t: 0, mode: "idle", eyes: "worry", mouth: "frown" }]), PH(560, 1520, 0.9, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }]), GD(900, 1520, 0.9, [{ t: 0, mode: "torch", eyes: "squint", mouth: "frown", torch: true }], { flip: true })],
        captions: capsAt("hook", vo("hook", 2) - 0.1, D("hook"), [2]),
        extra(L) { Fence.light(L, 560, 1040, 320, "#fff6d8", 0.55); },
        fx(tl, id, t0) { Fx.heart(tl, t0, D("hook") - (vo("hook", 2) - 0.1), 0.5, 0.6); },
      });

      // ---------- BEAT 1 · the deal: the guard on the roof edge — ไฟ ข้าว กำแพง, รถมารับ… กฎข้อเดียว (red) — "เขาเรียกชื่อภู" ----------
      add("deal", {
        ...NIGHT("dl"),
        cam: { keys: [{ t: 0, ...fr(560, 1100, 0.95, 540, 1000), drift: { s: 0.015 } }, { t: vo("deal", 1) - 0.2, glide: 0.5, ...fr(760, 700, 1.5, 540, 900), drift: { s: 0.02 } }, ] },
        actors: [...GROUP({ pi: [{ t: 0, mode: "sit", eyes: "normal", mouth: "flat", look: 8 }], ph: [{ t: 0, mode: "sit", eyes: "squint", mouth: "flat", look: 8 }] }),
          GD(820, 762, 0.78, [{ t: 0, mode: "crouch", eyes: "squint", mouth: "flat" }, { t: vo("deal", 1), mode: "crouch", eyes: "squint", mouth: "frown", look: -6 }], { flip: true, prop: "rifle" })],
        captions: caps("deal", [0]),
        bubbles: [bub("deal", 1, 420, 440, 780, { br: true })],
        ui: [{ type: "signs", t: F("deal", 0, 2), items: ["ไฟ", "ข้าว", "กำแพง", "รถมารับพรุ่งนี้"], icons: [RIC.sun, RIC.rain, RIC.high, RIC.down], ok: [1, 1, 1, 1], at: [F("deal", 0, 2), F("deal", 0, 2) + 0.25, F("deal", 0, 2) + 0.5, F("deal", 0, 2) + 0.75], end: vo("deal", 1) - 0.1, top: 150 },
          { type: "signs", t: F("deal", 1, 1), items: ["กฎข้อเดียวของนิคม: <em>ทุกคนต้องมีประโยชน์</em>"], icons: [RIC.down], ok: [0], at: [F("deal", 1, 1)], end: D("deal") - 0.05, top: 150 }],
        fx(tl, id, t0, L) { put(L.act, BAGS([620, 740, 900])); const X = t0 + F("deal", 1, 1); Fx.punch(tl, `#${id} .stage`, X, 1.05, 0.4); red(tl, X, 0.45, 0.5); Fx.heart(tl, t0, D("deal"), 0.65, 0.4); },
      });

      // ---------- BEAT 2 · who ภู is: "ภู… คุณเป็นใคร" — sent to count; the voice is คุณวิน's station; the second number is us (HUD คน 5) ----------
      add("who", {
        ...NIGHT("wh"),
        cam: { keys: [{ t: 0, ...fr(700, 1300, 1.3, 540, 1000), drift: { s: 0.015 } }, { t: F("who", 0, 1) - 0.1, glide: 0.5, ...fr(820, 1320, 1.7, 540, 980), drift: { s: 0.02 } }] },
        actors: GROUP({ pi: [{ t: 0, mode: "sit", eyes: "worry", mouth: "flat", look: 8 }, { t: vo("who", 0), mode: "sitReach", eyes: "squint", mouth: "frown", look: 10 }],
          ph: [{ t: 0, mode: "sit", eyes: "squint", mouth: "flat" }, { t: F("who", 0, 1) - 0.2, mode: "sitHold", eyes: "sad", mouth: "flat", opts: { head: 14 } }],
          ks: [{ t: 0, mode: "sitLeg", eyes: "normal", mouth: "flat", look: 10 }, { t: F("who", 0, 1), mode: "sitLeg", eyes: "angry", mouth: "frown", look: 10 }] }).map((a, i) => (i === 2 ? { ...a, cu: undefined } : a)),
        captions: caps("who", [0]),
        ui: [{ type: "counter", t: F("who", 0, 2), end: D("who") - 0.05, label: "เลขตัวหลังในวิทยุ · พวกเรา", icon: "people", unit: "คน", max: 6, keys: [{ t: F("who", 0, 2), v: 5 }], right: true, top: 150 }],
        fx(tl, id, t0) { const X = t0 + F("who", 0, 1); Fx.punch(tl, `#${id} .stage`, X, 1.06, 0.4); red(tl, X, 0.5, 0.6); Fx.heart(tl, t0, D("who"), 0.55, 0.55); },
      });

      // ---------- BEAT 2b · the first number: 94 → วันฝนหมด (HUD tearCal); the useless outside the wall at night (red) ----------
      add("count", {
        ...NIGHT("ct"),
        cam: { keys: [{ t: 0, ...fr(820, 1320, 1.75, 540, 980), drift: { s: 0.02 } }, { t: vo("count", 1) - 0.1, ...fr(600, 1320, 1.5, 540, 1000), drift: { s: 0.02 } }] },
        actors: GROUP({ ph: [{ t: 0, mode: "sitHold", eyes: "sad", mouth: "flat", opts: { head: 10 } }, { t: vo("count", 1), mode: "sitHold", eyes: "sad", mouth: "frown", opts: { head: 16 } }],
          pi: [{ t: 0, mode: "sit", eyes: "worry", mouth: "flat", look: 10 }], ho: [{ t: 0, mode: "sit", eyes: "worry", mouth: "frown", look: 10 }], ks: [{ t: 0, mode: "sitLeg", eyes: "worry", mouth: "flat", look: 10 }] }),
        captions: caps("count"),
        ui: [{ type: "tearCal", t: F("count", 0, 1), end: D("count") - 0.05, top: 150, label: "เหลือ", unit: "วัน", keys: [{ t: F("count", 0, 1), v: 94 }], tag: { t: F("count", 0, 1) + 0.2, text: "· ถึงวันฝนหมด" } },
          { type: "signs", t: F("count", 1, 1), items: ["คนที่ไม่มีประโยชน์ → <em>วางไว้นอกกำแพง</em>"], icons: [RIC.down], ok: [0], at: [F("count", 1, 1)], end: D("count") - 0.05, top: 560 }],
        fx(tl, id, t0) { const X = t0 + F("count", 1, 1); Fx.punch(tl, `#${id} .stage`, X, 1.06, 0.4); red(tl, X, 0.5, 0.6); Fx.heart(tl, t0, D("count"), 0.5, 0.6); },
      });

      // ---------- BEAT 2c · the refusal: เบาหวาน; "เราไม่ไป… เรานับกันเอง"; "คุณวิน… ไม่ชอบคนปฏิเสธ" (red) ----------
      add("refuse", {
        ...NIGHT("rf"),
        cam: { keys: [{ t: 0, ...fr(620, 1320, 1.6, 540, 1000), drift: { s: 0.02 } }, { t: vo("refuse", 1) - 0.2, glide: 0.4, ...fr(780, 720, 1.5, 540, 900), drift: { s: 0.02 } }] },
        actors: [...GROUP({ ho: [{ t: 0, mode: "sit", eyes: "worry", mouth: "flat", look: 12 }],
            pi: [{ t: 0, mode: "sit", eyes: "normal", mouth: "flat" }, { t: vo("refuse", 0) + 0.8, mode: "sit", eyes: "squint", mouth: "flat", look: 8 }],
            ph: [{ t: 0, mode: "sitHold", eyes: "sad", mouth: "flat", opts: { head: 12 } }, { t: vo("refuse", 0) + 0.5, mode: "sit", eyes: "wide", mouth: "o" }] }).map((a, i) => (i === 2 ? { ...a, cu: undefined } : a)),
          GD(820, 762, 0.78, [{ t: 0, mode: "crouch", eyes: "squint", mouth: "flat" }, { t: vo("refuse", 1) - 0.3, mode: "idle", eyes: "angry", mouth: "frown" }], { flip: true, prop: "rifle" })],
        captions: caps("refuse", [1]),
        bubbles: [bub("refuse", 0, 560, 460, 620, { br: true, end: vo("refuse", 1) - 0.05 })],
        fx(tl, id, t0, L) { put(L.act, BAGS([620, 740, 900])); const X = t0 + F("refuse", 1, 1); Fx.punch(tl, `#${id} .stage`, X, 1.05, 0.4); red(tl, X, 0.45, 0.6); Fx.heart(tl, t0, D("refuse"), 0.6, 0.5); },
      });

      // ---------- BEAT 3 · morning: the guard gone, five rules painted on the canopy face; the HUD list ticks as the narrator reads them ----------
      add("rules", {
        set: "station", setOpts: { id: "ru", time: "dusk", sunX: 1500 }, dark: 0.18, blur: { far: 3 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(200, 1000, 0.8, 540, 1000), drift: { s: 0.015 } }, { t: vo("rules", 1) - 0.2, glide: 0.6, ...fr(200, 860, 1.15, 540, 900), drift: { s: 0.012 } }] },
        actors: [PU(-220, 1520, 0.55, [{ t: 0, mode: "pointUp", eyes: "wide", mouth: "o" }]), KS(120, 1520, 0.9, [{ t: 0, mode: "lookUp", eyes: "normal", mouth: "flat" }], { prop: "spear1" }),
          PI(520, 1520, 0.9, [{ t: 0, mode: "lookUp", eyes: "normal", mouth: "flat" }], { flip: true }), PH(760, 1520, 0.9, [{ t: 0, mode: "armsCrossed", eyes: "squint", mouth: "flat" }], { flip: true })],
        captions: caps("rules", [0]),
        ui: [{ type: "signs", t: vo("rules", 1), items: ["เงียบ", "อยู่สูง · <em>มันปีนบันไดไม่เป็น</em>", "เดินตอนแดด", "กักน้ำฝน", "ห้ามถือไฟ<em>ตอนกลางคืน</em>"], icons: [RIC.quiet, RIC.high, RIC.sun, RIC.rain, RIC.nolight], ok: [1, 1, 1, 1, 1],
          at: [F("rules", 1, 0) + 0.1, F("rules", 1, 1) + 0.1, F("rules", 1, 1) + 0.9, F("rules", 1, 1) + 1.5, F("rules", 1, 2) + 0.1], end: D("rules") - 0.05, top: 140 }],
        fx(tl, id, t0, L) { put(L.set, RULEWALL("ru")); put(L.act, BAGS([620, 740, 900])); Fx.heart(tl, t0, D("rules"), 0.8, 0.3); },
      });

      // ---------- BEAT 3b · 94 days by the rules; the movies agree: the ones who die make noise, carry lights, go downstairs (red ✗✗✗) ----------
      add("movie", {
        ...NIGHT("mv", { dark: 0.62, blur: { far: 9, mid: 8, set: 8 } }), cu: false,
        cam: { keys: [{ t: 0, ...fr(500, 1100, 0.85, 540, 1000), drift: { s: 0.01 } }] },
        captions: caps("movie"),
        ui: [{ type: "signs", t: F("movie", 0, 2) - 0.1, items: ["ส่งเสียง", "ถือไฟตอนกลางคืน", "ลงมาข้างล่าง"], icons: [RIC.quiet, RIC.nolight, RIC.down], ok: [0, 0, 0], at: [F("movie", 0, 2) - 0.1, F("movie", 0, 2) + 0.35, F("movie", 0, 2) + 0.8], end: D("movie") - 0.05, top: 170 }],
        fx(tl, id, t0) { red(tl, t0 + F("movie", 0, 2) + 0.8, 0.35, 0.6); Fx.heart(tl, t0, D("movie"), 0.7, 0.4); },
      });

      // ---------- BEAT 4 · ten days later: roof life (HUD: น้ำฝน · ข้าว · คน); the can on its string; "ถ้าก้องกินน้อยลง" ----------
      split("days", vo("days", 1) - 0.15, {
        set: "station", setOpts: { id: "dy", time: "dusk", sunX: 1500 }, dark: 0.2, blur: { far: 3 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(600, 640, 1.25, 540, 900), drift: { s: 0.02 } }] },
        actors: [PU(560, 762, 0.5, [{ t: 0, mode: "crouchDraw", eyes: "normal", mouth: "smile" }]), KS(820, 762, 0.75, [{ t: 0, mode: "guard", eyes: "squint", mouth: "flat" }], { prop: "spear1", flip: true }),
          HO(300, 762, 0.75, [{ t: 0, mode: "sit", eyes: "normal", mouth: "flat" }], { prop: "ledger" }), PI(1020, 762, 0.75, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }], { flip: true }), PH(120, 762, 0.75, [{ t: 0, mode: "idle", eyes: "squint", mouth: "flat" }])],
        captions: capsAt("days", 0, vo("days", 1) - 0.15, [0]),
        ui: [{ type: "counter", t: F("days", 0, 1), end: D("days") - 0.05, label: "น้ำฝนสำรอง", icon: "water", unit: "ลิตร", keys: [{ t: F("days", 0, 1), v: 40 }, { t: F("days", 0, 2), v: 120 }], right: true, top: 150 }],
        fx(tl, id, t0, L) {
          put(L.set, RULEWALL("dy")); put(L.act, BAGS([620, 740, 900]));
          put(L.act, `<g id="dy-line"><path d="M600,770V1180" stroke="#f4ecd8" stroke-width="3"/><g transform="translate(600,1180)"><rect x="-22" y="-30" width="44" height="60" rx="6" fill="#c9ccd0" stroke="#2e2a26" stroke-width="3"/></g></g>`);
          tl.fromTo("#dy-line", { y: 0 }, { y: -380, duration: 1.2, ease: "power1.inOut", yoyo: true, repeat: 3, immediateRender: false }, t0 + 0.3);
          put(L.set, `<g transform="translate(-520,760)"><rect x="-60" y="-110" width="120" height="110" rx="10" fill="#2f6fb8" stroke="#2e2a26" stroke-width="4"/><ellipse cx="0" cy="-110" rx="60" ry="14" fill="#1f4f90" stroke="#2e2a26" stroke-width="4"/></g>`);
          Fx.heart(tl, t0, vo("days", 1) - 0.15, 0.9, 0.25);
        },
      }, {
        set: "station", setOpts: { id: "dy2", time: "dusk", sunX: 1500 }, dark: 0.2, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(560, 680, 1.4, 540, 900), drift: { s: 0.02 } }] },
        actors: [PU(560, 762, 0.5, [{ t: 0, mode: "raise", eyes: "wide", mouth: "smileOpen" }], { prop: "bottle" }), HO(300, 762, 0.75, [{ t: 0, mode: "sit", eyes: "squint", mouth: "smile", look: 10 }], { prop: "ledger" }),
          KS(820, 762, 0.75, [{ t: 0, mode: "guard", eyes: "squint", mouth: "flat" }, { t: 1.4, mode: "idle", eyes: "normal", mouth: "smileOpen" }], { prop: "spear1", flip: true })],
        bubbles: [bubAt(bub("days", 1, 540, 420, 560, { br: true }), vo("days", 1) - 0.15, D("days"))],
        ui: [{ type: "counter", t: 0.3, end: D("days") - (vo("days", 1) - 0.15) - 0.05, label: "ข้าวเหลือ", icon: "rice", unit: "วัน", keys: [{ t: 0.4, v: 20 }], right: true, top: 150 }],
        fx(tl, id, t0, L) { put(L.set, RULEWALL("dy2")); put(L.act, BAGS([620, 740, 900])); Fx.heart(tl, t0, D("days") - (vo("days", 1) - 0.15), 0.9, 0.25); },
      });

      // ---------- BEAT 4b · the radio: 94 → 84 · ห้า; "พวกเขาอยู่ที่นี่ได้… เป็นเดือน" (the false safety) ----------
      add("radio", {
        set: "radioClose", setOpts: { id: "ra6" }, dark: 0.55,
        cam: { keys: [{ t: 0, ...fr(540, 1000, 1.0, 540, 960), drift: { s: 0.02 } }, { t: vo("radio", 0) - 0.1, ...fr(400, 900, 1.5, 540, 960), drift: { s: 0.03 } }] },
        captions: caps("radio", [0, 1], { quote: true }),
        ui: [{ type: "tearCal", t: vo("radio", 0) - 0.15, end: D("radio") - 0.05, top: 150, label: "เหลือ", unit: "วัน", keys: [{ t: vo("radio", 0) - 0.15, v: 94 }, { t: F("radio", 0, 1), v: 84 }], tag: { t: F("radio", 0, 2), text: "· ห้า" } }],
        fx(tl, id, t0) {
          const on = t0 + vo("radio", 0) - 0.15;
          tl.fromTo(["#ra6-dialw", "#ra6-glow"], { opacity: 0 }, { opacity: 1, duration: 0.05, repeat: 5, yoyo: true, immediateRender: false }, on); tl.set(["#ra6-dialw", "#ra6-glow"], { opacity: 1 }, on + 0.3);
          tl.fromTo("#ra6-needle", { x: 0 }, { x: 180, duration: 0.6, ease: "power1.inOut", immediateRender: false }, on + 0.1);
          document.querySelectorAll(`#${id} .capbox`).forEach((c, i) => { if (i === 0) c.classList.add("radio"); });
          Fx.punch(tl, `#${id} .stage`, t0 + F("radio", 0, 2), 1.06, 0.4); Fx.heart(tl, t0, D("radio"), 0.6, 0.45);
        },
      });

      // ---------- BEAT 5 · the twist: "มีปัญหา… อยู่อย่างเดียว" (the roof, the lamp); lights on the road + the loudspeaker; the fields turn; black ----------
      const TW2 = vo("twist", 0) - 0.1, TW3 = vo("twist", 2) + 1.2;
      split3("twist", TW2, TW3, {
        ...NIGHT("tw", { dark: 0.6 }), cu: false,
        cam: { keys: [{ t: 0, ...fr(560, 700, 1.4, 540, 900), drift: { s: 0.02 } }] },
        actors: [PI(400, 762, 0.75, [{ t: 0, mode: "sleepSit", eyes: "closed", mouth: "flat" }], { flip: true }), KS(760, 762, 0.75, [{ t: 0, mode: "guard", eyes: "squint", mouth: "flat" }, { t: 0.5, mode: "lookOut", eyes: "wide", mouth: "o" }], { prop: "spear1", flip: true }),
          PH(560, 762, 0.75, [{ t: 0, mode: "sit", eyes: "squint", mouth: "flat" }], { flip: true }), HO(220, 762, 0.75, [{ t: 0, mode: "sleepSit", eyes: "closed", mouth: "flat" }]), PU(120, 762, 0.5, [{ t: 0, mode: "sleepSit", eyes: "closed", mouth: "flat" }])],
        captions: [],
        fx(tl, id, t0, L) { put(L.set, RULEWALL("tw")); put(L.act, BAGS([620, 740, 900])); tl.to(`#${id} .stage`, { filter: "saturate(0.55) brightness(0.8)", duration: TW2, ease: "power1.in", immediateRender: false }, t0); Fx.heart(tl, t0, TW2, 0.9, 0.3); },
      }, {
        ...NIGHT("tw2", { dark: 0.55 }), cu: false,
        cam: { keys: [{ t: 0, ...fr(900, 1100, 0.95, 540, 1000), drift: { s: 0.03 } }, { t: VA("twist", TW2, 1) - 0.1, glide: 0.4, ...fr(1200, 1150, 1.3, 540, 1000), drift: { s: 0.03 } }] },
        shake: (t) => 2 * Math.sin(t * 6.3),
        captions: capsAt("twist", TW2, TW3, [0, 1], { quote: true }),
        fx(tl, id, t0, L) {
          put(L.set, RULEWALL("tw2")); put(L.act, BAGS([620, 740, 900]));
          put(L.mid, `<g id="tw2-tr">${Road.TRUCK("tw2-t1", { col: "#3a3f45" })}</g><g id="tw2-tr2">${Road.TRUCK("tw2-t2", { col: "#2f3b4a" })}</g>`);
          document.getElementById("tw2-tr").setAttribute("transform", "translate(2300,1240) scale(-0.9,0.9)"); document.getElementById("tw2-tr2").setAttribute("transform", "translate(2900,1230) scale(-0.82,0.82)");
          const w1 = wrapEl("#tw2-tr"), w2 = wrapEl("#tw2-tr2"); tl.to(w1, { x: -800, duration: 2.2, ease: "power2.out", immediateRender: false }, t0 + 0.2); tl.to(w2, { x: -900, duration: 2.5, ease: "power2.out", immediateRender: false }, t0 + 0.5);
          put(L.glow, `${HEADLIGHTS("tw2-hl1", 2300, 1100)}${HEADLIGHTS("tw2-hl2", 2900, 1090)}`); const h1 = wrapEl("#tw2-hl1"), h2 = wrapEl("#tw2-hl2"); tl.to(h1, { x: -800, duration: 2.2, ease: "power2.out", immediateRender: false }, t0 + 0.2); tl.to(h2, { x: -900, duration: 2.5, ease: "power2.out", immediateRender: false }, t0 + 0.5);
          put(L.act, HORN(1220, 990));
          document.querySelectorAll(`#${id} .capbox`).forEach((c, i) => { if (i >= capsAt("twist", TW2, TW3, [0]).length) c.classList.add("radio"); });
          const X = t0 + FA("twist", TW2, 1, 1); Fx.punch(tl, `#${id} .stage`, X, 1.06, 0.4); red(tl, X, 0.4, 0.5); Fx.heart(tl, t0, TW3 - TW2, 0.45, 0.7);
        },
      }, {
        ...NIGHT("tw3", { dark: 0.55, blur: { far: 2 } }), cu: false,
        cam: { keys: [{ t: 0, ...fr(900, 1150, 0.9, 540, 1000), drift: { s: 0.04 } }, { t: D("twist") - TW3 - 1.5, glide: 0.7, ...fr(1000, 1380, 1.9, 540, 1000), drift: { s: 0.05 } }] },
        shake: (t) => 2.5 * Math.sin(t * 8.1) + 1.2 * Math.sin(t * 15),
        captions: capsAt("twist", TW3, D("twist"), [2]),
        actors: [HA("ha2", 1500, 1540, 0.95, [{ t: 0, mode: "shamble", eyes: "dead", mouth: "snarl", opts: { period: 1.4 } }, { t: D("twist") - TW3 - 1.4, mode: "lunge", eyes: "dead", mouth: "snarl" }], { flip: true, moveTo: { x: 1060, dur: D("twist") - TW3 - 1.4, ease: "none" }, cast: false })],
        fx(tl, id, t0, L) {
          put(L.mid, `<g id="tw3-tr">${Road.TRUCK("tw3-t1", { col: "#3a3f45" })}</g>`); document.getElementById("tw3-tr").setAttribute("transform", "translate(1500,1240) scale(-0.9,0.9)"); put(L.glow, HEADLIGHTS("tw3-hl", 1150, 1100));
          ZF(L, tl, "tw3", t0, D("twist") - TW3, [["ha1", 200, 0.62, 0, false], ["ha2", 420, 0.6, 0.3, false], ["ha3", 640, 0.64, 0.5, false], ["ha1", 880, 0.6, 0.2, false], ["ha2", 1120, 0.58, 0.7, false], ["ha3", 1380, 0.62, 0.1, false], ["ha1", 1620, 0.6, 0.4, false], ["ha2", 60, 0.56, 0.9, false]], "shamble", 1180);
          const X = t0 + D("twist") - TW3 - 0.8; impact(tl, id, L, X, 1000, 1300, 0.8); Fx.punch(tl, `#${id} .stage`, X, 1.1, 0.4); red(tl, X, 0.7, 0.5); Fx.glitch(tl, `#${id}`, X, 0.2, 12, 23);
          tl.set("#black", { opacity: 1 }, t0 + D("twist") - TW3 - 0.06);
          Fx.heart(tl, t0, D("twist") - TW3, 0.4, 0.9);
        },
      });

      // ---------- sig ----------
      add("sig", {
        ...NIGHT("sg", { dark: 0.6, blur: { far: 10, set: 8, mid: 8 } }),
        cam: { keys: Sig.cam(F, fr(400, 1100, 0.8, 540, 960)) }, shake: Sig.shake(F),
        captions: caps("sig"),
        ui: [Sig.ui(F, "เหลือ 84 วัน · กฎโลกซอมบี้", [["เงียบ", true], ["อยู่สูง", true], ["ห้ามถือไฟตอนกลางคืน", true], ["???", false]], D("sig"))],
        fx(tl, id, t0) { tl.set("#black", { opacity: 0 }, t0); Sig.fx(tl, id, t0, F, D("sig")); },
      });

      // ---------- ตอนที่ 7: the tease and the CTA ----------
      add("next", {
        ...NIGHT("nx", { dark: 0.75, blur: { far: 10, set: 8, mid: 8 } }), cu: false,
        cam: { keys: [{ t: 0, ...fr(560, 1100, 0.85, 540, 960), drift: { s: 0.01 } }] },
        ui: [{ type: "nextCard", t: 0.1, big: "ตอนที่ 7", tag: "ไฟฉายทุกดวงหันไปหามัน… และมันหันมาหาไฟฉายทุกดวง · กดติดตาม แล้วมารอดคืนนี้ไปด้วยกัน", top: 420 }],
        fx(tl, id, t0) { tl.set("#black", { opacity: 0 }, t0); Fx.heart(tl, t0, D("next"), 0.7, 0.4); tl.set("#black", { opacity: 1 }, t0 + D("next") - 0.06); },
      });

      // ---------- end: black ----------
      add("end", { ...NIGHT("en", { dark: 1 }), cu: false, cam: { keys: [{ t: 0, ...fr(560, 1100, 0.85, 540, 960) }] }, fx(tl, id, t0) { tl.set("#black", { opacity: 1 }, t0); } });

      // no source cards on screen (user, 26 Oct 2026)
      shots.forEach((sh) => { if (sh.ui) sh.ui = sh.ui.filter((u) => u.type !== "src"); });

      // ---------- the look ----------
      const DUSKS = (L) => { Fence.light(L, 1500, 1000, 900, "#ff9a40", 0.5); Fence.haze(L, 1180, 400, "#ffb070", 0.28); };
      const NIGHTS = (L) => { Fence.light(L, 300, 1100, 520, "#ffd58a", 0.5, "lampf"); Fence.haze(L, 1180, 400, "#5a6f90", 0.3); };
      const TRUCKL = (L) => { Fence.light(L, 1150, 1100, 700, "#fff6d0", 0.55); Fence.haze(L, 1180, 400, "#5a6f90", 0.3); };
      const LOOK = {
        "hook#0": NIGHTS, "hook#1": NIGHTS, deal: NIGHTS, who: NIGHTS, count: NIGHTS, refuse: NIGHTS, rules: DUSKS, movie: NIGHTS,
        "days#0": DUSKS, "days#1": DUSKS, radio: (L) => { Fence.depth(L, "post", { x: -200, w: 300, op: 0.85 }); }, "twist#0": NIGHTS, "twist#1": TRUCKL, "twist#2": TRUCKL,
        sig: NIGHTS, next: NIGHTS, end: () => {},
      };
      const seen = {}, depth0 = Fence.depth;
      shots.forEach((sh) => { const n = seen[sh.key] = (seen[sh.key] ?? -1) + 1, look = LOOK[`${sh.key}#${n}`] || (n === 0 ? LOOK[sh.key] : null), e = sh.extra;
        if (look) sh.extra = (L, id) => { if (e) e(L, id); const k0 = (sh.cam && sh.cam.keys && sh.cam.keys[0]) || { x: 0, y: 0, s: 1 }; Fence.depth = (L2, kind, o = {}) => depth0(L2, kind, { cam: k0, ...o }); look(L, id); Fence.depth = depth0; }; });
      shots.forEach((sh) => { const f = sh.fx; sh.fx = (tl, id, t0, L) => { if (f) f(tl, id, t0, L); Zom.zlife(tl, `#${id}`, t0, sh.dur); Fence.flife(tl, `#${id}`, t0, sh.dur); }; });
