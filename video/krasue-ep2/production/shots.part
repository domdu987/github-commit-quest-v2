      // ---------- แสงกระสือ: helpers ----------
      const tf = (tl, sel, t, dur, to, ease = "power2.inOut") => tl.to(sel, { attr: { transform: to }, duration: dur, ease, immediateRender: false }, t);
      const put = (el, html) => el.insertAdjacentHTML("beforeend", html);
      const split = (k, at, A, B) => {
        add(k, A); shots[shots.length - 1].dur = at;
        add(k, B); const sh = shots[shots.length - 1]; sh.start = SH[k].start + at; sh.dur = D(k) - at;
      };
      const capsFrom = (k, at, lines, o) => caps(k, lines, o).filter((c) => c.end > at + 0.05).map((c) => ({ ...c, t: Math.max(0, c.t - at), end: c.end - at }));
      const steps = (k, label, items, at, endAt, o = {}) => ({ type: "steps", t: at, label, items, gap: o.gap ?? 0.5, top: o.top ?? 210, end: endAt ?? D(k) - 0.2 });
      // ---------- แสงกระสือ EP.2 อย่าจับตัว ----------
      // many camera angles: low at the water, from the boat, the switch close up, down the stairs, top-down on the boards, the door
      const FON = (x, y, s, track, extra = {}) => ({ who: "fon", x, y, s, track, blinks: [0.9, 3.1, 5.4], ...extra });
      const TOEY = (x, y, s, track, extra = {}) => ({ who: "toey", x, y, s, track, blinks: [1.2, 3.6], ...extra });
      const PIAK = (x, y, s, track, extra = {}) => ({ who: "piak", x, y, s, track, blinks: [0.7, 2.6, 4.9], ...extra });
      const G = 1480, W = 1250, WL = G - 170; // house floor, the flood over the village, the water inside the house (just under the outlets)
      const WIRE = { span: 1, wire: 2 }, WE = [956, 1280];
      const FX = -250, DX = 1700, HX = FX + 273, HY = G - 430; // the fridge, the front door, the fridge's lower handle
      // poses: stuck to the fridge by the current; holding a broom up in both hands
      Rig.MODES.shocked = (u, o) => { const j = Math.sin(u * 83) * 4, k = Math.sin(u * 61); return { ...Rig.MODES.point(u, o), torso: -10 + j * 0.5, head: -16 + j, uaB: 40 + 6 * k, faB: 50 - 6 * k, bodyY: j * 0.6 }; };
      Rig.MODES.broomUp = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -130 + 2 * Math.sin(u * 2), faF: -16, uaB: -120 + 2 * Math.sin(u * 2), faB: -24, torso: -4, head: -10 });
      const TOP = (L, id) => { const w = document.getElementById(`${id}-wfront`) || document.getElementById(`${id}-water`); if (w) L.act.appendChild(w); };
      const HOUSE = (id, o = {}) => ({ id, level: WL, fridgeX: FX, doorX: DX, ...o });
      // the house lights: off (tube dark, no flicker) — or under our control in fx
      const lightsOff = (hid) => { const t = document.getElementById(`${hid}-tubeg`); if (t) { t.classList.remove("ktube"); t.setAttribute("opacity", "0"); } };
      const tube = (hid) => { const t = document.getElementById(`${hid}-tubeg`); if (t) t.classList.remove("ktube"); return `#${hid}-tubeg`; };
      // the current between เต้ย's hand and the fridge handle (act) and its glow (glow layer)
      const zap = (id, x0, y0, x1, y1) => {
        const d = (k) => { let p = `M${x0},${y0}`; for (let i = 1; i < 6; i++) p += `L${(x0 + (x1 - x0) * i / 6 + ((i + k) % 2 ? 14 : -14)).toFixed(0)},${(y0 + (y1 - y0) * i / 6 + ((i * 7 + k) % 3 - 1) * 16).toFixed(0)}`; return p + `L${x1},${y1}`; };
        return { act: `<g id="${id}" opacity="0">${[0, 1, 2].map((k) => `<path d="${d(k)}" stroke="#eafcff" stroke-width="${5 - k}" fill="none" stroke-linejoin="round"/>`).join("")}</g>`,
          glow: `<g id="${id}g" opacity="0"><circle cx="${(x0 + x1) / 2}" cy="${(y0 + y1) / 2}" r="260" fill="url(#ksArc)"/></g>` };
      };
      const flick = (tl, sel, t0, dur, seed = 3, lo = 0.25, hi = 1) => { let q = seed; const r = () => ((q = (q * 1664525 + 1013904223) % 4294967296) / 4294967296);
        for (let t = 0; t < dur; t += 0.06 + r() * 0.2) tl.set(sel, { opacity: r() < 0.4 ? lo : hi }, t0 + t); };
      const IK = "#2e2a26";
      const ROW3 = [`<circle cx="34" cy="28" r="12" fill="#e9bc93" stroke="${IK}" stroke-width="3"/><path d="M34,40V74M34,50l-16,-12M34,50l16,-14M34,74l-10,22M34,74l10,22" stroke="${IK}" stroke-width="7" stroke-linecap="round"/>
          <path d="M6,18l8,6l-6,4l8,6M56,14l-6,8l6,2l-6,8" stroke="#f2c94a" stroke-width="4" fill="none"/>
          <g class="kw"><path d="M62,108L110,42" stroke="#6a4a2e" stroke-width="12" stroke-linecap="round"/><path d="M62,108L110,42" stroke="#c9a86a" stroke-width="6" stroke-linecap="round"/></g>`,
        `<span style="font-size:54px">โดนดูด<u>อย่าจับ</u> หาไม้แห้ง</span>`];
      const elec = (id) => { const c = document.getElementById(`${id}-g0`); if (c) c.classList.add("elec"); };
      // the broom: a long dry wooden handle with a bristle head (world coordinates, from a to b = the bristles)
      const broom = (id, ax, ay, bx, by) => { const a = Math.atan2(by - ay, bx - ax) * 180 / Math.PI;
        return `<g id="${id}"><path d="M${ax},${ay}L${bx},${by}" stroke="${IK}" stroke-width="30" stroke-linecap="round"/><path d="M${ax},${ay}L${bx},${by}" stroke="#c9a86a" stroke-width="20" stroke-linecap="round"/>
          <g transform="translate(${bx},${by}) rotate(${a.toFixed(1)})"><path d="M0,-30L120,-70L130,70L0,30Z" fill="#d8b46a" stroke="${IK}" stroke-width="5"/>${[-40, -14, 12, 38].map((d) => `<path d="M20,${d * 0.6}L126,${d * 1.5}" stroke="#a8843a" stroke-width="4"/>`).join("")}</g></g>`; };

      // ---------- 0. EP.1's last image: เต้ย in the water by the broken line, the กระสือ beyond ----------
      add("recap", {
        set: "floodVillage", setOpts: { id: "f0", dark: true, fallen: WIRE, seed: 221 }, dark: 0.34,
        cam: { keys: [{ t: 0, ...fr(880, 1100, 1.0, 540, 1250), drift: { s: 0.04 } }] },
        actors: [TOEY(800, W + 170, 0.75, [{ t: 0, mode: "idle", eyes: "glow", mouth: "flat" }])],
        extra(L) { put(L.act, Krasue.ghost(1080, 880, 0.9)); put(L.glow, Krasue.glow(1080, 880, 0.9)); },
        fx(tl, id, t0, L) {
          TOP(L, "f0"); Krasue.arcs(tl, "#f0-arc", "#f0-arcg", t0, D("recap"), 31);
          Fx.glitch(tl, `#${id}`, t0, 0.3, 14, 701); Fx.heart(tl, t0, D("recap"), 0.4, 0.6);
        },
      });

      // ---------- 1. flash-forward: the kitchen lit, เต้ย stuck to the fridge, his sister's hand coming — cut ----------
      const zH = zap("zh", HX - 40, HY + 10, HX, HY);
      add("hook", {
        set: "houseIn", setOpts: HOUSE("h1"), dark: 0.14,
        cam: { keys: [{ t: 0, ...fr(260, G - 420, 1.15, 540, 1050), drift: { s: 0.06 } }] },
        shake: (t) => 5 * Math.sin(t * 71),
        actors: [TOEY(240, G, 1.0, [{ t: 0, mode: "shocked", eyes: "wide", mouth: "scream" }], { flip: true }),
          FON(865, G - 180, 1.4, [{ t: 0, mode: "point", eyes: "wide", mouth: "scream" }], { flip: true, moveTo: { x: 755, y: G - 90, dur: D("hook"), ease: "power1.in" } })],
        captions: caps("hook"),
        extra(L) { put(L.act, zH.act); put(L.glow, zH.glow); },
        fx(tl, id, t0, L) {
          TOP(L, "h1"); Krasue.arcs(tl, "#zh", "#zhg", t0, D("hook"), 41);
          flick(tl, tube("h1"), t0, D("hook"), 5); flick(tl, `#${id}-dark`, t0, D("hook"), 9, 0.14, 0.5);
          Fx.heart(tl, t0 + 0.3, D("hook") - 0.3, 0.4, 0.5);
          Fx.glitch(tl, `#${id}`, t0 + D("hook") - 0.5, 0.3, 18, 702); Fx.punch(tl, `#${id} .stage`, t0 + D("hook") - 0.5, 1.08, 0.4);
          tl.fromTo("#flashw", { opacity: 0.8 }, { opacity: 0, duration: 0.25, immediateRender: false }, t0 + D("hook") - 0.45);
        },
      });

      // ---------- 2. low at the water: ฝน wading in after him ----------
      add("step", {
        set: "floodVillage", setOpts: { id: "f2", dark: true, fallen: WIRE, seed: 222 }, dark: 0.3,
        cam: { keys: [{ t: 0, ...fr(420, 1180, 1.15, 540, 1000), drift: { x: 40, s: 0.05 } }] },
        actors: [FON(120, W + 90, 0.95, [{ t: 0, mode: "walk", eyes: "wide", mouth: "o" }], { moveTo: { x: 380, y: W + 130, dur: D("step"), ease: "power1.inOut" } }),
          TOEY(800, W + 170, 0.75, [{ t: 0, mode: "idle", eyes: "glow", mouth: "flat" }])],
        captions: caps("step"),
        fx(tl, id, t0, L) { TOP(L, "f2"); Krasue.arcs(tl, "#f2-arc", "#f2-arcg", t0, D("step"), 32); Fx.heart(tl, t0, D("step"), 0.42, 0.5); },
      });

      // ---------- 3. ลุงเปี๊ยก in his boat, torch up: "หยุด! น้ำมีไฟ!" ----------
      add("stop", {
        set: "floodVillage", setOpts: { id: "f3", dark: true, seed: 223 }, dark: 0.3, blur: { far: 6, set: 5 },
        cam: { keys: [{ t: 0, ...fr(560, W - 20 - 530 * 1.6, 1.0, 540, 920), drift: { x: -30, s: 0.07 } }] },
        shake: (t) => (t < 0.6 ? 10 * Math.sin(t * 50) * (0.6 - t) : 0),
        actors: [PIAK(560, W - 20, 1.6, [{ t: 0, mode: "torch", eyes: "wide", mouth: "scream" }])],
        captions: caps("stop", undefined, { quote: true }),
        extra(L) { put(L.act, `<g id="bf3">${Krasue.boatFront(560, W + 30, 1.6)}</g>`); put(L.glow, `<path d="M700,${W - 520}L1400,${W - 900}L1400,${W - 140}Z" fill="#fff2c8" opacity=".22"/>`); },
        fx(tl, id, t0, L) { TOP(L, "f3"); L.act.appendChild(document.getElementById("bf3")); Fx.punch(tl, `#${id} .stage`, t0 + 0.05, 1.08, 0.3); },
      });

      // ---------- 4. wide: he has called the power company; the line spits… and dies; the lamp by the temple goes out ----------
      add("off", {
        set: "floodVillage", setOpts: { id: "f4", fallen: WIRE, houses: [[-150, 1.0, { dark: true }], [980, 0.8, { dark: true }]], seed: 224 }, dark: 0.3,
        cam: { keys: [{ t: 0, ...fr(600, 1050, 0.74, 540, 1000), drift: { s: 0.02 } }, { t: F("off", 0, 2) - 0.1, glide: 0.8, ...fr(900, 1150, 1.15, 540, 1000), drift: { s: 0.03 } }] },
        actors: [PIAK(180, W - 20, 0.8, [{ t: 0, mode: "phoneEar", eyes: "normal", mouth: "o" }]),
          FON(420, W + 130, 0.9, [{ t: 0, mode: "idle", eyes: "wide", mouth: "flat" }]),
          TOEY(800, W + 170, 0.75, [{ t: 0, mode: "idle", eyes: "glow", mouth: "flat" }, { t: F("off", 0, 2) + 0.3, mode: "idle", eyes: "closed", mouth: "flat" }])],
        captions: caps("off"),
        extra(L) {
          put(L.set, `<g id="b4">${Krasue.boat(180, W + 10, 0.8)}</g>`); put(L.act, `<g id="bf4">${Krasue.boatFront(180, W + 10, 0.8)}</g>`);
          L.glow.querySelectorAll(".lamp").forEach((el) => { el.classList.remove("lamp"); el.classList.add("f4lamp"); });
        },
        fx(tl, id, t0, L) {
          TOP(L, "f4"); L.act.appendChild(document.getElementById("bf4"));
          Krasue.arcs(tl, "#f4-arc", "#f4-arcg", t0, F("off", 0, 2), 34);
          [0, 0.08, 0.16].forEach((d, k) => tl.set(`#${id} .f4lamp`, { opacity: k % 2 ? 1 : 0 }, t0 + F("off", 0, 2) + d));
          tl.set(`#${id} .f4lamp`, { opacity: 0 }, t0 + F("off", 0, 2) + 0.24);
          Fx.glitch(tl, `#${id}`, t0 + F("off", 0, 2), 0.2, 10, 703);
        },
      });

      // ---------- 5. he paddles in and hauls เต้ย into the boat ----------
      add("pull", {
        set: "floodVillage", setOpts: { id: "f5", dark: true, fallen: WIRE, seed: 225 }, dark: 0.3,
        cam: { keys: [{ t: 0, ...fr(720, 1080, 1.15, 540, 1000), drift: { s: 0.04 } }] },
        actors: [PIAK(620, W - 20, 0.9, [{ t: 0, mode: "drag", eyes: "normal", mouth: "o" }]),
          TOEY(800, W + 170, 0.75, [{ t: 0, mode: "idle", eyes: "closed", mouth: "flat" }], { moveTo: { x: 700, y: W - 10, dur: 0.9, at: F("pull", 0, 1), ease: "power2.inOut" } })],
        captions: caps("pull", undefined, { quote: true }),
        extra(L) { put(L.set, Krasue.boat(640, W + 10, 0.9, { flip: true })); put(L.act, `<g id="bf5">${Krasue.boatFront(640, W + 10, 0.9, { flip: true })}</g>`); },
        fx(tl, id, t0, L) { TOP(L, "f5"); L.act.appendChild(document.getElementById("bf5")); },
      });

      // ---------- 6. เต้ย close in the boat, eyes far away: "ป้าแช่ม… เรียกผม…" — far off, a green light ----------
      add("dazed", {
        set: "floodVillage", setOpts: { id: "f6", dark: true, lights: [[130, 160, 0.5]], seed: 226 }, dark: 0.3, blur: { far: 5 },
        cam: { keys: [{ t: 0, ...fr(560, W + 40 - 530 * 2.0, 1.0, 540, 960), drift: { s: 0.07 } }] },
        actors: [TOEY(560, W + 40, 2.0, [{ t: 0, mode: "idle", eyes: "side", mouth: "flat" }, { t: vo("dazed"), mode: "idle", eyes: "side", mouth: "o" }, { t: voEnd("dazed"), mode: "idle", eyes: "glow", mouth: "flat" }])],
        captions: caps("dazed", undefined, { quote: true }),
        extra(L) { put(L.act, `<g id="bf6">${Krasue.boatFront(560, W - 440, 2.2)}<rect x="-200" y="${W - 420}" width="1500" height="900" fill="#3b2a1c"/><path d="M-200,${W - 300}H1300" stroke="#2a1c12" stroke-width="10"/></g>`); },
        fx(tl, id, t0, L) {
          L.act.appendChild(document.getElementById("bf6"));
          tl.fromTo(["#f6-l0", "#f6-lg0"], { opacity: 0 }, { opacity: 1, duration: 0.6, immediateRender: false }, t0 + F("dazed", 0, 1));
          Fx.heart(tl, t0 + F("dazed", 0, 1), D("dazed") - F("dazed", 0, 1), 0.45, 0.45);
        },
      });

      // ---------- 7. 1 a.m.: the lights come back across the village — one house stays dark ----------
      add("one", {
        set: "floodVillage", setOpts: { id: "f7", houses: [[-150, 1.0, { dark: true }], [980, 0.8]], seed: 227 }, dark: 0.1,
        cam: { keys: [{ t: 0, ...fr(420, 1000, 0.72, 540, 1000), drift: { x: 40, s: 0.02 } }, { t: F("one", 0, 2) + 0.4, glide: 1.4, ...fr(-150, 950, 1.0, 540, 1000), drift: { s: 0.03 } }] },
        captions: caps("one"),
        fx(tl, id, t0) {
          tl.set([`#${id}-glow`, `#${id} .slt`], { opacity: 0 }, t0);
          tl.set(`#${id}-dark`, { opacity: 0.6 }, t0);
          [0, 0.1, 0.18, 0.3].forEach((d, k) => { tl.set([`#${id}-glow`, `#${id} .slt`], { opacity: k % 2 ? 0 : 1 }, t0 + F("one", 0, 2) + d); tl.set(`#${id}-dark`, { opacity: k % 2 ? 0.6 : 0.1 }, t0 + F("one", 0, 2) + d); });
        },
      });

      // ---------- 8. the main switch close up, still down: her house is dark ----------
      add("down", {
        set: "switchClose", setOpts: { id: "sc8", hand: false }, dark: 0.45,
        cam: { keys: [{ t: 0, ...fr(540, 1060, 1.15, 540, 960), drift: { s: 0.04 } }] },
        captions: caps("down"),
        fx(tl, id, t0) { tl.set("#sc8-lever", { attr: { transform: "matrix(1 0 0 -1 0 2100)" } }, t0); },
      });

      // ---------- 9. upstairs: ฝน's face in the light of her phone ----------
      add("phone", {
        set: "houseIn", setOpts: HOUSE("h9"), dark: 0.6, blur: { far: 8, set: 8 },
        cam: { keys: [{ t: 0, ...fr(300, G + 1300 - 530 * 2.3, 1.0, 540, 1000), drift: { s: 0.05 } }] },
        actors: [FON(300, G + 1300, 2.3, [{ t: 0, mode: "phoneLook", eyes: "side", mouth: "flat" }])],
        captions: caps("phone"),
        extra(L) { lightsOff("h9"); put(L.glow, `<ellipse cx="380" cy="${G + 160}" rx="420" ry="460" fill="url(#ksTube)" opacity=".9"/>`); },
      });

      // ---------- 10. the replay: the green light floating after เต้ย all the way… and a face in it ----------
      const RP = F("replay", 0, 3) - 0.25;
      add("replay", {
        set: "floodVillage", setOpts: { id: "f10", dark: true, seed: 228 }, dark: 0.3,
        cam: { keys: [{ t: 0, ...fr(520, 1080, 0.95, 540, 1050), drift: { x: 60, s: 0.02 } }, { t: RP, glide: 0.35, ...fr(700, 940, 2.0, 540, 900), drift: { s: 0.05 } }] },
        actors: [TOEY(240, W + 170, 0.75, [{ t: 0, mode: "walk", eyes: "glow", mouth: "flat" }], { moveTo: { x: 640, y: W + 170, dur: RP, ease: "none" } })],
        captions: caps("replay"),
        ui: [{ type: "rec", t: 0, dur: D("replay"), play: [18, 74], tc0: 1342, mode: "ไลฟ์เมื่อคืน" }],
        extra(L) {
          put(L.act, `<g id="rp-orb">${Krasue.orb(300, 940, 0.9)}</g>`); put(L.glow, `<g id="rp-orbg">${Krasue.orbGlow(300, 940, 0.9)}</g>`);
          put(L.act, Krasue.ghost(700, 900, 0.55, { id: "rp-k", op: 0, bun: true })); put(L.glow, `<g id="rp-kg" opacity="0">${Krasue.glow(700, 900, 0.55)}</g>`);
        },
        fx(tl, id, t0, L) {
          TOP(L, "f10");
          tl.fromTo(["#rp-orb", "#rp-orbg"], { x: 0 }, { x: 400, duration: RP, ease: "none", immediateRender: false }, t0);
          tl.to(["#rp-orb", "#rp-orbg"], { opacity: 0, duration: 0.2 }, t0 + RP + 0.1);
          tl.fromTo(["#rp-k", "#rp-kg"], { opacity: 0 }, { opacity: 1, duration: 0.25, immediateRender: false }, t0 + RP + 0.1);
          Fx.glitch(tl, `#${id}`, t0 + RP + 0.2, 0.3, 16, 704); Fx.punch(tl, `#${id} .stage`, t0 + RP + 0.25, 1.08, 0.4);
          tl.fromTo("#fxred", { opacity: 0.4 }, { opacity: 0, duration: 0.6, immediateRender: false }, t0 + RP + 0.25);
          Fx.heart(tl, t0 + F("replay", 0, 1), D("replay") - F("replay", 0, 1), 0.42, 0.5);
        },
      });

      // ---------- 11. 2 a.m.: downstairs, the lights flicker on by themselves ----------
      add("two", {
        set: "houseIn", setOpts: HOUSE("h11"), dark: 0.9,
        cam: { keys: [{ t: 0, ...fr(700, G - 520, 0.66, 540, 1100), drift: { s: 0.03 } }] },
        captions: caps("two"),
        fx(tl, id, t0) {
          const tb = tube("h11"), on = t0 + F("two", 0, 2) - 0.1;
          tl.set(tb, { opacity: 0 }, t0);
          [0, 0.07, 0.15, 0.22, 0.36, 0.42].forEach((d, k) => { tl.set(tb, { opacity: k % 2 ? 0 : 1 }, on + d); tl.set(`#${id}-dark`, { opacity: k % 2 ? 0.9 : 0.16 }, on + d); });
          tl.set(tb, { opacity: 1 }, on + 0.5); tl.set(`#${id}-dark`, { opacity: 0.16 }, on + 0.5);
          Fx.heart(tl, on, D("two") - F("two", 0, 2), 0.45, 0.45);
        },
      });

      // ---------- 12. the switch close up: the lever going up on its own; green light beside it ----------
      add("lever", {
        set: "switchClose", setOpts: { id: "sc12", hand: false }, dark: 0.3,
        cam: { keys: [{ t: 0, ...fr(540, 1000, 1.05, 540, 960), drift: { s: 0.05 } }] },
        captions: caps("lever"),
        extra(L) { put(L.glow, `<g id="lv-g">${Krasue.glow(120, 700, 1.0)}</g>`); put(L.act, `<g opacity=".85">${[0, 1, 2, 3, 4].map((k) => `<path class="khair" d="M${40 + k * 22},380C${30 + k * 26},560 ${60 + k * 20},700 ${30 + k * 30},880" stroke="#050706" stroke-width="16" fill="none" stroke-linecap="round"/>`).join("")}</g>`); },
        fx(tl, id, t0) {
          const up = t0 + F("lever", 0, 1) + 0.2;
          tl.fromTo("#sc12-lever", { attr: { transform: "matrix(1 0 0 -1 0 2100)" } }, { attr: { transform: "matrix(1 0 0 1 0 0)" }, duration: 0.5, ease: "power2.in", immediateRender: false }, up);
          tl.fromTo("#sc12-spark", { opacity: 1 }, { opacity: 0, duration: 0.3, immediateRender: false }, up + 0.5);
          Fx.punch(tl, `#${id} .stage`, up + 0.5, 1.06, 0.3); Fx.glitch(tl, `#${id}`, up + 0.5, 0.2, 12, 705);
          tl.fromTo(`#${id}-dark`, { opacity: 0.6 }, { opacity: 0.15, duration: 0.1, immediateRender: false }, up + 0.5);
        },
      });

      // ---------- 13. the กระสือ by the switch, calling up the stairs ----------
      add("call", {
        set: "houseIn", setOpts: HOUSE("h13"), dark: 0.2,
        cam: { keys: [{ t: 0, ...fr(1000, G - 900, 0.95, 540, 980), drift: { s: 0.03 } }, { t: F("call", 0, 1) - 0.1, glide: 0.5, ...fr(1080, G - 1130, 1.6, 540, 900), drift: { s: 0.05 } }] },
        captions: caps("call", undefined, { quote: true }),
        extra(L) { put(L.act, Krasue.ghost(1080, G - 1160, 0.85, { bun: true })); put(L.glow, Krasue.glow(1080, G - 1160, 0.85)); },
        fx(tl, id, t0) { Fx.heart(tl, t0, D("call"), 0.42, 0.55); Fx.glitch(tl, `#${id}`, t0 + F("call", 0, 1), 0.2, 10, 706); },
      });

      // ---------- 14. เต้ย down the stairs, into the water, his hand on the fridge — the current ----------
      const WK = (k) => ({ t: 0.25 * k, x: 1415 - 110 * k, y: G - 630 + 90 * k });
      const SHOCK = 3.5, zW = zap("zw", HX - 40, HY + 10, HX, HY);
      add("walk", {
        set: "houseIn", setOpts: HOUSE("h14"), dark: 0.16,
        cam: { keys: [{ t: 0, ...fr(900, G - 520, 0.7, 540, 1100), drift: { s: 0.02 } }, { t: 2.0, glide: 1.2, ...fr(200, G - 420, 1.15, 540, 1100), drift: { s: 0.05 } }] },
        shake: (t) => (t > SHOCK ? 7 * Math.sin(t * 71) : 0),
        actors: [TOEY(1415, G - 630, 1.0, [{ t: 0, mode: "walk", eyes: "glow", mouth: "flat" }, { t: SHOCK - 0.3, mode: "point", eyes: "glow", mouth: "flat" }, { t: SHOCK, mode: "shocked", eyes: "wide", mouth: "scream" }],
          { flip: true, path: [...[0, 1, 2, 3, 4, 5, 6].map(WK), { t: 1.85, x: 640, y: G }, { t: SHOCK - 0.3, x: 240, y: G }, { t: D("walk"), x: 240, y: G }] })],
        captions: caps("walk"),
        extra(L) { put(L.act, zW.act); put(L.glow, zW.glow); },
        fx(tl, id, t0, L) {
          TOP(L, "h14"); Krasue.arcs(tl, "#zw", "#zwg", t0 + SHOCK, D("walk") - SHOCK, 42);
          flick(tl, tube("h14"), t0 + SHOCK, D("walk") - SHOCK, 7);
          Fx.glitch(tl, `#${id}`, t0 + SHOCK, 0.3, 18, 707); Fx.punch(tl, `#${id} .stage`, t0 + SHOCK, 1.08, 0.4);
          tl.fromTo("#flashw", { opacity: 0.6 }, { opacity: 0, duration: 0.2, immediateRender: false }, t0 + SHOCK);
        },
      });

      // ---------- 15. ฝน at the top of the stairs: "เต้ย! ปล่อยมือ!" ----------
      add("scream", {
        set: "houseIn", setOpts: HOUSE("h15"), dark: 0.2, blur: { far: 6, set: 6 },
        cam: { keys: [{ t: 0, ...fr(300, G + 1300 - 530 * 2.3, 1.0, 640, 980), drift: { x: -40, s: 0.08 } }] },
        shake: (t) => 6 * Math.sin(t * 47),
        actors: [FON(300, G + 1300, 2.3, [{ t: 0, mode: "point", eyes: "wide", mouth: "scream" }], { flip: true })],
        captions: caps("scream", undefined, { quote: true }),
        extra(L) { put(L.glow, `<g id="sc15g"><circle cx="-200" cy="${G + 200}" r="500" fill="url(#ksArc)"/></g>`); },
        fx(tl, id, t0) { flick(tl, "#sc15g", t0, D("scream"), 11, 0, 1); flick(tl, tube("h15"), t0, D("scream"), 13); Fx.punch(tl, `#${id} .stage`, t0 + 0.05, 1.08, 0.3); },
      });

      // ---------- 16. she runs down, reaching for his hand ----------
      const zR = zap("zr", HX - 40, HY + 10, HX, HY);
      add("rush", {
        set: "houseIn", setOpts: HOUSE("h16"), dark: 0.16,
        cam: { keys: [{ t: 0, ...fr(560, G - 450, 0.78, 540, 1100), drift: { x: -40, s: 0.04 } }] },
        shake: (t) => 5 * Math.sin(t * 71),
        actors: [TOEY(240, G, 1.0, [{ t: 0, mode: "shocked", eyes: "wide", mouth: "scream" }], { flip: true }),
          FON(1305, G - 540, 1.4, [{ t: 0, mode: "run", eyes: "wide", mouth: "scream" }, { t: 1.2, mode: "point", eyes: "wide", mouth: "scream" }],
            { flip: true, path: [{ t: 0, x: 1305, y: G - 540 }, { t: 0.3, x: 1195, y: G - 450 }, { t: 0.6, x: 1085, y: G - 360 }, { t: 0.9, x: 975, y: G - 270 }, { t: 1.2, x: 865, y: G - 180 }, { t: D("rush"), x: 865, y: G - 180 }] })],
        captions: caps("rush"),
        extra(L) { put(L.act, zR.act); put(L.glow, zR.glow); },
        fx(tl, id, t0, L) { TOP(L, "h16"); Krasue.arcs(tl, "#zr", "#zrg", t0, D("rush"), 43); flick(tl, tube("h16"), t0, D("rush"), 17); Fx.heart(tl, t0, D("rush"), 0.36, 0.55); },
      });

      // ---------- 17. frozen: the rule card — ใครโดนดูด อย่าจับ ----------
      add("rule", {
        set: "houseIn", setOpts: HOUSE("h17"), dark: 0.2,
        cam: { keys: [{ t: 0, ...fr(600, G - 300, 0.9, 540, 1350), drift: { s: 0.03 } }] },
        actors: [TOEY(240, G, 1.0, [{ t: 0, mode: "shocked", eyes: "wide", mouth: "scream" }], { flip: true }),
          FON(865, G - 180, 1.4, [{ t: 0, mode: "point", eyes: "wide", mouth: "scream" }], { flip: true })],
        captions: caps("rule", undefined, { quote: true }),
        ui: [{ type: "koiRule", t: 0.05, label: "กฎของลุงเปี๊ยก", rows: [ROW3], at: [F("rule", 0, 0)], top: 300 }],
        fx(tl, id, t0, L) { TOP(L, "h17"); elec(id); Fx.desat(tl, `#${id} .stage`, t0, undefined, 0.15); Fx.glitch(tl, `#${id}`, t0, 0.2, 10, 708); },
      });

      // ---------- 18–19. what to do (verbatim sources) ----------
      const zK = zap("zk", HX - 40, HY + 10, HX, HY);
      add("know1", {
        set: "houseIn", setOpts: HOUSE("h18"), dark: 0.16,
        cam: { keys: [{ t: 0, ...fr(160, G - 420, 1.35, 540, 1300), drift: { s: 0.03 } }] },
        actors: [TOEY(240, G, 1.0, [{ t: 0, mode: "shocked", eyes: "wide", mouth: "scream" }], { flip: true })],
        captions: caps("know1"),
        ui: [steps("know1", "คนโดนไฟดูด", [["notouch", "อย่าแตะตัวเขา"]], F("know1", 0, 1) - 0.1, D("know1") - 0.15),
          { type: "src", t: F("know1", 0, 2) + 0.1, end: D("know1") - 0.05, top: 640, text: "ที่มา: <em>CDC สหรัฐฯ</em> · อย่าแตะตัว เขาอาจยังติดอยู่กับไฟ ไฟจะผ่านเข้าตัวคุณ · <em>St John Ambulance</em>" }],
        extra(L) { put(L.act, zK.act); put(L.glow, zK.glow); },
        fx(tl, id, t0, L) { TOP(L, "h18"); Krasue.arcs(tl, "#zk", "#zkg", t0, D("know1"), 44); Fx.desat(tl, `#${id} .stage`, t0, undefined, 0.3); },
      });
      add("know2", {
        set: "houseIn", setOpts: HOUSE("h19"), dark: 0.16,
        cam: { keys: [{ t: 0, ...fr(940, G - 1120, 1.4, 540, 1250), drift: { s: 0.03 } }] },
        captions: caps("know2"),
        ui: [steps("know2", "ช่วยคนโดนไฟดูด", [["cutmain", "ตัดไฟก่อน"]], F("know2", 0, 1) - 0.1, D("know2") - 0.15),
          { type: "src", t: F("know2", 0, 1) + 0.3, end: D("know2") - 0.05, top: 640, text: "ที่มา: <em>กรมสนับสนุนบริการสุขภาพ</em> · สิ่งแรกที่ต้องทำ คือตัดไฟฟ้าในจุดที่เกิดเหตุก่อน" }],
        fx(tl, id, t0) { Fx.desat(tl, `#${id} .stage`, t0, undefined, 0.3); },
      });

      // ---------- 20. at the switch: a head floating beside it ----------
      add("guard", {
        set: "houseIn", setOpts: HOUSE("h20"), dark: 0.18,
        cam: { keys: [{ t: 0, ...fr(960, G - 1110, 1.5, 540, 960), drift: { s: 0.03 } }, { t: F("guard", 0, 1) - 0.1, glide: 0.4, ...fr(1020, G - 1120, 1.9, 540, 960), drift: { s: 0.05 } }] },
        captions: caps("guard"),
        extra(L) { put(L.act, Krasue.ghost(1120, G - 1140, 0.8, { id: "g20", op: 0, bun: true })); put(L.glow, `<g id="g20g" opacity="0">${Krasue.glow(1120, G - 1140, 0.8)}</g>`); },
        fx(tl, id, t0) {
          tl.fromTo(["#g20", "#g20g"], { opacity: 0 }, { opacity: 1, duration: 0.15, immediateRender: false }, t0 + F("guard", 0, 1));
          Fx.glitch(tl, `#${id}`, t0 + F("guard", 0, 1), 0.3, 16, 709); Fx.punch(tl, `#${id} .stage`, t0 + F("guard", 0, 1), 1.08, 0.4);
          tl.fromTo("#fxred", { opacity: 0.4 }, { opacity: 0, duration: 0.6, immediateRender: false }, t0 + F("guard", 0, 1));
          Fx.heart(tl, t0 + F("guard", 0, 1), D("guard") - F("guard", 0, 1), 0.4, 0.55);
        },
      });

      // ---------- 21. ฝน on the dry step with the broom; the handle knocks the lever down; the house goes dark ----------
      const B2 = F("broom", 0, 2) - 0.12, HIT = 0.55;
      split("broom", B2, {
        set: "houseIn", setOpts: HOUSE("h21"), dark: 0.16,
        cam: { keys: [{ t: 0, ...fr(980, G - 650, 1.1, 540, 900), drift: { s: 0.04 } }, { t: F("broom", 0, 1) - 0.1, glide: 0.6, ...fr(980, G - 300, 1.4, 540, 1100), drift: { s: 0.04 } }] },
        actors: [FON(975, G - 270, 1.4, [{ t: 0, mode: "broomUp", eyes: "wide", mouth: "flat" }], { flip: true })],
        captions: caps("broom").filter((c) => c.t < B2),
        extra(L) { put(L.act, broom("br21", 1010, G - 520, 880, G - 1080)); put(L.act, Krasue.ghost(1120, G - 1140, 0.8, { bun: true })); put(L.glow, Krasue.glow(1120, G - 1140, 0.8)); },
        fx(tl, id, t0, L) { TOP(L, "h21"); Fx.heart(tl, t0, B2, 0.4, 0.5); },
      }, {
        set: "switchClose", setOpts: { id: "sc21", hand: false }, dark: 0.12,
        cam: { keys: [{ t: 0, ...fr(540, 980, 1.0, 540, 960), drift: { s: 0.05 } }] },
        shake: (t) => (t > HIT && t < HIT + 0.4 ? 12 * Math.sin(t * 60) * (HIT + 0.4 - t) / 0.4 : 0),
        captions: capsFrom("broom", B2),
        extra(L) { put(L.act, `<g id="br21b">${broom("br21s", 1300, 2400, 640, 720)}</g>`); put(L.glow, `<g id="br21g">${Krasue.glow(140, 640, 1.0)}</g>`); },
        fx(tl, id, t0) {
          tl.fromTo("#br21b", { x: 220, y: 260 }, { x: 0, y: 0, duration: HIT, ease: "power3.in", immediateRender: false }, t0);
          tl.to("#br21b", { x: 30, y: 360, duration: 0.4, ease: "power2.in" }, t0 + HIT);
          tl.fromTo("#sc21-lever", { attr: { transform: "matrix(1 0 0 1 0 0)" } }, { attr: { transform: "matrix(1 0 0 -1 0 2100)" }, duration: 0.4, ease: "power2.in", immediateRender: false }, t0 + HIT);
          tl.fromTo("#sc21-spark", { opacity: 1 }, { opacity: 0, duration: 0.25, immediateRender: false }, t0 + HIT + 0.05);
          Fx.punch(tl, `#${id} .stage`, t0 + HIT + 0.35, 1.08, 0.3);
          [0, 0.1, 0.18, 0.3].forEach((d, k) => tl.set(`#${id}-dark`, { opacity: k % 2 ? 0.3 : 0.9 }, t0 + HIT + 0.45 + d));
          tl.set(`#${id}-dark`, { opacity: 0.9 }, t0 + HIT + 0.8);
          tl.to("#br21g", { opacity: 0, duration: 0.3 }, t0 + HIT + 0.8);
        },
      });

      // ---------- 22. knowledge: something that doesn't conduct; stand on something dry ----------
      add("know3", {
        set: "houseIn", setOpts: HOUSE("h22"), dark: 0.5,
        cam: { keys: [{ t: 0, ...fr(980, G - 500, 0.95, 540, 1300), drift: { s: 0.02 } }] },
        actors: [FON(975, G - 270, 1.4, [{ t: 0, mode: "broomUp", eyes: "wide", mouth: "o" }], { flip: true })],
        captions: caps("know3"),
        ui: [steps("know3", "ถ้าตัดไฟไม่ได้", [["drystick", "ไม้แห้ง ผ้าแห้ง"], ["drystand", "ยืนบนของแห้ง"]], F("know3", 0, 1) - 0.1, D("know3") - 0.15, { gap: F("know3", 0, 3) - F("know3", 0, 1) }),
          { type: "src", t: F("know3", 0, 3) + 0.3, end: D("know3") - 0.05, top: 640, text: "ที่มา: <em>การไฟฟ้าส่วนภูมิภาค</em> · ใช้สิ่งของที่ไม่เป็นสื่อไฟฟ้า เช่น ผ้าแห้ง ไม้แห้ง · <em>St John Ambulance</em> · ยืนบนของแห้งที่ไม่นำไฟ" }],
        extra(L) { lightsOff("h22"); put(L.act, broom("br22", 1010, G - 520, 880, G - 1080)); put(L.glow, `<ellipse cx="900" cy="${G - 600}" rx="500" ry="600" fill="url(#ksTube)" opacity=".5"/>`); },
        fx(tl, id, t0, L) { TOP(L, "h22"); },
      });

      // ---------- 23. lights out: the กระสือ shrieks and is gone; เต้ย drops into the water ----------
      const FALL = F("dark", 0, 2);
      add("dark", {
        set: "houseIn", setOpts: HOUSE("h23"), dark: 0.62,
        cam: { keys: [{ t: 0, ...fr(900, G - 900, 1.0, 540, 900), drift: { s: 0.03 } }, { t: FALL - 0.2, glide: 0.5, ...fr(260, G - 300, 1.1, 540, 1100), drift: { s: 0.04 } }] },
        shake: (t) => (t > F("dark", 0, 1) && t < F("dark", 0, 1) + 0.6 ? 12 * Math.sin(t * 57) : 0),
        actors: [TOEY(240, G, 1.0, [{ t: 0, mode: "point", eyes: "closed", mouth: "o" }, { t: FALL, mode: "fall", eyes: "closed", mouth: "o" }], { flip: true, moveTo: { x: 300, y: G + 260, dur: 0.4, at: FALL, ease: "power2.in" } })],
        captions: caps("dark"),
        extra(L) { lightsOff("h23"); put(L.act, Krasue.ghost(1120, G - 1140, 0.8, { id: "g23", bun: true })); put(L.glow, `<g id="g23g">${Krasue.glow(1120, G - 1140, 0.8)}</g>`); },
        fx(tl, id, t0, L) {
          TOP(L, "h23");
          tl.to("#g23", { scale: 1.5, svgOrigin: `1120 ${G - 1140}`, duration: 0.4, ease: "power2.out" }, t0 + F("dark", 0, 1));
          tl.to(["#g23", "#g23g"], { opacity: 0, duration: 0.25 }, t0 + F("dark", 0, 1) + 0.6);
          Fx.glitch(tl, `#${id}`, t0 + F("dark", 0, 1), 0.5, 20, 710);
          tl.fromTo("#fxred", { opacity: 0.5 }, { opacity: 0, duration: 0.6, immediateRender: false }, t0 + F("dark", 0, 1));
        },
      });

      // ---------- 24. top-down on the boards upstairs: she has dragged him up; he isn't breathing ----------
      add("drag", {
        set: "cprFloor", setOpts: { id: "cf24", hands: 0 }, dark: 0.22,
        cam: { keys: [{ t: 0, ...fr(540, 1500, 1.0, 540, 960), drift: { s: 0.02 } }, { t: F("drag", 0, 1) - 0.2, glide: 0.8, ...fr(540, 760, 1.6, 540, 900), drift: { s: 0.05 } }] },
        captions: caps("drag"),
        fx(tl, id, t0) { Fx.heart(tl, t0 + F("drag", 0, 1), D("drag") - F("drag", 0, 1), 0.45, 0.55); },
      });

      // ---------- 25–26. knowledge: 1669 and CPR right away; she keeps pressing… his eyes open ----------
      const pump = (tl, k, t0, dur) => { for (let t = 0; t < dur; t += 0.5) { tl.to(`#${k}-hands`, { y: 26, duration: 0.12, ease: "power2.in" }, t0 + t); tl.to(`#${k}-hands`, { y: 0, duration: 0.2, ease: "power2.out" }, t0 + t + 0.12);
        tl.to(`#${k}-chest`, { scaleY: 0.96, svgOrigin: "540 1100", duration: 0.12 }, t0 + t); tl.to(`#${k}-chest`, { scaleY: 1, svgOrigin: "540 1100", duration: 0.2 }, t0 + t + 0.12); } };
      add("know4", {
        set: "cprFloor", setOpts: { id: "cf25", hands: 0 }, dark: 0.22,
        cam: { keys: [{ t: 0, ...fr(480, 1000, 0.85, 540, 1250), drift: { s: 0.02 } }] },
        captions: caps("know4"),
        ui: [steps("know4", "ถ้าหมดสติ ไม่หายใจ", [["call1669", "โทร 1669"], ["cpr", "ปั๊มหัวใจทันที"]], F("know4", 0, 0) + 0.2, D("know4") - 0.15, { gap: F("know4", 0, 2) - F("know4", 0, 0) - 0.2 }),
          { type: "src", t: F("know4", 0, 2) + 0.3, end: D("know4") - 0.05, top: 640, text: "ที่มา: <em>การไฟฟ้าส่วนภูมิภาค</em> · หมดสติหรือหยุดหายใจ ให้ทำ CPR · <em>CDC</em> · เริ่ม CPR ทันที" }],
        fx(tl, id, t0) { tl.to("#cf25-hands", { opacity: 1, duration: 0.2 }, t0 + F("know4", 0, 2)); pump(tl, "cf25", t0 + F("know4", 0, 2) + 0.2, D("know4") - F("know4", 0, 2) - 0.2); },
      });
      add("breathe", {
        set: "cprFloor", setOpts: { id: "cf26" }, dark: 0.2,
        cam: { keys: [{ t: 0, ...fr(540, 1000, 1.05, 540, 1000), drift: { s: 0.03 } }, { t: F("breathe", 0, 2) - 0.2, glide: 0.6, ...fr(540, 720, 1.7, 540, 900), drift: { s: 0.04 } }] },
        captions: caps("breathe"),
        fx(tl, id, t0) {
          pump(tl, "cf26", t0, F("breathe", 0, 2));
          const b = t0 + F("breathe", 0, 2) + 0.2;
          tl.to("#cf26-shut", { opacity: 0, duration: 0.1 }, b); tl.to("#cf26-open", { opacity: 1, duration: 0.1 }, b);
          tl.to("#cf26-lips", { attr: { fill: "#c97a6a" }, duration: 0.8 }, b);
          tl.fromTo("#cf26-chest", { scaleY: 1 }, { scaleY: 1.04, svgOrigin: "540 1100", duration: 0.6, repeat: 3, yoyo: true, ease: "sine.inOut", immediateRender: false }, b + 0.2);
          Fx.punch(tl, `#${id} .stage`, b, 1.04, 0.3);
        },
      });

      // ---------- 27. channel signature ----------
      add("sig", {
        set: "houseIn", setOpts: HOUSE("h27"), dark: 0.45, blur: { far: 8, set: 8, fg: 10 },
        cam: { keys: [{ t: 0, ...fr(300, G + 1300 - 530 * 2.3, 1.0, 540, 1000), drift: { s: 0.02 } }, { t: SF(2), ...fr(300, G + 1300 - 530 * 2.3, 1.06, 540, 1000), drift: { s: 0.045 } }, { t: SF(3), ...fr(300, G + 1300 - 530 * 2.3, 1.14, 540, 1000), drift: { s: 0.02 } }] },
        shake: (t) => (t > SF(3) && t < SF(3) + 0.5 ? 14 * Math.sin(t * 63) * (SF(3) + 0.5 - t) / 0.5 : 0),
        actors: [FON(300, G + 1300, 2.3, [{ t: 0, mode: "idle", eyes: "closed", mouth: "o" }])],
        captions: caps("sig"),
        ui: [{ type: "sigCard", t: 0.05, title: "แสงกระสือ · เช็กลิสต์เอาตัวรอด", items: [["ไม่แตะตัวน้อง", true], ["ตัดไฟด้วยไม้แห้ง", true], ["ปั๊มหัวใจทันที", true], ["???", false]],
          show: [SF(0) + 0.05, SF(0) + 0.3, SF(0) + 0.55, SF(2)], mark: [SF(0) + 0.3, SF(0) + 0.62, SF(1) + 0.15, SF(3)], top: 440 }],
        extra(L) { lightsOff("h27"); put(L.glow, `<ellipse cx="380" cy="${G + 160}" rx="420" ry="460" fill="url(#ksTube)" opacity=".7"/>`); },
        fx(tl, id, t0) {
          Fx.desat(tl, `#${id} .stage`, t0, undefined, 0.2);
          Fx.heart(tl, t0 + SF(2), SF(3) - SF(2), 0.38, 0.45); Fx.tunnel(tl, t0 + SF(2), t0 + SF(3) + 0.35, 0.6);
          Fx.glitch(tl, `#${id}`, t0 + SF(2), 0.12, 8, 93);
          Fx.punch(tl, `#${id} .stage`, t0 + SF(3), 1.1, 0.5); Fx.glitch(tl, `#${id}`, t0 + SF(3), 0.35, 16, 94);
          tl.fromTo("#fxred", { opacity: 0.9 }, { opacity: 0, duration: 0.7, immediateRender: false }, t0 + SF(3));
          tl.fromTo("#flashw", { opacity: 0.5 }, { opacity: 0, duration: 0.12, immediateRender: false }, t0 + SF(3));
          Fx.heart(tl, t0 + SF(3) + 0.2, D("sig") - SF(3) - 0.2, 0.5, 0.5);
        },
      });

      // ---------- 28–32. 3 a.m.: knocking at the door; ป้าแช่ม's voice; ฝน answers; green light under the door ----------
      const doorShot = (k, sid, o) => ({ set: "houseIn", setOpts: HOUSE(sid), dark: o.dark ?? 0.55, captions: caps(k, undefined, o.quote ? { quote: true } : {}), ...o.more,
        extra(L) { lightsOff(sid); put(L.glow, `<g id="${sid}-under" opacity="${o.under ?? 0}"><ellipse cx="${DX + 190}" cy="${WL + 6}" rx="420" ry="60" fill="url(#ksGlow)"/><rect x="${DX + 10}" y="${WL - 8}" width="360" height="14" rx="6" fill="#bfff96" opacity=".7"/></g>`); if (o.extra) o.extra(L); } });
      add("knock", { ...doorShot("knock", "h28", {}),
        cam: { keys: [{ t: 0, ...fr(1600, G - 700, 0.9, 540, 1000), drift: { s: 0.03 } }] },
        fx(tl, id, t0, L) { TOP(L, "h28"); for (let k = 0; k < 3; k++) tl.fromTo("#h28-door", { x: 0 }, { x: 7, duration: 0.05, yoyo: true, repeat: 1, immediateRender: false }, t0 + F("knock", 0, 1) + k * 0.32); Fx.heart(tl, t0 + F("knock", 0, 1), D("knock") - F("knock", 0, 1), 0.45, 0.45); },
      });
      add("voice", { ...doorShot("voice", "h29", { quote: true }),
        cam: { keys: [{ t: 0, ...fr(1880, G - 640, 1.05, 540, 960), drift: { s: 0.06 } }] },
        fx(tl, id, t0, L) { TOP(L, "h29"); for (let k = 0; k < 2; k++) tl.fromTo("#h29-door", { x: 0 }, { x: 5, duration: 0.05, yoyo: true, repeat: 1, immediateRender: false }, t0 + 0.05 + k * 0.3); },
      });
      add("answer", { ...doorShot("answer", "h30", { quote: true, dark: 0.5, more: { blur: { far: 6, set: 6 } } }),
        cam: { keys: [{ t: 0, ...fr(975, G - 270 - 530 * 1.4, 1.75, 540, 900), drift: { s: 0.05 } }] },
        actors: [FON(975, G - 270, 1.4, [{ t: 0, mode: "idle", eyes: "closed", mouth: "o" }, { t: voEnd("answer"), mode: "idle", eyes: "normal", mouth: "smile" }])],
        extra(L) { lightsOff("h30"); put(L.glow, `<ellipse cx="900" cy="${G - 900}" rx="420" ry="460" fill="url(#ksTube)" opacity=".7"/>`); },
      });
      add("under", { ...doorShot("under", "h31", { under: 0 }),
        cam: { keys: [{ t: 0, ...fr(1890, WL - 120, 1.6, 540, 900), drift: { s: 0.04 } }] },
        fx(tl, id, t0, L) {
          TOP(L, "h31");
          tl.fromTo("#h31-under", { opacity: 0, scaleX: 0.3, svgOrigin: `${DX + 190} ${WL}` }, { opacity: 1, scaleX: 1, svgOrigin: `${DX + 190} ${WL}`, duration: 1.2, ease: "power2.out", immediateRender: false }, t0 + F("under", 0, 2) - 0.2);
          Fx.heart(tl, t0 + F("under", 0, 2), D("under") - F("under", 0, 2), 0.42, 0.55);
          Fx.glitch(tl, `#${id}`, t0 + F("under", 0, 2), 0.2, 10, 711);
        },
      });
      add("inside", { ...doorShot("inside", "h32", { quote: true, under: 1 }),
        cam: { keys: [{ t: 0, ...fr(1890, G - 700, 1.0, 540, 1000), drift: { s: 0.03 } }, { t: F("inside", 0, 1) - 0.1, glide: 2.5, ...fr(DX + 30, G - 620, 1.8, 540, 960), drift: { s: 0.04 } }] },
        fx(tl, id, t0, L) {
          TOP(L, "h32");
          tl.fromTo("#h32-under", { opacity: 0.7 }, { opacity: 1, duration: 0.5, repeat: Math.ceil(D("inside") / 0.5), yoyo: true, immediateRender: false }, t0);
          tl.fromTo("#h32-knob", { rotation: 0, svgOrigin: `${DX + 30} ${G - 620}` }, { rotation: -50, svgOrigin: `${DX + 30} ${G - 620}`, duration: 0.6, ease: "power2.inOut", immediateRender: false }, t0 + D("inside") - 1.4);
          Fx.heart(tl, t0, D("inside"), 0.4, 0.6);
        },
      });

      // ---------- 33. the choice: keep quiet / open the door ----------
      add("choice", { ...doorShot("choice", "h33", { under: 1, dark: 0.6 }),
        cam: { keys: [{ t: 0, ...fr(1880, G - 640, 1.2, 540, 1150), drift: { s: 0.03 } }] },
        captions: [],
        ui: [{ type: "choice", t: 0.05, q: "จะทำยังไง?", a: "เงียบไว้", b: "เปิดประตู", secs: 3, top: 280,
          possessed: { at: 1.0, side: "b", glitch: "เปิดประตู…", who: "…ป้าเอาแกงมาให้นะลูก" } }],
        fx(tl, id, t0, L) {
          TOP(L, "h33");
          Fx.heart(tl, t0, D("choice"), 0.38, 0.85); Fx.tunnel(tl, t0, t0 + D("choice") + 0.5, 0.75);
          Fx.glitch(tl, `#${id}`, t0 + 1.0, 0.3, 12, 68); Fx.glitch(tl, `#${id}`, t0 + D("choice") - 0.6, 0.4, 18, 69);
          tl.set("#black", { opacity: 1 }, t0 + D("choice") - 0.2);
        },
      });

      // ---------- 34. end card: the sign on the pole — the last part ----------
      add("next", {
        set: "poleSign", setOpts: { id: "sg", ep: "ตอนที่ 3 (ตอนจบ)", title: "ห้ามขาน" }, dark: 0.08,
        cam: { keys: [{ t: 0, ...fr(540, 900, 1.0, 540, 900), drift: { s: 0.03 } }] },
        fx(tl, id, t0) {
          tl.set("#black", { opacity: 0 }, t0 + 0.3);
          tl.fromTo("#sg-sign", { attr: { transform: "rotate(-9 540 900)" } }, { attr: { transform: "rotate(-2 540 900)" }, duration: 1.6, ease: "elastic.out(1,0.4)", immediateRender: false }, t0 + 0.3);
          Fx.heart(tl, t0 + 0.9, D("next") - 0.9, 0.7, 0.35);
        },
      });

      shots.forEach((sh) => { const f = sh.fx; sh.fx = (tl, id, t0, L) => { if (f) f(tl, id, t0, L); Krasue.life(tl, `#${id}`, t0, sh.dur); }; });
