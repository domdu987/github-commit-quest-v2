      // ---------- StormFX demo on ต้นตะเคียนกลางนา (lane C) ----------
      // far flash on the horizon → the leader crawls down onto the ตะเคียน → return stroke, white flash, silhouette beat →
      // bark, sparks, a limb falls, smoke off the split → current runs over the wet field to the puddles → the rain goes on
      const ST = { from: "left", rim: "#b8c8ff", rimOp: 0.85, shade: "#0a0e18", shadeOp: 0.4, cast: false, vol: false };
      const GS = { top: "#2a3048", bottom: "#0a0e14", op: 0.16 };
      const TX = 540, TY = 1360, TS = 0.56, TOP = TY - 1600 * TS;
      add("st", { set: "tkField", setOpts: { id: "st", mood: "storm", dark: 0.8, rain: 0, flash: 0, tree: { x: TX, y: TY, s: TS }, hut: { x: 1010, y: 1090, s: 0.34 }, bundX: 300 },
        dark: 0.06, light: ST, grade: GS,
        cam: { keys: [{ t: 0, ...fr(540, 1080, 0.86, 540, 960) }, { t: 7.5, glide: 7.5, ...fr(540, 1060, 0.94, 540, 960) }] },
        actors: [{ who: "ploy", x: 880, y: 1640, s: 0.72, flip: true, blinks: [9], track: [{ t: 0, mode: "idle", eyes: "worry", mouth: "frown" }, { t: 2.2, mode: "duck", eyes: "wide", mouth: "scream" }] }],
        captions: [],
        fx(tl, id, t0, L) {
          const rain = StormFX.rain(L, tl, t0, 7.5, { wind: 0.22, horizon: 980, ripples: [{ x: -200, y: 1060, w: 1500, h: 140, n: 30, r: 12, layer: "mid" }, { x: -100, y: 1500, w: 1300, h: 420, n: 26, r: 22, layer: "set" }], splash: [[852, 1642, 0.9], [912, 1646, 0.9]] });
          StormFX.wind(L, tl, t0, 7.5, { rice: 18, ribbons: [[TX + 112 * TS, TY - 360 * TS, 150, "#d8302a"], [TX + 110 * TS, TY - 420 * TS, 130, "#f2c230"], [TX + 110 * TS, TY - 470 * TS, 110, "#3aa04a"]], leaves: 7 });
          StormFX.bolt(L, tl, t0 + 0.55, { x0: 140, y0: 380, x1: 200, y1: 930, seed: 13, w: 0.35, layer: "sky", flash: 0.3, cx: 160, cy: 380, cloudR: 0.6, leader: 0.08, lit: rain });
          const b = StormFX.bolt(L, tl, t0 + 2.0, { x0: 820, y0: -120, x1: TX + 10, y1: TOP, seed: 7, w: 1.25, flash: 1, sil: 0.12, cx: 700, cy: 360, lit: rain });
          StormFX.strikeTree(L, tl, b.tR, { x: TX, y: TY, s: TS, seed: 19, side: 1, dur: 5.4 });
          StormFX.ground(L, tl, b.tR + 0.03, { x: TX, y: TY + 10, s: 0.9, to: [[170, 1480], [760, 1560], [330, 1720]] });
        } });
