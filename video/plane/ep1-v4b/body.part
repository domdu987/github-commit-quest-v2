      ]);
      // ===== 15. (you) every flight… | count the rows to the exit | front and back — calm, bright cabin; the seat-back card =====
      add("rule", { ...CAB("u1", "calm", { rows: [25, 30] }), blur: { far: 0, set: 0, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(700, 1250, 1.3, 540, 1020) }, { t: C("rule", 0, 1), ...fr(600, 1200, 1.3, 540, 1000) }, { t: D("rule"), glide: D("rule") - C("rule", 0, 1), ...fr(640, 1200, 1.36, 540, 1000) }] },
        actors: [A("kiw", KX, PF - 6, KS, [{ t: 0, mode: "sitChair", eyes: "normal", mouth: "flat" }])],
        captions: caps("rule"),
        fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "u1", t0, D("rule"));
          const seats = (dir) => `<g>${[-60, 0, 60].map((x) => `<rect x="${x - 22}" y="-30" width="44" height="70" rx="10" fill="${PL.seat}" stroke="#1f1a17" stroke-width="4"/>`).join("")}<path d="${dir > 0 ? "M-70,-62H50l-22,-20M50,-62l-22,20" : "M70,-62H-50l22,-20M-50,-62l22,20"}" stroke="#2fa864" stroke-width="10" fill="none" stroke-linecap="round" stroke-linejoin="round"/></g>`;
          IconFX.board(tl, L.light, { skin: "seatcard", title: "นับแถวไปทางออก", t: t0 + C("rule", 0, 1), dur: D("rule") - C("rule", 0, 1) + 0.01, y: 230, active: 1, done: [], at: [0.35, C("rule", 0, 2) - C("rule", 0, 1) + 0.1],
            items: [{ text: "นับไป<u>ข้างหน้า</u>", art: `<g transform="scale(1.3)">${seats(1)}</g>` }, { text: "และนับไป<u>ข้างหลัง</u>", art: `<g transform="scale(1.3)">${seats(-1)}</g>` }] }); } });
      // ===== 16. because in smoke… | the signs sink out of sight (close on the EXIT sign, smoke rolling over it) =====
      seg("sign", [
        [0, (d) => ({ ...CAB("x1", "smoke", { smokeH: 620 }, 0.2), cam: { keys: [{ t: 0, ...fr(600, 1200, 0.9, 540, 980) }, { t: d, glide: d, ...fr(560, 1200, 0.95, 540, 980) }] }, shake: sway(1),
          fx(tl, id, t0, L) { Plane.cabinLife(tl, "x1", t0, d, { smokeFrom: -100, smokeTo: 60 }); react(tl, L, "x1r", t0, d, { binX: 1210, botX: 800 }); fireLight(tl, L, id, t0, d, 0.2); } })],
        [C("sign", 0, 1), (d) => ({ ...CAB("x2", "smoke", { noMasks: true, smokeH: 620 }, 0.16), cam: { keys: [{ t: 0, ...fr(DOORX, PF - 572, 3.4, 540, 860) }] },
          fx(tl, id, t0, L) { Plane.cabinLife(tl, "x2", t0, d);
            put(L.light, `<g id="x2-sm" opacity="0">${Plane.puffMk("x2p", 540, 700, 8, "dark", 260)}</g><rect id="x2-sk" width="1080" height="1920" fill="#262026" opacity="0"/>`);
            Plane.puffs(tl, "x2p", t0, d, 8, { dx: 120, dy: 200, per: 1.6, op: 0.95 }); tl.to("#x2-sm", { opacity: 1, duration: 0.3 }, t0);
            tl.fromTo("#x2-sk", { opacity: 0.05 }, { opacity: 0.9, duration: d * 0.8, ease: "power2.in", immediateRender: false }, t0 + 0.15); } })],
      ]);
      // ===== B5 · 17. over his shoulder: his hand counts the seatbacks… (insert) | one =====
      const seatBackHand = (id, x) => { const W = [0, -10], deg = -35, k = 2.3, back = [W[0] + Math.sin(35 * Math.PI / 180) * 900, W[1] + Math.cos(35 * Math.PI / 180) * 900], M = [W[0] + (back[0] - W[0]) * 0.22, W[1] + (back[1] - W[1]) * 0.22];
        return `<g id="${id}" transform="translate(${x},0)">${handAt(W, deg, k, KSK, { fore: 900, curl: [0.55, 0.6, 0.65, 0.7], thumb: 0.4 })}<path d="${limbD(M, back, 130, 140)}" fill="#d9a43a" stroke="#1f1a17" stroke-width="5"/><path d="${limbD([M[0] + 6, M[1]], [M[0] + 30, M[1] + 30], 140, 136)}" fill="#b98a2a" opacity=".5"/></g>`; };
      seg("count", [
        [0, (d) => ({ ...CAB("k1", "smoke", { noMasks: true, smokeH: 900 }, 0.2), blur: { far: 3, set: 1.5, fg: 10 },
          cam: { keys: [{ t: 0, ...fr(560, PF - 420, 2.2, 540, 900) }, { t: d, glide: d, ...fr(380, PF - 420, 2.2, 540, 900) }] },
          actors: [A("kiw", 820, PF - 30, KS, [{ t: 0, mode: "crouchLook", eyes: "pain", mouth: "o" }], { flip: true, moveTo: { x: 520, y: PF - 30, dur: d, ease: "power1.inOut" } })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "k1", t0, d, { chase: true });
            // the over-the-shoulder insert: his hand on a seatback top in the foreground, sliding back seat by seat
            put(L.light, `<g transform="translate(0,1180)"><rect x="-40" y="0" width="1160" height="400" fill="#2d3f7c"/><path d="M-40,8H1120" stroke="#4a62a8" stroke-width="10"/><rect x="-40" y="-40" width="1160" height="60" rx="26" fill="#f4f0e6" stroke="${PL.ink}" stroke-width="5"/>${seatBackHand("k1-h", 700)}</g>`);
            tl.fromTo("#k1-h", { x: 760 }, { x: 360, duration: d, ease: "steps(3)", immediateRender: false }, t0); } })],
        [C("count", 0, 1), (d) => ({ ...CAB("k2", "smoke", { noMasks: true, smokeH: 900 }, 0.16), blur: { far: 3, set: 1, fg: 10 },
          cam: { keys: [{ t: 0, ...fr(ROW30 - 160, PF - 420, 3.0, 540, 900) }] },
          actors: [A("kiw", ROW30 + 60, PF - 30, KS, [{ t: 0, mode: "crouchLook", eyes: "wide", mouth: "o" }], { flip: true })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "k2", t0, d, { chase: true }); SU.flash(tl, L.light, t0 + 0.05, "#9dffc8", 0.3);
            put(L.glow, `<g transform="translate(${DOORX - 6},${PF - 572})"><circle r="300" fill="url(#plGlowG)" opacity=".9"/></g>`); } })],
      ]);
      // ===== 18. the door opens (low angle) | down the slide | before the fire reaches him =====
      seg("out", [
        [0, (d) => ({ ...CAB("o1", "smoke", { smokeH: 600 }, 0.14), cam: { keys: [{ t: 0, ...fr(DOORX + 40, PF - 380, 1.9, 540, 1500) }] },
          actors: [A("kiw", DOORX + 260, PF - 30, KS, [{ t: 0, mode: "crouchLook", eyes: "wide", mouth: "o" }], { flip: true })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "o1", t0, d);
            tl.fromTo("#o1-door", { x: 0, opacity: 1 }, { x: -230, opacity: 0.2, duration: 0.5, ease: "power2.out", immediateRender: false }, t0 + 0.25);
            put(L.glow, `<rect id="o1-day" x="${DOORX - 120}" y="${PF - 520}" width="240" height="500" rx="40" fill="#ffe0b0" opacity="0" filter="url(#plBlur24)"/>`); tl.fromTo("#o1-day", { opacity: 0 }, { opacity: 0.55, duration: 0.45, immediateRender: false }, t0 + 0.3); } })],
        [C("out", 0, 1), (d) => ({ ...SITE("o2", { fire: 0.9 }),
          cam: { keys: [{ t: 0, ...fr(190, 1500, 3.2, 540, 1000) }, { t: d, glide: d, ...fr(130, 1540, 3.0, 540, 1000) }] },
          actors: [A("kiw", 198, 1474, 0.15, [{ t: 0, mode: "crouch", eyes: "wide", mouth: "o" }, { t: 0.7, mode: "run", eyes: "wide", mouth: "o" }], { flip: true, path: [{ t: 0, x: 198, y: 1474 }, { t: 0.7, x: 127, y: 1570 }, { t: 1.6, x: 60, y: 1590, s: 0.17 }] })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.siteLife(tl, "o2", t0, d); } })],
        [C("out", 0, 2), (d) => ({ ...SITE("o3", { fire: 1 }), cam: { keys: [{ t: 0, ...fr(200, 1470, 2.2, 540, 1050) }, { t: d, glide: d, ...fr(170, 1480, 2.0, 540, 1050) }] },
          shake: (t) => (t < 0.5 ? { x: 14 * Math.sin(t * 61), y: 10 * Math.sin(t * 47), r: 0 } : 0),
          actors: [A("kiw", 60, 1590, 0.17, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }], { flip: true, moveTo: { x: -40, y: 1600, dur: d, ease: "none" } })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.siteLife(tl, "o3", t0, d); put(L.glow, `<g transform="translate(330,1450)">${Plane.flames("o3f", 160, 1.2)}</g>`); Plane.flicker(tl, "o3f", t0, d);
            SU.flash(tl, L.light, t0 + 0.1, "#ff8a2a", 0.6); Plane.burst(tl, L.glow, 330, 1440, t0 + 0.12, { n: 20, v: 380 }); } })],
      ]);
      // ===== 19. he made it (face readable) =====
      add("safe", { ...SITE("v1", { fire: 0.7 }), blur: { far: 4, mid: 4, set: 5, fg: 9 }, cam: { keys: [{ t: 0, ...fr(60, 1100, 2.1, 540, 820) }, { t: D("safe"), glide: D("safe"), ...fr(60, 1100, 2.25, 540, 820) }] },
        actors: [A("kiw", 60, 1640, 0.95, [{ t: 0, mode: "crouch", eyes: "closed", mouth: "o" }])],
        captions: caps("safe"),
        fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.siteLife(tl, "v1", t0, D("safe")); } });
      // ===== twist: pull out — 0.45 s near-black =====
      add("hush", { dark: 0, light: false, cam: { keys: [{ t: 0, ...fr(540, 960, 1, 540, 960) }] },
        fx(tl, id, t0, L) { put(L.light, `<rect width="1080" height="1920" fill="#030406"/>`); } });
      // ===== B6 · 20. the smoke clears (his face, close) | no front section… (the torn end) | of the plane any more (wide) =====
      const kiwCU = (key, mode, eyes, mouth, extra = {}) => (d) => ({ ...SITE(`${key}c`, { fire: 0.3, ...(extra.site || {}) }), dark: 0.08, blur: { far: 4, mid: 4, set: 5, fg: 9 },
        cam: { keys: [{ t: 0, ...fr(60, 1100, 2.1, 540, 820) }, { t: d, glide: d, ...fr(60, 1100, 2.25, 540, 820) }] },
        actors: [A("kiw", 60, 1640, 0.95, [{ t: 0, mode, eyes, mouth }], extra.flip ? { flip: true } : {})],
        fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.siteLife(tl, `${key}c`, t0, d); if (extra.haze) { put(L.light, `<rect id="${key}-hz" width="1080" height="1920" fill="#8a8a92" opacity="0"/>`); tl.fromTo(`#${key}-hz`, { opacity: 0.7 }, { opacity: 0, duration: 1.1, ease: "power1.out", immediateRender: false }, t0); } } });
      seg("twist", [
        [0, kiwCU("tw", "idle", "wide", "o", { haze: true })],
        [C("twist", 0, 1), (d, at) => ({ ...SITE("z1", { fire: 0.35 }), dark: 0.12,
          cam: { keys: [{ t: 0, ...fr(620, 1400, 1.9, 540, 1050) }, { t: C("twist", 0, 2) - at, ...fr(400, 1300, 0.85, 540, 1050) }, { t: d, glide: d - (C("twist", 0, 2) - at), ...fr(420, 1300, 0.8, 540, 1050) }] },
          actors: [A("kiw", 60, 1598, 0.16, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.siteLife(tl, "z1", t0, d); } })],
      ]);
      // ===== 21. only คิว… (close) | and an island in the middle of the sea (wide) =====
      seg("alone", [
        [0, kiwCU("al", "holdHead", "worry", "frown")],
        [C("alone", 0, 1), (d) => ({ ...SITE("y1", { fire: 0.25 }), dark: 0.1, cam: { keys: [{ t: 0, ...fr(400, 1280, 0.5, 540, 1100) }, { t: d, glide: d, ...fr(420, 1280, 0.46, 540, 1100) }] },
          actors: [A("kiw", 60, 1598, 0.16, [{ t: 0, mode: "holdHead", eyes: "worry", mouth: "frown" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.siteLife(tl, "y1", t0, d); } })],
      ]);
      // ===== 22. but across the bay… (his face, he turns) | a column of smoke rising (clear, dark against the dusk) =====
      seg("smoke2", [
        [0, kiwCU("sm", "idle", "wide", "o", { flip: true })],
        [C("smoke2", 0, 1), (d) => ({ ...SITE("m1", { fire: 0.2, plume: true, plumeX: 900 }), dark: 0.12, cam: { keys: [{ t: 0, ...fr(900, 1060, 1.6, 540, 1100) }, { t: d, glide: d, ...fr(900, 1020, 1.9, 540, 1100) }] },
          fx(tl, id, t0, L) { Plane.siteLife(tl, "m1", t0, d);
            put(L.glow, `<g>${Plane.puffMk("m1c", 880, 1130, 14, "dark", 80)}</g><circle cx="890" cy="1150" r="60" fill="#ff7a2a" opacity=".6" filter="url(#plBlur14)"/>`); Plane.puffs(tl, "m1c", t0, d + 0.5, 14, { dx: 90, dy: -700, per: 2.0, op: 0.95 }); } })],
      ]);
      // ===== 23. next: the boarding pass =====
      add("next", { dark: 0, light: false, cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960), drift: { s: 0.01 } }] },
        fx(tl, id, t0, L) { PlaneUI.next(tl, L.light, t0, D("next"), { l1: "ตอนต่อไป · EP.2", l2: "ควันอีกฝั่งอ่าว", l3: "อย่าเดินไปหามัน" }); } });
