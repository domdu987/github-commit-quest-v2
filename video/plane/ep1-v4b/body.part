            tl.fromTo("#l2-h", { y: 120 }, { y: 0, duration: 0.5, ease: "power2.out", immediateRender: false }, t0);
            tl.fromTo("#l2-wh", { opacity: 0.1 }, { opacity: 0.88, duration: d * 0.85, ease: "power1.in", immediateRender: false }, t0); } })],
      ]);
      // ===== 13. and ahead… | FIRE (big, layered, debris) — his face lit =====
      seg("front", [
        [0, (d) => ({ ...CAB("t1", "smoke", { smokeH: 900 }, 0.3), cam: { keys: [{ t: 0, ...fr(1500, 1180, 1.4, 540, 960) }] },
          fx(tl, id, t0, L) { Plane.cabinLife(tl, "t1", t0, d); put(L.light, `<rect width="1080" height="1920" fill="#2a2228" opacity=".45"/>`); } })],
        [C("front", 0, 1), (d) => ({ ...CAB("t2", "fire", { breakX: 1350, smokeH: 460 }, 0.08), cam: { keys: [{ t: 0, ...fr(1270, PF - 400, 2.6, 540, 900) }, { t: d, glide: d, ...fr(1270, PF - 400, 2.4, 540, 900) }] },
          shake: (t) => (t < 0.6 ? { x: 20 * Math.sin(t * 61) * (0.6 - t), y: 16 * Math.sin(t * 47) * (0.6 - t), r: 0 } : 0),
          actors: [A("kiw", 1180, PF - 30, KS, [{ t: 0, mode: "cough", eyes: "wide", mouth: "scream" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "t2", t0, d); put(L.glow, `<g transform="translate(1420,${PF - 10})">${Plane.flames("t2f", 420, 1.2)}</g>`); Plane.flicker(tl, "t2f", t0, d);
            fireLight(tl, L, id, t0, d, 0.5); SU.flash(tl, L.light, t0 + 0.02, "#ff8a2a", 0.7); Plane.burst(tl, L.glow, 1400, 1150, t0 + 0.04, { n: 20, v: 460 }); } })],
      ]);
      // ===== B4 · 14. the nearest exit… (EXIT through smoke, low) | is behind him (down the aisle toward the rear door) | one row =====
      seg("behind", [
        [0, (d) => ({ ...CAB("e1", "smoke", { noMasks: true, smokeH: 520 }, 0.18), cam: { keys: [{ t: 0, ...fr(DOORX, PF - 560, 2.6, 540, 820) }, { t: d, glide: d, ...fr(DOORX, PF - 560, 2.8, 540, 820) }] }, shake: sway(1),
          fx(tl, id, t0, L) { Plane.cabinLife(tl, "e1", t0, d, { chase: true }); put(L.glow, `<g transform="translate(${DOORX - 6},${PF - 572})"><circle r="260" fill="url(#plGlowG)" opacity=".7"/></g>`); } })],
        [C("behind", 0, 1), (d) => ({ ...AISLE("e2", "smoke", { exitBack: true }), cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }, { t: d, glide: d, ...fr(540, 900, 1.25, 540, 900) }] }, shake: sway(1),
          actors: [(() => { const q = AQ(0.05, 1.9); return A("kiw", q.x, q.y, q.s, [{ t: 0, mode: "cough", eyes: "pain", mouth: "o" }], { flip: true }); })()],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.aisleLife(tl, "e2", t0, d); } })],
        [C("behind", 0, 2), (d) => ({ ...CAB("e3", "smoke", { noMasks: true, smokeH: 520 }, 0.16), cam: { keys: [{ t: 0, ...fr(DOORX + 200, PF - 300, 1.5, 540, 1150) }, { t: d, glide: d, ...fr(DOORX + 200, PF - 300, 1.6, 540, 1150) }] }, shake: sway(1),
          actors: [A("kiw", KX + 20, PF - 30, KS, [{ t: 0, mode: "cough", eyes: "pain", mouth: "o" }])],
