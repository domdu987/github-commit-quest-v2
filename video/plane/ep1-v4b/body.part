      ]);
      // ===== 7. he pulls too long (face) | the fire runs along the bins toward him =====
      seg("pull", [
        [0, (d) => ({ ...CAB("p1", "smoke", { noMasks: true, smokeH: 400 }, 0.16), cam: { keys: [{ t: 0, ...fr(KX + 80, PF - 300, 2.4, 540, 900) }] }, shake: (t) => ({ x: 7 * Math.sin(t * 23), y: 0, r: 0 }),
