          fx(tl, id, t0, L) { Plane.cabinLife(tl, "p2", t0, d); put(L.glow, `<g id="p2-run" transform="translate(860,${PF - 470})">${Plane.flames("p2f", 150, 2.2)}</g>`); Plane.flicker(tl, "p2f", t0, d);
            tl.fromTo("#p2-run", { x: 100 }, { x: -260, duration: d, ease: "power1.in", immediateRender: false }, t0); fireLight(tl, L, id, t0, d, 0.45); tl.fromTo("#p2-fire", { x: 120 }, { x: -60, duration: d, ease: "power1.in", immediateRender: false }, t0);
            SU.flash(tl, L.light, t0 + 0.05, "#ff6a1a", 0.4); Plane.burst(tl, L.glow, 760, 1100, t0 + 0.1, { n: 12, v: 300 }); } })],
      ]);
      // ===== B2 · 8. the seat-pocket card (pictures) | the board: everyone out in 90 s =====
      seg("ninety", [
        [0, (d) => ({ ...CAB("n1", "smoke", { smokeH: 300, noMasks: true }, 0.1), blur: { far: 6, set: 6, fg: 9 },
          cam: { keys: [{ t: 0, ...fr(560, 1200, 1.3, 540, 1000), drift: { s: 0.01 } }] },
          fx(tl, id, t0, L) { Plane.cabinLife(tl, "n1", t0, d); fireLight(tl, L, id, t0, d, 0.22);
            put(L.light, `<g transform="translate(540,1240)"><rect x="-300" y="80" width="600" height="400" rx="26" fill="#1e2b58" stroke="#121c40" stroke-width="8"/><g id="n1-cd">${safetyCard("n1-sc")}</g><rect x="-300" y="150" width="600" height="330" rx="26" fill="#2d3f7c" stroke="#121c40" stroke-width="8"/><path d="M-280,160H280" stroke="#4a62a8" stroke-width="6"/></g>`);
            tl.fromTo("#n1-cd", { y: 160, rotation: 0, svgOrigin: "0 0" }, { y: -320, rotation: -3, svgOrigin: "0 0", duration: 0.7, ease: "back.out(1.6)", immediateRender: false }, t0 + 0.1);
            tl.fromTo("#n1-cd", { scale: 1, svgOrigin: "0 0" }, { scale: 1.08, svgOrigin: "0 0", duration: d, ease: "sine.inOut", immediateRender: false }, t0 + 0.8); } })],
        [C("ninety", 0, 1), (d, at) => ({ ...CAB("n2", "smoke", { smokeH: 300, noMasks: true }, 0.1), blur: { far: 8, set: 8, fg: 9 },
          cam: { keys: [{ t: 0, ...fr(560, 1200, 1.3, 540, 1000), drift: { s: 0.01 } }] },
          fx(tl, id, t0, L) { Plane.cabinLife(tl, "n2", t0, d); fireLight(tl, L, id, t0, d, 0.2);
            put(L.light, `<g transform="translate(540,900) scale(1.9)"><g id="n2-cd">${safetyCard("n2-sc")}</g></g>`);
            tl.fromTo("#n2-cd", { scale: 0.92, svgOrigin: "0 0" }, { scale: 1, svgOrigin: "0 0", duration: 0.3, ease: "back.out(2)", immediateRender: false }, t0);
            const t90 = t0 + C("ninety", 0, 2) - at;
            tl.fromTo("#n2-sc-90", { opacity: 0, scale: 2.2, svgOrigin: "0 80" }, { opacity: 1, scale: 1, svgOrigin: "0 80", duration: 0.3, ease: "back.out(3)", immediateRender: false }, t90);
            put(L.light, `<circle id="n2-ring" cx="${540 + 100 * 1.9}" cy="${900 + 106 * 1.9}" r="150" fill="none" stroke="${PL.red}" stroke-width="10" opacity="0"/>`);
            tl.fromTo("#n2-ring", { opacity: 1, scale: 0.6, svgOrigin: `${540 + 190} ${900 + 201}` }, { opacity: 0, scale: 1.4, svgOrigin: `${540 + 190} ${900 + 201}`, duration: 0.6, immediateRender: false }, t90 + 0.1); } })],
      ]);
      // ===== 9. but in real crashes… (down the aisle, crowded, bags) | people with bags… | nearly half (reach up to the bins) | stop to grab it (close) =====
