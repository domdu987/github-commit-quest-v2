            [0, 1, 2].forEach((k) => Plane.burst(tl, L.glow, 760 + k * 200, PF - 30, t0 + 0.1 + k * 0.3, { n: 4, v: 120 })); } })],
        [C("block", 0, 1), (d) => ({ ...AISLE("b2", "smoke"), cam: { keys: [{ t: 0, ...fr(540, 980, 1.0, 540, 960) }] }, shake: rumble(3),
          actors: [[0.26, 2.5, 6], [-0.26, 2.8, 7], [0.2, 3.4, 8], [-0.18, 4.0, 9], [0.05, 4.8, 0]].map(([X, Z, k], i) => { const q = AQ(X, Z); return pax(k, q.x, q.y, q.s, i % 2 ? "push" : "cough", { flip: X > 0 }); }),
          fx(tl, id, t0, L) { noSh(tl, id, 5); Plane.aisleLife(tl, "b2", t0, d); fireLight(tl, L, id, t0, d, 0.26, "left");
            put(L.act, [[-0.12, 1.5, 0], [0.16, 1.7, 1], [0, 1.95, 2], [-0.22, 2.2, 3]].map(([X, Z, k]) => { const q = AQ(X, Z); return heldBag(q.x, q.y, q.s * 0.9, k); }).join(""));
            SU.flash(tl, L.light, t0 + 0.06, "#ff3b2e", 0.25); dropDark(tl, id, t0 + 0.6, 0.45, 0.5); } })],
      ]);
