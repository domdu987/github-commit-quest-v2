          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "r1", t0, d); fireLight(tl, L, id, t0, d, 0.24); } })],
        [C("run", 0, 1), (d) => ({ ...CAB("r2", "smoke", { smokeH: 440 }, 0.16), cam: { keys: [{ t: 0, ...fr(KX + 160, PF - 330, 1.6, 540, 1050) }, { t: d, glide: d, ...fr(KX + 640, PF - 330, 1.6, 540, 1050) }] }, shake: sway(1.4),
          actors: [A("kiw", KX + 60, PF - 30, KS, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }], { moveTo: { x: KX + 60 + 520, y: PF - 30, dur: d + 0.2, ease: "none" } })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "r2", t0, d, { chase: true }); fireLight(tl, L, id, t0, d, 0.24); } })],
        [C("run", 0, 2), (d) => ({ ...CAB("r3", "smoke", { smokeH: 480 }, 0.18), cam: { keys: [{ t: 0, ...fr(700, 1160, 0.85, 540, 980) }, { t: d, glide: d, ...fr(760, 1160, 0.88, 540, 980) }] }, shake: sway(1.2),
          actors: [A("kiw", 900, PF - 30, KS, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }], { moveTo: { x: 1250, y: PF - 30, dur: d + 0.2, ease: "none" } })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "r3", t0, d, { chase: true }); put(L.glow, `<g transform="translate(${DOORX - 6},${PF - 572})"><circle r="220" fill="url(#plGlowG)" opacity=".8"/></g>`); } })],
      ]);
      // ===== 12. the smoke so thick… | he can't see his own hand (insert: his hand fading in smoke) =====
      const KSK = ["#e0b088", "#b88a64", "#f0c8a0"];
      seg("blind", [
        [0, (d) => ({ ...CAB("l1", "smoke", { noMasks: true, smokeH: 900 }, 0.2), cam: { keys: [{ t: 0, ...fr(1250, PF - 420, 3.6, 540, 820) }, { t: d, glide: d, ...fr(1250, PF - 420, 3.9, 540, 820) }] }, shake: sway(1.2),
          actors: [A("kiw", 1230, PF - 30, KS, [{ t: 0, mode: "cough", eyes: "pain", mouth: "o" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "l1", t0, d, { smokeFrom: -200, smokeTo: 80 }); fireLight(tl, L, id, t0, d, 0.22); } })],
        [C("blind", 0, 1), (d) => ({ ...CAB("l2", "smoke", { smokeH: 1100 }, 0.25), blur: { far: 6, set: 6, fg: 12 }, cam: { keys: [{ t: 0, ...fr(1270, PF - 420, 1.5, 540, 860) }] },
          fx(tl, id, t0, L) { Plane.cabinLife(tl, "l2", t0, d);
