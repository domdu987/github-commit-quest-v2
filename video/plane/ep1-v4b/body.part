      // ---------- รอดคนเดียว EP.1 v4b · S17 card rhythm + the owner's look ("ทำภาพให้สวย แบบที่ผมเคยบอก") ----------
      // a cut on (or just before) every card; bright readable cabin (v3 level) with orange fire light, black smoke from the ceiling,
      // glowing floor-path lights and rim light; several angles (side, down the aisle, inserts, low at the door); faces ≥ 1/3 of the
      // frame on every emotional beat; layered fire, metal debris, a cabin that reacts (bins pop, masks swing, things roll, dust falls);
      // the facts on real things (passengers with bags, the seat-pocket card with pictures, the EXIT sign). Twist echoes "ข้างหน้า".
      Rig.MODES.crouchLook = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: -72 + 8 * Math.sin(u * 3.1), faF: -8, uaB: 20, faB: -30, head: -8 });
      Rig.MODES.reachBin = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -160 + 6 * Math.sin(u * 5), faF: -12, uaB: -150 + 6 * Math.sin(u * 5 + 1), faB: -20, head: -14, torso: -3 });
      Rig.MODES.hugBag = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: 20, faF: -110, uaB: 26, faB: -100, torso: 6 + 2 * Math.sin(u * 7), head: 6 });
      const A = (who, x, y, s, track, extra = {}) => { if (extra.talk) track.talk = extra.talk; return { who, x, y, s, track, blinks: [0.7, 2.6, 4.4], ...extra }; };
      const QUO = { quote: true };
      const EMERG = { from: "right", rim: "#ffb060", rimOp: 0.85, shade: "#1a0c12", shadeOp: 0.32, cast: false, vol: false };
      const BRIGHT = { from: "right", rim: "#ffd9a0", rimOp: 0.6, shade: "#1a1430", shadeOp: 0.25, cast: false, vol: false };
      const CALM = { from: "right", rim: "#ffd9a0", rimOp: 0.5, shade: "#1a1430", shadeOp: 0.35, cast: false, vol: false };
      const DUSKL = { from: "left", rim: "#ffc890", rimOp: 0.7, shade: "#141a2a", shadeOp: 0.35, cast: false, vol: false };
      const GEMR = { top: "#ff9a5a", bottom: "#141a28", op: 0.1 }, GCAB = { top: "#fff0d0", bottom: "#2a2030", op: 0.08 }, GSEA = { top: "#ffb080", bottom: "#101828", op: 0.12 };
      const KX = ROW30 + 40, KS = 0.8;
      const sway = (amp = 1.2) => (t) => ({ x: 0, y: 0, r: amp * Math.sin(t * 1.3) });
      const rumble = (a = 6) => (t) => ({ x: a * Math.sin(t * 37), y: a * 0.8 * Math.sin(t * 29), r: 0.3 * Math.sin(t * 17) });
      const noSh = (tl, id, n = 2) => { for (let i = 0; i < n; i++) tl.set(`#${id}-a${i}-shadow`, { opacity: 0 }, 0); };
      // the cabin: side cut (no hull section below), emergency light; dark is a light touch now (the owner wants it readable)
      const CAB = (id, state, extra = {}, dark = 0.2) => ({ set: "cabinCut", setOpts: { id, state, noHull: true, ...extra }, dark: state === "calm" ? 0 : dark, light: state === "calm" ? CALM : EMERG, grade: state === "calm" ? GCAB : GEMR });
      const AISLE = (id, state, extra = {}, dark = 0.18) => ({ set: "cabinAisle", setOpts: { id, state, ...extra }, dark, light: EMERG, grade: GEMR });
      const SITE = (id, extra = {}) => ({ set: "crashSite", setOpts: { id, time: "dusk", ...extra }, dark: 0.04, light: DUSKL, grade: GSEA, blur: { far: 1.5, mid: 0.6, fg: 7 } });
      const seg = (k, segs) => segs.forEach(([at, mkSpec], i) => {
        const end = i + 1 < segs.length ? segs[i + 1][0] : D(k), dur = end - at, spec = mkSpec(dur, at);
        add(k, { captions: capsFrom(k, at, undefined, spec.capO), ...spec }); const sh = shots[shots.length - 1]; sh.start = SH[k].start + at; sh.dur = dur; });
      const C = (k, i = 0, j = 0) => Math.max(0, F(k, i, j) - 0.1);
      const STRAPX = ROW30 + PP - 120, LEGX = ROW30 + PP - 150 + 20;
      const snagStrap = (id) => `<g id="${id}"><path d="M${STRAPX - 40},${PF - 70}Q${STRAPX - 60},${PF - 140} ${LEGX + 10},${PF - 66}" stroke="#3a2a22" stroke-width="9" fill="none"/>
        <ellipse cx="${LEGX + 4}" cy="${PF - 62}" rx="18" ry="10" fill="none" stroke="#3a2a22" stroke-width="8"/></g>`;
      const flick = (tl, sel, t0, dur, lo = 0.6, hi = 1) => { const n = Math.max(1, Math.round(dur / 0.11)); for (let i = 0; i < n; i++) tl.set(sel, { opacity: i % 3 === 1 ? lo : hi - (i % 2) * 0.12 }, t0 + i * 0.11); };
      // orange fire light flickering from one side (screen blend), not a brown wash over everything
      const fireLight = (tl, L, id, t0, dur, op = 0.3, side = "right") => {
        put(L.light, `<radialGradient id="${id}-flg" cx="${side === "right" ? 1 : 0}" cy=".55" r="1"><stop offset="0" stop-color="#ff7a2a" stop-opacity="1"/><stop offset=".6" stop-color="#ff5a1a" stop-opacity=".35"/><stop offset="1" stop-color="#ff5a1a" stop-opacity="0"/></radialGradient>
          <rect id="${id}-fl" width="1080" height="1920" fill="url(#${id}-flg)" opacity="0" style="mix-blend-mode:screen"/>`); flick(tl, `#${id}-fl`, t0, dur, op * 0.45, op); };
      const dropDark = (tl, id, at, to = 0.6, d = 0.25) => tl.to(`#${id}-dark`, { opacity: to, duration: d, ease: "power2.in" }, at);
      // the cabin reacts: dust and grit falling from the ceiling, a bin door pops open, a bottle rolls along the floor
      const react = (tl, L, id, t0, d, o = {}) => { const r = mk(Math.round(t0 * 100) + 7), x0 = o.x0 ?? 300, x1 = o.x1 ?? 1500;
        let g = "";
        for (let k = 0; k < 26; k++) g += `<circle id="${id}-du${k}" cx="${f1(x0 + r() * (x1 - x0))}" cy="${PF - 640 + r() * 40}" r="${f1(1.5 + r() * 3)}" fill="#d8ccb8" opacity="0"/>`;
        if (o.bin !== false) { const bx = o.binX ?? 760; g += `<g transform="translate(${bx},${PF - 470})"><g id="${id}-bd"><rect x="-90" y="-150" width="180" height="150" rx="8" fill="#ece6da" stroke="${PL.ink}" stroke-width="4"/><rect x="-24" y="-30" width="48" height="12" rx="5" fill="#bdb3a0"/></g></g>`; }
        if (o.bottle !== false) g += `<g transform="translate(${o.botX ?? 900},${PF - 18})"><g id="${id}-bt"><rect x="-26" y="-11" width="52" height="22" rx="10" fill="#bfe4ff" opacity=".9" stroke="${PL.ink}" stroke-width="2.5"/><rect x="26" y="-6" width="10" height="12" rx="3" fill="#2f6fd0"/></g></g>`;
        put(L.glow, g);
        for (let k = 0; k < 26; k++) tl.fromTo(`#${id}-du${k}`, { y: 0, opacity: 0.9 }, { y: 520 + (k % 5) * 90, opacity: 0, duration: 1.1 + (k % 4) * 0.3, repeat: Math.ceil(d / 1.1), ease: "power1.in", immediateRender: false }, t0 + (k % 7) * 0.12);
        if (o.bin !== false) tl.fromTo(`#${id}-bd`, { scaleY: 1, svgOrigin: "0 -150" }, { scaleY: -0.32, svgOrigin: "0 -150", duration: 0.3, ease: "back.out(2.2)", immediateRender: false }, t0 + (o.binAt ?? 0.25));
        if (o.bottle !== false) tl.fromTo(`#${id}-bt`, { x: 0, rotation: 0, svgOrigin: "0 0" }, { x: -260, rotation: -720, svgOrigin: "0 0", duration: d, ease: "power1.inOut", immediateRender: false }, t0); };
      // passengers (real cast from the channel's library) — standing in the aisle, some with bags; in the side cut or down the aisle
      const PAX = ["tourist", "boss", "mother", "chai", "joe", "pin", "somsak", "fon", "kla", "samarn"];
      const pax = (i, x, y, s, mode, extra = {}) => A(PAX[i % PAX.length], x, y, s, [{ t: 0, mode, eyes: extra.eyes ?? "wide", mouth: extra.mouth ?? "o" }], extra);
      const heldBag = (x, y, s, k) => `<g transform="translate(${f1(x)},${f1(y)}) scale(${f1(s)})">${k % 2 ? Plane.bag(0.9, { strap: true }) : `<rect x="-70" y="-110" width="140" height="110" rx="14" fill="${["#c8302a", "#2f6fd0", "#2fa864", "#6a4ac8"][k % 4]}" stroke="${PL.ink}" stroke-width="5"/><path d="M-30,-110v-24h60v24" stroke="${PL.ink}" stroke-width="7" fill="none"/>`}</g>`;
      // down the aisle (one-point perspective): a person at depth Z (m), lateral X (m) → world point and rig scale
      const AQ = (X, Z) => { const p = AP(X, 0, Z); return { x: p[0], y: p[1], s: 2.54 / Z }; };
      // the seat-pocket safety card, 2.5D with pictures (stay low under the smoke · no bags (red ✗) · count the rows · 90 s)
      const safetyCard = (id, o = {}) => `<g id="${id}"><g transform="skewY(-4)"><rect x="-200" y="-280" width="400" height="560" rx="18" fill="#fdfaf2" stroke="${PL.ink}" stroke-width="6"/>
        <rect x="-200" y="-280" width="400" height="74" rx="18" fill="${PL.navy}"/><rect x="-200" y="-224" width="400" height="18" fill="${PL.navy}"/><path d="M-200,-206H200" stroke="${PL.gold}" stroke-width="6"/>
        <text x="-176" y="-232" font-family="Kanit" font-weight="900" font-size="34" fill="${PL.gold}">ฟ้าราม แอร์ · SAFETY</text>
        <g transform="translate(-100,-110)"><rect x="-86" y="-80" width="172" height="160" rx="12" fill="#eef2f6" stroke="#9aa4b0" stroke-width="3"/><rect x="-86" y="-80" width="172" height="50" fill="#5a5a66" opacity=".7"/>
          <circle cx="-30" cy="0" r="16" fill="#3a3f4c"/><path d="M-22,10Q20,6 44,30L52,58H-6Z" fill="#3a3f4c"/><path d="M-60,-55h120" stroke="#8a8a96" stroke-width="10" stroke-dasharray="20 10"/></g>
        <g transform="translate(100,-110)"><rect x="-86" y="-80" width="172" height="160" rx="12" fill="#eef2f6" stroke="#9aa4b0" stroke-width="3"/><g transform="translate(0,40)">${Plane.bag(0.75, { strap: true })}</g>
          <path d="M-56,-56L56,56M56,-56L-56,56" stroke="${PL.red}" stroke-width="16" stroke-linecap="round"/></g>
        <g transform="translate(-100,100)"><rect x="-86" y="-80" width="172" height="160" rx="12" fill="#eef2f6" stroke="#9aa4b0" stroke-width="3"/>${[-50, 0, 50].map((x, k) => `<rect x="${x - 18}" y="-20" width="36" height="56" rx="8" fill="${PL.seat}"/><text x="${x}" y="-32" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="26" fill="${PL.ink}">${k + 1}</text>`).join("")}<path d="M-70,58H60l-16,-14M60,58l-16,14" stroke="#2fa864" stroke-width="7" fill="none"/></g>
        <g transform="translate(100,100)"><rect x="-86" y="-80" width="172" height="160" rx="12" fill="#eef2f6" stroke="#9aa4b0" stroke-width="3"/><circle cx="0" cy="6" r="56" fill="#fff" stroke="${PL.ink}" stroke-width="6"/><path d="M0,6V-34M0,6L26,22" stroke="${PL.ink}" stroke-width="7" stroke-linecap="round"/><rect x="-12" y="-66" width="24" height="14" rx="4" fill="${PL.ink}"/>
          <text id="${id}-90" x="0" y="96" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="34" fill="${PL.red}" opacity="${o.show90 ? 1 : 0}">90 วินาที</text></g></g></g>`;

      // ===== B0 · 1. hook — frame 0: คิว's shocked face AND the engine burning in the window behind him; then outside: the engine =====
      seg("hook", [
        [0, (d) => ({ ...CAB("h1", "alarm", { wingFire: true, wingX: 280, noMasks: true }, 0.05), light: BRIGHT, blur: { far: 0.6, set: 0.6, fg: 9 },
          cam: { keys: [{ t: 0, ...fr(330, 1090, 3.9, 540, 800) }, { t: d, glide: d, ...fr(335, 1090, 4.15, 540, 800) }] },
          shake: rumble(4),
          actors: [A("kiw", KX, PF - 6, KS, [{ t: 0, mode: "brace", eyes: "wide", mouth: "o" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "h1", t0, d);
            put(L.glow, `<circle id="h1-wg" cx="280" cy="${PF - 330}" r="360" fill="url(#plAmb)"/><clipPath id="h1-wc"><rect x="246" y="${PF - 380}" width="68" height="100" rx="30"/></clipPath>
              <g clip-path="url(#h1-wc)"><rect x="240" y="${PF - 390}" width="80" height="120" fill="#f0a070"/><rect x="240" y="${PF - 300}" width="80" height="40" fill="#5a6a9a"/>
                <path d="M240,${PF - 318}L320,${PF - 330}L320,${PF - 318}L240,${PF - 306}Z" fill="#c8d0dc" stroke="#1f1a17" stroke-width="1.5"/><rect x="262" y="${PF - 316}" width="40" height="16" rx="7" fill="#dfe4ec" stroke="#1f1a17" stroke-width="1.5"/>
                <g transform="translate(276,${PF - 304}) scale(.32)">${Plane.flames("h1wf", 160, 1.1)}</g>${Plane.puffMk("h1ws", 300, PF - 350, 5, "dark", 16)}</g>`);
            Plane.flicker(tl, "h1wf", t0, d); Plane.puffs(tl, "h1ws", t0, d, 5, { dx: -60, dy: -60, per: 0.9, op: 0.9 }); tl.fromTo("#h1-wg", { opacity: 0.6 }, { opacity: 1, duration: 0.12, yoyo: true, repeat: 12, immediateRender: false }, t0);
            fireLight(tl, L, id, t0, d, 0.28); SU.flash(tl, L.light, t0 + 0.02, "#fff0c0", 0.35); } })],
        [C("hook", 0, 1), (d) => ({ set: "planeSky", setOpts: { id: "h2", fire: true, s: 0.5, y: 820, x: 560 }, dark: 0, light: false, grade: { top: "#ffb080", bottom: "#1a1030", op: 0.12 },
          cam: { keys: [{ t: 0, ...fr(560, 840, 3.0, 540, 860) }, { t: d, glide: d, ...fr(600, 840, 2.5, 540, 860) }] },
          shake: (t) => ({ x: 12 * Math.sin(t * 61), y: 9 * Math.sin(t * 47), r: 1.2 * Math.sin(t * 33) }),
          fx(tl, id, t0, L) { Plane.skyLife(tl, "h2", t0, d); tl.fromTo("#h2-jet-fire", { scale: 1.5, svgOrigin: "0 0" }, { scale: 2.1, svgOrigin: "0 0", duration: d, ease: "power1.out", immediateRender: false }, t0);
            put(L.glow, `<g transform="translate(600,850)">${Plane.flames("h2f", 120, 1.4)}</g>`); Plane.flicker(tl, "h2f", t0, d);
            SU.flash(tl, L.light, t0, "#fff4c0", 0.55); Plane.burst(tl, L.glow, 600, 840, t0 + 0.04, { n: 18, v: 360 }); } })],
      ]);
      // ===== 2. the command: his hand closes on the camera-bag strap =====
      add("cmd", { ...CAB("c1", "smoke", { smokeH: 260, noMasks: true }, 0.16), blur: { far: 3, set: 1.5, fg: 8 },
        cam: { keys: [{ t: 0, ...fr(STRAPX - 10, PF - 120, 3.2, 540, 1000) }, { t: D("cmd"), glide: D("cmd"), ...fr(STRAPX - 10, PF - 120, 3.5, 540, 1000) }] },
        shake: rumble(5),
        actors: [A("kiw", KX, PF - 6, KS, [{ t: 0, mode: "reachDown", eyes: "wide", mouth: "o" }])],
        captions: caps("cmd"),
        fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "c1", t0, D("cmd")); fireLight(tl, L, id, t0, D("cmd"), 0.3); SU.flash(tl, L.light, t0 + vo("cmd") + 0.02, "#ff3b2e", 0.3); } });
      // ===== 3. why: smoke rolls under the ceiling (the cabin reacts) | down the aisle: passengers in smoke | the fire | คิว coughing, EXIT behind (plant) =====
      seg("why", [
        [0, (d) => ({ ...CAB("w1", "smoke", { smokeH: 300 }, 0.16), cam: { keys: [{ t: 0, ...fr(760, 1180, 1.15, 540, 980) }, { t: d, glide: d, ...fr(640, 1180, 1.22, 540, 980) }] }, shake: rumble(3),
          actors: [A("kiw", KX, PF - 6, KS, [{ t: 0, mode: "brace", eyes: "wide", mouth: "o" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "w1", t0, d, { chase: true, smokeFrom: -200, smokeTo: 20 }); react(tl, L, "w1r", t0, d, { binX: 990, botX: 1100 }); fireLight(tl, L, id, t0, d, 0.26); } })],
        [C("why", 0, 1), (d) => ({ ...AISLE("w2", "smoke"), cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }, { t: d, glide: d, ...fr(540, 940, 1.08, 540, 960) }] }, shake: sway(1),
          actors: [[-0.28, 1.7, 0], [0.3, 2.2, 3], [-0.22, 2.9, 6], [0.24, 3.7, 1], [-0.05, 4.8, 4]].map(([X, Z, k], i) => { const q = AQ(X, Z); return pax(k, q.x, q.y, q.s, i % 2 ? "cough" : "holdHead", { flip: X > 0 }); }),
          fx(tl, id, t0, L) { noSh(tl, id, 5); Plane.aisleLife(tl, "w2", t0, d); fireLight(tl, L, id, t0, d, 0.24, "left"); } })],
        [C("why", 0, 2), (d) => ({ ...CAB("w3", "fire", { breakX: 900, smokeH: 360 }, 0.12), cam: { keys: [{ t: 0, ...fr(1060, 1200, 1.6, 540, 960) }, { t: d, glide: d, ...fr(1080, 1200, 1.75, 540, 960) }] }, shake: rumble(4),
          fx(tl, id, t0, L) { Plane.cabinLife(tl, "w3", t0, d); put(L.glow, `<g transform="translate(1060,${PF - 10})">${Plane.flames("w3f", 340, 1.3)}</g>`); Plane.flicker(tl, "w3f", t0, d); fireLight(tl, L, id, t0, d, 0.4); Plane.burst(tl, L.glow, 980, 1250, t0 + 0.15, { n: 10, v: 300 }); } })],
        [C("why", 0, 3), (d) => ({ ...CAB("w4", "smoke", { noMasks: true, smokeH: 520 }, 0.2), blur: { far: 2, set: 0.8, fg: 8 },
          cam: { keys: [{ t: 0, ...fr(300, PF - 500, 2.2, 540, 900) }, { t: d, glide: d, ...fr(300, PF - 500, 2.35, 540, 900) }] }, shake: sway(1),
          actors: [A("kiw", KX + 20, PF - 30, KS, [{ t: 0, mode: "cough", eyes: "pain", mouth: "o" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "w4", t0, d, { smokeFrom: 0, smokeTo: 120 }); dropDark(tl, id, t0 + 0.3, 0.24, 0.6); } })],
      ]);
      // ===== B1 · 4. the first thing คิว grabs | the camera bag =====
      seg("grab", [
        [0, (d) => ({ ...CAB("g1", "smoke", { smokeH: 360, noMasks: true }, 0.16), cam: { keys: [{ t: 0, ...fr(KX + 40, PF - 380, 3.4, 540, 900) }, { t: d, glide: d, ...fr(KX + 40, PF - 360, 3.0, 540, 900) }] }, shake: sway(1),
          actors: [A("kiw", KX, PF - 6, KS, [{ t: 0, mode: "sitDazed", eyes: "worry", mouth: "o" }, { t: 0.5, mode: "reachDown", eyes: "worry", mouth: "o" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "g1", t0, d); fireLight(tl, L, id, t0, d, 0.26); } })],
        [C("grab", 0, 1), (d) => ({ ...CAB("g2", "smoke", { smokeH: 360, noMasks: true }, 0.1), blur: { far: 3, set: 1.5, fg: 9 },
          cam: { keys: [{ t: 0, ...fr(STRAPX, PF - 60, 3.6, 540, 1080) }, { t: d, glide: d, ...fr(STRAPX, PF - 60, 3.9, 540, 1080) }] },
          actors: [A("kiw", KX, PF - 6, KS, [{ t: 0, mode: "reachDown", eyes: "worry", mouth: "o" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "g2", t0, d); put(L.glow, `<circle cx="${STRAPX}" cy="${PF - 50}" r="140" fill="url(#plAmb)" opacity=".6"/>`); fireLight(tl, L, id, t0, d, 0.24); } })],
      ]);
      // ===== 5. คิว: "กล้องผม! งานทั้งปีอยู่ในนี้!" — face big =====
      seg("q", [
        [0, (d) => ({ ...CAB("q1", "smoke", { smokeH: 360, noMasks: true }, 0.12), blur: { far: 2, set: 1, fg: 9 },
          cam: { keys: [{ t: 0, ...fr(KX + 110, PF - 400, 4.4, 540, 760) }] }, shake: rumble(3), capO: QUO,
          actors: [A("kiw", KX, PF - 6, KS, [{ t: 0, mode: "reachDown", eyes: "worry", mouth: "o" }], { talk: [[vo("q", 0), voEnd("q", 0), "o"]] })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "q1", t0, d); fireLight(tl, L, id, t0, d, 0.3); } })],
        [C("q", 0, 1), (d, at) => ({ ...CAB("q2", "smoke", { smokeH: 400 }, 0.16), cam: { keys: [{ t: 0, ...fr(KX + 120, PF - 260, 2.0, 540, 1000) }, { t: d, glide: d, ...fr(KX + 120, PF - 260, 2.15, 540, 1000) }] }, shake: sway(1.2), capO: QUO,
          actors: [A("kiw", KX, PF - 6, KS, [{ t: 0, mode: "tug", eyes: "worry", mouth: "o" }], { talk: [[0, voEnd("q", 0) - at, "o"]] })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "q2", t0, d); react(tl, L, "q2r", t0, d, { binX: 520, binAt: 0.4, bottle: false }); fireLight(tl, L, id, t0, d, 0.26); } })],
      ]);
      // ===== 6. อย่า (face, red) | the strap… | caught round the seat leg (insert) =====
      seg("snag", [
        [0, (d) => ({ ...CAB("sn1", "smoke", { smokeH: 360, noMasks: true }, 0.22), blur: { far: 3, set: 2, fg: 9 },
          cam: { keys: [{ t: 0, ...fr(KX + 110, PF - 400, 4.8, 540, 760) }] },
          actors: [A("kiw", KX, PF - 6, KS, [{ t: 0, mode: "reachDown", eyes: "wide", mouth: "o" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); SU.flash(tl, L.light, t0 + 0.06, "#ff3b2e", 0.4); } })],
        [C("snag", 0, 1), (d) => ({ ...CAB("sn2", "smoke", { smokeH: 360 }, 0.14), blur: { far: 3, set: 1.5, fg: 9 },
