      seg("half", [
        [0, (d) => ({ ...AISLE("f1", "smoke"), cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }, { t: d, glide: d, ...fr(540, 950, 1.06, 540, 960) }] }, shake: sway(1),
          actors: [[0.3, 1.6, 0], [-0.3, 2.0, 1], [0.22, 2.6, 2], [-0.24, 3.2, 3], [0.18, 4.0, 4], [-0.12, 5.0, 5]].map(([X, Z, k], i) => { const q = AQ(X, Z); return pax(k, q.x, q.y, q.s, i % 3 === 0 ? "reachBin" : "hugBag", { flip: X > 0 }); }),
          fx(tl, id, t0, L) { noSh(tl, id, 6); Plane.aisleLife(tl, "f1", t0, d); fireLight(tl, L, id, t0, d, 0.22, "left");
            put(L.act, [[0.22, 2.6, 2], [-0.24, 3.2, 3], [-0.3, 2.0, 1]].map(([X, Z, k]) => { const q = AQ(X, Z); return heldBag(q.x + (X > 0 ? -60 : 60) * q.s, q.y - 300 * q.s, q.s * 0.9, k); }).join("")); } })],
        [C("half", 0, 1), (d) => ({ ...CAB("f2", "smoke", { noMasks: true, smokeH: 300 }, 0.14), cam: { keys: [{ t: 0, ...fr(980, 1180, 1.6, 540, 1000) }, { t: d, glide: d, ...fr(1000, 1180, 1.7, 540, 1000) }] },
          actors: [pax(0, 820, PF - 30, KS, "hugBag"), pax(2, 990, PF - 30, KS, "hugBag", { flip: true }), pax(4, 1160, PF - 30, KS, "cough")],
          fx(tl, id, t0, L) { noSh(tl, id, 3); Plane.cabinLife(tl, "f2", t0, d); put(L.act, heldBag(830, PF - 330, 0.75, 1) + heldBag(980, PF - 330, 0.75, 2)); fireLight(tl, L, id, t0, d, 0.24); } })],
        [C("half", 0, 2), (d) => ({ ...CAB("f3", "smoke", { noMasks: true, smokeH: 300 }, 0.14), cam: { keys: [{ t: 0, ...fr(1000, 1160, 1.15, 540, 960) }] },
          actors: [[640, 1, 0], [780, 0, 1], [920, 1, 2], [1060, 0, 3], [1200, 0, 4], [1340, 1, 5], [1480, 0, 6]].map(([x, up, k]) => pax(k, x, PF - 30, KS, up ? "reachBin" : "cough", { flip: k % 3 === 2 && !up })),
          fx(tl, id, t0, L) { noSh(tl, id, 7); Plane.cabinLife(tl, "f3", t0, d); fireLight(tl, L, id, t0, d, 0.24);
            binRow(L, [[640, "a"], [920, "b"], [1340, "c"]]); ["a", "b", "c"].forEach((k, i) => tl.fromTo(`#bn${k}`, { scaleY: 1, svgOrigin: "0 -150" }, { scaleY: -0.32, svgOrigin: "0 -150", duration: 0.3, ease: "back.out(2.2)", immediateRender: false }, t0 + 0.08 + i * 0.1)); } })],
        [C("half", 0, 3), (d) => ({ ...CAB("f4", "smoke", { noMasks: true, smokeH: 300 }, 0.12), blur: { far: 3, set: 1, fg: 9 }, cam: { keys: [{ t: 0, ...fr(930, PF - 600, 2.4, 540, 820) }, { t: d, glide: d, ...fr(930, PF - 580, 2.6, 540, 820) }] },
          actors: [pax(1, 920, PF - 30, KS, "reachBin")],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "f4", t0, d); fireLight(tl, L, id, t0, d, 0.26); put(L.glow, `<g id="f4-bag">${heldBag(985, PF - 540, 0.8, 1)}</g>`); tl.fromTo("#f4-bag", { y: -40 }, { y: 50, duration: d, ease: "power2.in", immediateRender: false }, t0); } })],
      ]);
      // ===== 10. and those bags… | block the aisle (down the aisle, jammed) =====
      seg("block", [
        [0, (d) => ({ ...CAB("b1", "smoke", { smokeH: 320 }, 0.12), blur: { far: 3, set: 1, fg: 9 }, cam: { keys: [{ t: 0, ...fr(900, PF - 80, 2.3, 540, 1080) }, { t: d, glide: d, ...fr(1000, PF - 80, 2.4, 540, 1080) }] },
