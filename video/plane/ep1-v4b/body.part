          actors: [A("kiw", KX, PF - 6, KS, [{ t: 0, mode: "tug", eyes: "worry", mouth: "o" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "sn2", t0, d); put(L.glow, snagStrap("sn2-st")); fireLight(tl, L, id, t0, d, 0.24); } })],
        [C("snag", 0, 2), (d) => ({ ...CAB("sn3", "smoke", { smokeH: 360 }, 0.12), blur: { far: 3, set: 1.5, fg: 9 },
