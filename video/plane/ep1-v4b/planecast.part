      // ---------- รอดคนเดียว: the cast (rig v2) ----------
      //   kiw     คิว 24, freelance photographer: messy fringe, a mustard jacket over a white tee, the camera-bag strap across the chest,
      //           white over-ear headphones round the neck (kiwPhones: on his ears), jeans, white sneakers · kiwVest (orange life vest)
      //   fa      the flight attendant, 30: hair in a low bun, ฟ้าราม navy uniform with gold buttons, a yellow neck scarf, a navy pencil skirt
      //   rescuer the rescue crewman, 40: orange flight suit, white helmet with visor, radio on the chest
      // poses: nap (sitChair, head back, arms folded) · phonesOn (sitChair, both hands at the ears) · reachDown (sitChair, leaning
      //   forward, the front arm down to the floor ahead) · cough (standing, bent, the front hand at the mouth) · wave2 (both arms up,
      //   waving) · pointBack (standing, the back arm pointing behind her, palm open) · sitDazed (sitChair, slumped) · crouchLook
      (function () {
        const C = Rig.CAST, LN = "#3a2622", ln = (w = 2.6) => `stroke="${LN}" stroke-width="${w}" stroke-linejoin="round" stroke-linecap="round"`;
        const messy = (h) => `<path d="M-50,-548C-58,-600 -30,-628 4,-628C36,-628 60,-604 52,-548Q50,-566 42,-574Q36,-560 24,-566Q20,-582 6,-580Q-2,-566 -16,-572Q-22,-586 -34,-578Q-40,-566 -50,-548Z" fill="${h.c}" ${ln()}/>
          <path d="M-36,-610Q-8,-628 26,-616M-44,-590Q-20,-606 8,-600" stroke="${h.sh}" stroke-width="5" fill="none" stroke-linecap="round" opacity=".55"/>`;
        const phones = (on) => on ? `<path d="M-56,-552C-60,-640 60,-640 56,-552" stroke="#f4f4f0" stroke-width="10" fill="none"/><path d="M-56,-552C-60,-640 60,-640 56,-552" stroke="${LN}" stroke-width="2" fill="none" opacity=".5"/>
            <rect x="-66" y="-570" width="20" height="40" rx="9" fill="#f4f4f0" ${ln(2.2)}/><rect x="46" y="-570" width="20" height="40" rx="9" fill="#f4f4f0" ${ln(2.2)}/><circle cx="-56" cy="-550" r="4" fill="#3ad0ff"/>`
          : "";
        const neckPhones = `<path d="M-40,-482Q0,-452 40,-482" stroke="#f4f4f0" stroke-width="9" fill="none"/><rect x="-52" y="-494" width="18" height="30" rx="8" fill="#f4f4f0" ${ln(2)}/><rect x="34" y="-494" width="18" height="30" rx="8" fill="#f4f4f0" ${ln(2)}/>`;
        const kiwPrint = `<path d="M-14,-490L-8,-400H8L14,-490Q0,-480 -14,-490Z" fill="#f6f4ee"/><path d="M-6,-470q6,6 12,0" stroke="#3a8ad8" stroke-width="3" fill="none"/>
          <path d="M-46,-480L44,-260" stroke="#3a2a22" stroke-width="12"/><path d="M-46,-480L44,-260" stroke="#6a4a3a" stroke-width="3" opacity=".6"/>
          <rect x="22" y="-300" width="16" height="22" rx="3" fill="#c8a050" ${ln(1.6)}/><path d="M-50,-430v120M48,-430v120" stroke="#b98a2a" stroke-width="3" opacity=".6"/>`;
        const kiwV2 = { skin: "#e0b088", iris: "#2a1a12", blush: 0.6, headScale: 1.16, w: 1.02,
          hair: { c: "#1c1410", s: "#08060a", sh: "#6a5446", front: (x) => messy(x.hair) },
          top: { kind: "coat", c: "#d9a43a", sleeve: "long" }, print: kiwPrint,
          bottom: { kind: "jeans", c: "#3b4a63" }, feet: { kind: "sneaker", c: "#f2f0ea", sole: "#3a3530", lace: "#8a8e94" } };
        C.kiw = { v2: { ...kiwV2, extra: neckPhones } };
        C.kiwHidden = { v2: { ...kiwV2, extra: neckPhones + `<path d="M-54,-262H54L50,-226H-50Z" fill="#ff6a14" ${ln(2.2)}/><path d="M-50,-246H50" stroke="#fff4d0" stroke-width="5"/>` } };
        C.kiwPhones = { v2: { ...kiwV2, faceTop: phones(true) } };
        C.kiwVest = { v2: { ...kiwV2, extra: `<path d="M-50,-486L-58,-300H-8L-14,-480ZM50,-486L58,-300H8L14,-480Z" fill="#ff6a14" ${ln(2.4)}/><path d="M-54,-380h40M14,-380h40" stroke="#fff4d0" stroke-width="7"/>` } };
        const bun = (h) => `<path d="M-50,-546C-54,-604 -24,-624 2,-624C30,-624 56,-604 50,-546Q44,-588 2,-592Q-40,-588 -50,-546Z" fill="${h.c}" ${ln()}/><path d="M-20,-614Q6,-622 30,-610" stroke="${h.sh}" stroke-width="5" fill="none" opacity=".5"/>`;
        C.fa = { v2: { skin: "#ebc19c", iris: "#3a2016", lash: true, blush: 0.7, lip: "#c8424a", w: 0.96, headScale: 1.1,
          hair: { c: "#1a1214", s: "#0a0608", sh: "#6a4a56", front: (x) => bun(x.hair), back: () => `<circle cx="0" cy="-596" r="30" fill="#1a1214" ${ln()}/><path d="M-20,-604q20,-14 40,0" stroke="#6a4a56" stroke-width="4" fill="none"/>` },
          top: { kind: "coat", c: "#1d2c5e", sleeve: "long" },
          print: `<path d="M-26,-490Q0,-456 26,-490L18,-470Q0,-448 -18,-470Z" fill="#f4c430" ${ln(2)}/><path d="M0,-466l-14,34l14,-8l14,8z" fill="#f4c430" ${ln(2)}/>
            ${[-430, -380, -330].map((y) => `<circle cx="-12" cy="${y}" r="5" fill="#f4c430" ${ln(1.4)}/>`).join("")}<path d="M18,-440h30" stroke="#f4c430" stroke-width="5"/><rect x="18" y="-420" width="30" height="12" rx="3" fill="#fff" ${ln(1.4)}/>`,
          bottom: { kind: "sarong", c: "#1d2c5e", band: "#1d2c5e" }, feet: { kind: "boot", c: "#121418" } } };
        C.rescuer = { v2: { skin: "#c88a5a", iris: "#2a1a12", blush: 0.4, headScale: 1.14, w: 1.08, limb: 1.04,
          hair: { c: "#1a1410", s: "#000", sh: "#4a3a30", front: () => "" },
          top: { kind: "coat", c: "#f26a1a", sleeve: "long" },
          print: `<rect x="-30" y="-440" width="34" height="50" rx="6" fill="#2a2e38" ${ln(2)}/><path d="M-20,-440v-24" stroke="#2a2e38" stroke-width="4"/><path d="M-60,-350H60" stroke="#e8eef4" stroke-width="12"/><path d="M-60,-350H60" stroke="#b8c4d0" stroke-width="3"/>`,
          faceTop: `<path d="M-58,-560C-64,-640 64,-640 58,-560Z" fill="#f4f4f0" ${ln(2.6)}/><path d="M-50,-600Q0,-628 50,-600" stroke="#fff" stroke-width="6" fill="none"/><path d="M-60,-560H60" stroke="#c8302a" stroke-width="7"/><rect x="-30" y="-640" width="60" height="16" rx="5" fill="#2a2e38"/>`,
          bottom: { kind: "trousers", c: "#e8601a" }, feet: { kind: "boot", c: "#2a221c" } } };
        const M = Rig.MODES;
        M.nap = (u, o) => ({ ...M.sitChair(u, o), torso: -9 + 1.2 * Math.sin(u * 1.4), head: -12 + 1.5 * Math.sin(u * 1.4), uaF: -20, faF: -96, uaB: -14, faB: -92 });
        M.phonesOn = (u, o) => ({ ...M.sitChair(u, o), torso: -6, head: -4 + 2 * Math.sin(u * 2), uaF: -150, faF: -110, uaB: -140, faB: -112 });
        M.reachDown = (u, o) => { const j = Math.sin(u * 9) * 3; return { ...M.sitChair(u, o), torso: 24 + j, head: 6, uaF: 34 + j, faF: -58, uaB: 10, faB: -40 }; };
        M.tug = (u, o) => { const j = Math.sin(u * 14) * 9; return { ...M.sitChair(u, o), torso: 16 - j * 0.6, head: 6, uaF: 10 - j, faF: -20 - j, uaB: 4 - j, faB: -24 }; };
        M.cough = (u, o) => { const j = Math.abs(Math.sin(u * 8)) * 6; return { ...M.idle(u, o), torso: 16 + j, head: 14 + j, uaF: -40, faF: -120, uaB: 18, faB: -20 }; };
        M.wave2 = (u, o) => { const j = Math.sin(u * 10) * 22; return { ...M.idle(u, o), torso: -4, head: -10, uaF: -160 + j, faF: -20, uaB: 160 - j, faB: 20, bodyY: -Math.abs(Math.sin(u * 5)) * 10 }; };
        M.pointBack = (u, o) => ({ ...M.idle(u, o), torso: -3, head: -10, uaF: -20, faF: -30, uaB: 96 + 2 * Math.sin(u * 3), faB: 6 });
        M.sitDazed = (u, o) => ({ ...M.sitChair(u, o), torso: 10 + 2 * Math.sin(u * 2), head: 14 + 3 * Math.sin(u * 1.3), uaF: -10, faF: -30, uaB: 8, faB: -20 });
        M.radio = (u, o) => ({ ...M.idle(u, o), torso: -2, head: -4, uaF: -70, faF: -140, uaB: 150 + 10 * Math.sin(u * 8), faB: 20 });
      })();
