        [C("half", 0, 1), (d) => ({ ...CAB("f2", "smoke", { noMasks: true, smokeH: 300 }, 0.14), cam: { keys: [{ t: 0, ...fr(990, PF - 270, 2.0, 540, 1100) }, { t: d, glide: d, ...fr(1000, PF - 270, 2.1, 540, 1100) }] },
