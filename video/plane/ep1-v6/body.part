          if (spec.fgd !== false) fgDepth(L, spec.fgd || "seat"); } }; };
      const SMOKE_KEYS = [[0, PF - 880], [8, PF - 800], [20, PF - 720], [30, PF - 650], [37, PF - 520], [45, PF - 470], [50, PF - 420], [53, PF - 200], [57, PF - 140]];
      const smokeAt = (t) => { const K = SMOKE_KEYS; if (t <= K[0][0]) return K[0][1]; for (let i = 1; i < K.length; i++) if (t <= K[i][0]) { const [a, ya] = K[i - 1], [b, yb] = K[i]; return ya + (yb - ya) * (t - a) / (b - a); } return K[K.length - 1][1]; };
      let smN = 0;
      const smokeLayer = (tl, L, t0, d, o = {}) => { const id = `sl${smN++}`, y1 = o.y1 ?? smokeAt(t0), y2 = o.y2 ?? smokeAt(t0 + d), r = mk(31 + smN * 7);
        let g = `<rect x="-1400" y="${o.top ?? PF - 1300}" width="4000" height="${y1 - (o.top ?? PF - 1300) - 90}" fill="#141214"/>`;
        for (let k = 0; k < 34; k++) { const x = -1300 + k * 115 + r() * 60, rr = 120 + r() * 110, yy = y1 - 60 - r() * 120;
          g += `<g class="smk" data-d="${f1((r() - 0.5) * 50)}"><ellipse cx="${f1(x)}" cy="${f1(yy)}" rx="${f1(rr)}" ry="${f1(rr * 0.62)}" fill="#1c1a1c"/><ellipse cx="${f1(x + 10)}" cy="${f1(yy + rr * 0.42)}" rx="${f1(rr * 0.8)}" ry="${f1(rr * 0.2)}" fill="#ff7a2a" opacity="${f1(0.12 + r() * 0.16)}"/></g>`; }
