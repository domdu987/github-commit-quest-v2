        [C("pull", 0, 1), (d) => ({ set: "galley", setOpts: { id: "p2" }, dark: 0.1, light: EMERG, grade: GEMR, blur: { far: 1, set: 0.6, fg: 8 },
          cam: { keys: [{ t: 0, ...fr(640, PF - 380, 1.15, 540, 1060) }, { t: d, glide: d, ...fr(760, PF - 380, 1.25, 540, 1060) }] }, shake: rumble(4),
          fx(tl, id, t0, L) { smokeCeiling(L, { y1: PF - 520 }); fireFX(tl, L, id, t0, d, { x: 120, y: PF - 10, h: 480, w: 1.5, ex0: 0, ex1: 900, ey0: PF - 700, ey1: PF });
            put(L.glow, `<g id="p2-run">${Plane.flames("p2r", 200, 2.4).replace(/^/, "")}</g>`.replace('<g id="p2-run">', `<g transform="translate(300,${PF - 430})"><g id="p2-run">`) + "</g>"); Plane.flicker(tl, "p2r", t0, d);
            tl.fromTo("#p2-run", { x: 0 }, { x: 520, duration: d, ease: "power1.in", immediateRender: false }, t0);
            tl.fromTo("#p2-cart", { x: 0, rotation: 0, svgOrigin: "0 0" }, { x: 60, rotation: 4, svgOrigin: "0 0", duration: 0.5, ease: "back.out(2)", immediateRender: false }, t0 + 0.2);
            tl.fromTo("#p2-cur", { skewX: 0, svgOrigin: `1490 ${PF - 700}` }, { skewX: -6, svgOrigin: `1490 ${PF - 700}`, duration: 0.4, yoyo: true, repeat: Math.ceil(d / 0.4), ease: "sine.inOut", immediateRender: false }, t0);
            fireLight(tl, L, id, t0, d, 0.45, "left"); SU.flash(tl, L.light, t0 + 0.05, "#ff6a1a", 0.4); } })],
      ]);
      // ===== B2 · 8. the seat-pocket card (pictures) | the board: everyone out in 90 s =====
      seg("ninety", [
        [0, (d) => ({ ...CAB("n1", "smoke", { smokeH: 300, noMasks: true }, 0.1), blur: { far: 6, set: 6, fg: 9 },
          fgd: false, cam: { keys: [{ t: 0, ...fr(560, 1200, 1.3, 540, 1000), drift: { s: 0.01 } }] },
          fx(tl, id, t0, L) { Plane.cabinLife(tl, "n1", t0, d); fireLight(tl, L, id, t0, d, 0.22);
            const grip = { fore: 900, curl: [0.78, 0.82, 0.86, 0.9], thumb: 0.5 };
            put(L.light, `<g transform="translate(540,1240)"><rect x="-300" y="80" width="600" height="400" rx="26" fill="#1e2b58" stroke="#121c40" stroke-width="8"/><g id="n1-cd">${safetyCard("n1-sc")}</g><rect x="-300" y="150" width="600" height="330" rx="26" fill="#2d3f7c" stroke="#121c40" stroke-width="8"/><path d="M-280,160H280" stroke="#4a62a8" stroke-width="6"/>
              <g id="n1-hd">${handAt([120, -236], -16, 1.25, KSK, grip)}</g></g>`);
            // คิว's hand comes in, pinches the top edge in the pocket, and yanks the card out (fast, with a little overshoot and tilt); the gloss runs across as it tilts to the light
            tl.fromTo("#n1-hd", { x: 260, y: 900 }, { x: 0, y: 160, duration: 0.28, ease: "power3.out", immediateRender: false }, t0);
            tl.fromTo("#n1-cd", { y: 160, rotation: 0, svgOrigin: "0 0" }, { y: -330, rotation: -4, svgOrigin: "0 0", duration: 0.42, ease: "back.out(1.5)", immediateRender: false }, t0 + 0.3);
            tl.fromTo("#n1-hd", { y: 160, rotation: 0, svgOrigin: "0 0" }, { y: -330, rotation: -4, svgOrigin: "0 0", duration: 0.42, ease: "back.out(1.5)", immediateRender: false }, t0 + 0.3);
            tl.to(["#n1-cd", "#n1-hd"], { y: -318, rotation: -2.5, svgOrigin: "0 0", duration: 0.5, yoyo: true, repeat: Math.ceil(d / 0.5), ease: "sine.inOut", immediateRender: false }, t0 + 0.72);
            cardLive(tl, "n1-sc", t0, d, { popIn: t0 + 0.42, gloss: t0 + 0.5 }); } })],
        [C("ninety", 0, 1), (d, at) => ({ ...CAB("n2", "smoke", { smokeH: 300, noMasks: true }, 0.1), blur: { far: 8, set: 8, fg: 9 },
