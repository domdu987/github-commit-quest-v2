        <text x="-176" y="-232" font-family="Kanit" font-weight="900" font-size="34" fill="${PL.gold}">ฟ้าราม แอร์ · SAFETY</text>
        ${P(0, -100, -110, `<path d="M-80,66H80" stroke="#9aa4b0" stroke-width="4"/><g id="${id}-sm"><path d="M-110,-80H110V-44Q86,-30 62,-42T14,-40T-34,-36T-82,-42T-110,-38Z" fill="#4e4e5a"/><path d="M-110,-58Q-70,-48 -40,-56T20,-54T110,-58" stroke="#6e6e7c" stroke-width="6" fill="none"/></g>${man0}${man1}
