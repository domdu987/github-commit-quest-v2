      const binRow = (L, ids) => put(L.set, ids.map(([x, k]) => `<g transform="translate(${x},${PF - 470})"><rect x="-90" y="-150" width="180" height="150" fill="#3a332a"/><rect x="-80" y="-60" width="70" height="56" rx="8" fill="#2f6fd0" stroke="${PL.ink}" stroke-width="3"/>
        <rect x="0" y="-74" width="78" height="70" rx="8" fill="#c8302a" stroke="${PL.ink}" stroke-width="3"/><path d="M-70,-110Q-20,-130 30,-108Q60,-96 78,-112" stroke="#6a8a4a" stroke-width="22" fill="none" stroke-linecap="round"/>
        <g id="bn${k}"><rect x="-90" y="-150" width="180" height="150" rx="8" fill="#ece6da" stroke="${PL.ink}" stroke-width="4"/><rect x="-24" y="-30" width="48" height="12" rx="5" fill="#bdb3a0"/></g></g>`).join(""));
      seg("half", [
        [0, (d) => ({ ...AISLE("f1", "smoke"), cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }, { t: d, glide: d, ...fr(540, 950, 1.05, 540, 960) }] }, shake: sway(1),
