        ${P(2, -100, 100, [-50, 0, 50].map((x, k) => `<g id="${id}-s${k}"><rect x="${x - 18}" y="-20" width="36" height="56" rx="8" fill="${PL.seat}" stroke="${PL.ink}" stroke-width="3"/><text x="${x}" y="-32" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="26" fill="${PL.ink}">${k + 1}</text></g>`).join("") +
          `<path id="${id}-ar" d="M-70,58H60M44,44L60,58L44,72" stroke="#2fa864" stroke-width="8" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="190" stroke-dashoffset="${o.done ? 0 : 190}"/>`)}
        ${P(3, 100, 100, `<circle cx="0" cy="-8" r="46" fill="#fff" stroke="${PL.ink}" stroke-width="6"/><circle id="${id}-pie" cx="0" cy="-8" r="21" fill="none" stroke="#f6c4bc" stroke-width="42" stroke-dasharray="132" stroke-dashoffset="${o.done ? 0 : 132}" transform="rotate(-90 0 -8)"/>
          <circle cx="0" cy="-8" r="46" fill="none" stroke="${PL.ink}" stroke-width="6"/>${[0, 90, 180, 270].map((a) => `<path d="M0,-46V-39" stroke="${PL.ink}" stroke-width="5" transform="rotate(${a} 0 -8)"/>`).join("")}
