            tl.fromTo("#n2-all", { y: 0 }, { y: 10, duration: 0.6, yoyo: true, repeat: Math.ceil(d / 0.6), ease: "sine.inOut", immediateRender: false }, t0);
            tl.fromTo("#n2-cd", { scale: 0.92, svgOrigin: "0 0" }, { scale: 1, svgOrigin: "0 0", duration: 0.3, ease: "back.out(2)", immediateRender: false }, t0);
            const t90 = t0 + C("ninety", 0, 2) - at, gap = (t90 - 0.3 - (t0 + 0.12)) / 3;
            // "ถูกออกแบบให้ทุกคนออกได้…": stay low → no bags → count the rows, one after the other; "ใน 90 วินาที": the stopwatch
            cardLive(tl, "n2-sc", t0, d, { gloss: t0 + 0.05, focus: { 0: t0 + 0.12, 1: t0 + 0.12 + gap, 2: t0 + 0.12 + 2 * gap, 3: t90 - 0.3 }, sweep: 0.6, stamp: t90 + 0.1, allBack: Math.min(t0 + d - 0.3, t90 + 0.9) });
            put(L.light, `<circle id="n2-ring" cx="${540 + 100 * 1.9}" cy="${900 + 106 * 1.9}" r="150" fill="none" stroke="${PL.red}" stroke-width="10" opacity="0"/>`);
