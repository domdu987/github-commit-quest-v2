      const safetyCard = (id, o = {}) => { const P = (k, x, y, inner) => `<g transform="translate(${x},${y})"><g id="${id}-p${k}"><rect x="-86" y="-80" width="172" height="160" rx="12" fill="#f3f6f9" stroke="${PL.ink}" stroke-width="4"/>${inner}<rect id="${id}-h${k}" x="-90" y="-84" width="180" height="168" rx="14" fill="none" stroke="#f4c430" stroke-width="8" opacity="0"/></g></g>`;
