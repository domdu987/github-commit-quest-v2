          tl.fromTo(S("lo"), { opacity: 0, y: -22 }, { opacity: 1, y: 0, duration: 0.3, ease: "back.out(2.4)", immediateRender: false }, t + 0.18);
          tl.fromTo(S("ad"), { y: -14 }, { y: 6, duration: 0.25, yoyo: true, repeat: 5, ease: "sine.inOut", immediateRender: false }, t); }
        if (F[1] != null) { const t = F[1]; focus(1, t);   // the ✗, one stroke then the other
          tl.to(S("x1"), { strokeDashoffset: 0, duration: 0.16, ease: "power2.out", immediateRender: false }, t + 0.08);
          tl.to(S("x2"), { strokeDashoffset: 0, duration: 0.16, ease: "power2.out", immediateRender: false }, t + 0.28); }
        if (F[2] != null) { const t = F[2]; focus(2, t);   // seats go green one by one, then the arrow draws
          [0, 1, 2].forEach((k) => { tl.to(`${S(`s${k}`)} rect`, { fill: "#2fa864", duration: 0.08, immediateRender: false }, t + 0.06 + k * 0.12);
            tl.fromTo(S(`s${k}`), { y: 0 }, { keyframes: [{ y: -10, duration: 0.07 }, { y: 0, duration: 0.12, ease: "bounce.out" }], immediateRender: false }, t + 0.06 + k * 0.12); });
          tl.to(S("ar"), { strokeDashoffset: 0, duration: 0.25, ease: "power2.out", immediateRender: false }, t + 0.42); }
        if (F[3] != null) { const t = F[3], sw = o.sweep || 0.7; focus(3, t);   // the hand sweeps a full turn, the dial fills, "90" stamps on
          tl.fromTo(S("hd"), { rotation: 0, svgOrigin: "0 0" }, { rotation: 360, svgOrigin: "0 0", duration: sw, ease: "power1.inOut", immediateRender: false }, t);
          tl.to(S("pie"), { strokeDashoffset: 0, duration: sw, ease: "power1.inOut", immediateRender: false }, t);
          tl.fromTo(S("90"), { opacity: 0, scale: 2.2, svgOrigin: "0 60" }, { opacity: 1, scale: 1, svgOrigin: "0 60", duration: 0.3, ease: "back.out(3)", immediateRender: false }, o.stamp ?? t + sw);
          if (o.allBack) [0, 1, 2, 3].forEach((j) => { tl.to(S(`p${j}`), { opacity: 1, scale: 1, svgOrigin: ctr, duration: 0.25, immediateRender: false }, o.allBack); }); } };

      // ---------- a new set: the over-wing exit (the side wall facing us: the plug hatch with its red pull bar and window, the lit EXIT sign
      // above, a window either side; through the glass the wing reaching out over the sea at dusk — o.fire puts flames on the wing) ----------
      Sets.overwing = (L, o = {}) => { const id = o.id || "ow", HX = 900, top = PF - 640;
        const view = (cx, cy, w, h, k) => `<clipPath id="${id}-vc${k}"><rect x="${cx - w / 2}" y="${cy - h / 2}" width="${w}" height="${h}" rx="${Math.min(w, h) * 0.42}"/></clipPath>
          <g clip-path="url(#${id}-vc${k})"><rect x="${cx - w}" y="${cy - h}" width="${w * 2}" height="${h * 2}" fill="url(#${id}-vsk)"/><rect x="${cx - w}" y="${cy + h * 0.12}" width="${w * 2}" height="${h}" fill="#3a5a78"/>
            <path d="M${cx - w},${cy + h * 0.12}H${cx + w}" stroke="#ffe0c0" stroke-width="3" opacity=".7"/>
            <path d="M${cx - w * 1.2},${cy + h * 0.55}L${cx + w * 1.4},${cy + h * 0.05}L${cx + w * 1.4},${cy + h * 0.2}L${cx - w * 1.2},${cy + h * 0.9}Z" fill="#c8d0dc" stroke="${PL.ink}" stroke-width="2"/>
            <path d="M${cx - w * 1.2},${cy + h * 0.62}L${cx + w * 1.4},${cy + h * 0.12}" stroke="#9aa4b0" stroke-width="3"/>
            ${o.fire ? `<g transform="translate(${cx + w * 0.1},${cy + h * 0.32}) scale(${w / 200})"><g class="${id}-wfire">${Plane.flames(`${id}-wf${k}`, 170, 1.3)}</g></g>` : ""}</g>`;
        let s = `<linearGradient id="${id}-vsk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#c86a6a"/><stop offset="1" stop-color="#f6b880"/></linearGradient>
          <rect x="-1200" y="${top - 400}" width="3600" height="${PF - top + 400}" fill="url(#plWall)"/><rect x="-1200" y="${top - 60}" width="3600" height="62" fill="#d7d0c2"/>
          <path d="M-1200,${PF - 470}H2400V${top}H-1200Z" fill="url(#plBin)"/><path d="M-1200,${PF - 470}H2400" stroke="${PL.ink}" stroke-width="4"/>
          <rect x="-1200" y="${PF - 64}" width="3600" height="64" fill="${PL.floor}"/><rect x="-1200" y="${PF}" width="3600" height="1400" fill="#0a0b10"/>`;
        [HX - 330, HX + 330].forEach((wx, k) => { s += `<rect x="${wx - 56}" y="${PF - 400}" width="112" height="150" rx="50" fill="#d8d1c3" stroke="${PL.ink}" stroke-width="4"/>` + view(wx, PF - 325, 76, 112, k); });
        s += `<rect x="${HX - 170}" y="${PF - 590}" width="340" height="560" rx="46" fill="#e6e0d4" stroke="${PL.ink}" stroke-width="6"/><rect x="${HX - 150}" y="${PF - 570}" width="300" height="520" rx="36" fill="none" stroke="#bdb3a0" stroke-width="4"/>
          <rect x="${HX - 70}" y="${PF - 500}" width="140" height="190" rx="60" fill="#d8d1c3" stroke="${PL.ink}" stroke-width="4"/>${view(HX, PF - 405, 104, 160, 2)}
          <rect x="${HX - 120}" y="${PF - 280}" width="240" height="44" rx="14" fill="${PL.red}" stroke="${PL.ink}" stroke-width="4"/><text x="${HX}" y="${PF - 249}" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="26" fill="#fff">ดึง · PULL</text>
          <text x="${HX}" y="${PF - 140}" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="22" fill="#7a7060">ทางออกฉุกเฉิน</text>
          <g transform="translate(${HX},${PF - 660})"><g id="${id}-exit">${Plane.exit(`${id}-ex`, 1.1)}</g></g>`;
        s += Array.from({ length: 14 }, (_, k) => `<rect x="${HX - 640 + k * 90}" y="${PF - 22}" width="40" height="10" rx="5" fill="#9dffc8"/>`).join("");
        put(L.set, s);
        put(L.glow, Array.from({ length: 14 }, (_, k) => `<ellipse cx="${HX - 620 + k * 90}" cy="${PF - 18}" rx="46" ry="14" fill="#7dffb8" opacity=".4" filter="url(#plBlur6)"/>`).join(""));
        if (o.smoke) put(L.fg, `<g id="${id}-smoke" filter="url(#plBlur14)"><rect x="-1200" y="${top - 300}" width="3600" height="${(o.smokeH ?? 500) + 300}" fill="url(#plSmoke)"/>${Plane.puffMk(`${id}-sm`, HX, PF - 520, 10, "dark", 110)}</g>`); };
      // the wreck washed up along a ทะเลลด beach (Sets.tideBeach view "sea"): panels with rivets and the airline stripe, a row of seats on its
      // side, a suitcase, an orange life vest, a tray table, foam round them — scaled by distance with Tide.yAt
      const wreckBits = (L, bid, items) => put(L.set, items.map(([x, d, kind, rot = 0]) => { const y = Tide.yAt(bid, d), k = 15 / d;
        const art = kind === "panel" ? `<path d="M-120,-30L110,-44L124,22L-110,34Z" fill="url(#plMetal)" stroke="${PL.ink}" stroke-width="5"/><path d="M-110,-6L116,-18" stroke="${PL.navy}" stroke-width="12"/><path d="M-108,8L118,-4" stroke="${PL.gold}" stroke-width="6"/>${[-80, -30, 20, 70].map((rx) => `<circle cx="${rx}" cy="-30" r="4" fill="#5a6070"/>`).join("")}`
          : kind === "seats" ? `<g transform="rotate(-80)"><rect x="-90" y="-40" width="180" height="70" rx="14" fill="${PL.seat}" stroke="${PL.ink}" stroke-width="5"/><rect x="-90" y="-110" width="60" height="80" rx="12" fill="${PL.seatD}" stroke="${PL.ink}" stroke-width="5"/><rect x="0" y="-110" width="60" height="80" rx="12" fill="${PL.seatD}" stroke="${PL.ink}" stroke-width="5"/></g>`
          : kind === "case" ? `<rect x="-60" y="-90" width="120" height="90" rx="12" fill="#c8302a" stroke="${PL.ink}" stroke-width="5"/><path d="M-24,-90v-18h48v18" stroke="${PL.ink}" stroke-width="6" fill="none"/>`
          : kind === "vest" ? `<path d="M-50,-60L-60,10H-8L-14,-56ZM50,-60L60,10H8L14,-56Z" fill="#ff6a14" stroke="${PL.ink}" stroke-width="4"/><path d="M-54,-20h40M14,-20h40" stroke="#fff4d0" stroke-width="6"/>`
          : `<rect x="-70" y="-14" width="140" height="28" rx="6" fill="#cfc7b6" stroke="${PL.ink}" stroke-width="4"/>`;
        return `<g transform="translate(${f1(x)},${f1(y)}) scale(${f1(k)}) rotate(${rot})"><ellipse cy="10" rx="150" ry="18" fill="#000" opacity=".22"/>${art}<ellipse cy="14" rx="170" ry="16" fill="#fff" opacity=".35"/></g>`; }).join(""));

      // ================= v5 additions =================
      // fire, the way ทะเลลด/ขวัญ do it: layered flames (Plane.flames v2) + rising embers (Pov.embers) + heat haze on the set behind
      // (Pov's displacement filter) + a smoke ceiling that rolls along the roof (Pov.smoke) — all driven by Pov.life
      const fireFX = (tl, L, id, t0, d, o = {}) => { const r = mk(Math.round(t0 * 100) + 3);
        if (o.x != null) { put(L.glow, `<g transform="translate(${o.x},${o.y})">${Plane.flames(`${id}-ff`, o.h ?? 300, o.w ?? 1.2)}</g>`); Plane.flicker(tl, `${id}-ff`, t0, d); }
        put(L.glow, Pov.embers(r, { x0: o.ex0 ?? (o.x ?? 540) - 300, x1: o.ex1 ?? (o.x ?? 540) + 300, y0: o.ey0 ?? PF - 500, y1: o.ey1 ?? PF, n: o.embers ?? 34, big: 7 }));
        if (o.haze !== false) { L.set.setAttribute("filter", "url(#pvHaze)"); L.set.classList.add("haze"); }
        Pov.life(tl, `#${id}`, t0, d); };
      const smokeCeiling = (L, o = {}) => put(L.fg, `<g opacity="${o.op ?? 0.95}">${Pov.smoke(mk(o.seed ?? 11), { x0: -1200, x1: 2600, y0: PF - 1000, y1: o.y1 ?? PF - 560, lit: true, n: 30 })}</g>`);
      // the under-wing exterior (a film angle): the wing's underside across the top of the frame, the engine pod hanging under it on its
      // pylon, its exhaust on fire, the smoke trail streaming back, the sea far below at dusk
      Sets.underwing = (L, o = {}) => { const id = o.id || "uw";
        put(L.sky, `<linearGradient id="${id}-sk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a4a8a"/><stop offset=".5" stop-color="#d07a7a"/><stop offset="1" stop-color="#f6b880"/></linearGradient><rect x="-2000" y="-1400" width="5200" height="4800" fill="url(#${id}-sk)"/>`);
        put(L.far, `<rect x="-2000" y="1250" width="5200" height="2400" fill="#2e4a6a"/><path d="M-2000,1250H3200" stroke="#ffe0c0" stroke-width="6" opacity=".7"/>
          ${Array.from({ length: 26 }, (_, k) => `<path d="M${-1600 + (k * 397) % 4200},${1290 + (k % 9) * 70}h${60 + (k % 5) * 40}" stroke="#8ab0d0" stroke-width="${2 + (k % 3)}" opacity=".5"/>`).join("")}
          ${Array.from({ length: 6 }, (_, k) => `<ellipse cx="${-1000 + k * 700}" cy="${1120 + (k % 2) * 60}" rx="${380 + (k % 3) * 120}" ry="50" fill="#ffe6d0" opacity=".55"/>`).join("")}`);
        put(L.set, `<path d="M-1400,-400L2600,-400L2600,180L-1400,560Z" fill="#c8d0dc" stroke="#1f1a17" stroke-width="8"/><path d="M-1400,440L2600,90" stroke="#9aa4b0" stroke-width="10"/>
          ${[-900, -400, 100, 600, 1100, 1600, 2100].map((x) => `<path d="M${x},${560 - (x + 1400) * 0.095}l60,70h220l40,-${70 - (x + 1400) * 0.002}" fill="#b8c0cc" stroke="#1f1a17" stroke-width="5"/>`).join("")}
          ${Array.from({ length: 12 }, (_, k) => `<path d="M${-1300 + k * 330},${-400}L${-1300 + k * 330},${540 - k * 33}" stroke="#aeb6c2" stroke-width="3"/>`).join("")}
          <g transform="translate(540,520)"><path d="M-60,-140L60,-140L90,40L-90,40Z" fill="#b8c0cc" stroke="#1f1a17" stroke-width="6"/>
            <rect x="-330" y="20" width="700" height="250" rx="120" fill="#dfe4ec" stroke="#1f1a17" stroke-width="8"/><ellipse cx="370" cy="145" rx="60" ry="125" fill="#2a2e38" stroke="#1f1a17" stroke-width="8"/>
            <ellipse cx="370" cy="145" rx="36" ry="90" fill="#4a505c"/><rect x="-330" y="95" width="700" height="20" fill="#f4c430"/><ellipse cx="-330" cy="145" rx="40" ry="100" fill="#3a3f4c" stroke="#1f1a17" stroke-width="6"/></g>`);
        // the intake's fan (seen through the lip, at an angle)
        put(L.set, `<g transform="translate(910,665)">${Array.from({ length: 12 }, (_, k) => { const a = (k / 12) * Math.PI * 2; return `<path d="M0,0L${f1(Math.cos(a) * 28)},${f1(Math.sin(a) * 76)}" stroke="#8a929e" stroke-width="7"/>`; }).join("")}<circle r="14" fill="#c8ccd4" stroke="#1f1a17" stroke-width="3"/></g>`);
        if (o.fire) { // jet fire: tongues streaming back from the exhaust (left), a tight glow, the black trail behind
          const ex = 205, ey = 665, tongue = (k, L0, W0, c) => `<path class="${id}-jt" data-o="${ex} ${ey}" d="M${ex},${ey - W0}C${ex - L0 * 0.3},${ey - W0 * 1.3} ${ex - L0 * 0.7},${ey - W0 * 0.4 + k * 6} ${ex - L0},${ey + k * 8}C${ex - L0 * 0.7},${ey + W0 * 0.5 + k * 6} ${ex - L0 * 0.3},${ey + W0 * 1.2} ${ex},${ey + W0}Z" fill="url(#${c})"/>`;
          put(L.glow, `<ellipse cx="${ex - 240}" cy="${ey}" rx="420" ry="150" fill="#ff6a1a" opacity=".42" filter="url(#plBlur24)"/>
            <path d="M${ex - 300},${ey - 40}C${ex - 700},${ey - 90} ${ex - 1200},${ey - 30} ${ex - 1900},${ey + 120}L${ex - 1900},${ey + 330}C${ex - 1200},${ey + 170} ${ex - 700},${ey + 90} ${ex - 300},${ey + 50}Z" fill="#2a2628" opacity=".85" filter="url(#plBlur14)"/>
            ${Plane.puffMk(`${id}-tr`, ex - 260, ey, 14, "dark", 80)}
            <g id="${id}-jet">${tongue(-1, 980, 110, "plFlR")}${tongue(1, 880, 96, "plFlR")}${tongue(-1, 760, 80, "plFlO")}${tongue(1, 600, 62, "plFlO")}${tongue(0, 420, 44, "plFlY")}<ellipse cx="${ex - 20}" cy="${ey}" rx="60" ry="56" fill="#fff6d0"/></g>`); } };
      Plane.underwingLife = (tl, id, t0, d) => { const n = Math.ceil(d / 0.09);
        document.querySelectorAll(`.${id}-jt`).forEach((el, j) => { const o = el.getAttribute("data-o"); tl.fromTo(el, { scaleX: 0.86, scaleY: 1.1, svgOrigin: o }, { scaleX: 1.12, scaleY: 0.86, svgOrigin: o, duration: 0.08 + j * 0.02, yoyo: true, repeat: n, ease: "sine.inOut", immediateRender: false }, t0 + j * 0.015); });
        Plane.puffs(tl, `${id}-tr`, t0, d, 14, { dx: -1500, dy: 180, per: 1.0, op: 0.95 }); };
      // the forward galley, fire reaching it from the break: stainless carts in their bays, ovens with little windows, the counter, a loose
      // trolley, the curtain to the cabin half drawn on the right
      Sets.galley = (L, o = {}) => { const id = o.id || "gl", top = PF - 700;
        let s = `<rect x="-1200" y="${top - 300}" width="3600" height="${PF - top + 300}" fill="#c9ccd2"/><rect x="-1200" y="${PF - 64}" width="3600" height="64" fill="#5a6070"/><rect x="-1200" y="${PF}" width="3600" height="1400" fill="#0a0b10"/>`;
        for (let k = 0; k < 6; k++) { const x = 60 + k * 150;
          s += `<rect x="${x}" y="${PF - 380}" width="136" height="360" rx="8" fill="#dfe3e8" stroke="#1f1a17" stroke-width="5"/><rect x="${x + 14}" y="${PF - 360}" width="108" height="16" rx="5" fill="#9aa4b0"/><rect x="${x + 50}" y="${PF - 220}" width="36" height="12" rx="5" fill="#4a505c"/>
            <rect x="${x}" y="${PF - 640}" width="136" height="110" rx="8" fill="#e8ebef" stroke="#1f1a17" stroke-width="5"/><rect x="${x + 22}" y="${PF - 620}" width="92" height="60" rx="8" fill="#2a2e38"/><circle cx="${x + 110}" cy="${PF - 548}" r="6" fill="${k % 2 ? "#ff6a3a" : "#7dffb8"}"/>`; }
        s += `<rect x="40" y="${PF - 420}" width="940" height="34" fill="#b8bec8" stroke="#1f1a17" stroke-width="5"/>
          <g id="${id}-cart" transform="translate(1180,${PF - 30})"><rect x="-80" y="-330" width="160" height="320" rx="10" fill="#dfe3e8" stroke="#1f1a17" stroke-width="6"/><rect x="-60" y="-300" width="120" height="14" rx="5" fill="${PL.navy}"/><rect x="-100" y="-350" width="200" height="22" rx="8" fill="#9aa4b0" stroke="#1f1a17" stroke-width="4"/><circle cx="-50" cy="0" r="14" fill="#2a2e38"/><circle cx="50" cy="0" r="14" fill="#2a2e38"/></g>
          <g id="${id}-cur"><path d="M1420,${top - 20}V${PF - 20}Q1500,${PF - 200} 1560,${PF - 20}V${top - 20}Z" fill="${PL.navy}" stroke="#1f1a17" stroke-width="5"/>${[1450, 1490, 1530].map((x) => `<path d="M${x},${top}V${PF - 60}" stroke="#121c40" stroke-width="6"/>`).join("")}<path d="M1400,${top - 20}H1700" stroke="#9aa4b0" stroke-width="12"/></g>`;
        put(L.set, s);
        put(L.glow, `<rect x="-1200" y="${top - 300}" width="1260" height="${PF - top + 300}" fill="#1a0e0a"/><circle cx="-60" cy="${PF - 300}" r="560" fill="url(#plAmb)"/>`); };
      // the overhead bin, close: lid up, the bags inside; a passenger's hand drags the camera bag's twin out and it tips over the edge
      Sets.binClose = (L, o = {}) => {
        put(L.set, `<rect x="-1200" y="-1400" width="3600" height="4800" fill="#d8d0c2"/><rect x="40" y="520" width="1000" height="520" rx="20" fill="#3a332a" stroke="#1f1a17" stroke-width="8"/>
          <rect x="80" y="760" width="300" height="250" rx="20" fill="#2f6fd0" stroke="#1f1a17" stroke-width="6"/><path d="M160,760v-40h140v40" stroke="#1f1a17" stroke-width="10" fill="none"/>
          <rect x="420" y="700" width="360" height="310" rx="24" fill="#c8302a" stroke="#1f1a17" stroke-width="6"/><path d="M820,880Q900,820 1000,900L1000,1010H820Z" fill="#6a8a4a" stroke="#1f1a17" stroke-width="5"/>
          <path d="M20,1040H1060" stroke="#1f1a17" stroke-width="10"/><rect x="20" y="1040" width="1040" height="60" fill="#ece6da" stroke="#1f1a17" stroke-width="6"/>
          <path d="M40,520L120,250H960L1040,520Z" fill="#ece6da" stroke="#1f1a17" stroke-width="8"/><rect x="460" y="280" width="160" height="30" rx="10" fill="#bdb3a0"/>
          <rect x="-1200" y="1100" width="3600" height="1400" fill="#b8b0a2"/>`); };
      // the seat-back screen (S12): the route over the sea, the airliner icon halfway, ฟ้าราม FR 623
      const ifeScreen = (id) => `<g id="${id}"><rect x="-330" y="-470" width="660" height="940" rx="40" fill="#1e2b58" stroke="#121c40" stroke-width="10"/><rect x="-280" y="-380" width="560" height="380" rx="16" fill="#0a1226" stroke="#3a4a7a" stroke-width="6"/>
        <clipPath id="${id}-c"><rect x="-272" y="-372" width="544" height="364" rx="12"/></clipPath><g clip-path="url(#${id}-c)"><rect x="-280" y="-380" width="560" height="380" fill="#1f4f7a"/>
          <path d="M-280,-60Q-230,-120 -200,-80T-140,-130L-150,0H-280Z" fill="#4a7a4a"/><path d="M280,-300Q220,-260 240,-200T200,-120L280,-80Z" fill="#4a7a4a"/><circle cx="60" cy="-150" r="10" fill="#4a7a4a"/>
          <path id="${id}-rt" d="M-200,-110Q20,-330 220,-230" stroke="#fff" stroke-width="6" stroke-dasharray="14 10" fill="none"/><path d="M-200,-110Q20,-330 220,-230" pathLength="100" stroke="#f4c430" stroke-width="22" stroke-linecap="round" fill="none" opacity=".35" filter="url(#plBlur6)" stroke-dasharray="100 100" stroke-dashoffset="95" class="${id}-rg"/><path d="M-200,-110Q20,-330 220,-230" pathLength="100" stroke="#ffe27a" stroke-width="8" stroke-linecap="round" fill="none" stroke-dasharray="100 100" stroke-dashoffset="95" class="${id}-rg"/><circle cx="-200" cy="-110" r="10" fill="#f4c430"/><circle cx="220" cy="-230" r="10" fill="#f4c430"/>
          <g transform="translate(10,-218) rotate(-14)"><g id="${id}-pl"><circle r="34" fill="#f4c430" opacity=".35"/><path d="M-36,0H36M0,-30L10,0L0,30M-30,-12L-26,0L-30,12" stroke="#fff" stroke-width="11" stroke-linecap="round" fill="none"/></g></g></g>
        <path d="M-272,-8V-360Q-272,-372 -260,-372H272" stroke="#000" stroke-width="10" opacity=".35" fill="none" clip-path="url(#${id}-c)"/>
        <g clip-path="url(#${id}-c)"><path d="M-280,-380H40L-180,0H-280Z" fill="#fff" opacity=".08"/><g id="${id}-sh"><path d="M-60,-400H-20L-240,20H-280Z" fill="#fff" opacity=".12"/></g></g>
        <path d="M-322,-440Q-322,-462 -300,-462H300Q322,-462 322,-440" stroke="#4a5c94" stroke-width="5" fill="none"/><rect x="-286" y="-386" width="572" height="392" rx="18" fill="none" stroke="#0a0f20" stroke-width="4"/><text x="-262" y="-404" font-family="Kanit" font-weight="800" font-size="26" fill="${PL.gold}">ฟ้าราม แอร์ · FR 623</text><text x="0" y="60" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="28" fill="#cfd8f0">เที่ยวบินของคุณ</text>
        <rect x="-150" y="300" width="300" height="130" rx="18" fill="#121c40"/><path d="M-110,330h220M-110,365h170M-110,400h200" stroke="#4a62a8" stroke-width="10"/></g>`;

      // ===== B0 · 1. hook — frame 0: คิว's shocked face AND the engine burning in the window behind him; then outside: the engine =====
      seg("hook", [
        [0, (d) => ({ ...CAB("h1", "alarm", { wingFire: true, wingX: 280, noMasks: true }, 0.05), light: BRIGHT, blur: { far: 0.6, set: 0.6, fg: 9 },
          fgd: false, cam: { keys: [{ t: 0, ...fr(330, 1090, 3.9, 540, 800) }, { t: d, glide: d, ...fr(335, 1090, 4.15, 540, 800) }] },
          shake: rumble(4),
          actors: [A("kiw", KX, PF - 6, KS, [{ t: 0, mode: "brace", eyes: "wide", mouth: "o" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "h1", t0, d);
