        </g></g>`; };
      // bring the card's panels to life (k: which, t: when). In: each panel pops on with an overshoot. Focus: that panel lifts and glows, the rest dim
      const cardLive = (tl, id, t0, d, o = {}) => { const S = (s) => `#${id}-${s}`, ctr = "0 0";
        if (o.popIn) [0, 1, 2, 3].forEach((k) => tl.fromTo(S(`p${k}`), { scale: 0.4, opacity: 0, svgOrigin: ctr }, { scale: 1, opacity: 1, svgOrigin: ctr, duration: 0.38, ease: "back.out(2.6)", immediateRender: false }, o.popIn + k * 0.09));
        if (o.gloss != null) tl.fromTo(S("gl"), { x: -60, opacity: 0.55 }, { x: 640, opacity: 0.25, duration: 0.7, ease: "power2.out", immediateRender: false }, o.gloss);
        // idle life: the smoke band drifts, the figure breathes, the bag rocks, the hand ticks
