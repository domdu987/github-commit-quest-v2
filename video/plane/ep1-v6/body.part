          <text id="${id}-90" x="0" y="70" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="28" fill="${PL.red}" opacity="${o.show90 ? 1 : 0}">90 วินาที</text>`)}
        <g opacity=".22" stroke="#8a7e66" stroke-width="2" fill="none">${[0, 1, 2, 3].map((k) => `<ellipse cx="-150" cy="236" rx="${10 + k * 6}" ry="${14 + k * 7}" transform="rotate(-24 -150 236)"/><ellipse cx="156" cy="226" rx="${9 + k * 6}" ry="${13 + k * 7}" transform="rotate(30 156 226)"/>`).join("")}</g>
