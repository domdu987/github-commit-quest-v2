          <rect id="${id}-fr" width="1080" height="1920" fill="url(#${id}-frg)" opacity="0" style="mix-blend-mode:screen"/>`); flick(tl, `#${id}-fr`, t0, dur, op * 0.5, op); };
      const exitBeam = (L, x, y, s = 1) => put(L.glow, `<g transform="translate(${x},${y}) scale(${s})"><linearGradient id="exb${x}${y}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7dffb8" stop-opacity=".55"/><stop offset="1" stop-color="#7dffb8" stop-opacity="0"/></linearGradient>
        <path d="M-90,30L-260,520H260L90,30Z" fill="url(#exb${x}${y})" style="mix-blend-mode:screen"/><ellipse rx="130" ry="56" fill="#7dffb8" opacity=".5" filter="url(#plBlur14)"/>${Plane.exit(`exg${x}${y}`, 1)}</g>`);
      const dropDark = (tl, id, at, to = 0.6, d = 0.25) => tl.to(`#${id}-dark`, { opacity: to, duration: d, ease: "power2.in" }, at);
      // the cabin reacts: dust and grit falling from the ceiling, a bin door pops open, a bottle rolls along the floor
      const react = (tl, L, id, t0, d, o = {}) => { const r = mk(Math.round(t0 * 100) + 7), x0 = o.x0 ?? 300, x1 = o.x1 ?? 1500;
        let g = "";
        for (let k = 0; k < 26; k++) g += `<circle id="${id}-du${k}" cx="${f1(x0 + r() * (x1 - x0))}" cy="${PF - 640 + r() * 40}" r="${f1(1.5 + r() * 3)}" fill="#d8ccb8" opacity="0"/>`;
        if (o.bin !== false) { const bx = o.binX ?? 760; put(L.set, `<g transform="translate(${bx},${PF - 470})"><rect x="-90" y="-150" width="180" height="150" fill="#3a332a"/><rect x="-60" y="-70" width="90" height="66" rx="8" fill="#6a4ac8" stroke="${PL.ink}" stroke-width="3"/><g id="${id}-bd"><rect x="-90" y="-150" width="180" height="150" rx="8" fill="#ece6da" stroke="${PL.ink}" stroke-width="4"/><rect x="-24" y="-30" width="48" height="12" rx="5" fill="#bdb3a0"/></g></g>`); }
        if (o.bottle !== false) g += `<g transform="translate(${o.botX ?? 900},${PF - 18})"><g id="${id}-bt"><rect x="-26" y="-11" width="52" height="22" rx="10" fill="#bfe4ff" opacity=".9" stroke="${PL.ink}" stroke-width="2.5"/><rect x="26" y="-6" width="10" height="12" rx="3" fill="#2f6fd0"/></g></g>`;
