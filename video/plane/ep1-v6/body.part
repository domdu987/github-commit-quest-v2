      const heldBag = (x, y, s, k) => `<g transform="translate(${f1(x)},${f1(y)}) scale(${f1(s)})">${k % 2 ? Plane.bag(0.9, { strap: true }) : `<rect x="-70" y="-110" width="140" height="110" rx="14" fill="${["#c8302a", "#2f6fd0", "#2fa864", "#6a4ac8"][k % 4]}" stroke="${PL.ink}" stroke-width="5"/><path d="M-30,-110v-24h60v24" stroke="${PL.ink}" stroke-width="7" fill="none"/>`}</g>`;
      // down the aisle (one-point perspective): a person at depth Z (m), lateral X (m) → world point and rig scale
