          actors: [A("kiw", KX, PF - 6, KS, [{ t: 0, mode: "sitDazed", eyes: "worry", mouth: "o" }, { t: 0.5, mode: "reachDown", eyes: "worry", mouth: "o" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "g1", t0, d); fireLight(tl, L, id, t0, d, 0.26); } })],
        [C("grab", 0, 1), (d) => ({ ...CAB("g2", "smoke", { smokeH: 360, noMasks: true }, 0.1), blur: { far: 3, set: 1.5, fg: 9 },
