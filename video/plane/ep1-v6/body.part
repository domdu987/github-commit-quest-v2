          fx(tl, id, t0, L) { Plane.aisleLife(tl, "w2", t0, d); frontLight(tl, L, id, t0, d, 0.3); } })],
        [C("why", 0, 2), (d) => ({ ...CAB("w3", "fire", { breakX: 900, smokeH: 360 }, 0.12), cam: { keys: [{ t: 0, ...fr(1060, 1200, 1.6, 540, 960) }, { t: d, glide: d, ...fr(1080, 1200, 1.75, 540, 960) }] }, shake: rumble(4),
          fx(tl, id, t0, L) { Plane.cabinLife(tl, "w3", t0, d); fireFX(tl, L, id, t0, d, { ex0: 800, ex1: 1300 }); put(L.glow, Plane.edgeFlames("w3e", 760, 1000, PF - 120, 70)); Plane.flicker(tl, "w3e", t0, d); put(L.glow, `<g transform="translate(1060,${PF - 10})">${Plane.flames("w3f", 340, 1.3)}</g>`); Plane.flicker(tl, "w3f", t0, d); fireLight(tl, L, id, t0, d, 0.4); Plane.burst(tl, L.glow, 980, 1250, t0 + 0.15, { n: 10, v: 300 }); } })],
