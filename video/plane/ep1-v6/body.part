        const focus = (k, t) => { [0, 1, 2, 3].forEach((j) => { tl.to(S(`p${j}`), { opacity: j === k ? 1 : 0.42, duration: 0.15, immediateRender: false }, t); tl.to(S(`h${j}`), { opacity: j === k ? 1 : 0, duration: 0.15, immediateRender: false }, t); });
          tl.fromTo(S(`p${k}`), { scale: 1, svgOrigin: ctr }, { keyframes: [{ scale: 1.16, duration: 0.16, ease: "power2.out" }, { scale: 1.08, duration: 0.22, ease: "back.out(3)" }], svgOrigin: ctr, immediateRender: false }, t);
          [0, 1, 2, 3].filter((j) => j !== k).forEach((j) => tl.to(S(`p${j}`), { scale: 0.96, svgOrigin: ctr, duration: 0.2, immediateRender: false }, t)); };
        const F = o.focus || {};
