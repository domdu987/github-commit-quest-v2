            put(L.act, heldBag(975, PF - 610, 0.6, 0) + heldBag(1225, PF - 240, 0.6, 3)); } })],
        [C("half", 0, 3), (d) => ({ set: "binClose", setOpts: {}, dark: 0.12, light: EMERG, grade: GEMR, blur: { set: 0, fg: 8 },
          cam: { keys: [{ t: 0, ...fr(540, 860, 1.0, 540, 900) }, { t: d, glide: d, ...fr(560, 860, 1.08, 540, 900) }] }, shake: rumble(2),
          fx(tl, id, t0, L) { smokeCeiling(L, { y1: 600, seed: 5 });
            put(L.act, `<g id="f4-bag" transform="translate(600,1000)">${heldBag(0, 0, 2.0, 1)}</g><g id="f4-hand">${handAt([640, 980], 30, 2.2, ["#c99a74", "#a8784e", "#e0b896"], { fore: 260, curl: [0.75, 0.8, 0.8, 0.85], thumb: 0.6 })}<path d="${limbD([640 - Math.sin(30 * Math.PI / 180) * 200, 980 + Math.cos(30 * Math.PI / 180) * 200], [640 - Math.sin(30 * Math.PI / 180) * 700, 980 + Math.cos(30 * Math.PI / 180) * 700], 120, 130)}" fill="#2f6fd0" stroke="#1f1a17" stroke-width="5"/></g>`);
            tl.fromTo("#f4-bag", { x: 0, y: 0, rotation: 0, svgOrigin: "600 1000" }, { keyframes: [{ x: 60, y: 30, rotation: 8, duration: 0.5, ease: "power1.inOut" }, { x: 140, y: 520, rotation: 40, duration: 0.45, ease: "power2.in" }], immediateRender: false }, t0 + 0.55); tl.to("#f4-hand", { x: 140, y: 40, duration: 0.5, ease: "power1.inOut" }, t0 + 0.55);
            fireLight(tl, L, id, t0, d, 0.26); } })],
      ]);
      // ===== 10. and those bags… | block the aisle (down the aisle, jammed) =====
      seg("block", [
        [0, (d) => ({ ...CAB("b1", "smoke", { smokeH: 320 }, 0.12), blur: { far: 3, set: 1, fg: 9 }, cam: { keys: [{ t: 0, ...fr(900, PF - 80, 2.3, 540, 1080) }, { t: d, glide: d, ...fr(1000, PF - 80, 2.4, 540, 1080) }] },
          fx(tl, id, t0, L) { Plane.cabinLife(tl, "b1", t0, d); put(L.act, [700, 820, 960, 1100, 1220].map((x, k) => `<g transform="translate(${x},${PF - 12}) rotate(${(k % 3 - 1) * 9})">${heldBag(0, 0, 0.62 + (k % 2) * 0.1, k)}</g>`).join("")); fireLight(tl, L, id, t0, d, 0.24);
            [0, 1, 2].forEach((k) => Plane.burst(tl, L.glow, 760 + k * 200, PF - 30, t0 + 0.1 + k * 0.3, { n: 4, v: 120 })); } })],
        [C("block", 0, 1), (d) => ({ ...AISLE("b2", "smoke"), cam: { keys: [{ t: 0, ...fr(540, 980, 1.0, 540, 960) }] }, shake: rumble(3),
          actors: [[-0.6, 2.6, 5, "cough"], [0.52, 3.0, 8, "push"], [0.06, 4.6, 2, "holdHead"]].map(([X, Z, k, m]) => { const q = AQ(X, Z); return pax(k, q.x, q.y, q.s, m, { flip: X > 0 }); }),
          fx(tl, id, t0, L) { Plane.aisleLife(tl, "b2", t0, d); frontLight(tl, L, id, t0, d, 0.28);
            put(L.act, [[-0.14, 1.6, 0], [0.16, 1.8, 1], [0.0, 2.05, 2]].map(([X, Z, k]) => { const q = AQ(X, Z); return heldBag(q.x, q.y, q.s * 0.9, k); }).join(""));
            SU.flash(tl, L.light, t0 + 0.06, "#ff3b2e", 0.25);  } })],
      ]);
      // ===== B3 · 11. คิว drops the bag | runs forward… | the only way he knows (the EXIT glows behind him) =====
      seg("run", [
        [0, (d) => ({ ...CAB("r1", "smoke", { noMasks: true, smokeH: 360 }, 0.12), blur: { far: 3, set: 1, fg: 9 }, cam: { keys: [{ t: 0, ...fr(STRAPX, PF - 80, 3.0, 540, 1050) }] },
          actors: [A("kiw", KX, PF - 6, KS, [{ t: 0, mode: "reachDown", eyes: "worry", mouth: "o" }, { t: 0.45, mode: "getUp", eyes: "wide", mouth: "o" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "r1", t0, d); fireLight(tl, L, id, t0, d, 0.24); } })],
        [C("run", 0, 1), (d) => ({ ...CAB("r2", "smoke", { smokeH: 440 }, 0.16), cam: { keys: [{ t: 0, ...fr(KX + 120, PF - 270, 2.0, 540, 1100) }, { t: d, glide: d, ...fr(KX + 600, PF - 270, 2.0, 540, 1100) }] }, shake: sway(1.4),
          actors: [A("kiw", KX + 60, PF - 30, KS, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }], { moveTo: { x: KX + 60 + 520, y: PF - 30, dur: d + 0.2, ease: "none" } })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "r2", t0, d, { chase: true }); fireLight(tl, L, id, t0, d, 0.24); } })],
        [C("run", 0, 2), (d) => ({ ...CAB("r3", "smoke", { smokeH: 480 }, 0.18), cam: { keys: [{ t: 0, ...fr(700, 1160, 0.85, 540, 980) }, { t: d, glide: d, ...fr(760, 1160, 0.88, 540, 980) }] }, shake: sway(1.2),
          actors: [A("kiw", 900, PF - 30, KS, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }], { moveTo: { x: 1250, y: PF - 30, dur: d + 0.2, ease: "none" } })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "r3", t0, d, { chase: true }); exitBeam(L, DOORX - 6, PF - 572); } })],
      ]);
      // ===== 12. the smoke so thick… | he can't see his own hand (insert: his hand fading in smoke) =====
      const KSK = ["#e0b088", "#b88a64", "#f0c8a0"];
      seg("blind", [
        [0, (d) => ({ ...CAB("l1", "smoke", { noMasks: true, noSheet: true, smokeH: 900 }, 0.2), smokeL: false, cam: { keys: [{ t: 0, ...fr(1250, PF - 420, 3.6, 540, 820) }, { t: d, glide: d, ...fr(1250, PF - 420, 3.9, 540, 820) }] }, shake: sway(1.2),
          actors: [A("kiw", 1230, PF - 30, KS, [{ t: 0, mode: "cough", eyes: "closed", mouth: "o" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "l1", t0, d, { smokeFrom: -200, smokeTo: 80 }); fireLight(tl, L, id, t0, d, 0.22); smokeLayer(tl, L, t0, d, { y1: 330, y2: 420, top: -400, layer: L.light }); fgDepth(L, "seat"); } })],
        [C("blind", 0, 1), (d) => ({ ...CAB("l2", "smoke", { smokeH: 1100 }, 0.25), blur: { far: 6, set: 6, fg: 12 }, fgd: false, cam: { keys: [{ t: 0, ...fr(1270, PF - 420, 1.5, 540, 860) }] },
          fx(tl, id, t0, L) { Plane.cabinLife(tl, "l2", t0, d);
            put(L.light, `<g id="l2-h">${handAt([560, 900], -8, 2.6, KSK, { fore: 1400, curl: [0.1, 0, 0.1, 0.2], thumb: 0.2 })}</g>`);
            tl.fromTo("#l2-h", { y: 120 }, { y: 0, duration: 0.5, ease: "power2.out", immediateRender: false }, t0);
             } })],
      ]);
      // ===== 13. and ahead… | FIRE (big, layered, debris) — his face lit =====
      seg("front", [
        [0, (d) => ({ set: "overwing", setOpts: { id: "t1" }, dark: 0.22, light: EMERG, grade: GEMR, blur: { far: 1, set: 0.6, fg: 9 },
          cam: { keys: [{ t: 0, ...fr(860, PF - 360, 1.55, 540, 1080) }, { t: d, glide: d, ...fr(880, PF - 360, 1.7, 540, 1080) }] }, shake: sway(1),
          actors: [A("kiw", 1150, PF - 30, KS, [{ t: 0, mode: "cough", eyes: "pain", mouth: "o" }], { flip: true, moveTo: { x: 1040, y: PF - 30, dur: d, ease: "power1.out" } })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); smokeLayer(tl, L, t0, d); fgDepth(L, "seat"); } })],
        [C("front", 0, 1), (d) => ({ set: "overwing", setOpts: { id: "t2", fire: true }, dark: 0.08, light: EMERG, grade: GEMR, blur: { far: 1, set: 0.6, fg: 9 },
          cam: { keys: [{ t: 0, ...fr(930, PF - 420, 2.3, 540, 900) }, { t: d, glide: d, ...fr(930, PF - 420, 2.1, 540, 900) }] },
          shake: (t) => (t < 0.6 ? { x: 20 * Math.sin(t * 61) * (0.6 - t), y: 16 * Math.sin(t * 47) * (0.6 - t), r: 0 } : 0),
          actors: [A("kiw", 1090, PF - 30, KS, [{ t: 0, mode: "cough", eyes: "wide", mouth: "o" }], { flip: true })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); smokeLayer(tl, L, t0, d); [0, 1, 2].forEach((k) => Plane.flicker(tl, `t2-wf${k}`, t0, d)); fireFX(tl, L, id, t0, d, { ex0: 500, ex1: 1300, ey0: PF - 600, ey1: PF - 200, haze: false });
            tl.fromTo(".t2-wfire", { opacity: 0, scale: 0.3, svgOrigin: "0 0" }, { opacity: 1, scale: 1, svgOrigin: "0 0", duration: 0.25, ease: "back.out(2)", immediateRender: false }, t0 + 0.02);
            put(L.glow, `<circle cx="900" cy="${PF - 405}" r="260" fill="url(#plAmb)"/><circle cx="570" cy="${PF - 325}" r="180" fill="url(#plAmb)"/><circle cx="1230" cy="${PF - 325}" r="180" fill="url(#plAmb)"/>`);
            fireLight(tl, L, id, t0, d, 0.5); SU.flash(tl, L.light, t0 + 0.02, "#ff8a2a", 0.6); } })],
      ]);
      // ===== B4 · 14. the nearest exit… (EXIT through smoke, low) | is behind him (down the aisle toward the rear door) | one row =====
      seg("behind", [
        [0, (d) => ({ ...CAB("e1", "smoke", { noMasks: true, smokeH: 520 }, 0.18), cam: { keys: [{ t: 0, ...fr(DOORX, PF - 560, 2.6, 540, 820) }, { t: d, glide: d, ...fr(DOORX, PF - 560, 2.8, 540, 820) }] }, shake: sway(1),
          fx(tl, id, t0, L) { Plane.cabinLife(tl, "e1", t0, d, { chase: true }); exitBeam(L, DOORX - 6, PF - 572); } })],
        [C("behind", 0, 1), (d) => ({ ...AISLE("e2", "smoke", { exitBack: true }), cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }, { t: d, glide: d, ...fr(540, 900, 1.25, 540, 900) }] }, shake: sway(1),
          actors: [(() => { const q = AQ(0.05, 1.9); return A("kiw", q.x, q.y, q.s, [{ t: 0, mode: "cough", eyes: "pain", mouth: "o" }], { flip: true }); })()],
          fx(tl, id, t0, L) { Plane.aisleLife(tl, "e2", t0, d); frontLight(tl, L, id, t0, d, 0.22); } })],
        [C("behind", 0, 2), (d) => ({ ...CAB("e3", "smoke", { noMasks: true, smokeH: 520 }, 0.16), cam: { keys: [{ t: 0, ...fr(DOORX + 200, PF - 270, 2.0, 540, 1150) }, { t: d, glide: d, ...fr(DOORX + 200, PF - 270, 2.1, 540, 1150) }] }, shake: sway(1),
          actors: [A("kiw", KX + 20, PF - 30, KS, [{ t: 0, mode: "cough", eyes: "pain", mouth: "o" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "e3", t0, d, { chase: true }); exitBeam(L, DOORX - 6, PF - 572); } })],
      ]);
      // ===== 15. (you) every flight… | count the rows to the exit | front and back — calm, bright cabin; the seat-back card =====
      add("rule", { ...CAB("u1", "calm", { rows: [25, 30] }), blur: { far: 0, set: 0, fg: 6 },
        cam: { keys: [{ t: 0, ...fr(700, 1250, 1.3, 540, 1020) }, { t: C("rule", 0, 1), ...fr(600, 1200, 1.3, 540, 1000) }, { t: D("rule"), glide: D("rule") - C("rule", 0, 1), ...fr(640, 1200, 1.36, 540, 1000) }] },
        actors: [A("kiw", KX, PF - 6, KS, [{ t: 0, mode: "sitChair", eyes: "normal", mouth: "flat" }])],
        captions: caps("rule"),
        fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "u1", t0, D("rule"));
          put(L.light, `<g id="u1-ife"><rect width="1080" height="1920" fill="#2d3f7c"/><rect x="0" y="1500" width="1080" height="420" fill="#1e2b58"/><g transform="translate(540,880) scale(1.45)">${ifeScreen("u1-s")}</g></g>`);
          tl.fromTo("#u1-s-pl", { x: -170, y: 90 }, { x: 0, y: 0, duration: C("rule", 0, 1), ease: "none", immediateRender: false }, t0);
          tl.fromTo(".u1-s-rg", { strokeDashoffset: 95 }, { strokeDashoffset: 52, duration: C("rule", 0, 1), ease: "none", immediateRender: false }, t0);
          tl.fromTo("#u1-s-rt", { strokeDashoffset: 0 }, { strokeDashoffset: -96, duration: C("rule", 0, 1), ease: "none", immediateRender: false }, t0);
          tl.fromTo("#u1-s-pl", { scale: 1, svgOrigin: "0 0" }, { scale: 1.12, svgOrigin: "0 0", duration: 0.4, yoyo: true, repeat: Math.ceil(C("rule", 0, 1) / 0.4), ease: "sine.inOut", immediateRender: false }, t0);
          tl.fromTo("#u1-s-sh", { x: -60 }, { x: 420, duration: C("rule", 0, 1), ease: "sine.inOut", immediateRender: false }, t0);
          tl.set("#u1-ife", { opacity: 0 }, t0 + C("rule", 0, 1));

          // the seat-back card in his hands (half the frame): the cabin plan, his seat, a finger counting the rows to the front exit, then back
          const RW = 8, Y0 = -150, DY = 40, ME = 6;   // rows on the plan, top row y, row pitch, his row index (two from the rear door)
          let plan = `<rect x="-78" y="${Y0 - 70}" width="156" height="${RW * DY + 120}" rx="70" fill="#eef2f6" stroke="#9aa4b0" stroke-width="4"/>`;
          for (let r = 0; r < RW; r++) { const y = Y0 + r * DY;
            plan += `<g id="u1-r${r}"><rect x="-64" y="${y - 14}" width="44" height="28" rx="6" fill="${r === ME ? PL.gold : PL.seat}"/><rect x="20" y="${y - 14}" width="44" height="28" rx="6" fill="${PL.seat}"/></g>
              <text x="-92" y="${y + 9}" text-anchor="end" font-family="Kanit" font-weight="800" font-size="22" fill="#7a7060">${23 + r}</text>`; }
          plan += `<g transform="translate(0,${Y0 - 52})"><path d="M-30,10L0,-12L30,10" stroke="#2fa864" stroke-width="10" fill="none" stroke-linecap="round"/><text x="0" y="-22" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="24" fill="#2fa864">EXIT</text></g>
            <g transform="translate(0,${Y0 + (RW - 1) * DY + 50})"><path d="M-30,-10L0,12L30,-10" stroke="#2fa864" stroke-width="10" fill="none" stroke-linecap="round"/><text x="0" y="40" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="24" fill="#2fa864">EXIT</text></g>
            <text x="-42" y="${Y0 + ME * DY + 50}" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="22" fill="${PL.red}">คุณ</text>
            <g id="u1-up" opacity="0"><path d="M100,${Y0 + ME * DY}V${Y0 - 30}" stroke="#2fa864" stroke-width="12" stroke-linecap="round"/><path d="M84,${Y0 - 14}L100,${Y0 - 36}L116,${Y0 - 14}" stroke="#2fa864" stroke-width="12" fill="none" stroke-linecap="round"/>
              <circle cx="146" cy="${Y0 + 60}" r="34" fill="#2fa864"/><text x="146" y="${Y0 + 72}" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="34" fill="#fff">${ME}</text></g>
            <g id="u1-dn" opacity="0"><path d="M100,${Y0 + ME * DY}V${Y0 + (RW - 1) * DY + 36}" stroke="${PL.red}" stroke-width="12" stroke-linecap="round"/><path d="M84,${Y0 + (RW - 1) * DY + 20}L100,${Y0 + (RW - 1) * DY + 42}L116,${Y0 + (RW - 1) * DY + 20}" stroke="${PL.red}" stroke-width="12" fill="none" stroke-linecap="round"/>
              <circle cx="146" cy="${Y0 + (RW - 1) * DY + 10}" r="34" fill="${PL.red}"/><text x="146" y="${Y0 + (RW - 1) * DY + 22}" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="34" fill="#fff">1</text></g>`;
          const card = `<g transform="skewY(-3)"><rect x="-200" y="-280" width="400" height="560" rx="18" fill="#fdfaf2" stroke="${PL.ink}" stroke-width="6"/><rect x="-200" y="-280" width="400" height="74" rx="18" fill="${PL.navy}"/><rect x="-200" y="-224" width="400" height="18" fill="${PL.navy}"/>
            <path d="M-200,-206H200" stroke="${PL.gold}" stroke-width="6"/><text x="-176" y="-232" font-family="Kanit" font-weight="900" font-size="32" fill="${PL.gold}">นับแถวไปทางออก</text><g transform="translate(-30,30)">${plan}</g></g>`;
          const tC = t0 + C("rule", 0, 1), tD = t0 + C("rule", 0, 2), Kc = 1.9, P = (x, y) => [540 + Kc * (x - 30), 860 + Kc * (y + 30)];
          put(L.light, `<g id="u1-card" opacity="0"><rect width="1080" height="1920" fill="#000" opacity=".25"/><g transform="translate(540,860) scale(${Kc})">${card}</g>
            ${handAt([250, 1420], 28, 2.1, KSK, { fore: 900, curl: [0.7, 0.75, 0.8, 0.85], thumb: 0.2 })}<g id="u1-f">${handAt([0, 0], -60, 1.7, KSK, { fore: 150, curl: [0, 1, 1, 1], thumb: 1, mirror: true })}<path d="${limbD([Math.sin(60 * Math.PI / 180) * 150 * 0.7, Math.cos(60 * Math.PI / 180) * 150 * 0.7], [Math.sin(60 * Math.PI / 180) * 210, Math.cos(60 * Math.PI / 180) * 210], 96, 104)}" fill="#d9a43a" stroke="#1f1a17" stroke-width="5"/></g></g>`);
          tl.fromTo("#u1-card", { opacity: 0, y: 260 }, { opacity: 1, y: 0, duration: 0.35, ease: "back.out(1.6)", immediateRender: false }, tC);
          const fy = (r) => P(-64 + 22, Y0 + r * DY)[1] + 10, fx0 = P(-30, 0)[0] + 30;
          tl.set("#u1-f", { x: fx0, y: fy(ME) }, tC);
          for (let r = ME, k = 0; r >= 0; r--, k++) { const at = tC + 0.35 + k * ((tD - tC - 0.45) / (ME + 1));
            tl.to("#u1-f", { y: fy(r), duration: 0.12, ease: "power2.out" }, at); tl.to(`#u1-r${r} rect:first-child`, { attr: { fill: r === ME ? PL.gold : "#7dd9a0" }, duration: 0.1 }, at); }
          tl.fromTo("#u1-up", { opacity: 0 }, { opacity: 1, duration: 0.2, immediateRender: false }, tD - 0.15);
          tl.to("#u1-f", { y: fy(RW - 1), duration: 0.3, ease: "power2.inOut" }, tD + 0.25); tl.to(`#u1-r${RW - 1} rect:first-child`, { attr: { fill: "#ff9a8a" }, duration: 0.1 }, tD + 0.5);
          tl.fromTo("#u1-dn", { opacity: 0, scale: 1.4, svgOrigin: `100 ${Y0 + (RW - 1) * DY}` }, { opacity: 1, scale: 1, svgOrigin: `100 ${Y0 + (RW - 1) * DY}`, duration: 0.3, ease: "back.out(2.5)", immediateRender: false }, tD + 0.55); } });
      // ===== 16. because in smoke… | the signs sink out of sight (close on the EXIT sign, smoke rolling over it) =====
      seg("sign", [
        [0, (d) => ({ ...CAB("x1", "smoke", { smokeH: 620 }, 0.2), cam: { keys: [{ t: 0, ...fr(600, 1200, 0.9, 540, 980) }, { t: d, glide: d, ...fr(560, 1200, 0.95, 540, 980) }] }, shake: sway(1),
          fx(tl, id, t0, L) { Plane.cabinLife(tl, "x1", t0, d, { smokeFrom: -100, smokeTo: 60 }); react(tl, L, "x1r", t0, d, { binX: 1210, botX: 800 }); fireLight(tl, L, id, t0, d, 0.2); } })],
        [C("sign", 0, 1), (d) => ({ ...CAB("x2", "smoke", { noMasks: true, smokeH: 620 }, 0.3), smokeL: false, fgd: false, cam: { keys: [{ t: 0, ...fr(DOORX, PF - 572, 3.4, 540, 860) }] },
          fx(tl, id, t0, L) { Plane.cabinLife(tl, "x2", t0, d); smokeLayer(tl, L, t0, d, { y1: PF - 700, y2: PF - 470 });
            exitBeam(L, DOORX - 6, PF - 572);
            
             } })],
      ]);
      // ===== B5 · 17. over his shoulder: his hand counts the seatbacks… (insert) | one =====
      const seatBackHand = (id, x) => { const W = [0, -10], deg = -35, k = 2.3, back = [W[0] + Math.sin(35 * Math.PI / 180) * 900, W[1] + Math.cos(35 * Math.PI / 180) * 900], M = [W[0] + (back[0] - W[0]) * 0.22, W[1] + (back[1] - W[1]) * 0.22];
        return `<g id="${id}" transform="translate(${x},0)">${handAt(W, deg, k, KSK, { fore: 900, curl: [0.55, 0.6, 0.65, 0.7], thumb: 0.4 })}<path d="${limbD(M, back, 130, 140)}" fill="#d9a43a" stroke="#1f1a17" stroke-width="5"/><path d="${limbD([M[0] + 6, M[1]], [M[0] + 30, M[1] + 30], 140, 136)}" fill="#b98a2a" opacity=".5"/></g>`; };
      seg("count", [
        [0, (d) => ({ ...CAB("k1", "smoke", { noMasks: true, smokeH: 900 }, 0.2), blur: { far: 3, set: 1.5, fg: 10 },
          fgd: false, cam: { keys: [{ t: 0, ...fr(560, PF - 420, 2.2, 540, 900) }, { t: d, glide: d, ...fr(380, PF - 420, 2.2, 540, 900) }] },
          light: { ...EMERG, rim: "#9dffc8", rimOp: 1 },
          fx(tl, id, t0, L) { Plane.cabinLife(tl, "k1", t0, d, { chase: true });
            put(L.glow, Array.from({ length: 14 }, (_, k) => `<ellipse id="k1-pg${k}" cx="${DOORX + 80 + k * 90}" cy="${PF - 16}" rx="60" ry="22" fill="#9dffc8" opacity=".75" filter="url(#plBlur14)"/>`).join(""));
            for (let k = 0; k < 14; k++) tl.fromTo(`#k1-pg${k}`, { opacity: 0.4 }, { opacity: 1, duration: 0.18, yoyo: true, repeat: 1, repeatDelay: 0.7, immediateRender: false }, t0 + ((13 - k) % 14) * 0.06);
            // the over-the-shoulder insert: his hand on a seatback top in the foreground, sliding back seat by seat
            put(L.light, `<g transform="translate(0,1180)"><rect x="-40" y="0" width="1160" height="400" fill="#2d3f7c"/><path d="M-40,8H1120" stroke="#4a62a8" stroke-width="10"/><rect x="-40" y="-40" width="1160" height="60" rx="26" fill="#f4f0e6" stroke="${PL.ink}" stroke-width="5"/>${seatBackHand("k1-h", 700)}</g>`);
            tl.fromTo("#k1-h", { x: 760 }, { x: 360, duration: d, ease: "steps(3)", immediateRender: false }, t0); } })],
        [C("count", 0, 1), (d) => ({ ...CAB("k2", "smoke", { noMasks: true, smokeH: 900 }, 0.16), blur: { far: 3, set: 1, fg: 10 },
          cam: { keys: [{ t: 0, ...fr(ROW30 - 60, PF - 400, 2.2, 540, 960) }] },
          actors: [A("kiw", ROW30 + 60, PF - 30, KS, [{ t: 0, mode: "crouchLook", eyes: "normal", mouth: "flat" }], { flip: true })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "k2", t0, d, { chase: true }); SU.flash(tl, L.light, t0 + 0.05, "#9dffc8", 0.3);
            exitBeam(L, DOORX - 6, PF - 572); } })],
      ]);
      // ===== 18. the door opens (low angle) | down the slide | before the fire reaches him =====
      seg("out", [
        [0, (d) => ({ ...CAB("o1", "alarm", { noMasks: true }, 0.06), cam: { keys: [{ t: 0, ...fr(DOORX + 30, PF - 260, 1.9, 540, 1000) }] },
          actors: [A("kiw", DOORX + 260, PF - 30, KS, [{ t: 0, mode: "crouchLook", eyes: "wide", mouth: "o" }], { flip: true })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.cabinLife(tl, "o1", t0, d);
            tl.fromTo("#o1-door", { x: 0, opacity: 1 }, { x: -260, opacity: 0, duration: 0.5, ease: "power2.out", immediateRender: false }, t0 + 0.25);
            const X0 = DOORX - 120, Y0 = PF - 515;
            put(L.glow, `<linearGradient id="o1-sk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6a7ab8"/><stop offset=".55" stop-color="#f09a7a"/><stop offset="1" stop-color="#ffd9a0"/></linearGradient>
              <linearGradient id="o1-sl" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#f4c430"/><stop offset=".5" stop-color="#ffe070"/><stop offset="1" stop-color="#d9a020"/></linearGradient>
              <linearGradient id="o1-bm" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#ffd9a0" stop-opacity=".28"/><stop offset="1" stop-color="#ffd9a0" stop-opacity="0"/></linearGradient>
              <clipPath id="o1-dc"><rect x="${X0}" y="${Y0}" width="240" height="495" rx="40"/></clipPath>
              <g id="o1-day" opacity="0"><g clip-path="url(#o1-dc)">
                <rect x="${X0 - 10}" y="${Y0 - 10}" width="260" height="230" fill="url(#o1-sk)"/><circle cx="${X0 + 70}" cy="${Y0 + 205}" r="34" fill="#fff0c8"/>
                <ellipse cx="${X0 + 170}" cy="${Y0 + 70}" rx="70" ry="18" fill="#fff" opacity=".7"/><ellipse cx="${X0 + 60}" cy="${Y0 + 120}" rx="55" ry="12" fill="#fff" opacity=".6"/>
                <rect x="${X0 - 10}" y="${Y0 + 215}" width="260" height="300" fill="#2e5a7a"/><path d="M${X0 - 10},${Y0 + 216}h260" stroke="#ffe0c0" stroke-width="5"/>
                ${[0, 1, 2, 3, 4, 5].map((k) => `<path d="M${X0 - 10},${Y0 + 240 + k * 34}q20,-10 40,0t40,0t40,0t40,0t40,0t40,0t40,0" stroke="#8ac0dc" stroke-width="4" fill="none" opacity="${0.8 - k * 0.08}"/>`).join("")}
                <path d="M${X0 + 120},${Y0 + 500}L${X0 + 10},${Y0 + 270}Q${X0 + 40},${Y0 + 250} ${X0 + 80},${Y0 + 262}L${X0 + 230},${Y0 + 500}Z" fill="url(#o1-sl)" stroke="#1f1a17" stroke-width="5"/>
                ${[0, 1, 2, 3].map((k) => `<path d="M${X0 + 30 + k * 34},${Y0 + 300 + k * 52}L${X0 + 82 + k * 38},${Y0 + 292 + k * 54}" stroke="#c89020" stroke-width="7" stroke-linecap="round"/>`).join("")}</g>
                <rect x="${X0 - 6}" y="${Y0 - 6}" width="252" height="507" rx="44" fill="none" stroke="#c9c1b2" stroke-width="16"/><rect x="${X0 - 14}" y="${Y0 - 14}" width="268" height="523" rx="50" fill="none" stroke="#1f1a17" stroke-width="5"/>
                </g>
              <rect id="o1-glow" x="${DOORX - 160}" y="${PF - 560}" width="320" height="580" rx="60" fill="#ffd9a0" opacity="0" filter="url(#plBlur24)" style="mix-blend-mode:screen"/>`);
            tl.fromTo("#o1-day", { opacity: 0 }, { opacity: 1, duration: 0.35, immediateRender: false }, t0 + 0.3);  } })],
        [C("out", 0, 1), (d) => ({ ...SITE("o2", { fire: 0.9, sand: true }),
          cam: { keys: [{ t: 0, ...fr(190, 1500, 3.2, 540, 1000) }, { t: d, glide: d, ...fr(130, 1540, 3.0, 540, 1000) }] },
          actors: [A("kiw", 198, 1474, 0.19, [{ t: 0, mode: "crouch", eyes: "wide", mouth: "o" }, { t: 0.7, mode: "run", eyes: "wide", mouth: "o" }], { flip: true, path: [{ t: 0, x: 198, y: 1474 }, { t: 0.7, x: 127, y: 1574 }, { t: 1.6, x: 60, y: 1596, s: 0.21 }] })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.siteLife(tl, "o2", t0, d); put(L.glow, `<g transform="translate(360,1440)">${Plane.flames("o2f", 150, 1.1)}</g>${Plane.puffMk("o2s", 360, 1300, 10, "dark", 70)}`); Plane.flicker(tl, "o2f", t0, d); Plane.puffs(tl, "o2s", t0, d, 10, { dx: 180, dy: -600, per: 1.8, op: 0.9 }); } })],
        [C("out", 0, 2), (d) => ({ ...SITE("o3", { fire: 1, sand: true }), cam: { keys: [{ t: 0, ...fr(200, 1470, 2.2, 540, 1050) }, { t: d, glide: d, ...fr(170, 1480, 2.0, 540, 1050) }] },
          shake: (t) => (t < 0.5 ? { x: 14 * Math.sin(t * 61), y: 10 * Math.sin(t * 47), r: 0 } : 0),
          actors: [A("kiw", 60, 1596, 0.21, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }], { flip: true, moveTo: { x: -40, y: 1606, dur: d, ease: "none" } })],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.siteLife(tl, "o3", t0, d); fireFX(tl, L, id, t0, d, { ex0: 200, ex1: 500, ey0: 1200, ey1: 1460, haze: false }); put(L.glow, `<g transform="translate(330,1450)">${Plane.flames("o3f", 220, 1.3)}</g>${Plane.puffMk("o3s", 330, 1280, 12, "dark", 80)}`); Plane.flicker(tl, "o3f", t0, d); Plane.puffs(tl, "o3s", t0, d, 12, { dx: 200, dy: -650, per: 1.7, op: 0.92 });
            SU.flash(tl, L.light, t0 + 0.1, "#ff8a2a", 0.6); Plane.burst(tl, L.glow, 330, 1440, t0 + 0.12, { n: 20, v: 380 }); } })],
      ]);
      // ===== 19. he made it (face readable) =====
      add("safe", { ...SITE("v1", { fire: 0.7 }), blur: { far: 4, mid: 4, set: 5, fg: 9 }, cam: { keys: [{ t: 0, ...fr(60, 1100, 2.1, 540, 820) }, { t: D("safe"), glide: D("safe"), ...fr(60, 1100, 2.25, 540, 820) }] },
        actors: [A("kiw", 60, 1640, 0.95, [{ t: 0, mode: "crouch", eyes: "closed", mouth: "o" }])],
        captions: caps("safe"),
        fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.siteLife(tl, "v1", t0, D("safe")); } });
      // ===== twist: pull out — 0.45 s near-black =====
      add("hush", { dark: 0, light: false, cam: { keys: [{ t: 0, ...fr(540, 960, 1, 540, 960) }] },
        fx(tl, id, t0, L) { put(L.light, `<rect width="1080" height="1920" fill="#030406"/>`); } });
      // ===== B6 · 20. the smoke clears (his face, close) | no front section… (the torn end) | of the plane any more (wide) =====
      const kiwCU = (key, mode, eyes, mouth, extra = {}) => (d) => ({ ...SITE(`${key}c`, { fire: 0.3, ...(extra.site || {}) }), dark: 0.08, blur: { far: 4, mid: 4, set: 5, fg: 9 },
        cam: { keys: [{ t: 0, ...fr(60, 1100, 2.1, 540, 820) }, { t: d, glide: d, ...fr(60, 1100, 2.25, 540, 820) }] },
        actors: [A("kiw", 60, 1640, 0.95, [{ t: 0, mode, eyes, mouth }], extra.flip ? { flip: true } : {})],
        fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.siteLife(tl, `${key}c`, t0, d);
          tl.fromTo(`#${id}-a0-hair`, { skewX: -4, svgOrigin: "0 -560" }, { skewX: 6, svgOrigin: "0 -560", duration: 0.35, yoyo: true, repeat: Math.ceil(d / 0.35), ease: "sine.inOut", immediateRender: false }, t0); if (extra.haze) { put(L.light, `<rect id="${key}-hz" width="1080" height="1920" fill="#8a8a92" opacity="0"/>`); tl.fromTo(`#${key}-hz`, { opacity: 0.7 }, { opacity: 0, duration: 1.1, ease: "power1.out", immediateRender: false }, t0); } } });
      seg("twist", [
        [0, kiwCU("tw", "idle", "wide", "o", { haze: true })],
        [C("twist", 0, 1), (d, at) => ({ ...SITE("z1", { fire: 0.35 }), dark: 0.12,
          cam: { keys: [{ t: 0, ...fr(620, 1400, 1.9, 540, 1050) }, { t: C("twist", 0, 2) - at, ...fr(400, 1300, 0.85, 540, 1050) }, { t: d, glide: d - (C("twist", 0, 2) - at), ...fr(420, 1300, 0.8, 540, 1050) }] },
          actors: [A("kiw", 60, 1598, 0.16, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Plane.siteLife(tl, "z1", t0, d); } })],
      ]);
      // ===== 21. only คิว… (close) | and an island in the middle of the sea (wide) =====
      seg("alone", [
        [0, kiwCU("al", "holdHead", "worry", "frown")],
        [C("alone", 0, 1), (d) => ({ set: "tideBeach", setOpts: { id: "y1", view: "sea", time: "eerie", sea: 0, boats: 0, fish: 0, people: 0, seed: 7 }, dark: 0.04, light: DUSKL, grade: { top: "#ff8a5a", bottom: "#2a2050", op: 0.3 }, blur: { fg: 5 },
          cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }, { t: d, glide: d, ...fr(540, 980, 1.06, 540, 960) }] },
          actors: [A("kiw", 330, 1540, 0.82, [{ t: 0, mode: "holdHead", eyes: "worry", mouth: "frown" }])],
          fx(tl, id, t0, L) { noSh(tl, id, 1); Tide.sea(tl, "y1", t0, d, {}); put(L.sky, `<linearGradient id="y1-dk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a4a6a"/><stop offset=".6" stop-color="#c87a6a"/><stop offset="1" stop-color="#f2b080"/></linearGradient><rect x="-2000" y="-1400" width="5200" height="2050" fill="url(#y1-dk)"/><circle cx="260" cy="640" r="260" fill="#fff0c8" opacity=".35"/><circle cx="260" cy="640" r="66" fill="#fff6e0"/>`);
            put(L.light, `<rect width="1080" height="1920" fill="#ff8a4a" opacity=".22" style="mix-blend-mode:multiply"/><rect width="1080" height="1920" fill="#ffb070" opacity=".12" style="mix-blend-mode:screen"/>`);  wreckBits(L, "y1", [[150, 4.2, "panel", -8], [820, 5.5, "seats"], [640, 9, "case", 6], [960, 3.6, "vest", -14], [260, 11, "tray", 4], [760, 14, "panel", 10]]);
            put(L.sky, `<g>${Plane.puffMk("y1p", 820, 640, 10, "dark", 50)}</g>`); Plane.puffs(tl, "y1p", t0, d + 0.5, 10, { dx: 60, dy: -420, per: 2.2, op: 0.85 }); } })],
      ]);
      // ===== 22. but across the bay… (his face, he turns) | a column of smoke rising (clear, dark against the dusk) =====
      seg("smoke2", [
        [0, kiwCU("sm", "idle", "wide", "o", { flip: true })],
        [C("smoke2", 0, 1), (d) => ({ set: "tideBeach", setOpts: { id: "m1", view: "sea", time: "eerie", sea: 0, boats: 0, fish: 0, people: 0, seed: 7 }, dark: 0.04, light: DUSKL, grade: { top: "#ff8a5a", bottom: "#2a2050", op: 0.3 }, blur: { fg: 6 },
          cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }] },
          fx(tl, id, t0, L) { Tide.sea(tl, "m1", t0, d, {}); put(L.sky, `<linearGradient id="m1-dk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a4a6a"/><stop offset=".6" stop-color="#c87a6a"/><stop offset="1" stop-color="#f2b080"/></linearGradient><rect x="-2000" y="-1400" width="5200" height="2050" fill="url(#m1-dk)"/><circle cx="260" cy="640" r="260" fill="#fff0c8" opacity=".35"/><circle cx="260" cy="640" r="66" fill="#fff6e0"/>`);
            put(L.light, `<rect width="1080" height="1920" fill="#ff8a4a" opacity=".22" style="mix-blend-mode:multiply"/><rect width="1080" height="1920" fill="#ffb070" opacity=".12" style="mix-blend-mode:screen"/>`); 
            tl.set(["#m1-palm0", "#m1-palm1"], { opacity: 0 }, t0);
            // screen space (the camera holds still): a low headland across the bay between the two karsts, the column rising from behind it
            put(L.light, `<g transform="translate(170,-385)"><g id="m1-colg"><path id="m1-col" d="M560,1000C540,880 500,760 540,640C580,520 500,400 560,260C600,160 700,90 800,50L880,80C780,140 690,220 670,330C650,460 700,580 660,720C640,840 650,930 660,1000Z" fill="#2a2420" opacity=".88"/>
              ${Plane.puffMk("m1c", 600, 980, 18, "dark", 110)}<circle cx="610" cy="994" r="34" fill="#ff7a2a" opacity=".85"/><circle cx="610" cy="994" r="15" fill="#ffd27a"/></g>
              <path d="M450,1003Q520,972 590,978Q650,966 710,982Q760,974 800,1003Z" fill="#4a5a5a"/></g>`);
            Plane.puffs(tl, "m1c", t0, d + 0.5, 18, { dx: 130, dy: -820, per: 1.9, op: 1 }); tl.fromTo("#m1-col", { scaleX: 0.95, svgOrigin: "610 1000" }, { scaleX: 1.08, svgOrigin: "610 1000", duration: 0.8, yoyo: true, repeat: Math.ceil(d / 0.8), ease: "sine.inOut", immediateRender: false }, t0); } })],
      ]);
      // ===== 23. next: the boarding pass =====
      add("next", { dark: 0, light: false, cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960), drift: { s: 0.01 } }] },
        fx(tl, id, t0, L) { PlaneUI.next(tl, L.light, t0, D("next"), { l1: "ตอนต่อไป · EP.2", l2: "ควันอีกฝั่งอ่าว", l3: "อย่าเดินไปหามัน" }); } });
