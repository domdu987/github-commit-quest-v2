      const A = (who, x, y, s, track, extra = {}) => ({ who, x, y, s, track, blinks: [0.7, 2.6], ...extra });
      const EMERG = { from: "right", rim: "#ff9a4a", rimOp: 0.65, shade: "#1a0a10", shadeOp: 0.45, cast: false, vol: false };
      const NIGHTL = { from: "right", rim: "#9fb8ff", rimOp: 0.55, shade: "#060a18", shadeOp: 0.5, cast: false, vol: false };
      const GEMR = { top: "#ff6a3a", bottom: "#1a0a10", op: 0.22 }, GNT = { top: "#2a3a6a", bottom: "#05070f", op: 0.28 };
      const KX = ROW30 + 40;
      const capt = (L, a, b) => put(L.light, `<g transform="translate(540,1560)"><rect x="-470" y="-62" width="940" height="200" rx="24" fill="#0a0c14" opacity=".72"/>
        <text y="2" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="46" fill="#fff">${a}</text><g transform="translate(0,90)"><rect x="-${b.length * 17 + 30}" y="-44" width="${b.length * 34 + 60}" height="68" rx="12" fill="#e2382e"/><text y="8" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="50" fill="#fff">${b}</text></g></g>`);
      const tag = (L, t) => put(L.light, `<g transform="translate(540,140)"><rect x="-120" y="-44" width="240" height="88" rx="44" fill="#ffd23a" stroke="#26201c" stroke-width="5"/><text y="18" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="52" fill="#26201c">${t}</text></g>`);
      add("e1a", { set: "cabinCut", setOpts: { id: "ha", state: "alarm", wingFire: true, wingX: 760, noBag: true }, dark: 0.1, light: EMERG, grade: GEMR,
        cam: { keys: [{ t: 0, ...fr(560, 1220, 1.5, 540, 1000) }] }, shake: (t) => ({ x: 9 * Math.sin(t * 31), y: 7 * Math.sin(t * 27), r: -3 + 2 * Math.sin(t * 2) }),
        actors: [A("kiw", KX + 220, PF - 6, 0.8, [{ t: 0, mode: "brace", eyes: "wide", mouth: "scream" }])],
        fx(tl, id, t0, L) { Plane.cabinLife(tl, "ha", t0, 3, { chase: true }); for (let k = 0; k < 7; k++) tl.fromTo(`#ha-mask${k}`, { y: -170 }, { y: 0, duration: 0.5, ease: "bounce.out", immediateRender: false }, t0 + 0.1 + k * 0.04);
          put(L.glow, `<g transform="translate(${KX + 300},${PF - 150})">${Plane.bag(0.9, { strap: false })}</g>`); tag(L, "A"); capt(L, "ถ้าเครื่องยนต์ไฟลุก ตอนคุณบินอยู่กลางแอตแลนติก…", "อย่าคว้ากระเป๋า"); } });
      add("e1b", { set: "planeSky", setOpts: { id: "sk", fire: true, s: 0.55, rot: 20, x: 640, y: 700, islandX: 260 }, dark: 0.05, light: false, grade: { top: "#ff9a6a", bottom: "#1a1030", op: 0.2 },
        cam: { keys: [{ t: 0, ...fr(560, 900, 1.05, 540, 900) }] }, shake: (t) => ({ x: 7 * Math.sin(t * 43), y: 5 * Math.sin(t * 37), r: 0 }),
        fx(tl, id, t0, L) { Plane.skyLife(tl, "sk", t0, 3, { cloud: 1600 }); tl.fromTo("#sk-jet", { x: 0, y: 0 }, { x: -300, y: 420, duration: 3, ease: "power1.in", immediateRender: false }, t0); tag(L, "B"); capt(L, "ถ้าเครื่องบินดิ่งลงทะเล ตอนคุณหลับอยู่แถวหลังสุด…", "อย่าคว้ากระเป๋า"); } });
      add("e1c", { set: "cabinAisle", setOpts: { id: "ca", state: "fire", bin: true, title: { l1: "รอดคนเดียว", l2: "EP.1" } }, dark: 0.22, light: false, grade: GEMR,
        cam: { keys: [{ t: 0, ...fr(540, 1010, 1.3, 540, 980) }] }, shake: (t) => ({ x: 9 * Math.sin(t * 31), y: 7 * Math.sin(t * 27), r: -4 + 2.5 * Math.sin(t * 2.2) }),
        fx(tl, id, t0, L) { Plane.aisleLife(tl, "ca", t0, 3); tag(L, "C"); capt(L, "ถ้าเครื่องบินหักกลางลำ ตอนคุณยังติดอยู่ในควัน…", "อย่าคว้ากระเป๋า"); } });
      add("e2a", { set: "crashSite", setOpts: { id: "cs", time: "rain", storm: true, fire: 0.25, smoke: false, spray: true }, dark: 0.15, light: NIGHTL, grade: GNT,
        cam: { keys: [{ t: 0, ...fr(480, 1360, 1.15, 540, 1000) }] }, shake: (t) => ({ x: 4 * Math.sin(t * 3), y: 3 * Math.sin(t * 2), r: 0.8 * Math.sin(t * 1.3) }),
        actors: [A("kiwHidden", 198, 1474, 0.15, [{ t: 0, mode: "holdHead", eyes: "wide", mouth: "scream" }])],
        fx(tl, id, t0, L) { Plane.siteLife(tl, "cs", t0, 3); tag(L, "A"); capt(L, "ถ้าคุณรอดจากเครื่องบินตกคนเดียว ตอนพายุเข้าเกาะ…", "อย่าเดินออกไปหาคนช่วย"); } });
      add("e2b", { set: "bayView", setOpts: { id: "bv", time: "night", torches: true }, dark: 0.12, light: NIGHTL, grade: GNT,
        cam: { keys: [{ t: 0, ...fr(560, 1080, 1.1, 540, 1000) }] }, shake: (t) => ({ x: 3 * Math.sin(t * 2), y: 2 * Math.sin(t * 1.7), r: 0.6 * Math.sin(t * 1.1) }),
        actors: [A("kiwHidden", 330, 1520, 0.62, [{ t: 0, mode: "walk", eyes: "wide", mouth: "o" }])],
        fx(tl, id, t0, L) { Plane.bayLife(tl, "bv", t0, 3); tag(L, "B"); capt(L, "ถ้าคุณเห็นไฟอีกฝั่งอ่าว ตอนติดเกาะคนเดียวตีสี่…", "อย่าเดินไปหามัน"); } });
      add("e2c", { set: "crashSite", setOpts: { id: "cs2", time: "rain", storm: true, fire: 0.7, spray: true }, dark: 0.1, light: NIGHTL, grade: GNT,
        cam: { keys: [{ t: 0, ...fr(560, 1300, 0.85, 540, 980) }] },
        fx(tl, id, t0, L) { Plane.siteLife(tl, "cs2", t0, 3); tag(L, "C"); capt(L, "ถ้าเครื่องบินคุณตกบนเกาะร้าง แล้วคุณรอดคนเดียว…", "อย่าทิ้งซากเครื่องบิน"); } });
