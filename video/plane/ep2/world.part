      // ---------- นาทีก่อนจม world (remake in the house style of ทะเลลด / ผีแม่ม่าย / เห็ดปอบ): the village canal road at 1 a.m. ----------
      // A full, lit world instead of a dark strip: a violet night with a big moon, the temple's string lights across the fields, wooden
      // houses with lit windows, ป้าแดง's shop under a fluorescent tube, the spirit house, banana trees, lamp posts with amber cones,
      // the road with its guardrail (a gap where the car goes in), the bank, and the canal full of reflections, hyacinth and a moored boat.
      // Same geometry as Canal.set (road at RY, water at WY) so every framing helper still works. Ids from o.id.
      const KL = { ink: "#1c1a2a", wood: "#6a4a34", woodL: "#8e6648", woodD: "#3e2a1e", roof: "#3c4256", roofL: "#5a6278", tile: "#8a3a2c", win: "#ffcf72",
        leaf: "#2f6a3c", leafL: "#79b85a", leafD: "#1c4428", road: "#2e3140", roadL: "#4a4c58", rail: "#c4c8d0", red: "#d8392e", gold: "#e8b860" };
      const KO = (w = 3) => `stroke="${KL.ink}" stroke-width="${w}" stroke-linejoin="round" stroke-linecap="round"`;
      Sets.DEFS += `
        <linearGradient id="klSky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0a0f2e"/><stop offset=".45" stop-color="#1c2360"/><stop offset=".78" stop-color="#3a3478"/><stop offset="1" stop-color="#7a4a78"/></linearGradient>
        <radialGradient id="klMoon"><stop offset="0" stop-color="#fff6dc" stop-opacity=".55"/><stop offset=".4" stop-color="#fff0c8" stop-opacity=".16"/><stop offset="1" stop-color="#fff0c8" stop-opacity="0"/></radialGradient>
        <linearGradient id="klWater" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2a4e78"/><stop offset=".4" stop-color="#1a3656"/><stop offset="1" stop-color="#0a1828"/></linearGradient>
        <radialGradient id="klLamp"><stop offset="0" stop-color="#ffe2a0" stop-opacity=".95"/><stop offset=".3" stop-color="#ffb860" stop-opacity=".4"/><stop offset="1" stop-color="#ffb860" stop-opacity="0"/></radialGradient>
        <radialGradient id="klWin"><stop offset="0" stop-color="#ffd890" stop-opacity=".7"/><stop offset="1" stop-color="#ffd890" stop-opacity="0"/></radialGradient>
        <radialGradient id="klTube"><stop offset="0" stop-color="#e8fff6" stop-opacity=".8"/><stop offset="1" stop-color="#bff0ff" stop-opacity="0"/></radialGradient>
        <radialGradient id="klBulb"><stop offset="0" stop-color="#fff0b0"/><stop offset=".35" stop-color="#ffc860" stop-opacity=".6"/><stop offset="1" stop-color="#ffc860" stop-opacity="0"/></radialGradient>
        <linearGradient id="klCone" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffd890" stop-opacity=".34"/><stop offset="1" stop-color="#ffd890" stop-opacity="0"/></linearGradient>
        <linearGradient id="klGlowH" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff9a6a" stop-opacity="0"/><stop offset="1" stop-color="#ff9a6a" stop-opacity=".32"/></linearGradient>
        <linearGradient id="klWinG" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffe6a8"/><stop offset="1" stop-color="#ffb850"/></linearGradient>`;
      const Klong = {};
      // a wooden house (side-front), ground at y; o.stilts lifts it, o.lit [win…] windows lit, o.roof colour
      Klong.house = (x, y, s, o = {}) => {
        const st = o.stilts ? 70 : 0, W = 300, H = 190, rc = o.roof || KL.roof;
        let g = `<g transform="translate(${x},${y}) scale(${s})">`;
        if (st) g += [-120, -40, 40, 120].map((px) => `<rect x="${px - 7}" y="${-st}" width="14" height="${st}" fill="${KL.woodD}" ${KO(2.4)}/>`).join("") + `<path d="M-150,${-st + 6}H150" stroke="${KL.woodD}" stroke-width="8"/>`;
        g += `<rect x="${-W / 2}" y="${-st - H}" width="${W}" height="${H}" fill="${KL.wood}" ${KO()}/>` +
          Array.from({ length: 9 }, (_, k) => `<path d="M${-W / 2 + 4},${-st - H + 18 + k * 20}H${W / 2 - 4}" stroke="${KL.woodD}" stroke-width="2.4" opacity=".55"/>`).join("") +
          `<path d="M${-W / 2},${-st - H}H${W / 2}" stroke="${KL.woodL}" stroke-width="5" opacity=".7"/>`;
        // the roof: a tall gable with a dark eave line and a lit rim
        g += `<path d="M${-W / 2 - 34},${-st - H + 6}L0,${-st - H - 120}L${W / 2 + 34},${-st - H + 6}Z" fill="${rc}" ${KO()}/><path d="M${-W / 2 - 34},${-st - H + 6}L0,${-st - H - 120}" stroke="#9aa6c8" stroke-width="4" opacity=".5"/>
          ${Array.from({ length: 7 }, (_, k) => `<path d="M${-W / 2 - 20 + k * 52},${-st - H}L${-W / 2 - 20 + k * 52 + (k < 3.5 ? 26 : -26) * 0.4},${-st - H - 60 + Math.abs(k - 3) * 14}" stroke="${KL.ink}" stroke-width="2" opacity=".35"/>`).join("")}`;
        // windows: shutters open, warm light, a curtain edge; a door
        const wins = o.wins || [[-90, -st - 120], [60, -st - 120]];
        wins.forEach(([wx, wy], k) => {
          const lit = (o.lit || [0, 1]).includes(k);
          g += `<rect x="${wx - 30}" y="${wy - 34}" width="60" height="68" fill="${lit ? "url(#klWinG)" : "#1a2030"}" ${KO(2.6)}/>` + (lit ? `<path d="M${wx - 30},${wy - 34}h18v68h-18Z" fill="#c86a3a" opacity=".55"/><path d="M${wx},${wy - 34}v68M${wx - 30},${wy}h60" stroke="${KL.woodD}" stroke-width="3"/>` : `<path d="M${wx},${wy - 34}v68" stroke="${KL.woodD}" stroke-width="3"/>`) +
            `<path d="M${wx - 52},${wy - 36}h22v72h-22Z M${wx + 30},${wy - 36}h22v72h-22Z" fill="${KL.woodL}" ${KO(2.2)}/>`;
        });
        if (o.door !== false) g += `<rect x="-14" y="${-st - 112}" width="50" height="112" fill="${KL.woodD}" ${KO(2.6)}/><circle cx="26" cy="${-st - 56}" r="3" fill="${KL.gold}"/>`;
        if (st) g += `<path d="M-14,${-st}L-54,0M36,${-st}L76,0" stroke="${KL.woodD}" stroke-width="7"/>${[0, 1, 2, 3].map((k) => `<path d="M${-22 - k * 10},${-st + 14 + k * 16}h${54 + k * 20}" stroke="${KL.woodD}" stroke-width="5"/>`).join("")}`;
        return g + `</g>`;
      };
      // a banana clump: trunk(s) and big split leaves, lamp-lit edges
      Klong.banana = (x, y, s, flip = 1) => {
        const P = (a, L, W) => { const c = Math.cos((a * Math.PI) / 180), n = Math.sin((a * Math.PI) / 180), mx = (L / 2) * c, my = (L / 2) * n;
          return `M0,0Q${f1(mx - W * n)},${f1(my + W * c)} ${f1(L * c)},${f1(L * n)}Q${f1(mx + W * n)},${f1(my - W * c)} 0,0Z`; };
        let g = `<g transform="translate(${x},${y}) scale(${s * flip},${s})"><path d="M-10,0Q-16,-120 -6,-240H16Q22,-120 14,0Z" fill="#5a6a3a" ${KO(2.4)}/><path d="M-2,-20Q-6,-120 0,-230" stroke="#7a8a4a" stroke-width="4" opacity=".6"/>`;
        [[-168, 230, 42, 1], [-138, 250, 46, 0], [-108, 220, 40, 1], [-72, 230, 44, 0], [-40, 250, 46, 1], [-8, 230, 42, 0], [18, 190, 36, 1]].forEach(([a, L, W, k]) => {
          const c = Math.cos((a * Math.PI) / 180), n = Math.sin((a * Math.PI) / 180);
          g += `<g transform="translate(2,-232)"><path d="${P(a, L, W)}" fill="${k ? KL.leaf : "#3a7a44"}" ${KO(2.2)}/><path d="M0,0L${f1(L * c * 0.96)},${f1(L * n * 0.96)}" stroke="${KL.leafL}" stroke-width="3.5" opacity=".7"/>
            ${[0.35, 0.55, 0.75].map((q) => `<path d="M${f1(L * c * q)},${f1(L * n * q)}l${f1(-n * W * 0.8)},${f1(c * W * 0.8)}" stroke="${KL.leafD}" stroke-width="2" opacity=".55"/>`).join("")}</g>`;
        });
        return g + `</g>`;
      };
      // the spirit house on its pillar: red and gold, a tiny lamp, marigold garlands, a glass of red soda
      Klong.shrine = (x, y, s) => `<g transform="translate(${x},${y}) scale(${s})">
        <rect x="-12" y="-150" width="24" height="150" fill="#e8e2d6" ${KO(2.4)}/><rect x="-46" y="-162" width="92" height="14" fill="#e8e2d6" ${KO(2.4)}/>
        <rect x="-38" y="-240" width="76" height="80" fill="${KL.red}" ${KO(2.6)}/><path d="M-30,-232h60v64h-60Z" fill="#7a1a14"/><circle cx="0" cy="-205" r="9" fill="#ffd36a"/>
        <path d="M-52,-238L0,-290L52,-238Z" fill="${KL.gold}" ${KO(2.6)}/><path d="M-40,-262L0,-312L40,-262" fill="none" stroke="${KL.gold}" stroke-width="7"/><path d="M0,-312V-336" stroke="${KL.gold}" stroke-width="5"/>
        <path d="M-52,-238Q-62,-254 -66,-246M52,-238Q62,-254 66,-246" stroke="${KL.gold}" stroke-width="6" fill="none"/>
        <path d="M-40,-166q20,22 40,0q20,22 40,0" stroke="#ff9a2a" stroke-width="8" fill="none" stroke-dasharray="3 5"/>
        <rect x="24" y="-178" width="10" height="16" fill="#e8302a" opacity=".85"/></g>`;
      // ป้าแดง's shop: a shophouse front, roller shutter half up, the fluorescent tube under the awning, a sign, crates of drinks
      Klong.shop = (x, y, s) => `<g transform="translate(${x},${y}) scale(${s})">
        <rect x="-170" y="-260" width="340" height="260" fill="#7c8496" ${KO()}/><rect x="-170" y="-260" width="340" height="26" fill="#949cb0" ${KO(2.4)}/>
        <rect x="-150" y="-200" width="300" height="200" fill="#2a2420"/><rect x="-150" y="-200" width="300" height="86" fill="#a8b0bc" ${KO(2.4)}/>
        ${Array.from({ length: 8 }, (_, k) => `<path d="M-150,${-192 + k * 10}H150" stroke="#7c8494" stroke-width="2"/>`).join("")}
        <rect x="-140" y="-112" width="120" height="112" fill="#3a3028"/>${[0, 1, 2].map((k) => `<rect x="${-134 + k * 38}" y="-100" width="30" height="20" fill="${["#e8402a", "#2a8ad8", "#f2c040"][k]}" opacity=".8"/>`).join("")}
        ${[0, 1].map((k) => `<rect x="${-134}" y="${-70 + k * 34}" width="108" height="26" fill="#5a4a3a" ${KO(1.8)}/>`).join("")}
        <path d="M-196,-210H196L180,-176H-180Z" fill="#2f6ad8" ${KO(2.6)}/>${Array.from({ length: 7 }, (_, k) => `<path d="M${-180 + k * 60},-176l12,-34" stroke="#fff" stroke-width="10" opacity=".85"/>`).join("")}
        <rect x="-110" y="-252" width="220" height="40" rx="6" fill="#f2ecd8" ${KO(2.2)}/><text x="0" y="-222" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="28" fill="#b82a20">ร้านป้าแดง</text>
        <rect id="klTube" x="-60" y="-174" width="120" height="8" rx="4" fill="#f0fffa"/>
        <rect x="40" y="-60" width="70" height="60" fill="#c8302a" ${KO(2.2)}/><rect x="46" y="-54" width="58" height="22" fill="#e8e0d0"/></g>`;
      // a lamp post (concrete, curved arm, sodium head) at ground y; glow drawn separately
      Klong.lamp = (x, y, h = 490) => `<path d="M${x},${y}V${y - h}Q${x},${y - h - 40} ${x + 52},${y - h - 40}" stroke="#4a4e5a" stroke-width="12" fill="none"/><path d="M${x - 3},${y}V${y - h}" stroke="#7a7e8a" stroke-width="3" opacity=".6"/>
        <rect x="${x + 40}" y="${y - h - 52}" width="50" height="18" rx="7" fill="#3a3e48" ${KO(2)}/><rect x="${x + 44}" y="${y - h - 38}" width="42" height="7" rx="3" fill="#ffe6a6"/>`;
      // the guardrail along the canal side of the road: white posts with red bands and a steel rail, with a gap
      Klong.rail = (y, gap = [600, 860]) => {
        let g = "";
        for (let x = -1180; x < 2300; x += 120) { if (x > gap[0] - 40 && x < gap[1] + 40) continue; g += `<rect x="${x - 9}" y="${y - 58}" width="18" height="62" fill="#ece8e0" ${KO(2.2)}/><rect x="${x - 9}" y="${y - 50}" width="18" height="12" fill="${KL.red}"/>`; }
        const seg = (a, b) => `<path d="M${a},${y - 40}H${b}" stroke="${KL.rail}" stroke-width="16" stroke-linecap="round"/><path d="M${a},${y - 46}H${b}" stroke="#f4f6fa" stroke-width="4" opacity=".6"/><path d="M${a},${y - 34}H${b}" stroke="#6a7080" stroke-width="3" opacity=".7"/>`;
        return g + seg(-1190, gap[0] - 40) + seg(gap[1] + 40, 2300) + `<path d="M${gap[0] - 40},${y - 40}l26,22M${gap[1] + 40},${y - 40}l-26,22" stroke="${KL.rail}" stroke-width="12" stroke-linecap="round"/>`;
      };
      // a coconut palm silhouette
      Klong.palm = (x, y, s, c = "#10153a") => `<g transform="translate(${x},${y}) scale(${s})"><path d="M-6,0Q-24,-160 10,-330" stroke="${c}" stroke-width="16" fill="none"/>
        ${[-150, -110, -60, -10, 40, 90, 140].map((a) => `<path d="M10,-330q${Math.sin((a * Math.PI) / 180) * 90},${-Math.cos((a * Math.PI) / 180) * 40 - 20} ${Math.sin((a * Math.PI) / 180) * 170},${-Math.cos((a * Math.PI) / 180) * 70 + 50}" stroke="${c}" stroke-width="12" fill="none" stroke-linecap="round"/>`).join("")}</g>`;
      // the long-tail boat moored at a post, bow left
      Klong.boat = (x, y, s) => `<g transform="translate(${x},${y}) scale(${s})"><path d="M-260,-30Q-300,-70 -320,-90Q-200,-40 0,-36Q160,-34 240,-50L250,-14Q120,10 -40,8Q-200,6 -260,-30Z" fill="${KL.wood}" ${KO(3)}/>
        <path d="M-300,-74Q-200,-36 0,-32Q150,-30 244,-44" stroke="#2f6ad8" stroke-width="8" fill="none"/><path d="M-280,-60Q-200,-26 0,-22" stroke="${KL.woodL}" stroke-width="4" fill="none" opacity=".7"/>
        <path d="M-316,-92l-6,-14" stroke="#e8b860" stroke-width="5"/><path d="M-322,-108q-10,4 -6,14" stroke="#ff8a3a" stroke-width="5" fill="none"/><path d="M-120,-34v-10M60,-34v-10" stroke="${KL.woodD}" stroke-width="10"/></g>`;
      // a clump of water hyacinth floating (class klHy bobs)
      Klong.hyacinth = (x, y, s) => `<g class="klHy"><g transform="translate(${x},${y}) scale(${s})">${[-60, -30, 0, 30, 58].map((dx, k) => `<path d="M${dx},0q${-14 + k * 6},-40 ${4 + k * 3},-${46 + (k % 2) * 14}q22,10 10,46Z" fill="${k % 2 ? KL.leaf : "#3a8a4c"}" ${KO(2)}/>`).join("")}
        <path d="M-6,-44q6,-26 2,-46" stroke="#3a7a3a" stroke-width="4"/>${[[-4, -96], [8, -84], [-14, -80]].map(([a, b]) => `<circle cx="${a}" cy="${b}" r="9" fill="#c4a6e8" ${KO(1.6)}/><circle cx="${a}" cy="${b}" r="3" fill="#ffd36a"/>`).join("")}
        <ellipse cx="0" cy="4" rx="80" ry="10" fill="#0a1a24" opacity=".5"/></g></g>`;
      // the green road sign with the series title (the opener's in-world title)
      Klong.titleSign = (x, y, o = {}) => `<g transform="translate(${x},${y})"><rect x="-160" y="-300" width="14" height="300" fill="#8a909c" ${KO(2.4)}/><rect x="146" y="-300" width="14" height="300" fill="#8a909c" ${KO(2.4)}/>
        <g id="${o.id || "klts"}"><rect x="-250" y="-480" width="500" height="210" rx="16" fill="#1e7a4a" ${KO(4)}/><rect x="-238" y="-468" width="476" height="186" rx="10" fill="none" stroke="#f4f8f4" stroke-width="6"/>
        <text x="0" y="-380" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="78" fill="#ffffff">นาทีก่อนจม</text>
        <text x="0" y="-324" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="32" fill="#e8f4ea">${o.sub || "EP.1"}</text>
        <path d="M-210,-300h60l-14,-12M-150,-300l-14,12" stroke="#f4f8f4" stroke-width="5" fill="none" opacity="${o.arrow === false ? 0 : 0.9}"/>
        <rect id="${o.id || "klts"}-shine" x="-250" y="-480" width="500" height="210" rx="16" fill="#fff8e0" opacity="0"/></g></g>`;
      // the curve warning sign (yellow diamond with a bend arrow)
      Klong.curveSign = (x, y) => `<g transform="translate(${x},${y})"><rect x="-6" y="-250" width="12" height="250" fill="#8a909c" ${KO(2)}/><g transform="translate(0,-300) rotate(45)"><rect x="-56" y="-56" width="112" height="112" rx="10" fill="#f2c020" ${KO(4)}/></g>
        <path d="M-16,-268v-34q0,-22 22,-22h10" stroke="${KL.ink}" stroke-width="10" fill="none"/><path d="M12,-340l18,16l-18,16Z" fill="${KL.ink}"/></g>`;

      Sets.klong = (L, o = {}) => {
        const id = o.id || "kl", gap = o.gap || [600, 860];
        // sky: violet night, stars, the moon with its halo, two lit clouds
        put(L.sky, `<rect x="-1200" y="-800" width="3500" height="2400" fill="url(#klSky)"/><rect x="-1200" y="700" width="3500" height="420" fill="url(#klGlowH)"/>
          ${Array.from({ length: 90 }, (_, k) => `<circle class="${id}-st" cx="${f1(-600 + ((k * 397) % 2300))}" cy="${f1(-400 + ((k * 211) % 1100))}" r="${f1(1 + (k % 3) * 0.9)}" fill="#fff" opacity="${(0.3 + (k % 4) * 0.15).toFixed(2)}"/>`).join("")}
          <circle cx="${o.moonX ?? 860}" cy="${o.moonY ?? 230}" r="300" fill="url(#klMoon)"/><circle cx="${o.moonX ?? 860}" cy="${o.moonY ?? 230}" r="66" fill="#fff6dc"/>
          <circle cx="${(o.moonX ?? 860) - 20}" cy="${(o.moonY ?? 230) - 12}" r="14" fill="#efe2bc" opacity=".6"/><circle cx="${(o.moonX ?? 860) + 22}" cy="${(o.moonY ?? 230) + 18}" r="9" fill="#efe2bc" opacity=".5"/>
          ${[[-420, 330, 420], [380, 120, 300], [1260, 300, 380]].map(([x, y, w]) => `<g opacity=".85"><path d="M${x},${y}q${w * 0.18},-50 ${w * 0.42},-18q${w * 0.2},-46 ${w * 0.42},-6q${w * 0.16},2 ${w * 0.16},24Z" fill="#2c2f6a"/><path d="M${x + w * 0.06},${y - 14}q${w * 0.16},-42 ${w * 0.36},-14" stroke="#b8b0e8" stroke-width="4" fill="none" opacity=".55"/></g>`).join("")}`);
        // far: tree line, palms, the temple with its lit roof edges and string lights, a phone mast blinking
        let far = `<path d="M-1200,1000Q-1000,930 -820,960T-420,940T0,965T420,930T820,955T1300,935T2300,960V1060H-1200Z" fill="#161b44"/>`;
        far += [-760, -540, 160, 1180, 1420].map((x, k) => Klong.palm(x, 980, 0.8 + (k % 3) * 0.12)).join("");
        far += `<g transform="translate(${o.templeX ?? -260},965)"><path d="M-120,0V-80H120V0Z" fill="#232a5a"/><path d="M-150,-78L0,-150L150,-78Z" fill="#2c2a5a" stroke="#e8b860" stroke-width="4"/>
          <path d="M-100,-128L0,-190L100,-128Z" fill="#2c2a5a" stroke="#e8b860" stroke-width="4"/><path d="M0,-190V-240" stroke="#e8b860" stroke-width="5"/><path d="M-150,-78q-10,-26 -26,-28M150,-78q10,-26 26,-28" stroke="#e8b860" stroke-width="5" fill="none"/></g>`;
        far += `<path d="M${(o.templeX ?? -260) - 360},950Q${(o.templeX ?? -260) - 180},990 ${o.templeX ?? -260},960T${(o.templeX ?? -260) + 360},950" stroke="#3a3a5a" stroke-width="2" fill="none"/>`;
        far += `<path d="M1500,960V700M1480,960L1500,700L1520,960" stroke="#2a2e58" stroke-width="5" fill="none"/><circle id="${id}-mast" cx="1500" cy="696" r="7" fill="#ff3a2a"/>`;
        put(L.far, far);
        // the canal: deep blue water, the moon's broken column, the lamps' streaks, ripples (drawn before the bank)
        let wa = `<rect x="-1200" y="${WY - 60}" width="3500" height="1500" fill="url(#klWater)"/>`;
        for (let j = 0; j < 14; j++) wa += `<path d="M${(o.moonX ?? 860) - 50 + (j % 3) * 20},${WY - 30 + j * 34}h${100 - j * 5}" stroke="#fff4d0" stroke-width="${8 - j * 0.35}" opacity="${(0.85 - j * 0.05).toFixed(2)}" stroke-linecap="round"/>`;
        [-500, 150, 560, 970, 1400].forEach((x, k) => { for (let j = 0; j < 10; j++) wa += `<path d="M${x + 30 + (j % 2) * 18},${WY - 34 + j * 36}h${70 - j * 5}" stroke="#ffcf80" stroke-width="6" opacity="${(0.7 - j * 0.06).toFixed(2)}" stroke-linecap="round"/>`; });
        [[-430, "#ffd890"], [470, "#ffd890"], [1000, "#ffd890"], [90, "#cfeeff"]].forEach(([x, c]) => { for (let j = 0; j < 6; j++) wa += `<path d="M${x - 20 + (j % 2) * 10},${WY - 20 + j * 30}h${44 - j * 5}" stroke="${c}" stroke-width="4" opacity="${(0.45 - j * 0.06).toFixed(2)}" stroke-linecap="round"/>`; });
        for (let k = 0; k < 40; k++) wa += `<path d="M${-1000 + ((k * 263) % 3200)},${WY - 20 + ((k * 37) % 420)}q30,-6 60,0" stroke="#8ab8d8" stroke-width="3" opacity=".28" fill="none" stroke-linecap="round"/>`;
        // the village behind the road: houses with lit windows, the shop, the spirit house, banana trees, power poles and wires
        const G = RY - 70;
        let vil = `<path d="M-1200,${G}H2300V${G - 30}H-1200Z" fill="#20253a"/>`;
        vil += [-1000, -380, 240, 900, 1560].map((x) => `<path d="M${x},${G}V${G - 420}" stroke="#2a2a3a" stroke-width="12"/><path d="M${x - 40},${G - 400}h80" stroke="#2a2a3a" stroke-width="8"/>`).join("");
        vil += `<path d="M-1000,${G - 396}Q-690,${G - 340} -380,${G - 396}T240,${G - 396}T900,${G - 396}T1560,${G - 396}" stroke="#1a1a2a" stroke-width="3" fill="none"/><path d="M-1000,${G - 380}Q-690,${G - 320} -380,${G - 380}T240,${G - 380}T900,${G - 380}T1560,${G - 380}" stroke="#1a1a2a" stroke-width="2.4" fill="none"/>`;
        vil += Klong.banana(-640, G, 0.9) + Klong.house(-430, G, 0.82, { stilts: true, lit: [0], roof: KL.tile }) + Klong.shrine(-200, G, 0.62);
        vil += Klong.shop(90, G, 0.82) + Klong.banana(330, G, 0.82, -1) + Klong.house(470, G, 0.78, { lit: [1] }) + Klong.banana(1180, G, 1.0);
        vil += Klong.house(1000, G, 0.86, { stilts: true, lit: [0, 1], roof: "#4a5a7a" }) + Klong.house(1420, G, 0.8, { lit: [0], roof: KL.tile }) + Klong.banana(-1060, G, 0.95, -1);
        put(L.mid, `<g id="${id}-water">${wa}</g>${vil}`);
        // the road, its lamps, the guardrail (with the gap), the signs, the bank down to the water, the boat and the hyacinth
        let s = `<path d="M-1200,${RY - 70}H2300V${RY + 34}H-1200Z" fill="${KL.road}"/>${[-500, 150, 560, 970, 1400].map((x) => `<ellipse cx="${x + 70}" cy="${RY - 10}" rx="230" ry="46" fill="#5a5660" opacity=".45"/>`).join("")}
          <path d="M-1200,${RY - 66}H2300" stroke="#c8c0a8" stroke-width="5" opacity=".6"/><path d="M-1200,${RY + 28}H2300" stroke="#ece4cc" stroke-width="6" opacity=".8"/>
          ${Array.from({ length: 14 }, (_, k) => `<path d="M${-1100 + k * 260},${RY - 18}h130" stroke="#f0c850" stroke-width="7" opacity=".8"/>`).join("")}`;
        s += [-500, 150, 560, 970, 1400].map((x) => Klong.lamp(x, RY - 66)).join("");
        s += `<path d="M-1200,${RY + 30}H2300V${WY - 30}Q1600,${WY} 900,${WY - 26}T-1200,${WY - 30}Z" fill="#1c3626"/>`;
        for (let k = 0; k < 70; k++) { const x = -1150 + k * 50 + ((k * 31) % 30); s += `<path d="M${x},${WY - 26}q${(k % 3) - 1 * 8},-50 ${(k % 2 ? 1 : -1) * 12},-${46 + (k % 5) * 12}" stroke="${k % 4 ? "#2e5a34" : "#4a7a3a"}" stroke-width="5" fill="none"/>`; }
        for (let k = 0; k < 16; k++) s += `<circle cx="${-1100 + k * 210 + (k % 3) * 40}" cy="${RY + 70 + (k % 4) * 22}" r="5" fill="${k % 2 ? "#f4ecd8" : "#ffd36a"}" opacity=".85"/>`;
        s += Klong.rail(RY + 34, gap);
        if (o.title) s += Klong.titleSign(o.title.x ?? 380, RY - 66, o.title);
        if (o.curve !== false) s += Klong.curveSign(o.curveX ?? 1100, RY - 66);
        s += Klong.boat(o.boatX ?? -300, WY + 70, 0.9) + `<rect x="${(o.boatX ?? -300) + 270}" y="${WY - 60}" width="16" height="190" fill="${KL.woodD}" ${KO(2)}/><path d="M${(o.boatX ?? -300) + 240},${WY + 30}L${(o.boatX ?? -300) + 276},${WY - 30}" stroke="#c8b890" stroke-width="3"/>`;
        s += [[-760, WY + 40, 0.9], [120, WY + 120, 1.0], [1260, WY + 60, 0.85], [1700, WY + 150, 1.1]].map(([x, y, sc]) => Klong.hyacinth(x, y, sc)).join("");
        put(L.set, s);
        // foreground reeds, out of focus
        put(L.fg, `<g opacity=".95">${Array.from({ length: 18 }, (_, k) => { const x = k < 9 ? -160 + k * 34 : 940 + (k - 9) * 34; return `<path d="M${x},1990q${(k % 3 - 1) * 24},-260 ${(k % 2 ? 44 : -34)},-${380 + (k % 5) * 70}" stroke="#0c1a12" stroke-width="${18 + (k % 3) * 6}" fill="none" stroke-linecap="round"/>`; }).join("")}</g>`);
        // light: the lamp heads and their cones, the lit windows' spill, the shop's tube, the shrine's red lamp, the string lights
        let gl = [-500, 150, 560, 970, 1400].map((x) => `<circle cx="${x + 65}" cy="${RY - 66 - 490 - 30}" r="120" fill="url(#klLamp)"/><path d="M${x + 65},${RY - 586}L${x - 120},${RY + 30}H${x + 270}Z" fill="url(#klCone)"/>`).join("");
        gl += `<ellipse cx="90" cy="${G - 140}" rx="200" ry="110" fill="url(#klTube)" opacity=".8"/><circle cx="-200" cy="${G - 120}" r="36" fill="url(#klBulb)" opacity=".8"/>`;
        gl += [[-470, G - 160], [470, G - 110], [1000, G - 160], [1060, G - 160], [1420, G - 110]].map(([x, y]) => `<circle cx="${x}" cy="${y}" r="80" fill="url(#klWin)" opacity=".7"/>`).join("");
        const tx = o.templeX ?? -260;
        gl += Array.from({ length: 22 }, (_, k) => { const x = tx - 340 + k * 32, y = 952 + Math.sin((k / 21) * Math.PI) * 30; return `<circle class="${id}-sl" cx="${x}" cy="${y}" r="5" fill="${["#ffd36a", "#ff8a5a", "#9affc8", "#8ac8ff"][k % 4]}"/><circle cx="${x}" cy="${y}" r="16" fill="url(#klBulb)" opacity=".5"/>`; }).join("");
        gl += `<path d="M${tx - 150},887L${tx},815L${tx + 150},887" stroke="#ffd890" stroke-width="3" fill="none" opacity=".7"/>`;
        put(L.glow, gl);
        // the night's small life (moths at the lamps, fireflies over the water)
        put(L.act, `<g>${[150, 560, 970].map((x, k) => [0, 1, 2].map((j) => `<circle id="${id}-b${k}${j}" cx="${x + 65}" cy="${RY - 590}" r="3" fill="#fff3c8" opacity=".85"/>`).join("")).join("")}</g>
          <g>${Array.from({ length: 14 }, (_, k) => `<circle id="${id}-f${k}" cx="${-500 + k * 150 + (k % 3) * 30}" cy="${WY - 80 - (k % 4) * 26}" r="5" fill="#d8ff8a" opacity="0"/>`).join("")}</g>`);
      };
      Klong.life = (tl, id, t0, dur) => {
        tl.fromTo(`#${id}-water`, { x: -7 }, { x: 7, duration: 1.4, repeat: Math.ceil(dur / 1.4), yoyo: true, ease: "sine.inOut", immediateRender: false }, t0);
        tl.fromTo(`.${id}-sl`, { opacity: 1 }, { opacity: 0.35, duration: 0.5, repeat: Math.ceil(dur / 0.5), yoyo: true, stagger: { each: 0.09, from: "random" }, ease: "sine.inOut", immediateRender: false }, t0);
        tl.fromTo(`.${id}-st`, { opacity: 0.9 }, { opacity: 0.3, duration: 0.8, repeat: Math.ceil(dur / 0.8), yoyo: true, stagger: { each: 0.05, from: "random" }, ease: "sine.inOut", immediateRender: false }, t0);
        tl.fromTo(`#${id}-mast`, { opacity: 1 }, { opacity: 0.15, duration: 0.5, repeat: Math.ceil(dur / 0.5), yoyo: true, ease: "steps(1)", immediateRender: false }, t0);
        tl.fromTo(".klHy", { y: -3 }, { y: 3, duration: 1.6, repeat: Math.ceil(dur / 1.6), yoyo: true, stagger: 0.4, ease: "sine.inOut", immediateRender: false }, t0);
        for (let k = 0; k < 3; k++) for (let j = 0; j < 3; j++) { const a = (j / 3) * Math.PI * 2, R = 24 + j * 9;
          tl.fromTo(`#${id}-b${k}${j}`, { x: Math.cos(a) * R, y: Math.sin(a) * R }, { x: Math.cos(a + 6.28) * R, y: Math.sin(a + 6.28) * R * 0.6, duration: 1.1 + j * 0.2, repeat: Math.ceil(dur), ease: "none", immediateRender: false }, t0); }
        for (let k = 0; k < 14; k++) tl.fromTo(`#${id}-f${k}`, { opacity: 0 }, { opacity: 0.9, duration: 0.5, yoyo: true, repeat: Math.ceil(dur / 1.0), repeatDelay: 0.3 + (k % 4) * 0.25, ease: "sine.inOut", immediateRender: false }, t0 + (k % 5) * 0.23);
      };
