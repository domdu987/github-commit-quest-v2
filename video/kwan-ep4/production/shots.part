
      // ---------- ควันหลง EP.1 ประตูร้อน: helpers ----------
      const tf = (tl, sel, t, dur, to, ease = "power2.inOut") => tl.to(sel, { attr: { transform: to }, duration: dur, ease, immediateRender: false }, t);
      const put = (el, html) => el.insertAdjacentHTML("beforeend", html);
      const split = (k, at, A, B) => {
        add(k, A); shots[shots.length - 1].dur = at;
        add(k, B); const sh = shots[shots.length - 1]; sh.start = SH[k].start + at; sh.dur = D(k) - at;
      };
      const capsFrom = (k, at, lines, o) => caps(k, lines, o).filter((c) => c.end > at + 0.05).map((c) => ({ ...c, t: Math.max(0, c.t - at), end: c.end - at }));
      // room 714 framings (world points of the panorama; see kwan.js)
      const V = {
        ceil: fr(1450, 230, 1.05, 540, 900),         // lying in bed, looking up
        door: fr(545, 1060, 1.05, 540, 1000),         // standing, facing the door
        knob: fr(730, 1110, 1.9, 600, 1000),
        notice: fr(545, 1025, 2.6, 540, 920),
        hw: fr(560, 1112, 3.3, 540, 900),             // the handwriting
        sign: fr(600, 1172, 4.6, 540, 900),           // "— ดาว 714 / 2539"
        gap: fr(540, 1500, 2.3, 540, 1250),           // crouched at the gap under the door
        bed: fr(1650, 1230, 1.12, 540, 1000),         // แพร's bed
        win: fr(2740, 1010, 1.12, 540, 900),
        floor: fr(1500, 1470, 1.3, 540, 760),         // flat on the floor, looking under แพร's bed
      };
      // the phone torch on a shot: o = Pov.torch options; returns { extra, drive } to merge into the spec
      const torch = (k, o) => { const T = Pov.torch(`t-${k}`, o); return { extra: (L) => put(L.light, T.markup), drive: T.drive }; };
      const withTorch = (k, o, spec) => {
        const T = torch(k, o), ex = spec.extra, f = spec.fx;
        return { ...spec, extra(L, id) { if (ex) ex(L, id); T.extra(L, id); }, fx(tl, id, t0, L) { T.drive(tl, t0, D(k)); if (f) f(tl, id, t0, L); } };
      };
      const knock = (tl, t, n = 3, gap = 0.22) => { for (let i = 0; i < n; i++) tl.fromTo("#rm-door", { attr: { transform: "translate(0,0)" } }, { attr: { transform: `translate(${i % 2 ? -5 : 6},0)` }, duration: 0.05, yoyo: true, repeat: 1, immediateRender: false }, t + i * gap); };
      const steps = (k, label, items, at, endAt, o = {}) => ({ type: "steps", t: at, label, items, gap: o.gap ?? 0.5, top: o.top ?? 210, end: endAt ?? D(k) - 0.2 });
      const RM = (o = {}) => ({ id: "rm", ...o });
      // ---------- "คุณ" seen from outside (user: "ไม่ได้หมายถึงให้ทำแต่มุมมองคนที่1 แค่ให้ทำหลายๆมุมกล้อง"): the story now cuts between
      // your own eyes and other angles — wide, low, from the floor, over your shoulder, from the street. You: a first-year in blue
      // pyjamas (the same sleeves as the first-person hands), hair in a messy bun, barefoot.
      Rig.CAST.you = {
        skin: "#ecc19a", skinS: "#cc9a74", top: "#5d6f8f", topS: "#4a5a78", sleeve: "#5d6f8f", sleeveS: "#4a5a78", forearm: "#5d6f8f", forearmS: "#4a5a78",
        pants: "#5d6f8f", pantsS: "#4a5a78", shoe: "#ecc19a", belt: "#4a5a78",
        torsoExtra: `<path d="M-30,-484L0,-452L30,-484" fill="#7f91b2" stroke="#2e2a26" stroke-width="3.5" stroke-linejoin="round"/>${[-430, -395, -360].map((y) => `<circle cx="0" cy="${y}" r="4" fill="#e8e4d8"/>`).join("")}
          ${[[-34, -440], [26, -420], [-20, -380], [34, -360], [-36, -340]].map(([x, y]) => `<path d="M${x},${y - 7}l2,5l5,1l-4,3l1,5l-4,-3l-4,3l1,-5l-4,-3l5,-1z" fill="#e8e4d8" opacity=".75"/>`).join("")}
          <path d="M-56,-334H56" stroke="#7f91b2" stroke-width="8"/>`,
        hair: `<path d="M-48,-540Q-56,-606 0,-610Q54,-606 48,-544Q44,-524 36,-512Q34,-560 28,-574Q-2,-560 -32,-572Q-40,-540 -40,-514Q-50,-522 -48,-540Z" fill="#2a201c" stroke="#2e2a26" stroke-width="3.5"/>
          <circle cx="8" cy="-622" r="27" fill="#2a201c" stroke="#2e2a26" stroke-width="3.5"/><path d="M-6,-600q-14,-30 6,-44M24,-604q16,-20 2,-40" stroke="#2a201c" stroke-width="6" fill="none" stroke-linecap="round"/>
          <path d="M-44,-548q-12,24 -4,44M42,-552q10,22 4,40" stroke="#2a201c" stroke-width="5" fill="none" stroke-linecap="round"/><path d="M-16,-600q16,-8 34,0" stroke="#e07a8a" stroke-width="7" fill="none" stroke-linecap="round"/>`,
        face: `<g fill="#e0907a" opacity=".55"><ellipse cx="-26" cy="-526" rx="8" ry="4"/><ellipse cx="32" cy="-526" rx="8" ry="4"/></g>`,
      };
      // flat on the floor under the smoke, pulling yourself forward (the whole body tipped over like "lie", arms reaching ahead)
      Rig.MODES.crawl = (u, o) => { const w = Math.sin(u * 2 * Math.PI / 0.9); return { ...Rig.MODES.lie(u, o), thF: -14 + 12 * w, shF: 30 + 10 * w, thB: 6 - 12 * w, shB: 24 - 10 * w, uaF: -160 + 16 * w, faF: -10, uaB: -150 - 16 * w, faB: -14, head: -30, rootR: -82, rootY: -30 }; };
      // sitting on the floor at the door, both arms reaching forward (pushing the towel into the gap)
      Rig.MODES.kneelPush = (u, o) => { const w = Math.sin(u * 2 * Math.PI / 0.6); return { ...Rig.MODES.sit(u, o), torso: 24, head: -10, uaF: -84 + 10 * w, faF: -12, uaB: -76 + 10 * w, faB: -10 }; };
      // a sleeve over the mouth, coughing
      Rig.MODES.coughing = (u, o) => { const j = Math.max(0, Math.sin(u * 9)) * 6; return { ...Rig.MODES.whistle(u, o), torso: 8 + j, head: 6 + j * 0.8, bodyY: 6 + j * 0.6 }; };
      const YOU = (x, y, s, track, extra = {}) => ({ who: "you", x, y, s, track, blinks: [1.1, 3.3, 5.2], ...extra });
      // your back from just behind your shoulder (screen space, a dark silhouette with a cold rim light)
      const youBack = (id, x, y, s = 1) => `<g id="${id}" transform="translate(${x},${y}) scale(${s})">
          <path d="M-330,760C-330,430 -240,280 -120,250L-74,196Q0,176 74,196L120,250C240,280 330,430 330,760Z" fill="#232c3e"/>
          <path d="M120,250C240,280 330,430 330,760" stroke="#9fb2d6" stroke-width="12" fill="none" opacity=".55"/>
          <path d="M-120,250C-240,280 -330,430 -330,760" stroke="#7f91b2" stroke-width="10" fill="none" opacity=".45"/>
          <ellipse cx="0" cy="60" rx="128" ry="150" fill="#1b2230"/><circle cx="14" cy="-112" r="66" fill="#1b2230"/><path d="M128,60C130,-40 70,-88 0,-90" stroke="#9fb2d6" stroke-width="9" fill="none" opacity=".5"/>
          <path d="M-128,60C-130,-40 -70,-88 0,-90" stroke="#7f91b2" stroke-width="8" fill="none" opacity=".4"/>
          ${[[-60, -40], [-90, 30], [80, -30]].map(([a, b]) => `<path d="M${a},${b}q-14,40 -4,84" stroke="#12161f" stroke-width="10" fill="none" stroke-linecap="round"/>`).join("")}</g>`;
      // her room seen from the street: your silhouette in the seventh-floor window, waving the phone torch
      const winWave = (id) => `<g id="${id}"><rect x="326" y="700" width="104" height="84" fill="#2a3040" opacity=".9"/>
          <g transform="translate(372,786)"><path d="M-22,0C-24,-30 -18,-44 0,-46C18,-44 24,-30 22,0Z" fill="#0c0f16"/><circle cx="0" cy="-56" r="13" fill="#0c0f16"/><circle cx="2" cy="-72" r="7" fill="#0c0f16"/>
            <g id="${id}-arm" transform="rotate(0 14 -36)"><path d="M14,-36L34,-74" stroke="#0c0f16" stroke-width="8" stroke-linecap="round"/><circle cx="34" cy="-76" r="5" fill="#fffbe8"/>
              <circle cx="34" cy="-76" r="40" fill="#fff6dc" opacity=".35"/><circle cx="34" cy="-76" r="90" fill="#fff6dc" opacity=".12"/></g></g></g>`;
      // ---------- ควันหลง EP.4 ห้ามกลับ (ตอนจบ) ----------
      const PRAE = (x, y, s, track, extra = {}) => ({ who: "prae", x, y, s, track, blinks: [0.8, 2.9], ...extra });
      const FF = (x, y, s, track, extra = {}) => ({ who: "ff", x, y, s, track, blinks: [1.4, 3.6], ...extra });
      const SRI = (x, y, s, track, extra = {}) => ({ who: "sri", x, y, s, track, blinks: [0.9, 2.7, 4.4], ...extra });
      const G = 1500; // the street's ground line (Sets.street)
      const wave = (tl, sel, t0, dur, a = -28, b = 18, p = 0.32) => { for (let t = 0; t < dur; t += 2 * p) { tl.to(sel, { attr: { transform: `rotate(${a} 16 -40)` }, duration: p, ease: "sine.inOut" }, t0 + t); tl.to(sel, { attr: { transform: `rotate(${b} 16 -40)` }, duration: p, ease: "sine.inOut" }, t0 + t + p); } };
      // the landing's fire door seen from your eyes, with the street behind it (glow layer: outside light is above the dark)
      const doorOut = (p) => `<defs><clipPath id="${p}-ap"><rect x="460" y="560" width="440" height="1000"/></clipPath></defs>
        <g id="${p}-out" opacity="0"><g clip-path="url(#${p}-ap)"><rect x="460" y="560" width="440" height="1000" fill="url(#kwNight)"/>
          ${[[440, 880, 110], [540, 960, 90], [640, 840, 120], [770, 920, 100], [860, 870, 90]].map(([x, y, w], k) => `<rect x="${x}" y="${y}" width="${w}" height="${1300 - y}" fill="#141a26"/>${[0, 1, 2].map((j) => `<rect x="${x + 16 + (j % 2) * 40}" y="${y + 30 + j * 70}" width="14" height="18" fill="#ffd58a" opacity="${(0.3 + ((k + j) % 3) * 0.2).toFixed(1)}"/>`).join("")}`).join("")}
          <rect x="440" y="1290" width="480" height="280" fill="#1c1e22"/><path d="M440,1296H920" stroke="#4a4c52" stroke-width="8"/><path d="M440,1430H920" stroke="#d8d4c0" stroke-width="6" stroke-dasharray="40 30" opacity=".35"/>
          <g transform="translate(700,1330)"><rect x="-210" y="-120" width="330" height="110" rx="10" fill="#c8261c" stroke="#2e2a26" stroke-width="3"/><rect x="110" y="-150" width="100" height="140" rx="8" fill="#c8261c" stroke="#2e2a26" stroke-width="3"/><rect x="128" y="-136" width="66" height="44" fill="#2a3644"/>
            <rect x="-200" y="-142" width="290" height="14" fill="#9aa0a6"/><path d="M-200,-60H110" stroke="#e8e8e8" stroke-width="7"/><circle cx="-130" cy="-6" r="28" fill="#141414"/><circle cx="150" cy="-6" r="28" fill="#141414"/>
            <circle class="siren" cx="140" cy="-160" r="10" fill="#ff3a3a"/><circle class="sirenb" cx="190" cy="-160" r="10" fill="#3a7aff"/></g>
          ${[[520, 1340], [600, 1350], [880, 1345]].map(([x, y]) => `<g transform="translate(${x},${y})"><path d="M-16,0C-18,-40 -12,-62 0,-64C12,-62 18,-40 16,0Z" fill="#0c0f16"/><circle cx="0" cy="-74" r="11" fill="#0c0f16"/><path d="M-16,-76H16" stroke="#0c0f16" stroke-width="6"/></g>`).join("")}
          <ellipse cx="620" cy="700" rx="240" ry="120" fill="url(#pvPuff)" opacity=".6"/>
          <g class="siren"><circle cx="840" cy="1180" r="460" fill="url(#kwSiren)" opacity=".55"/></g><g class="sirenb"><circle cx="900" cy="1180" r="460" fill="url(#kwSirenB)" opacity=".55"/></g></g>
          <g class="siren"><ellipse cx="680" cy="1600" rx="420" ry="70" fill="#ff3a3a" opacity=".25"/></g><g class="sirenb"><ellipse cx="680" cy="1600" rx="420" ry="70" fill="#3a7aff" opacity=".25"/></g></g>
        <g id="${p}-panel"><rect x="460" y="560" width="440" height="1000" fill="#3a4a42" stroke="#2e2a26" stroke-width="4"/><rect x="520" y="640" width="150" height="200" fill="#0a0c0c"/>
          <g id="${p}-eyes"><ellipse cx="575" cy="730" rx="12" ry="5" fill="#ffd27a"/><ellipse cx="615" cy="732" rx="12" ry="5" fill="#ffd27a"/></g><rect x="490" y="1050" width="380" height="50" rx="10" fill="#8a9096"/></g>`;
      // an old photo: ศรี and ดาว in front of the dorm, 2539 (screen space)
      const photo = (id) => {
        const SEP = "#5a4028", girl = (x, long, smile) => `<g transform="translate(${x},40)"><path d="M-70,180C-70,60 -50,30 0,30C50,30 70,60 70,180Z" fill="#e6d8b8" stroke="${SEP}" stroke-width="4"/>
            ${long ? `<path d="M-52,-60C-60,10 -50,60 -40,80H40C50,60 60,10 52,-60Z" fill="#3a2814"/>` : ""}<circle cx="0" cy="-40" r="46" fill="#d8b88a" stroke="${SEP}" stroke-width="4"/>
            <path d="M-48,-44Q-50,-96 0,-96Q50,-96 48,-44Q30,-70 0,-72Q-30,-70 -48,-44Z" fill="${long ? "#3a2814" : "#4a3420"}"/>
            <g id="${id}-e${long ? "d" : "s"}"><circle cx="-16" cy="-38" r="5" fill="${SEP}"/><circle cx="16" cy="-38" r="5" fill="${SEP}"/></g>
            <path d="${smile ? "M-16,-14Q0,0 16,-14" : "M-12,-12H12"}" stroke="${SEP}" stroke-width="4" fill="none" stroke-linecap="round"/></g>`;
        return `<g id="${id}" transform="translate(560,640) rotate(-6)" opacity="0"><rect x="-308" y="-332" width="616" height="716" fill="#000" opacity=".35"/><rect x="-300" y="-340" width="600" height="700" fill="#f2ecdc" stroke="#2e2a26" stroke-width="4"/>
          <rect x="-260" y="-300" width="520" height="500" fill="#b89a6a"/><rect x="-260" y="-300" width="520" height="270" fill="#9a7c50"/>
          ${[-200, -90, 20, 130].map((x) => `<rect x="${x}" y="-270" width="70" height="80" fill="#6a5034"/><rect x="${x}" y="-150" width="70" height="80" fill="#6a5034"/>`).join("")}
          ${girl(-95, false, true)}${girl(95, true, true)}<path d="M-40,120Q0,90 40,120" stroke="#e6d8b8" stroke-width="22" stroke-linecap="round"/>
          <g id="${id}-glint" opacity="0"><ellipse cx="79" cy="42" rx="8" ry="4" fill="#ff8a3a"/><ellipse cx="111" cy="42" rx="8" ry="4" fill="#ff8a3a"/><circle cx="95" cy="42" r="40" fill="#ff6a1a" opacity=".25"/></g>
          <rect x="-260" y="-300" width="520" height="500" fill="#7a5a2a" opacity=".18"/><text x="0" y="290" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="46" fill="#5a4a3a">ศรี &amp; ดาว · 714 · 2539</text></g>`;
      };
      // a blanket round someone's shoulders (inside the rig's torso, so it moves with them)
      const blanket = (aid) => { const t = document.getElementById(`${aid}-torso`); if (t) t.insertAdjacentHTML("beforeend", `<g id="${aid}-bk" opacity="0"><path d="M-78,-500Q0,-548 78,-500L104,-290Q0,-262 -104,-290Z" fill="#8a6a5a" stroke="#2e2a26" stroke-width="4"/>${[-60, -20, 20, 60].map((x) => `<path d="M${x},-516V-284" stroke="#6a4e40" stroke-width="7" opacity=".6"/>`).join("")}</g>`); };
      // the dorm at night from across the street, the fire on the seventh floor put out: smoke only
      const fireOut = (L) => {
        [L.set, L.glow].forEach((g) => g.querySelectorAll(".flk, .emb").forEach((e) => e.remove()));
        L.set.querySelectorAll('rect[fill="url(#kwFireWin)"]').forEach((e) => e.setAttribute("fill", "#1a1410"));
      };

      // ---------- 0. EP.3's last image: the landing door marked 7; your hand on it ----------
      add("recap", withTorch("recap", { keys: [{ t: 0, x: 620, y: 880, r: 420 }], dark: 0.55, flicker: [[0.3, 1.2]], noHand: true }, {
        set: "landing", setOpts: { id: "ld0", show: 7, key: true, under: 1 }, dark: 0.35,
        cam: { keys: [{ t: 0, ...fr(640, 900, 1.35, 540, 960), drift: { s: 0.05 } }] },
        shake: Pov.head({ mode: "panic" }),
        extra(L) { put(L.light, Pov.reach("rh-rc", { x: 1200, y: 2300 })); },
        fx(tl, id, t0) {
          tl.set("#ld0-win", { opacity: 1 }, t0);
          tf(tl, "#rh-rc", t0 + 0.2, 1.2, "translate(820,1500) rotate(0)", "power2.out");
          Fx.heart(tl, t0, D("recap"), 0.38, 0.7); Fx.glitch(tl, `#${id}`, t0 + D("recap") - 0.35, 0.35, 22, 401);
        },
      }));

      // ---------- 1. the door swings open — not a corridor: the street, red and blue ----------
      const OPEN = F("hook", 0, 1) - 0.25;
      add("hook", {
        set: "landing", setOpts: { id: "ld1", show: 7, key: true, under: 1 }, dark: 0.45,
        cam: { keys: [{ t: 0, ...fr(640, 900, 1.35, 540, 960), drift: { s: 0.02 } }, { t: OPEN + 0.3, glide: 1.2, ...fr(680, 1000, 1.7, 540, 960), drift: { s: 0.05 } }] },
        shake: Pov.head({ mode: "panic", modes: [[OPEN + 0.6, "breath"]] }),
        captions: caps("hook"),
        extra(L) { put(L.glow, doorOut("h1")); },
        fx(tl, id, t0) {
          tl.set("#ld1-under", { opacity: 1 }, t0); tl.to("#ld1-under", { opacity: 0, duration: 0.3 }, t0 + OPEN);
          tl.to("#h1-eyes", { opacity: 0, duration: 0.25 }, t0 + OPEN - 0.3);
          tl.set("#h1-out", { opacity: 1 }, t0 + OPEN);
          tl.fromTo("#h1-panel", { scaleX: 1 }, { scaleX: 0.08, svgOrigin: "460 1060", duration: 0.7, ease: "power2.in", immediateRender: false }, t0 + OPEN);
          tl.fromTo("#flashw", { opacity: 0.45 }, { opacity: 0, duration: 0.3, immediateRender: false }, t0 + OPEN + 0.6);
          document.getElementById(id).insertAdjacentHTML("beforeend", `<div class="op" id="${id}-t" style="top:250px"><div class="op-ep"><b>EP.4</b><span>ห้ามกลับ</span></div></div>`);
          tl.fromTo(`#${id}-t .op-ep`, { opacity: 0, scale: 1.8 }, { opacity: 1, scale: 1, duration: 0.16, ease: "power4.in", immediateRender: false }, t0 + 0.3);
          tl.to(`#${id}-t .op-ep`, { opacity: 0, y: -30, duration: 0.3 }, t0 + 2.4);
          Fx.heart(tl, t0, OPEN, 0.4, 0.5);
          Fx.glitch(tl, `#${id}`, t0 + F("hook", 0, 3), 0.25, 14, 402);
          tl.fromTo("#flashw", { opacity: 0 }, { opacity: 0.9, duration: 0.25, immediateRender: false }, t0 + D("hook") - 0.25);
        },
      });

      // ---------- 2. wide from the street: you and แพร stumble out of the ground-floor door ----------
      add("out", {
        set: "street", setOpts: { id: "st2", door: 380, truck: 2150 }, dark: 0.25,
        cam: { keys: [{ t: 0, ...fr(560, 1000, 0.5, 540, 1150), drift: { s: 0.03 } }] },
        actors: [PRAE(260, G + 70, 1.35, [{ t: 0, mode: "walk", eyes: "side", mouth: "flat", sweat: true }, { t: 2.4, mode: "coughing", eyes: "closed", mouth: "flat", sweat: true }], { moveTo: { x: 500, y: G + 300, dur: 2.3, at: 0.1, ease: "power1.out" } }),
          YOU(470, G + 60, 1.35, [{ t: 0, mode: "walk", eyes: "side", mouth: "flat", sweat: true }, { t: 2.6, mode: "coughing", eyes: "closed", mouth: "flat", sweat: true }], { moveTo: { x: 930, y: G + 330, dur: 2.5, at: 0.25, ease: "power1.out" } })],
        captions: caps("out"),
        fx(tl, id, t0) { tl.fromTo("#flashw", { opacity: 0.9 }, { opacity: 0, duration: 0.4, immediateRender: false }, t0); },
      });

      // ---------- 3. knowledge: the assembly point across the street — and stay there ----------
      add("meet", {
        set: "street", setOpts: { id: "st3", sign: -40, crowd: 760 }, dark: 0.25,
        cam: { keys: [{ t: 0, ...fr(400, 2480, 0.62, 540, 1200), drift: { x: 20, s: 0.03 } }] },
        actors: [YOU(-420, G + 1600, 1.35, [{ t: 0, mode: "walk", eyes: "side", mouth: "flat" }, { t: 2.2, mode: "idle", eyes: "normal", mouth: "flat" }], { moveTo: { x: 610, y: G + 1600, dur: 2.0, at: 0.1, ease: "power1.out" } }),
          PRAE(-560, G + 1620, 1.35, [{ t: 0, mode: "walk", eyes: "side", mouth: "flat" }, { t: 2.4, mode: "coughing", eyes: "closed", mouth: "flat" }], { moveTo: { x: 330, y: G + 1620, dur: 2.2, at: 0.1, ease: "power1.out" } })],
        captions: caps("meet"),
        ui: [steps("meet", "ออกมาได้แล้ว", [["assembly", "ไปที่จุดรวมพล"], ["staythere", "รออยู่ตรงนั้น"]], F("meet", 0, 1) - 0.1, D("meet") - 0.15, { gap: F("meet", 0, 2) - F("meet", 0, 1) }),
          { type: "src", t: F("meet", 0, 2) + 0.4, end: D("meet") - 0.05, top: 640, text: "ที่มา: <em>USFA (FEMA)</em> · ไปที่จุดรวมพลข้างนอก แล้วอยู่ตรงนั้น" }],
      });

      // ---------- 4. over your shoulder: a firefighter, the engine's lights behind him ----------
      add("ask", {
        set: "street", setOpts: { id: "st4", truck: 760 }, dark: 0.3, blur: { far: 4 },
        cam: { keys: [{ t: 0, ...fr(600, 1950, 0.85, 540, 1000), drift: { s: 0.04 } }] },
        actors: [FF(640, G + 1350, 1.45, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: vo("ask"), mode: "point", eyes: "normal", mouth: "o" }, { t: voEnd("ask") + 0.1, mode: "idle", eyes: "normal", mouth: "flat" }], { flip: true })],
        captions: caps("ask", undefined, { quote: true }),
        extra(L) { put(L.light, youBack("yb4", 170, 1560, 1.15)); },
      });

      // ---------- 5. side on: you point up at the seventh floor and tell him ----------
      add("tell", {
        set: "street", setOpts: { id: "st5", truck: 2400 }, dark: 0.25,
        cam: { keys: [{ t: 0, ...fr(600, 1800, 0.7, 540, 1150), drift: { x: 15, s: 0.03 } }] },
        actors: [YOU(420, G + 900, 1.25, [{ t: 0, mode: "raise", eyes: "side", mouth: "o", sweat: true }]),
          FF(800, G + 920, 1.3, [{ t: 0, mode: "idle", eyes: "side", mouth: "flat" }, { t: F("tell", 0, 1) + 0.6, mode: "phoneEar", eyes: "side", mouth: "o" }], { flip: true })],
        captions: caps("tell"),
        ui: [steps("tell", "มีคนติดอยู่ข้างใน", [["tellff", "บอกเจ้าหน้าที่ดับเพลิง"]], F("tell", 0, 1) - 0.1, D("tell") - 0.15),
          { type: "src", t: F("tell", 0, 1) + 0.6, end: D("tell") - 0.05, top: 520, text: "ที่มา: <em>USFA (FEMA)</em> · ถ้ามีคนติดอยู่ในอาคาร ให้บอกเจ้าหน้าที่ดับเพลิง" }],
      });

      // ---------- 6. up at 714: someone in the window, waving a light — แพร's voice, calling you back ----------
      add("call", {
        set: "dormExt", setOpts: { id: "dx6", truck: 700 }, dark: 0.18,
        cam: { keys: [{ t: 0, ...fr(420, 900, 1.15, 540, 960), drift: { s: 0.02 } }, { t: vo("call") - 0.1, glide: 0.45, ...fr(378, 742, 3.6, 540, 900), drift: { s: 0.06 } }] },
        shake: (t) => (t > vo("call") ? 3 * Math.sin(t * 23) : 0),
        captions: caps("call", undefined, { quote: true }),
        extra(L) { put(L.set, winWave("cw6")); },
        fx(tl, id, t0) {
          wave(tl, "#cw6-arm", t0 + 0.2, D("call") - 0.2, -34, 12, 0.22);
          Fx.punch(tl, `#${id} .stage`, t0 + vo("call") + 0.3, 1.05, 0.4);
          Fx.glitch(tl, `#${id}`, t0 + F("call", 0, 1), 0.25, 14, 403);
          Fx.heart(tl, t0 + vo("call"), D("call") - vo("call"), 0.42, 0.5);
        },
      });

      // ---------- 7. low, from behind the two of you: แพร is standing right beside you ----------
      add("beside", {
        set: "street", setOpts: { id: "st7", truck: 2500 }, dark: 0.25,
        cam: { keys: [{ t: 0, ...fr(560, 1450, 0.7, 540, 1150), drift: { s: 0.02 } }, { t: F("beside", 0, 1) - 0.1, glide: 0.9, ...fr(700, 1250, 1.15, 540, 1000), drift: { s: 0.04 } }] },
        actors: [YOU(440, G + 620, 1.3, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }]),
          PRAE(720, G + 640, 1.3, [{ t: 0, mode: "tremble", eyes: "wide", mouth: "flat", sweat: true }], { flip: true })],
        captions: caps("beside"),
        fx(tl, id, t0) { Fx.heart(tl, t0 + F("beside", 0, 1), D("beside") - F("beside", 0, 1), 0.42, 0.55); },
      });

      // ---------- 8. close on แพร: that's not my voice ----------
      add("notme", {
        set: "street", setOpts: { id: "st8", truck: 1700 }, dark: 0.3, blur: { far: 6, set: 7 },
        cam: { keys: [{ t: 0, ...fr(560, G + 1900 - 400 * 2.3, 1.0, 540, 1000), drift: { s: 0.06 } }] },
        shake: (t) => 2 * Math.sin(t * 31),
        actors: [PRAE(540, G + 1900, 2.3, [{ t: 0, mode: "tremble", eyes: "wide", mouth: "flat", sweat: true }, { t: vo("notme"), mode: "tremble", eyes: "wide", mouth: "o", sweat: true }, { t: voEnd("notme"), mode: "tremble", eyes: "side", mouth: "flat", sweat: true }])],
        captions: caps("notme", undefined, { quote: true }),
        fx(tl, id, t0) { Fx.glitch(tl, `#${id}`, t0 + vo("notme") + 0.5, 0.2, 10, 404); Fx.heart(tl, t0, D("notme"), 0.4, 0.55); },
      });

      // ---------- 9. 2539 in shadow puppets: four screens, the camera glides down ----------
      const LG = (j) => vo("legend", j);
      add("legend", {
        set: "kwanLegend", setOpts: { id: "kl" }, dark: 0.05,
        cam: { keys: [{ t: 0, ...fr(540, 450, 1.2, 540, 760), drift: { s: 0.02 } },
          { t: LG(1) - 0.1, glide: 0.7, ...fr(540, 2050, 1.2, 540, 760), drift: { s: 0.02 } },
          { t: LG(2) - 0.1, glide: 0.7, ...fr(540, 3650, 1.2, 540, 760), drift: { s: 0.02 } },
          { t: LG(3) - 0.1, glide: 0.7, ...fr(540, 5250, 1.2, 540, 760), drift: { s: 0.03 } }] },
        captions: caps("legend"),
        fx(tl, id, t0) {
          const dur = D("legend");
          Koi.life(tl, `#${id}`, t0, dur);
          document.querySelectorAll(`#${id} .kfl`).forEach((el, i) => {
            const b = el.getBBox(), o = `${(b.x + b.width / 2).toFixed(0)} ${(b.y + b.height).toFixed(0)}`;
            tl.fromTo(el, { scaleY: 0.82, scaleX: 1.08 }, { scaleY: 1.18, scaleX: 0.92, svgOrigin: o, duration: 0.16 + (i % 4) * 0.04, repeat: Math.ceil(dur / 0.16), yoyo: true, ease: "none", immediateRender: false }, t0);
          });
          tl.fromTo("#kl-call", { opacity: 0.2 }, { opacity: 1, duration: 0.35, repeat: 12, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0 + LG(1) + 1.0);
          tl.fromTo("#kl-go", { x: 0 }, { x: 250, duration: 2.6, ease: "power1.in", immediateRender: false }, t0 + LG(2) + 0.2);
          tl.to("#kl-go", { opacity: 0, duration: 0.4 }, t0 + LG(2) + 2.7);
          tl.fromTo("#kl-win", { opacity: 0.4 }, { opacity: 1, duration: 0.5, repeat: 7, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0 + LG(3));
          Fx.heart(tl, t0 + LG(2) + 0.4, 1.8, 0.6, 0.35);
          Fx.glitch(tl, `#${id}`, t0 + LG(3) - 0.15, 0.2, 10, 405);
        },
      });

      // ---------- 10. ป้าศรี puts a blanket round you: "the handwriting on that sign — I wrote it for ดาว" ----------
      add("sri", {
        set: "street", setOpts: { id: "st10", crowd: 1100 }, dark: 0.22, blur: { far: 4 },
        cam: { keys: [{ t: 0, ...fr(600, 1500, 0.85, 540, 1100), drift: { x: -15, s: 0.03 } }] },
        actors: [YOU(470, G + 560, 1.25, [{ t: 0, mode: "sit", eyes: "side", mouth: "flat" }]),
          SRI(780, G + 520, 1.2, [{ t: 0, mode: "point", eyes: "normal", mouth: "flat" }, { t: 1.0, mode: "idle", eyes: "side", mouth: "flat" }, { t: vo("sri"), mode: "idle", eyes: "side", mouth: "o" }, { t: voEnd("sri"), mode: "idle", eyes: "closed", mouth: "flat" }], { flip: true })],
        captions: caps("sri", undefined, { quote: true }),
        fx(tl, id, t0) {
          blanket(`${id}-a0`);
          tl.fromTo(`#${id}-a0-bk`, { opacity: 0, y: -50 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out", immediateRender: false }, t0 + 0.35);
        },
      });

      // ---------- 11. close on ป้าศรี — and the photo: she was ดาว's roommate that night ----------
      add("reveal", {
        set: "street", setOpts: { id: "st11", truck: 2200 }, dark: 0.3, blur: { far: 6, set: 7 },
        cam: { keys: [{ t: 0, ...fr(560, G + 1900 - 530 * 2.3, 1.0, 540, 1250), drift: { s: 0.05 } }] },
        actors: [SRI(560, G + 1900, 2.3, [{ t: 0, mode: "idle", eyes: "side", mouth: "flat" }, { t: F("reveal", 0, 1) - 0.4, mode: "idle", eyes: "closed", mouth: "flat" }])],
        captions: caps("reveal"),
        extra(L) { put(L.light, photo("rv")); },
        fx(tl, id, t0) {
          const a = t0 + F("reveal", 0, 1) - 0.15;
          tl.fromTo("#rv", { opacity: 0, y: 120 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out", immediateRender: false }, a);
          tl.fromTo("#rv", { attr: { transform: "translate(560,640) rotate(-6)" } }, { attr: { transform: "translate(560,620) rotate(-3)" }, duration: D("reveal") - (a - t0), ease: "sine.inOut", immediateRender: false }, a);
          tl.to("#rv-glint", { opacity: 1, duration: 0.12 }, t0 + D("reveal") - 0.7); tl.to("#rv-glint", { opacity: 0, duration: 0.12 }, t0 + D("reveal") - 0.3);
          Fx.glitch(tl, `#${id}`, t0 + D("reveal") - 0.7, 0.18, 8, 406);
        },
      });

      // ---------- 12. "ออกมาแล้ว… ห้ามกลับนะลูก" — her face, then the line on the sign in her hand, 2539 ----------
      const RULE = F("rule", 0, 1) - 0.12;
      split("rule", RULE, {
        set: "street", setOpts: { id: "st12", truck: 1500 }, dark: 0.3, blur: { far: 6, set: 8 },
        cam: { keys: [{ t: 0, ...fr(560, G + 1900 - 400 * 2.4, 1.1, 600, 980), drift: { s: 0.04 } }] },
        actors: [SRI(560, G + 1900, 2.4, [{ t: 0, mode: "idle", eyes: "normal", mouth: "o" }], { flip: true })],
        captions: caps("rule", undefined, { quote: true }).filter((c) => c.t < RULE),
      }, {
        set: "room", setOpts: RM({ smokeY: -400 }), dark: 0.28,
        cam: { keys: [{ t: 0, ...fr(560, 1112 + 84, 3.0, 540, 900), drift: { s: 0.05 } }] },
        captions: capsFrom("rule", RULE, undefined, { quote: true }),
        fx(tl, id, t0) {
          [0, 1, 2, 3].forEach((k) => tl.set(`#rm-hwr${k}`, { attr: { width: 320 } }, t0));
          tl.fromTo("#rm-hw2", { attr: { fill: "#7a1a14" } }, { attr: { fill: "#ff2a1c" }, duration: 0.3, immediateRender: false }, t0 + 0.15);
          tl.fromTo("#rm-hw2", { x: 0 }, { x: 1.5, duration: 0.05, yoyo: true, repeat: 7, immediateRender: false }, t0 + 0.15);
          Fx.desat(tl, `#${id} .stage`, t0, undefined, 0.5);
          Fx.heart(tl, t0 + 0.1, D("rule") - RULE - 0.1, 0.5, 0.4);
        },
      });

      // ---------- 13. 714's window at first light: ดาว waves goodbye, and is gone ----------
      const BYE = F("wave", 0, 2);
      add("wave", {
        set: "dormExt", setOpts: { id: "dx13" }, dark: 0.12,
        cam: { keys: [{ t: 0, ...fr(540, 980, 1.0, 540, 960), drift: { s: 0.02 } }, { t: F("wave", 0, 1) - 0.2, glide: 1.4, ...fr(378, 742, 3.4, 540, 900), drift: { s: 0.03 } },
          { t: voEnd("wave") + 0.2, glide: 1.6, ...fr(480, 760, 1.15, 540, 1000), drift: { s: -0.02 } }] },
        captions: caps("wave"),
        extra(L) {
          fireOut(L);
          put(L.sky, `<defs><linearGradient id="k4Dawn" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2a3a5a"/><stop offset=".6" stop-color="#c88a7a"/><stop offset="1" stop-color="#f2c08a"/></linearGradient></defs><rect id="wv-dawn" x="-1400" y="-3200" width="3900" height="6000" fill="url(#k4Dawn)" opacity="0"/>`);
          put(L.set, `<rect x="326" y="700" width="104" height="84" fill="#ffb070" opacity=".55"/>${Kwan.daoWindow("wv-dao", 378, 784, 1.0)}`);
        },
        fx(tl, id, t0) {
          tl.to("#wv-dawn", { opacity: 0.8, duration: D("wave"), ease: "sine.in" }, t0);
          wave(tl, "#wv-dao-arm", t0 + BYE - 0.2, voEnd("wave") - BYE + 0.9, -40, 10, 0.4);
          tl.to("#wv-dao", { opacity: 0, duration: 1.2, ease: "sine.in" }, t0 + voEnd("wave") + 0.5);
          tl.to(`#${id} .stage`, { filter: "brightness(1.15)", duration: 2, immediateRender: false }, t0 + voEnd("wave"));
          tl.to("#black", { opacity: 1, duration: 0.5 }, t0 + D("wave") - 0.5);
        },
      });

      // ---------- 14. end card: the key tag ----------
      add("end", {
        set: "keyTag", setOpts: { id: "kt", ep: "ควันหลง · ตอนจบ", title: "ห้ามกลับ" }, dark: 0.1,
        cam: { keys: [{ t: 0, x: 0, y: 0, s: 1, drift: { s: 0.03 } }] },
        fx(tl, id, t0) {
          tl.set("#black", { opacity: 0 }, t0 + 0.3);
          tl.fromTo("#kt-tag", { attr: { transform: "translate(540,900) rotate(-14)" } }, { attr: { transform: "translate(540,900) rotate(-6)" }, duration: 1.6, ease: "elastic.out(1,0.4)", immediateRender: false }, t0 + 0.3);
          tl.to("#black", { opacity: 1, duration: 0.6 }, t0 + D("end") - 0.6);
        },
      });

      shots.forEach((sh) => { const f = sh.fx; sh.fx = (tl, id, t0, L) => { if (f) f(tl, id, t0, L); Pov.life(tl, `#${id}`, t0, sh.dur); }; });
