      // ---------- แสงกระสือ: helpers ----------
      const tf = (tl, sel, t, dur, to, ease = "power2.inOut") => tl.to(sel, { attr: { transform: to }, duration: dur, ease, immediateRender: false }, t);
      const put = (el, html) => el.insertAdjacentHTML("beforeend", html);
      const split = (k, at, A, B) => {
        add(k, A); shots[shots.length - 1].dur = at;
        add(k, B); const sh = shots[shots.length - 1]; sh.start = SH[k].start + at; sh.dur = D(k) - at;
      };
      const capsFrom = (k, at, lines, o) => caps(k, lines, o).filter((c) => c.end > at + 0.05).map((c) => ({ ...c, t: Math.max(0, c.t - at), end: c.end - at }));
      const steps = (k, label, items, at, endAt, o = {}) => ({ type: "steps", t: at, label, items, gap: o.gap ?? 0.5, top: o.top ?? 210, end: endAt ?? D(k) - 0.2 });
      // ---------- สกิลจอมโกหก EP.3 · storytelling clip (lane A) · the channel look (slender cast, lit sets) ----------
      Rig.FLAT = true;
      Engine.look = { ...(Engine.look || {}), vignette: 0.5, grain: 0.05 };
      const NS = "http://www.w3.org/2000/svg";
      const A = (who, x, y, s, track, extra = {}) => { if (extra.talk) track.talk = extra.talk; return { who, x, y, s, track, blinks: [0.8, 2.4, 4.1], ...extra }; };
      const ID = fr(540, 960, 1.0, 540, 960);
      const grp = (parent) => { const g = document.createElementNS(NS, "g"); parent.appendChild(g); return g; };
      const pop = (tl, g, at, o = {}) => tl.fromTo(g, { opacity: 0, scale: o.from ?? 0.8, y: o.dy ?? -18, svgOrigin: o.origin || "540 960" },
        { opacity: 1, scale: 1, y: 0, svgOrigin: o.origin || "540 960", duration: o.dur ?? 0.4, ease: o.ease || "back.out(2.2)" }, at);
      const out = (tl, g, at, d = 0.18) => tl.to(g, { opacity: 0, duration: d }, at);
      const swingG = (tl, sel, t0, dur, amp = 3, org = "0 0") => tl.fromTo(sel, { rotation: -amp, svgOrigin: org }, { rotation: amp, svgOrigin: org, duration: 1.2, repeat: Math.ceil(dur / 1.2), yoyo: true, ease: "sine.inOut" }, t0);
      const shake = (tl, g, t0, dur, a = 3, p = 0.05) => tl.fromTo(g, { x: -a }, { x: a, duration: p, repeat: Math.ceil(dur / p), yoyo: true, ease: "none" }, t0);
      const DAY = { dark: 0.02, light: { from: "right", rim: "#fff0d0", rimOp: 0.6, rimW: 4, shade: "#3a2440", shadeOp: 0.25, shadeW: 26, soft: 9, vol: false }, blur: { fg: 0 },
        grade: { top: "#fff2d8", bottom: "#4a3a50", op: 0.16 } };
      const NIGHT = { dark: 0.1, light: { from: "right", rim: "#ffd9a0", rimOp: 0.55, rimW: 4, shade: "#1a1430", shadeOp: 0.32, shadeW: 26, soft: 9, vol: false }, blur: { fg: 0 },
        grade: { top: "#ffe2b0", bottom: "#1a1428", op: 0.24 } };
      const spec = (k, o) => ({ ...(o.night ? NIGHT : DAY), cam: o.cam || { keys: [{ t: 0, ...(o.camAt || ID), drift: { s: o.push ?? 0.012 } }] }, captions: o.captions ?? caps(k), ...o });
      const shot = (k, o) => add(k, spec(k, o));
      const talk = (k, i, m = "o") => [[vo(k, i), voEnd(k, i), m]];
      const swap = (tl, id, t, a = 0, b = 1, d = 0.12) => { tl.set(`#${id}-a${b}`, { opacity: 0 }, 0); tl.to(`#${id}-a${a}`, { opacity: 0, duration: d }, t); tl.to(`#${id}-a${b}`, { opacity: 1, duration: d }, t); };
      const tagAt = (tl, L, x, y, text, at, o = {}) => { const g = grp(L.act); g.innerHTML = Lot.tag(x, y, text, o); pop(tl, g, at, { origin: `${x} ${y}`, from: 0.5 }); return g; };
      const capAt = (id, y) => { const c = document.getElementById(`${id}-caps`); if (c) c.style.setProperty("top", `${y}px`, "important"); };
      const ink = Lot.INK;
      // a counter chip in the corner (screen space): "1/5"
      const chip = (tl, L, steps, o = {}) => { const x = o.x ?? 900, y = o.y ?? 250;
        const g = grp(L.light); g.innerHTML = `<g transform="translate(${x},${y})"><circle r="78" fill="#fbf7ee" stroke="${ink}" stroke-width="7"/>
          ${steps.map(([, txt], i) => `<text id="${o.id}-c${i}" x="0" y="20" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="58" fill="${ink}" opacity="0">${txt}</text>`).join("")}
          <text x="0" y="-36" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="22" fill="#a8305a">${o.label || "ที่ซ่อน"}</text></g>`;
        steps.forEach(([at], i) => { tl.set(`#${o.id}-c${i}`, { opacity: 1 }, at); if (i + 1 < steps.length) tl.set(`#${o.id}-c${i}`, { opacity: 0 }, steps[i + 1][0]);
          tl.fromTo(g, { scale: 1.25, svgOrigin: `${x} ${y}` }, { scale: 1, svgOrigin: `${x} ${y}`, duration: 0.25, ease: "back.out(3)", immediateRender: false }, at); });
        return g; };
      const sparkle = (x, y, r = 22) => `<path d="M${x},${y - r}Q${x + 4},${y - 4} ${x + r},${y}Q${x + 4},${y + 4} ${x},${y + r}Q${x - 4},${y + 4} ${x - r},${y}Q${x - 4},${y - 4} ${x},${y - r}Z" fill="#fff6b0" stroke="${ink}" stroke-width="2.5"/>`;


      // the status bar (top left), per shot: [[label, value, colour]]
      document.head.insertAdjacentHTML("beforeend", `<style>
        .sghud { position: absolute; z-index: 58; left: 44px; top: 120px; display: flex; flex-direction: row; white-space: nowrap; width: max-content; align-items: center; gap: 16px;
          padding: 12px 22px; border-radius: 18px; background: rgba(18,20,30,.7); border: 1.5px solid rgba(244,236,216,.2); box-shadow: 0 8px 24px rgba(0,0,0,.35); font-family: Kanit; color: #f4ecd8; }
        .sghud b { font: 800 34px/1 Kanit; } .sghud small { font: 600 19px/1 Kanit; opacity: .65; } .sghud i { width: 1.5px; height: 30px; background: rgba(244,236,216,.25); }
        .capbox { font: 800 54px/1.25 Kanit !important; }
      </style>`);
      const hud = (id, items) => { const el = document.getElementById(id); if (!el) return;
        el.insertAdjacentHTML("beforeend", `<div class="sghud">${items.map(([l, v, c], i) => `${i ? "<i></i>" : ""}<small>${l}</small><b style="color:${c || "#f4ecd8"}">${v}</b>`).join("")}</div>`); };
      const ears = (tl, aid, at, on = true, d = 0.25) => tl.to(`#${aid} .jkEar`, { opacity: on ? 1 : 0, duration: d }, at);

      const act = (k) => (shots.find((x) => x.key === k) || {}).actors || [];
      const INN = { dark: 0.04, light: { from: "left", rim: "#ffc880", rimOp: 0.7, rimW: 4, shade: "#2a140a", shadeOp: 0.3, shadeW: 26, soft: 9, vol: false },
        grade: { top: "#ffcf90", bottom: "#3a1a10", op: 0.22 } };
      const NIGHTT = { dark: 0.12, light: { from: "right", rim: "#ffd090", rimOp: 0.7, rimW: 4, shade: "#140e28", shadeOp: 0.35, shadeW: 26, soft: 9, vol: false },
        grade: { top: "#3a4a8a", bottom: "#a8603a", op: 0.3 } };
      const inn = (k, o = {}) => ({ ...INN, set: "jkTavern", setOpts: { id: `jv${k}`, ...o } });
      const townN = (k, o = {}) => ({ ...NIGHTT, set: "jkTown", setOpts: { id: `jt${k}`, dusk: true, ...o } });
      const shadows = (L, id, actors, sh = 0.4) => NkL.cast(L, id, actors, { k: 0.3, sh, op: 0.35 });
      const ME = (who, x, y, track, extra = {}) => A(who, x, y, 0.95, track, extra);
      const sit = (who, x, track, extra = {}) => ME(who, x, 1400, track, extra);
      const KID = (who, x, y, track, extra = {}) => A(who, x, y, 0.64, track, extra);
      const faceSit = (x, s = 3.0, flip = false, sx = 540, sy = 760) => fr(x + (flip ? -2 : 2) * 0.95, 1400 - 396 * 0.95, s, sx, sy);
      const faceStand = (x, s = 3.0, flip = false, sx = 540, sy = 760) => fr(x + (flip ? -2 : 2) * 0.95, 1400 - 546 * 0.95, s, sx, sy);
      // a status bar whose believer count steps through values: steps [[t (s into the shot), "47%"]]
      const hudN = (tl, id, t0, rank, steps) => { const el = document.getElementById(id); if (!el) return;
        el.insertAdjacentHTML("beforeend", `<div class="sghud"><small>อันดับ</small><b style="color:#ff8a7a" id="${id}-hr">${rank}</b><i></i><small>คนเชื่อ</small><b style="color:#f2c55c" id="${id}-hv">${steps[0][1]}</b></div>`);
        const o = { u: 0 }; tl.to(o, { u: 100, duration: 100, ease: "none", onUpdate: () => { const now = o.u; let v = steps[0][1]; steps.forEach(([t, s]) => { if (now >= t) v = s; }); const e = document.getElementById(`${id}-hv`); if (e && e.textContent !== v) e.textContent = v; } }, t0); };
      const bigChip = (tl, L, x, y, txt, at, end, col = "#f2c55c") => { const g = grp(L.act); g.innerHTML = `<g transform="translate(${x},${y})"><rect x="-96" y="-46" width="192" height="92" rx="46" fill="${col}"/><text x="0" y="24" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="64" fill="#2e2a26">${txt}</text></g>`;
        tl.set(g, { opacity: 0 }, 0); tl.fromTo(g, { opacity: 1, scale: 1.4, svgOrigin: `${x} ${y}` }, { scale: 1, svgOrigin: `${x} ${y}`, duration: 0.25, ease: "back.out(3)", immediateRender: false }, at);
        if (end !== undefined) tl.set(g, { opacity: 0 }, end); return g; };
      const stars = (tl, layer, x, y, t0, dur, sc = 1) => { const g = grp(layer); g.innerHTML = [0, 1, 2].map((k) => `<path transform="translate(${x + 60 * sc * Math.cos(k * 2.09)},${y + 18 * sc * Math.sin(k * 2.09)}) scale(${sc})" d="M0,-16L4,-5L16,-5L6,2L10,14L0,7L-10,14L-6,2L-16,-5L-4,-5Z" fill="#f6d36a"/>`).join("");
        tl.fromTo(g, { rotation: 0, svgOrigin: `${x} ${y}` }, { rotation: 360, svgOrigin: `${x} ${y}`, duration: 1.6, repeat: Math.ceil(dur / 1.6), ease: "none" }, t0); return g; };
      const PATRONS = (mode = "sitChair", eyes = "side", mouth = "smile") => [A("jkKen", 150, 1400, 0.92, [{ t: 0, mode, eyes, mouth }]), A("jkWom1", 440, 1400, 0.92, [{ t: 0, mode, eyes, mouth }], { flip: true }),
        A("jkMan1", 560, 1400, 0.98, [{ t: 0, mode, eyes, mouth }]), A("jkMan2", 1010, 1400, 0.95, [{ t: 0, mode: mode === "sitChair" ? "idle" : mode, eyes, mouth }], { flip: true }),
        A("jkMap", 1250, 1400, 0.95, [{ t: 0, mode: "idle", eyes: "tired", mouth: "flat" }], { flip: true })];
      const YOU = (track = [{ t: 0, mode: "raise", eyes: "normal", mouth: "o" }], extra = {}) => sit("jkYouBucket", 840, track, { flip: true, ...extra });

      // the creature out cold by the road, seen through the window: gecko → monitor lizard → crocodile → a baby dragon (local ground y 0, facing right)
      const CRE = {
        gecko: `<g transform="scale(1.4)"><path d="M-30,-8Q0,-22 30,-8Q0,4 -30,-8Z" fill="#8ab06a"/><circle cx="34" cy="-8" r="11" fill="#8ab06a"/><path d="M-30,-8Q-56,-2 -62,-18" stroke="#8ab06a" stroke-width="7" fill="none" stroke-linecap="round"/><path d="M32,-14l5,5l-5,5M40,-14l-5,5l5,5" stroke="#2a2220" stroke-width="2.2" fill="none"/></g>`,
        monitor: `<g><path d="M-90,-14Q-20,-46 70,-20Q20,6 -90,-2Z" fill="#7a7a5a"/>${[-60, -30, 0, 30].map((x) => `<circle cx="${x}" cy="-22" r="5" fill="#d8c88a" opacity=".8"/>`).join("")}<path d="M60,-30Q100,-34 112,-18Q96,-6 62,-12Z" fill="#7a7a5a"/>
          <path d="M-90,-8Q-180,0 -220,-26" stroke="#7a7a5a" stroke-width="12" fill="none" stroke-linecap="round"/><path d="M112,-18l22,-4M112,-18l22,6" stroke="#d8443a" stroke-width="3"/><path d="M-40,-4l-10,18M30,-8l10,18" stroke="#6a6a4a" stroke-width="9" stroke-linecap="round"/>
          <path d="M84,-26l5,5l-5,5M92,-26l-5,5l5,5" stroke="#2a2220" stroke-width="2.4" fill="none"/></g>`,
        croc: `<g><path d="M-170,-10Q-60,-60 120,-30L250,-26Q260,-14 250,-4L120,0Q-60,10 -170,-2Z" fill="#4a6a3a"/>${[-120, -80, -40, 0, 40, 80].map((x) => `<path d="M${x - 12},-40l12,-16l12,16Z" fill="#3a5a2c"/>`).join("")}
          <path d="M-170,-6Q-280,0 -340,-30" stroke="#4a6a3a" stroke-width="22" fill="none" stroke-linecap="round"/><path d="M130,-6L250,-6M150,-6l6,8l6,-8l6,8l6,-8l6,8l6,-8" stroke="#f4ecd8" stroke-width="3" fill="none"/>
          <path d="M140,-40l6,6l-6,6M150,-40l-6,6l6,6" stroke="#2a2220" stroke-width="3" fill="none"/><path d="M-80,-2l-14,26M60,-6l14,26" stroke="#3a5a2c" stroke-width="16" stroke-linecap="round"/></g>`,
        baby: `<g transform="translate(-50,-70) scale(.72)">${JK.dragon("#5a9a6a")}</g>`,
      };
      const windowView = (id, inner) => `<g transform="translate(540,760)"><rect x="-430" y="-520" width="860" height="980" rx="400" fill="#1a2440"/>
          <defs><clipPath id="${id}-wc"><rect x="-420" y="-510" width="840" height="960" rx="392"/></clipPath></defs>
          <g clip-path="url(#${id}-wc)"><rect x="-500" y="-600" width="1000" height="700" fill="#24304e"/><circle cx="220" cy="-330" r="50" fill="#f4f0dc" opacity=".85"/>
            <path d="M-500,40L-380,-80L-200,0L-40,-120L120,-20L300,-140L500,20V120H-500Z" fill="#1c2238"/><rect x="-500" y="90" width="1000" height="400" fill="#3a3640"/><path d="M-500,94H500" stroke="#4a4652" stroke-width="6"/>${inner}</g>
          <rect x="-430" y="-520" width="860" height="980" rx="400" fill="none" stroke="#3a2418" stroke-width="44"/><path d="M0,-520V460M-430,-30H430" stroke="#3a2418" stroke-width="22"/></g>`;

      // ---------- c01 hook ----------
      shot("c01", { ...inn("c01"), camAt: faceSit(840, 2.4, true, 540, 900), push: 0.03, blur: { mid: 6, far: 8 },
        actors: [YOU()],
        fx(tl, id, t0, L) { hudN(tl, id, t0, "9,999", [[0, "12%"], [0.8, "31%"], [1.6, "47%"]]); [["12%", 0.1], ["31%", 0.8], ["47%", 1.6]].forEach(([v, t], i, a) => bigChip(tl, L, 842, 760, v, t0 + t, i + 1 < a.length ? t0 + a[i + 1][1] : undefined)); } });

      // ---------- c02–c04 the numbers climb; outside, the thing grows ----------
      shot("c02", { ...inn("c02"), camAt: fr(700, 1000, 1.1, 540, 1000), push: 0.02, shake: JKC.hand(3, 0.3),
        actors: [...PATRONS("sitChair", "wide", "o").map((a, i) => ({ ...a, flip: i < 3 ? false : true })), YOU(), KID("jkKidLizard", 920, 1490, [{ t: 0, mode: "idle", eyes: "wide", mouth: "smile" }], { flip: true })],
        fx(tl, id, t0, L) { const s1 = F("c02", 0, 1); hudN(tl, id, t0, "9,999", [[0, "1%"], [s1, "12%"], [s1 + 0.8, "31%"], [s1 + 1.6, "47%"]]); shadows(L, id, act("c02"));
          JKI.counter(tl, L.light, t0, D("c02"), { icon: "believer", x: 44, y: 250, w: 320, from: 1, unit: "คน", at: 0.1, steps: [[s1, 12], [s1 + 0.8, 31], [s1 + 1.6, 47]], count: 0.45, tone: "blue", plus: true }); } });
      shot("c03", { ...inn("c03"), camAt: fr(1500, 800, 1.2, 540, 900), blur: { set: 10, mid: 10, far: 10 }, dark: 0.2,
        fx(tl, id, t0, L) { hudN(tl, id, t0, "9,999", [[0, "47%"]]); const g = grp(L.light); g.innerHTML = windowView(id, `<g transform="translate(-40,180)">${CRE.gecko}</g>`);
          stars(tl, L.light, 520, 880, t0, D("c03"), 0.9); pop(tl, g, t0, { origin: "540 760", from: 0.95, dur: 0.3 }); } });
      shot("c04", { ...inn("c04"), camAt: fr(1500, 800, 1.2, 540, 900), blur: { set: 10, mid: 10, far: 10 }, shake: JKC.impact(vo("c04", 1) + 0.6, 0.5, 10, JKC.dutch(-3)), dark: 0.2,
        fx(tl, id, t0, L) { const ts = [0, F("c04", 0, 0) + 0.6, F("c04", 0, 1) + 0.5, vo("c04", 1) + 0.6], v = ["52%", "61%", "78%", "86%"];
          hudN(tl, id, t0, "9,999", ts.map((t, i) => [t, v[i]]));
          const g = grp(L.light); g.innerHTML = windowView(id, ["gecko", "monitor", "croc", "baby"].map((k, i) => `<g id="${id}-c${i}" transform="translate(${k === "baby" ? 0 : -40},${k === "baby" ? 160 : 180})" opacity="${i ? 0 : 1}">${CRE[k]}</g>`).join(""));
          ts.forEach((t, i) => { if (!i) return; tl.set(`#${id}-c${i - 1}`, { opacity: 0 }, t0 + t); tl.fromTo(`#${id}-c${i}`, { opacity: 1, scale: 0.7, svgOrigin: "0 0" }, { scale: 1, svgOrigin: "0 0", duration: 0.3, ease: "back.out(2.5)", immediateRender: false }, t0 + t); tl.set(`#${id}-c${i}`, { opacity: 0 }, 0); });
          stars(tl, L.light, 600, 820, t0, D("c04"), 1.3);
          JKI.chain(tl, L.light, t0, D("c04"), [{ icon: "gecko", label: "จิ้งจก", tone: "green" }, { icon: "monitor", label: "ตะกวด", tone: "green" }, { icon: "croc", label: "จระเข้", tone: "green" }, { icon: "dragon", label: "มังกรน้อย", tone: "yellow" }], { y: 1500, gap: 250, s: 0.85, ats: ts.map((t, i) => (i ? t : 0.1)) }); } });

      // ---------- c05–c08 Ken: "โม้ทั้งเพ!", the demon-king joke, the grey numbers ----------
      shot("c05", { ...inn("c05"), camAt: fr(260, 1000, 1.7, 540, 1000), push: 0.02,
        actors: [A("jkKen", 150, 1400, 0.92, [{ t: 0, mode: "sitChair", eyes: "angry", mouth: "frown" }], { until: vo("c05", 0) + 0.5 }),
          A("jkKen", 150, 1400, 0.92, [{ t: 0, mode: "point", eyes: "angry", mouth: "o" }], { from: vo("c05", 0) + 0.5, talk: talk("c05", 1) })],
        sfxText: [{ text: "ปัง!", x: 600, y: 900, size: 110, rot: 6, color: "#f6d36a", t: vo("c05", 0) + 0.5, end: vo("c05", 0) + 1.4 }],
        fx(tl, id, t0, L) { hudN(tl, id, t0, "9,999", [[0, "86%"]]); } });
      shot("c06", { ...inn("c06"), cam: { keys: [{ t: 0, ...faceSit(840, 2.6, true), drift: { s: 0.01 } }, { t: vo("c06", 1) - 0.1, ...faceSit(840, 3.8, true, 540, 820), glide: 0.4 }] }, blur: { mid: 6, far: 8 }, dark: 0.1,
        actors: [YOU([{ t: 0, mode: "sitChair", eyes: "normal", mouth: "flat" }, { t: vo("c06", 1), mode: "raise", eyes: "angry", mouth: "snarl" }])],
        fx(tl, id, t0, L) { hudN(tl, id, t0, "9,999", [[0, "86%"]]); const g = grp(L.act), y = 1400 - 560 * 0.95 + 4;
          g.innerHTML = [877, 841].map((x) => `<ellipse cx="${x}" cy="${y}" rx="9" ry="5" fill="#ff3a2a"/><ellipse cx="${x}" cy="${y}" rx="20" ry="12" fill="#ff3a2a" opacity=".35"/>`).join("");
          tl.set(g, { opacity: 0 }, 0); tl.to(g, { opacity: 1, duration: 0.2 }, t0 + vo("c06", 1) + 0.2); } });
      shot("c07", { ...inn("c07"), camAt: fr(420, 1040, 1.15, 540, 1000), push: 0.02,
        actors: [A("jkKen", 150, 1400, 0.92, [{ t: 0, mode: "startle", eyes: "wide", mouth: "scream" }, { t: 0.6, mode: "knocked", eyes: "wide", mouth: "o" }], { path: [{ t: 0, x: 150, y: 1400 }, { t: 0.6, x: 60, y: 1400 }] }),
          ...PATRONS("laugh", "closed", "laugh").slice(1, 4), YOU([{ t: 0, mode: "sitChair", eyes: "closed", mouth: "smile" }])],
        sfxText: [{ text: "ฮ่าๆๆๆ", x: 460, y: 520, size: 110, rot: -8, color: "#f6d36a", t: 0.7, end: D("c07") - 0.1 }],
        fx(tl, id, t0, L) { hudN(tl, id, t0, "9,999", [[0, "86%"]]); const ch = grp(L.act); ch.innerHTML = `<g transform="translate(180,1400) rotate(80)"><rect x="-34" y="-120" width="68" height="16" rx="5" fill="#7a5030"/><path d="M-26,-104L-30,0M26,-104L30,0" stroke="#4a2e1a" stroke-width="10"/></g>`;
          tl.set(ch, { opacity: 0 }, 0); tl.set(ch, { opacity: 1 }, t0 + 0.6); } });
      // the set-up for EP.4: faint grey numbers rise from every head that laughed at the demon-king joke
      shot("c08", { ...inn("c08"), camAt: fr(640, 1000, 1.0, 540, 1000), push: 0.03, shake: JKC.hand(4, 0.4), dark: 0.12,
        actors: [...PATRONS("laugh", "closed", "laugh").map((a, i) => (i === 4 ? { ...a, track: [{ t: 0, mode: "idle", eyes: "closed", mouth: "smile" }] } : a)), YOU([{ t: 0, mode: "sitChair", eyes: "closed", mouth: "smile" }])],
        fx(tl, id, t0, L) { hudN(tl, id, t0, "9,999", [[0, "86%"]]); const heads = [[150, 1022], [440, 1022], [560, 1012], [1010, 880], [1250, 880]];
          heads.forEach(([x, y], k) => { const g = grp(L.act); g.innerHTML = `<text x="${x}" y="${y - 70}" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="44" fill="#c8ccd4" opacity=".75">+1</text>`;
            tl.set(g, { opacity: 0 }, 0); tl.fromTo(g, { opacity: 0.85, y: 0 }, { opacity: 0, y: -160, duration: 1.8, ease: "sine.out", immediateRender: false }, t0 + F("c08", 0, 1) + k * 0.15);
            const g2 = grp(L.act); g2.innerHTML = g.innerHTML; tl.set(g2, { opacity: 0 }, 0); tl.fromTo(g2, { opacity: 0.85, y: 0 }, { opacity: 0, y: -160, duration: 1.8, ease: "sine.out", immediateRender: false }, t0 + F("c08", 0, 1) + 1.0 + k * 0.15); });
          const tag = grp(L.light); tag.innerHTML = `<g transform="translate(300,520)"><rect x="-150" y="-34" width="300" height="68" rx="34" fill="#3a3e48" opacity=".85"/><text x="0" y="12" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="30" fill="#e8ecf2">เชื่อว่า… ราชาปีศาจ?</text></g>`;
          pop(tl, tag, t0 + F("c08", 0, 2), { origin: "300 520", from: 0.6 }); } });

      // ---------- c09–c11 99%: มะปราง ----------
      shot("c09", { ...inn("c09"), camAt: faceSit(840, 2.2, true, 540, 1000), push: 0.02, shake: JKC.impact(vo("c09", 1), 0.35, 8), blur: { mid: 6, far: 8 },
        actors: [YOU([{ t: 0, mode: "sitChair", eyes: "normal", mouth: "flat" }, { t: vo("c09", 1), mode: "sitPray", eyes: "closed", mouth: "pout" }])],
        fx(tl, id, t0, L) { hudN(tl, id, t0, "9,999", [[0, "86%"], [0.4, "99%"]]); JKI.ring(tl, L.light, t0, D("c09"), { x: 540, y: 540, s: 1.1, from: 86, to: 99, at: 0.1, rollAt: 0.4, count: 0.5, tone: "yellow", label: "ขาดอีก 1 คน", labelAt: vo("c09", 1) }); } });
      shot("c10", { ...inn("c10"), cam: { keys: [{ t: 0, ...fr(900, 1000, 1.0, 540, 1000), drift: { s: 0.01 } }, { t: vo("c10", 1) - 0.1, ...faceStand(1250, 3.0, true, 540, 820), glide: 0.6 }] },
        actors: [...PATRONS("sitChair", "side", "o").map((a, i) => ({ ...a, flip: false })).slice(0, 4), A("jkMap", 1250, 1400, 0.95, [{ t: 0, mode: "idle", eyes: "closed", mouth: "frown" }], { flip: true }),
          YOU([{ t: 0, mode: "sitChair", eyes: "side", mouth: "flat" }], { flip: false })],
        fx(tl, id, t0, L) { hudN(tl, id, t0, "9,999", [[0, "99%"]]); const fx0 = 1250 - 2 * 0.95, fy = 1400 - 546 * 0.95; const g = grp(L.act);
          g.innerHTML = `<path d="M${fx0 - 26},${fy + 8}q-6,14 0,24q6,-10 0,-24Z" fill="#9ad8ff"/><path d="M${fx0 + 8},${fy + 8}q-6,14 0,24q6,-10 0,-24Z" fill="#9ad8ff"/>`;
          tl.set(g, { opacity: 0 }, 0); tl.fromTo(g, { opacity: 1, y: 0 }, { y: 30, opacity: 0, duration: 1.0, repeat: 2, ease: "sine.in", immediateRender: false }, t0 + F("c10", 1, 2)); } });
      shot("c11", { ...inn("c11"), camAt: faceStand(1250, 3.2, true, 540, 700), push: 0.03, shake: JKC.dutch(-2), blur: { mid: 6, far: 8 },
        actors: [A("jkMap", 1250, 1400, 0.95, [{ t: 0, mode: "fold", eyes: "side", mouth: "smirk" }], { flip: true, talk: talk("c11", 0) })],
        fx(tl, id, t0, L) { hudN(tl, id, t0, "9,999", [[0, "99%"]]); } });

      // ---------- c12–c13 100%: บึ้ม ----------
      shot("c12", { ...inn("c12"), camAt: fr(800, 1000, 1.05, 540, 1000), shake: (t) => (t > vo("c12", 1) && t < vo("c12", 1) + 1.2 ? 14 * Math.sin(t * 60) * (1 - (t - vo("c12", 1)) / 1.2) : 0),
        actors: [...PATRONS("startle", "wide", "scream").map((a, i) => ({ ...a, flip: i < 3 ? false : true })), YOU([{ t: 0, mode: "startle", eyes: "wide", mouth: "o" }, { t: 0.5, mode: "sitCower", eyes: "wide", mouth: "o" }])],
        sfxText: [{ text: "บึ้ม!", x: 300, y: 600, size: 170, rot: -6, color: "#ffd84a", t: vo("c12", 1), end: D("c12") - 0.1 }],
        fx(tl, id, t0, L) { hudN(tl, id, t0, "9,999", [[0, "99%"], [vo("c12", 0) + 0.3, "100%"]]); JKI.ring(tl, L.light, t0, D("c12"), { x: 860, y: 560, s: 1.1, from: 99, to: 100, at: 0.05, rollAt: vo("c12", 0) + 0.3, count: 0.3, tone: "green", flashAt: vo("c12", 1) });
          const fl = grp(L.light); fl.innerHTML = `<rect x="-100" y="-100" width="1280" height="2200" fill="#fff6d8"/>`; tl.set(fl, { opacity: 0 }, 0); tl.fromTo(fl, { opacity: 0.9 }, { opacity: 0, duration: 0.5, immediateRender: false }, t0 + vo("c12", 1)); } });
      shot("c13", { ...townN("c13"), camAt: fr(1000, 1300, 0.62, 540, 1500), push: 0.02, shake: (t) => (t < 0.6 ? 10 * Math.sin(t * 50) * (1 - t / 0.6) : 0),
        fx(tl, id, t0, L) { JKC.bars(tl, L, t0, D("c13"), 150); hudN(tl, id, t0, "9,999", [[0, "100%"]]); const g = grp(L.act); g.innerHTML = `<g transform="translate(1150,1640) scale(-3.1,3.1) rotate(-3)">${JK.dragon("#4f8a5e", { ko: true })}</g>`;   // the real one, flat on its back across the plaza, head to the left
          tl.set(g, { opacity: 0 }, 0); tl.fromTo(g, { opacity: 1, y: -1400 }, { y: 0, duration: 0.35, ease: "power3.in", immediateRender: false }, t0);
          stars(tl, L.act, 420, 960, t0 + 0.4, D("c13"), 3.2);
          const d = grp(L.act); d.innerHTML = [...Array(7)].map((_, k) => `<circle cx="${560 + k * 120}" cy="1420" r="${70 + (k % 3) * 20}" fill="#d8c8a8" opacity=".7"/>`).join("");
          tl.set(d, { opacity: 0 }, 0); tl.fromTo(d, { opacity: 0.9, scale: 0.5, svgOrigin: "920 1420" }, { opacity: 0, scale: 1.6, svgOrigin: "920 1420", duration: 1.2, immediateRender: false }, t0 + 0.35); } });

      // ---------- c14–c15 rank one ----------
      shot("c14", { ...townN("c14"), shake: JKC.impact(vo("c14", 1) + 0.4, 0.4, 10), cam: { keys: [{ t: 0, ...fr(1000, 860, 1.25, 540, 760), drift: { s: 0.008 } }] },
        fx(tl, id, t0, L) { const up = F("c14", 1, 1); hudN(tl, id, t0, "9,999", [[0, "100%"]]);
          const board = grp(L.act), rows = [[1, "คุณ · จอมโกหก (F)", 2], [2, "เซอร์อาเธอร์ผู้ไม่เคยแพ้", 0], [3, "แม่มดดอกไม้เหล็ก", 0], [4, "ยักษ์ใจดีแห่งภูเขา", 0], [11, "เคน · ดาบแสง (SSR)", 1]];
          board.innerHTML = `<g transform="translate(1000,1180)">${rows.map(([n, name, hl], k) => { const y = -500 + k * 70 + (k === rows.length - 1 ? 20 : 0); const bg = hl === 2 ? "#ffd84a" : hl === 1 ? "#f4e8cc" : "#f4e8cc";
              return `<rect x="-230" y="${y}" width="460" height="56" rx="8" fill="${bg}"/><text x="-205" y="${y + 40}" font-family="Kanit" font-weight="900" font-size="30" fill="#5a3a24">${n}</text><text x="-95" y="${y + 39}" font-family="Kanit" font-weight="800" font-size="27" fill="#3a2a20">${name}</text>`; }).join("")}
              <rect x="-236" y="-506" width="472" height="68" rx="12" fill="none" stroke="#fff6b0" stroke-width="6"/></g>`;
          tl.set(board, { opacity: 0 }, 0); JKI.counter(tl, L.light, t0, D("c14"), { icon: "crown", x: 44, y: 250, w: 500, unitW: 70, from: 9999, unit: "อันดับ", at: 0.1, steps: [[up - 0.2, 1]], count: 0.9, tone: "yellow" });
          [0, 1, 2, 3, 4].forEach((k) => tl.fromTo(`#jtc14-r${k}`, { y: 0 }, { y: 40, duration: 0.08, repeat: 9, yoyo: true, ease: "none", immediateRender: false }, t0 + F("c14", 0, 1)));
          tl.fromTo(board, { opacity: 1, scaleY: 0, svgOrigin: "1000 860" }, { scaleY: 1, svgOrigin: "1000 860", duration: 0.35, ease: "back.out(2)", immediateRender: false }, t0 + up - 0.2);
          const h = document.getElementById(`${id}-hr`); tl.to({ u: 0 }, { u: 1, duration: D("c14"), onUpdate: function () { const now = this.progress() * D("c14"); if (h) h.textContent = now >= up - 0.2 ? "1" : "9,999"; } }, t0); } });
      shot("c15", { ...townN("c15"), camAt: fr(1000, 860, 1.25, 540, 760), blur: { set: 10, mid: 10, far: 10 }, dark: 0.3,
        fx(tl, id, t0, L) { hudN(tl, id, t0, "1", [[0, "100%"]]); const g = grp(L.light);
          g.innerHTML = `<g transform="translate(540,760)"><circle r="420" fill="url(#jkGold)" opacity=".7" id="${id}-aura"/><g transform="rotate(-6)"><rect x="-230" y="-330" width="460" height="660" rx="34" fill="#9aa0a6"/><rect x="-206" y="-306" width="412" height="612" rx="24" fill="#c3c8cd"/>
              <text x="0" y="-20" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="92" fill="#4a4f56">จอมโกหก</text><text x="0" y="200" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="190" fill="#7a8088">F</text></g></g>`;
          pop(tl, g, t0 + 0.1, { origin: "540 760", from: 0.7 }); tl.set(`#${id}-aura`, { opacity: 0 }, 0); tl.to(`#${id}-aura`, { opacity: 0.9, duration: 0.4 }, t0 + F("c15", 0, 1));
          const st = grp(L.light); st.innerHTML = `<g transform="translate(700,980) rotate(-12)"><rect x="-210" y="-62" width="420" height="124" rx="18" fill="none" stroke="#ffd84a" stroke-width="12"/><text x="0" y="28" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="74" fill="#ffd84a">โกงที่สุด</text></g>`;
          pop(tl, st, t0 + F("c15", 0, 1) + 0.4, { origin: "700 980", from: 2.2, dur: 0.25, ease: "power3.in" }); } });

      // ---------- c16 next · c17 logo ----------
      shot("c16", { ...townN("c16"), camAt: fr(1000, 900, 0.8, 540, 900), push: 0.01, dark: 0.4, blur: { set: 12, mid: 10, far: 10, glow: 8 }, captions: [],
        fx(tl, id, t0, L) { NkV.chalkEnd(tl, grp(L.light), t0, D("c16"), { big: "ตอนที่ 4", q: "พูดเล่น ก็นับ", foot: "กดติดตาม รอดูตอนจบภาคแรก" }); } });
      shot("c17", { light: false, captions: [], fx(tl, id, t0, L) { const g = grp(L.light); NkUI.logo(g); pop(tl, g, t0 + 0.05, { from: 0.9, dy: 0, origin: "540 880" }); } });
