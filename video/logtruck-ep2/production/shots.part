      // ---------- แสงกระสือ: helpers ----------
      const tf = (tl, sel, t, dur, to, ease = "power2.inOut") => tl.to(sel, { attr: { transform: to }, duration: dur, ease, immediateRender: false }, t);
      const put = (el, html) => el.insertAdjacentHTML("beforeend", html);
      const split = (k, at, A, B) => {
        add(k, A); shots[shots.length - 1].dur = at;
        add(k, B); const sh = shots[shots.length - 1]; sh.start = SH[k].start + at; sh.dur = D(k) - at;
      };
      const capsFrom = (k, at, lines, o) => caps(k, lines, o).filter((c) => c.end > at + 0.05).map((c) => ({ ...c, t: Math.max(0, c.t - at), end: c.end - at }));
      const steps = (k, label, items, at, endAt, o = {}) => ({ type: "steps", t: at, label, items, gap: o.gap ?? 0.5, top: o.top ?? 210, end: endAt ?? D(k) - 0.2 });
      // ---------- นาทีก่อนจม: the story's own kit (canal road at night, the window-lock insert, the HUD, the cards) ----------
      const INK = "#1e2228", f1 = (v) => (+v).toFixed(1);
      const NIGHT = { from: "left", rim: "#ffd9a0", rimOp: 0.55, shade: "#0e1422", shadeOp: 0.42, cast: false, vol: false };
      const CABIN = { from: "right", rim: "#9fd0ff", rimOp: 0.45, shade: "#0a0e16", shadeOp: 0.45, cast: false, vol: false };
      const GNIGHT = { top: "#2a3a5a", bottom: "#0a1018", op: 0.3 }, GWATER = { top: "#3a5a4a", bottom: "#0a1810", op: 0.35 };
      // the canal road at 1 a.m. (screen coordinates at the identity camera): stars, the far bank's trees and a few lit windows, the canal
      // (dark water, streetlight reflections), the near bank sloping up to the road with its lamp posts; no rail where the car goes in.
      // o.water: the canal's surface y (WY) · Canal.car(L, id, x, y, s, o) puts a side-view car (Mok.car; o.flip nose left) with headlight beams
      const WY = 1180, RY = 1010;
      const Canal = {
        set(L, o = {}) {
          const id = o.id || "cn";
          put(L.sky, `<defs><linearGradient id="${id}-sk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#060a16"/><stop offset=".7" stop-color="#14203a"/><stop offset="1" stop-color="#2a3550"/></linearGradient>
            <radialGradient id="${id}-lamp"><stop offset="0" stop-color="#ffd890" stop-opacity=".9"/><stop offset=".35" stop-color="#ffb860" stop-opacity=".35"/><stop offset="1" stop-color="#ffb860" stop-opacity="0"/></radialGradient>
            <linearGradient id="${id}-wa" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1a2a2a"/><stop offset="1" stop-color="#050a0a"/></linearGradient></defs>
            <rect x="-1200" y="-800" width="3500" height="3600" fill="url(#${id}-sk)"/>
            ${Array.from({ length: 70 }, (_, k) => `<circle cx="${f1(-600 + ((k * 397) % 2300))}" cy="${f1(-300 + ((k * 211) % 1000))}" r="${(k % 3) + 1.2}" fill="#fff" opacity="${0.25 + (k % 4) * 0.15}"/>`).join("")}
            <circle cx="860" cy="210" r="46" fill="#f4ecd0" opacity=".9"/><circle cx="860" cy="210" r="140" fill="#f4ecd0" opacity=".08"/>`);
          // far bank: a dark tree line, two houses on stilts with a lit window, a temple roof
          let far = `<path d="M-1200,1060Q-900,960 -600,1010T0,990T600,1000T1200,980T2300,1000V1190H-1200Z" fill="#0b1410"/>`;
          [[-200, 1000], [320, 990], [1080, 1000]].forEach(([x, y], k) => {
            far += `<g transform="translate(${x},${y})"><path d="M-90,0V-90H90V0Z" fill="#141c22"/><path d="M-110,-88L0,-150L110,-88Z" fill="#101820"/>
              <rect x="${k === 1 ? -50 : 20}" y="-70" width="34" height="28" fill="#ffcf70" opacity=".85"/><path d="M-70,0V40M70,0V40" stroke="#141c22" stroke-width="10"/></g>`;
          });
          put(L.far, far);
          // the canal: dark water with the moon and the streetlights broken into ripples
          let mid = `<rect x="-1200" y="${WY - 60}" width="3500" height="1400" fill="url(#${id}-wa)"/>`;
          for (let k = 0; k < 26; k++) mid += `<path d="M${-900 + ((k * 263) % 2900)},${WY - 30 + ((k * 37) % 240)}h${40 + (k % 5) * 30}" stroke="#9fb8c8" stroke-width="3" opacity=".25" stroke-linecap="round"/>`;
          [[150, "#ffd890"], [560, "#ffd890"], [970, "#ffd890"], [860, "#f4ecd0"]].forEach(([x, c], k) => {
            for (let j = 0; j < 7; j++) mid += `<path d="M${x - 30 + (j % 2) * 16},${WY - 40 + j * 36}h${60 - j * 5}" stroke="${c}" stroke-width="5" opacity="${0.55 - j * 0.07}" stroke-linecap="round"/>`;
          });
          put(L.mid, `<g id="${id}-water">${mid}</g>`);
          // near bank and road (set layer): the grass slope down to the water, the asphalt with its edge line, lamp posts with glows
          let s = `<path d="M-1200,${RY + 30}H2300V${WY - 40}Q1200,${WY - 10} 540,${WY - 30}T-1200,${WY - 40}Z" fill="#15221a"/>
            <path d="M-1200,${RY - 70}H2300V${RY + 34}H-1200Z" fill="#2a2c30"/><path d="M-1200,${RY + 28}H2300" stroke="#d8d0b8" stroke-width="6" opacity=".7"/>
            ${Array.from({ length: 14 }, (_, k) => `<path d="M${-1100 + k * 260},${RY - 20}h120" stroke="#e8d890" stroke-width="7" opacity=".55"/>`).join("")}`;
          [150, 560, 970].forEach((x) => { s += `<path d="M${x},${RY - 70}V${RY - 520}Q${x},${RY - 560} ${x + 50},${RY - 560}" stroke="#3a3e46" stroke-width="12" fill="none"/><rect x="${x + 40}" y="${RY - 572}" width="44" height="16" rx="6" fill="#ffe0a0"/>`; });
          // reeds along the waterline, and the few concrete posts that stop short of where the car will go in
          for (let k = 0; k < 40; k++) { const x = -900 + k * 75 + ((k * 31) % 40); s += `<path d="M${x},${WY - 34}q${(k % 3) - 1 * 6},-60 ${(k % 2 ? 1 : -1) * 14},-${70 + (k % 4) * 14}" stroke="#2a4a30" stroke-width="5" fill="none"/>`; }
          [-640, -460, -280, 1240, 1420].forEach((x) => { s += `<rect x="${x}" y="${RY + 34}" width="22" height="60" fill="#c8c4b8" stroke="${INK}" stroke-width="3"/><rect x="${x}" y="${RY + 44}" width="22" height="12" fill="#d8312a"/>`; });
          put(L.set, s);
          put(L.glow, [150, 560, 970].map((x) => `<circle cx="${x + 62}" cy="${RY - 560}" r="220" fill="url(#${id}-lamp)"/>`).join(""));
        },
        car(L, id, x, y, s, o = {}) {
          const beam = `<path d="M${o.flip ? -330 : 330},-110L${o.flip ? -1500 : 1500},-260V60Z" fill="#fff3c8" opacity=".16"/>`;
          put(L.act, `<g id="${id}" transform="translate(${x},${y})"><g id="${id}-r"><g id="${id}-beam" opacity="${o.beam ?? 1}" transform="scale(${s})">${beam}</g>${Mok.car(`${id}-b`, 0, 0, s, { flip: o.flip })}</g></g>`);
        },
        // the water's front over a floating or sinking car: a band from y down, with a lit ripple line on top
        front(L, id, y) { put(L.act, `<g id="${id}"><rect x="-1200" y="${y}" width="3500" height="1400" fill="#0a1414" opacity=".88"/><path d="M-1200,${y}Q-600,${y - 10} 0,${y}T1200,${y}T2300,${y}" stroke="#9fb8c8" stroke-width="5" fill="none" opacity=".6"/></g>`); },
      };
      // insert: the driver's armrest, the four window switches and the lock button (the planted mistake). o.on: the lock already on
      const lockInsert = (L, id, o = {}) => {
        put(L.sky, `<rect x="-900" y="-600" width="2900" height="3400" fill="#14181e"/>`);
        put(L.set, `<g transform="translate(540,980)"><path d="M-520,-260Q-540,-300 -480,-310H500Q560,-300 540,-250L560,330H-560Z" fill="#2a2e36" stroke="${INK}" stroke-width="6"/>
          <path d="M-480,-300H500" stroke="#4a505a" stroke-width="8"/><rect x="-400" y="-200" width="820" height="420" rx="40" fill="#1a1d22" stroke="#3a3e46" stroke-width="6"/>
          ${[[-250, -60], [-80, -60], [-250, 110], [-80, 110]].map(([x, y], k) => `<g transform="translate(${x},${y})"><rect x="-60" y="-55" width="120" height="110" rx="18" fill="#30343c" stroke="${INK}" stroke-width="4"/>
            <path d="M-20,10L0,-20L20,10" stroke="#9aa2aa" stroke-width="6" fill="none" stroke-linecap="round"/><text y="44" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="22" fill="#7a828c">${["คนขับ", "ข้าง", "หลังซ้าย", "หลังขวา"][k]}</text></g>`).join("")}
          <g id="${id}-lock" transform="translate(190,25)"><rect x="-80" y="-80" width="160" height="160" rx="26" fill="#30343c" stroke="${INK}" stroke-width="4"/>
            <rect x="-40" y="-20" width="80" height="54" rx="8" fill="none" stroke="#c8ccd2" stroke-width="7"/><path d="M-24,-20V-38Q-24,-60 0,-60Q24,-60 24,-38V-20" stroke="#c8ccd2" stroke-width="7" fill="none"/>
            <circle id="${id}-led" cx="56" cy="-56" r="10" fill="#ff8a2a" opacity="${o.on ? 1 : 0.15}"/></g></g>`);
        put(L.act, `<g transform="translate(${o.on ? 730 : 900},${o.on ? 1000 : 1350})"><g id="${id}-finger">${handAt([98, 96], -8, 2.6, SK.ton, { ...POKE, band: BAND, sw: 0.55, fore: 800 })}</g></g>`);
      };
      const pressLock = (tl, id, t) => {
        tl.fromTo(`#${id}-finger`, { x: 0, y: 0 }, { x: -170, y: -350, duration: 0.45, ease: "power2.out", immediateRender: false }, t);
        tl.to(`#${id}-finger`, { y: -335, duration: 0.08, yoyo: true, repeat: 1 }, t + 0.45);
        tl.to(`#${id}-led`, { opacity: 1, duration: 0.05 }, t + 0.5);
      };
      // HUD (screen space): a dark slab with a big value and a label; returns the value element's id to drive
      const hudCard = (L, tl, t0, dur, id, o) => {
        const x = o.x ?? 540, y = o.y ?? 250, w = o.w ?? 420, c = o.color || "#ff5a3a";
        put(L.light, `<g transform="translate(${x},${y})"><g id="${id}" opacity="0"><rect x="${-w / 2 + 6}" y="-62" width="${w}" height="130" rx="30" fill="#000" opacity=".35"/>
          <rect x="${-w / 2}" y="-68" width="${w}" height="130" rx="30" fill="#0e1218" opacity=".9" stroke="${c}" stroke-width="5"/>
          <text x="${-w / 2 + 34}" y="-22" font-family="Kanit" font-weight="700" font-size="30" fill="#c8d0d8">${o.label}</text>
          <text id="${id}-v" x="${-w / 2 + 34}" y="40" font-family="Kanit" font-weight="900" font-size="64" fill="${c}">${o.value}</text>
          ${o.src ? `<text x="${w / 2 - 24}" y="44" text-anchor="end" font-family="Kanit" font-weight="400" font-size="22" fill="#7a8490">${o.src}</text>` : ""}</g></g>`);
        tl.fromTo(`#${id}`, { opacity: 0, scale: 0.6, svgOrigin: `${x} ${y}` }, { opacity: 1, scale: 1, svgOrigin: `${x} ${y}`, duration: 0.35, ease: "back.out(2.2)", immediateRender: false }, t0);
        tl.to(`#${id}`, { opacity: 0, duration: 0.2 }, t0 + dur - 0.2);
        return `${id}-v`;
      };
      // the one-minute countdown: whole seconds tick down from `from` while the shot runs
      const countdown = (L, tl, t0, dur, id, from, o = {}) => {
        const v = hudCard(L, tl, t0, dur, id, { label: "รถลอยได้อีก", value: `${from} วิ`, color: "#ff5a3a", x: o.x ?? 790, y: o.y ?? 230, w: 360, src: o.src });
        const el = document.getElementById(v), c = { s: from };
        tl.fromTo(c, { s: from }, { s: Math.max(0, from - (o.rate ?? 1) * dur), duration: dur, ease: "none", immediateRender: false, onUpdate: () => (el.textContent = `${Math.ceil(c.s)} วิ`) }, t0);
      };
      // the steps (screen space, left column): each lands with a tick at its time
      const stepList = (L, tl, t0, dur, id, items, o = {}) => {
        const x = o.x ?? 60, y0 = o.y ?? 380;
        put(L.light, `<g id="${id}" opacity="0">${items.map(([txt], k) => `<g id="${id}-s${k}" opacity="0" transform="translate(${x},${y0 + k * 96})"><rect width="${34 + txt.length * 26}" height="76" rx="22" fill="#0e1218" opacity=".88" stroke="#3ad06a" stroke-width="4"/>
          <circle cx="40" cy="38" r="22" fill="#3ad06a"/><path d="M29,38l8,9l16,-18" stroke="#0e1218" stroke-width="7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <text x="76" y="50" font-family="Kanit" font-weight="800" font-size="36" fill="#fff">${txt}</text></g>`).join("")}</g>`);
        tl.set(`#${id}`, { opacity: 1 }, t0);
        items.forEach(([, t], k) => tl.fromTo(`#${id}-s${k}`, { opacity: 0, x: -40 }, { opacity: 1, x: 0, duration: 0.3, ease: "back.out(2)", immediateRender: false }, t0 + t));
        tl.to(`#${id}`, { opacity: 0, duration: 0.2 }, t0 + dur - 0.2);
      };
      // the rewind: a VHS tear over the shot and the "↺ 0:04" badge
      const rewind = (L, tl, t0, dur, label) => {
        const id = `rw${Math.round(t0 * 100)}`;
        put(L.light, `<g id="${id}"><rect width="1080" height="1920" fill="#0a0e14" opacity=".25"/>${Array.from({ length: 9 }, (_, k) => `<rect id="${id}-l${k}" x="0" y="${k * 220}" width="1080" height="${8 + (k % 3) * 6}" fill="#fff" opacity=".18"/>`).join("")}
          <g transform="translate(540,300)"><rect x="-190" y="-70" width="380" height="140" rx="70" fill="#ff5a3a" stroke="#fff" stroke-width="6"/>
          <text y="26" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="78" fill="#fff">↺ ${label}</text></g></g>`);
        tl.fromTo(`#${id}`, { opacity: 0 }, { opacity: 1, duration: 0.12, immediateRender: false }, t0);
        for (let k = 0; k < 9; k++) tl.fromTo(`#${id}-l${k}`, { y: 0 }, { y: 1920, duration: 0.6, repeat: Math.ceil(dur / 0.6), ease: "none", immediateRender: false }, t0 + k * 0.05);
      };
      // the next-episode card and the channel card (screen space)
      const nextCard = (L, tl, t0, dur, l1, l2, cta) => {
        put(L.light, `<g id="nx"><rect width="1080" height="1920" fill="#06080c" opacity=".92"/><text x="540" y="700" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="46" fill="#ff5a3a">ตอนต่อไป</text>
          <text x="540" y="820" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="66" fill="#fff">${l1}</text>
          <text x="540" y="920" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="66" fill="#ffd23a">${l2}</text>
          <text x="540" y="1120" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="40" fill="#c8d0d8">${cta}</text>
          <text x="540" y="1660" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="44" fill="#fff" letter-spacing="10">ROD MAI CLUB</text>
          <text x="540" y="1716" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="32" fill="#8a94a0">นาทีก่อนจม</text></g>`);
        tl.fromTo("#nx", { opacity: 0 }, { opacity: 1, duration: 0.3, immediateRender: false }, t0);
      };
      // the cabin from the bonnet (Sets.carInterior): call after the actors exist. Brings the dashboard (and a seat back that hides the
      // back-seat passenger's legs) over the people, and adds murky water rising from y0 to y1 between t and t + len
      const cabinWater = (L, tl, id, t, len, y0, y1) => {
        put(L.act, `<g id="${id}-cw"><rect x="-900" y="0" width="2900" height="2000" fill="#2a4a3a" opacity=".55"/><path d="M-900,0Q-300,-14 300,0T1500,0T2000,0" stroke="#9fc8b8" stroke-width="6" fill="none" opacity=".6"/></g>`);
        tl.set(`#${id}-cw`, { y: y0 }, 0); tl.fromTo(`#${id}-cw`, { y: y0 }, { y: y1, duration: len, ease: "sine.inOut", immediateRender: false }, t);
      };
      const cabinTop = (L, id) => {
        put(L.act, `<rect x="640" y="760" width="360" height="520" rx="60" fill="#2a2e34" stroke="#1e2228" stroke-width="5"/><rect x="720" y="700" width="200" height="100" rx="36" fill="#30353c" stroke="#1e2228" stroke-width="5"/>`);
        const d = document.getElementById(`${id}-dash`); if (d) L.act.appendChild(d);
      };
      // ---------- ท่อนซุงลงเขา EP.2 ซุงหล่นตรงหน้า (ตอนจบ) ----------
      // grammar: the stack pours off (0–0.8 full-screen action) → title in profile → หนิง screams → the 2 s gap pays: the log stops short
      // → the rail, the grille in the mirror stops → เจ๋ง wants to lift it → หนิง stops him → K4 → the calls → the foot of the hill, relief, selfie
      // → the hiss first → the one behind us all the way rolls in: an LPG tanker (orange plate, red diamond), smoke at its wheels → K6 → the smoke
      //   drifts toward the pumps → the debate question → black. No explosion, nobody hurt.
      const GDAY = { top: "#fff3d6", bottom: "#cfe6f4", op: 0.08 }, GLATE = { top: "#ffe0b0", bottom: "#c8d8ec", op: 0.12 }, GDUSK = { top: "#ffc890", bottom: "#a8b8d8", op: 0.16 };
      const SUN = { from: "left", rim: "#fff6dc", rimOp: 0.7, shade: "#2a2440", shadeOp: 0.22, cast: false, vol: false };
      const DUSK = { from: "right", rim: "#ffd8a0", rimOp: 0.8, shade: "#2a2440", shadeOp: 0.3, cast: { len: 1.4, op: 0.3 }, vol: false };
      const A = (who, x, y, s, track, extra = {}) => { if (extra.talk) track.talk = Array.isArray(extra.talk[0]) ? extra.talk : [extra.talk]; return { who, x, y, s, track, blinks: [0.7, 2.3, 3.9], ...extra }; };
      const TALK = (k, i, m = "o") => [vo(k, i), voEnd(k, i), m];
      const LIFE = (k, extra, dur) => (tl, id, t0, L) => { Lt.life(tl, `#${id}`, t0, dur ?? D(k)); if (extra) extra(tl, id, t0, L); };
      const flash = (tl, t, op = 0.85) => { tl.set("#flashw", { opacity: op }, t); tl.to("#flashw", { opacity: 0, duration: 0.25 }, t + 0.03); };
      const kick = (a, b, amp) => (t) => (t >= a && t < b ? { x: amp * Math.sin(t * 61) * (1 - (t - a) / (b - a)), y: amp * 0.8 * Math.sin(t * 47) * (1 - (t - a) / (b - a)), r: 0 } : 0);
      const rumble = (amp = 2.2) => (t) => ({ x: amp * Math.sin(t * 23) + amp * 0.5 * Math.sin(t * 61), y: amp * 0.8 * Math.sin(t * 31), r: 0.12 * Math.sin(t * 7) });
      const TN = Math.tan(9 * Math.PI / 180);
      const POV = (id, o = {}) => ({ set: "ltPOV", setOpts: { id, mirror: 0.9, late: true, ...o }, dark: 0, grade: GLATE, blur: { fg: 2 } });
      const SLOPE = (id, o = {}) => ({ set: "ltSlope", setOpts: { id, ground: 1300, slope: 9, late: true, ...o }, dark: 0, grade: GLATE, blur: { far: 1.5, fg: 8 } });
      const CONVOY = (o = {}) => ({ truck: 1700, car: 900, tank: -270, trs: 0.62, cs: 0.62, ts: 0.62, cabOnly: true, ...o });
      const CAB = (id, o = {}) => ({ set: "ltCabin", setOpts: { id, rear: "grille", clock: "14:41", ...o }, dark: 0, light: SUN, grade: GLATE, blur: { far: 3, fg: 0.5 } });
      const CABCAM = (k, z = 0.04) => ({ keys: [{ t: 0, ...fr(540, 1100, 1.05, 540, 1000) }, { t: D(k), glide: D(k), ...fr(540, 1100, 1.05 + z, 540, 1000) }] });
      const JENG = (track, extra = {}) => A("jeng", 320, 1880, 1.6, track, extra);
      const NING = (track, extra = {}) => A(extra.phone ? "ningPhone" : "ning", 770, 1880, 1.52, track, extra);
      const coin = (tl, L, name, id, t, dur, x = 540, y = 470, s = 2.4) => { put(L.glow, Lt.coin(name, x, y, s, id)); Lt.coinIn(tl, id, t, dur); };
      const hxcoin = (tl, L, name, id, t, dur, x, y, s) => { put(L.glow, HnFx.coin(name, x, y, s, id)); HnFx.pop(tl, id, t); HnFx.life(tl, id, t, dur); };
      const beams = (tl, sels, t0, times, on = 0.16) => times.forEach((k) => { tl.set(sels, { opacity: 1 }, t0 + k); tl.set(sels, { opacity: 0 }, t0 + k + on); });
      const ST = (id, o = {}) => ({ set: "ltStation", setOpts: { id, car: 300, cs: 0.8, ...o }, dark: 0, light: DUSK, grade: GDUSK, blur: { far: 2, fg: 6 } });
      const G = 1500, TANK_END = 0, TANK_Y = 1440;

      // ---------- 1. the stack pours off the back: three logs tumble down the road at the lens; brake, screech ----------
      add("hook", { ...POV("h", { truck: { x: 560, y: 1290, s: 0.72, brake: 1, smoke: 1 }, spill: 3 }),
        cam: { keys: [{ t: 0, ...fr(560, 1010, 1.24, 540, 960) }, { t: D("hook"), glide: D("hook"), ...fr(560, 1020, 1.1, 540, 960) }] },
        shake: (t) => { const a = t < 1.4 ? 10 : 3; const dip = t > 0.7 && t < 1.8 ? 16 * Math.sin((t - 0.7) / 1.1 * Math.PI) : 0; return { x: a * Math.sin(t * 67), y: a * 0.8 * Math.sin(t * 49) + dip, r: 0.35 * Math.sin(t * 29) }; },
        captions: caps("hook"),
        fx: LIFE("hook", (tl, id, t0, L) => {
          tl.set("#h-truck-stack", { rotation: -9, y: 30, transformOrigin: "50% 100%" }, 0);
          tl.to("#h-truck-stack", { rotation: -16, y: 90, duration: 0.6, ease: "power2.in", transformOrigin: "50% 100%" }, t0);
          tl.to(["#h-truck-ch0", "#h-truck-ch1"], { opacity: 0, duration: 0.1 }, t0);
          Lt.sparks(tl, L.glow, t0 + 0.02, 400, 1000, 1.1, 14, 7);
          const paths = [
            [[560, 1000, 0.45, -8], [520, 1300, 1.2, 10], [470, 1180, 1.6, -6], [430, 1500, 3.2, 4]],
            [[590, 960, 0.45, 6], [640, 1290, 1.0, -12], [760, 1200, 1.0, 8], [980, 1290, 0.9, 2]],
            [[530, 920, 0.45, -4], [460, 1270, 0.9, 14], [300, 1200, 0.85, -10], [140, 1260, 0.8, 0]] ];
          paths.forEach((P, k) => tl.fromTo(`#h-sp${k}`, { attr: { transform: `translate(${P[0][0]},${P[0][1]}) scale(${P[0][2]}) rotate(${P[0][3]})` } }, { keyframes: P.slice(1).map((q, j) => ({ attr: { transform: `translate(${q[0]},${q[1]}) scale(${q[2]}) rotate(${q[3]})` }, duration: [0.3, 0.3, 0.5][j], ease: j % 2 ? "power2.out" : "power2.in" })), immediateRender: false }, t0 + 0.05 + k * 0.12));
          HnFx.dust(tl, L.glow, t0 + 0.35, 520, 1380, 2.4); HnFx.dust(tl, L.glow, t0 + 0.5, 760, 1330, 1.8);
          flash(tl, t0 + 0.78, 0.5);
        }) });

      // ---------- 2. the command, in profile: logs across the road between the truck and our car; title EP.2 ----------
      add("cmd", { ...SLOPE("c", { convoy: CONVOY({ brake: 1, cbrake: 1, smoke: 1 }), title: { x: 1180, s: 0.62, top: "ท่อนซุงลงเขา", km: "EP.2 ซุงหล่นตรงหน้า", fs: 60 } }),
        cam: { keys: [{ t: 0, ...fr(1150, 1250, 0.86, 540, 1000) }, { t: D("cmd"), glide: D("cmd"), ...fr(1180, 1260, 0.9, 540, 1000) }] }, shake: kick(0, 0.6, 6),
        captions: caps("cmd"),
        fx: LIFE("cmd", (tl, id, t0, L) => {
          put(L.act, [1260, 1340, 1430].map((x, k) => `<g id="c-lg${k}">${Lt.logEnd(x, 1300 + (x - 540) * TN - 14 - k * 4, 34 - k * 2, 30 + k)}</g>`).join(""));
          [0, 1, 2].forEach((k) => tl.fromTo(`#c-lg${k}`, { x: -40 - k * 30, rotation: -90, transformOrigin: "50% 50%" }, { x: 0, rotation: 0, transformOrigin: "50% 50%", duration: 0.6 + k * 0.15, ease: "power3.out", immediateRender: false }, t0));
        }) });

      // ---------- 3. หนิง screams; both thrown forward ----------
      add("stop", { ...CAB("s"), cam: CABCAM("stop", 0.08), shake: kick(0, 0.9, 14),
        actors: [JENG([{ t: 0, mode: "idle", eyes: "pain", mouth: "scream" }]), NING([{ t: 0, mode: "idle", eyes: "wide", mouth: "scream" }], { flip: true, talk: TALK("stop", 0, "scream") })],
        captions: caps("stop", null, { quote: true }), fx: LIFE("stop") });

      // ---------- 4. stopped: one log rolls at us and stops short of the bonnet; the 2 s gap paid ----------
      add("short", { ...POV("o", { mirror: 1, truck: { x: 560, y: 1200, s: 0.5, brake: 1, smoke: 1 }, loose: { x: 560, y: 1160, s: 0.6 } }),
        cam: { keys: [{ t: 0, ...fr(560, 1010, 1.12, 540, 960) }, { t: D("short"), glide: D("short"), ...fr(560, 1020, 1.2, 540, 960) }] },
        captions: caps("short"),
        fx: LIFE("short", (tl, id, t0, L) => {
          tl.set("#o-truck-stack", { rotation: -16, y: 90, transformOrigin: "50% 100%" }, 0);
          tl.fromTo("#o-loose", { attr: { transform: "translate(560,1160) scale(0.6)" } }, { attr: { transform: "translate(540,1390) scale(1.35)" }, duration: 1.4, ease: "power2.out", immediateRender: false }, t0);
          tl.fromTo("#o-loose .lroll", { x: 0 }, { x: 10, duration: 0.07, repeat: 14, yoyo: true, immediateRender: false }, t0);
          coin(tl, L, "gap", "o-coin", t0 + F("short", 0, 1) - 0.1, D("short") - F("short", 0, 1), 780, 560, 2.2);
        }, D("short")) });

      // ---------- 5. the logs at the rail; then the mirror: the grille rushes in, air brakes, stops inches away ----------
      split("rail", 2.1,
        { ...SLOPE("r", { convoy: CONVOY({ brake: 1, cbrake: 1, smoke: 0.6 }) }),
          cam: { keys: [{ t: 0, ...fr(1350, 1330, 1.0, 540, 1000) }, { t: 2.1, glide: 2.1, ...fr(1420, 1340, 1.05, 540, 1000) }] },
          captions: caps("rail").filter((c) => c.t < 2.1),
          fx: LIFE("rail", (tl, id, t0, L) => {
            put(L.act, [1290, 1380].map((x, k) => `<g id="r-lg${k}">${Lt.logEnd(x, 1300 + (x - 540) * TN - 14, 34, 40 + k)}</g>`).join(""));
            [0, 1].forEach((k) => tl.fromTo(`#r-lg${k}`, { x: 0, y: 0, rotation: 0, transformOrigin: "50% 50%" }, { x: 120 + k * 60, y: 46 + k * 10, rotation: 260, transformOrigin: "50% 50%", duration: 1.2, ease: "power2.out", immediateRender: false }, t0 + 0.1 + k * 0.2));
          }, 2.1) },
        { set: "ltMirror", setOpts: { id: "m", is: 1.0, iy: 1330 }, dark: 0, grade: GLATE, blur: { fg: 3 },
          cam: { keys: [{ t: 0, ...fr(540, 1000, 0.82, 540, 960) }, { t: D("rail") - 2.1, glide: 1.0, ...fr(540, 880, 1.35, 540, 900) }] },
          shake: kick(0.2, 1.4, 10), captions: capsFrom("rail", 2.1),
          fx: LIFE("rail", (tl, id, t0) => {
            tl.fromTo("#m-img", { attr: { transform: "translate(540,1330) scale(0.9)" } }, { attr: { transform: "translate(540,1560) scale(1.6)" }, duration: 0.9, ease: "power3.out", immediateRender: false }, t0 + 0.1);
            tl.fromTo("#m-img", { x: 0 }, { x: 6, duration: 0.05, repeat: 12, yoyo: true, immediateRender: false }, t0 + 1.0);
          }, D("rail") - 2.1) });

      // ---------- 6. เจ๋ง reaches for the door; 7. หนิง grabs his arm ----------
      add("help", { ...CAB("p"), cam: CABCAM("help"),
        actors: [JENG([{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: 0.5, mode: "point", eyes: "normal", mouth: "flat" }], { talk: TALK("help", 0) }), NING([{ t: 0, mode: "idle", eyes: "worry", mouth: "flat" }], { flip: true })],
        captions: caps("help", null, { quote: true }), fx: LIFE("help") });
      add("no", { ...CAB("q"), cam: CABCAM("no", 0.08), shake: kick(0, 0.4, 5),
        actors: [JENG([{ t: 0, mode: "point", eyes: "wide", mouth: "o" }, { t: 0.6, mode: "idle", eyes: "wide", mouth: "o" }]), NING([{ t: 0, mode: "point", eyes: "angry", mouth: "scream" }], { flip: true, talk: TALK("no", 0, "scream") })],
        captions: caps("no", null, { quote: true }), fx: LIFE("no") });

      // ---------- 8. K4: stopped on the shoulder; the log across the lane; the coin "don't lift it" ----------
      add("k4", { ...SLOPE("k", { convoy: CONVOY({ truck: 1900, brake: 1, cbrake: 0 }) }),
        cam: { keys: [{ t: 0, ...fr(1150, 1260, 0.84, 540, 1040) }, { t: D("k4"), glide: D("k4"), ...fr(1230, 1270, 0.88, 540, 1040) }] },
        captions: caps("k4"),
        fx: LIFE("k4", (tl, id, t0, L) => {
          put(L.act, `<g id="k-lg">${Lt.logEnd(1400, 1300 + 860 * TN - 14, 34, 51)}</g>`);
          coin(tl, L, "nolift", "k-coin", t0 + F("k4", 0, 1) - 0.1, D("k4") - F("k4", 0, 1), 1250, 880, 2.4);
        }) });

      // ---------- 9. the calls: หนิง on the phone; coins 1586 / 1193 and 1669 ----------
      add("call", { ...CAB("cl", { rear: "grille", folS: 0.8, folY: 1260 }), cam: CABCAM("call", 0.05),
        actors: [JENG([{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }]), NING([{ t: 0, mode: "phoneEar", eyes: "normal", mouth: "flat" }], { flip: true, phone: true })],
        captions: caps("call"),
        fx: LIFE("call", (tl, id, t0, L) => {
          coin(tl, L, "call", "cl-c1", t0 + 0.15, D("call"), 330, 560, 2.3);
          hxcoin(tl, L, "phone", "cl-c2", t0 + F("call", 0, 2) - 0.1, D("call") - F("call", 0, 2), 750, 560, 2.3);
        }) });

      // ---------- 10. the foot of the hill: the gas station in the late sun; relief ----------
      add("foot", { ...ST("f"), cam: { keys: [{ t: 0, ...fr(560, 1150, 0.72, 540, 1000) }, { t: D("foot"), glide: D("foot"), ...fr(600, 1200, 0.8, 540, 1000) }] },
        actors: [A("jeng", 760, G + 20, 1.0, [{ t: 0, mode: "idle", eyes: "closed", mouth: "smile" }]), A("ning", 940, G + 30, 0.96, [{ t: 0, mode: "idle", eyes: "normal", mouth: "smile" }], { flip: true })],
        captions: caps("foot"), fx: LIFE("foot") });

      // ---------- 11. selfie ----------
      add("selfie", { ...ST("sf"), cam: { keys: [{ t: 0, ...fr(840, 1180, 1.0, 540, 1000) }, { t: D("selfie"), glide: D("selfie"), ...fr(840, 1160, 1.08, 540, 1000) }] },
        actors: [A("jeng", 760, G + 20, 1.0, [{ t: 0, mode: "idle", eyes: "normal", mouth: "smile" }]), A("ningPhone", 940, G + 30, 0.96, [{ t: 0, mode: "raise", eyes: "normal", mouth: "laugh" }], { flip: true, talk: TALK("selfie", 0, "laugh") })],
        captions: caps("selfie", null, { quote: true }), fx: LIFE("selfie") });

      // ---------- 12. the hiss first; headlights sweep over them; เจ๋ง turns ----------
      add("what", { ...ST("w"), cam: { keys: [{ t: 0, ...fr(840, 1180, 1.05, 540, 1000) }, { t: D("what"), glide: D("what"), ...fr(820, 1180, 1.12, 540, 1000) }] },
        actors: [A("jeng", 760, G + 20, 1.0, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: 0.6, mode: "idle", eyes: "wide", mouth: "o" }], { talk: TALK("what", 0) }), A("ningPhone", 940, G + 30, 0.96, [{ t: 0, mode: "raise", eyes: "normal", mouth: "smile" }, { t: 0.9, mode: "raise", eyes: "wide", mouth: "o" }], { flip: true })],
        captions: caps("what", null, { quote: true }),
        fx: LIFE("what", (tl, id, t0) => { tl.fromTo("#w-sweep", { opacity: 0, x: -400 }, { opacity: 1, x: 1400, duration: D("what"), ease: "power1.inOut", immediateRender: false }, t0 + 0.3); }) });

      // ---------- 13. the reveal: the tanker rolls in behind them and stops beside the pumps; smoke at its wheels ----------
      add("reveal", { ...ST("v", { tank: -2200, ts: 0.62, tsmoke: 1 }), cam: { keys: [{ t: 0, ...fr(300, 1260, 0.62, 540, 1000) }, { t: D("reveal"), glide: D("reveal"), ...fr(520, 1260, 0.66, 540, 1000) }] },
        shake: kick(D("reveal") - 1.4, D("reveal") - 0.8, 4),
        actors: [A("jeng", 760, G + 20, 1.0, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }]), A("ningPhone", 940, G + 30, 0.96, [{ t: 0, mode: "raise", eyes: "wide", mouth: "o" }], { flip: true })],
        captions: caps("reveal"),
        fx: LIFE("reveal", (tl, id, t0) => {
          tl.set("#v-tank", { y: -60 }, 0);
          tl.fromTo("#v-tank", { x: 0 }, { x: 2200, duration: D("reveal") - 1.2, ease: "power2.out", immediateRender: false }, t0);
        }) });

      // ---------- 14. close: the orange plate and the red diamond; the coin ----------
      add("orange", { set: "ltPlate", setOpts: { id: "pl", smoke: 0.9 }, dark: 0, grade: GDUSK,
        cam: { keys: [{ t: 0, ...fr(540, 1460, 1.15, 540, 1100) }, { t: D("orange"), glide: D("orange"), ...fr(720, 760, 1.3, 540, 900) }] },
        captions: caps("orange"),
        fx: LIFE("orange", (tl, id, t0, L) => { coin(tl, L, "orange", "pl-coin", t0 + F("orange", 0, 1) - 0.1, D("orange") - F("orange", 0, 1), 260, 900, 2.0); }) });

      // ---------- 15. K6: หนิง lowers the phone; the smoke drifts toward the pumps; coins back away / no phone ----------
      add("k6", { ...ST("k", { tank: 0, ts: 0.62, tsmoke: 1 }), cam: { keys: [{ t: 0, ...fr(760, 1240, 0.86, 540, 1000) }, { t: D("k6"), glide: D("k6"), ...fr(700, 1240, 0.92, 540, 1000) }] },
        actors: [A("jeng", 760, G + 20, 1.0, [{ t: 0, mode: "idle", eyes: "wide", mouth: "flat" }], { moveTo: { x: 1060, dur: D("k6") * 0.7, at: 0.8 } }),
          A("ningPhone", 940, G + 30, 0.96, [{ t: 0, mode: "raise", eyes: "wide", mouth: "o" }, { t: F("k6", 0, 2), mode: "idle", eyes: "wide", mouth: "flat" }], { flip: true, moveTo: { x: 1200, dur: D("k6") * 0.7, at: 0.8 } })],
        captions: caps("k6"),
        fx: LIFE("k6", (tl, id, t0, L) => {
          tl.set("#k-tank", { y: -60 }, 0);
          tl.fromTo("#k-drift", { opacity: 0, x: 380, y: TANK_Y - 120 }, { opacity: 0.85, x: 820, y: G - 260, duration: D("k6"), ease: "sine.inOut", immediateRender: false }, t0);
          coin(tl, L, "back", "k-c1", t0 + F("k6", 0, 1) - 0.1, D("k6"), 420, 520, 2.0);
          coin(tl, L, "nophone", "k-c2", t0 + F("k6", 0, 2) - 0.1, D("k6") - F("k6", 0, 2), 820, 520, 2.0);
        }) });

      // ---------- 16. the question over the smoke at the pump; the hiss; black ----------
      add("ask", { ...ST("a", { tank: 0, ts: 0.62, tsmoke: 1 }), cam: { keys: [{ t: 0, ...fr(760, 1300, 1.2, 540, 1000) }, { t: D("ask"), glide: D("ask"), ...fr(820, 1320, 1.5, 540, 1000) }] },
        captions: caps("ask"),
        fx: LIFE("ask", (tl, id, t0) => {
          tl.set("#a-tank", { y: -60 }, 0);
          tl.fromTo("#a-drift", { opacity: 0.6, x: 700, y: G - 280 }, { opacity: 1, x: 860, y: G - 330, duration: D("ask"), ease: "sine.inOut", immediateRender: false }, t0);
          tl.to("#black", { opacity: 1, duration: 0.5 }, t0 + D("ask") - 0.9);
        }) });
