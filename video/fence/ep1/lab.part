      add("run", { set: "fenceNail", setOpts: { id: "n0", blood: true, foot: true }, dark: 0, light: false, grade: GD, cam: { keys: [{ t: 0, ...fr(540, 900, 0.8, 540, 1000), drift: { s: 0 } }] } });
      add("gate", { set: "fenceLock", setOpts: { id: "l0", lock: "open", horde: 8 }, dark: 0, light: false, grade: GK, cam: { keys: [{ t: 0, ...fr(540, 1000, 0.8, 540, 1000), drift: { s: 0 } }] } });
      add("free", { set: "fenceRadio", setOpts: { id: "ra0" }, dark: 0, light: false, grade: GN, cam: { keys: [{ t: 0, ...fr(540, 1150, 0.8, 540, 1000), drift: { s: 0 } }] }, fx(tl, id, t0) { Fence.life(tl, "ra0", t0, D("free")); } });
      add("bulge", { set: "fenceOut", setOpts: { id: "o1", time: "night", hill: true, blink: true, lit: true }, dark: 0.05, light: NITE, grade: GN,
