      // ---------- lab: style-frame test of the world ----------
      const A = (who, x, y, s, track, extra = {}) => { if (extra.talk) track.talk = extra.talk; return { who, x, y, s, track, blinks: [0.8, 2.9], ...extra }; };
      const DAYL = { from: "left", rim: "#fff2d0", rimOp: 0.5, shade: "#3a3048", shadeOp: 0.25, cast: { len: 0.5, op: 0.25 }, vol: false };
      const DUSKL = { from: "left", rim: "#ffb070", rimOp: 0.7, shade: "#2a1a3a", shadeOp: 0.35, cast: false, vol: false };
      const NITE = { from: "right", rim: "#ffd090", rimOp: 0.6, shade: "#0a0e1e", shadeOp: 0.45, cast: false, vol: false };
      const GD = { top: "#fff0d0", bottom: "#3a2a20", op: 0.08 }, GK = { top: "#5a3a6a", bottom: "#2a1418", op: 0.18 }, GN = { top: "#1a2448", bottom: "#05070e", op: 0.3 };
      add("hook", { set: "fenceYard", setOpts: { id: "y0", time: "day", gen: 600 }, dark: 0, light: DAYL, grade: GD,
