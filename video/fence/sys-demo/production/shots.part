      // ======================================================================================================
      // systems demo: the title from the sky → the camp register → the recipe page → the 20-second countdown
      // ======================================================================================================
      const CAP = (text, t, end) => ({ text, t, end });
      const ZF = (L, tl, pre, t0, dur, list) => list.forEach(([w, x, s, ph], k) => behind(L, tl, `${pre}-z${k}`, w, x, 1180, s, true, t0, dur, [{ t: 0, mode: "lunge", eyes: "dead", mouth: "snarl", opts: { period: 1.2 + ph } }]));

      // ---------- 0. title: from the sky, the card, the drop onto the school ----------
      add("title", {
        set: "schoolYard", setOpts: { id: "tt", time: "day" }, dark: 0.08, blur: { mid: 5, far: 2 },
        cam: { keys: [{ t: 0, ...fr(540, -1600, 0.58, 540, 900), r: 5, drift: { s: 0.03, r: -0.4 } }, { t: 2.55, glide: 2.2, ...fr(560, 760, 0.62, 540, 900), r: 0 }] },
        ui: [{ type: "callback", t: 0.25, end: 2.3, label: "เอาชีวิตรอด 99 วัน · ระบบใหม่ 3 อย่าง", text: "ทักษะ · คราฟ · นับถอยหลัง", top: 640 }],
        extra(L) { Fence.clouds(L); Fence.light(L, 800, 240, 900, "#ffe6b0", 0.35); Fence.haze(L, 1120, 460, "#dfe8ea", 0.35); },
        fx(tl, id, t0) { tl.set("#black", { opacity: 1 }, t0); tl.to("#black", { opacity: 0, duration: 0.5, ease: "power1.out" }, t0 + 0.05); Fx.speed(tl, t0 + 1.2, t0 + 2.4); tl.set("#fxspeed", { opacity: 0 }, t0 + 2.45); },
      });

      // ---------- 1. the register: five of them in the yard, the camera pans along the line as each row is written in ----------
      {
        const c0 = fr(260, 1180, 0.78, 540, 1150);
        add("roster", {
          set: "schoolYard", setOpts: { id: "ro", time: "day" }, dark: 0.1, blur: { far: 3 },
          cam: { keys: [{ t: 0, ...c0 }, { t: 7.5, glide: 7.3, ...fr(880, 1180, 0.84, 540, 1150) }] },
          actors: [MA(-240, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: 0.9, mode: "raise", eyes: "normal", mouth: "smile" }, { t: 2.3, mode: "idle", eyes: "normal", mouth: "flat" }]),
            KO(100, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: 2.1, mode: "run", eyes: "wide", mouth: "flat" }, { t: 3.5, mode: "idle", eyes: "normal", mouth: "smile" }]),
            HO(440, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: 3.3, mode: "write", eyes: "normal", mouth: "flat" }, { t: 4.7, mode: "idle", eyes: "normal", mouth: "flat" }], { prop: "ledger" }),
            PU(760, 1500, 0.58, [{ t: 0, mode: "idle", eyes: "normal", mouth: "smile" }, { t: 4.5, mode: "pointUp", eyes: "wide", mouth: "smile" }, { t: 5.9, mode: "idle", eyes: "normal", mouth: "smile" }], { prop: "crayon" }),
            PI(1060, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: 5.7, mode: "point", eyes: "normal", mouth: "smile" }, { t: 7.1, mode: "idle", eyes: "normal", mouth: "flat" }], { flip: true })],
          captions: [CAP("แต่ละคน… [มีดีคนละอย่าง]", 0.3, 3.0), CAP("ไม่มีใคร {ทำแทนกันได้}", 5.9, 7.45)],
          ui: [{ type: "roster", t: 0.3, end: 7.4, top: 150, title: "ทะเบียนค่าย", who: "วันที่ 101 · ครูพิมแบ่งหน้าที่", rows: [
            { name: "ลุงหมาน", skill: "ช่าง", desc: "ซ่อมได้ทุกเครื่อง · คราฟอาวุธ", icon: "wrench", at: 0.9 },
            { name: "ก้อง", skill: "นักวิ่ง", desc: "เร็วที่สุด · ออกไปหาของ", icon: "shoe", at: 2.1 },
            { name: "เจ๊หงส์", skill: "คลัง", desc: "นับทุกอย่าง · รู้ว่าของอยู่ไหน", icon: "ledger", at: 3.3 },
            { name: "น้องปั้น", skill: "ตาดี", desc: "เห็นก่อนใคร · รูปวาดคือเบาะแส", icon: "eye", at: 4.5 },
            { name: "ครูพิม", skill: "ผู้นำ", desc: "ตัดสินใจแทนทุกคน", icon: "lead", at: 5.7 }] }],
          extra(L) { Fence.light(L, 760, 300, 900, "#ffe6b0", 0.3); Fence.haze(L, 1120, 460, "#dfe8ea", 0.3); Fence.depth(L, "grass", { cam: c0 }); },
        });
      }

      // ---------- 2. the recipe, first person: our two hands on the desk — the broom handle, the knife taped on, the finished spear raised; ลุงหมาน's hand slides the steel pipe on ----------
      {
        const KN = (id) => `<g id="${id}" opacity="0"><rect x="8" y="-70" width="28" height="120" rx="8" fill="#5a3a1e" stroke="#2e2a26" stroke-width="4"/><path d="M4,50h36l-6,250q-12,26 -24,0z" fill="url(#fCan)" stroke="#2e2a26" stroke-width="4" stroke-linejoin="round"/><path d="M16,60l2,210" stroke="#fff" stroke-width="3" opacity=".55"/></g>`;
        const ROLL = (id) => `<g id="${id}" opacity="0" transform="translate(22,-10)"><circle r="54" fill="#1f1d1a" stroke="#2e2a26" stroke-width="4"/><circle r="54" fill="none" stroke="#3a3632" stroke-width="12" stroke-dasharray="6 9"/><circle r="22" fill="#e8dcc6" stroke="#2e2a26" stroke-width="4"/></g>`;
        const held = { L: "translate(378,1214) rotate(90) scale(-0.62,0.62)", R: "translate(809,1126) rotate(-90) scale(0.62,0.62)" };
        add("craft", {
          set: "classroom", setOpts: { id: "cf", night: true, lampX: 540, lampY: 700 }, dark: 0.28, blur: { far: 4 },
          cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960), drift: { s: 0.012, y: -6 } }] },
          shake: (t) => 3 * Math.sin(t * 2.1) + 1.5 * Math.sin(t * 5.3),
          captions: [CAP("อาวุธหมด… {ต้องประกอบเอง}", 0.3, 4.1), CAP("ไม้กวาด + มีด + เทป = [หอกมีด]", 4.5, 7.5), CAP("ลุงหมานเป็นช่าง… {อัปเกรด} ได้อีกขั้น", 7.8, 11.3)],
          ui: [{ type: "craft", t: 0.4, end: 11.35, top: 150, title: "สูตรประดิษฐ์", who: "สมุดสูตร · ลุงหมาน",
            parts: [{ icon: "broom", label: "ไม้กวาด", at: 1.2 }, { icon: "knife", label: "มีดครัว", at: 2.3 }, { icon: "tape", label: "เทปพันสาย", at: 3.4 }],
            build: 4.6, result: { icon: "spear", label: "หอกมีด" }, stats: [{ label: "ระยะ", v: 3 }, { label: "แรง", v: 3 }, { label: "เสียง", v: 1 }],
            upgrade: { at: 8.0, part: { icon: "pipe", label: "ท่อเหล็กบันไดแท็งก์" }, label: "หอกมีด +1", stats: [{ v: 5 }, { v: 4 }, { v: 1 }] } },
            { type: "skill", t: 7.3, end: 10.9, x: 40, y: 760, name: "ลุงหมาน", skill: "ช่าง", desc: "อัปเกรดได้คนเดียวในค่าย", icon: "wrench" }],
          extra(L) {
            // the desk fills the lower frame (we are leaning over it); the lamp pools light on it
            L.set.insertAdjacentHTML("beforeend", `<path d="M-1200,900L2300,900L2300,2800L-1200,2800Z" fill="#6b4a2e" stroke="#2e2a26" stroke-width="4"/><path d="M-1200,900L2300,900L2300,940L-1200,940Z" fill="#8a6a42"/>${[1020, 1160, 1320, 1500, 1700, 1950, 2250].map((y) => `<path d="M-1200,${y}L2300,${y}" stroke="#5a3d24" stroke-width="3" opacity=".8"/>`).join("")}<ellipse cx="600" cy="1380" rx="760" ry="330" fill="#9a7045" opacity=".28"/>`);
            glow(L, `<circle cx="560" cy="1050" r="720" fill="url(#fLamp)" opacity=".55"/>`);
            const ko = Rig.CAST.kong, ma = Rig.CAST.man;
            const BROOM = `<rect class="shaft" x="0" y="-18" width="864" height="36" rx="12" fill="#c9955c" stroke="#2e2a26" stroke-width="4"/><path d="M-40,-60q-40,60 0,120h70q10,-60 0,-120z" fill="#e2c988" stroke="#2e2a26" stroke-width="4" stroke-linejoin="round"/><path d="M-30,-40v80M-10,-50v100M10,-44v88" stroke="#a78a4a" stroke-width="3"/><rect x="-44" y="-24" width="82" height="20" fill="#c8392b" stroke="#2e2a26" stroke-width="3"/>`;
            // the parts on the desk: the broom (lying), the knife, the roll of tape
            L.act.insertAdjacentHTML("beforeend", `<g id="cp-desk">
              <g id="cp-broom0" transform="translate(140,1480) rotate(-6)">${BROOM}</g>
              <g id="cp-knife0" transform="translate(700,1560) rotate(-62)">${KN("cp-knife0i").replace('opacity="0"', 'opacity="1"')}</g>
              <g id="cp-roll0" transform="translate(940,1620)">${ROLL("cp-roll0i").replace('opacity="0"', 'opacity="1"')}</g></g>
            <g id="cp-held">
              <g id="cp-spear" transform="translate(140,1480) rotate(-6)" opacity="0">
                <g id="cp-wood">${BROOM}</g>
                <g id="cp-pipe" transform="translate(1300,0)" opacity="0"><rect x="0" y="-21" width="864" height="42" rx="14" fill="url(#fCan)" stroke="#2e2a26" stroke-width="4"/><path d="M20,-6h800" stroke="#fff" stroke-width="3" opacity=".5"/><rect x="-44" y="-24" width="82" height="20" fill="#c8392b" stroke="#2e2a26" stroke-width="3"/></g>
                <g transform="translate(830,22) rotate(-90)">${KN("cp-kn")}</g>
                ${[770, 806, 842].map((x, k) => `<rect id="cp-band${k}" x="${x}" y="-22" width="26" height="44" rx="4" fill="#1f1d1a" stroke="#2e2a26" stroke-width="3" opacity="0"/>`).join("")}
                <path id="cp-glint" d="M300,-30L380,-30L340,30L260,30Z" fill="#fff" opacity="0"/>
              </g>
              <g id="cp-hl" transform="translate(-300,2300) rotate(90) scale(-0.62,0.62)">${Hand.grip({ skin: ko.skin, sleeve: ko.sleeve })}</g>
              <g id="cp-hr" transform="translate(1400,2300) rotate(-90) scale(0.62,0.62)">${Hand.grip({ skin: ko.skin, sleeve: ko.sleeve })}<g transform="translate(22,0)">${KN("cp-knh")}</g>${ROLL("cp-rollh")}</g>
            </g>
            <g id="cp-hm" transform="translate(1700,1500) rotate(-90) scale(0.6,0.6)">${Hand.grip({ skin: ma.skin, sleeve: ma.sleeve })}</g>`);
          },
          fx(tl, id, t0) {
            const A = (sel, from, to, t, d, ease = "power2.inOut") => tl.fromTo(sel, { attr: { transform: from } }, { attr: { transform: to }, duration: d, ease, immediateRender: false }, t0 + t);
            const show = (sel, t, on = 1) => tl.set(sel, { opacity: on }, t0 + t);
            // 1.2 the left hand comes in from below, closes on the broom handle and lifts it across the frame
            A("#cp-hl", "translate(-300,2300) rotate(90) scale(-0.62,0.62)", "translate(342,1500) rotate(90) scale(-0.62,0.62)", 0.9, 0.45, "power2.out");
            show("#cp-broom0", 1.35, 0); show("#cp-spear", 1.35, 1);
            A("#cp-spear", "translate(140,1480) rotate(-6)", "translate(120,1250) rotate(-11.5)", 1.35, 0.55);
            A("#cp-hl", "translate(342,1500) rotate(90) scale(-0.62,0.62)", held.L, 1.35, 0.55);
            // 2.3 the right hand picks the knife and sets it on the end of the handle
            A("#cp-hr", "translate(1400,2300) rotate(-90) scale(0.62,0.62)", "translate(702,1578) rotate(-62) scale(0.62,0.62)", 2.0, 0.4, "power2.out");
            show("#cp-knife0", 2.42, 0); show("#cp-knh", 2.42, 1);
            A("#cp-hr", "translate(702,1578) rotate(-62) scale(0.62,0.62)", "translate(992,1098) rotate(-101) scale(0.62,0.62)", 2.45, 0.5);
            show("#cp-knh", 2.98, 0); show("#cp-kn", 2.98, 1);
            tl.fromTo("#cp-spear", { y: 0 }, { y: 10, duration: 0.08, yoyo: true, repeat: 1, immediateRender: false }, t0 + 2.98);   // the handle dips as the knife lands
            // 3.4 the tape: the hand grabs the roll and winds it round the joint three times; the bands appear
            A("#cp-hr", "translate(992,1098) rotate(-101) scale(0.62,0.62)", "translate(942,1640) rotate(-90) scale(0.62,0.62)", 3.1, 0.3);
            show("#cp-roll0", 3.42, 0); show("#cp-rollh", 3.42, 1);
            const c = { k: 0 }, J = [963, 1079];
            tl.to(c, { k: 1, duration: 1.0, ease: "none", immediateRender: false, onUpdate: () => { const a = c.k * Math.PI * 6, g = document.getElementById("cp-hr"); if (g) g.setAttribute("transform", `translate(${(J[0] + Math.cos(a) * 95).toFixed(1)},${(J[1] + 50 + Math.sin(a) * 60).toFixed(1)}) rotate(${(-90 + Math.sin(a) * 25).toFixed(1)}) scale(0.62,0.62)`); } }, t0 + 3.45);
            [3.65, 3.95, 4.25].forEach((t, k) => tl.fromTo(`#cp-band${k}`, { opacity: 0, scaleY: 0.3 }, { opacity: 1, scaleY: 1, duration: 0.15, transformOrigin: "50% 50%", immediateRender: false }, t0 + t));
            show("#cp-rollh", 4.45, 0);
            A("#cp-hr", `translate(${J[0] + 95},${J[1] + 60}) rotate(-90) scale(0.62,0.62)`, held.R, 4.45, 0.3);
            // 4.6 → 5.15 both hands raise the spear and thrust it at the lens on the hit, then settle
            tl.fromTo("#cp-held", { scale: 1, y: 0 }, { scale: 1.14, y: -120, duration: 0.45, ease: "power2.in", transformOrigin: "50% 100%", immediateRender: false }, t0 + 4.7);
            tl.to("#cp-held", { scale: 1.3, y: -260, duration: 0.12, ease: "power3.out" }, t0 + 5.15); tl.to("#cp-held", { scale: 1.08, y: -80, duration: 0.6, ease: "elastic.out(1,.45)" }, t0 + 5.3);
            tl.fromTo("#cp-glint", { opacity: 0, x: -300 }, { opacity: 0.9, x: 500, duration: 0.35, ease: "power1.inOut", immediateRender: false }, t0 + 5.3); tl.to("#cp-glint", { opacity: 0, duration: 0.1 }, t0 + 5.65);
            // 8.0 ลุงหมาน's hand pushes the steel pipe onto the handle from the right; the wood is gone at 8.85
            A("#cp-hm", "translate(1700,1500) rotate(-90) scale(0.6,0.6)", "translate(1180,1080) rotate(-96) scale(0.6,0.6)", 7.9, 0.5, "power2.out");
            show("#cp-pipe", 8.3, 1);
            A("#cp-pipe", "translate(1300,0)", "translate(0,0)", 8.35, 0.5, "power3.in");
            A("#cp-hm", "translate(1180,1080) rotate(-96) scale(0.6,0.6)", "translate(560,1200) rotate(-96) scale(0.6,0.6)", 8.35, 0.5, "power3.in");
            tl.set("#cp-wood", { opacity: 0 }, t0 + 8.85);
            tl.fromTo("#cp-held", { x: 0 }, { x: -14, duration: 0.05, repeat: 5, yoyo: true, immediateRender: false }, t0 + 8.85);
            tl.fromTo("#cp-glint", { opacity: 0, x: -300 }, { opacity: 1, x: 560, duration: 0.3, ease: "power1.inOut", immediateRender: false }, t0 + 8.9); tl.to("#cp-glint", { opacity: 0, duration: 0.1 }, t0 + 9.2);
            A("#cp-hm", "translate(560,1200) rotate(-96) scale(0.6,0.6)", "translate(1700,1700) rotate(-90) scale(0.6,0.6)", 9.3, 0.6, "power2.in");
            Fx.punch(tl, `#${id} .stage`, t0 + 5.15, 1.06, 0.3); Fx.punch(tl, `#${id} .stage`, t0 + 8.85, 1.04, 0.3);
          },
        });
      }

      // ---------- 3. the countdown: the horde at the fence, the generator in the yard, ลุงหมาน runs out to kill it (20 → 8) ----------
      add("count", {
        set: "schoolYard", setOpts: { id: "cd", time: "night", lampX: -300 }, dark: 0.55, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(760, 1150, 0.8, 540, 1000), drift: { s: 0.02 } }, { t: 4.3, ...fr(800, 1280, 1.25, 540, 1100), drift: { s: 0.03 } }, { t: 6.4, glide: 6.4, ...fr(260, 1200, 0.9, 540, 1050) }] },
        shake: (t) => (t > 6.4 ? 5 * Math.sin(t * 19) : 2 * Math.sin(t * 11)),
        actors: [MA(1250, 1500, 0.9, [{ t: 0, mode: "run", eyes: "wide", mouth: "frown" }, { t: 2.6, mode: "crouch", eyes: "normal", mouth: "frown" }, { t: 3.2, mode: "grabArm", eyes: "normal", mouth: "frown" }, { t: 5.6, mode: "run", eyes: "wide", mouth: "frown" }], { flip: true })],
        captions: [CAP("“ยี่สิบวิ ลุง! {แล้วประตูปิด}”", 0.2, 2.9), CAP("ช่าง… [ดับเครื่องได้ใน 3 วิ]", 3.3, 6.1), CAP("มันเดินตามเสียง… {มาแล้ว}", 7.6, 10.6)],
        ui: [{ type: "countdown", t: 0.2, from: 20, to: 8, label: "ประตูปิดใน", warn: 5, end: 12.9, top: 150 },
          { type: "skill", t: 3.0, end: 6.2, x: 80, y: 840, name: "ลุงหมาน", skill: "ช่าง", desc: "รู้ว่าสวิตช์อยู่ไหนโดยไม่ต้องมอง", icon: "wrench" }],
        extra(L) { L.set.insertAdjacentHTML("beforeend", Sets.props.generator("cd-gen", 760, 1500, 0.75, true)); glow(L, `<circle id="cd-glow" cx="760" cy="1380" r="460" fill="url(#fLamp)" opacity=".85"/>`); },
        fx(tl, id, t0, L) {
          ZF(L, tl, "cd", t0, D("count"), [["ha1", 760, 0.8, 0], ["ha2", 900, 0.76, 0.4], ["ha3", 1060, 0.78, 0.2], ["ha1", 1240, 0.74, 0.7], ["ha2", 1400, 0.7, 0.9], ["ha3", 600, 0.72, 0.5]]);
          route(tl, `${id}-a0`, t0, [{ t: 0, x: 1250, y: 1500 }, { t: 2.6, x: 880, y: 1500 }, { t: 5.6, x: 880, y: 1500 }, { t: 12.9, x: -260, y: 1430 }], 0.9, true);
          tl.fromTo("#cd-glow", { opacity: 0.85 }, { opacity: 0.55, duration: 0.09, repeat: 47, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0);   // the generator's bulb hums
          tl.to("#cd-glow", { opacity: 0, duration: 0.25 }, t0 + 4.4); tl.to("#cd-gen-shim", { opacity: 0, duration: 0.3 }, t0 + 4.4);   // killed at 4.4
          Fx.heart(tl, t0 + 0.2, D("count") - 0.2, 0.6, 0.5);
        },
      });

      // ---------- 4. the last five seconds: ครูพิม holding the door, ลุงหมาน running in, 0 = slam to black ----------
      add("count2", {
        set: "schoolYard", setOpts: { id: "ce", time: "night", lampX: 140 }, dark: 0.6, blur: { far: 4 },
        cam: { keys: [{ t: 0, ...fr(300, 1260, 1.2, 540, 1150), drift: { s: 0.04, x: -8 } }] },
        shake: (t) => (t < 5.0 ? 7 * Math.sin(t * 21) : 0),
        actors: [PI(90, 1440, 0.82, [{ t: 0, mode: "guard", eyes: "wide", mouth: "frown" }, { t: 4.9, mode: "push", eyes: "wide", mouth: "frown" }]),
          MA(1400, 1500, 0.9, [{ t: 0, mode: "run", eyes: "wide", mouth: "frown" }, { t: 4.75, mode: "fall", eyes: "closed", mouth: "frown" }], { flip: true })],
        captions: [CAP("ห้า… สี่… สาม…", 0.3, 3.0), CAP("{ทัน}… หรือไม่ทัน", 3.2, 4.95)],
        ui: [{ type: "countdown", t: 0.0, from: 5, to: 0, label: "ประตูปิดใน", warn: 5, end: 5.6, top: 150 }],
        fx(tl, id, t0, L) {
          ZF(L, tl, "ce", t0, D("count2"), [["ha1", 1500, 0.8, 0], ["ha2", 1650, 0.76, 0.4], ["ha3", 1350, 0.78, 0.2], ["ha1", 1800, 0.74, 0.6]]);
          route(tl, `${id}-a1`, t0, [{ t: 0, x: 1400, y: 1500 }, { t: 4.75, x: 300, y: 1450 }], 0.9, true);
          Fx.heart(tl, t0, 5.0, 0.36, 0.8);
          tl.fromTo("#flashw", { opacity: 0.9 }, { opacity: 0, duration: 0.2, immediateRender: false }, t0 + 5.0);
          tl.set("#black", { opacity: 1 }, t0 + 5.05);
        },
      });
