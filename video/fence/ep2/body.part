      // ---------- รั้วสุดท้าย EP.2 น้ำมันในปอด ----------
      // the planted mistake: at ~0:04 ลุงหมาน swallows a mouthful ("อึก"), wipes his mouth and says nothing; revealed at the end
      const PK = 760;                                   // the pickup in front of the school (fenceOut), its fuel flap at about PK − 255
      const OUTN = (id, o = {}) => ({ set: "fenceOut", setOpts: { id, time: "noon", pickup: PK, ...o }, dark: 0, light: NOONL, grade: GNOON });
      const MANP = [400, 1460, 0.95];                   // ลุงหมาน crouched at the filler
      // the hose from the fuel filler to his mouth; #id-fuel is the amber column that climbs it
      const hoseTo = (L, tl, id, t0, rise) => {
        const F0 = [PK - 255, 1275], M = [MANP[0] + 16, MANP[1] - 492 * MANP[2]], d = `M${F0[0]},${F0[1]}C${F0[0] - 40},${F0[1] + 160} ${M[0] + 60},${M[1] + 260} ${M[0]},${M[1]}`;
        put(L.act, `<g id="${id}"><path d="${d}" stroke="#2a5a3a" stroke-width="20" fill="none" stroke-linecap="round"/><path d="${d}" stroke="#3aa86a" stroke-width="14" fill="none" stroke-linecap="round"/>
          <path id="${id}-fuel" d="${d}" stroke="#e8b42a" stroke-width="8" fill="none" stroke-linecap="round" pathLength="1" stroke-dasharray="1 1" stroke-dashoffset="1"/></g>`);
        if (rise) tl.to(`#${id}-fuel`, { attr: { "stroke-dashoffset": 0 }, duration: rise[1], ease: "power2.in", immediateRender: false }, t0 + rise[0]);
      };
      const gulpFx = (L, tl, t, x = 600, y = 560) => {
        const id = `gp${Math.round(t * 100)}`;
        put(L.light, `<g id="${id}"><text x="${x}" y="${y}" font-family="Sriracha" font-size="70" fill="#fff" stroke="#26201c" stroke-width="8" paint-order="stroke" transform="rotate(-8 ${x} ${y})">อึก</text></g>`);
        tl.set(`#${id}`, { opacity: 0 }, 0);
        tl.fromTo(`#${id}`, { opacity: 0, scale: 0.4, svgOrigin: `${x} ${y}` }, { opacity: 1, scale: 1, svgOrigin: `${x} ${y}`, duration: 0.25, ease: "back.out(3)", immediateRender: false }, t);
        tl.to(`#${id}`, { opacity: 0, duration: 0.2, immediateRender: false }, t + 0.7);
      };
      const MANCU = (mode, mouth, extra = {}) => A("man", MANP[0], MANP[1], MANP[2], [T(mode === "siphon" ? "whistle" : mode, "normal", mouth)], extra);
      const genIn = (L, tl, id, x, y, s, t0, dx = 0, dur = 0) => {
        put(L.act, `<g id="${id}">${Fence.gen(x, y, s, id, false)}</g>`);
        if (dur) tl.fromTo(`#${id}`, { x: -dx }, { x: 0, duration: dur, ease: "power1.out", immediateRender: false }, t0);
      };
      const rings = (L, tl, id, x, y, t0, dur) => {
        put(L.glow, `<g id="${id}">${[0, 1, 2, 3].map((k) => `<circle id="${id}-${k}" cx="${x}" cy="${y}" r="120" fill="none" stroke="#ffe0a0" stroke-width="10" opacity="0"/>`).join("")}</g>`);
        [0, 1, 2, 3].forEach((k) => tl.fromTo(`#${id}-${k}`, { scale: 0.3, opacity: 0.8, svgOrigin: `${x} ${y}` }, { scale: 6, opacity: 0, svgOrigin: `${x} ${y}`, duration: 1.6, repeat: Math.ceil(dur / 1.6), ease: "power1.out", immediateRender: false }, t0 + k * 0.4));
      };

      // ---------- 1. hook: noon, ลุงหมาน crouched at the abandoned pickup, the hose at his lips ----------
      add("hook", {
        ...OUTN("o1"),
        cam: { keys: [{ t: 0, ...fr(560, 1250, 1.05, 540, 1060) }, { t: D("hook"), glide: D("hook"), ...fr(540, 1200, 1.25, 540, 1060) }] },
        actors: [MANCU("siphon", "o", { flip: false })],
        captions: caps("hook"),
        fx(tl, id, t0, L) { Fence.life(tl, "o1", t0, D("hook")); hoseTo(L, tl, "h1", t0, null); },
      });
      // ---------- 2. the command: the fuel climbs the hose — and he swallows (planted at ~0:04) ----------
      add("dont", {
        ...OUTN("o2"),
        cam: { keys: [{ t: 0, ...fr(520, 1120, 1.5, 540, 1000) }, { t: D("dont"), glide: D("dont"), ...fr(520, 1110, 1.6, 540, 1000) }] },
        actors: [MANCU("siphon", "o")],
        captions: caps("dont"),
        fx(tl, id, t0, L) { hoseTo(L, tl, "h2", t0, [0.0, 0.7]); gulpFx(L, tl, t0 + 0.9, 640, 560); },
      });
      // ---------- 3. card: a little fuel into the lung → the lung inflames ----------
      add("lung", {
        ...OUTN("o3"), blur: BLUR,
        cam: { keys: [{ t: 0, ...still(fr(560, 1200, 0.9, 540, 1000)) }] },
        captions: caps("lung"),
        fx(tl, id, t0, L) {
          put(L.light, `<rect width="1080" height="1920" fill="#14100c" opacity=".45"/>`);
          FenceUI.card(tl, L.light, t0, D("lung"), { title: "น้ำมันหลุดเข้าปอด", color: "#e2382e", y: 300,
            rows: [{ icon: "hose", text: "แค่นิดเดียว", sub: "สำลักตอนดูด", at: F("lung", 0, 0) }, { icon: "lung", text: "ปอดอักเสบ", sub: "บวม เลือดออก", at: F("lung", 0, 2), mark: "x" }] });
        },
      });
      // ---------- 4. "but our fathers did it all their lives": ลุงหมาน wipes his mouth and grins ----------
      add("dad", {
        ...OUTN("o4"),
        cam: { keys: [{ t: 0, ...fr(520, 1300, 1.0, 540, 1100) }, { t: D("dad"), glide: D("dad"), ...fr(520, 1260, 1.08, 540, 1100) }] },
        actors: [A("man", 520, 1640, 0.98, [T("whistle", "normal", "laugh")]), A("kong", 860, 1660, 0.92, [T("idle", "worry", "frown")], { flip: true })],
        captions: caps("dad"),
        fx(tl, id, t0, L) { Fence.life(tl, "o4", t0, D("dad")); trio(tl, L.light, t0, D("dad"), [["hose", "", 0.2], ["people", "", 0.5]], 330, 0.9); },
      });
      // ---------- 5. day 101: ลุงหมาน drags the generator in through the gate ----------
      add("gen", {
        set: "fenceGate", setOpts: { id: "g5", time: "day", lock: "locked", open: 0.5 }, dark: 0, light: DAYL, grade: GD,
        cam: { keys: [{ t: 0, ...fr(540, 1300, 0.8, 540, 1100) }, { t: D("gen"), glide: D("gen"), ...fr(540, 1330, 0.86, 540, 1100) }] },
        actors: [A("man", 520, 1600, 0.9, [T("walk", "normal", "smile")], { moveTo: { x: 330, y: 1700, s: 1.0, dur: D("gen") } })],
        captions: caps("gen"),
        fx(tl, id, t0, L) { Fence.life(tl, "g5", t0, D("gen")); genIn(L, tl, "g5g", 640, 1720, 1.0, t0, -200, D("gen")); chalkWord(tl, L.light, t0 + 0.1, D("gen"), "วันที่ 101", 330, 120); },
      });
      // ---------- 6. "tonight we get the fan!" ----------
      add("fan", {
        set: "fenceYard", setOpts: { id: "y6", time: "day", gen: 620 }, dark: 0, light: DAYL, grade: GD,
        cam: { keys: [{ t: 0, ...fr(560, 1380, 1.0, 540, 1150) }, { t: D("fan"), glide: D("fan"), ...fr(560, 1360, 1.06, 540, 1150) }] },
        actors: [A("man", 380, 1600, 0.95, [T("raise", "normal", "laugh")], { talk: [TALK("fan", 0, "laugh")] }), A("pan", 860, 1620, 0.6, [T("idle", "wide", "smile")], { flip: true })],
        captions: caps("fan", undefined, QUO),
        fx(tl, id, t0) { Fence.life(tl, "y6", t0, D("fan")); },
      });
      // ---------- 7. the tank is dry → the fuel is in the pickup outside the fence ----------
      split("tank", 1.4, {
        set: "fenceYard", setOpts: { id: "y7", time: "day", gen: 540 }, dark: 0, light: DAYL, grade: GD,
        cam: { keys: [{ t: 0, ...still(fr(540, 1480, 2.0, 540, 1000)) }] },
        captions: caps("tank"),
        fx(tl, id, t0, L) { tl.fromTo("#y7-gen", { x: -3 }, { x: 3, duration: 0.06, yoyo: true, repeat: 8, immediateRender: false }, t0 + 0.2); trio(tl, L.light, t0, 1.4, [["trash", "x", 0.3]], 360, 0.9); },
      }, {
        ...OUTN("o7"),
        cam: { keys: [{ t: 0, ...fr(560, 1260, 0.7, 540, 1060) }, { t: D("tank") - 1.4, glide: D("tank") - 1.4, ...fr(520, 1260, 0.95, 540, 1060) }] },
        captions: capsFrom("tank", 1.4),
        fx(tl, id, t0) { Fence.life(tl, "o7", t0, D("tank") - 1.4); },
      });
      // ---------- 8. noon: the heat haze, ผีห่า dragging slow + rule 1 ----------
      add("noon", {
        set: "fenceRoad", setOpts: { id: "r8", time: "noon", horde: 10 }, dark: 0, light: NOONL, grade: GNOON,
        cam: { keys: [{ t: 0, ...fr(540, 1250, 0.8, 540, 1100) }, { t: D("noon"), glide: D("noon"), ...fr(540, 1260, 0.84, 540, 1100) }] },
        actors: [A("hz1", 380, 1650, 0.9, [T("shamble", "glow", "flat")], { moveTo: { x: 450, y: 1650, dur: D("noon") } }), A("hz3", 760, 1700, 0.95, [T("shamble", "glow", "flat")], { flip: true, moveTo: { x: 700, y: 1700, dur: D("noon") } })],
        captions: caps("noon"),
        fx(tl, id, t0, L) { Fence.life(tl, "r8", t0, D("noon")); FenceUI.rules(tl, L.light, t0 + F("noon", 0, 1), D("noon") - F("noon", 0, 1), { active: 0, y: 330 }); },
      });
      // ---------- 9. ก้อง: "with your mouth?!" ----------
      add("why", {
        ...OUTN("o9"),
        cam: { keys: [{ t: 0, ...still(fr(820, 1220, 1.2, 540, 1150)) }] },
        actors: [MANCU("siphon", "flat"), A("kongBat", 860, 1680, 1.0, [T("point", "wide", "o")], { flip: true, talk: [TALK("why", 0)] })],
        captions: caps("why", undefined, QUO),
        fx(tl, id, t0, L) { hoseTo(L, tl, "h9", t0, null); },
      });
      // ---------- 10. ลุงหมาน: "forty years, never a problem" ----------
      add("forty", {
        ...OUTN("o10"),
        cam: { keys: [{ t: 0, ...fr(500, 1150, 1.4, 540, 1050) }, { t: D("forty"), glide: D("forty"), ...fr(500, 1140, 1.5, 540, 1050) }] },
        actors: [A("man", 400, 1460, 0.95, [T("idle", "normal", "smile")], { talk: [TALK("forty", 0, "smile")] })],
        captions: caps("forty", undefined, QUO),
        fx(tl, id, t0, L) { Fence.life(tl, "o10", t0, D("forty")); },
      });
      // ---------- 11. the fuel comes (no voice): he chokes, coughs, spits ----------
      add("gulp", {
        ...OUTN("o11"),
        cam: { keys: [{ t: 0, ...still(fr(520, 1150, 1.45, 540, 1000)) }] },
        shake: (t) => (t > 0.5 && t < 1.6 ? { x: 6 * Math.sin(t * 50), y: 4 * Math.sin(t * 43), r: 0 } : 0),
        actors: [A("man", 400, 1460, 0.95, [T("whistle", "normal", "o"), T("cough", "closed", "scream", 0.55)])],
        fx(tl, id, t0, L) {
          hoseTo(L, tl, "h11", t0, [0, 0.45]); tl.to("#h11", { opacity: 0, duration: 0.1 }, t0 + 0.55);
          put(L.glow, `<g id="sp11">${[0, 1, 2, 3, 4].map((k) => `<circle cx="${560 + k * 18}" cy="${1060 + (k % 2) * 14}" r="${8 - k}" fill="#e8b42a"/>`).join("")}</g>`);
          tl.set("#sp11", { opacity: 0 }, 0); tl.fromTo("#sp11", { opacity: 1, x: 0, y: 0 }, { opacity: 0, x: 90, y: 60, duration: 0.5, immediateRender: false }, t0 + 0.55);
        },
      });
      // ---------- 12. a few coughs… gone: he waves it off; they carry the jerrycan in ----------
      add("fine", {
        set: "fenceGate", setOpts: { id: "g12", time: "day", lock: "locked", open: 0.5 }, dark: 0, light: DAYL, grade: GD,
        cam: { keys: [{ t: 0, ...fr(540, 1300, 0.85, 540, 1100) }, { t: D("fine"), glide: D("fine"), ...fr(540, 1320, 0.9, 540, 1100) }] },
        actors: [A("man", 470, 1560, 0.9, [T("wave", "normal", "smile")], { moveTo: { x: 380, y: 1680, s: 1.0, dur: D("fine") } }), A("kong", 640, 1540, 0.88, [T("carry", "worry", "flat")], { flip: true, moveTo: { x: 700, y: 1660, s: 0.98, dur: D("fine") } })],
        captions: caps("fine"),
        fx(tl, id, t0, L) { Fence.life(tl, "g12", t0, D("fine")); },
      });
      // ---------- 13. night: the generator running, the fan in the window; ลุงหมาน coughing, sweating ----------
      add("night", {
        set: "fenceYard", setOpts: { id: "y13", time: "night", gen: 620, genOn: true, lit: true }, dark: 0.04, light: NITE, grade: GN,
        cam: { keys: [{ t: 0, ...fr(480, 1350, 0.9, 540, 1100) }, { t: D("night"), glide: D("night"), ...fr(420, 1400, 1.15, 540, 1100) }] },
        actors: [A("man", 360, 1600, 0.95, [T("cough", "pain", "o")]), A("pim", 120, 1620, 0.9, [T("idle", "worry", "frown")])],
        captions: caps("night"),
        fx(tl, id, t0, L) {
          Fence.life(tl, "y13", t0, D("night"));
          tl.fromTo("#y13-gen", { x: -2 }, { x: 2, duration: 0.05, yoyo: true, repeat: Math.ceil(D("night") / 0.05), ease: "none", immediateRender: false }, t0);
          tl.set(`#${id}-a0-sweat`, { display: "inline" }, t0);
        },
      });
      // ---------- 14. เจ๊หงส์: "were you bitten?!" — ก้อง raises the bat ----------
      add("bit", {
        set: "fenceYard", setOpts: { id: "y14", time: "night", gen: 620, genOn: true, lit: true }, dark: 0.04, light: NITE, grade: GN,
        cam: { keys: [{ t: 0, ...still(fr(620, 1300, 1.1, 540, 1100)) }] },
        shake: (t) => (t < 0.3 ? { x: 8 * Math.sin(t * 60), y: 0, r: 0 } : 0),
        actors: [A("hong", 560, 1640, 0.95, [T("tremble", "wide", "scream")], { flip: true, talk: [TALK("bit", 0, "scream")] }), A("kongBat", 860, 1640, 0.98, [T("bat", "angry", "frown")], { flip: true })],
        captions: caps("bit", undefined, QUO),
      });
      // ---------- 15. the twist card: not ห่า — fuel in the lung ----------
      add("twist", {
        set: "fenceYard", setOpts: { id: "y15", time: "night", gen: 620, genOn: true, lit: true }, dark: 0.04, light: false, grade: GN, blur: BLUR,
        cam: { keys: [{ t: 0, ...still(fr(500, 1300, 0.9, 540, 1100)) }] },
        captions: caps("twist"),
        fx(tl, id, t0, L) {
          put(L.light, `<rect width="1080" height="1920" fill="#0a0c14" opacity=".45"/>`);
          FenceUI.versus(tl, L.light, t0, D("twist"), { title: "ไอ หอบ ตัวร้อน", a: { icon: "skull", text: "โดนห่ากัด", mark: "x" }, b: { icon: "lung", text: "น้ำมันลงปอด", mark: "ok" }, gap: 0.4, markAt: [0.6, F("twist", 0, 1) + 0.3], y: 720 });
        },
      });
      // ---------- 16. card: swallowed fuel → don't make yourself vomit, see a doctor now ----------
      add("vomit", {
        set: "fenceYard", setOpts: { id: "y16", time: "night", gen: 620, genOn: true, lit: true }, dark: 0.04, light: false, grade: GN, blur: BLUR,
        cam: { keys: [{ t: 0, ...still(fr(500, 1300, 0.9, 540, 1100)) }] },
        captions: caps("vomit"),
        fx(tl, id, t0, L) {
          put(L.light, `<rect width="1080" height="1920" fill="#0a0c14" opacity=".45"/>`);
          FenceUI.card(tl, L.light, t0, D("vomit"), { title: "ถ้ากลืนน้ำมันเข้าไป", color: "#2f6fd0", y: 300,
            rows: [{ icon: "nofinger", text: "อย่าล้วงคอ", sub: "อย่าทำให้อาเจียน", at: F("vomit", 0, 1), mark: "x" }, { icon: "doctor", text: "รีบไปหาหมอ", sub: "ทันที ไม่ต้องรออาการ", at: F("vomit", 0, 2), mark: "ok" }] });
        },
      });
      // ---------- 17. rewind to 0:04 ----------
      add("rw", {
        ...OUTN("o17"),
        cam: { keys: [{ t: 0, ...fr(520, 1120, 1.5, 540, 1000) }, { t: D("rw"), glide: D("rw") - 0.5, ...fr(500, 1080, 2.1, 540, 900) }] },
        actors: [MANCU("siphon", "o")],
        captions: caps("rw"),
        fx(tl, id, t0, L) { hoseTo(L, tl, "h17", t0, [0.2, 0.7]); FenceUI.rewind(tl, L.light, t0, D("rw"), "0:04"); gulpFx(L, tl, t0 + 1.2, 640, 520); },
      });
      // ---------- 18. slowed: he swallows, wipes his mouth, smiles, says nothing ----------
      add("swallow", {
        ...OUTN("o18"),
        cam: { keys: [{ t: 0, ...fr(500, 1100, 2.0, 540, 900) }, { t: D("swallow"), glide: D("swallow"), ...fr(500, 1100, 2.2, 540, 900) }] },
        actors: [A("man", 400, 1460, 0.95, [T("whistle", "closed", "flat"), T("idle", "normal", "smile", 1.4)])],
        captions: caps("swallow"),
        fx(tl, id, t0, L) { gulpFx(L, tl, t0 + 0.3, 640, 520); put(L.light, `<rect width="1080" height="1920" fill="#3a2a10" opacity=".18"/>`); },
      });
      // ---------- 19. the sound rolls out over the dark paddies ----------
      add("sound", {
        set: "fenceOut", setOpts: { id: "o19", time: "night", hill: true, blink: true, lit: true }, dark: 0.04, light: NITE, grade: GN,
        cam: { keys: [{ t: 0, ...fr(540, 1150, 0.7, 540, 1050) }, { t: D("sound"), glide: D("sound"), ...fr(100, 1100, 0.66, 540, 1050) }] },
        captions: caps("sound"),
        fx(tl, id, t0, L) { rings(L, tl, "rg19", 300, 1000, t0, D("sound")); },
      });
      // ---------- 20. a torch on the hill blinks back three times ----------
      add("blink", {
        set: "fenceOut", setOpts: { id: "o20", time: "night", hill: true, blink: true, lit: true }, dark: 0.04, light: NITE, grade: GN,
        cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }, { t: D("blink"), glide: D("blink"), ...fr(540, 960, 1.05, 540, 960) }] },
        captions: caps("blink"),
        fx(tl, id, t0, L) { [0, 1, 2].forEach((k) => tl.fromTo("#o20-blink", { opacity: 0 }, { opacity: 1, duration: 0.12, yoyo: true, repeat: 1, ease: "none", immediateRender: false }, t0 + F("blink", 0, 1) + k * 0.45)); },
      });
      // ---------- 21. next ----------
      add("next", {
        set: "fenceOut", setOpts: { id: "o21", time: "night", hill: true }, dark: 0.1, light: NITE, grade: GN, blur: BLUR,
        cam: { keys: [{ t: 0, ...still(fr(540, 1200, 0.8, 540, 1000)) }] },
        fx(tl, id, t0, L) { FenceUI.next(tl, L.light, t0, D("next"), { ep: 3, l1: "ถ้าโดนตะปูตำ แผลแค่รูเดียว…", l2: "อย่าคิดว่าไม่เป็นไร" }); },
      });
