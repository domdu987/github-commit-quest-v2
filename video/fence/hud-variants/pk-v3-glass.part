
      // ======================================================================================================
      // v3 look: cinematic glass + neon edge — smoked-glass plates with a light running round the rim,
      // clay icons with specular highlights, slot-rolling numbers, bokeh dust, dissolve-to-lines exits
      // ======================================================================================================
      window.GRADE = { filter: "saturate(.6) brightness(.84) contrast(1.1)", tint: "#8a9cb0", tintOp: 0.22 };
      const PK_INK = "#15171c", PK_RED = "#ff3b2f", PK_GOLD = "#f2b544", PK_TXT = "#f3efe6", PK_DIM = "rgba(243,239,230,.62)";
      const PK_GLASS = `background: linear-gradient(160deg, rgba(34,38,48,.72), rgba(8,10,14,.82)); backdrop-filter: blur(16px) saturate(1.3); -webkit-backdrop-filter: blur(16px) saturate(1.3); border: 1.5px solid rgba(255,255,255,.14); box-shadow: 0 24px 60px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.18);`;
      document.head.insertAdjacentHTML("beforeend", `<style>
        /* ---- the neon-glass plate layers (added by nxDress) ---- */
        .nx { isolation: isolate; --sw: 0deg; --a: 0deg; --tone: ${PK_GOLD}; }
        .nx > .nx-ring { position: absolute; inset: -3px; border-radius: inherit; padding: 3px; pointer-events: none; z-index: 2; opacity: 0;
          -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; }
        .nx > .nx-ring.draw { background: conic-gradient(from -90deg, #fff6e6 0deg, var(--tone) calc(var(--sw) * .55), var(--tone) var(--sw), transparent var(--sw)); }
        .nx > .nx-ring.drawb { inset: -8px; padding: 12px; filter: blur(5px); background: conic-gradient(from -90deg, var(--tone) 0deg, var(--tone) var(--sw), transparent var(--sw)); }
        .nx > .nx-ring.run { background: conic-gradient(from var(--a), transparent 0deg 200deg, var(--tone) 290deg, #fff8ea 318deg, var(--tone) 335deg, transparent 360deg); }
        .nx > .nx-fill { position: absolute; inset: 0; border-radius: inherit; z-index: -1; opacity: 0; ${PK_GLASS} }
        .nx > .nx-fill::after { content: ""; position: absolute; left: 8%; right: 8%; top: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,.6), transparent); }
        .nx > .nx-glow { position: absolute; inset: -1px; border-radius: inherit; z-index: -2; box-shadow: 0 0 44px var(--tone), 0 0 10px var(--tone); opacity: 0; pointer-events: none; }
        .nx > .nx-shw { position: absolute; inset: 0; border-radius: inherit; overflow: hidden; z-index: -1; pointer-events: none; }
        .nx > .nx-top { position: absolute; inset: 0; border-radius: inherit; overflow: hidden; z-index: 3; pointer-events: none; }
        .nx .nx-sweep { position: absolute; top: -30%; bottom: -30%; left: 0; width: 26%; transform: translateX(-250%) skewX(-18deg);
          background: linear-gradient(100deg, transparent, rgba(255,255,255,.1) 40%, rgba(255,255,255,.26) 50%, rgba(255,255,255,.1) 60%, transparent); }
        .nx .nx-bk { position: absolute; border-radius: 50%; opacity: 0; background: radial-gradient(circle, rgba(255,226,170,.95), rgba(255,226,170,0) 70%); }
        .nx > .nx-ln { position: absolute; left: 10%; right: 10%; height: 2px; border-radius: 1px; background: var(--tone); box-shadow: 0 0 10px var(--tone); opacity: 0; z-index: 4; pointer-events: none; }
        .nx-pt { position: absolute; left: 50%; top: 50%; width: 8px; height: 8px; margin: -4px; border-radius: 50%; background: #ffd9d2; box-shadow: 0 0 10px var(--tone); opacity: 0; pointer-events: none; z-index: 5; }
        .nx-orb { position: absolute; inset: -10px; opacity: 0; pointer-events: none; z-index: 5; }
        .nx-orb i { position: absolute; left: 50%; top: 50%; width: 7px; height: 7px; margin: -3.5px; border-radius: 50%; background: #ffd9d2; box-shadow: 0 0 8px var(--tone); }
        /* captions: white bold on smoked glass, a gold hairline under; [gold words], {red box words}; words bounce in one by one */
        .capwrap { top: 1470px; }
        .capbox { ${PK_GLASS} color: ${PK_TXT}; border-radius: 20px; font: 900 56px/1.2 Kanit; padding: 10px 32px 16px; letter-spacing: .5px; }
        .capbox::after { content: ""; position: absolute; left: 14%; right: 14%; bottom: -1px; height: 3px; border-radius: 2px; background: linear-gradient(90deg, transparent, ${PK_GOLD}, transparent); box-shadow: 0 0 12px rgba(242,181,68,.6); }
        .capbox .w { display: inline-block; }
        .capbox .k { background: none; color: ${PK_GOLD}; border: 0; padding: 0; transform: none; box-shadow: none; text-shadow: 0 0 18px rgba(242,181,68,.55); }
        .capbox .k.kr, .k.kr { background: linear-gradient(180deg, #ff6a5c, #c81e14); color: #fff; border-radius: 10px; padding: 0 .18em; box-shadow: 0 0 22px rgba(255,59,47,.55), inset 0 1px 0 rgba(255,255,255,.35); text-shadow: none; transform: none; }
        .capbox.q { border-color: rgba(242,181,68,.45); color: #fff3d6; }
        .capbox.radio { border-color: rgba(255,179,92,.6); color: #ffd27a; letter-spacing: 6px; text-shadow: 0 0 18px rgba(255,179,92,.7); }
        .capbox.radio::after { background: linear-gradient(90deg, transparent, #ffb35c, transparent); }
        .bubble { ${PK_GLASS} border-radius: 22px; color: ${PK_TXT}; font: 900 42px/1.2 Kanit; padding: 14px 26px 18px; }
        .bubble:after { border: 0; background: rgba(16,18,24,.92); bottom: -26px; }
        .badge { font: 700 24px/1 Kanit; opacity: .6; background: none; padding: 0; letter-spacing: 3px; }
        /* stat chip (top-left): clay icon in a dark well, small label, slot number, neon segments */
        .pks { position: absolute; left: 36px; top: 150px; z-index: 52; opacity: 0; display: flex; gap: 18px; align-items: center; padding: 14px 28px 14px 16px; border-radius: 24px; color: ${PK_TXT}; font-family: Kanit; }
        .pks.right { left: auto; right: 36px; }
        .pks .ic { position: relative; width: 106px; height: 106px; border-radius: 26px; flex: none; display: grid; place-items: center;
          background: radial-gradient(circle at 35% 25%, rgba(255,255,255,.2), rgba(255,255,255,.02) 60%), rgba(0,0,0,.4); box-shadow: inset 0 1px 0 rgba(255,255,255,.22), inset 0 -2px 6px rgba(0,0,0,.5), 0 8px 18px rgba(0,0,0,.45); }
        .pks .ic svg { width: 88px; height: 88px; overflow: visible; filter: drop-shadow(0 6px 8px rgba(0,0,0,.55)); }
        .pks .lbl { font: 700 26px/1 Kanit; color: ${PK_DIM}; letter-spacing: 2px; margin-bottom: 4px; }
        .pks .v { display: flex; align-items: baseline; gap: 8px; font: 900 66px/1 Kanit; color: ${PK_TXT}; text-shadow: 0 0 26px rgba(242,181,68,.3); }
        .pks .slot { display: inline-block; height: 66px; line-height: 66px; overflow: hidden; } .pks .num { display: inline-block; }
        .pks .v small { font: 700 26px/1 Kanit; color: ${PK_DIM}; }
        .pks .seg { display: flex; gap: 4px; margin-top: 9px; } .pks .seg i { width: 16px; height: 8px; border-radius: 2px; background: var(--tone); box-shadow: 0 0 8px var(--tone); } .pks .seg i.off { background: rgba(255,255,255,.12); box-shadow: none; }
        .pks[data-alarm="1"] .v { color: #ff7a6c; text-shadow: 0 0 26px rgba(255,59,47,.6); }
        .pks .sub { margin-top: 9px; display: inline-block; font: 700 22px/1 Kanit; color: ${PK_TXT}; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); padding: 5px 10px 6px; border-radius: 10px; }
        /* title card: a glass plate; red series pill, the big slot count, the radio chip, the episode line */
        .pkt { position: absolute; left: 0; right: 0; top: 150px; z-index: 52; text-align: center; font-family: Kanit; color: ${PK_TXT}; opacity: 0; }
        .pkt .plate { position: relative; display: inline-block; padding: 26px 56px 30px; border-radius: 32px; }
        .pkt .pill { display: inline-block; font: 700 28px/1 Kanit; letter-spacing: 3px; background: linear-gradient(180deg, #ff5a4a, #c81e14); color: #fff; padding: 9px 24px 11px; border-radius: 12px; box-shadow: 0 0 24px rgba(255,59,47,.5), inset 0 1px 0 rgba(255,255,255,.35); }
        .pkt .big { font: 900 136px/1.05 Kanit; margin-top: 12px; text-shadow: 0 6px 30px rgba(0,0,0,.6); letter-spacing: 1px; white-space: nowrap; }
        .pkt .big b { display: inline-block; color: ${PK_GOLD}; text-shadow: 0 0 34px rgba(242,181,68,.5); }
        .pkt .slot { display: inline-block; height: 1.05em; line-height: 1.05em; overflow: hidden; vertical-align: bottom; } .pkt .num { display: inline-block; }
        .pkt .chip { display: inline-flex; align-items: center; gap: 10px; margin-top: 10px; font: 700 26px/1 Kanit; color: ${PK_TXT}; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.16); padding: 8px 20px 9px 12px; border-radius: 30px; }
        .pkt .chip svg { width: 34px; height: 34px; overflow: visible; filter: drop-shadow(0 3px 4px rgba(0,0,0,.5)); }
        .pkt .ep { margin-top: 14px; font: 700 30px/1 Kanit; color: ${PK_DIM}; letter-spacing: 2px; }
        /* rule card: glass, red rim, "กฎข้อ N" chip, two-line title, neon rule, clay icon wells */
        .pkr { position: absolute; left: 50%; width: 780px; margin-left: -390px; top: 200px; z-index: 52; font-family: Kanit; }
        .pkr .card { position: absolute; left: 0; right: 0; top: 0; padding: 28px 32px 30px; border-radius: 26px; color: ${PK_TXT}; text-align: center; opacity: 0; }
        .pkr .n { display: inline-flex; align-items: center; gap: 8px; font: 700 26px/1 Kanit; letter-spacing: 2px; color: ${PK_GOLD}; background: rgba(242,181,68,.1); border: 1px solid rgba(242,181,68,.4); padding: 8px 18px 9px 14px; border-radius: 30px; }
        .pkr .n svg { width: 24px; height: 24px; }
        .pkr .t { font: 900 62px/1.15 Kanit; margin-top: 14px; } .pkr .t b, .pkr .t u { color: #ff7a6c; text-decoration: none; text-shadow: 0 0 22px rgba(255,59,47,.55); }
        .pkr .line { width: 240px; height: 4px; border-radius: 2px; background: linear-gradient(90deg, transparent, ${PK_RED}, transparent); box-shadow: 0 0 14px rgba(255,59,47,.6); margin: 16px auto 14px; }
        .pkr .ics { display: flex; justify-content: center; gap: 16px; }
        .pkr .ics span { width: 66px; height: 66px; border-radius: 50%; display: grid; place-items: center; background: radial-gradient(circle at 35% 28%, rgba(255,255,255,.2), rgba(255,255,255,.02) 65%), rgba(0,0,0,.4); border: 1px solid rgba(255,255,255,.14); box-shadow: inset 0 -2px 6px rgba(0,0,0,.5); }
        .pkr .ics svg { width: 40px; height: 40px; overflow: visible; filter: drop-shadow(0 3px 4px rgba(0,0,0,.5)); }
        /* end card: "ตอนต่อไป" pill + big "ตอนที่ 2" on a glass plate above the ledger page */
        .pkn { position: absolute; left: 0; right: 0; top: 150px; z-index: 52; text-align: center; font-family: Kanit; color: ${PK_TXT}; opacity: 0; }
        .pkn .plate { position: relative; display: inline-block; padding: 22px 60px 26px; border-radius: 32px; }
        .pkn .pill { display: inline-flex; align-items: center; gap: 10px; font: 700 26px/1 Kanit; letter-spacing: 2px; color: ${PK_TXT}; background: rgba(255,255,255,.08); padding: 9px 20px 10px; border-radius: 30px; border: 1px solid rgba(255,255,255,.18); }
        .pkn .pill i { width: 14px; height: 14px; border-radius: 50%; background: ${PK_RED}; box-shadow: 0 0 14px ${PK_RED}; }
        .pkn .big { display: inline-block; font: 900 116px/1.05 Kanit; margin-top: 8px; color: ${PK_GOLD}; text-shadow: 0 0 36px rgba(242,181,68,.5), 0 6px 30px rgba(0,0,0,.6); white-space: nowrap; }
        .pkn .tag { font: 900 38px/1.2 Kanit; color: #ff8a7a; margin-top: 4px; text-shadow: 0 0 18px rgba(255,59,47,.4); }
        /* the rest of the HUD on glass */
        .zsrc span { position: relative; background: none; border: 0; color: ${PK_TXT}; font: 700 25px/1.25 Kanit; box-shadow: none; backdrop-filter: none; border-radius: 16px; padding: 10px 22px 12px 14px; }
        .zsrc b { background: linear-gradient(180deg, #ffd27a, #d99a2a); color: #2a1c06; box-shadow: 0 0 14px rgba(242,181,68,.6); transform-origin: 50% 50%; } .zsrc em { color: ${PK_GOLD}; }
        .zcall span { position: relative; background: none; border: 0; color: ${PK_TXT}; font: 900 48px/1 Kanit; box-shadow: none; backdrop-filter: none; padding: 14px 30px 18px; border-radius: 18px; } .zcall small { color: #ff8a7a; }
        .fsun { background: none; border: 0; box-shadow: none; backdrop-filter: none; border-radius: 24px; width: 410px; padding: 12px 14px 12px; }
        .fsun .win { border-radius: 16px; overflow: hidden; box-shadow: inset 0 0 0 1px rgba(255,255,255,.12), 0 6px 16px rgba(0,0,0,.4); } .fsun svg { display: block; height: 150px; }
        .fsun .tm, .fsun .lf { margin-top: 8px; } .fsun .tm { color: ${PK_TXT}; text-shadow: 0 0 20px rgba(242,181,68,.3); } .fsun .lf { color: ${PK_DIM}; } .fsun .lf b { color: ${PK_GOLD}; }
        .fsun.late { --tone: ${PK_RED} !important; } .fsun.late .lf b { color: #ff7a6c; text-shadow: 0 0 18px rgba(255,59,47,.5); }
        .fsigns .row { background: none; border: 0; box-shadow: none; backdrop-filter: none; border-radius: 24px; padding: 14px 26px; position: relative; }
        .fsigns .ic { width: 120px; height: 120px; border-radius: 30px; display: grid; place-items: center; background: radial-gradient(circle at 35% 25%, rgba(255,255,255,.2), rgba(255,255,255,.02) 60%), rgba(0,0,0,.4); box-shadow: inset 0 1px 0 rgba(255,255,255,.22), inset 0 -2px 6px rgba(0,0,0,.5); }
        .fsigns .ic svg { width: 104px; height: 104px; overflow: visible; filter: drop-shadow(0 6px 8px rgba(0,0,0,.55)); }
        .fsigns .tx { color: ${PK_TXT}; font-size: 48px; } .fsigns .tx em { color: #ff7a6c; text-shadow: 0 0 20px rgba(255,59,47,.5); } .fsigns .bad { color: #ff5a4a; text-shadow: 0 0 20px rgba(255,59,47,.8); }
        .gui.tip { background: linear-gradient(160deg, rgba(34,38,48,.72), rgba(8,10,14,.82)); backdrop-filter: blur(16px) saturate(1.3); border: 1.5px solid rgba(255,255,255,.14); color: ${PK_TXT}; border-radius: 28px; }
        .gui.tip.danger { --tone: ${PK_RED} !important; box-shadow: 0 0 44px rgba(255,59,47,calc(var(--glow) * .9)), 0 24px 60px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.18); }
        .gui.tip.rule { --tone: ${PK_GOLD} !important; box-shadow: 0 0 44px rgba(242,181,68,calc(var(--glow) * .9)), 0 24px 60px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.18); }
        .gui.tip .txt { color: ${PK_TXT}; } .gui.tip .chip { color: #1a1206; } .gui.tip.danger .chip { background: linear-gradient(180deg, #ff6a5c, #d8302a); color: #fff; } .gui.tip.rule .chip { background: linear-gradient(180deg, #ffd27a, #d99a2a); }
        .gui.tip .med { background: radial-gradient(circle at 38% 30%, #3a3f4a, #121520 72%); border: 1.5px solid rgba(255,255,255,.16); box-shadow: inset 0 2px 8px rgba(255,255,255,.08), inset 0 -4px 10px rgba(0,0,0,.6), 0 10px 24px rgba(0,0,0,.5); }
        .gui.tip .med svg { overflow: visible; filter: drop-shadow(0 6px 8px rgba(0,0,0,.6)); }
        .gui .k { background: linear-gradient(180deg, #ff6a5c, #c81e14); color: #fff; transform: none; border-radius: 8px; box-shadow: 0 0 18px rgba(255,59,47,.5); }
        .gui.tip .fx-ring { inset: -3px; padding: 3px; background: conic-gradient(from var(--a), transparent 0deg 200deg, var(--tone) 290deg, #fff8ea 318deg, var(--tone) 335deg, transparent 360deg); }
        .gui .chip { font-size: 26px; } .gui .bar { background: rgba(255,255,255,.1); } .gui .bar i { background: var(--tone); box-shadow: 0 0 10px var(--tone); }
        .choice .q, .choice .opt { ${PK_GLASS} color: ${PK_TXT}; } .choice .key { background: rgba(255,255,255,.12); color: ${PK_TXT}; box-shadow: none; border: 1px solid rgba(255,255,255,.2); }
        .choice .who { color: #ff8a7a; } .choice .who2 { color: ${PK_GOLD}; }
        .fledger .page { box-shadow: 0 30px 60px rgba(0,0,0,.7), 0 0 70px rgba(242,181,68,.14); }
      </style>`);

      // ---------- deterministic helpers ----------
      const PK_LCG = (seed) => { let s = (seed * 2654435761) >>> 0; return () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296); };
      let NXN = 0;
      // dress a plate: rim rings (draw / blurred draw / running light), the glass fill, bokeh dust, a sweep layer, breakup lines
      function nxDress(el, tone, seed) {
        if (el.classList.contains("nx")) return el;
        el.classList.add("nx"); el.style.setProperty("--tone", tone);
        const r = PK_LCG(seed ?? ++NXN);
        const bk = Array.from({ length: 7 }, () => { const s = 5 + Math.round(r() * 12); return `<i class="nx-bk" style="left:${(4 + r() * 92).toFixed(1)}%;top:${(6 + r() * 88).toFixed(1)}%;width:${s}px;height:${s}px"></i>`; }).join("");
        const ln = Array.from({ length: 4 }, (_, i) => `<i class="nx-ln" style="top:${18 + i * 22}%"></i>`).join("");
        el.insertAdjacentHTML("afterbegin", `<i class="nx-glow"></i><i class="nx-fill"></i><i class="nx-shw">${bk}</i><i class="nx-ring drawb"></i><i class="nx-ring draw"></i><i class="nx-ring run"></i><i class="nx-top"><i class="nx-sweep"></i></i>${ln}`);
        return el;
      }
      const nxKids = (el) => [...el.children].filter((c) => !/(^|\s)nx-/.test(c.getAttribute("class") || ""));
      // entrance in three beats: the rim light draws round, the glass fills from a hairline (with a sweep), the content rises in
      function nxIn(tl, el, t0, o = {}) {
        const id = `#${el.id}`, kids = nxKids(el);
        tl.set(el, { opacity: 1 }, t0);
        if (o.dx || o.dy) tl.fromTo(el, { x: o.dx || 0, y: o.dy || 0 }, { x: 0, y: 0, duration: 0.55, ease: "power3.out", immediateRender: false }, t0);
        tl.set(`${id} > .nx-ring.draw, ${id} > .nx-ring.drawb`, { opacity: 1 }, t0);
        tl.fromTo(el, { "--sw": "0deg" }, { "--sw": "360deg", duration: 0.4, ease: "power2.inOut", immediateRender: false }, t0);
        tl.to(`${id} > .nx-ring.draw, ${id} > .nx-ring.drawb`, { opacity: 0, duration: 0.3 }, t0 + 0.5);
        tl.fromTo(`${id} > .nx-ring.run`, { opacity: 0 }, { opacity: 1, duration: 0.3, immediateRender: false }, t0 + 0.5);
        tl.fromTo(`${id} > .nx-fill`, { scaleY: 0.03, opacity: 0 }, { scaleY: 1, opacity: 1, duration: 0.34, ease: "power3.out", immediateRender: false }, t0 + 0.14);
        tl.fromTo(`${id} > .nx-glow`, { opacity: 1 }, { opacity: 0.3, duration: 0.6, ease: "power2.out", immediateRender: false }, t0 + 0.14);
        tl.fromTo(`${id} .nx-sweep`, { xPercent: -250 }, { xPercent: 560, duration: 0.6, ease: "power2.inOut", immediateRender: false }, t0 + 0.3);
        kids.forEach((k, i) => tl.fromTo(k, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.3, ease: "power2.out", immediateRender: false }, t0 + 0.3 + i * 0.06));
      }
      // exit: content drops out, the rim light un-draws, the glass collapses to a hairline and breaks into flying lines
      function nxOut(tl, el, t1) {
        const id = `#${el.id}`, kids = nxKids(el);
        tl.to(kids, { opacity: 0, y: -8, duration: 0.14, ease: "power2.in" }, t1);
        tl.to(`${id} > .nx-ring.run`, { opacity: 0, duration: 0.1 }, t1);
        tl.set(`${id} > .nx-ring.draw, ${id} > .nx-ring.drawb`, { opacity: 1 }, t1 + 0.04);
        tl.fromTo(el, { "--sw": "360deg" }, { "--sw": "0deg", duration: 0.3, ease: "power2.in", immediateRender: false }, t1 + 0.04);
        tl.to(`${id} > .nx-fill`, { scaleY: 0.03, duration: 0.24, ease: "power3.in" }, t1 + 0.08);
        tl.to(`${id} > .nx-fill`, { opacity: 0, scaleX: 1.15, duration: 0.12 }, t1 + 0.3);
        tl.to(`${id} > .nx-glow`, { opacity: 0, duration: 0.2 }, t1 + 0.2);
        el.querySelectorAll(":scope > .nx-ln").forEach((ln, i) => tl.fromTo(ln, { opacity: 0.95, scaleX: 0.2, x: 0 }, { opacity: 0, scaleX: 1.3, x: (i % 2 ? 1 : -1) * (70 + i * 40), duration: 0.4, ease: "power2.out", immediateRender: false }, t1 + 0.2 + i * 0.03));
        tl.set(el, { opacity: 0 }, t1 + 0.6);
      }
      // living: the light runs round the rim, a sweep crosses every ~2.3s, the glow breathes, bokeh drifts
      function nxLive(tl, el, t0, t1) {
        const id = `#${el.id}`, D = Math.max(0.6, t1 - t0), rep = (p) => Math.ceil(D / p) + 1;
        tl.fromTo(el, { "--a": "0deg" }, { "--a": "360deg", duration: 2.2, repeat: rep(2.2), ease: "none", immediateRender: false }, t0);
        for (let t = 1.4; t < D; t += 2.3) tl.fromTo(`${id} .nx-sweep`, { xPercent: -250 }, { xPercent: 560, duration: 0.7, ease: "power2.inOut", immediateRender: false }, t0 + t);
        tl.fromTo(`${id} > .nx-glow`, { opacity: 0.22 }, { opacity: 0.5, duration: 1.1, repeat: rep(1.1), yoyo: true, ease: "sine.inOut", immediateRender: false }, t0 + 0.8);
        el.querySelectorAll(".nx-bk").forEach((b, i) => { const p = 1.3 + (i % 4) * 0.35; tl.fromTo(b, { y: 10, opacity: 0 }, { y: -16, opacity: 0.6, duration: p, repeat: rep(p), yoyo: true, ease: "sine.inOut", immediateRender: false }, t0 + 0.4 + i * 0.17); });
      }
      // a two-frame chromatic glitch on a text element
      function nxGlitch(tl, el, t) {
        [[0, "3px 0 rgba(255,59,47,.9), -3px 0 rgba(90,220,255,.9)", 2], [0.05, "-3px 0 rgba(255,59,47,.9), 3px 0 rgba(90,220,255,.9)", -2], [0.1, "none", 0]].forEach(([d, sh, x]) => tl.set(el, { textShadow: sh, x }, t + d));
      }
      // alarm: the rim flashes red, the plate shakes, sparks burst from the icon and a ring of particles keeps orbiting it
      function nxAlarm(tl, el, t, host, end) {
        const id = `#${el.id}`;
        tl.set(el, { "--tone": PK_RED, "--sw": "360deg", attr: { "data-alarm": "1" } }, t);
        tl.fromTo(`${id} > .nx-ring.draw, ${id} > .nx-ring.drawb`, { opacity: 1 }, { opacity: 0, duration: 0.5, ease: "power2.out", immediateRender: false }, t);
        tl.fromTo(`${id} > .nx-glow`, { opacity: 1 }, { opacity: 0.45, duration: 0.6, immediateRender: false }, t);
        tl.fromTo(el, { x: 0 }, { x: 8, duration: 0.05, repeat: 7, yoyo: true, immediateRender: false }, t);
        tl.fromTo(`${id} .ic svg`, { rotation: -12 }, { rotation: 12, duration: 0.08, repeat: 5, yoyo: true, transformOrigin: "50% 50%", immediateRender: false }, t); tl.set(`${id} .ic svg`, { rotation: 0 }, t + 0.5);
        tl.fromTo(`${id} .v`, { scale: 1.4 }, { scale: 1, duration: 0.35, ease: "back.out(2)", transformOrigin: "0% 50%", immediateRender: false }, t);
        if (host) {
          host.insertAdjacentHTML("beforeend", Array.from({ length: 12 }, () => `<i class="nx-pt"></i>`).join("") + `<i class="nx-orb">${Array.from({ length: 6 }, (_, i) => `<i style="transform:rotate(${i * 60}deg) translateY(-58px)"></i>`).join("")}</i>`);
          host.querySelectorAll(".nx-pt").forEach((sp, i) => { const a = (i / 12) * Math.PI * 2 + 0.4, r = 64 + (i % 3) * 26; tl.fromTo(sp, { x: 0, y: 0, opacity: 1, scale: 1.2 }, { x: Math.cos(a) * r, y: Math.sin(a) * r, opacity: 0, scale: 0.2, duration: 0.65, ease: "power2.out", immediateRender: false }, t + 0.02 + (i % 4) * 0.03); });
          const orb = host.querySelector(".nx-orb"), D = Math.max(0.5, end - t);
          tl.fromTo(orb, { opacity: 0 }, { opacity: 1, duration: 0.3, immediateRender: false }, t + 0.3);
          tl.fromTo(orb, { rotation: 0 }, { rotation: 360, duration: 2.6, repeat: Math.ceil(D / 2.6), ease: "none", immediateRender: false }, t);
          host.querySelectorAll(".nx-orb i").forEach((d, i) => tl.fromTo(d, { opacity: 0.3 }, { opacity: 1, duration: 0.35 + i * 0.05, repeat: Math.ceil(D / 0.4), yoyo: true, immediateRender: false }, t + 0.3));
        }
      }
      // slot ticks: the number slides in from above at every integer change of value between keys [{t, v}]
      function nxTicks(tl, num, keys, A) {
        for (let i = 0; i + 1 < keys.length; i++) {
          const a = keys[i], b = keys[i + 1], d = b.v - a.v; if (!d) continue;
          const n = Math.abs(Math.round(b.v) - Math.round(a.v)), span = Math.max(0.001, b.t - a.t), s = Math.sign(d);
          nxGlitch(tl, num, A(a.t));
          for (let k = 1; k <= n; k++) { const target = Math.round(a.v) + s * k, tc = a.t + (((target - s * 0.5) - a.v) / d) * span; tl.fromTo(num, { yPercent: -75, opacity: 0.15 }, { yPercent: 0, opacity: 1, duration: Math.min(0.14, (span / n) * 0.9), ease: "power2.out", immediateRender: false }, A(tc)); }
        }
      }

      // ---------- clay icons: soft gradients, a specular highlight, a floor shadow; ids are prefixed per instance ----------
      const PKG = (p) => `<defs>
        <linearGradient id="${p}-tin" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#ffffff"/><stop offset=".45" stop-color="#bfc7d0"/><stop offset="1" stop-color="#525c66"/></linearGradient>
        <linearGradient id="${p}-red" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#ff8f7e"/><stop offset=".5" stop-color="#e2352a"/><stop offset="1" stop-color="#7f160f"/></linearGradient>
        <linearGradient id="${p}-blue" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#8fd0f5"/><stop offset=".5" stop-color="#2f78c4"/><stop offset="1" stop-color="#17395f"/></linearGradient>
        <linearGradient id="${p}-yel" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#ffe6a0"/><stop offset=".5" stop-color="#f2b544"/><stop offset="1" stop-color="#946414"/></linearGradient>
        <radialGradient id="${p}-sack" cx=".35" cy=".3" r=".9"><stop offset="0" stop-color="#f8e9c6"/><stop offset="1" stop-color="#9c7437"/></radialGradient>
        <radialGradient id="${p}-wood" cx=".3" cy=".25" r="1"><stop offset="0" stop-color="#c99461"/><stop offset="1" stop-color="#4a2d15"/></radialGradient>
        <radialGradient id="${p}-skin" cx=".35" cy=".3" r=".8"><stop offset="0" stop-color="#ffdfc0"/><stop offset="1" stop-color="#b87a4c"/></radialGradient>
        <radialGradient id="${p}-sun" cx=".4" cy=".35" r=".7"><stop offset="0" stop-color="#fff8d8"/><stop offset=".6" stop-color="#ffcf5a"/><stop offset="1" stop-color="#f08a2a"/></radialGradient>
        <radialGradient id="${p}-glow"><stop offset="0" stop-color="#ffd27a"/><stop offset="1" stop-color="#ff9a3c" stop-opacity="0"/></radialGradient>
        <linearGradient id="${p}-water" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#bfe9fb"/><stop offset=".6" stop-color="#3b93cf"/><stop offset="1" stop-color="#1c4f80"/></linearGradient>
        <linearGradient id="${p}-glass" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#ffffff"/><stop offset=".5" stop-color="#dfe8ee"/><stop offset="1" stop-color="#8e9ea9"/></linearGradient>
        <radialGradient id="${p}-dark" cx=".35" cy=".3" r=".85"><stop offset="0" stop-color="#5a4a52"/><stop offset="1" stop-color="#15101a"/></radialGradient>
        <linearGradient id="${p}-bin" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#9aa3ab"/><stop offset=".5" stop-color="#5b6066"/><stop offset="1" stop-color="#262a2e"/></linearGradient>
        <radialGradient id="${p}-spec" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#fff" stop-opacity=".9"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></radialGradient>
      </defs>`;
      const RIM = `stroke="rgba(0,0,0,.45)" stroke-width="1.4"`;
      const SHADOW = (cx, cy, rx) => `<ellipse cx="${cx}" cy="${cy}" rx="${rx}" ry="${rx * 0.22}" fill="#000" opacity=".45"/>`;
      const SPEC = (p, cx, cy, rx, ry, rot = -30) => `<ellipse cx="${cx}" cy="${cy}" rx="${rx}" ry="${ry}" fill="url(#${p}-spec)" transform="rotate(${rot} ${cx} ${cy})"/>`;
      const CAN3 = (p, x, y, w, h, band, cls = "a-float") => `<g class="${cls}" style="transform-origin:${x + w / 2}px ${y + h / 2}px">${SHADOW(x + w / 2, y + h + 2, w * 0.62)}<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="${w * 0.1}" fill="url(#${p}-tin)" ${RIM}/><rect x="${x}" y="${y + h * 0.36}" width="${w}" height="${h * 0.32}" fill="url(#${p}-${band})"/><rect x="${x + w * 0.1}" y="${y + 3}" width="${w * 0.1}" height="${h - 6}" rx="2" fill="#fff" opacity=".55"/><ellipse cx="${x + w / 2}" cy="${y}" rx="${w / 2}" ry="${w * 0.14}" fill="url(#${p}-glass)" ${RIM}/><ellipse cx="${x + w / 2}" cy="${y}" rx="${w * 0.3}" ry="${w * 0.07}" fill="#fff" opacity=".7"/><ellipse class="a-glint" cx="${x + w * 0.32}" cy="${y + h * 0.55}" rx="${w * 0.07}" ry="${h * 0.28}" fill="#fff" opacity=".3"/></g>`;
      const PK_ICON = (name, p) => PKG(p) + ({
        can: CAN3(p, 13, 11, 24, 32, "red"),
        people: `${SHADOW(24, 45, 20)}<g class="a-bob"><path d="M3,42c0,-12 6,-17 13,-17s13,5 13,17z" fill="url(#${p}-blue)" ${RIM}/><circle cx="16" cy="16" r="8" fill="url(#${p}-skin)" ${RIM}/>${SPEC(p, 13, 12, 3, 2)}</g><g class="a-bob2"><path d="M22,42c0,-10 5,-14 11,-14s11,4 11,14z" fill="url(#${p}-red)" ${RIM}/><circle cx="33" cy="19" r="7" fill="url(#${p}-skin)" ${RIM}/>${SPEC(p, 30.5, 16, 2.6, 1.8)}</g>`,
        rice: `${SHADOW(24, 44, 18)}<g class="a-float" style="transform-origin:24px 30px"><path d="M11,42q-7,-20 7,-27h12q14,7 7,27z" fill="url(#${p}-sack)" ${RIM}/><path d="M16,15q8,5 16,0" stroke="#6b4a1e" stroke-width="3" fill="none" stroke-linecap="round"/><path d="M17,13l-3,-6M31,13l3,-6" stroke="#6b4a1e" stroke-width="2.5" stroke-linecap="round"/>${SPEC(p, 17, 24, 3, 7, -15)}<text x="24" y="36" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="9" fill="#6b4a1e">ข้าว</text></g>`,
        radio: `${SHADOW(24, 44, 20)}<g class="a-float" style="transform-origin:24px 28px"><rect x="5" y="16" width="38" height="25" rx="4" fill="url(#${p}-wood)" ${RIM}/><rect x="10" y="21" width="17" height="11" rx="2" fill="#120c06"/><rect class="a-glow" x="10" y="21" width="17" height="11" rx="2" fill="url(#${p}-glow)"/><rect class="a-jit" x="17" y="22" width="1.6" height="9" fill="#ff3b30"/><circle cx="35" cy="27" r="4.5" fill="url(#${p}-yel)" ${RIM}/>${SPEC(p, 33.5, 25.5, 1.6, 1.2)}<path d="M31,16L42,5" stroke="#dfe3e8" stroke-width="2.5" stroke-linecap="round"/><circle cx="42" cy="5" r="2.2" fill="#ff3b30" class="a-pulse" style="transform-origin:42px 5px"/><rect x="7" y="18" width="34" height="2" rx="1" fill="#fff" opacity=".35"/></g>`,
        thermo: `${SHADOW(24, 45, 10)}<g class="a-float" style="transform-origin:24px 26px"><rect x="19" y="5" width="10" height="28" rx="5" fill="url(#${p}-glass)" ${RIM}/><rect class="a-merc" x="22" y="12" width="4" height="22" rx="2" fill="#ff3b2f" style="transform-origin:24px 34px"/><circle cx="24" cy="37" r="7" fill="url(#${p}-red)" ${RIM}/>${SPEC(p, 21.5, 34.5, 2.2, 1.6)}<path d="M31,12h4M31,18h3M31,24h4" stroke="#dfe3e8" stroke-width="1.5" opacity=".8"/></g>`,
        water: `${SHADOW(24, 45, 12)}<g class="a-bob"><path d="M24,5c8,12 14,18 14,26a14,14 0 0 1 -28,0c0,-8 6,-14 14,-26z" fill="url(#${p}-water)" ${RIM}/>${SPEC(p, 18, 26, 3, 6, -20)}</g>`,
        sun: `<g class="a-spin" style="transform-origin:24px 24px"><path d="M24,3v7M24,38v7M3,24h7M38,24h7M9,9l5,5M34,34l5,5M39,9l-5,5M14,34l-5,5" stroke="#f08a2a" stroke-width="3" stroke-linecap="round"/></g><circle cx="24" cy="24" r="10" fill="url(#${p}-sun)" ${RIM}/>`,
      })[name];
      const PK_SHIELD = `<path d="M12,5L3,8v6c0,6 4,9 9,11c5,-2 9,-5 9,-11V8z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>`;
      const LT = "#f3efe6", RD = "#ff6a5c", GD = PK_GOLD;
      const PK_RULE_ICONS = [
        [`<circle cx="17" cy="17" r="7" fill="${GD}"/><path d="M4,28h26" stroke="${LT}" stroke-width="2.4" stroke-linecap="round"/>`, `<path d="M17,5v6M9,8l3,4M25,8l-3,4" stroke="${LT}" stroke-width="2.4" stroke-linecap="round"/><path d="M8,26l9,-14l9,14z" fill="${LT}"/>`],
        [`<path d="M8,20q0,-6 5,-6l4,4l4,-4q5,0 5,6v8H8z" fill="none" stroke="${LT}" stroke-width="2.4" stroke-linejoin="round"/><path d="M13,14V9q0,-4 4,-4t4,4v5" fill="none" stroke="${LT}" stroke-width="2.4"/>`, `<circle cx="17" cy="17" r="11" fill="none" stroke="${RD}" stroke-width="2.6"/><path d="M9,9l16,16" stroke="${RD}" stroke-width="2.6" stroke-linecap="round"/>`],
        [`<path d="M6,28V12l11,-6l11,6v16z" fill="none" stroke="${LT}" stroke-width="2.4" stroke-linejoin="round"/><path d="M17,6v22M6,19h22" stroke="${LT}" stroke-width="2"/>`, `<path d="M8,26L26,8M20,8h6v6" fill="none" stroke="${RD}" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="17" cy="17" r="12" fill="none" stroke="${RD}" stroke-width="2.6"/>`],
      ];
      // a looping micro-motion driver for the pk cards (classes a-*), active from t0 to t1
      function pkLoops(tl, root, t0, t1) {
        const D = Math.max(0.5, t1 - t0), rep = (p) => Math.ceil(D / p) + 1, q = (c) => root.querySelectorAll(c);
        const T = (el, from, to, p, extra = {}) => tl.fromTo(el, from, { ...to, duration: p, repeat: rep(p), yoyo: true, ease: "sine.inOut", immediateRender: false, ...extra }, t0);
        q(".a-pulse").forEach((el) => T(el, { scale: 1 }, { scale: 1.12, transformOrigin: "50% 50%" }, 0.45));
        q(".a-bob").forEach((el) => T(el, { y: -2 }, { y: 3 }, 0.6)); q(".a-bob2").forEach((el) => T(el, { y: 3 }, { y: -2 }, 0.6));
        q(".a-float").forEach((el, i) => T(el, { y: -2, rotation: -4 }, { y: 2, rotation: 4, transformOrigin: "50% 50%" }, 0.9 + (i % 2) * 0.2));
        q(".a-glint").forEach((el) => T(el, { x: -3 }, { x: 5 }, 1.1));
        q(".a-wob").forEach((el) => T(el, { rotation: -6 }, { rotation: 6 }, 0.7));
        q(".a-jit").forEach((el) => T(el, { x: -1.5 }, { x: 1.5 }, 0.07, { ease: "none" }));
        q(".a-merc").forEach((el) => T(el, { scaleY: 0.72 }, { scaleY: 1 }, 0.9));
        q(".a-glow").forEach((el) => T(el, { opacity: 0.35 }, { opacity: 1 }, 0.7));
        q(".a-bulge").forEach((el) => T(el, { scaleY: 1 }, { scaleY: 1.5, transformOrigin: "50% 100%" }, 0.5));
        q(".a-spin").forEach((el) => tl.fromTo(el, { rotation: 0 }, { rotation: 360, duration: 6, repeat: rep(6), ease: "none", transformOrigin: "50% 50%", immediateRender: false }, t0));
        q(".a-drip").forEach((el, i) => tl.fromTo(el, { y: 0, opacity: 1 }, { y: 18, opacity: 0, duration: 0.9, repeat: rep(0.9), ease: "power1.in", immediateRender: false }, t0 + i * 0.3));
        q(".a-rise").forEach((el, i) => tl.fromTo(el, { y: 0, opacity: 0.9 }, { y: -16, opacity: 0, duration: 0.8, repeat: rep(0.8), ease: "power1.out", immediateRender: false }, t0 + i * 0.25));
      }

      // ---------- stat chip: keys [{t, v}] in shot time; `max` draws segments; `alarm` goes red with sparks; `right` docks it right ----------
      GameUI.C.counter = {
        html: (id, o) => `<div id="${id}" class="pks${o.right ? " right" : ""}" style="top:${o.top ?? 150}px"><div class="ic"><svg viewBox="0 0 48 48">${PK_ICON(o.icon || "can", id)}</svg></div>
          <div class="tx"><div class="lbl">${o.label}</div><div class="v"><span class="slot"><span class="num">${o.keys[0].v}</span></span>${o.unit ? `<small>${o.unit}</small>` : ""}</div>
          ${o.max ? `<div class="seg">${Array.from({ length: o.max }, (_, k) => `<i class="${k < o.keys[0].v ? "" : "off"}"></i>`).join("")}</div>` : ""}${o.sub ? `<div class="sub">${o.sub}</div>` : ""}</div></div>`,
        anim(tl, id, t0, o) {
          const el = nxDress(document.getElementById(id), PK_GOLD, 11 + (o.top || 0)), ic = el.querySelector(".ic"), num = el.querySelector(".num"), segs = el.querySelectorAll(".seg i"), c = { t: o.t };
          const endT = o.end ?? o.t + 30, end = o.t0abs + endT, A = (t) => o.t0abs + t;
          nxIn(tl, el, t0, { dx: o.right ? 70 : -70 });
          tl.fromTo(`#${id} .ic svg`, { scale: 0, rotation: -50 }, { scale: 1, rotation: 0, duration: 0.55, ease: "back.out(2.2)", transformOrigin: "50% 50%", immediateRender: false }, t0 + 0.3);
          if (segs.length) tl.fromTo(segs, { scaleY: 0, opacity: 0 }, { scaleY: 1, opacity: 1, duration: 0.2, stagger: 0.03, ease: "power2.out", transformOrigin: "50% 100%", immediateRender: false }, t0 + 0.45);
          const at = (t) => { let i = 0; while (i + 1 < o.keys.length && o.keys[i + 1].t <= t) i++; const a = o.keys[i], b = o.keys[i + 1]; if (!b) return a.v; const k = Math.min(1, Math.max(0, (t - a.t) / (b.t - a.t))); return a.v + (b.v - a.v) * k; };
          const draw = () => { const v = at(c.t); num.textContent = Math.round(v); segs.forEach((s, k) => s.classList.toggle("off", k >= Math.round(v))); };
          tl.to(c, { t: endT, duration: endT - o.t, ease: "none", immediateRender: false, onUpdate: draw }, t0);
          nxTicks(tl, num, o.keys, A);
          o.keys.forEach((k, i) => { if (i && k.v !== o.keys[i - 1].v) tl.fromTo(`#${id} .v`, { scale: 1.22 }, { scale: 1, duration: 0.3, ease: "back.out(2)", transformOrigin: "0% 50%", immediateRender: false }, A(k.t)); });
          if (o.alarm !== undefined) nxAlarm(tl, el, A(o.alarm), ic, end);
          draw();
          nxLive(tl, el, t0, end); pkLoops(tl, el, t0, end);
          if (o.end !== undefined) nxOut(tl, el, A(o.end));
        },
      };
      // ---------- title card for the chapter beat: the count rolls down to the day on a slot, then pops gold ----------
      GameUI.C.board = {
        html: (id, o) => `<div id="${id}" class="pkt" style="top:${o.top ?? 150}px"><div class="plate" id="${id}-pl">
          <div class="pill" id="${id}-p">${o.series || "เอาชีวิตรอด 99 วัน"}</div>
          <div class="big" id="${id}-b">${o.label || "เหลือ"} <b><span class="slot"><span class="num" id="${id}-n">${+o.day + 6}</span></span></b> ${o.unit0 || "วัน"}</div>
          <div class="chip" id="${id}-c"><svg viewBox="0 0 48 48">${PK_ICON("radio", id + "r")}</svg>${o.unit || "ตามที่วิทยุนับ"}</div>
          <div class="ep" id="${id}-e">${o.ep}</div></div></div>`,
        anim(tl, id, t0, o) {
          const pl = nxDress(document.getElementById(`${id}-pl`), PK_RED, 21), num = document.getElementById(`${id}-n`), end = o.t0abs + (o.end ?? o.t + 5);
          tl.set(`#${id}`, { opacity: 1 }, t0);
          nxIn(tl, pl, t0, { dy: -30 });
          const day = +o.day, from = day + 6, c = { v: from }, dur = 0.8, T0 = t0 + 1.0;
          tl.to(c, { v: day, duration: dur, ease: "none", immediateRender: false, onUpdate: () => { num.textContent = Math.round(c.v); } }, T0);
          for (let k = 1; k <= from - day; k++) tl.fromTo(num, { yPercent: -80, opacity: 0.2 }, { yPercent: 0, opacity: 1, duration: 0.1, ease: "power2.out", immediateRender: false }, T0 + ((k - 0.5) / (from - day)) * dur);
          nxGlitch(tl, num, T0 + dur - 0.02);
          tl.fromTo(`#${id}-b b`, { scale: 1.45, color: "#fff" }, { scale: 1, color: PK_GOLD, duration: 0.5, ease: "back.out(1.6)", transformOrigin: "50% 60%", immediateRender: false }, T0 + dur);
          tl.fromTo(`#${id}-pl > .nx-glow`, { opacity: 1 }, { opacity: 0.35, duration: 0.6, immediateRender: false }, T0 + dur);
          tl.fromTo(`#${id}-c svg`, { rotation: -15 }, { rotation: 15, duration: 0.12, repeat: 5, yoyo: true, transformOrigin: "50% 50%", immediateRender: false }, t0 + 0.9); tl.set(`#${id}-c svg`, { rotation: 0 }, t0 + 1.65);
          nxLive(tl, pl, t0, end); pkLoops(tl, pl, t0 + 0.7, end);
          if (o.end !== undefined) nxOut(tl, pl, o.t0abs + o.end);
        },
      };
      // ---------- the rules: one glass card per rule, each dissolving into the next at o.at[i] ----------
      GameUI.C.fRule = {
        html: (id, o) => `<div id="${id}" class="pkr" style="top:${o.top ?? 200}px">${o.rows.map((txt, i) => `<div class="card" id="${id}-r${i}"><div class="n"><svg viewBox="0 0 24 24" style="color:${PK_GOLD}">${PK_SHIELD}</svg>กฎข้อ ${i + 1}</div>
          <div class="t">${txt}</div><div class="line"></div><div class="ics">${PK_RULE_ICONS[i].map((ic) => `<span><svg viewBox="0 0 34 34">${ic}</svg></span>`).join("")}</div></div>`).join("")}</div>`,
        anim(tl, id, t0, o) {
          const A = (t) => o.t0abs + t;
          o.at.forEach((at, i) => {
            const card = nxDress(document.getElementById(`${id}-r${i}`), PK_RED, 31 + i), T = A(at), t1 = i + 1 < o.at.length ? A(o.at[i + 1]) - 0.05 : A(o.end ?? at + 5);
            nxIn(tl, card, T, { dy: 40 });
            tl.fromTo(`#${id}-r${i} .t`, { clipPath: "inset(-20px 100% -20px -10px)" }, { clipPath: "inset(-20px -10px -20px -10px)", duration: 0.55, ease: "power1.inOut", immediateRender: false }, T + 0.35);
            tl.fromTo(`#${id}-r${i} .line`, { scaleX: 0 }, { scaleX: 1, duration: 0.4, ease: "power2.out", transformOrigin: "50% 50%", immediateRender: false }, T + 0.5);
            tl.fromTo(`#${id}-r${i} .ics span`, { scale: 0, rotation: -30 }, { scale: 1, rotation: 0, duration: 0.35, stagger: 0.09, ease: "back.out(2.4)", immediateRender: false }, T + 0.6);
            nxLive(tl, card, T, t1); pkLoops(tl, card, T + 0.6, t1);
            nxOut(tl, card, t1);
          });
        },
      };
      // ---------- "ตอนต่อไป · ตอนที่ 2" header for the end card ----------
      GameUI.C.nextCard = {
        html: (id, o) => `<div id="${id}" class="pkn" style="top:${o.top ?? 150}px"><div class="plate" id="${id}-pl"><div class="pill" id="${id}-p"><i></i>ตอนต่อไป</div><div class="big" id="${id}-b">${o.big}</div><div class="tag" id="${id}-t">${o.tag}</div></div></div>`,
        anim(tl, id, t0, o) {
          const pl = nxDress(document.getElementById(`${id}-pl`), PK_GOLD, 41), end = o.t0abs + (o.end ?? o.t + 6), big = document.getElementById(`${id}-b`);
          tl.set(`#${id}`, { opacity: 1 }, t0);
          nxIn(tl, pl, t0, { dy: -30 });
          tl.fromTo(big, { letterSpacing: "30px", scale: 1.15 }, { letterSpacing: "2px", scale: 1, duration: 0.7, ease: "power3.out", immediateRender: false }, t0 + 0.35);
          tl.fromTo(`#${id}-p i`, { opacity: 0.3, scale: 0.8 }, { opacity: 1, scale: 1.25, duration: 0.5, repeat: Math.ceil((end - t0) / 0.5), yoyo: true, immediateRender: false }, t0);
          nxGlitch(tl, big, t0 + 1.4); nxGlitch(tl, big, t0 + 2.7);
          nxLive(tl, pl, t0, end);
