      // ---------- the signs on a can: three clay cans that do the thing (lid doming, a drip, fizz), each row a glass plate with a red rim ----------
      const SIGN3 = (i, p) => PKG(p) + [
        `${SHADOW(60, 104, 34)}<g class="a-float" style="transform-origin:60px 74px"><rect x="32" y="44" width="56" height="58" rx="6" fill="url(#${p}-tin)" ${RIM}/><rect x="32" y="64" width="56" height="20" fill="url(#${p}-red)"/><rect x="37" y="47" width="7" height="52" rx="2" fill="#fff" opacity=".5"/><path class="a-bulge" d="M32,44q28,-26 56,0z" fill="url(#${p}-glass)" ${RIM} style="transform-origin:60px 44px"/><ellipse class="a-glint" cx="50" cy="74" rx="4" ry="18" fill="#fff" opacity=".3"/></g>`,
        `${SHADOW(60, 104, 34)}<g class="a-float" style="transform-origin:60px 60px"><rect x="32" y="30" width="56" height="60" rx="6" fill="url(#${p}-tin)" ${RIM}/><rect x="32" y="50" width="56" height="20" fill="url(#${p}-blue)"/><rect x="37" y="33" width="7" height="54" rx="2" fill="#fff" opacity=".5"/><ellipse cx="60" cy="30" rx="28" ry="7" fill="url(#${p}-glass)" ${RIM}/><ellipse cx="60" cy="30" rx="18" ry="3.5" fill="#fff" opacity=".7"/></g><path d="M48,90q12,8 24,0" stroke="#6b4a2e" stroke-width="5" fill="none" opacity=".8"/>${[0, 1, 2].map((k) => `<path class="a-drip" d="M${56 + k * 6},92c5,8 7,13 2,16c-6,-3 -6,-8 -2,-16z" fill="#8a6a4a"/>`).join("")}`,
        `${SHADOW(60, 104, 34)}<g class="a-float" style="transform-origin:60px 74px"><rect x="32" y="46" width="56" height="56" rx="6" fill="url(#${p}-tin)" ${RIM}/><rect x="32" y="66" width="56" height="20" fill="url(#${p}-yel)"/><rect x="37" y="49" width="7" height="50" rx="2" fill="#fff" opacity=".5"/><path d="M32,46h56" stroke="rgba(0,0,0,.45)" stroke-width="2"/></g>${[[46, 36, 7], [60, 28, 9], [76, 36, 6], [54, 18, 5], [68, 14, 6]].map(([x, y, r]) => `<circle class="a-rise" cx="${x}" cy="${y}" r="${r}" fill="#fff8e0" opacity=".9"/>`).join("")}`,
      ][i];
      GameUI.C.signs = {
        html: (id, o) => `<div id="${id}" class="fsigns" style="top:${o.top ?? 170}px">${o.items.map((t, i) => `<div class="row" id="${id}-r${i}"><div class="ic"><svg viewBox="0 0 120 120" style="overflow:visible">${SIGN3(i, `${id}s${i}`)}</svg></div><div class="tx">${t}</div><b class="bad nx-skip">✗</b></div>`).join("")}</div>`,
        anim(tl, id, t0, o) {
          const end = o.t0abs + (o.end ?? o.at[o.at.length - 1] + 4);
          o.at.forEach((at, i) => {
            const row = nxDress(document.getElementById(`${id}-r${i}`), PK_RED, 51 + i), T = o.t0abs + at;
            nxIn(tl, row, T, { dx: -70 });
            tl.fromTo(`#${id}-r${i} .ic svg`, { scale: 0, rotation: -30 }, { scale: 1, rotation: 0, duration: 0.5, ease: "back.out(2.2)", transformOrigin: "50% 50%", immediateRender: false }, T + 0.3);
            tl.fromTo(`#${id}-r${i} .bad`, { opacity: 0, scale: 3.5, rotation: -20 }, { opacity: 1, scale: 1, rotation: -8, duration: 0.2, ease: "power4.in", immediateRender: false }, T + 0.55);
            tl.fromTo(`#${id}-r${i}`, { x: 0 }, { x: 8, duration: 0.05, repeat: 5, yoyo: true, immediateRender: false }, T + 0.72);
            tl.fromTo(`#${id}-r${i} > .nx-glow`, { opacity: 1 }, { opacity: 0.35, duration: 0.5, immediateRender: false }, T + 0.72);
            nxLive(tl, row, T, end); pkLoops(tl, row, T + 0.5, end);
            if (o.end !== undefined) nxOut(tl, row, o.t0abs + o.end + i * 0.06);
          });
        },
      };
      // ---------- source chip and callback on glass ----------
      GameUI.C.src = {
        html: (id, o) => `<div id="${id}" class="zsrc" style="top:${o.top}px"><span id="${id}-s"><b>i</b><div>${o.text}</div></span></div>`,
        anim(tl, id, t0, o) {
          const sp = nxDress(document.getElementById(`${id}-s`), PK_GOLD, 61), end = o.t0abs + (o.end ?? o.t + 4);
          tl.set(`#${id}`, { opacity: 1 }, t0);
          nxIn(tl, sp, t0, { dy: 20 });
          tl.fromTo(`#${id} b`, { scale: 1 }, { scale: 1.2, duration: 0.5, repeat: Math.ceil((end - t0) / 0.5) + 1, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0 + 0.5);
          nxLive(tl, sp, t0, end);
          if (o.end !== undefined) nxOut(tl, sp, o.t0abs + o.end);
        },
      };
      GameUI.C.callback = {
        html: (id, o) => `<div id="${id}" class="zcall" style="top:${o.top ?? 150}px"><span id="${id}-s"><small>${o.label}</small><em class="tx" style="font-style:normal">${o.text}</em></span></div>`,
        anim(tl, id, t0, o) {
          const sp = nxDress(document.getElementById(`${id}-s`), PK_RED, 71), end = o.t0abs + (o.end ?? o.t + 4);
          tl.set(`#${id}`, { opacity: 1 }, t0);
          tl.fromTo(sp, { scale: 1.3 }, { scale: 1, duration: 0.45, ease: "power3.out", immediateRender: false }, t0);
          nxIn(tl, sp, t0);
          tl.fromTo(`#${id}-s > .nx-glow`, { opacity: 0.9 }, { opacity: 0.4, duration: 0.18, repeat: 5, yoyo: true, immediateRender: false }, t0 + 0.4);
          nxLive(tl, sp, t0 + 0.8, end);
          if (o.end !== undefined) nxOut(tl, sp, o.t0abs + o.end);
        },
      };
      // ---------- the tip medallions with depth (animated by GameUI's own loops: a-pulse / a-bob / a-sway) ----------
      Object.assign(GameUI.ILL, {
        toxin: `${PKG("tx")}${SHADOW(60, 108, 34)}<circle cx="60" cy="58" r="40" fill="url(#tx-dark)" ${RIM}/>${SPEC("tx", 46, 40, 14, 8, -30)}
          <g class="a-pulse" style="transform-origin:60px 56px"><path d="M38,46l14,14M52,46l-14,14M68,46l14,14M82,46l-14,14" stroke="#ff5a4a" stroke-width="6" stroke-linecap="round"/></g><path d="M48,78q12,-8 24,0" stroke="#f4ecd8" stroke-width="4" fill="none" stroke-linecap="round"/><path d="M52,74v8M60,76v8M68,74v8" stroke="#f4ecd8" stroke-width="3" stroke-linecap="round"/>
          <g class="a-bob"><circle cx="24" cy="22" r="7" fill="#8ff0a0" opacity=".9"/><circle cx="98" cy="18" r="5" fill="#8ff0a0" opacity=".9"/><circle cx="90" cy="34" r="3.5" fill="#8ff0a0" opacity=".9"/></g>`,
        trash: `${PKG("tr")}${SHADOW(60, 110, 34)}<path d="M30,42h60l-6,64H36z" fill="url(#tr-bin)" ${RIM}/><path d="M36,45h8l-4,58" fill="#fff" opacity=".25"/><path d="M50,54v44M70,54v44" stroke="#0e1014" stroke-width="3" opacity=".5"/>
          <g class="a-bob"><rect x="22" y="30" width="76" height="12" rx="4" fill="url(#tr-bin)" ${RIM}/><path d="M48,30v-8h24v8" fill="none" stroke="#dfe3e8" stroke-width="4"/></g>
          <g class="a-sway" style="transform-origin:60px 10px">${CAN3("tr", 46, -8, 28, 36, "red", "")}</g>`,
      });
      // ---------- the sun card: a window of sky in the glass, the sun sliding down to a red horizon; the clock ticks each minute ----------
      GameUI.C.sunHud = {
        html: (id, o) => `<div id="${id}" class="fsun" style="top:${o.top ?? 140}px"><div class="win"><svg viewBox="0 0 380 150">${PKG(id)}<defs><linearGradient id="${id}-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#14223a"/><stop offset=".55" stop-color="#8a4f5c"/><stop offset=".86" stop-color="#e98f44"/><stop offset="1" stop-color="#ffd37a"/></linearGradient></defs>
          <rect width="380" height="150" fill="url(#${id}-sky)"/>${[[30, 22], [80, 14], [140, 30], [300, 18], [340, 40], [250, 10]].map(([x, y]) => `<circle class="a-glow" cx="${x}" cy="${y}" r="1.6" fill="#fff"/>`).join("")}<path d="M65,150A125,125 0 0 1 315,150" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="3" stroke-dasharray="4 10"/>
          <path d="M0,150V128L40,118L90,126L140,110L200,122L250,106L300,118L340,108L380,120V150Z" fill="#0f0c0e"/><path d="M0,128H380" stroke="#ff5a4a" stroke-width="3" stroke-dasharray="10 8"/>
          <g id="${id}-sun"><circle class="a-glow" r="40" fill="url(#${id}-glow)" opacity=".85"/><circle r="17" fill="url(#${id}-sun)"/><circle cx="-5" cy="-6" r="5" fill="#fff" opacity=".6"/></g>
          <text x="370" y="118" text-anchor="end" font-family="Kanit" font-weight="700" font-size="22" fill="#ffd6c8">มืด ${o.dark}</text></svg></div>
          <div class="row"><div class="tm" id="${id}-tm">${o.t0}</div><div class="lf">ก่อนมืด<b id="${id}-lf">${o.left0}</b></div></div></div>`,
        anim(tl, id, t0, o) {
          const el = nxDress(document.getElementById(id), PK_GOLD, 81), sun = document.getElementById(`${id}-sun`), tm = document.getElementById(`${id}-tm`), lf = document.getElementById(`${id}-lf`), c = { k: 0 };
          const m = (h) => { const [a, b] = h.split(":").map(Number); return a * 60 + b; };
          const A = m(o.t0), B = m(o.t1), DK = m(o.dark), dur = (o.end ?? D("gate")) - o.t, end = o.t0abs + (o.end ?? o.t + dur);
          nxIn(tl, el, t0, { dx: 70 });
          const draw = () => {
            const k = c.k, mins = A + (B - A) * k, u = (o.from ?? 0.3) + ((o.to ?? 0.95) - (o.from ?? 0.3)) * k, a = Math.PI * (1 - u);
            sun.setAttribute("transform", `translate(${(190 + Math.cos(a) * 125).toFixed(1)},${(150 - Math.sin(a) * 125).toFixed(1)})`);
            tm.textContent = `${String(Math.floor(mins / 60)).padStart(2, "0")}:${String(Math.floor(mins % 60)).padStart(2, "0")} น.`;
            const left = DK - mins; lf.textContent = left > 0 ? `${Math.floor(left / 60)}:${String(Math.floor(left % 60)).padStart(2, "0")} ชม.` : "เลยเวลา";
            el.classList.toggle("late", left <= 0);
          };
          tl.to(c, { k: 1, duration: dur, ease: "none", immediateRender: false, onUpdate: draw }, t0);
          for (let k = 1; k <= B - A; k++) { const tc = t0 + (k / (B - A)) * dur; tl.fromTo(tm, { y: 8, opacity: 0.4 }, { y: 0, opacity: 1, duration: 0.18, ease: "power2.out", immediateRender: false }, tc); if (A + k === DK) { tl.fromTo(`#${id} > .nx-glow`, { opacity: 1 }, { opacity: 0.4, duration: 0.5, immediateRender: false }, tc); tl.fromTo(el, { x: 0 }, { x: 6, duration: 0.05, repeat: 5, yoyo: true, immediateRender: false }, tc); } }
          draw();
          nxLive(tl, el, t0, end); pkLoops(tl, el, t0, end);
          if (o.end !== undefined) nxOut(tl, el, o.t0abs + o.end);
        },
      };
      // ---------- captions bounce in word by word: Ui.caption wraps the words, Engine.build gets the tweens after the shots are built ----------
      {
        const seg = typeof Intl !== "undefined" && Intl.Segmenter ? new Intl.Segmenter("th", { granularity: "word" }) : null;
        const cap0 = Ui.caption;
        Ui.caption = (id, text) => {
          const tpl = document.createElement("template"); tpl.innerHTML = cap0(id, text);
          const box = tpl.content.firstElementChild;
          const walk = (el) => [...el.childNodes].forEach((n) => {
            if (n.nodeType === 3) {
              const frag = document.createDocumentFragment(), parts = seg ? [...seg.segment(n.textContent)].map((s) => s.segment) : n.textContent.split(/(\s+)/);
              parts.forEach((p) => { if (!p) return; if (/^\s+$/.test(p)) frag.appendChild(document.createTextNode(p)); else { const s = document.createElement("span"); s.className = "w"; s.textContent = p; frag.appendChild(s); } });
              el.replaceChild(frag, n);
            } else if (n.classList && n.classList.contains("k")) n.classList.add("w");
            else walk(n);
          });
          walk(box);
          return box.outerHTML;
        };
        const build0 = Engine.build;
        Engine.build = (root, tl, shots) => {
          build0(root, tl, shots);
          shots.forEach((sh, i) => (sh.captions || []).forEach((cp, k) => {
            const ws = document.querySelectorAll(`#s${i}-c${k} .w`);
            if (ws.length) tl.fromTo(ws, { opacity: 0, y: 22, scale: 0.7 }, { opacity: 1, y: 0, scale: 1, duration: 0.26, ease: "back.out(2.4)", stagger: Math.min(0.05, 0.35 / ws.length), immediateRender: false }, sh.start + cp.t);
          }));
        };
      }
