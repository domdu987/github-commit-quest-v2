      // ======================================================================================================
      // ติดเกาะร้าง · EP.1 "ปลาลูกโป่ง" (ร่าง 2: ของจริงล้วน ไม่มีตำนาน)
      // ======================================================================================================
      const put = (el, html) => el.insertAdjacentHTML("beforeend", html);
      const CLIP = (list) => { list.sort((a, b) => a.t - b.t); for (let n = 0; n + 1 < list.length; n++) list[n].end = Math.min(list[n].end, list[n + 1].t - 0.03); return list; };
      // a shot cut into three framings: [0, a1), [a1, a2), [a2, end)
      const split3 = (k, a1, a2, A, B, C) => {
        add(k, A); shots[shots.length - 1].dur = a1;
        add(k, B); let sh = shots[shots.length - 1]; sh.start = SH[k].start + a1; sh.dur = a2 - a1; sh.vo = (SH[k].vo || []).map((v) => ({ ...v, t: v.t - a1 }));
        add(k, C); sh = shots[shots.length - 1]; sh.start = SH[k].start + a2; sh.dur = D(k) - a2; sh.vo = (SH[k].vo || []).map((v) => ({ ...v, t: v.t - a2 }));
      };
      const capsAt = (k, a, b, lines, o) => caps(k, lines, o).filter((c) => c.end > a + 0.05 && c.t < b - 0.05).map((c) => ({ ...c, t: Math.max(0, c.t - a), end: Math.min(b - a - 0.03, c.end - a) }));
      const bubAt = (bb, a, b) => ({ ...bb, t: Math.max(0.02, bb.t - a), end: Math.min(b - a - 0.05, bb.end - a) });
      const FA = (k, a, i = 0, j = 0) => F(k, i, j) - a;
      const VA = (k, a, i = 0) => vo(k, i) - a;
      const PW = (x, y, s, track, extra = {}) => ({ who: "praew", x, y, s, track, ...extra });
      const TG = (x, y, s, track, extra = {}) => ({ who: "tong", x, y, s, track, ...extra });
      const NU = (x, y, s, track, extra = {}) => ({ who: "nuan", x, y, s, track, ...extra });
      const MK = (x, y, s, track, extra = {}) => ({ who: "mek", x, y, s, track, ...extra });
      // shake an actor through a wrapper group: GSAP x/y on the actor <g> itself replaces its transform attribute (the figure jumps to 0,0)
      const wrapEl = (sel) => { const a = document.querySelector(sel), w = document.createElementNS("http://www.w3.org/2000/svg", "g"); a.parentNode.insertBefore(w, a); w.appendChild(a); return w; };
      const jig = (id, k) => { const a = document.getElementById(`${id}-a${k}`), w = document.createElementNS("http://www.w3.org/2000/svg", "g"); a.parentNode.insertBefore(w, a); w.appendChild(a); return w; };
      // a face leaning over the camera from above the viewer's head (the paralysed point of view): the whole figure turned on its feet so the
      // head hangs into the top of the frame, chin toward the centre, hair toward the edge
      Rig.MODES.overMe = (u, o) => ({ ...Rig.MODES.idle(u, o), rootR: 180 + Math.sin(u * 1.1) * 1.5, head: (o.head ?? 6) + Math.sin(u * 0.9) * 2, torso: 4, uaF: -40, faF: -50, uaB: -30, faB: -40 });
      Rig.MODES.overMeShake = (u, o) => ({ ...Rig.MODES.overMe(u, o), rootR: 180 + Math.sin(u * 24) * 2.2, head: 8 + Math.sin(u * 24) * 3 });
      const OVER = (track, extra = {}) => PW(540, -560, 2.65, track, { cu: false, cast: false, rim: false, blinks: [], ...extra });
      // โต้ง's cupped hands (first person) with the balloon fish on them; origin = between the wrists
      const CUPHANDS = () => `<g transform="translate(-118,0) rotate(-26) scale(-0.92,0.92)">${Hand.open(Isle.TONGHAND)}</g><g transform="translate(118,0) rotate(26) scale(0.92)">${Hand.open(Isle.TONGHAND)}</g>`;
      Camp.hand.coconutS = `<g transform="translate(6,132) scale(.42)">${Isle.COCONUT(0, 0, 1, true)}</g>`;
      // the stool ยาย sits on, and a cleaver for her hand
      const STOOL = (x, y) => `<g transform="translate(${x},${y})"><ellipse cx="0" cy="6" rx="110" ry="18" fill="#000" opacity=".22"/><path d="M-80,-150h160v-26H-80z" fill="#8a6a44" stroke="#2e2a26" stroke-width="4"/><path d="M-66,-150l-14,150M66,-150l14,150M-20,-150l-4,150M20,-150l4,150" stroke="#6b4a2e" stroke-width="12" stroke-linecap="round"/></g>`;
      Camp.hand.cleaver = `<g transform="translate(0,118) rotate(-100)"><rect x="-8" y="-6" width="16" height="60" rx="5" fill="#6b4a2e" stroke="#2e2a26" stroke-width="3"/><path d="M-30,-6H30L34,-120Q0,-140 -30,-120Z" fill="#c9ccd0" stroke="#2e2a26" stroke-width="3.5"/><path d="M-22,-16V-110" stroke="#fff" stroke-opacity=".5" stroke-width="4"/></g>`;
      // the eyes that never close: a figure whose blink list is empty (ตาเมฆ, and โต้ง once the poison has him)
      const NOBLINK = { blinks: [] };

      // ---------- icons for this episode's cards (120-space, like the EP.7 step icons) ----------
      const I3 = `stroke="${PK_INK}" stroke-width="3"`;
      const ICN = {
        fire: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<g class="a-bob"><path d="M60,22q-30,36 -22,62q6,20 24,22q22,-2 26,-24q4,-22 -10,-40q2,20 -10,26q-4,-22 -8,-46z" fill="#f08a3c" ${I3}/><path d="M60,56q-12,20 -4,34q10,4 14,-8q2,-14 -10,-26z" fill="#fff1c4"/></g>`,
        water: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<path d="M38,90Q30,30 60,20Q90,30 82,90Q74,100 60,100Q46,100 38,90Z" fill="#7aa84a" ${I3}/><ellipse cx="62" cy="28" rx="14" ry="5" fill="#f4ecd8" ${I3}/><path d="M64,28L80,0" stroke="#9a7a3a" stroke-width="5" stroke-linecap="round"/><g class="a-rise"><path d="M48,56q6,-6 12,0M66,64q6,-6 12,0" stroke="#dff6ff" stroke-width="3" fill="none" stroke-linecap="round"/></g>`,
        bed: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<path d="M20,96L48,36h24l28,60z" fill="#4f7a44" ${I3}/><path d="M34,96l20,-44M86,96l-20,-44M60,36v60" stroke="#6a9a58" stroke-width="3"/><path d="M14,98h92" stroke="#8a6a44" stroke-width="6" stroke-linecap="round"/><g class="a-bob"><path d="M74,26q6,-14 18,-10q-4,10 -18,10z" fill="#6a9a58" ${I3}/></g>`,
        food: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<text x="60" y="80" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="64" fill="${PK_INK}">?</text>`,
        fish: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<g class="a-bob"><path d="M18,62q24,-34 56,-28q20,6 24,26q-4,20 -24,26q-32,6 -56,-24z" fill="#b9b073" ${I3}/><path d="M94,46l16,-14v56l-16,-14" fill="#d9d0a0" ${I3}/><circle cx="36" cy="56" r="8" fill="#fbf7ee" ${I3}/><circle cx="35" cy="56" r="3.5" fill="#1d130c"/><circle cx="60" cy="48" r="4" fill="#5e5a2e"/><circle cx="74" cy="64" r="4" fill="#5e5a2e"/><circle cx="56" cy="70" r="3" fill="#5e5a2e"/></g>`,
        knife: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<g class="a-wob" style="transform-origin:60px 60px"><path d="M30,96l10,-14h14l-10,14z" fill="#6b4a2e" ${I3}/><path d="M40,82L86,20q10,-2 10,10L54,82z" fill="#c9ccd0" ${I3}/></g><path d="M20,100h80" stroke="#9aa0a6" stroke-width="4" stroke-linecap="round"/>`,
        phone: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<rect x="40" y="18" width="40" height="80" rx="8" fill="#1a1a1e" ${I3}/><rect x="45" y="24" width="30" height="62" fill="#0c0f16"/><g class="a-pulse" style="transform-origin:60px 56px"><path d="M52,44q8,-10 16,0M48,36q12,-14 24,0" stroke="#2f8a5a" stroke-width="3.5" fill="none" stroke-linecap="round"/></g><text x="60" y="78" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="14" fill="#f4ecd8">1669</text>`,
        lung: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<path d="M60,22v30" stroke="${PK_INK}" stroke-width="6" stroke-linecap="round"/><path d="M56,50q-34,0 -34,40q0,10 10,10h20q4,0 4,-4z" fill="#e88a86" ${I3}/><path d="M64,50q34,0 34,40q0,10 -10,10h-20q-4,0 -4,-4z" fill="#e88a86" ${I3}/><g class="a-pulse" style="transform-origin:60px 72px"><path d="M30,80q6,-10 12,0M78,80q6,-10 12,0" stroke="#c8392b" stroke-width="3" fill="none"/></g>`,
      };

      // ---------- 1. hook: frame one is the balloon fish in his hands; then the sand, looking up, the face above, no blink ----------
      split("hook", vo("hook", 1) - 0.08, {
        set: "pool", setOpts: { id: "hk", time: "dusk", puff: 1, puffX: 540, puffY: 1180, puffS: 1.7 }, dark: 0.18, blur: { far: 5 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(540, 1230, 1.45, 540, 900), drift: { s: 0.035 } }] },
        shake: (t) => 2 * Math.sin(t * 3.1) + 1 * Math.sin(t * 7.3),
        captions: capsAt("hook", 0, vo("hook", 1) - 0.08, [0]),
        ui: [{ type: "hookPaper", t: 0, l1: "ติดเกาะร้าง… ของฟรีชิ้นไหน", l2: "ทำให้ ‘ตายทั้งเป็น’?", top: 150 }],
        fx(tl, id, t0, L) {
          // the hands under the fish (behind it in the act layer), drips off the fish, its slow swell and the fins
          const pg = document.getElementById("hk-puffg"); pg.insertAdjacentHTML("beforebegin", `<g transform="translate(540,1360) scale(1.5)">${CUPHANDS()}</g>`);
          for (let k = 0; k < 5; k++) { put(L.act, `<g class="drp" opacity="0"><path d="M0,0q-6,-14 0,-22q6,8 0,22z" fill="#cfeeff" stroke="#2e2a26" stroke-width="2"/></g>`); const el = L.act.lastElementChild, dx = 450 + k * 46, dy = 1300 + (k % 2) * 24;
            for (let r = 0; r < 4; r++) { const T = t0 + 0.2 + k * 0.33 + r * 1.7; tl.set(el, { opacity: 1, x: dx, y: dy }, T); tl.to(el, { y: dy + 420, opacity: 0, duration: 0.55, ease: "power1.in", immediateRender: false }, T); } }
          const c = { k: 1 }; tl.to(c, { k: 0.92, duration: 0.9, yoyo: true, repeat: 6, ease: "sine.inOut", onUpdate: () => document.getElementById("hk-puff-body").setAttribute("transform", `scale(${(1 + 0.55 * c.k).toFixed(3)})`), immediateRender: false }, t0);
          Fx.heart(tl, t0, D("hook"), 0.62, 0.45);
        },
      }, {
        set: "lieDown", setOpts: { id: "hk2", moonX: 880, moonY: 1120 }, dark: 0.4, cu: false,
        cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960), drift: { s: 0.03 } }] },
        shake: (t) => 1.5 * Math.sin(t * 2.3),
        actors: [OVER([{ t: 0, mode: "overMeShake", eyes: "wide", mouth: "scream" }, { t: 1.2, mode: "overMe", eyes: "worry", mouth: "o", opts: { head: 10 } }])],
        captions: capsAt("hook", vo("hook", 1) - 0.08, D("hook"), [1]),
        fx(tl, id, t0, L) {
          const a = vo("hook", 1) - 0.08, X = t0 + FA("hook", a, 1, 2);
          tl.fromTo(`#${id} .stage`, { opacity: 0.2 }, { opacity: 1, duration: 0.22, immediateRender: false }, t0);
          tl.fromTo("#hk2-blur", { opacity: 0 }, { opacity: 1, duration: 0.5, yoyo: true, repeat: 3, immediateRender: false }, t0 + 0.4);
          Fx.punch(tl, `#${id} .stage`, X, 1.08, 0.5); Fx.glitch(tl, `#${id}`, X, 0.2, 12, 17); red(tl, X, 0.6, 0.6);
          // the blanket comes down over the eyes on "ตายทั้งเป็น" — the hook ends under it
          const C = X + 0.3; tl.set("#hk2-cloth", { opacity: 1 }, C); tl.fromTo("#hk2-clothg", { y: 0 }, { y: 2100, duration: 0.8, ease: "power2.in", immediateRender: false }, C);
          Fx.heart(tl, t0, D("hook") - a, 0.5, 0.75);
        },
      });

      // ---------- 2. ยาย's porch at the water: the rule; โต้ง's joke is the belief the episode overturns; the last line of the rule ----------
      add("yai", {
        set: "porch", setOpts: { id: "pc" }, dark: 0.1, blur: { far: 3, mid: 2 },
        cam: { keys: [{ t: 0, ...fr(600, 1250, 1.0, 540, 960), drift: { s: 0.012 } }] },
        actors: [YA(330, 1720, 0.84, [{ t: 0, mode: "peel", eyes: "normal", mouth: "smile" }, { t: vo("yai", 0) - 0.3, mode: "sitTalk", eyes: "normal", mouth: "flat" }, { t: vo("yai", 1), mode: "sitTalk", eyes: "squint", mouth: "flat", look: 6 }, { t: F("yai", 1, 2), mode: "sitTalk", eyes: "worry", mouth: "flat" }, { t: vo("yai", 2) + 0.3, mode: "sitTalk", eyes: "squint", mouth: "flat", look: 8 }, { t: vo("yai", 3) - 0.15, mode: "sitTalk", eyes: "worry", mouth: "flat" }], { prop: "cleaver" }),
          TG(650, 1700, 0.68, [{ t: 0, mode: "idle", eyes: "normal", mouth: "smile" }, { t: F("yai", 1, 2), mode: "listen", eyes: "wide", mouth: "o" }, { t: vo("yai", 2) - 0.2, mode: "idle", eyes: "squint", mouth: "smile", opts: { head: -6 } }, { t: vo("yai", 3), mode: "listen", eyes: "normal", mouth: "flat" }], { flip: true }),
          PW(880, 1710, 0.82, [{ t: 0, mode: "holdPhone", eyes: "squint", mouth: "flat" }, { t: F("yai", 1, 1), mode: "holdPhone", eyes: "normal", mouth: "flat", look: -10 }, { t: vo("yai", 2) + 0.4, mode: "holdPhone", eyes: "squint", mouth: "smile", look: 8 }], { flip: true, prop: "phone" })],
        captions: caps("yai", [0, 1, 2, 3], { quote: true }),
        react: [{ a: 1, t: F("yai", 1, 2) + 0.1, dur: 1.1 }],
        ui: [{ type: "signs", t: vo("yai", 0), items: ["ปลาพอง… <em>อย่าลอง</em>", "ตาเปิด แต่ไม่ขยับ… <em>อย่าทิ้ง</em>", "อยู่กับเขา… <em>จนกว่าตะวันจะขึ้น</em>"], icons: [ICN.fish, ICN.lung, PK_ICON.sun], ok: [1, 1, 1], at: [vo("yai", 0) + 0.2, F("yai", 1, 2) + 0.1, vo("yai", 3) + 0.1], end: D("yai") - 0.05, top: 150 }],
        fx(tl, id, t0, L) {
          put(L.set, STOOL(330, 1720)); put(L.set, Isle.COCONUT(250, 1560, 0.9, false));
          document.querySelectorAll(`#${id} .capbox`).forEach((c) => c.classList.add("q"));
          Fx.heart(tl, t0 + vo("yai", 1), D("yai") - vo("yai", 1), 0.8, 0.3);
        },
      });

      // ---------- 3. the boat: the island ahead, then ลุงนวล's method ("ย่างให้เกรียม กินได้") and "มารับก่อนมืด" ----------
      split("boat", 2.6, {
        set: "seaWide", setOpts: { id: "sw", storm: true }, dark: 0.12, blur: { far: 2 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(600, 1250, 0.98, 540, 960), drift: { s: 0.03 } }] },
        shake: (t) => 3 * Math.sin(t * 1.9),
        fx(tl, id, t0, L) {
          tl.fromTo("#sw-boat", { x: 0, y: 0 }, { x: 640, duration: 2.6, ease: "none", immediateRender: false }, t0);
          tl.fromTo("#sw-boat", { y: 0 }, { y: -14, duration: 0.9, yoyo: true, repeat: 3, ease: "sine.inOut", immediateRender: false }, t0);
          put(L.glow, `<g id="sw-sign" opacity="0"><rect x="300" y="1560" width="480" height="70" rx="10" fill="#f4ecd8" stroke="#2e2a26" stroke-width="4"/><text x="540" y="1610" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="40" fill="#c8392b">ห่างฝั่ง 3 กม.</text></g>`);
          tl.fromTo("#sw-sign", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.3, immediateRender: false }, t0 + 0.9);
        },
      }, {
        set: "boatIn", setOpts: { id: "bi", storm: true }, dark: 0.14, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(540, 1420, 1.0, 540, 960), drift: { s: 0.015 } }] },
        shake: (t) => 4 * Math.sin(t * 1.7) + 2 * Math.sin(t * 4.1),
        actors: [NU(640, 1440, 0.76, [{ t: 0, mode: "steer", eyes: "normal", mouth: "smile" }, { t: VA("boat", 2.6, 1) - 0.2, mode: "steer", eyes: "squint", mouth: "smileOpen" }, { t: VA("boat", 2.6, 2) - 0.2, mode: "point", eyes: "normal", mouth: "smile" }]),
          TG(330, 1750, 0.7, [{ t: 0, mode: "sitChair", eyes: "normal", mouth: "smile" }, { t: VA("boat", 2.6, 0) - 0.2, mode: "sitChair", eyes: "normal", mouth: "flat", look: 10 }, { t: VA("boat", 2.6, 1), mode: "sitChair", eyes: "wide", mouth: "smile", look: 10 }]),
          PW(830, 1770, 0.84, [{ t: 0, mode: "sitChair", eyes: "squint", mouth: "flat" }, { t: VA("boat", 2.6, 1) + 1.0, mode: "sitChair", eyes: "normal", mouth: "frown", look: -8 }], { flip: true, prop: "phone" })],
        bubbles: [bubAt(bub("boat", 0, 330, 560, 330, { br: true, end: vo("boat", 1) - 0.05 }), 2.6, D("boat")), bubAt(bub("boat", 1, 600, 500, 640, { br: true, end: vo("boat", 2) - 0.05 }), 2.6, D("boat")), bubAt(bub("boat", 2, 640, 560, 640, { br: true }), 2.6, D("boat"))],
        fx(tl, id, t0, L) { put(L.act, `<g transform="translate(560,1760)">${Isle.PHONE("", 0, 0, 0.001)}</g>`); Fx.heart(tl, t0 + VA("boat", 2.6, 1), 3, 0.9, 0.25); },
      });

      // ---------- 4. stranded: the squall takes the sky, no boat, no signal; โต้ง is thrilled ----------
      split("stranded", vo("stranded", 1) - 0.3, {
        set: "beach", setOpts: { id: "st", time: "dusk", washY: 1800 }, dark: 0.3, blur: { far: 3, mid: 2 }, life: { bolts: [0.35, 1.7] },
        cam: { keys: [{ t: 0, ...fr(560, 1200, 0.9, 540, 940), drift: { s: 0.02 } }] },
        shake: (t) => 2 * Math.sin(t * 2.7),
        actors: [TG(430, 1650, 0.68, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: 0.5, mode: "lookUp", eyes: "wide", mouth: "o" }]), PW(600, 1670, 0.82, [{ t: 0, mode: "phoneUp", eyes: "squint", mouth: "flat" }], { prop: "phone" })],
        captions: capsAt("stranded", 0, vo("stranded", 1) - 0.3, [0]),
        fx(tl, id, t0, L) { tl.fromTo("#st-wash", { y: 0 }, { y: -110, duration: 2.6, yoyo: true, repeat: 2, ease: "sine.inOut", immediateRender: false }, t0); Fx.heart(tl, t0, D("stranded"), 0.75, 0.35); },
      }, {
        set: "beach", setOpts: { id: "st2", time: "dusk", washY: 1800 }, dark: 0.34, blur: { far: 4, mid: 3 }, life: { bolts: [2.6] },
        cam: { keys: [{ t: 0, ...fr(640, 1450, 1.6, 540, 940), drift: { s: 0.02 } }] },
        actors: [TG(430, 1650, 0.68, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat", look: 8 }, { t: VA("stranded", vo("stranded", 1) - 0.3, 2) - 0.3, mode: "raise", eyes: "wide", mouth: "smileOpen" }]),
          PW(640, 1670, 0.82, [{ t: 0, mode: "phoneUp", eyes: "squint", mouth: "flat" }, { t: 1.2, mode: "holdPhone", eyes: "sad", mouth: "frown" }], { prop: "phone" })],
        bubbles: [bubAt(bub("stranded", 1, 400, 500, 560, { br: true }), vo("stranded", 1) - 0.3, D("stranded")), bubAt(bub("stranded", 2, 430, 560, 430, { br: true }), vo("stranded", 1) - 0.3, D("stranded"))],
        react: [{ a: 0, t: VA("stranded", vo("stranded", 1) - 0.3, 2) + 0.2, dur: 1.3 }],
        fx(tl, id, t0, L) {
          const a = vo("stranded", 1) - 0.3, T = t0 + VA("stranded", a, 1);
          put(L.act, Isle.PHONE("st2-ph", 880, 1420, 1.0, -8)); const pw = wrapEl("#st2-ph"); tl.set(pw, { opacity: 0 }, t0); tl.fromTo(pw, { opacity: 0, scale: 0.8, transformOrigin: "880px 1420px" }, { opacity: 1, scale: 1, duration: 0.25, immediateRender: false }, T + 0.1); tl.to(pw, { opacity: 0, duration: 0.2, immediateRender: false }, T + 2.6);
          Fx.heart(tl, t0, D("stranded") - a, 0.75, 0.35);
        },
      });

      // ---------- 5. the survival montage: fire, water, shelter, all by the book; then the checklist with one line still open ----------
      split3("survive", 1.15, 2.3, {
        set: "beach", setOpts: { id: "sv", time: "dusk", fire: true, fireX: 560, fireY: 1600, washY: 1820 }, dark: 0.36, blur: { far: 5, mid: 3 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(500, 1480, 1.6, 540, 1000), drift: { s: 0.04 } }] },
        actors: [TG(390, 1650, 0.68, [{ t: 0, mode: "fireBlow", eyes: "squint", mouth: "o" }], { prop: "lighter" })],
        fx(tl, id, t0, L) { tl.set("#sv-fire-fl", { opacity: 0 }, t0); tl.fromTo("#sv-fire-fl", { opacity: 0, scale: 0.3 }, { opacity: 1, scale: 1, duration: 0.5, transformOrigin: "50% 100%", immediateRender: false }, t0 + 0.55); Fx.punch(tl, `#${id} .stage`, t0 + 0.6, 1.04, 0.3); },
      }, {
        set: "beach", setOpts: { id: "sv2", time: "dusk", fire: true, fireX: 560, fireY: 1600, washY: 1820 }, dark: 0.38, blur: { far: 5, mid: 3 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(560, 1420, 1.7, 540, 980), drift: { s: 0.04 } }] },
        actors: [TG(560, 1660, 0.68, [{ t: 0, mode: "drinkCoco", eyes: "closed", mouth: "o" }], { prop: "coconutS" })],
        fx(tl, id, t0, L) { put(L.set, Isle.COCONUT(700, 1690, 0.8, false)); put(L.set, Isle.COCONUT(640, 1720, 0.7, false)); },
      }, {
        set: "beach", setOpts: { id: "sv3", time: "dusk", fire: true, fireX: 560, fireY: 1600, shelter: true, washY: 1820 }, dark: 0.4, blur: { far: 5, mid: 3 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(700, 1350, 1.05, 540, 940), drift: { s: 0.015 } }] },
        actors: [TG(600, 1660, 0.68, [{ t: 0, mode: "carry", eyes: "normal", mouth: "smile" }, { t: 0.9, mode: "idle", eyes: "normal", mouth: "smileOpen" }, { t: VA("survive", 2.3, 0), mode: "shrug", eyes: "normal", mouth: "smileOpen" }], { moveTo: { x: 760, dur: 0.9, ease: "none" } }),
          PW(300, 1680, 0.82, [{ t: 0, mode: "hugKnees", eyes: "squint", mouth: "flat" }], { flip: true })],
        bubbles: [bubAt(bub("survive", 0, 760, 540, 760, { br: true }), 2.3, D("survive"))],
        ui: [{ type: "signs", t: 0.05, items: ["ไฟ", "น้ำ", "ที่นอน", "อาหาร… ?"], icons: [ICN.fire, ICN.water, ICN.bed, ICN.food], ok: [1, 1, 1, 0], q: [0, 0, 0, 1], at: [0.1, 0.4, 0.9, VA("survive", 2.3, 0) + 1.0], end: D("survive") - 2.3 - 0.05, top: 130 }],
        fx(tl, id, t0, L) { tl.set("#sv3-shelter", { opacity: 0 }, t0); tl.fromTo("#sv3-shelter", { opacity: 0 }, { opacity: 1, duration: 0.3, immediateRender: false }, t0 + 0.75); Fx.heart(tl, t0 + VA("survive", 2.3, 0), 3, 0.8, 0.3); },
      });

      // ---------- 6. the fish: it swims to him; the balloon; the photo; ยาย's rule against ลุงนวล's method ----------
      split3("fish", vo("fish", 2) - 0.15, vo("fish", 3) - 0.15, {
        set: "pool", setOpts: { id: "fs", time: "dusk", puff: 0, puffX: 560, puffY: 640, puffS: 0.9 }, dark: 0.22, blur: { far: 4 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(540, 1060, 1.0, 540, 960), drift: { s: 0.02 } }, { t: vo("fish", 1) - 0.2, glide: 0.5, ...fr(540, 1180, 1.25, 540, 940), drift: { s: 0.03 } }] },
        shake: (t) => 2.5 * Math.sin(t * 2.4) + 1.2 * Math.sin(t * 6.3),
        bubbles: [bub("fish", 0, 540, 420, 540, { up: true }), bub("fish", 1, 540, 440, 540, { up: true })],
        fx(tl, id, t0, L) {
          put(L.act, `<g id="fs-hands" transform="translate(540,2260) scale(1.25)">${CUPHANDS()}</g>`);
          const fw = wrapEl("#fs-puffg"), hw = wrapEl("#fs-hands");
          tl.fromTo(fw, { y: 0, x: 0 }, { y: 560, x: -30, duration: 1.7, ease: "sine.inOut", immediateRender: false }, t0 + 0.1);   // it comes straight to him
          tl.fromTo(hw, { y: 0 }, { y: -720, duration: 0.7, ease: "power2.out", immediateRender: false }, t0 + 1.6);                // the hands come up under it
          tl.to(fw, { y: 690, duration: 0.5, ease: "power2.out", immediateRender: false }, t0 + 1.9);
          Isle.puff(tl, "fs-puff", t0 + vo("fish", 1) + 0.05, 0.45);
          Fx.punch(tl, `#${id} .stage`, t0 + vo("fish", 1) + 0.1, 1.06, 0.4);
          Fx.heart(tl, t0, D("fish"), 0.7, 0.35);
        },
      }, {
        set: "beach", setOpts: { id: "fs2", time: "dusk", fire: true, fireX: 560, fireY: 1600, shelter: true, pool: true, washY: 1840 }, dark: 0.4, blur: { far: 5, mid: 3 },
        cam: { keys: [{ t: 0, ...fr(560, 1420, 1.45, 540, 980), drift: { s: 0.02 } }] },
        actors: [TG(420, 1660, 0.68, [{ t: 0, mode: "holdBall", eyes: "wide", mouth: "smileOpen" }], { prop: "puffball" }), PW(760, 1680, 0.82, [{ t: 0, mode: "holdPhone", eyes: "normal", mouth: "smile" }], { flip: true, prop: "phone" })],
        bubbles: [bubAt(bub("fish", 2, 760, 520, 760, { br: true }), vo("fish", 2) - 0.15, vo("fish", 3) - 0.15)],
        fx(tl, id, t0, L) { const T = t0 + VA("fish", vo("fish", 2) - 0.15, 2) + 0.9; tl.fromTo("#flashw", { opacity: 0.9 }, { opacity: 0, duration: 0.3, immediateRender: false }, T); },
      }, {
        set: "beach", setOpts: { id: "fs3", time: "dusk", fire: true, fireX: 560, fireY: 1600, shelter: true, pool: true, washY: 1840 }, dark: 0.42, blur: { far: 5, mid: 3 },
        cam: { keys: [{ t: 0, ...fr(580, 1420, 1.35, 540, 980), drift: { s: 0.02 } }] },
        actors: [TG(420, 1660, 0.68, [{ t: 0, mode: "holdBall", eyes: "normal", mouth: "flat", look: -6 }, { t: VA("fish", vo("fish", 3) - 0.15, 4) - 0.1, mode: "holdBall", eyes: "squint", mouth: "smile" }], { prop: "puffball" }),
          PW(760, 1680, 0.82, [{ t: 0, mode: "point", eyes: "squint", mouth: "flat" }, { t: VA("fish", vo("fish", 3) - 0.15, 4), mode: "armsCrossed", eyes: "squint", mouth: "frown" }], { flip: true })],
        bubbles: [bubAt(bub("fish", 3, 700, 520, 760, { br: true, end: vo("fish", 4) - 0.05 }), vo("fish", 3) - 0.15, D("fish")), bubAt(bub("fish", 4, 460, 520, 420, { br: true }), vo("fish", 3) - 0.15, D("fish"))],
        react: [{ a: 0, t: VA("fish", vo("fish", 3) - 0.15, 4) + 1.4, dur: 1.2 }],
        fx(tl, id, t0, L) { Fx.heart(tl, t0, D("fish") - (vo("fish", 3) - 0.15), 0.7, 0.4); },
      });

      // ---------- 7. the grill: the viewer is told first ("พิษไม่กลัวไฟ"), then the first bite, "อร่อยเหมือนไก่" ----------
      add("grill", {
        set: "beach", setOpts: { id: "gr", time: "night", fire: true, fireX: 560, fireY: 1600, shelter: true, washY: 1840 }, dark: 0.5, blur: { far: 6, mid: 4 },
        cam: { keys: [{ t: 0, ...fr(520, 1450, 1.5, 540, 980), drift: { s: 0.025 } }, { t: vo("grill", 1) - 0.2, ...fr(430, 1420, 2.2, 540, 940), drift: { s: 0.03 } }, { t: vo("grill", 2) - 0.15, ...fr(760, 1440, 2.0, 540, 940), drift: { s: 0.02 } }] },
        actors: [TG(430, 1660, 0.68, [{ t: 0, mode: "grill", eyes: "normal", mouth: "smile" }, { t: vo("grill", 1) - 0.4, mode: "eatStick", eyes: "closed", mouth: "smileOpen" }, { t: vo("grill", 1) + 0.8, mode: "eatStick", eyes: "normal", mouth: "smile" }], { prop: "stickfish", cu: false }),
          PW(800, 1690, 0.82, [{ t: 0, mode: "hugKnees", eyes: "squint", mouth: "flat" }, { t: vo("grill", 2) - 0.2, mode: "hugKnees", eyes: "squint", mouth: "frown", look: -8 }], { flip: true, cu: false })],
        captions: caps("grill", [0]),
        bubbles: [bub("grill", 1, 430, 520, 430), bub("grill", 2, 760, 520, 760)],
        ui: [{ type: "signs", t: F("grill", 0, 1), items: ["ย่างจนเกรียม… <em>พิษก็ยังอยู่</em>"], icons: [ICN.fish], ok: [0], at: [F("grill", 0, 1)], end: vo("grill", 1) - 0.2, top: 150 }],
        fx(tl, id, t0, L) { Fx.heart(tl, t0, D("grill"), 0.7, 0.45); red(tl, t0 + F("grill", 0, 1), 0.3, 0.5); },
      });

      // ---------- 8. the wait: twenty minutes of nothing; the numb lip; the stick he cannot hold; the poison climbs ----------
      add("wait", {
        set: "beach", setOpts: { id: "wt", time: "night", fire: true, fireX: 560, fireY: 1600, shelter: true, washY: 1840 }, dark: 0.52, blur: { far: 6, mid: 4 },
        cam: { keys: [{ t: 0, ...fr(560, 1440, 1.4, 540, 980), drift: { s: 0.02 } }, { t: vo("wait", 1) - 0.3, glide: 0.8, ...fr(440, 1430, 2.1, 540, 940), drift: { s: 0.03 } }, { t: vo("wait", 2) - 0.1, ...fr(780, 1450, 2.0, 540, 940) }, { t: vo("wait", 3) - 0.3, ...fr(450, 1480, 1.9, 540, 980), drift: { s: 0.03 } }, { t: vo("wait", 4) + 0.2, glide: 2.5, ...fr(440, 1400, 3.0, 540, 900), drift: { s: 0.04 } }] },
        actors: [TG(440, 1670, 0.68, [{ t: 0, mode: "sit", eyes: "normal", mouth: "smile" }, { t: vo("wait", 1) - 0.4, mode: "numbLip", eyes: "worry", mouth: "flat" }, { t: vo("wait", 3) - 0.4, mode: "dropStick", eyes: "wide", mouth: "o" }, { t: vo("wait", 4) + 0.2, mode: "sit", eyes: "wide", mouth: "o", opts: {} }], { cu: false, prop: "stickfish" }),
          PW(800, 1690, 0.82, [{ t: 0, mode: "hugKnees", eyes: "squint", mouth: "flat" }, { t: vo("wait", 2) - 0.2, mode: "hugKnees", eyes: "squint", mouth: "smile", look: -8 }, { t: vo("wait", 3) + 0.3, mode: "hugKnees", eyes: "normal", mouth: "flat", look: -10 }], { flip: true, cu: false })],
        captions: caps("wait", [0, 4]),
        bubbles: [bub("wait", 1, 440, 520, 440, { br: true }), bub("wait", 2, 780, 540, 780), bub("wait", 3, 450, 560, 450)],
        ui: [{ type: "counter", t: vo("wait", 0) - 0.1, end: vo("wait", 1) + 1.2, label: "ผ่านไปแล้ว", icon: "clock", unit: "นาที", keys: [{ t: vo("wait", 0), v: 0 }, { t: vo("wait", 0) + 1.9, v: 20 }], right: true, top: 150 }],
        fx(tl, id, t0, L) {
          // the stick leaves his hand at "พี่…": the prop vanishes, a loose one falls to the sand
          const T = t0 + vo("wait", 3) + 0.15; tl.set(`#${id}-a0-handF`, { opacity: 0.001 }, T);
          put(L.act, `<g id="wt-stk" opacity="0" transform="translate(470,1500)">${Isle.STICKFISH(0, 0, 0.42, -80)}</g>`); const sw = wrapEl("#wt-stk"); tl.set("#wt-stk", { opacity: 1 }, T);
          tl.to(sw, { y: 160, rotation: 70, duration: 0.45, ease: "power2.in", transformOrigin: "470px 1500px", immediateRender: false }, T);
          Fx.desat(tl, `#${id} .stage`, t0 + vo("wait", 4), t0 + D("wait"), 0.45);
          Fx.heart(tl, t0, vo("wait", 1), 0.9, 0.3); Fx.heart(tl, t0 + vo("wait", 1), D("wait") - vo("wait", 1), 0.55, 0.65);
          Fx.tunnel(tl, t0 + vo("wait", 4), t0 + D("wait"), 0.5);
        },
      });

      // ---------- 9. still: he tips over, eyes open, nothing moves; inside his head; she listens, hears nothing, says it, and draws the blanket over his face ----------
      const ST2 = vo("still", 1) - 0.25, ST3 = vo("still", 4) - 0.45, CLX = 215, CLY = 1660;   // CLX/CLY: where his head lies (feet at 520, the lying rig points left ~300 px at s 0.68)
      split3("still", ST2, ST3, {
        set: "beach", setOpts: { id: "pa", time: "night", fire: true, fireX: 560, fireY: 1600, shelter: true, washY: 1840 }, dark: 0.55, blur: { far: 7, mid: 5 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(470, 1500, 1.35, 540, 1000), drift: { s: 0.03 } }] },
        shake: (t) => 3.5 * Math.sin(t * 9.3) + 2 * Math.sin(t * 17),
        actors: [TG(520, 1700, 0.68, [{ t: 0, mode: "slumpSide", eyes: "wide", mouth: "o" }, { t: 0.65, mode: "lieStill", eyes: "wide", mouth: "o", blend: 0.3 }], { ...NOBLINK, cu: false }),
          PW(760, 1700, 0.82, [{ t: 0, mode: "run", eyes: "wide", mouth: "scream" }, { t: 0.4, mode: "kneelOver", eyes: "wide", mouth: "scream", opts: { shake: true } }], { flip: true, moveTo: { x: 330, dur: 0.55, ease: "power1.out" }, cu: false })],
        bubbles: [bub("still", 0, 520, 520, 420)],
        fx(tl, id, t0, L) { Fx.punch(tl, `#${id} .stage`, t0 + 0.05, 1.08, 0.4); Fx.heart(tl, t0, ST2, 0.48, 0.8); },
      }, {
        set: "lieDown", setOpts: { id: "pa2", moonX: 880, moonY: 1120 }, dark: 0.42, cu: false,
        cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960), drift: { s: 0.02 } }, { t: VA("still", vo("still", 1) - 0.25, 3) - 0.3, glide: 1.0, ...fr(540, 880, 1.15, 540, 960), drift: { s: 0.03 } }] },
        shake: (t) => 1.2 * Math.sin(t * 2.1),
        actors: [OVER([{ t: 0, mode: "overMeShake", eyes: "wide", mouth: "o" }, { t: 1.0, mode: "overMe", eyes: "worry", mouth: "flat", opts: { head: 12 } }, { t: VA("still", vo("still", 1) - 0.25, 3) - 0.4, mode: "overMe", eyes: "sad", mouth: "frown", opts: { head: 14 } }])],
        captions: capsAt("still", ST2, ST3, [1, 2]),
        bubbles: [bubAt(bub("still", 3, 540, 1180, 540, { up: true }), ST2, ST3)],
        fx(tl, id, t0, L) {
          const a = ST2, nI = capsAt("still", a, ST3, [1]).length;
          document.querySelectorAll(`#${id} .capbox`).forEach((c, i) => { if (i < nI) c.classList.add("inner"); });
          tl.fromTo("#pa2-blur", { opacity: 0 }, { opacity: 1, duration: 0.6, yoyo: true, repeat: 5, immediateRender: false }, t0 + 0.2);
          // tears: from her eyes (upside-down above us) down onto the lens
          [[500, 700, 0.2], [585, 700, 1.1], [512, 700, 2.0]].forEach(([x, y, d]) => { const T = t0 + VA("still", a, 3) + d; put(L.act, `<g class="tear" opacity="0"><path d="M0,0q-9,-16 0,-30q9,14 0,30z" fill="#dff4ff" stroke="#2e2a26" stroke-width="2"/></g>`); const el = L.act.lastElementChild;
            tl.set(el, { opacity: 1, x, y, scale: 0.6 }, T); tl.to(el, { y: y + 560, scale: 2.6, duration: 0.55, ease: "power1.in", immediateRender: false }, T); tl.set(el, { opacity: 0 }, T + 0.55);
            tl.fromTo("#pa2-blur", { opacity: 0 }, { opacity: 1, duration: 0.15, immediateRender: false }, T + 0.5); tl.to("#pa2-blur", { opacity: 0, duration: 1.0, immediateRender: false }, T + 0.7); });
          const X = t0 + FA("still", a, 2, 3); Fx.punch(tl, `#${id} .stage`, X, 1.06, 0.5); red(tl, X, 0.45, 0.7);
          Fx.heart(tl, t0, ST3 - a, 0.5, 0.8);
        },
      }, {
        set: "beach", setOpts: { id: "st3", time: "night", fire: true, fireX: 560, fireY: 1600, shelter: true, washY: 1840 }, dark: 0.55, blur: { far: 7, mid: 5 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(300, 1640, 2.1, 540, 1000), drift: { s: 0.02 } }, { t: VA("still", ST3, 4) + 1.1, glide: 0.8, ...fr(380, 1600, 1.6, 540, 960), drift: { s: 0.02 } }] },
        actors: [TG(520, 1700, 0.68, [{ t: 0, mode: "lieStill", eyes: "wide", mouth: "o" }], { ...NOBLINK, cu: false }),
          PW(330, 1700, 0.82, [{ t: 0, mode: "earChest", eyes: "closed", mouth: "flat" }, { t: VA("still", ST3, 4) - 0.35, mode: "kneelOver", eyes: "sad", mouth: "frown" }, { t: VA("still", ST3, 4) + 1.15, mode: "kneelWatch", eyes: "closed", mouth: "frown" }, { t: VA("still", ST3, 4) + 2.0, mode: "kneelCry", eyes: "closed", mouth: "frown" }], { flip: true, cu: false })],
        bubbles: [bubAt(bub("still", 4, 560, 560, 420), ST3, D("still"))],
        fx(tl, id, t0, L) {
          // the blanket drawn up from his chest over his face once she has said it
          put(L.act, `<g id="st3-cl" opacity="0">${Isle.CLOTH(0, 0, 0.85)}</g>`);
          const C = t0 + VA("still", ST3, 4) + 1.15;
          tl.set("#st3-cl", { opacity: 1, x: CLX, y: CLY + 150, scaleY: 0.55 }, C); tl.to("#st3-cl", { y: CLY, scaleY: 1, duration: 0.7, ease: "power1.inOut", immediateRender: false }, C);
          Fx.heart(tl, t0, D("still") - ST3, 0.5, 0.75);
        },
      });

      // ---------- 10. the cloth: from inside his head, the blanket comes down over the eyes he cannot close ----------
      add("cloth", {
        set: "lieDown", setOpts: { id: "cl", moonX: 880, moonY: 1120 }, dark: 0.42, cu: false,
        cam: { keys: [{ t: 0, ...fr(540, 920, 1.08, 540, 960), drift: { s: 0.02 } }] },
        actors: [OVER([{ t: 0, mode: "overMe", eyes: "sad", mouth: "frown", opts: { head: 14 } }])],
        captions: caps("cloth"),
        fx(tl, id, t0, L) {
          document.querySelectorAll(`#${id} .capbox`).forEach((c) => c.classList.add("inner"));
          tl.set("#cl-cloth", { opacity: 1 }, t0); tl.fromTo("#cl-clothg", { y: 0 }, { y: 2100, duration: 1.1, ease: "power2.in", immediateRender: false }, t0 + 0.1);
          tl.fromTo("#cl-leak", { opacity: 0.1 }, { opacity: 0.28, duration: 1.1, yoyo: true, repeat: 3, ease: "sine.inOut", immediateRender: false }, t0 + 1.3);
          Fx.heart(tl, t0, D("cloth"), 0.45, 0.85);
        },
      });

      // ---------- 11. the rule: beside the covered boy her grandmother's words come back; she uncovers him — his eyes are on her, a tear; a breath, then none; no antidote: breathe for him ----------
      const RU2 = vo("rule", 1) - 0.5, RU3 = vo("rule", 2) - 0.3, EYEX = CLX + 20, EYEY = CLY - 8;
      split3("rule", RU2, RU3, {
        set: "beach", setOpts: { id: "ru", time: "night", fire: true, fireX: 560, fireY: 1600, shelter: true, washY: 1840 }, dark: 0.6, blur: { far: 7, mid: 5 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(460, 1440, 1.1, 540, 960), drift: { s: 0.012 } }, { t: RU2 - 0.3, glide: RU2 - 0.6, ...fr(400, 1540, 1.55, 540, 940), drift: { s: 0.02 } }] },
        actors: [TG(520, 1700, 0.68, [{ t: 0, mode: "lieStill", eyes: "wide", mouth: "o" }], { ...NOBLINK, cu: false }),
          PW(400, 1700, 0.82, [{ t: 0, mode: "hugKnees", eyes: "closed", mouth: "frown" }, { t: vo("rule", 0) + 0.4, mode: "hugKnees", eyes: "sad", mouth: "frown", look: -12 }, { t: vo("rule", 0) + 2.6, mode: "kneelSlump", eyes: "wide", mouth: "o" }], { flip: true, cu: false })],
        captions: capsAt("rule", 0, RU2, [0], { quote: true }),
        fx(tl, id, t0, L) {
          put(L.act, `<g id="ru-cl">${Isle.CLOTH(CLX, CLY, 0.85)}</g>`);
          document.querySelectorAll(`#${id} .capbox`).forEach((c) => c.classList.add("mem"));
          Fx.heart(tl, t0, RU2, 0.55, 0.6);
        },
      }, {
        set: "beach", setOpts: { id: "ru2", time: "night", fire: true, fireX: 560, fireY: 1600, shelter: true, washY: 1840 }, dark: 0.5, blur: { far: 7, mid: 5 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(290, 1640, 2.3, 540, 980), drift: { s: 0.02 } }] },
        actors: [TG(520, 1700, 0.68, [{ t: 0, mode: "lieStill", eyes: "wide", mouth: "o" }], { ...NOBLINK, cu: false }),
          PW(330, 1700, 0.82, [{ t: 0, mode: "kneelWatch", eyes: "wide", mouth: "o" }, { t: 0.8, mode: "kneelOver", eyes: "sad", mouth: "o" }], { flip: true, cu: false })],
        bubbles: [bubAt(bub("rule", 1, 560, 560, 420), RU2, RU3)],
        fx(tl, id, t0, L) {
          // the blanket pulled back; a tear from the eye that cannot blink
          put(L.act, `<g id="ru2-cl">${Isle.CLOTH(0, 0, 0.85)}</g>`);
          tl.set("#ru2-cl", { x: CLX, y: CLY }, t0); tl.to("#ru2-cl", { x: CLX + 170, y: CLY + 150, rotation: 25, opacity: 0, duration: 0.6, ease: "power1.in", immediateRender: false }, t0 + 0.15);
          put(L.act, `<g class="tear2" opacity="0"><path d="M0,0q-5,-9 0,-17q5,8 0,17z" fill="#dff4ff" stroke="#2e2a26" stroke-width="2"/></g>`); const el = L.act.lastElementChild;
          tl.set(el, { opacity: 1, x: EYEX, y: EYEY }, t0 + 1.0); tl.to(el, { x: EYEX - 24, y: EYEY + 26, duration: 1.4, ease: "power1.in", immediateRender: false }, t0 + 1.0);
          Fx.heart(tl, t0, RU3 - RU2, 0.5, 0.7);
        },
      }, {
        set: "beach", setOpts: { id: "ru3", time: "night", fire: true, fireX: 560, fireY: 1600, shelter: true, washY: 1840 }, dark: 0.5, blur: { far: 7, mid: 5 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(360, 1580, 1.7, 540, 960), drift: { s: 0.02 } }] },
        actors: [TG(520, 1700, 0.68, [{ t: 0, mode: "lieStill", eyes: "wide", mouth: "o" }], { ...NOBLINK, cu: false }),
          PW(330, 1700, 0.82, [{ t: 0, mode: "earChest", eyes: "closed", mouth: "flat" }, { t: FA("rule", RU3, 2, 1) + 0.1, mode: "kneelOver", eyes: "wide", mouth: "o" }, { t: FA("rule", RU3, 2, 2) + 0.2, mode: "breathe", eyes: "closed", mouth: "o", opts: { period: 1.6, n: 3, t0: 0 } }], { flip: true, cu: false })],
        captions: capsAt("rule", RU3, D("rule"), [2]),
        ui: [{ type: "counter", t: 0.1, end: FA("rule", RU3, 2, 1) + 0.4, label: "ลมหายใจ", icon: "lung", unit: "ครั้ง/นาที", keys: [{ t: 0.2, v: 6 }, { t: 0.9, v: 3 }, { t: FA("rule", RU3, 2, 0) - 0.3, v: 0 }], alarm: FA("rule", RU3, 2, 0) - 0.3, right: true, top: 150 }],
        fx(tl, id, t0, L) { red(tl, t0 + FA("rule", RU3, 2, 0) - 0.3, 0.4, 0.8); Fx.heart(tl, t0, D("rule") - RU3, 0.5, 0.75); },
      });

      // ---------- 12. the safety card: heat does nothing, gutting does nothing; numb lips → 1669; not breathing → 2 breaths, 30 compressions ----------
      add("card", {
        set: "beach", setOpts: { id: "cd", time: "night", fire: true, fireX: 560, fireY: 1600, washY: 1840 }, dark: 0.66, blur: { far: 10, mid: 8, set: 8 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(600, 1300, 0.9, 540, 960), drift: { s: 0.01 } }] },
        captions: caps("card"),
        ui: [{ type: "signs", t: 0.1, items: ["ต้ม ทอด ย่าง ตากแห้ง → <em>พิษไม่หาย</em>", "ควักไส้ ลอกหนัง → <em>ก็ไม่ปลอดภัย</em>", "ชาปาก ชาลิ้น หลังกินปลา → โทร <em>1669</em> ทันที", "ไม่หายใจ → <em>เป่าปาก 2 กดอก 30</em> จนกู้ชีพมาถึง"], icons: [ICN.fish, ICN.knife, ICN.phone, ICN.lung], ok: [0, 0, 1, 1], at: [0.1, vo("card", 0) + 0.1, F("card", 0, 1), F("card", 0, 3)], end: D("card") - 0.05, top: 150 }],
        fx(tl, id, t0) { Fx.heart(tl, t0, D("card"), 0.8, 0.3); },
      });

      // ---------- 12. the night: her hand on his chest counting; the breaths she gives when the count hits nothing; the moon crosses ----------
      add("night", {
        set: "beach", setOpts: { id: "nt", time: "night", fire: true, fireX: 560, fireY: 1600, shelter: true, washY: 1840, moonX: 1000, moonY: 260 }, dark: 0.58, blur: { far: 7, mid: 5 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(420, 1480, 1.3, 540, 980), drift: { s: 0.012 } }, { t: 2.0, glide: 1.2, ...fr(380, 1560, 1.9, 540, 1000), drift: { s: 0.02 } }, { t: 5.8, ...fr(520, 1380, 1.0, 540, 940), drift: { s: 0.015 } }] },
        actors: [TG(520, 1700, 0.68, [{ t: 0, mode: "lieStill", eyes: "wide", mouth: "o" }], { ...NOBLINK, cu: false }),
          PW(330, 1700, 0.82, [{ t: 0, mode: "kneelWatch", eyes: "worry", mouth: "flat" }, { t: 2.1, mode: "breathe", eyes: "closed", mouth: "o", opts: { period: 1.5, n: 2, t0: 0 } }, { t: 3.9, mode: "compress", eyes: "worry", mouth: "grit", opts: { period: 0.5, n: 6, t0: 0 } }, { t: 5.8, mode: "kneelWatch", eyes: "worry", mouth: "flat" }, { t: 6.7, mode: "breathe", eyes: "closed", mouth: "o", opts: { period: 1.5, n: 1, t0: 0 } }], { flip: true, cu: false })],
        captions: caps("night"),
        ui: [{ type: "counter", t: 0.1, end: D("night") - 0.05, label: "ลมหายใจ", icon: "lung", unit: "ครั้ง/นาที", keys: [{ t: 0.2, v: 14 }, { t: 1.3, v: 9 }, { t: 2.0, v: 0 }, { t: 3.3, v: 0 }, { t: 3.7, v: 6 }, { t: 5.8, v: 6 }, { t: 6.5, v: 0 }, { t: 7.6, v: 5 }], alarm: 2.0, right: true, top: 150 }],
        fx(tl, id, t0, L) {
          document.querySelectorAll(`#${id} .capbox`).forEach((c) => c.classList.add("inner"));
          tl.fromTo("#nt-moon", { x: 0 }, { x: -560, duration: D("night"), ease: "none", immediateRender: false }, t0);
          tl.fromTo("#nt-fire-fl", { scale: 1 }, { scale: 0.35, duration: D("night"), ease: "none", transformOrigin: "50% 100%", immediateRender: false }, t0);
          red(tl, t0 + 2.0, 0.4, 0.8); red(tl, t0 + 6.5, 0.35, 0.8);
          Fx.heart(tl, t0, D("night"), 0.52, 0.7);
        },
      });

      // ---------- 13. the channel line: his checklist, every box right but one ----------
      add("sig", {
        set: "beach", setOpts: { id: "sg", time: "night", fire: true, fireX: 560, fireY: 1600, washY: 1840 }, dark: 0.6, blur: { far: 10, set: 8, mid: 8 },
        cam: { keys: Sig.cam(F, fr(560, 1300, 0.85, 540, 960)) }, shake: Sig.shake(F),
        captions: caps("sig"),
        ui: [Sig.ui(F, "เอาตัวรอดแบบโต้ง · เช็กลิสต์", [["ก่อไฟ", true], ["หาน้ำ", true], ["ทำที่นอน", true], ["ปลาพอง… อย่าลอง", false]], D("sig"))],
      });

      // ---------- 14. dawn: a finger moves; the longtail; ลุงนวล sees what she is doing; "ลุงบอกว่ากินได้"; the stick by the dead fire ----------
      const DW2 = vo("dawn", 1) - 0.4, DW3 = vo("dawn", 2) - 0.3;
      split3("dawn", DW2, DW3, {
        set: "beach", setOpts: { id: "dw", time: "dawn", fire: "out", fireX: 560, fireY: 1600, shelter: true, washY: 1840 }, dark: 0.3, blur: { far: 5, mid: 3 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(360, 1560, 1.8, 540, 1020), drift: { s: 0.03 } }] },
        actors: [TG(520, 1700, 0.68, [{ t: 0, mode: "lieStill", eyes: "wide", mouth: "o" }, { t: 0.5, mode: "sitUpWeak", eyes: "closed", mouth: "flat", blend: 0.4 }, { t: 1.4, mode: "sitUpWeak", eyes: "normal", mouth: "flat" }], { blinks: [1.0, 1.3, 1.9], cu: false }),
          PW(330, 1700, 0.82, [{ t: 0, mode: "kneelSlump", eyes: "closed", mouth: "frown" }, { t: 0.9, mode: "kneelOver", eyes: "wide", mouth: "o" }, { t: 1.6, mode: "kneelOver", eyes: "normal", mouth: "smileOpen" }], { flip: true, cu: false })],
        bubbles: [bub("dawn", 0, 400, 560, 300)],
        react: [{ a: 1, t: 0.95, dur: 1.0, fast: true }],
        fx(tl, id, t0, L) { tl.fromTo(`#${id} .stage`, { opacity: 0.3 }, { opacity: 1, duration: 0.5, immediateRender: false }, t0); Fx.heart(tl, t0, 1.0, 0.5, 0.6); },
      }, {
        set: "beach", setOpts: { id: "dw2", time: "dawn", fire: "out", fireX: 560, fireY: 1600, shelter: true, washY: 1840 }, dark: 0.26, blur: { far: 3, mid: 2 },
        cam: { keys: [{ t: 0, ...fr(560, 1300, 0.9, 540, 940), drift: { s: 0.012 } }, { t: VA("dawn", DW2, 1) - 0.1, ...fr(600, 1460, 1.25, 540, 960), drift: { s: 0.02 } }] },
        actors: [TG(520, 1700, 0.68, [{ t: 0, mode: "sitWeak", eyes: "normal", mouth: "flat" }], { cu: false }),
          PW(330, 1700, 0.82, [{ t: 0, mode: "breathe", eyes: "closed", mouth: "o", opts: { period: 1.6, n: 1, t0: 0.1 } }, { t: 1.5, mode: "kneelOver", eyes: "normal", mouth: "flat" }], { flip: true, cu: false }),
          NU(1500, 1690, 0.88, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }, { t: 1.5, mode: "lampStand", eyes: "wide", mouth: "o" }, { t: VA("dawn", DW2, 1) - 0.2, mode: "lampStand", eyes: "worry", mouth: "flat" }], { flip: true, moveTo: { x: 720, dur: 1.5, ease: "power1.out" } })],
        bubbles: [bubAt(bub("dawn", 1, 640, 500, 840, { br: true }), DW2, DW3)],
        fx(tl, id, t0, L) {
          // the longtail nosing in while she is still breathing for him
          put(L.mid, `<g id="dw2-bt">${Isle.LONGTAIL("dw2-lt", 1900, 1330, 0.5, { canopy: false })}</g>`); tl.fromTo("#dw2-bt", { x: 0 }, { x: -520, duration: 1.6, ease: "power1.out", immediateRender: false }, t0);
          Fx.heart(tl, t0 + 1.0, DW3 - DW2 - 1.0, 0.7, 0.4);
        },
      }, {
        set: "beach", setOpts: { id: "dw3", time: "dawn", fire: "out", fireX: 560, fireY: 1600, shelter: true, washY: 1840 }, dark: 0.26, blur: { far: 3, mid: 2 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(440, 1520, 1.5, 540, 960), drift: { s: 0.015 } }, { t: VA("dawn", DW3, 2) + 1.6, glide: 0.9, ...fr(560, 1600, 2.0, 540, 1000), drift: { s: 0.02 } }] },
        actors: [TG(520, 1700, 0.68, [{ t: 0, mode: "sitWeak", eyes: "normal", mouth: "flat" }], { cu: false }),
          PW(330, 1700, 0.82, [{ t: 0, mode: "kneelOver", eyes: "normal", mouth: "flat", look: -14 }], { flip: true, cu: false }),
          NU(720, 1690, 0.88, [{ t: 0, mode: "lampStand", eyes: "worry", mouth: "flat" }, { t: VA("dawn", DW3, 2) + 0.9, mode: "lampStand", eyes: "sad", mouth: "flat", opts: { head: 18 } }], { flip: true, cu: false })],
        bubbles: [bubAt(bub("dawn", 2, 480, 520, 360), DW3, D("dawn"))],
        fx(tl, id, t0, L) { put(L.set, Isle.STICKFISH(680, 1600, 0.5, 70)); Fx.heart(tl, t0, D("dawn") - DW3, 0.6, 0.5); },
      });

      // ---------- 15. the boat home: wrapped in a blanket, he says the one thing; she looks at her hands, then back at the island ----------
      add("line", {
        set: "boatIn", setOpts: { id: "bh", time: "dawn", island: true, islandX: 200, islandS: 0.55, lamp: false }, dark: 0.3, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(560, 1500, 1.25, 540, 960), drift: { s: 0.015 } }, { t: F("line", 0, 2) - 0.2, glide: 0.8, ...fr(420, 1520, 1.9, 540, 940), drift: { s: 0.02 } }, { t: F("line", 0, 3) + 0.1, ...fr(820, 1540, 2.0, 540, 940), drift: { s: 0.03 } }, { t: D("line") - 1.25, ...fr(200, 900, 2.6, 540, 900), drift: { s: 0.03 } }] },
        shake: (t) => 3 * Math.sin(t * 1.6),
        actors: [NU(640, 1440, 0.76, [{ t: 0, mode: "steer", eyes: "normal", mouth: "flat" }], { cu: false }),
          TG(400, 1750, 0.7, [{ t: 0, mode: "sitWrapped", eyes: "sad", mouth: "flat" }, { t: F("line", 0, 1), mode: "sitWrapped", eyes: "sad", mouth: "flat", look: 12 }], { cu: false }),
          PW(830, 1770, 0.84, [{ t: 0, mode: "sitTired", eyes: "sad", mouth: "flat" }, { t: F("line", 0, 2), mode: "sitTired", eyes: "normal", mouth: "flat", look: 10 }, { t: F("line", 0, 3) + 0.1, mode: "think", eyes: "wide", mouth: "o" }, { t: F("line", 0, 3) + 1.6, mode: "sitTired", eyes: "wide", mouth: "flat", look: -14 }], { flip: true, cu: false })],
        bubbles: [bub("line", 0, 400, 500, 400, { br: true, end: D("line") - 1.3 })],   // gone before the hard cut to the island, so the last picture is clean
        react: [{ a: 2, t: F("line", 0, 3) + 0.15, dur: 1.0, fast: true }],
        fx(tl, id, t0, L) {
          put(L.act, `<g transform="translate(400,1750) scale(.7)"><path d="M-104,-420Q-124,-290 -96,-150Q0,-120 96,-150Q124,-290 104,-420Q70,-396 36,-440Q0,-416 -36,-440Q-70,-396 -104,-420Z" fill="#8a6a9a" stroke="#2e2a26" stroke-width="4"/><path d="M-92,-380q92,30 184,0M-88,-300q88,30 176,0M-86,-220q86,30 172,0" stroke="#6a4a7a" stroke-width="6" fill="none"/></g>`);
          const X = t0 + F("line", 0, 3); Fx.punch(tl, `#${id} .stage`, X, 1.05, 0.5); Fx.glitch(tl, `#${id}`, X + 0.1, 0.2, 10, 61); red(tl, X, 0.4, 0.8);
          Fx.heart(tl, t0 + F("line", 0, 1), D("line") - F("line", 0, 1), 0.55, 0.65);
          tl.set("#black", { opacity: 1 }, t0 + D("line") - 0.06);
        },
      });

      // ---------- 16. the choice ----------
      add("choice", {
        set: "beach", setOpts: { id: "ch", time: "night", fire: "out", fireX: 560, fireY: 1600, washY: 1840 }, dark: 0.75, blur: { far: 10, set: 8, mid: 8 }, cu: false,
        cam: { keys: [{ t: 0, ...fr(560, 1300, 0.85, 540, 960), drift: { s: 0.01 } }] },
        ui: [{ type: "choice", t: 0.05, q: "น้องหยุดหายใจ ไม่มีเรือ ไม่มีสัญญาณ… จะอยู่หายใจแทนเขาทั้งคืน หรือทิ้งเขาไว้ไปจุดไฟขอความช่วยเหลือ?", a: "อยู่หายใจแทนเขา", b: "ไปจุดไฟ", secs: 3, top: 300 }],
        fx(tl, id, t0) { tl.set("#black", { opacity: 0 }, t0 + 0.05); tl.set("#black", { opacity: 1 }, t0 + D("choice") - 0.05); Fx.heart(tl, t0, D("choice"), 0.6, 0.5); },
      });

      // ---------- the look: light sources per shot (the engine aims cast shadows and rim light from the strongest) ----------
      const SUNM = (L) => { Fence.light(L, 820, 420, 1100, "#ffe6b8", 0.34); Fence.haze(L, 860, 400, "#ffe6c8", 0.25); };
      const DUSKL = (L) => { Fence.light(L, 1100, 980, 900, "#ffb070", 0.3); Fence.haze(L, 1000, 420, "#f0a080", 0.2); };
      const FIREL = (L) => { Fence.light(L, 560, 1500, 620, "#ffb35c", 0.5, "lampf"); Fence.light(L, 760, 300, 500, "#cfe0f0", 0.16); };
      const FIRELAMP = (L) => { Fence.light(L, 560, 1500, 560, "#ffb35c", 0.42, "lampf"); Fence.light(L, 1000, 1500, 400, "#ffd890", 0.4, "lampf"); };
      const DAWNL = (L) => { Fence.light(L, 900, 1040, 1000, "#ffc080", 0.4); Fence.haze(L, 1000, 440, "#ffd0a0", 0.25); };
      const POVL = (L) => { Fence.light(L, 1180, 1900, 900, "#ffb35c", 0.35, "lampf"); };
      const LOOK = {
        "hook#0": (L) => { Fence.light(L, 300, 500, 800, "#ffd0a0", 0.3); }, "hook#1": POVL, yai: SUNM, "boat#0": SUNM, "boat#1": SUNM,
        "stranded#0": DUSKL, "stranded#1": DUSKL, "survive#0": (L) => { DUSKL(L); FIREL(L); }, "survive#1": (L) => { DUSKL(L); FIREL(L); }, "survive#2": (L) => { DUSKL(L); FIREL(L); },
        "fish#0": (L) => { Fence.light(L, 300, 500, 800, "#ffd0a0", 0.3); }, "fish#1": (L) => { DUSKL(L); FIREL(L); }, "fish#2": (L) => { DUSKL(L); FIREL(L); },
        grill: FIREL, wait: FIREL, "still#0": FIREL, "still#1": POVL, "still#2": FIREL, cloth: POVL, "rule#0": FIREL, "rule#1": FIREL, "rule#2": FIREL,
        card: FIREL, night: FIREL, sig: FIREL, "dawn#0": DAWNL, "dawn#1": DAWNL, "dawn#2": DAWNL,
        line: DAWNL, choice: (L) => { Fence.light(L, 760, 300, 500, "#cfe0f0", 0.2); },
      };
      const seen = {}, depth0 = Fence.depth;
      shots.forEach((sh) => { const n = seen[sh.key] = (seen[sh.key] ?? -1) + 1, look = LOOK[`${sh.key}#${n}`] || (n === 0 ? LOOK[sh.key] : null), e = sh.extra;
        if (look) sh.extra = (L, id) => { if (e) e(L, id); const k0 = (sh.cam && sh.cam.keys && sh.cam.keys[0]) || { x: 0, y: 0, s: 1 }; Fence.depth = (L2, kind, o = {}) => depth0(L2, kind, { cam: k0, ...o }); look(L, id); Fence.depth = depth0; }; });
      shots.forEach((sh) => { const f = sh.fx; sh.fx = (tl, id, t0, L) => { if (f) f(tl, id, t0, L); Isle.life(tl, `#${id}`, t0, sh.dur, sh.life || {}); Fence.flife(tl, `#${id}`, t0, sh.dur); }; });
