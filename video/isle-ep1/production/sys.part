          ${Array.from({ length: o.n || 5 }, (_, i) => `<div class="bx">${i + 1}<b>✓</b><i class="hit"></i></div>`).join("")}</div>${o.res ? `<div class="res">${STAMP(o.res.text, "", o.res.ok ? -6 : 5)}</div>` : ""}</div>`,
