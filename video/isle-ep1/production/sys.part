      // ======================================================================================================
      document.head.insertAdjacentHTML("beforeend", `<style>
        .pkt.scr .row { height: 84px; } .pkt.scr .nm { width: 230px; } .pkt.scr .bar { flex: 1; height: 28px; border: 4px solid ${PK_INK}; border-radius: 8px; background: rgba(60,80,130,.08); position: relative; overflow: hidden; }
        .pkt.scr .bar i { position: absolute; left: 0; top: 0; bottom: 0; background: #4f8a5a; transform-origin: 0% 50%; } .pkt.scr .pt { font: 900 44px/1 Kanit; width: 70px; text-align: right; }
        .pkt.scr .row.bad .nm, .pkt.scr .row.bad .pt { color: ${PK_RED}; } .pkt.scr .row.bad .bar { border-color: ${PK_RED}; }
        .pkt.scr .ring { position: absolute; left: 70px; right: 20px; height: 96px; opacity: 0; pointer-events: none; } .pkt.scr .ring path { stroke: ${PK_RED}; stroke-width: 6; fill: none; }
        .pkt.scr .ft { margin-top: 14px; opacity: 0; } .pkt.scr .ft .stamp { font-size: 32px; }
        .tly { position: absolute; z-index: 54; opacity: 0; width: 760px; left: 160px; padding: 26px 30px 22px; color: ${PK_INK}; font-family: Kanit; filter: drop-shadow(0 16px 20px rgba(0,0,0,.6)); }
        .tly .in { position: relative; z-index: 1; display: flex; align-items: center; gap: 16px; } .tly .lb { font: 900 44px/1 Kanit; width: 190px; }
        .tly .bx { width: 74px; height: 74px; border: 5px solid ${PK_INK}; border-radius: 10px; position: relative; font: 900 46px/64px Kanit; text-align: center; color: rgba(46,42,38,.25); }
        .tly .bx b { position: absolute; inset: 0; color: ${PK_INK}; opacity: 0; } .tly .bx .hit { position: absolute; inset: -10px; border: 6px solid ${PK_RED}; border-radius: 50%; opacity: 0; }
        .tly .res { position: absolute; right: 18px; top: -40px; z-index: 3; opacity: 0; } .tly .res .stamp { font-size: 40px; } .tly.ok .res .stamp { color: #2f8a5a; border-color: #2f8a5a; }
      </style>`);
      // o = {t, end, title, who, rows: [{name, pts, v (0..1), bad, at}], ring (row index), ringAt, foot, footAt, top}
      GameUI.C.score = {
