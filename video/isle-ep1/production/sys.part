            tl.fromTo(row, { opacity: 0, x: -40 }, { opacity: 1, x: 0, duration: 0.25, ease: "power2.out", immediateRender: false }, T);
            tl.fromTo(row.querySelector(".bar i"), { scaleX: 0 }, { scaleX: 1, duration: 0.45, ease: "power2.out", immediateRender: false }, T + 0.1);
            if (r.bad) { tl.fromTo(row, { x: 0 }, { x: 7, duration: 0.05, repeat: 7, yoyo: true, immediateRender: false }, T + 0.5); slam(tl, row, T + 0.4, { punch: row }); } });
          if (o.ring !== undefined) { const ring = el.querySelector(".ring"), row = document.getElementById(`${id}-r${o.ring}`), T = o.t0abs + o.ringAt;
            ring.style.top = `${row.offsetTop - 6}px`; tl.set(ring, { opacity: 1 }, T); tl.fromTo(ring.querySelector("path"), { attr: { "stroke-dashoffset": 1 } }, { attr: { "stroke-dashoffset": 0 }, duration: 0.45, ease: "power1.inOut", immediateRender: false }, T); }
          if (o.foot) { const ft = el.querySelector(".ft"), T = o.t0abs + o.footAt; tl.set(ft, { opacity: 1 }, T); slam(tl, ft, T, { punch: `#${id} .in` }); }
