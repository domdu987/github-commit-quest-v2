          tl.set(`#${id}`, { opacity: 1, rotation: -1.5 }, t0); el.querySelectorAll(".tape").forEach((tp) => (tp.style.opacity = 1));
          tl.fromTo(el.querySelector(".l2 path"), { attr: { "stroke-dashoffset": 1 } }, { attr: { "stroke-dashoffset": 0 }, duration: 0.45, ease: "power1.inOut", immediateRender: false }, t0 + 0.5);
          tl.fromTo(`#${id} .in`, { scale: 1.04 }, { scale: 1, duration: 0.35, ease: "power2.out", immediateRender: false }, t0);
          if (o.end !== undefined) pkOut(tl, `#${id}`, o.t0abs + o.end);
        },
      };
