        .hkp { position: absolute; z-index: 56; opacity: 0; left: 50%; transform: translateX(-50%); width: 900px; padding: 34px 40px 30px 54px; color: ${PK_INK}; font-family: Kanit; filter: drop-shadow(0 18px 24px rgba(0,0,0,.65)); }
        .hkp .in { position: relative; z-index: 1; } .hkp .l1 { font: 900 64px/1.15 Kanit; } .hkp .l2 { font: 900 84px/1.1 Kanit; color: ${PK_RED}; margin-top: 6px; position: relative; display: inline-block; }
        .hkp .l2 svg { position: absolute; left: -6px; right: -6px; bottom: -14px; height: 18px; width: calc(100% + 12px); } .hkp .l2 svg path { stroke: ${PK_RED}; stroke-width: 5; fill: none; }
