        },
      };
      // ---------- the countdown: o = {t, from, to, label, warn, end, top}; one paper sheet flies off per second, a red ring closes, the last seconds go red ----------
      GameUI.C.countdown = {
        html: (id, o) => { const seq = Array.from({ length: o.from - (o.to ?? 0) + 1 }, (_, i) => o.from - i);
          return `<div id="${id}" class="pkt cdn" style="top:${o.top ?? 60}px">${PAP("st")}<i class="red"></i>${TAPE("tl", -7)}${TAPE("tr", 5)}<svg class="ring" viewBox="0 0 520 330"><path d="M260,20C400,16 500,80 500,165C500,250 400,312 260,310C120,312 20,250 20,165C20,80 120,16 260,20Z" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1"/></svg><div class="in">
            <div class="lb">${o.label || "ประตูปิดใน"}</div><div class="big">${PAPERS(seq)}<span class="w">วิ</span></div></div><div class="warnst">${STAMP(o.warnText || "เร็ว!", "", -12)}</div></div>`; },
        anim(tl, id, t0, o) {
          const el = document.getElementById(id), to = o.to ?? 0, n = o.from - to, end = o.t0abs + (o.end ?? o.t + n + 0.6), warn = o.warn ?? 5, digs = [...el.querySelectorAll(".pd")], tick = o.tick ?? 1;
          wordify(el.querySelector(".lb"));
          flipIn(tl, `#${id}`, t0, 0.3); tapeOn(tl, el, t0 + 0.25);
          write(tl, el.querySelector(".lb"), t0 + 0.15, { from: t0, gap: 0.08, d: 0.16 });
          slapIn(tl, el, t0 + 0.2, 0.1);
          tl.fromTo(`#${id} .ring path`, { attr: { "stroke-dashoffset": 1 } }, { attr: { "stroke-dashoffset": 0 }, duration: n * tick, ease: "none", immediateRender: false }, t0 + 0.2);
          const used = new Set();   // sheets already flown at build time (a digit value can repeat in a stack: 20 → 10 → 0 on the ones digit)
          const w = String(o.from).length, strs = Array.from({ length: n + 1 }, (_, i) => String(o.from - i).padStart(w, "0"));   // same padding PAPERS used
          for (let i = 1; i <= n; i++) { const T = t0 + i * tick, v = o.from - i, a = strs[i - 1], b = strs[i];
            digs.forEach((pd, j) => { if (a[j] === b[j]) return;
              // the stack top-first, minus the sheets already gone; the top one flies, and any copies of the same digit right under it
              // (the tens digit holds one "1" sheet per second from 19 to 10) drop out at the same moment so the next digit shows
              const live = [...pd.querySelectorAll(".sh")].reverse().filter((s) => !used.has(s)), k0 = live.findIndex((s) => s.dataset.v === a[j]);
              if (k0 < 0) return; let k = k0; while (k < live.length && live[k].dataset.v === a[j]) { used.add(live[k]); k++; }
              const kf = Math.min(1, tick); flyOff(tl, live[k0], T - (kf < 1 ? 0.75 * kf : 0.2), kf); tl.set(live[k0], { opacity: 0 }, T + 0.6 * kf);
              for (let m = k0 + 1; m < k; m++) tl.set(live[m], { opacity: 0 }, T + 0.05); });
            const hot = v <= warn;
            tl.fromTo(`#${id}`, { x: 0 }, { x: hot ? 10 : 4, duration: 0.035, repeat: hot ? 7 : 3, yoyo: true, immediateRender: false }, T);
            tl.fromTo(`#${id} .big`, { scale: 1 }, { scale: hot ? 1.12 : 1.05, duration: 0.08, yoyo: true, repeat: 1, ease: "power2.out", transformOrigin: "50% 50%", immediateRender: false }, T);
            if (hot) { tl.fromTo(`#${id} .red`, { opacity: 0.55 }, { opacity: 0.18, duration: tick * 0.9, ease: "power2.out", immediateRender: false }, T); tl.fromTo("#fxred", { opacity: 0.5 }, { opacity: 0, duration: 0.5, ease: "power1.out", immediateRender: false }, T); }
            if (v === warn) { slam(tl, el.querySelector(".warnst"), T, { punch: `#${id} .in` }); tl.set(`#${id} .ring path`, { stroke: "#ff3b30" }, T); }
            if (v === 0) { tl.fromTo(`#${id}`, { scale: 1 }, { scale: 1.08, duration: 0.07, yoyo: true, repeat: 1, immediateRender: false }, T); tl.fromTo("#flashw", { opacity: 0.7 }, { opacity: 0, duration: 0.3, immediateRender: false }, T); } }
          if (o.from <= warn) { tl.set(`#${id} .red`, { opacity: 0.3 }, t0); slam(tl, el.querySelector(".warnst"), t0 + 0.3, { punch: `#${id} .in` }); tl.set(`#${id} .ring path`, { stroke: "#ff3b30" }, t0); }
          pkLoops(tl, el, t0 + 0.3, end);
          if (o.end !== undefined) pkOut(tl, `#${id}`, o.t0abs + o.end);
        },
      };
      // ======================================================================================================
