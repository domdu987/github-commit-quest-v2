      GameUI.C.hookPaper = {
        html: (id, o) => `<div id="${id}" class="hkp" style="top:${o.top ?? 210}px">${PAP()}${TAPE("tl", -7)}${TAPE("tr", 6)}<i class="mg"></i><div class="in"><div class="l1">${o.l1}</div><div class="l2">${o.l2}<svg viewBox="0 0 100 10" preserveAspectRatio="none"><path d="M2,6q25,-6 50,0t46,-2" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" vector-effect="non-scaling-stroke"/></svg></div></div></div>`,
        anim(tl, id, t0, o) {
