          <svg class="ring" viewBox="0 0 800 96" preserveAspectRatio="none"><path d="M30,50Q40,6 400,8Q770,10 774,48Q770,90 400,90Q20,92 34,40" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1"/></svg>
