      // ===== หนวดใส EP.3 Short 9:16 · อยู่นิ่งอย่าถู เรียกหมอมาดู · CINEMA BIBLE cut (video/jelly-ep3/production/short/shotlist.json · 31 cuts, lane B e24aeda) =====
      // the towel at the leg (the lure) → a tentacle still on the welts → the wide: the command → the stranger with the towel → ต้น holds her
      // wrist still → the skin: rubbing fires the stingers → ยาย runs in with her basket, pours, the lifeguard lifts the tentacle off → rule 3 →
      // the ambulance → the hospital corridor: "เสาของแม่" → the shadow screen: thirty years ago (the hold), the jellyfish (the sting), plain
      // water, the empty boat → ต้น: "พ่อทิ้งเราไป…" (the twist) → why: the rhyme, the post every morning → "เพราะผมไล่แม่เอง" → ภูมิ wakes →
      // the four steps on the ER board → dawn: three generations fill the post → the end board.
      const VB = (x, y, s = 1, o = {}) => `<g transform="translate(${x},${y}) scale(${s}) rotate(${o.tilt ?? 0})"><path d="M-36,0Q-40,-4 -40,-14V-130Q-40,-150 -24,-160Q-14,-168 -14,-182V-196H14V-182Q14,-168 24,-160Q40,-150 40,-130V-14Q40,-4 36,0Z" fill="#f6efe0" stroke="#2e2a26" stroke-width="3"/>
        <rect x="-40" y="-118" width="80" height="62" fill="#f2c230" stroke="#2e2a26" stroke-width="2.4"/><text x="0" y="-92" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="15" fill="#7a1a10">น้ำส้มสายชู</text>
        <text x="0" y="-66" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="20" fill="#7a1a10">5%</text>${o.cap === false ? "" : `<rect x="-17" y="-216" width="34" height="22" rx="4" fill="#d8312a" stroke="#2e2a26" stroke-width="2.6"/>`}</g>`;
      const TOWEL = (x, y, s = 1, r = 0) => `<g transform="translate(${x},${y}) rotate(${r}) scale(${s})"><path d="M-90,-40Q-20,-70 80,-50Q110,0 90,50Q0,80 -80,60Q-110,10 -90,-40Z" fill="#f2f0e8" stroke="#2e2a26" stroke-width="4"/>
        ${[0, 1, 2].map((k) => `<path d="M-80,${-24 + k * 30}Q0,${-44 + k * 30} 84,${-30 + k * 30}" stroke="#3a9ad8" stroke-width="7" fill="none" opacity=".8"/>`).join("")}</g>`;
      // a real hand gripping an edge that runs along y = 0 (the arm comes in from −y): back of the hand, four fingers wrapped over the
      // edge, the thumb behind, an optional sleeve cuff (the C1p hand of the long; review: no stick arms, fingers on what they hold)
      const GRIP = (skin, o = {}) => `<g>${o.sleeve ? `<path d="M-56,-170L56,-170L50,-84L-50,-84Z" fill="${o.sleeve}" stroke="#1e1a16" stroke-width="6"/>` : ""}<path d="M-30,-140L30,-140L40,-80L-40,-80Z" fill="${skin}" stroke="#1e1a16" stroke-width="6"/>
        <path d="M-74,-44Q-90,-10 -70,10" stroke="#1e1a16" stroke-width="28" stroke-linecap="round" fill="none"/><path d="M-74,-44Q-90,-10 -70,10" stroke="${skin}" stroke-width="18" stroke-linecap="round" fill="none"/>
        <path d="M-48,-92Q-64,-40 -52,-8L52,-8Q64,-40 48,-92Z" fill="${skin}" stroke="#1e1a16" stroke-width="6"/>
        ${[0, 1, 2, 3].map((k) => { const x = -36 + k * 24; return `<path d="M${x},-18Q${x + 6},12 ${x - 2},${30 - Math.abs(k - 1.5) * 4}" stroke="#1e1a16" stroke-width="24" stroke-linecap="round" fill="none"/><path d="M${x},-18Q${x + 6},12 ${x - 2},${30 - Math.abs(k - 1.5) * 4}" stroke="${skin}" stroke-width="15" stroke-linecap="round" fill="none"/>`; }).join("")}
        <path d="M-40,-30Q0,-22 40,-30" stroke="#1e1a16" stroke-width="3" fill="none" opacity=".45"/></g>`;
      Rig.CAST.jWomanHat = { v2: { ...Rig.CAST.jWoman.v2, faceTop: `<g transform="translate(0,22)"><path d="M-150,-596Q0,-690 150,-596Q0,-612 -150,-596Z" fill="#d8b878" stroke="#2e2a26" stroke-width="2.6"/><path d="M-80,-620Q0,-700 80,-620" fill="#c8a868" stroke="#2e2a26" stroke-width="2.6"/><path d="M-82,-622Q0,-634 82,-622" stroke="#d8312a" stroke-width="7" fill="none"/></g>` } };
      Rig.CAST.jWomanTowel = { v2: Rig.CAST.jWomanHat.v2, hand: `<g transform="translate(0,104) rotate(10)">${TOWEL(0, 30, 0.55)}<g transform="translate(-6,8) scale(.42)">${GRIP((Rig.CAST.jWoman.v2 || {}).skin || "#e0b088")}</g></g>`, keep: "F" };
      Rig.CAST.jLaorVinUp = { v2: Rig.CAST.jLaor.v2, hand: `<g transform="translate(0,104) rotate(180)">${VB(0, 0, 0.5)}</g>`, keep: "F" };
      Rig.CAST.jLaorVin = { v2: Rig.CAST.jLaor.v2, hand: `<g transform="translate(0,104) rotate(150)">${VB(0, 0, 0.5, { cap: false })}<g transform="translate(0,-46) rotate(-150) scale(.58)">${GRIP((Rig.CAST.jLaor.v2 || {}).skin || "#c89870")}</g></g>`, keep: "F" };
      Rig.CAST.jWanBare2 = Rig.CAST.jWanBare;
      Rig.MODES.kneel = Rig.MODES.kneel || ((u, o) => ({ ...Rig.MODES.idle(u, o), thF: -86, shF: 86, thB: 0, shB: 90, uaF: -10, faF: -30, uaB: 6, faB: -20, torso: 6, head: 4, bodyY: 286 }));
      Rig.MODES.wipe = (u, o) => { const w = 10 * Math.sin(u * 9); return { ...Rig.MODES.kneel(u, o), uaF: -64 + w, faF: -30, uaB: -30, faB: -50, torso: 18, head: 14 }; };
      Rig.MODES.wipeLow = (u, o) => { const w = 8 * Math.sin(u * 9); return { ...Rig.MODES.kneel(u, o), uaF: -10 + w, faF: -40, uaB: -30, faB: -50, torso: 30, head: 22 }; };   // the towel down at the calf
      Rig.MODES.pourLow2 = (u, o) => ({ ...Rig.MODES.kneel(u, o), uaF: -20, faF: -50, uaB: -40, faB: -50, torso: 30, head: 26 });   // the bottle tipped over the shin
      Rig.MODES.grabWrist = (u, o) => ({ ...Rig.MODES.kneel(u, o), uaF: -84, faF: -6, uaB: 10, faB: -30, torso: 10, head: 4 });
      Rig.MODES.runBasket = (u, o) => ({ ...Rig.MODES.run(u, o), uaF: -40, faF: -60 });
      Rig.MODES.pourKneel = (u, o) => ({ ...Rig.MODES.kneel(u, o), uaF: -66, faF: -24, uaB: -40, faB: -50, torso: 16, head: 18 });
      Rig.MODES.benchSit = (u, o) => ({ ...Rig.MODES.sit(u, o), thF: -84, shF: 86, thB: -82, shB: 84, uaF: -20, faF: -50, uaB: 10, faB: -40, torso: 4, head: 6 + 2 * Math.sin(u * 1.1), bodyY: 150 });
      Rig.MODES.waveBig = Rig.MODES.waveBig || ((u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -160 + 20 * Math.sin(u * 9), faF: -20, uaB: 10, faB: -20, head: -8 }));
      Rig.MODES.fillPost = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -120, faF: -40, uaB: -100, faB: -50, head: -12 });
      const FGB = (L, tl, t0, a, b, fid, svg) => { if (window.LANDSCAPE && (window.LANDSCAPE.noFg || ["fg21", "fg28"]).includes(fid)) return; put(L.light, `<defs><filter id="${fid}-f" x="-.3" y="-.3" width="1.6" height="1.6"><feGaussianBlur stdDeviation="14"/></filter></defs><g id="${fid}" filter="url(#${fid}-f)">${window.LANDSCAPE ? `<g transform="translate(-660,0) scale(2.2222,1)"><rect width="1080" height="1920" opacity="0"/>${svg}</g>` : svg}</g>`);
        tl.set(`#${fid}`, { opacity: 0 }, 0); tl.set(`#${fid}`, { opacity: 1 }, t0 + a); if (b !== undefined) tl.set(`#${fid}`, { opacity: 0 }, t0 + b); };
      const BEACH3 = (id, x = {}) => BEACH(id, { tower: [930, 1270, 0.82], umbrellas: [[90, 1300, 0.8, "#f2c230"], [1040, 1360, 0.85, "#3a9ad8"]], life: [["mat", 330, 1760, 0.95, "#e8482a"], ["cooler", 120, 1350, 0.6]], ...x });
      const MAT = [330, 1760];
      // the hospital corridor outside the ER: tiled wall, the doors with their red sign, a bench, neon tubes
      const HALL = (L, id, o = {}) => { const G = 1720;
        put(L.sky, `<rect x="-1300" y="-900" width="3700" height="3900" fill="#cfd8d2"/>`);
        let s = `<rect x="-1300" y="-200" width="3700" height="${G + 200}" fill="#dfe6e0"/>${Array.from({ length: 30 }, (_, k) => `<path d="M${-1300 + k * 120},-200V${G}" stroke="#c8d2ca" stroke-width="3"/>`).join("")}
          <rect x="-1300" y="${G - 420}" width="3700" height="420" fill="#a8c0b6"/><path d="M-1300,${G - 420}H2400" stroke="#8aa89c" stroke-width="10"/>
          <rect x="-1300" y="${G}" width="3700" height="900" fill="#b8bfb8"/>${Array.from({ length: 10 }, (_, k) => `<path d="M-1300,${G + Math.pow(k / 9, 1.6) * 600}H2400" stroke="#a4aba4" stroke-width="3"/>`).join("")}
          <g transform="translate(${o.door ?? 900},0)"><rect x="-220" y="${G - 900}" width="440" height="900" fill="#7a8a90" stroke="#3a4448" stroke-width="8"/><rect x="-200" y="${G - 860}" width="190" height="560" fill="#b8d8e0" opacity=".7"/><rect x="10" y="${G - 860}" width="190" height="560" fill="#b8d8e0" opacity=".7"/>
            <rect x="-180" y="${G - 1020}" width="360" height="90" rx="10" fill="#d8312a" stroke="#3a1a1a" stroke-width="5"/><text y="${G - 960}" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="46" fill="#fff">ห้องฉุกเฉิน</text></g>
          ${[-200, 500, 1200].map((x) => `<rect x="${x - 160}" y="-40" width="320" height="22" rx="10" fill="#f6fbff"/>`).join("")}`;
        if (o.bench !== false) s += `<g transform="translate(${o.bench ?? 330},${G})"><rect x="-300" y="-250" width="600" height="40" rx="10" fill="#4a7ab0" stroke="#2a3a50" stroke-width="5"/><path d="M-270,-210V0M270,-210V0" stroke="#3a4448" stroke-width="16"/><rect x="-300" y="-430" width="600" height="36" rx="10" fill="#4a7ab0" stroke="#2a3a50" stroke-width="5"/><path d="M-250,-394V-250M250,-394V-250" stroke="#3a4448" stroke-width="12"/></g>`;
        if (o.board) s += `<g id="${id}-board"></g>`;
        put(L.set, s);
        put(L.glow, `${[-200, 500, 1200].map((x) => `<ellipse cx="${x}" cy="-10" rx="420" ry="160" fill="#f6fbff" opacity=".25"/>`).join("")}`); };

      // 1–2 · hook: the towel coming at the calf · ECU the tentacle still on the welts
      add("c_h1", { set: "jellyHook", setOpts: { id: "jh1", title: " ", sub: " ", seed: 4 }, dark: 0, blur: { fg: 0, set: 0, act: 0 }, light: false,
        cam: { keys: [{ t: 0, ...fr(560, 980, 1.15, 540, 980) }, { t: CT(2, "c_h1"), ...fr(640, 1120, 2.2, 540, 980) }] }, captions: caps("c_h1"),
        fx(tl, id, t0, L) {
          document.getElementById("jh1-bt").setAttribute("display", "none");
          put(L.act, `<g id="h1-tw"><path d="M1250,240L860,620" stroke="#1e1a16" stroke-width="96" stroke-linecap="round"/><path d="M1250,240L860,620" stroke="#e0b088" stroke-width="84" stroke-linecap="round"/><path d="M1300,180L1060,420" stroke="#f2f0e8" stroke-width="120" stroke-linecap="round"/>
            ${TOWEL(780, 700, 2.4, -20)}<g transform="translate(866,618) rotate(45)">${GRIP("#e0b088", { sleeve: "#f2f0e8" })}</g></g>`);   // the stranger's hand grips the towel (in frame when the camera pushes in)
          // the towel comes on the whole time, right up to the command cut (review: 1–3 s must not hold still)
          tl.fromTo("#h1-tw", { x: 150, y: -60 }, { x: -70, y: 330, duration: D("c_h1"), ease: "sine.inOut", immediateRender: false }, t0);
          put(L.act, `<path id="h1-ten" d="M520,1000Q600,1060 660,1040Q720,1020 760,1080Q800,1140 860,1120" stroke="#f2feff" stroke-width="9" fill="none" stroke-linecap="round"/><path d="M520,1000Q600,1060 660,1040Q720,1020 760,1080Q800,1140 860,1120" stroke="#a88ae8" stroke-width="3" fill="none" stroke-dasharray="3 8"/>
            ${[0, 1, 2, 3].map((k) => `<circle class="h1-gl" cx="${560 + k * 90}" cy="${1040 + (k % 2) * 30}" r="6" fill="#fff"/>`).join("")}`);
          // the tentacle twitches on the skin and the welts under it flare red as the towel nears
          put(L.act, `<path id="h1-red" d="M520,1000Q600,1060 660,1040Q720,1020 760,1080Q800,1140 860,1120" stroke="#ff2a3a" stroke-width="30" fill="none" stroke-linecap="round" opacity="0" style="filter:blur(6px)"/>`);
          tl.fromTo("#h1-red", { opacity: 0 }, { opacity: 0.75, duration: D("c_h1"), ease: "power1.in", immediateRender: false }, t0);
          tl.fromTo("#h1-ten", { x: 0, y: 0 }, { x: 5, y: -4, duration: 0.12, repeat: Math.floor(D("c_h1") / 0.12), yoyo: true, ease: "sine.inOut", immediateRender: false }, t0 + 0.3);
          tl.fromTo(".h1-gl", { opacity: 0.2 }, { opacity: 1, duration: 0.25, stagger: 0.1, repeat: 9, yoyo: true, immediateRender: false }, t0 + 0.2);
        } });
      // 3 · the wide: the stranger kneels with her towel at ภูมิ's leg; ต้น turns
      add("c_h2", { set: "jellyBeach", setOpts: BEACH3("jb31"), dark: 0, light: SUN,
        cam: { keys: [{ t: 0, ...fr(560, 1380, 1.0, 540, 1000) }] },
        actors: [
          A("jPhum", MAT[0] + 40, MAT[1] + 10, 0.95, [{ t: 0, mode: "sit", eyes: "cry", mouth: "o" }]),
          A("jWomanTowel", 640, 1775, 0.95, [{ t: 0, mode: "wipeLow", eyes: "worry", mouth: "o" }], { flip: true }),
          A("jTon", 860, 1740, 1.0, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }], { flip: true }),
        ],
        captions: caps("c_h2"),
        fx(tl, id, t0, L) { put(L.act, shin(MAT[0] + 40, MAT[1] + 10, 0.95)); } });
      // 4–6 · "เช็ดหนวดออกก่อน!" → the towel inches from the tentacle → ต้น's hand on her wrist, still (the choice)
      add("c_towel", { set: "jellyBeach", setOpts: BEACH3("jb32", { tower: false }), dark: 0, blur: { set: 3, mid: 4, far: 4 }, light: SUN,
        cam: { keys: [{ t: 0, ...fr(680, 1440, 2.8, 540, 900) }, { t: CT(6, "c_towel"), ...fr(830, 1450, 3.0, 540, 840) }] },
        actors: [
          A("jPhum", MAT[0] + 40, MAT[1] + 10, 0.95, [{ t: 0, mode: "sit", eyes: "cry", mouth: "o" }]),
          A("jWomanTowel", 640, 1775, 0.95, [{ t: 0, mode: "wipeLow", eyes: "worry", mouth: "o" }], { flip: true, talk: [TALK("c_towel", 0, "o")] }),
          A("jTon", 860, 1770, 1.0, [{ t: 0, mode: "grabWrist", eyes: "angry", mouth: "o" }], { flip: true, talk: [TALK("c_towel", 1, "scream")] }),
        ],
        captions: caps("c_towel", undefined, { quote: true }),
        fx(tl, id, t0, L) { put(L.act, shin(MAT[0] + 40, MAT[1] + 10, 0.95));
          const a = CT(5, "c_towel"), b = CT(6, "c_towel");
          insert(L, tl, t0, "tw-ins", a, b, SAND("tw-s") + `<path d="M-200,1240Q140,1190 420,1220Q640,1244 790,1300Q860,1322 900,1290Q950,1250 1000,1270Q1060,1300 1040,1370Q1010,1440 900,1430Q760,1410 600,1410Q360,1410 120,1440Q-60,1460 -200,1460Z" fill="#cf9262" stroke="#1e1a16" stroke-width="6"/>
            ${Jelly.ladder([[180, 1270], [300, 1300], [420, 1280]], { w: 8 })}<path d="M200,1290Q320,1330 420,1300Q520,1270 620,1320" stroke="#f2feff" stroke-width="8" fill="none" stroke-linecap="round"/>
            <g id="tw-tw">${TOWEL(560, 1040, 2.6, -14)}<path d="M1240,380L800,880" stroke="#1e1a16" stroke-width="100" stroke-linecap="round"/><path d="M1240,380L800,880" stroke="#e0b088" stroke-width="86" stroke-linecap="round"/><path d="M1300,300L1080,560" stroke="#f2f0e8" stroke-width="126" stroke-linecap="round"/><g transform="translate(800,892) rotate(41) scale(1.45)">${GRIP("#e0b088", { sleeve: "#f2f0e8" })}</g></g>`, 1.04);
          tl.fromTo("#tw-tw", { y: -120 }, { y: 0, duration: b - a, ease: "power2.out", immediateRender: false }, t0 + a);
        } });
      // 7–9 · the skin cut open: a towel rubbing → the stingers fire → the venom spreads; the stamp
      add("c_know", { dark: 0, light: false,
        cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }, { t: CT(8, "c_know") - 0.01, glide: CT(8, "c_know") - 0.01, ...fr(540, 990, 1.06, 540, 960) }, { t: CT(8, "c_know"), ...fr(540, 1010, 1.25, 540, 960) }, { t: CT(9, "c_know"), ...fr(540, 1060, 1.0, 540, 960) }] },
        captions: caps("c_know"),
        fx(tl, id, t0, L) {
          // F3: the "follow · full story on YouTube" sign drops in for 3 s (as EP.1/EP.2), Short only (hidden in the long)
          put(L.light, `<g transform="translate(540,0)"><g id="fsg3"><path d="M-150,-10V70M150,-10V70" stroke="#8a6a3a" stroke-width="6"/>
            <path d="M-260,70Q-266,64 -250,62H250Q266,64 262,76L258,190Q258,204 244,204H-246Q-262,202 -260,188Z" fill="#a88454" stroke="#1e1a16" stroke-width="5"/>
            <rect x="-238" y="88" width="220" height="62" rx="31" fill="#d8312a" stroke="#1e1a16" stroke-width="4"/><text x="-128" y="130" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="34" fill="#fff">กดติดตาม</text>
            <rect x="0" y="88" width="238" height="62" rx="14" fill="#fffaf0" stroke="#1e1a16" stroke-width="4"/><path d="M20,100L50,119L20,138Z" fill="#d8312a"/><text x="140" y="130" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="30" fill="#1e2a3a">เรื่องเต็ม</text>
            <text x="0" y="186" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="24" fill="#2a1a0a">ดูเรื่องเต็มที่ช่อง YouTube</text></g></g>`);
          { const f3 = 10.3 - SH["c_know"].start; tl.set("#fsg3", { opacity: 0 }, 0);
            tl.fromTo("#fsg3", { opacity: 0, y: -230 }, { opacity: 1, y: 20, duration: 0.5, ease: "back.out(1.8)", immediateRender: false }, t0 + f3);
            tl.to("#fsg3", { rotation: 1.6, svgOrigin: "0 0", duration: 0.6, yoyo: true, repeat: 3, ease: "sine.inOut", immediateRender: false }, t0 + f3 + 0.5);
            tl.to("#fsg3", { opacity: 0, y: -230, duration: 0.4, ease: "power2.in", immediateRender: false }, t0 + f3 + 2.7); }
          const b = CT(8, "c_know"), c = CT(9, "c_know");
          let g = `<rect x="-200" y="-200" width="1480" height="2400" fill="#e8f6fa"/><text x="540" y="340" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="50" fill="#1e2a3a">ผิวหนังตรงที่หนวดยังติด</text>
            <path d="M40,760H1040V1520H40Z" fill="#f6e2a8" stroke="#1e1a16" stroke-width="6"/><path d="M40,760H1040V1180H40Z" fill="#e88a7a"/><path d="M40,760H1040V870H40Z" fill="#e8b08a"/><path d="M40,760H1040" stroke="#1e1a16" stroke-width="6"/>
            <path d="M40,1080Q300,1040 540,1090T1040,1060" stroke="#b8241e" stroke-width="44" fill="none" stroke-linecap="round"/>
            <g id="kn3-vp" opacity="0"><path d="M40,1080Q300,1040 540,1090T1040,1060" stroke="#8a3ad8" stroke-width="30" fill="none" stroke-linecap="round" stroke-dasharray="40 50"/></g>
            <path d="M-40,700Q300,660 540,710T1120,690" stroke="#eafcff" stroke-width="58" fill="none" opacity=".75" stroke-linecap="round"/>`;
          [140, 260, 380, 500, 620, 740, 860, 980].forEach((x, k) => { const y = 700 - 20 * Math.sin(x / 200);
            g += `<g transform="translate(${x},${y.toFixed(0)})"><ellipse rx="22" ry="15" fill="#c8b8f8" stroke="#5a3aa8" stroke-width="3"/><path id="kn3-th${k}" d="M0,12Q-10,60 6,110Q20,160 0,210" stroke="#5a3aa8" stroke-width="4" fill="none" stroke-dasharray="230" stroke-dashoffset="230"/>
              <circle id="kn3-v${k}" cx="0" cy="210" r="70" fill="#a85ae8" opacity="0"/></g>`; });
          g += `<g id="kn3-tw">${TOWEL(540, 560, 1.6, -6)}<path d="M380,560h-80M700,560h80" stroke="#d8312a" stroke-width="10" stroke-linecap="round"/><path d="M300,560l24,-16v32zM780,560l-24,-16v32z" fill="#d8312a"/></g>
            <g transform="translate(540,1340) rotate(-6)"><g id="kn3-st"><rect x="-200" y="-70" width="400" height="140" rx="20" fill="none" stroke="#b8241e" stroke-width="12"/><text y="34" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="96" fill="#b8241e">ห้ามถู</text></g></g>`;
          put(L.set, g);
          tl.fromTo("#kn3-tw", { x: -80 }, { x: 80, duration: 0.22, repeat: Math.floor(b / 0.22), yoyo: true, ease: "sine.inOut", immediateRender: false }, t0 + 0.2);
