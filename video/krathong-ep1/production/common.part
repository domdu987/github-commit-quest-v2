      // ================= เรือล่มคืนลอยกระทง shared shot helpers (every episode) =================
      // Plans: shotlist.json (30 cuts, CINEMA BIBLE) · colorscript.json · soundplan.json. The cine layer (Cine.episode) sets the grade,
      // vignette, grain, parallax and the handheld camera per cut, so no shot carries its own grade or shake here.
      // In-shot cuts are camera keys without a glide (a jump) at the times plan.py writes.

      // captions: the narrator plain, characters in quotes
      const capsQ = (k) => {
        const n = [], q = [];
        SH[k].vo.forEach((v, i) => (v.id[0] === "n" ? n : q).push(i));
        // narrator and character lines come from two caps() lists: trim across the merged list too, or a line still on screen overlaps the next one
        const out = [...(n.length ? caps(k, n) : []), ...(q.length ? caps(k, q, { quote: true }) : [])].sort((a, b) => a.t - b.t);
        for (let i = 0; i + 1 < out.length; i++) out[i].end = Math.min(out[i].end, out[i + 1].t - 0.03);
        return out;
      };
      const TK = (k, i, m = "o") => [vo(k, i), voEnd(k, i), m];
      const NIGHT = { dark: 0 };
      // the moored-boat scene at the pontoon, seen from the river: the boat บุญล้น low in the water against the lit pontoon
      // (used by the hook and the crash): o.sink 0…1, o.tilt, o.fw fireworks, o.crowd extra heads
      function boatAtPier(L, o = {}) {
        riverNight(L, { hz: 640, moon: [880, 210], tx: 760, fwx: o.fwx ?? 2000 });
        krathongField(L, { n: 40, y0: 660, y1: 1880, smax: 0.9, seed: o.seed || 5, skip: (x, y) => (y > 980 && y < 1320 && x > -80 && x < 1120) || (y > 1380 && y < 1700 && x > 60 && x < 1020) });
        // the lit pontoon behind the boat: deck edge, rail, drums, the "20 คน" sign and string lights
        put(L.far, `<g transform="translate(540,1010)"><path d="M-760,0H760V22H-760Z" fill="#9a6a3e" ${KOUT}/><path d="M-760,22H760V36H-760Z" fill="#5a3a1e"/>
          ${Array.from({ length: 12 }, (_, i) => `<ellipse cx="${-700 + i * 128}" cy="48" rx="54" ry="20" fill="url(#kDrum)" ${KOUT2}/>`).join("")}
          <path d="M-760,0V-70H760V0" stroke="#d8d2c0" stroke-width="6" fill="none"/>${Array.from({ length: 9 }, (_, i) => `<path d="M${-760 + i * 190},0V-70" stroke="#d8d2c0" stroke-width="6"/>`).join("")}
          <g transform="translate(-520,-130)"><path d="M0,0V130" stroke="#5a3a1e" stroke-width="7"/><rect x="-80" y="-56" width="160" height="64" rx="7" fill="#f6f2e4" ${KOUT2}/><text x="0" y="-28" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="19" fill="#1e2a4a">โป๊ะรับได้</text><text x="0" y="-2" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="25" fill="#c8241e">20 คน</text></g></g>`);
        put(L.glow, `<ellipse cx="540" cy="990" rx="820" ry="90" fill="url(#kBulb)" opacity=".45"/>` + Array.from({ length: 24 }, (_, i) => `<circle cx="${-120 + i * 56}" cy="${930 + Math.sin(i) * 8}" r="16" fill="url(#kBulb)" opacity=".7"/>`).join(""));
        if (!o.noBoat) put(L.set, boatSide(600, 1220, 0.8, { sink: o.sink ?? 0.85, tilt: o.tilt ?? -3.5, water: true, wake: 1, load: o.noCrowd ? "" : crowd(-300, 420, -150, 5, 3, 0.9) }));
      }
      // the people on the boat in the hook: ข้าวปั้น up on the bench (whistle), มะปราง seated reaching for him, others rising
      // no more than three faces on the boat (V3): มะปราง, ลุงหมึก and ข้าวปั้น; everyone else is a round-head passenger (riseCrowd)
      const KX = 600, KY = 1220 + 22 - 62;
      const hookCast = (tilt) => [...onBoat(600, 1220, tilt, [["maprang", -150, 0.32, "reachSit", "worry", "o"], ["lungMuek", 405, 0.36, "idle", "normal", "o", true]]),
        A("khaopanW", KX, KY, 0.26, [{ t: 0, mode: "whistle", eyes: "wide", mouth: "o" }])];
      const hookBench = (L, tl, tilt) => {
        riseCrowd(L, tl, `${L.id}-rc`, 330, 900, 1110, 6, 3, 0.8, L.riseAt, 40, tilt);
        put(L.act, hullOver(boatSide(600, 1220, 0.8, { sink: 0.85, tilt, water: true, wake: 1 })));
        const ky = KY;
        put(L.act, `<g transform="translate(${KX},${k1(ky)}) rotate(${tilt})"><rect x="-46" y="-2" width="92" height="16" rx="3" fill="#a8763e" ${KOUT2}/><rect x="-40" y="-8" width="80" height="10" rx="4" fill="#ff7a2a" ${KOUT2}/></g>`);
        put(L.fg, krathong(150, 1300, 0.6, { seed: 31 }) + krathong(980, 1360, 0.7, { seed: 32 }) + kRefl(150, 1300, 0.6, 160) + kRefl(980, 1360, 0.7, 160));
        put(L.glow, kGlow(150, 1300, 0.6, 80) + kGlow(980, 1360, 0.7, 90));
      };
      // a firework burst in screen space (light layer) that blooms at t
      const burstAt = (tl, L, id, x, y, R, t, c1 = "#ffd24a", c2 = "#ff6aa8") => {
        const rays = Array.from({ length: 36 }, (_, i) => { const a = i / 36 * Math.PI * 2; return `<path d="M${k1(Math.cos(a) * R * 0.2)},${k1(Math.sin(a) * R * 0.2)}Q${k1(Math.cos(a) * R * 0.7)},${k1(Math.sin(a) * R * 0.7)} ${k1(Math.cos(a) * R)},${k1(Math.sin(a) * R + 30)}" stroke="${i % 2 ? c1 : c2}" stroke-width="5" fill="none" stroke-linecap="round"/><circle cx="${k1(Math.cos(a) * R)}" cy="${k1(Math.sin(a) * R + 30)}" r="6" fill="#fff"/>`; }).join("");
        put(L.light, `<g id="${id}" transform="translate(${x},${y})"><circle r="${R * 1.5}" fill="url(#kBulb)" opacity=".45"/>${rays}<circle r="${R * 0.22}" fill="#fff6d0" opacity=".9"/></g>`);
        tl.fromTo(`#${id}`, { scale: 0.15, opacity: 0, svgOrigin: `${x} ${y}` }, { scale: 1, opacity: 1, svgOrigin: `${x} ${y}`, duration: 0.35, ease: "expo.out", immediateRender: false }, t);
        tl.to(`#${id}`, { opacity: 0.25, y: 40, duration: 1.4, ease: "power1.in" }, t + 0.4);
      };

      const vestProp = (x, y, s = 1, r = 0) => `<g transform="translate(${k1(x)},${k1(y)}) scale(${s}) rotate(${r})"><path d="M-40,-60L-10,-58L-6,40Q-28,46 -46,40Z" fill="url(#kVest)" ${KOUT2}/><path d="M40,-60L10,-58L6,40Q28,46 46,40Z" fill="url(#kVest)" ${KOUT2}/><path d="M-46,-24H-6M6,-24H46M-46,8H-6M6,8H46" stroke="#e8e4d8" stroke-width="6"/><path d="M-6,-24H6M-6,8H6" stroke="#2a2e34" stroke-width="4"/></g>`;
      function rulePaddle(L, id, active, done) {
        // a worn paddle on a hook: wood grain, flaking paint, water stains, brush lettering; marigold garland, a brass bell, a frayed rope
        const R = ["เรือเทียบท่า อย่าลุกพร้อมกัน", "เรือเอียง อย่าเถียงเรือ", "คว้าของลอย นอนคอยเรือ"];
        put(L.light, `<g id="${id}" opacity="0"><rect x="-900" y="-900" width="2900" height="3900" fill="#140c08" opacity=".86"/>
          <g id="${id}-sw" transform="translate(540,250)"><path d="M0,0V120" stroke="#8a6a3a" stroke-width="10"/><path d="M-30,0Q0,-30 30,0" stroke="#6a6e74" stroke-width="10" fill="none"/>
            <g transform="translate(0,120)"><rect x="-26" y="0" width="52" height="420" rx="16" fill="#a8763e" ${KOUT}/>
              <path d="M-330,420Q-350,1010 0,1110Q350,1010 330,420Z" fill="#c89a5a" ${KOUT}/>
              ${Array.from({ length: 9 }, (_, i) => `<path d="M${-300 + i * 70},450Q${-290 + i * 72},780 ${-260 + i * 64},1060" stroke="#a8784a" stroke-width="3" fill="none" opacity=".5"/>`).join("")}
              <path d="M-250,980q60,40 140,30M120,500q50,20 110,4" stroke="#7a5a3a" stroke-width="10" fill="none" opacity=".25"/>
              ${R.map((r, i) => `<g transform="translate(0,${560 + i * 160})" opacity="${i === active || done.includes(i) ? 1 : 0.32}"><text x="0" y="0" text-anchor="middle" font-family="Sriracha" font-size="${i === active ? 50 : 44}" fill="${i === active ? "#c8241e" : "#3a1e10"}">${r.split(" ")[0]}</text><text x="0" y="58" text-anchor="middle" font-family="Sriracha" font-size="${i === active ? 56 : 46}" fill="${i === active ? "#c8241e" : "#3a1e10"}">${r.split(" ").slice(1).join(" ")}</text>
                ${done.includes(i) ? `<path d="M-230,24H230" stroke="#fff" stroke-width="10" stroke-linecap="round" opacity=".9"/>` : ""}${i === active ? `<path id="${id}-br" d="M-250,80Q0,96 250,76" stroke="#c8241e" stroke-width="12" fill="none" stroke-linecap="round" stroke-dasharray="520" stroke-dashoffset="520"/>` : ""}</g>`).join("")}
              <path d="M-90,430${Array.from({ length: 7 }, () => "q14,26 26,0").join("")}" stroke="#f2961a" stroke-width="16" fill="none" stroke-linecap="round" stroke-dasharray="3 10"/>
              <g transform="translate(110,440)"><path d="M0,0V30" stroke="#8a6a2a" stroke-width="3"/><path d="M-20,58Q-20,30 0,28Q20,30 20,58Z" fill="#d8a83a" ${KOUT2}/><circle cy="62" r="6" fill="#8a6a2a"/></g></g></g></g>`);
      }
      const paddleIn = (tl, id, t) => {
        tl.set(`#${id}`, { opacity: 1 }, t);
        // enters swinging on its hook, settles, then keeps swaying in the breeze
        tl.fromTo(`#${id}-sw`, { rotation: -14, svgOrigin: "540 250" }, { rotation: 0, svgOrigin: "540 250", duration: 0.9, ease: "elastic.out(1, 0.35)", immediateRender: false }, t);
        tl.to(`#${id}-sw`, { rotation: 1.6, svgOrigin: "540 250", duration: 1.1, yoyo: true, repeat: 3, ease: "sine.inOut" }, t + 0.9);
        tl.to(`#${id}-br`, { strokeDashoffset: 0, duration: 0.45, ease: "power2.out" }, t + 0.35);
      };
      // the boat leaning: rotate the whole shot (sky and pontoon lights included: the camera rides the boat)
      // the zoom that keeps a 1080×1920 frame covered when it is turned by deg
      const coverS = (deg) => { const a = Math.abs(deg) / 57.3; return Math.cos(a) + (1920 / 1080) * Math.sin(a) + 0.02; };
      const lean = (tl, id, t0, deg, at = 0) => tl.set(`#${id}-world`, { rotation: deg, scale: coverS(deg), svgOrigin: "540 960" }, t0 + at);
      const leanTo = (tl, id, t, deg, dur, ease = "power2.inOut") => tl.to(`#${id}-world`, { rotation: deg, scale: coverS(deg), svgOrigin: "540 960", duration: dur, ease }, t);
      // round-head passengers (count as scenery, not as faces; set layer, behind the named cast): a row behind the gunwale that stands up (y −dy) at t, staggered
      const riseCrowd = (L, tl, id, x0, x1, y, n, seed, sc, t, dy = 46, tilt = 0) => {
        put(L.set, `<g id="${id}"><g transform="rotate(${tilt} ${(x0 + x1) / 2} ${y})">${crowd(x0, x1, y, n, seed, sc)}</g></g>`);
        if (t != null) tl.fromTo(`#${id}`, { y: 0 }, { y: -dy, duration: 0.35, ease: "back.out(2)", immediateRender: false }, t);
      };
      // a small wooden sign on a rope that drops in from the top edge, swings and settles, then lifts out (screen space, above the faces):
      // F3 "กดติดตาม · ดูเรื่องเต็มที่ช่อง YouTube" and the HG7 card; a brass bell rings on it when o.bell
      function hangSign(L, tl, id, t, dur, lines, o = {}) {
        const W = 720, H = 70 + lines.length * 62, Y = o.y ?? 210;
        put(L.light, `<g id="${id}" opacity="0"><g id="${id}-sw" transform="translate(540,0)"><path d="M-200,-40V${Y - H / 2}M200,-40V${Y - H / 2}" stroke="#c8a870" stroke-width="7"/>
          <g transform="translate(0,${Y})"><rect x="${-W / 2 + 8}" y="${-H / 2 + 10}" width="${W}" height="${H}" rx="18" fill="#000" opacity=".35"/>
            <rect x="${-W / 2}" y="${-H / 2}" width="${W}" height="${H}" rx="18" fill="#b07a48" ${KOUT}/><rect x="${-W / 2 + 14}" y="${-H / 2 + 14}" width="${W - 28}" height="${H - 28}" rx="10" fill="#c89a5a"/>
            ${Array.from({ length: 6 }, (_, i) => `<path d="M${-W / 2 + 30},${-H / 2 + 24 + i * (H - 48) / 5}q${W / 2},${i % 2 ? 8 : -8} ${W - 60},0" stroke="#a8784a" stroke-width="2" fill="none" opacity=".5"/>`).join("")}
            ${lines.map((ln, i) => `<text x="${o.bell ? 40 : 0}" y="${-H / 2 + 76 + i * 62}" text-anchor="middle" font-family="Kanit" font-weight="${i ? 700 : 900}" font-size="${i ? 40 : 54}" fill="${i ? "#3a1e10" : "#c8241e"}">${ln}</text>`).join("")}
            ${o.bell ? `<g id="${id}-bl" transform="translate(${-W / 2 + 70},${-H / 2 + 34})"><path d="M0,-10V8" stroke="#8a6a2a" stroke-width="4"/><path d="M-30,62Q-30,10 0,8Q30,10 30,62Z" fill="#e2b84a" ${KOUT2}/><path d="M-36,62H36" stroke="${KINK}" stroke-width="6" stroke-linecap="round"/><circle cy="70" r="8" fill="#8a6a2a"/></g>` : ""}</g></g></g>`);
        tl.set(`#${id}`, { opacity: 1 }, t);
        tl.fromTo(`#${id}-sw`, { y: -Y - 260, rotation: -6, svgOrigin: "540 0" }, { y: 0, rotation: 0, svgOrigin: "540 0", duration: 0.45, ease: "back.out(1.6)", immediateRender: false }, t);
        tl.to(`#${id}-sw`, { rotation: 1.5, svgOrigin: "540 0", duration: 0.5, yoyo: true, repeat: Math.max(1, Math.round((dur - 0.7) / 0.5)), ease: "sine.inOut" }, t + 0.45);
        if (o.bell) tl.fromTo(`#${id}-bl`, { rotation: -18 }, { rotation: 18, transformOrigin: "50% 0%", duration: 0.12, yoyo: true, repeat: 5, ease: "sine.inOut", immediateRender: false }, t + 0.35);
        tl.to(`#${id}-sw`, { y: -Y - 260, duration: 0.25, ease: "power2.in" }, t + dur - 0.25);
        tl.set(`#${id}`, { opacity: 0 }, t + dur);
      }
