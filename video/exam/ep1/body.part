      // ---------- ห้องสอบ EP.1 ----------
      // grammar: frame-0 action at the glass (phone filming → face slams) → stamp → calm wide (planted shoes) → clock → joke → scream →
      // the run to the door → the slam from inside → the rule sheet → lock + lights → hide → under-desk sight line → the broken latch →
      // the desk barricade → feet in the corridor → signs 3/1..3/3 → the shadow stops → held breath → the bag buzzes "แม่" → next card
      const ROOM = (id, o = {}) => ({ set: "examRoom", setOpts: { id, ...o }, dark: 0, light: o.dark ? NITE : DAYL, grade: o.dark ? GN : GD });
      const DOOR = (id, o = {}) => ({ set: "examDoor", setOpts: { id, ...o }, dark: 0, light: false, grade: o.dark ? GN : GD });
      const HALL = (id, o = {}) => ({ set: "examHall", setOpts: { id, ...o }, dark: 0, light: DAYL, grade: o.dark ? GN : GD });
      const ROWS = [[-430, 1700, "st1"], [0, 1700, "st2"], [430, 1700, "st3"], [-215, 1840, "st2"], [215, 1840, "st1"]];
      const kids = (eyes = "normal", mode = "sitChair") => ROWS.map(([x, y, w], k) => A(w, x, y, 0.62, [T(mode, eyes, "flat")], { flip: k % 2 === 1 }));
      const crack = (L, tl, id, t, cx, cy, s = 1) => {
        put(L.act, `<g id="${id}" opacity="0" stroke="#f4fbff" stroke-width="${3 * s}" fill="none" stroke-linecap="round">${Array.from({ length: 9 }, (_, k) => { const a = (k / 9) * Math.PI * 2, l = (60 + (k * 37) % 70) * s; return `<path d="M${cx},${cy}l${f1(Math.cos(a) * l * 0.5)},${f1(Math.sin(a) * l * 0.5)}l${f1(Math.cos(a + 0.3) * l * 0.5)},${f1(Math.sin(a + 0.3) * l * 0.5)}"/>`; }).join("")}</g>`);
        tl.fromTo(`#${id}`, { opacity: 0 }, { opacity: 0.95, duration: 0.05, immediateRender: false }, t);
      };
      const phoneHand = (L, id, x, y, s, screen, rot = -6) => put(L.act, `<g id="${id}">${Exam.phone(x, y, s, { screen, rot })}${handAt([x + 10 * s, y + 70 * s], 0, 0.75 * s, KIDSK, { fore: 900, band: "#f8f8f4" })}</g>`);

      // ---------- 1. hook: the glass panel, a phone up filming — the face slams the glass at 0.25 s ----------
      add("hook", {
        ...DOOR("d1", { face: true }),
        cam: { keys: [{ t: 0, ...fr(540, 900, 1.25, 540, 820) }, { t: D("hook"), glide: D("hook"), ...fr(540, 880, 1.4, 540, 820) }] },
        shake: (t) => (t > 0.25 && t < 0.7 ? { x: 16 * Math.sin(t * 80), y: 11 * Math.sin(t * 67), r: 0 } : 0),
        captions: caps("hook"),
        fx(tl, id, t0, L) {
          tl.fromTo("#d1-face", { scale: 0.45, y: 30, transformOrigin: "50% 50%" }, { scale: 1.12, y: 0, duration: 0.22, ease: "power4.in", immediateRender: false }, t0);
          tl.to("#d1-face", { scale: 1.06, duration: 0.3, ease: "back.out(3)" }, t0 + 0.22);
          tl.fromTo("#d1-face", { x: -4 }, { x: 4, duration: 0.09, yoyo: true, repeat: Math.ceil(D("hook") / 0.09), ease: "sine.inOut", immediateRender: false }, t0 + 0.5);
          crack(L, tl, "cr1", t0 + 0.24, 540, 900, 1.6);
          phoneHand(L, "ph1", 600, 1240, 1.6, "cam");
          tl.fromTo("#ph1", { y: 0, rotation: 0, svgOrigin: "600 1500" }, { y: 120, rotation: 12, svgOrigin: "600 1500", duration: 0.35, ease: "power2.out", immediateRender: false }, t0 + 0.28);
          impact(L, tl, t0 + 0.24, 540, 760, { col: "#e8f4fa", chip: "#cfe6f0", n: 14 });
        },
      });
      // ---------- 2. the command: the phone medal stamped ห้ามถ่าย ----------
      add("dont", {
        ...DOOR("d2", { face: true }), blur: BLUR,
        cam: { keys: [{ t: 0, ...still(fr(540, 880, 1.4, 540, 820)) }] },
        captions: caps("dont"),
        fx(tl, id, t0, L) { put(L.light, `<rect width="1080" height="1920" fill="#14100c" opacity=".4"/>`); ExamUI.nope(tl, L.light, t0, D("dont"), { icon: "phone", text: "ห้ามถ่าย", y: 640, stamp: 0.35 }); },
      });
      // ---------- 3. earlier, calm: the exam room wide (the extra shoes under the back cabinet, ~0:05) ----------
      add("calm", {
        ...ROOM("r3"),
        cam: { keys: [{ t: 0, ...fr(200, 1340, 0.56, 540, 1080) }, { t: D("calm"), glide: D("calm"), ...fr(150, 1360, 0.6, 540, 1080) }] },
        actors: [...kids(), A("orn", 1050, 1560, 0.78, [T("idle", "normal", "flat")], { flip: true })],
        captions: caps("calm"),
        fx(tl, id, t0) { Exam.life(tl, "r3", t0, D("calm")); },
      });
      // ---------- 4. 10:40 on the wall clock → the room: a late student shoves the back door, the latch drops ----------
      split("clock", 1.3, {
        ...ROOM("r4"),
        cam: { keys: [{ t: 0, ...still(fr(1230, 330, 2.4, 540, 820)) }] },
        captions: caps("clock"),
        fx(tl, id, t0) { Exam.life(tl, "r4", t0, 1.3); },
      }, {
        ...ROOM("r4b"),
        cam: { keys: [{ t: 0, ...fr(-900, 1300, 0.85, 540, 1100) }, { t: D("clock") - 1.3, glide: D("clock") - 1.3, ...fr(-950, 1320, 0.9, 540, 1100) }] },
        actors: [A("st3", -1100, 1520, 0.78, [T("walk", "normal", "smile")], { moveTo: { x: -900, y: 1560, dur: 1.4 } })],
        captions: capsFrom("clock", 1.3),
        fx(tl, id, t0) { tl.fromTo("#r4b-latch", { rotation: 30, y: 0, svgOrigin: "0 0" }, { rotation: 120, y: 260, svgOrigin: "0 0", duration: 0.5, ease: "bounce.out", immediateRender: false }, t0 + 0.3); },
      });
      // ---------- 5. บีม at his desk ----------
      add("joke", {
        ...ROOM("r5"), blur: { far: 4, mid: 4, set: 3, fg: 7 },
        cam: { keys: [{ t: 0, ...still(fr(0, 1460, 1.5, 540, 1150)) }] },
        actors: [A("beam", 0, 1760, 0.75, [T("sitChair", "normal", "smile"), T("raise", "normal", "laugh", 0.6)], { talk: [TALK("joke", 0, "smile")] }), A("st2", -330, 1740, 0.72, [T("sitChair", "side", "flat")])],
        captions: caps("joke", undefined, QUO),
      });
      // ---------- 6. the scream: the corridor, a figure lurching at the far end ----------
      add("scream", {
        ...HALL("h6"),
        cam: { keys: [{ t: 0, ...fr(800, 1200, 0.62, 540, 1050) }, { t: D("scream"), glide: D("scream"), ...fr(1400, 1200, 0.75, 540, 1050) }] },
        actors: [A("zs1", 1900, 1500, 0.8, [T("shamble", "glow", "snarl")], { flip: true, moveTo: { x: 1700, y: 1520, dur: D("scream") } })],
        captions: caps("scream"),
      });
      // ---------- 7. บีม: viral! — he runs to the door, phone up ----------
      add("viral", {
        ...ROOM("r7"),
        cam: { keys: [{ t: 0, ...fr(900, 1300, 0.8, 540, 1100) }] },
        actors: [A("beamPhone", 700, 1720, 0.78, [T("run", "wide", "laugh")], { moveTo: { x: 1150, y: 1560, dur: D("viral") } })],
        captions: caps("viral", undefined, QUO),
      });
      // ---------- 8. the slam from inside: the face hits the glass over บีม's phone; he falls back ----------
      add("slam", {
        ...ROOM("r8", { face: true }),
        cam: { keys: [{ t: 0, ...still(fr(1300, 1150, 1.1, 540, 1000)) }] },
        shake: (t) => (t > 0.15 && t < 0.6 ? { x: 14 * Math.sin(t * 80), y: 10 * Math.sin(t * 63), r: 0 } : 0),
        actors: [A("beamPhone", 1180, 1560, 0.8, [T("film", "normal", "o"), T("fall", "wide", "scream", 0.2)])],
        fx(tl, id, t0, L) { tl.fromTo("#r8-face", { scale: 0.5, transformOrigin: "50% 50%" }, { scale: 1.1, duration: 0.15, ease: "power4.in", immediateRender: false }, t0); impact(L, tl, t0 + 0.15, 540, 760, { col: "#e8f4fa", chip: "#cfe6f0" }); },
      });
      // ---------- 9. ครูอร: ล็อก ปิด หลบ เงียบ + the rule sheet ----------
      add("rule", {
        ...ROOM("r9"), blur: { far: 3, mid: 3, set: 2, fg: 7 },
        cam: { keys: [{ t: 0, ...still(fr(1000, 1300, 1.25, 540, 1250)) }] },
        actors: [A("orn", 1000, 1760, 1.0, [T("point", "angry", "scream")], { talk: [TALK("rule", 0, "scream")] })],
        captions: caps("rule", undefined, QUO),
        fx(tl, id, t0, L) { ExamUI.rules(tl, L.light, t0 + 0.05, D("rule"), { y: 220, s: 0.92, at: [0.2, 0.55, 0.9, 1.3] }); },
      });
      // ---------- 10. she turns the lock, hits the switch — lights out ----------
      add("lock", {
        ...DOOR("d10"),
        cam: { keys: [{ t: 0, ...fr(700, 1150, 1.2, 540, 1000) }, { t: D("lock"), glide: D("lock"), ...fr(820, 1000, 1.3, 540, 1000) }] },
        captions: caps("lock"),
        fx(tl, id, t0, L) {
          tl.fromTo("#d10-knob", { rotation: 0, svgOrigin: "90 -270" }, { rotation: 90, svgOrigin: "90 -270", duration: 0.3, ease: "back.out(2)", immediateRender: false }, t0 + 0.3);
          put(L.light, `<rect id="dk10" width="1080" height="1920" fill="#060912" opacity="0"/>`);
          tl.fromTo("#dk10", { opacity: 0 }, { opacity: 0.62, duration: 0.12, immediateRender: false }, t0 + F("lock", 0, 1) - 0.1);
        },
      });
      // ---------- 11. everyone flat along the door wall, below the glass ----------
      add("hide", {
        ...ROOM("r11", { dark: 0.85, desk: "front" }),
        cam: { keys: [{ t: 0, ...fr(1050, 1500, 0.95, 540, 1150) }, { t: D("hide"), glide: D("hide"), ...fr(1080, 1520, 1.0, 540, 1150) }] },
        actors: [["fon", 900], ["st2", 1040], ["beam", 1180], ["orn", 1380]].map(([w, x]) => A(w, x, 1640, w === "orn" ? 0.82 : 0.76, [T("crouchHide", "wide", "flat")])),
        captions: caps("hide"),
      });
      // ---------- 12. the under-desk mistake: the sight line from the glass finds him ----------
      add("desk", {
        ...ROOM("r12", { dark: 0.85 }),
        cam: { keys: [{ t: 0, ...still(fr(500, 1400, 0.72, 540, 1100)) }] },
        actors: [A("st3", 0, 1740, 0.6, [T("crouch", "wide", "flat")], { moveTo: { x: 700, y: 1740, at: 2.2, dur: 0.8 } })],
        captions: caps("desk"),
        fx(tl, id, t0, L) {
          put(L.glow, `<path id="sl12" d="M1300,1080L0,1700" stroke="#ff5a3a" stroke-width="10" stroke-dasharray="26 16" opacity="0"/><circle id="sl12c" cx="0" cy="1700" r="90" fill="none" stroke="#ff5a3a" stroke-width="10" opacity="0"/>`);
          tl.to(["#sl12", "#sl12c"], { opacity: 1, duration: 0.25, immediateRender: false }, t0 + F("desk", 0, 1));
          tl.to(["#sl12", "#sl12c"], { opacity: 0, duration: 0.2, immediateRender: false }, t0 + 2.2);
        },
      });
      // ---------- 13. the back door drifts open: the latch is broken ----------
      add("latch", {
        ...ROOM("r13", { dark: 0.85 }),
        cam: { keys: [{ t: 0, ...fr(-1100, 1240, 1.1, 540, 1000) }, { t: D("latch"), glide: D("latch"), ...fr(-1100, 1240, 1.25, 540, 1000) }] },
        captions: caps("latch"),
        fx(tl, id, t0) { tl.fromTo("#r13b-door", { scaleX: 1, svgOrigin: "-116 0" }, { scaleX: 0.82, svgOrigin: "-116 0", duration: 1.4, ease: "sine.inOut", immediateRender: false }, t0 + 0.3); },
      });
      // ---------- 14. ฝน: drag the desk! — they shove the teacher's desk against the back door ----------
      add("drag", {
        ...ROOM("r14", { dark: 0.7 }),
        cam: { keys: [{ t: 0, ...fr(-700, 1400, 0.8, 540, 1150) }, { t: D("drag"), glide: D("drag"), ...fr(-850, 1420, 0.9, 540, 1150) }] },
        shake: (t) => (t > D("drag") - 0.9 && t < D("drag") - 0.5 ? { x: 10 * Math.sin(t * 70), y: 6 * Math.sin(t * 57), r: 0 } : 0),
        actors: [A("fon", -300, 1640, 0.8, [T("drag", "angry", "scream")], { talk: [TALK("drag", 0, "scream")], moveTo: { x: -720, y: 1600, dur: D("drag") - 0.9, ease: "power1.in" } }),
          A("beam", -120, 1650, 0.8, [T("drag", "wide", "o")], { moveTo: { x: -540, y: 1610, dur: D("drag") - 0.9, ease: "power1.in" } })],
        captions: [...caps("drag", [0], QUO), ...caps("drag", [1])],
        fx(tl, id, t0, L) {
          tl.fromTo("#r14-tdesk", { attr: { transform: "translate(-200,1520)" } }, { attr: { transform: "translate(-860,1500)" }, duration: D("drag") - 0.9, ease: "power1.in", immediateRender: false }, t0);
          tl.fromTo("#r14b-door", { scaleX: 0.82, svgOrigin: "-116 0" }, { scaleX: 1, svgOrigin: "-116 0", duration: 0.25, ease: "power3.in", immediateRender: false }, t0 + D("drag") - 1.1);
          impact(L, tl, t0 + D("drag") - 0.9, 300, 1050, { col: "#d8c8a8", chip: "#8a6440" });
        },
      });
      // ---------- 15. the corridor floor: dragging feet ----------
      add("steps", {
        ...HALL("h15"),
        cam: { keys: [{ t: 0, ...fr(-300, 1500, 1.4, 540, 1300) }, { t: D("steps"), glide: D("steps"), ...fr(100, 1500, 1.4, 540, 1300) }] },
        actors: [A("zs2", -700, 1700, 1.0, [T("shamble", "glow", "snarl")], { moveTo: { x: 200, y: 1700, dur: D("steps") } })],
        captions: caps("steps"),
      });
      // ---------- 16. the room signs light up one by one: 3/1 … 3/2 … 3/3 ----------
      add("rooms", {
        ...HALL("h16", { dark: 0.4 }),
        cam: { keys: [{ t: 0, ...fr(-1100, 900, 1.0, 540, 900) }, { t: D("rooms"), glide: D("rooms"), ...fr(500, 900, 1.0, 540, 900) }] },
        captions: caps("rooms"),
        fx(tl, id, t0, L) { [0, 1, 2].forEach((k) => { tl.fromTo(`#h16-sign${k}`, { scale: 1, svgOrigin: `${-1100 + k * 800} -605` }, { scale: 1.25, svgOrigin: `${-1100 + k * 800} -605`, duration: 0.2, yoyo: true, repeat: 1, ease: "back.out(3)", immediateRender: false }, t0 + F("rooms", 0, k)); }); },
      });
      // ---------- 17. inside: the shadow at the glass stops ----------
      add("stop", {
        ...DOOR("d17", { dark: 0.8 }),
        cam: { keys: [{ t: 0, ...fr(540, 900, 1.2, 540, 820) }, { t: D("stop"), glide: D("stop"), ...fr(540, 900, 1.35, 540, 820) }] },
        captions: caps("stop"),
        fx(tl, id, t0, L) { put(L.glow, `<g id="sh17" opacity="0"><ellipse cx="540" cy="900" rx="70" ry="110" fill="#06080c" opacity=".85"/><circle cx="520" cy="860" r="7" fill="#c8f0b0"/><circle cx="560" cy="860" r="7" fill="#c8f0b0"/></g>`); tl.fromTo("#sh17", { opacity: 0, x: -200 }, { opacity: 1, x: 0, duration: 1.0, ease: "power1.out", immediateRender: false }, t0 + 0.1); },
      });
      // ---------- 18. ฝน holding her breath ----------
      add("breath", {
        ...ROOM("r18", { dark: 0.85 }), blur: { far: 5, mid: 5, set: 4, fg: 7 },
        cam: { keys: [{ t: 0, ...fr(900, 1250, 2.0, 540, 1000) }, { t: D("breath"), glide: D("breath"), ...fr(900, 1250, 2.2, 540, 1000) }] },
        actors: [A("fon", 900, 1640, 0.76, [T("crouchHide", "wide", "flat")])],
        captions: caps("breath"),
      });
      // ---------- 19. a bag lights up buzzing: แม่ — the shadow at the glass turns ----------
      split("buzz", 1.6, {
        ...ROOM("r19", { dark: 0.9 }),
        cam: { keys: [{ t: 0, ...still(fr(300, 1650, 1.6, 540, 1000)) }] },
        captions: caps("buzz"),
        fx(tl, id, t0, L) { put(L.act, `<g id="bg19" transform="translate(300,1650)"><path d="M-120,0Q-130,-160 -90,-200H90Q130,-160 120,0Z" fill="#2a3a6a" stroke="${INK}" stroke-width="4"/><g id="bg19p">${Exam.phone(10, -170, 0.9, { screen: "mom", rot: -14 })}</g></g>`);
          tl.fromTo("#bg19p", { x: -3 }, { x: 3, duration: 0.05, yoyo: true, repeat: 30, immediateRender: false }, t0 + 0.4); },
      }, {
        ...DOOR("d19", { dark: 0.8 }),
        cam: { keys: [{ t: 0, ...fr(540, 900, 1.35, 540, 820) }, { t: D("buzz") - 1.6, glide: 0.4, ...fr(540, 880, 1.7, 540, 820) }] },
        captions: capsFrom("buzz", 1.6),
        fx(tl, id, t0, L) { put(L.glow, `<g id="sh19"><ellipse cx="540" cy="900" rx="70" ry="110" fill="#06080c" opacity=".85"/><circle cx="520" cy="860" r="9" fill="#e8ffd0"/><circle cx="560" cy="860" r="9" fill="#e8ffd0"/></g>`);
          tl.fromTo("#sh19", { scaleX: -1, svgOrigin: "540 900" }, { scaleX: 1, svgOrigin: "540 900", duration: 0.3, ease: "power3.out", immediateRender: false }, t0 + 0.4); blackOut(tl, L, t0 + D("buzz") - 1.6 - 0.2, 0.15); },
      });
      // ---------- 20. next card ----------
      add("next", {
        ...ROOM("r20", { dark: 0.9 }), blur: BLUR,
        cam: { keys: [{ t: 0, ...still(fr(300, 1300, 0.7, 540, 1000)) }] },
        fx(tl, id, t0, L) { ExamUI.next(tl, L.light, t0, D("next"), { l1: "ถ้าซอมบี้บุกโรงเรียน แล้วแม่โทรมา…", l2: "อย่ารับสาย" }); },
      });
