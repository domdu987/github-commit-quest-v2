      // ---------- ห้องสอบ EP.1 ----------
      // grammar: frame-0 action at the glass (phone filming → face slams) → stamp → calm wide (planted shoes) → clock → joke → scream →
      // the run to the door → the slam from inside → the rule sheet → lock + lights → hide → under-desk sight line → the broken latch →
      // the desk barricade → feet in the corridor → signs 3/1..3/3 → the shadow stops → held breath → the bag buzzes "แม่" → next card
      // pulling the teacher's desk: both feet planted, front knee bent, leaning back, arms straight to the desk edge
      Rig.MODES.dragFloor = (u, o) => { const m = Rig.MODES.dragHard(u, o), j = Math.sin(u * 7); return { ...m, thF: -34 + 3 * j, shF: 44, thB: 12, shB: 8, bodyY: 64 + 4 * j, rootX: 0, rootR: -2 }; };
      const ROOM = (id, o = {}) => ({ set: "examRoom", setOpts: { id, ...o }, dark: 0, light: o.dark ? NITE : DAYL, grade: o.dark ? GN : GD });
      const DOOR = (id, o = {}) => ({ set: "examDoor", setOpts: { id, ...o }, dark: 0, light: false, grade: o.dark ? GN : GD });
      const HALL = (id, o = {}) => ({ set: "examHall", setOpts: { id, ...o }, dark: 0, light: DAYL, grade: o.dark ? GN : GD });
      const ROWS = [[-430, 1700, "st1"], [0, 1700, "st2"], [430, 1700, "st3"], [-215, 1840, "st2"], [215, 1840, "st1"]];
      const kids = (eyes = "normal", mode = "sitChair") => ROWS.map(([x, y, w], k) => A(w, x, y, 0.62, [T(mode, eyes, "flat")], { flip: k % 2 === 1 }));
      const crack = (L, tl, id, t, cx, cy, s = 1) => {
        put(L.act, `<g id="${id}" opacity="0" stroke="#f4fbff" stroke-width="${3 * s}" fill="none" stroke-linecap="round">${Array.from({ length: 9 }, (_, k) => { const a = (k / 9) * Math.PI * 2, l = (60 + (k * 37) % 70) * s; return `<path d="M${cx},${cy}l${f1(Math.cos(a) * l * 0.5)},${f1(Math.sin(a) * l * 0.5)}l${f1(Math.cos(a + 0.3) * l * 0.5)},${f1(Math.sin(a + 0.3) * l * 0.5)}"/>`; }).join("")}</g>`);
        tl.fromTo(`#${id}`, { opacity: 0 }, { opacity: 0.95, duration: 0.05, immediateRender: false }, t);
      };
      const phoneHand = (L, id, x, y, s, screen, rot = -6) => put(L.act, `<g id="${id}">${Exam.phone(x, y, s, { screen, rot })}${handAt([x + 10 * s, y + 70 * s], 0, 0.75 * s, KIDSK, { fore: 900, band: "#f8f8f4" })}</g>`);

      // world point in L.fg (parallax 1.5) that lands on screen (sx, sy) under the camera c = fr(...)
      const fgAt = (c, sx, sy) => { const ls = 1 + (c.s - 1) * 1.5; return [(sx - 540) / ls + 540 + 1.5 * c.x, (sy - 960) / ls + 960 + 1.5 * c.y, ls]; };
      const fgDesk = (L, c, sx, sy, sz = 1.6) => { const [x, y, ls] = fgAt(c, sx, sy); put(L.fg, `<g transform="translate(${f1(x)},${f1(y)}) scale(${(sz / ls).toFixed(3)})">${Exam.desk(0, 0, 1)}</g>`); };
      // the room alive: fans, the second hand, dust turning in the window light
      const roomLife = (tl, L, id, t0, dur, n = 46) => { Exam.life(tl, id, t0, dur); Pop2.particles(tl, L.glow, { type: "dust", n, box: [-1250, 340, 1800, 1300], t0, dur, seed: (id.length * 31 + n) | 0 }); };
      const HALLD = (id, o = {}) => ({ set: "examHallDeep", setOpts: { id, ...o }, dark: 0, light: NITE, grade: GN });
      const GLASS = (id, o = {}) => ({ set: "examGlass", setOpts: { id, ...o }, dark: 0, light: false, grade: GD });
      const hand = (t) => ({ x: 5 * Math.sin(t * 6.1) + 3 * Math.sin(t * 13.7), y: 4 * Math.sin(t * 5.3) + 2 * Math.sin(t * 11.1), r: 0.5 * Math.sin(t * 4.3) });
      // glass shards flying at the lens from screen point (x, y)
      const shards = (tl, L, t, x, y, n = 14) => { const id = `sd${Math.round(t * 100)}`;
        put(L.light, `<g id="${id}">${Array.from({ length: n }, (_, k) => `<path id="${id}-${k}" d="M0,0l${18 + (k * 13) % 30},${-10 - (k * 7) % 20}l${-6 - (k * 5) % 14},${30 + (k * 11) % 26}z" fill="#eaf6fc" stroke="#9ab8c8" stroke-width="2" opacity="0" transform="translate(${x},${y})"/>`).join("")}</g>`);
        for (let k = 0; k < n; k++) { const a = (k / n) * Math.PI * 2 + 0.3, v = 380 + (k * 53) % 260;
          tl.fromTo(`#${id}-${k}`, { opacity: 1, x: 0, y: 0, scale: 0.4, rotation: 0 }, { opacity: 0, x: Math.cos(a) * v, y: Math.sin(a) * v, scale: 3.4, rotation: 160 + k * 30, duration: 0.55, ease: "power2.out", immediateRender: false }, t); } };
      const pov = (tl, L, id, t0, dur, o = {}) => { put(L.light, Exam.pov(id, o));
        tl.fromTo(`#${id}-rec`, { opacity: 1 }, { opacity: 0.15, duration: 0.3, yoyo: true, repeat: Math.ceil(dur / 0.3), ease: "steps(1)", immediateRender: false }, t0);
        tl.fromTo(`#${id}-af`, { scale: 1.12, svgOrigin: "540 770" }, { scale: 1, svgOrigin: "540 770", duration: 0.25, ease: "back.out(3)", immediateRender: false }, t0 + 0.05);
        tl.fromTo(`#${id}`, { x: 0, y: 0 }, { x: 2, y: 3, duration: 0.11, yoyo: true, repeat: Math.ceil(dur / 0.11), ease: "sine.inOut", immediateRender: false }, t0); };

      // ---------- 1. hook: บีม's phone POV — frame 0 the face SLAMS the glass, cracks and shards fly at the lens ----------
      add("hook", {
        ...GLASS("g1"),
        cam: { keys: [{ t: 0, ...fr(540, 870, 1.22, 540, 900) }, { t: D("hook"), glide: D("hook"), ...fr(540, 880, 1.32, 540, 900) }] },
        shake: (t) => { const h = hand(t); const b = (t < 0.5 ? 1 - t / 0.5 : 0) + (t > 1.2 && t < 1.5 ? 0.6 * (1 - (t - 1.2) / 0.3) : 0); return { x: h.x + 26 * b * Math.sin(t * 83), y: h.y + 18 * b * Math.sin(t * 67), r: h.r + 1.4 * b * Math.sin(t * 51) }; },
        captions: caps("hook"),
        fx(tl, id, t0, L) {
          tl.fromTo("#g1-fw", { scale: 1.16, svgOrigin: "540 900" }, { scale: 1, svgOrigin: "540 900", duration: 0.35, ease: "back.out(3)", immediateRender: false }, t0);
          tl.fromTo("#g1-face", { rotation: -3, svgOrigin: "0 0" }, { rotation: 3, svgOrigin: "0 0", duration: 0.14, yoyo: true, repeat: Math.ceil(D("hook") / 0.14), ease: "sine.inOut", immediateRender: false }, t0 + 0.35);
          tl.fromTo("#g1-hand", { opacity: 0, scale: 1.4, svgOrigin: "860 1100" }, { opacity: 1, scale: 1, svgOrigin: "860 1100", duration: 0.12, ease: "power4.in", immediateRender: false }, t0 + 1.2);
          tl.fromTo("#g1-fw", { scale: 1 }, { scale: 1.08, svgOrigin: "540 900", duration: 0.1, yoyo: true, repeat: 1, ease: "power3.in", immediateRender: false }, t0 + 1.2);
          crack(L, tl, "cr1", t0, 540, 760, 2.6); crack(L, tl, "cr1b", t0 + 1.25, 820, 1120, 1.8);
          impact(L, tl, t0, 540, 760, { col: "#e8f4fa", chip: "#cfe6f0", n: 16 }); shards(tl, L, t0, 540, 760); shards(tl, L, t0 + 1.25, 800, 1100, 8);
          pov(tl, L, "pv1", t0, D("hook"), { sec: 7 });
          tl.fromTo("#pv1", { y: 40, rotation: 3, svgOrigin: "540 1900" }, { y: 0, rotation: 0, svgOrigin: "540 1900", duration: 0.4, ease: "back.out(2)", immediateRender: false }, t0);
        },
      });
      // ---------- 2. the command: the phone medal stamped ห้ามถ่าย (the face still working at the glass behind) ----------
      add("dont", {
        ...GLASS("g2", { hand: true }), blur: { set: 8, act: 8 },
        cam: { keys: [{ t: 0, ...fr(540, 880, 1.32, 540, 900) }, { t: D("dont"), glide: D("dont"), ...fr(540, 880, 1.4, 540, 900) }] },
        shake: hand,
        captions: caps("dont"),
        fx(tl, id, t0, L) {
          tl.fromTo("#g2-face", { rotation: -3, svgOrigin: "0 0" }, { rotation: 3, svgOrigin: "0 0", duration: 0.14, yoyo: true, repeat: Math.ceil(D("dont") / 0.14), ease: "sine.inOut", immediateRender: false }, t0);
          crack(L, tl, "cr2", t0 - 0.05, 540, 760, 2.6);
          pov(tl, L, "pv2", t0, D("dont"), { sec: 9 });
          put(L.light, `<rect width="1080" height="1920" fill="#14100c" opacity=".45"/>`); ExamUI.nope(tl, L.light, t0, D("dont"), { icon: "phone", text: "ห้ามถ่าย", y: 640, stamp: 0.35 });
        },
      });
      // ---------- 3. earlier, calm: the exam room in the afternoon light (the extra shoes under the back cabinet, ~0:05) ----------
      const C3 = fr(110, 1380, 0.64, 540, 1080);
      add("calm", {
        ...ROOM("r3"), blur: { fg: 7 },
        cam: { keys: [{ t: 0, ...C3 }, { t: D("calm"), glide: D("calm"), ...fr(60, 1400, 0.7, 540, 1080) }] },
        actors: [...kids(), A("orn", 1050, 1560, 0.78, [T("walk", "normal", "flat")], { flip: true, moveTo: { x: 760, y: 1580, dur: D("calm") } })],
        captions: caps("calm"),
        fx(tl, id, t0, L) { roomLife(tl, L, "r3", t0, D("calm")); fgDesk(L, C3, 900, 1900, 1.5); },
      });
      // ---------- 4. 10:40 on the wall clock (the second hand ticking) → a late student shoves the back door, the latch drops ----------
      split("clock", 1.3, {
        ...ROOM("r4"),
        cam: { keys: [{ t: 0, ...fr(1230, 330, 2.4, 540, 820) }, { t: 1.3, glide: 1.3, ...fr(1230, 330, 2.7, 540, 820) }] },
        captions: caps("clock"),
        fx(tl, id, t0) { Exam.life(tl, "r4", t0, 1.3); },
      }, {
        ...ROOM("r4b"), blur: { fg: 7 },
        cam: { keys: [{ t: 0, ...fr(-880, 1300, 1.0, 540, 1100) }, { t: D("clock") - 1.3, glide: D("clock") - 1.3, ...fr(-940, 1320, 1.08, 540, 1100) }] },
        actors: [A("st3", -1100, 1520, 0.84, [T("walk", "normal", "smile")], { moveTo: { x: -880, y: 1580, dur: 1.4 } })],
        captions: capsFrom("clock", 1.3),
        fx(tl, id, t0, L) { roomLife(tl, L, "r4b", t0, D("clock") - 1.3, 30); fgDesk(L, fr(-880, 1300, 1.0, 540, 1100), 160, 1880, 1.7);
          tl.fromTo("#r4b-latch", { rotation: 30, y: 0, svgOrigin: "0 0" }, { rotation: 120, y: 260, svgOrigin: "0 0", duration: 0.5, ease: "bounce.out", immediateRender: false }, t0 + 0.3); },
      });
      // ---------- 5. บีม at his desk, close ----------
      add("joke", {
        ...ROOM("r5"), blur: { far: 4, mid: 4, set: 3, fg: 7 },
        cam: { keys: [{ t: 0, ...fr(0, 1440, 1.75, 540, 1150) }, { t: D("joke"), glide: D("joke"), ...fr(10, 1440, 1.9, 540, 1150) }] },
        actors: [A("beam", 0, 1760, 0.75, [T("sitChair", "normal", "smile"), T("raise", "normal", "laugh", 0.6)], { talk: [TALK("joke", 0, "smile")] }), A("st2", -330, 1740, 0.72, [T("sitChair", "side", "flat")])],
        captions: caps("joke", undefined, QUO),
        fx(tl, id, t0, L) { roomLife(tl, L, "r5", t0, D("joke"), 26); },
      });
      // ---------- 6. the scream: the corridor, tubes flickering, two infected lurching out of the far doors ----------
      add("scream", {
        ...HALLD("h6", { dark: 0.4 }),
        cam: { keys: [{ t: 0, ...fr(540, 1000, 1.0, 540, 960) }, { t: D("scream"), glide: D("scream"), ...fr(540, 1010, 1.22, 540, 960) }] },
        shake: (t) => ({ x: 3 * Math.sin(t * 5.1), y: 2 * Math.sin(t * 4.3), r: 0 }),
        actors: [A("zs1", 420, 1160, 0.36, [T("shamble", "glow", "snarl")], { moveTo: { x: 470, y: 1230, s: 0.48, dur: D("scream") } }),
          A("zs2", 760, 1240, 0.55, [T("shamble", "glow", "snarl", 0.3)], { flip: true, moveTo: { x: 660, y: 1330, s: 0.72, dur: D("scream") } })],
        captions: caps("scream"),
        fx(tl, id, t0) { Exam.flicker(tl, "h6", t0, D("scream")); },
      });
      // ---------- 7. บีม: viral! — he runs to the door, phone up ----------
      const C7 = fr(950, 1320, 1.0, 540, 1100);
      add("viral", {
        ...ROOM("r7"), blur: { fg: 7 },
        cam: { keys: [{ t: 0, ...C7 }, { t: D("viral"), glide: D("viral"), ...fr(1120, 1300, 1.12, 540, 1100) }] },
        actors: [A("beamPhone", 650, 1720, 0.86, [T("run", "wide", "laugh")], { moveTo: { x: 1130, y: 1580, dur: D("viral") } })],
        captions: caps("viral", undefined, QUO),
        fx(tl, id, t0, L) { roomLife(tl, L, "r7", t0, D("viral"), 26); fgDesk(L, C7, 180, 1900, 1.7); },
      });
      // ---------- 8. the slam from inside: the face hits the glass over บีม's phone — he staggers, sits down hard, scoots back ----------
      add("slam", {
        ...ROOM("r8", { face: true }),
        cam: { keys: [{ t: 0, ...fr(1230, 1260, 1.25, 540, 1000) }, { t: D("slam"), glide: D("slam"), ...fr(1150, 1330, 1.15, 540, 1000) }] },
        shake: (t) => (t > 0.12 && t < 0.6 ? { x: 16 * Math.sin(t * 80), y: 11 * Math.sin(t * 63), r: 0 } : 0),
        actors: [A("beamPhone", 1170, 1560, 0.86, [T("film", "normal", "o"), T("fallBack", "wide", "scream", 0.14)])],
        fx(tl, id, t0, L) { tl.fromTo("#r8-face", { scale: 0.5, transformOrigin: "50% 50%" }, { scale: 1.1, duration: 0.12, ease: "power4.in", immediateRender: false }, t0); impact(L, tl, t0 + 0.12, 700, 560, { col: "#e8f4fa", chip: "#cfe6f0" });
          impact(L, tl, t0 + 0.14 + 0.45, 420, 1500, { col: "#d8c8a8", chip: "#8a6440", n: 6 }); },
      });
      // ---------- 9. ครูอร: ล็อก ปิด หลบ เงียบ + the rule sheet ----------
      add("rule", {
        ...ROOM("r9"), blur: { far: 3, mid: 3, set: 2, fg: 7 },
        cam: { keys: [{ t: 0, ...still(fr(1000, 1300, 1.25, 540, 1250)) }] },
        actors: [A("orn", 1000, 1760, 1.0, [T("point", "angry", "scream")], { talk: [TALK("rule", 0, "scream")] })],
        captions: caps("rule", undefined, QUO),
        fx(tl, id, t0, L) { ExamUI.rules(tl, L.light, t0 + 0.05, D("rule"), { y: 220, s: 0.92, at: [0.2, 0.55, 0.9, 1.3] }); },
      });
      // ---------- 10. she turns the lock, hits the switch — lights out ----------
      add("lock", {
        ...DOOR("d10"),
        cam: { keys: [{ t: 0, ...fr(700, 1150, 1.2, 540, 1000) }, { t: D("lock"), glide: D("lock"), ...fr(820, 1000, 1.3, 540, 1000) }] },
        captions: caps("lock"),
        fx(tl, id, t0, L) {
          tl.fromTo("#d10-knob", { rotation: 0, svgOrigin: "90 -270" }, { rotation: 90, svgOrigin: "90 -270", duration: 0.3, ease: "back.out(2)", immediateRender: false }, t0 + 0.3);
          put(L.light, `<rect id="dk10" width="1080" height="1920" fill="#060912" opacity="0"/>`);
          tl.fromTo("#dk10", { opacity: 0 }, { opacity: 0.62, duration: 0.12, immediateRender: false }, t0 + F("lock", 0, 1) - 0.1);
        },
      });
      // ---------- 11. everyone flat along the door wall, below the glass, trembling (curtains shut, the door's light on the floor) ----------
      add("hide", {
        ...ROOM("r11", { dark: 0.85, desk: "front" }),
        cam: { keys: [{ t: 0, ...fr(1080, 1480, 1.1, 540, 1150) }, { t: D("hide"), glide: D("hide"), ...fr(1100, 1500, 1.2, 540, 1150) }] },
        actors: [A("fon", 1180, 1555, 0.7, [T("sit", "wide", "flat")]), A("beam", 930, 1680, 0.8, [T("crouch", "wide", "o", 0.1)]), A("orn", 1480, 1585, 0.78, [T("crouchHide", "worry", "flat", 0.2)], { flip: true }), A("st2", 760, 1830, 1.0, [T("hideShake", "wide", "flat", 0.3)])],
        captions: caps("hide"),
      });
      // ---------- 12. the under-desk mistake: the sight line from the glass finds him ----------
      add("desk", {
        ...ROOM("r12", { dark: 0.85 }),
        cam: { keys: [{ t: 0, ...still(fr(500, 1400, 0.72, 540, 1100)) }] },
        actors: [A("st3", 0, 1740, 0.6, [T("crouch", "wide", "flat")], { moveTo: { x: 700, y: 1740, at: 2.2, dur: 0.8 } })],
        captions: caps("desk"),
        fx(tl, id, t0, L) {
          put(L.glow, `<path id="sl12" d="M1300,1080L0,1700" stroke="#ff5a3a" stroke-width="10" stroke-dasharray="26 16" opacity="0"/><circle id="sl12c" cx="0" cy="1700" r="90" fill="none" stroke="#ff5a3a" stroke-width="10" opacity="0"/>`);
          tl.to(["#sl12", "#sl12c"], { opacity: 1, duration: 0.25, immediateRender: false }, t0 + F("desk", 0, 1));
          tl.to(["#sl12", "#sl12c"], { opacity: 0, duration: 0.2, immediateRender: false }, t0 + 2.2);
        },
      });
      // ---------- 13. the back door drifts open: the latch is broken ----------
      add("latch", {
        ...ROOM("r13", { dark: 0.85 }),
        cam: { keys: [{ t: 0, ...fr(-1100, 1240, 1.1, 540, 1000) }, { t: D("latch"), glide: D("latch"), ...fr(-1100, 1240, 1.25, 540, 1000) }] },
        captions: caps("latch"),
        fx(tl, id, t0) { tl.fromTo("#r13b-door", { scaleX: 1, svgOrigin: "-116 0" }, { scaleX: 0.82, svgOrigin: "-116 0", duration: 1.4, ease: "sine.inOut", immediateRender: false }, t0 + 0.3); },
      });
      // ---------- 14. ฝน: drag the desk! — low and close: she hauls the teacher's desk backwards, บีม shoves, legs scraping ----------
      add("drag", {
        ...ROOM("r14", { dark: 0.7 }), blur: { fg: 8 },
        cam: { keys: [{ t: 0, ...fr(-560, 1440, 0.8, 540, 1150) }, { t: D("drag"), glide: D("drag"), ...fr(-700, 1450, 0.88, 540, 1150) }] },
        shake: (t) => { const e = D("drag") - 0.9; return t > e && t < e + 0.4 ? { x: 12 * Math.sin(t * 70), y: 8 * Math.sin(t * 57), r: 0 } : { x: 2 * Math.sin(t * 9), y: 1.5 * Math.sin(t * 7.3), r: 0 }; },
        actors: [A("fon", -520, 1640, 0.86, [T("dragFloor", "angry", "scream")], { talk: [TALK("drag", 0, "scream")], moveTo: { x: -1150, y: 1650, dur: D("drag") - 0.9, ease: "power1.in" } }),
          A("beam", 150, 1600, 0.84, [T("shove", "wide", "o")], { moveTo: { x: -480, y: 1610, dur: D("drag") - 0.9, ease: "power1.in" } })],
        captions: [...caps("drag", [0], QUO), ...caps("drag", [1])],
        fx(tl, id, t0, L) {
          const dd = D("drag") - 0.9, X = (u) => -200 - 660 * u * u;
          tl.fromTo("#r14-tdm", { x: -1260, y: 40 }, { x: -1920, y: 20, duration: dd, ease: "power1.in", immediateRender: false }, t0);
          // scrape: dust puffs at the desk's legs + streaks left on the floor
          for (let k = 0; k < 13; k++) { const u = (k + 0.5) / 13, x = X(u), t = t0 + u * dd, pid = `scr14-${k}`;
            put(L.act, `<g id="${pid}" opacity="0"><circle cx="${f1(x + 220)}" cy="1512" r="26" fill="#d8c8a8"/><circle cx="${f1(x - 220)}" cy="1512" r="22" fill="#d8c8a8"/><path d="M${f1(x + 200)},1518h${f1(90 + k * 6)}M${f1(x - 240)},1520h${f1(80 + k * 6)}" stroke="#6a5a44" stroke-width="5" opacity=".7"/></g>`);
            tl.fromTo(`#${pid}`, { opacity: 0.85, y: 0, scale: 0.6, transformOrigin: "50% 100%" }, { opacity: 0, y: -50, scale: 1.8, duration: 0.6, ease: "power2.out", immediateRender: false }, t); }
          tl.fromTo("#r14b-door", { scaleX: 0.82, svgOrigin: "-116 0" }, { scaleX: 1, svgOrigin: "-116 0", duration: 0.25, ease: "power3.in", immediateRender: false }, t0 + dd - 0.2);
          impact(L, tl, t0 + dd, 230, 1180, { col: "#d8c8a8", chip: "#8a6440" });
          fgDesk(L, fr(-560, 1440, 0.8, 540, 1150), 960, 1960, 1.6);
        },
      });
      // ---------- 15. the corridor: tubes flickering, three of them dragging their feet toward the classrooms ----------
      add("steps", {
        ...HALLD("h15", { dark: 0.45 }),
        cam: { keys: [{ t: 0, ...fr(540, 1060, 1.05, 540, 960) }, { t: D("steps"), glide: D("steps"), ...fr(540, 1080, 1.2, 540, 960) }] },
        shake: (t) => ({ x: 3 * Math.sin(t * 4.7), y: 2 * Math.sin(t * 3.9), r: 0 }),
        actors: [A("zs2", 470, 1150, 0.34, [T("shamble", "glow", "snarl", 0.4)], { moveTo: { x: 500, y: 1200, s: 0.42, dur: D("steps") } }),
          A("zs1", 720, 1300, 0.7, [T("shamble", "glow", "snarl")], { flip: true, moveTo: { x: 640, y: 1400, s: 0.86, dur: D("steps") } }),
          A("zs1", 250, 1560, 1.15, [T("shamble", "glow", "snarl", 0.2)], { moveTo: { x: 330, y: 1680, s: 1.35, dur: D("steps") } })],
        captions: caps("steps"),
        fx(tl, id, t0) { Exam.flicker(tl, "h15", t0, D("steps")); },
      });
      // ---------- 16. the room signs light up one by one: 3/1 … 3/2 … 3/3 ----------
      add("rooms", {
        ...HALL("h16", { dark: 0.4 }),
        cam: { keys: [{ t: 0, ...fr(-1100, 900, 1.0, 540, 900) }, { t: D("rooms"), glide: D("rooms"), ...fr(500, 900, 1.0, 540, 900) }] },
        captions: caps("rooms"),
        fx(tl, id, t0, L) { [0, 1, 2].forEach((k) => { tl.fromTo(`#h16-sign${k}`, { scale: 1, svgOrigin: `${-1100 + k * 800} -605` }, { scale: 1.25, svgOrigin: `${-1100 + k * 800} -605`, duration: 0.2, yoyo: true, repeat: 1, ease: "back.out(3)", immediateRender: false }, t0 + F("rooms", 0, k)); }); },
      });
      // ---------- 17. inside, dark: the door's light lies on the floor — a shadow slides into it (and into the glass) and STOPS ----------
      add("stop", {
        ...ROOM("r17", { dark: 0.85, zsh: true, zsil: true }), blur: { fg: 8 },
        cam: { keys: [{ t: 0, ...fr(1280, 1380, 1.08, 540, 980) }, { t: D("stop"), glide: D("stop"), ...fr(1290, 1400, 1.2, 540, 980) }] },
        actors: [A("fon", 930, 1650, 0.92, [T("hideShake", "wide", "flat")])],
        captions: caps("stop"),
        fx(tl, id, t0) {
          tl.fromTo("#r17-zsh", { x: -330 }, { x: 0, duration: 1.3, ease: "power1.out", immediateRender: false }, t0 + 0.1);
          tl.fromTo("#r17-sil", { x: -90 }, { x: 0, duration: 1.3, ease: "power1.out", immediateRender: false }, t0 + 0.1);
          tl.fromTo("#r17-zsh", { skewX: 0 }, { skewX: 3, duration: 0.6, yoyo: true, repeat: 3, ease: "sine.inOut", immediateRender: false }, t0 + 1.4);
          tl.fromTo("#r17-sil", { rotation: 0, transformOrigin: "50% 100%" }, { rotation: 4, transformOrigin: "50% 100%", duration: 0.5, yoyo: true, repeat: 3, ease: "sine.inOut", immediateRender: false }, t0 + 1.4);
        },
      });
      // ---------- 18. ฝน holding her breath, the shadow lying beside her ----------
      add("breath", {
        ...ROOM("r18", { dark: 0.85, zsh: true }), blur: { far: 5, mid: 5, set: 4, fg: 7 },
        cam: { keys: [{ t: 0, ...fr(930, 1250, 2.0, 540, 1000) }, { t: D("breath"), glide: D("breath"), ...fr(930, 1250, 2.25, 540, 1000) }] },
        actors: [A("fon", 930, 1640, 0.8, [T("hideShake", "wide", "flat")])],
        captions: caps("breath"),
        fx(tl, id, t0) { tl.fromTo("#r18-zsh", { skewX: 0 }, { skewX: 4, duration: 0.6, yoyo: true, repeat: 3, ease: "sine.inOut", immediateRender: false }, t0); },
      });
      // ---------- 19. a bag lights up buzzing: แม่ — the head in the glass turns toward the sound ----------
      split("buzz", 1.6, {
        ...ROOM("r19", { dark: 0.9 }),
        cam: { keys: [{ t: 0, ...fr(300, 1650, 1.6, 540, 1000) }, { t: 1.6, glide: 1.6, ...fr(300, 1650, 1.75, 540, 1000) }] },
        captions: caps("buzz"),
        fx(tl, id, t0, L) { put(L.act, `<g id="bg19" transform="translate(300,1650)"><path d="M-120,0Q-130,-160 -90,-200H90Q130,-160 120,0Z" fill="#2a3a6a" stroke="${INK}" stroke-width="4"/><g id="bg19p">${Exam.phone(10, -170, 0.9, { screen: "mom", rot: -14 })}</g></g>`);
          tl.fromTo("#bg19p", { x: -3 }, { x: 3, duration: 0.05, yoyo: true, repeat: 30, immediateRender: false }, t0 + 0.4); },
      }, {
        ...DOOR("d19", { dark: 0.8, zsil: true }),
        cam: { keys: [{ t: 0, ...fr(540, 900, 1.4, 540, 820) }, { t: D("buzz") - 1.6, glide: 0.5, ...fr(540, 880, 1.85, 540, 820) }] },
        captions: capsFrom("buzz", 1.6),
        fx(tl, id, t0, L) {
          tl.fromTo("#d19-sil", { scaleX: 1, transformOrigin: "50% 50%" }, { scaleX: -1, transformOrigin: "50% 50%", duration: 0.28, ease: "power3.inOut", immediateRender: false }, t0 + 0.35);
          tl.fromTo("#d19-sil", { scale: 1 }, { scale: 1.14, transformOrigin: "50% 50%", duration: 0.5, ease: "power2.in", immediateRender: false }, t0 + 0.7);
          blackOut(tl, L, t0 + D("buzz") - 1.6 - 0.2, 0.15); },
      });
      // ---------- 20. next card ----------
      add("next", {
        ...ROOM("r20", { dark: 0.9 }), blur: BLUR,
        cam: { keys: [{ t: 0, ...still(fr(300, 1300, 0.7, 540, 1000)) }] },
        fx(tl, id, t0, L) { ExamUI.next(tl, L.light, t0, D("next"), { l1: "ถ้าซอมบี้บุกโรงเรียน แล้วแม่โทรมา…", l2: "อย่ารับสาย" }); },
      });
