      // ---------- ห้องสอบ EP.2 (ตอนจบ) ----------
      // grammar: frame-0 the bag lights up "แม่" → the head in the glass snaps to it → stamp ห้ามรับ → the dark room → mute + rules →
      // the shadow stays… and goes → an hour later, knocking → "ตำรวจครับ" → everyone gets up → ครูอร: don't → rules → the key turns,
      // daylight → safe → the roll call: 31 → the list says 30 → the empty cabinet → one student walks away alone → end card
      const ROOM = (id, o = {}) => ({ set: "examRoom", setOpts: { id, ...o }, dark: 0, light: o.dark ? NITE : DAYL, grade: o.dark ? GN : GD });
      const DOOR = (id, o = {}) => ({ set: "examDoor", setOpts: { id, ...o }, dark: 0, light: false, grade: o.dark ? GN : GD });
      const HALL = (id, o = {}) => ({ set: "examHall", setOpts: { id, ...o }, dark: 0, light: DAYL, grade: o.dark ? GN : GD });
      const ROWS = [[-430, 1700, "st1"], [0, 1700, "st2"], [430, 1700, "st3"], [-215, 1840, "st2"], [215, 1840, "st1"]];
      const kids = (eyes = "normal", mode = "sitChair") => ROWS.map(([x, y, w], k) => A(w, x, y, 0.62, [T(mode, eyes, "flat")], { flip: k % 2 === 1 }));
      const crack = (L, tl, id, t, cx, cy, s = 1) => {
        put(L.act, `<g id="${id}" opacity="0" stroke="#f4fbff" stroke-width="${3 * s}" fill="none" stroke-linecap="round">${Array.from({ length: 9 }, (_, k) => { const a = (k / 9) * Math.PI * 2, l = (60 + (k * 37) % 70) * s; return `<path d="M${cx},${cy}l${f1(Math.cos(a) * l * 0.5)},${f1(Math.sin(a) * l * 0.5)}l${f1(Math.cos(a + 0.3) * l * 0.5)},${f1(Math.sin(a + 0.3) * l * 0.5)}"/>`; }).join("")}</g>`);
        tl.fromTo(`#${id}`, { opacity: 0 }, { opacity: 0.95, duration: 0.05, immediateRender: false }, t);
      };
      const phoneHand = (L, id, x, y, s, screen, rot = -6) => put(L.act, `<g id="${id}">${Exam.phone(x, y, s, { screen, rot })}${handAt([x + 10 * s, y + 70 * s], 0, 0.75 * s, KIDSK, { fore: 900, band: "#f8f8f4" })}</g>`);

      // world point in L.fg (parallax 1.5) that lands on screen (sx, sy) under the camera c = fr(...)
      const fgAt = (c, sx, sy) => { const ls = 1 + (c.s - 1) * 1.5; return [(sx - 540) / ls + 540 + 1.5 * c.x, (sy - 960) / ls + 960 + 1.5 * c.y, ls]; };
      const fgDesk = (L, c, sx, sy, sz = 1.6) => { const [x, y, ls] = fgAt(c, sx, sy); put(L.fg, `<g transform="translate(${f1(x)},${f1(y)}) scale(${(sz / ls).toFixed(3)})">${Exam.desk(0, 0, 1)}</g>`); };
      // the room alive: fans, the second hand, dust turning in the window light
      const roomLife = (tl, L, id, t0, dur, n = 46) => { Exam.life(tl, id, t0, dur); Pop2.particles(tl, L.glow, { type: "dust", n, box: [-1250, 340, 1800, 1300], t0, dur, seed: (id.length * 31 + n) | 0 }); };
      const HALLD = (id, o = {}) => ({ set: "examHallDeep", setOpts: { id, ...o }, dark: 0, light: NITE, grade: GN });
      const GLASS = (id, o = {}) => ({ set: "examGlass", setOpts: { id, ...o }, dark: 0, light: false, grade: GD });
      const hand = (t) => ({ x: 5 * Math.sin(t * 6.1) + 3 * Math.sin(t * 13.7), y: 4 * Math.sin(t * 5.3) + 2 * Math.sin(t * 11.1), r: 0.5 * Math.sin(t * 4.3) });
      // glass shards flying at the lens from screen point (x, y)
      const shards = (tl, L, t, x, y, n = 14) => { const id = `sd${Math.round(t * 100)}`;
        put(L.light, `<g id="${id}">${Array.from({ length: n }, (_, k) => `<path id="${id}-${k}" d="M0,0l${18 + (k * 13) % 30},${-10 - (k * 7) % 20}l${-6 - (k * 5) % 14},${30 + (k * 11) % 26}z" fill="#eaf6fc" stroke="#9ab8c8" stroke-width="2" opacity="0" transform="translate(${x},${y})"/>`).join("")}</g>`);
        for (let k = 0; k < n; k++) { const a = (k / n) * Math.PI * 2 + 0.3, v = 380 + (k * 53) % 260;
          tl.fromTo(`#${id}-${k}`, { opacity: 1, x: 0, y: 0, scale: 0.4, rotation: 0 }, { opacity: 0, x: Math.cos(a) * v, y: Math.sin(a) * v, scale: 3.4, rotation: 160 + k * 30, duration: 0.55, ease: "power2.out", immediateRender: false }, t); } };
      const pov = (tl, L, id, t0, dur, o = {}) => { put(L.light, Exam.pov(id, o));
        tl.fromTo(`#${id}-rec`, { opacity: 1 }, { opacity: 0.15, duration: 0.3, yoyo: true, repeat: Math.ceil(dur / 0.3), ease: "steps(1)", immediateRender: false }, t0);
        tl.fromTo(`#${id}-af`, { scale: 1.12, svgOrigin: "540 770" }, { scale: 1, svgOrigin: "540 770", duration: 0.25, ease: "back.out(3)", immediateRender: false }, t0 + 0.05);
        tl.fromTo(`#${id}`, { x: 0, y: 0 }, { x: 2, y: 3, duration: 0.11, yoyo: true, repeat: Math.ceil(dur / 0.11), ease: "sine.inOut", immediateRender: false }, t0); };

      const bag = (L, id, x, y, s = 1) => put(L.act, `<g transform="translate(${x},${y}) scale(${s})"><g id="${id}"><path d="M-120,0Q-130,-160 -90,-200H90Q130,-160 120,0Z" fill="#2a3a6a" stroke="${INK}" stroke-width="4"/><path d="M-60,-200q60,-70 120,0" stroke="#1a2440" stroke-width="12" fill="none"/><g id="${id}p">${Exam.phone(10, -170, 0.9, { screen: "mom", rot: -14 })}</g></g></g>`);
      const capSil = (L, id) => put(L.glow, `<clipPath id="${id}-c"><rect x="452" y="666" width="176" height="462"/></clipPath><g clip-path="url(#${id}-c)"><rect x="452" y="666" width="176" height="462" fill="#e8f0f8"/>
        <g id="${id}" opacity=".88" fill="#1a2030"><path d="M420,1130C424,1040 470,1010 540,1004C610,1010 656,1040 660,1130Z"/><path d="M540,1010c-34,0 -50,-30 -48,-70c2,-36 22,-56 48,-56c26,0 46,20 48,56c2,40 -14,70 -48,70z"/>
          <path d="M486,884c4,-30 26,-44 54,-44c30,0 52,14 56,44z"/><path d="M478,884h124v10h-124z"/><path d="M500,896q40,14 92,-2v8q-50,14 -92,2z"/><circle cx="540" cy="862" r="7" fill="#c8b060"/></g></g>`);

      // ---------- 1. hook: frame 0 the bag lights up and jumps — "แม่" — then the head in the glass snaps toward the sound ----------
      split("hook", 1.5, {
        ...ROOM("r1", { dark: 0.9 }),
        cam: { keys: [{ t: 0, ...fr(300, 1560, 2.0, 540, 1100) }, { t: 1.5, glide: 1.5, ...fr(300, 1560, 2.25, 540, 1100) }] },
        shake: (t) => (t < 0.35 ? { x: 10 * Math.sin(t * 80), y: 6 * Math.sin(t * 61), r: 0 } : 0),
        captions: caps("hook"),
        fx(tl, id, t0, L) { bag(L, "bg1", 300, 1650);
          tl.fromTo("#bg1", { y: -30, scaleY: 0.9, svgOrigin: "0 0" }, { y: 0, scaleY: 1, svgOrigin: "0 0", duration: 0.3, ease: "bounce.out", immediateRender: false }, t0);
          tl.fromTo("#bg1p", { x: -4 }, { x: 4, duration: 0.05, yoyo: true, repeat: 29, immediateRender: false }, t0);
          impact(L, tl, t0, 560, 900, { col: "#9cc4ff", chip: "#cfe6f0", n: 6 }); },
      }, {
        ...DOOR("d1", { dark: 0.8, zsil: true }),
        cam: { keys: [{ t: 0, ...fr(540, 900, 1.5, 540, 820) }, { t: D("hook") - 1.5, glide: D("hook") - 1.5, ...fr(540, 880, 1.9, 540, 820) }] },
        captions: capsFrom("hook", 1.5),
        fx(tl, id, t0) { tl.fromTo("#d1-sil", { scaleX: 1, transformOrigin: "50% 50%" }, { scaleX: -1, transformOrigin: "50% 50%", duration: 0.22, ease: "power3.inOut", immediateRender: false }, t0 + 0.15);
          tl.fromTo("#d1-sil", { scale: 1 }, { scale: 1.16, transformOrigin: "50% 50%", duration: 0.9, ease: "power2.in", immediateRender: false }, t0 + 0.4); },
      });
      // ---------- 2. the command: ห้ามรับ ----------
      add("dont", {
        ...ROOM("r2", { dark: 0.9 }), blur: BLUR,
        cam: { keys: [{ t: 0, ...fr(300, 1560, 2.25, 540, 1100) }, { t: D("dont"), glide: D("dont"), ...fr(300, 1560, 2.4, 540, 1100) }] },
        captions: caps("dont"),
        fx(tl, id, t0, L) { bag(L, "bg2", 300, 1650); tl.fromTo("#bg2p", { x: -4 }, { x: 4, duration: 0.05, yoyo: true, repeat: Math.ceil(D("dont") / 0.05), immediateRender: false }, t0);
          ExamUI.nope(tl, L.light, t0, D("dont"), { icon: "phone", text: "ห้ามรับ", y: 640, stamp: 0.35 }); },
      });
      // ---------- 3. the hidden room: everyone along the wall, the head at the glass ----------
      add("quiet", {
        ...ROOM("r3", { dark: 0.85, zsh: true, zsil: true }),
        cam: { keys: [{ t: 0, ...fr(1080, 1440, 0.95, 540, 1100) }, { t: D("quiet"), glide: D("quiet"), ...fr(1100, 1460, 1.05, 540, 1100) }] },
        actors: [["fon", 860], ["st2", 990], ["beam", 1120], ["st1", 1500], ["orn", 1640]].map(([w, x], k) => A(w, x, 1640, w === "orn" ? 0.84 : 0.78, [T("hideShake", "wide", "flat", k * 0.11)])),
        captions: caps("quiet"),
        fx(tl, id, t0) { tl.fromTo("#r3-sil", { rotation: -2, transformOrigin: "50% 100%" }, { rotation: 3, transformOrigin: "50% 100%", duration: 0.7, yoyo: true, repeat: 4, ease: "sine.inOut", immediateRender: false }, t0); },
      });
      // ---------- 4. ฝน's thumb flips the phone silent + the rules card ----------
      add("mute", {
        ...ROOM("r4", { dark: 0.85 }), blur: { mid: 6, set: 6, fg: 8 },
        cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }] },
        captions: caps("mute"),
        fx(tl, id, t0, L) {
          put(L.act, `<g id="ph4">${Exam.phone(560, 1380, 2.6, { screen: "mom", rot: -6 })}${handAt([600, 1560], -8, 1.25, KIDSK, { fore: 900, band: "#f8f8f4" })}
            <g id="ph4m" opacity="0"><rect x="420" y="1170" width="290" height="420" rx="30" fill="#0e1014" transform="rotate(-6 560 1380)"/><g transform="translate(560,1360) rotate(-6) scale(3)"><path d="M-14,-20q14,-12 28,0v18l8,10h-44l8,-10z" fill="#fff"/><path d="M-26,-30L26,22" stroke="#e2382e" stroke-width="6" stroke-linecap="round"/></g></g></g>`);
          tl.fromTo("#ph4", { x: -6 }, { x: 6, duration: 0.05, yoyo: true, repeat: 10, immediateRender: false }, t0);
          tl.fromTo("#ph4", { y: 0 }, { y: 8, duration: 0.6, yoyo: true, repeat: Math.ceil(D("mute") / 0.6), ease: "sine.inOut", immediateRender: false }, t0 + 0.55);
          tl.fromTo("#ph4m", { opacity: 0 }, { opacity: 1, duration: 0.06, immediateRender: false }, t0 + 0.5);
          ExamUI.rules(tl, L.light, t0 + 0.05, D("mute"), { rows: [["phone", "ปิดเสียงมือถือ"], ["quiet", "ปิดทุกอย่างที่ดังได้"]], y: 170, s: 0.86, at: [0.35, F("mute", 0, 1) - 0.1] });
        },
      });
      // ---------- 5. the shadow on the floor light stays… stays… then slides away ----------
      add("pass", {
        ...ROOM("r5", { dark: 0.85, zsh: true, zsil: true }), blur: { fg: 8 },
        cam: { keys: [{ t: 0, ...fr(1280, 1380, 1.12, 540, 980) }, { t: D("pass"), glide: D("pass"), ...fr(1290, 1400, 1.22, 540, 980) }] },
        actors: [A("fon", 930, 1650, 0.92, [T("hideShake", "wide", "flat")])],
        captions: caps("pass"),
        fx(tl, id, t0) { const go = F("pass", 0, 2);
          tl.fromTo("#r5-zsh", { skewX: 0 }, { skewX: 3, duration: 0.5, yoyo: true, repeat: Math.max(1, Math.floor(go / 0.5)), ease: "sine.inOut", immediateRender: false }, t0);
          tl.fromTo("#r5-sil", { rotation: 0, transformOrigin: "50% 100%" }, { rotation: 4, transformOrigin: "50% 100%", duration: 0.5, yoyo: true, repeat: Math.max(1, Math.floor(go / 0.5)), ease: "sine.inOut", immediateRender: false }, t0);
          tl.to("#r5-zsh", { x: 360, duration: 1.1, ease: "power1.in", immediateRender: false }, t0 + go);
          tl.to("#r5-sil", { x: 100, duration: 1.1, ease: "power1.in", immediateRender: false }, t0 + go); },
      });
      // ---------- 6. an hour later: the clock jumps to 11:40 → the door shakes with knocking ----------
      split("knock", 1.3, {
        ...ROOM("r6", { dark: 0.6 }),
        cam: { keys: [{ t: 0, ...fr(1230, 330, 2.4, 540, 820) }, { t: 1.3, glide: 1.3, ...fr(1230, 330, 2.6, 540, 820) }] },
        captions: caps("knock"),
        fx(tl, id, t0) { tl.fromTo("#r6-min", { rotation: 0, svgOrigin: "0 0" }, { rotation: 360, svgOrigin: "0 0", duration: 0.9, ease: "power2.inOut", immediateRender: false }, t0 + 0.1);
          tl.fromTo("#r6-hr", { rotation: 0, svgOrigin: "0 0" }, { rotation: 30, svgOrigin: "0 0", duration: 0.9, ease: "power2.inOut", immediateRender: false }, t0 + 0.1);
          tl.fromTo("#r6-sec", { rotation: 0, svgOrigin: "0 0" }, { rotation: 720, svgOrigin: "0 0", duration: 1.0, ease: "none", immediateRender: false }, t0); },
      }, {
        ...DOOR("d6", { dark: 0.7 }),
        cam: { keys: [{ t: 0, ...fr(540, 1150, 1.15, 540, 1000) }, { t: D("knock") - 1.3, glide: D("knock") - 1.3, ...fr(540, 1150, 1.25, 540, 1000) }] },
        shake: (t) => { const k = [0.15, 0.45, 0.75].some((a) => t > a && t < a + 0.12); return k ? { x: 9 * Math.sin(t * 90), y: 0, r: 0 } : 0; },
        captions: capsFrom("knock", 1.3),
        fx(tl, id, t0) { [0.15, 0.45, 0.75].forEach((a) => tl.fromTo("#d6-door", { x: 0 }, { x: 6, duration: 0.04, yoyo: true, repeat: 3, immediateRender: false }, t0 + a)); },
      });
      // ---------- 7. "ตำรวจครับ!" — through the glass a peaked cap, the door shaking ----------
      add("cop", {
        ...DOOR("d7", { dark: 0.7 }),
        cam: { keys: [{ t: 0, ...fr(540, 920, 1.55, 540, 860) }, { t: D("cop"), glide: D("cop"), ...fr(540, 920, 1.7, 540, 860) }] },
        shake: (t) => ([0.1, 1.4].some((a) => t > a && t < a + 0.1) ? { x: 8 * Math.sin(t * 90), y: 0, r: 0 } : 0),
        captions: caps("cop", undefined, QUO),
        fx(tl, id, t0, L) { capSil(L, "cp7"); tl.fromTo("#cp7", { x: -8 }, { x: 6, duration: 0.6, yoyo: true, repeat: 4, ease: "sine.inOut", immediateRender: false }, t0); },
      });
      // ---------- 8. everyone gets up; บีม hurries to the lock ----------
      add("up", {
        ...ROOM("r8", { dark: 0.8 }),
        cam: { keys: [{ t: 0, ...fr(1050, 1430, 0.95, 540, 1100) }, { t: D("up"), glide: D("up"), ...fr(1120, 1420, 1.05, 540, 1100) }] },
        actors: [A("beam", 900, 1640, 0.8, [T("crouchHide", "wide", "o"), T("walk", "normal", "smile", 0.35)], { moveTo: { x: 1180, y: 1600, at: 0.35, dur: D("up") - 0.35 } }),
          A("st2", 1010, 1650, 0.78, [T("crouchHide", "wide", "flat"), T("idle", "normal", "smile", 0.5)]), A("st1", 760, 1660, 0.78, [T("crouchHide", "wide", "flat"), T("idle", "normal", "flat", 0.7)]), A("fon", 620, 1660, 0.8, [T("hideShake", "side", "flat")])],
        captions: caps("up"),
      });
      // ---------- 9. ครูอร grabs his wrist: don't open — let them unlock it themselves ----------
      add("wait", {
        ...ROOM("r9", { dark: 0.8 }), blur: { far: 3, mid: 3, set: 2, fg: 7 },
        cam: { keys: [{ t: 0, ...fr(1180, 1330, 1.45, 540, 1150) }, { t: D("wait"), glide: D("wait"), ...fr(1180, 1330, 1.6, 540, 1150) }] },
        actors: [A("beam", 1240, 1640, 0.82, [T("walk", "normal", "o"), T("idle", "wide", "flat", 0.8)], { moveTo: { x: 1200, y: 1640, dur: 0.4 } }),
          A("orn", 1050, 1650, 0.88, [T("point", "angry", "scream")], { talk: [TALK("wait", 0, "scream")] })],
        captions: caps("wait", undefined, QUO),
      });
      // ---------- 10. the rules: locked → open for no one · wait for the key ----------
      add("rule", {
        ...ROOM("r10", { dark: 0.85 }), blur: BLUR,
        cam: { keys: [{ t: 0, ...fr(1150, 1400, 1.0, 540, 1100) }, { t: D("rule"), glide: D("rule"), ...fr(1150, 1400, 1.1, 540, 1100) }] },
        captions: [...caps("rule", [0]), ...caps("rule", [1])],
        fx(tl, id, t0, L) { ExamUI.rules(tl, L.light, t0 + 0.05, D("rule"), { rows: [["lock", "ห้ามเปิดให้ใคร"], ["key", "รอเจ้าหน้าที่ไขเอง"]], y: 420, s: 0.95, at: [F("rule", 0, 1) - 0.2, vo("rule", 1) + 0.2] }); },
      });
      // ---------- 11. the knob turns from outside, a key slides in — the door opens on daylight ----------
      add("key", {
        ...DOOR("d11", { dark: 0.7 }),
        cam: { keys: [{ t: 0, ...fr(700, 1150, 1.9, 540, 960) }, { t: 1.2, glide: 1.0, ...fr(560, 1100, 1.1, 540, 960) }] },
        fx(tl, id, t0, L) {
          tl.fromTo("#d11-knob", { rotation: 0, transformOrigin: "50% 50%" }, { rotation: -70, transformOrigin: "50% 50%", duration: 0.25, yoyo: true, repeat: 1, ease: "power2.inOut", immediateRender: false }, t0 + 0.1);
          tl.fromTo("#d11-knob", { rotation: 0, transformOrigin: "50% 50%" }, { rotation: 90, transformOrigin: "50% 50%", duration: 0.3, ease: "back.out(2)", immediateRender: false }, t0 + 0.9);
          tl.fromTo("#d11-door", { scaleX: 1, transformOrigin: "0% 50%" }, { scaleX: 0.08, transformOrigin: "0% 50%", duration: 0.8, ease: "power2.in", immediateRender: false }, t0 + 1.4);
          put(L.glow, `<g id="op11" opacity="0"><rect x="285" y="499" width="510" height="1201" fill="#fff4dc"/><path d="M285,1300h510v400h-510z" fill="#e8dcbc"/><rect x="560" y="700" width="140" height="900" rx="60" fill="#3a4050" opacity=".55"/></g>`);
          tl.fromTo("#op11", { opacity: 0, scaleX: 0, transformOrigin: "100% 50%" }, { opacity: 1, scaleX: 0.92, transformOrigin: "100% 50%", duration: 0.8, ease: "power2.in", immediateRender: false }, t0 + 1.4);
          put(L.light, `<radialGradient id="dl11"><stop offset="0" stop-color="#fff8e8"/><stop offset="1" stop-color="#fff8e8" stop-opacity="0"/></radialGradient><rect id="dl11r" width="1080" height="1920" fill="url(#dl11)" opacity="0"/>`);
          tl.to("#dl11r", { opacity: 0.95, duration: 0.7, ease: "power2.in", immediateRender: false }, t0 + 1.6);
        },
      });
      // ---------- 12. safe: the corridor in daylight, ฝน breathes out ----------
      add("safe", {
        ...HALL("h12"),
        cam: { keys: [{ t: 0, ...fr(-300, 1250, 1.05, 540, 1150) }, { t: D("safe"), glide: D("safe"), ...fr(-250, 1250, 1.15, 540, 1150) }] },
        actors: [A("fon", -300, 1560, 0.85, [T("idle", "normal", "smile")]), A("st2", -560, 1560, 0.8, [T("walk", "normal", "smile")], { moveTo: { x: -700, y: 1560, dur: D("safe") } })],
        captions: caps("safe"),
        fx(tl, id, t0, L) { put(L.light, `<rect id="sf12" width="1080" height="1920" fill="#fff8e8" opacity="0"/>`); tl.fromTo("#sf12", { opacity: 0.9 }, { opacity: 0, duration: 0.5, immediateRender: false }, t0); },
      });
      // ---------- 13. the roll call: ครูอร ticks the list — 31… complete ----------
      add("call", {
        ...HALL("h13"),
        cam: { keys: [{ t: 0, ...fr(-250, 1300, 0.86, 540, 1150) }, { t: D("call"), glide: D("call"), ...fr(-200, 1300, 0.94, 540, 1150) }] },
        actors: [A("orn", 300, 1570, 0.84, [T("idle", "normal", "flat")], { flip: true, talk: [TALK("call", 1, "smile")] }),
          ...[["st1", -1000], ["st2", -820], ["beam", -640], ["fon", -460], ["st3", -280], ["st2", -100]].map(([w, x], k) => A(w, x, 1560 + (k % 2) * 20, 0.78, [T("idle", "normal", k % 2 ? "smile" : "flat", k * 0.1)]))],
        captions: [...caps("call", [0]), ...caps("call", [1], QUO)],
        fx(tl, id, t0, L) { ExamUI.rules(tl, L.light, t0 + vo("call", 0), D("call") - vo("call", 0), { rows: [["list", "เช็กชื่อให้ครบ"]], y: 220, s: 0.9, at: [F("call", 0, 1) - vo("call", 0)] }); },
      });
      // ---------- 14. insert: the roll list says 30 ----------
      add("thirty", {
        ...ROOM("r14"), blur: { far: 4, mid: 4, fg: 7 },
        cam: { keys: [{ t: 0, ...fr(940, 1220, 2.6, 540, 960) }, { t: D("thirty"), glide: D("thirty"), ...fr(940, 1220, 3.0, 540, 960) }] },
        captions: caps("thirty"),
        fx(tl, id, t0, L) { put(L.glow, `<ellipse id="c14" cx="944" cy="1214" rx="96" ry="34" fill="none" stroke="#e2382e" stroke-width="6" pathLength="1" stroke-dasharray="1 1" stroke-dashoffset="1"/>`);
          tl.to("#c14", { attr: { "stroke-dashoffset": 0 }, duration: 0.45, ease: "power2.inOut", immediateRender: false }, t0 + F("thirty", 0, 1)); impact(L, tl, t0 + F("thirty", 0, 1) + 0.4, 540, 960, { col: "#fff", chip: "#e2382e", n: 6 }); },
      });
      // ---------- 15. the back cabinet: open, empty, a misted handprint, shoe prints in the dust ----------
      add("cab", {
        set: "examCab", setOpts: { id: "c15", open: true, dark: 0.3 }, dark: 0, light: DAYL, grade: GD,
        cam: { keys: [{ t: 0, ...fr(330, 760, 0.72, 540, 960) }, { t: D("cab"), glide: D("cab"), ...fr(240, 700, 0.88, 540, 960) }] },
        captions: caps("cab"),
        fx(tl, id, t0, L) { put(L.act, `<g id="sp15" opacity=".55">${[0, 1, 2, 3].map((k) => `<path d="M${560 + k * 90},${1400 + k * 70}q-14,-30 0,-50q16,-6 22,14q6,24 -4,36z" fill="#3a3028" transform="rotate(${k % 2 ? 14 : -10} ${560 + k * 90} ${1400 + k * 70})"/>`).join("")}</g>`);
          tl.fromTo("#sp15", { opacity: 0 }, { opacity: 0.55, duration: 0.6, immediateRender: false }, t0 + F("cab", 0, 1)); },
      });
      // ---------- 16. ฝน: where did he go — far down the corridor one student walks away alone, never turning ----------
      add("where", {
        ...HALLD("h16", { dark: 0.12 }), grade: GD,
        cam: { keys: [{ t: 0, ...fr(540, 1000, 1.0, 540, 960) }, { t: D("where"), glide: D("where"), ...fr(540, 1000, 1.18, 540, 960) }] },
        actors: [A("fon", 220, 1820, 1.2, [T("idle", "wide", "o")], { talk: [TALK("where", 0, "o")] }),
          A("st3", 600, 1240, 0.5, [T("walk", "normal", "flat")], { moveTo: { x: 560, y: 1090, s: 0.22, dur: D("where") } })],
        captions: caps("where", undefined, QUO),
        fx(tl, id, t0) { Exam.flicker(tl, "h16", t0 + D("where") - 1.0, 1.0); },
      });
      // ---------- 17. end card ----------
      add("end", {
        ...HALL("h17"), blur: BLUR,
        cam: { keys: [{ t: 0, ...still(fr(-300, 1100, 0.7, 540, 1000)) }] },
        fx(tl, id, t0, L) { ExamUI.next(tl, L.light, t0, D("end"), { head: "ห้องสอบ · ตอนจบ", l1: "ห้องมีนักเรียน 30 คน… เช็กชื่อได้ 31", l2: "คนที่ 31 ยังอยู่ในโรงเรียน", cta: "กดติดตาม… เรื่องต่อไปมาเร็วๆ นี้" }); },
      });
