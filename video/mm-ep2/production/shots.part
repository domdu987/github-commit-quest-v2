        captions: caps("ask", undefined, { quote: true }),
      }, {
        set: "ward2", setOpts: { id: "w4", time: "night", bed: 560, window: 820 }, dark: 0.06, blur: { sky: 4, mid: 3, set: 3 }, light: TUBEW, grade: GWARD,
        cam: { keys: [{ t: 0, ...fr(170, 1170, 2.1, 540, 1000) }] },
        actors: [A("chan", 140, 1600, 0.8, [{ t: 0, mode: "idle", eyes: "side", mouth: "flat", look: -8 }])],
      });
      // ---------- 19. mom doesn't answer; behind her, in the black window, the eyes ----------
      add("silent", {
        set: "ward2", setOpts: { id: "w5", time: "night", bed: 560, window: 820, eyes: true }, dark: 0.1, blur: { sky: 1, mid: 2 }, light: TUBEW, grade: GWARD,
        cam: { keys: [{ t: 0, ...fr(230, 1000, 1.7, 540, 1000) }, { t: F("silent", 0, 1) - 0.15, glide: 0.9, ease: "power2.inOut", ...fr(800, 640, 1.55, 540, 900) }] },
        actors: [A("chan", 140, 1600, 0.8, [{ t: 0, mode: "idle", eyes: "side", mouth: "flat", look: -10 }])],
        captions: caps("silent"),
        fx(tl, id, t0) {
          tl.set("#w5-eyes", { opacity: 0 }, t0);
          tl.to("#w5-eyes", { opacity: 1, duration: 0.6, ease: "power1.in" }, t0 + F("silent", 0, 1));
          tl.set("#w5-eyes", { opacity: 0 }, t0 + D("silent") - 0.5); tl.set("#w5-eyes", { opacity: 1 }, t0 + D("silent") - 0.38);
          Fx.heart(tl, t0 + F("silent", 0, 1), D("silent") - F("silent", 0, 1), 0.6, 0.5);
        },
      });
      // ---------- 20. the choice — dragged to "ปิดไว้" ----------
      add("choice", {
        set: "ward2", setOpts: { id: "w6", time: "night", bed: 560, window: 820, eyes: true }, dark: 0.3, blur: { sky: 8, mid: 8, set: 8, act: 6 }, light: TUBEW, grade: GWARD,
        cam: { keys: [{ t: 0, ...fr(420, 900, 1.2, 540, 960) }] },
        actors: [A("chan", 140, 1600, 0.8, [{ t: 0, mode: "idle", eyes: "side", mouth: "flat", look: -10 }])],
        fx(tl, id, t0, L) {
          const LOCK = `<rect x="-36" y="-8" width="72" height="60" rx="12" fill="#f2c55c" stroke="#26201c" stroke-width="4"/><path d="M-22,-8V-28A22,22 0 0 1 22,-28V-8" stroke="#26201c" stroke-width="10" fill="none"/><circle cy="16" r="9" fill="#26201c"/><path d="M0,20v16" stroke="#26201c" stroke-width="7" stroke-linecap="round"/>`;
          const TELL = `<path d="M-54,-44H54Q66,-44 66,-32V18Q66,30 54,30H-4L-30,52V30H-54Q-66,30 -66,18V-32Q-66,-44 -54,-44Z" fill="#fff" stroke="#26201c" stroke-width="4" stroke-linejoin="round"/><path d="M-44,-8H-20L-12,-26L-2,12L8,-16L14,-8H44" stroke="#e2382e" stroke-width="7" fill="none" stroke-linejoin="round" stroke-linecap="round"/>`;
          MmUI.choice(tl, L.light, t0 + 0.05, D("choice") - 0.05, { q: "แม่จะทำยังไง?", a: "ปิดไว้", b: "บอกหมอ", ia: LOCK, ib: TELL, at: 1.6 });
          Fx.heart(tl, t0, D("choice"), 0.42, 0.7);
          Fx.glitch(tl, `#${id}`, t0 + 1.6, 0.3, 14, 2125); Fx.glitch(tl, `#${id}`, t0 + D("choice") - 0.5, 0.35, 20, 2126);
          tl.set("#black", { opacity: 1 }, t0 + D("choice") - 0.15);
        },
      });
      // ---------- 21. end card ----------
      add("next", {
        set: "tag2", setOpts: { id: "tx", ep: "ตอนจบ", title: "ตรวจใจก่อนสาย" }, dark: 0, blur: { mid: 3 }, light: false, grade: GNIGHT,
        cam: { keys: [{ t: 0, ...fr(540, 760, 1.0, 540, 800) }, { t: D("next"), glide: D("next"), ...fr(560, 780, 1.05, 540, 800) }] },
        fx(tl, id, t0) {
          tl.set("#black", { opacity: 0 }, t0 + 0.3);
          tl.fromTo("#tx-tag", { rotation: -24, svgOrigin: "0 0" }, { rotation: 0, svgOrigin: "0 0", duration: 1.8, ease: "elastic.out(1, 0.35)", immediateRender: false }, t0 + 0.3);
          tl.fromTo("#tx-sh", { rotation: -3, svgOrigin: "0 0" }, { rotation: 3, duration: 1.2, repeat: 2, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0);
        },
      });
