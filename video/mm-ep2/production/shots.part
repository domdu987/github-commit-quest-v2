      // ---------- แสงกระสือ: helpers ----------
      const tf = (tl, sel, t, dur, to, ease = "power2.inOut") => tl.to(sel, { attr: { transform: to }, duration: dur, ease, immediateRender: false }, t);
      const put = (el, html) => el.insertAdjacentHTML("beforeend", html);
      const split = (k, at, A, B) => {
        add(k, A); shots[shots.length - 1].dur = at;
        add(k, B); const sh = shots[shots.length - 1]; sh.start = SH[k].start + at; sh.dur = D(k) - at;
      };
      const capsFrom = (k, at, lines, o) => caps(k, lines, o).filter((c) => c.end > at + 0.05).map((c) => ({ ...c, t: Math.max(0, c.t - at), end: c.end - at }));
      const steps = (k, label, items, at, endAt, o = {}) => ({ type: "steps", t: at, label, items, gap: o.gap ?? 0.5, top: o.top ?? 210, end: endAt ?? D(k) - 0.2 });
      // ---------- ผีแม่ม่าย EP.2 ปั๊มให้ฟื้น ----------
      // camera grammar: 3 a.m. continues (close, shaky) → the door / the ghost doctor → Fon decides → Bua's rule (memory) → the check
      // and the call (inserts) → the neighbour → the village map → the floor, the hands from above, the pumping wide → the widow's arm →
      // the AED (close inserts, everyone's hands up) → the shock → the map to the hospital → the ward → the question → the eyes → choice
      const MOON = { from: "right", rim: "#a8c4ff", rimOp: 0.8, shade: "#000010", shadeOp: 0.5, cast: false, vol: false };
      const SUN = { from: "left", rim: "#fff2c8", rimOp: 0.7, shade: "#2a1a10", shadeOp: 0.35, cast: { len: 1.6, op: 0.35 }, vol: false };
      const BULB = { from: "left", rim: "#ffd8a0", rimOp: 0.55, shade: "#0a0614", shadeOp: 0.55, cast: false, vol: false };
      const TUBEW = { from: "right", rim: "#e8fff4", rimOp: 0.5, shade: "#102028", shadeOp: 0.4, cast: false, vol: false };
      const GLATE = { top: "#0a1430", bottom: "#1a2a3a", op: 0.35 }, GDAY = { top: "#fff0c8", bottom: "#c8e0f0", op: 0.12 }, GNIGHT = { top: "#1a2a5a", bottom: "#2a1a3a", op: 0.3 };
      const GMEM = { top: "#e8c890", bottom: "#5a3a1a", op: 0.42 }, GWARD = { top: "#0e2a2a", bottom: "#1a2a3a", op: 0.28 }, GMAP = { top: "#fff8e8", bottom: "#d8f0f0", op: 0.12 };
      const oneHand = (id, i) => { const h = document.getElementById(`${id}-a${i}-handB`); if (h) h.innerHTML = ""; };
      const TALK = (k, i, m) => [vo(k, i), voEnd(k, i), m];
      const A = (who, x, y, s, track, extra = {}) => { if (extra.talk) track.talk = extra.talk; return { who, x, y, s, track, blinks: [0.8, 2.9], ...extra }; };
      const sm = (x) => { x = Math.max(0, Math.min(1, x)); return x * x * (3 - 2 * x); };
      const tw = (u, k) => Math.sin(u * 47 + k) * 0.6 + Math.sin(u * 31 + k * 2.3) * 0.4;
      const PER = 60 / 110, push = (u) => { const ph = (u % PER) / PER; return ph < 0.42 ? Math.sin((ph / 0.42) * Math.PI / 2) : Math.cos(((ph - 0.42) / 0.58) * Math.PI / 2); };
      Rig.MODES.sleep = (u, o) => ({ ...Rig.MODES.lie(u, o), uaF: 4, faF: 4, uaB: -4, faB: -4, thF: -2, thB: 2, shF: 3, shB: 2 });
      Rig.MODES.supine = (u, o) => ({ ...Rig.MODES.lie(u, o), torso: 0, uaF: 2, faF: -2, uaB: -2, faB: -2, thF: -2, thB: 2, shF: 4, shB: 2, head: 4 });
      Rig.MODES.pulled = (u, o) => { const k = sm(u / 1.1); return { ...Rig.MODES.supine(u, o), rootX: -30 * k, rootY: -40 + (o.dy ?? 195) * k }; };
      Rig.MODES.pressed = (u, o) => ({ ...Rig.MODES.supine(u, o), rootY: -40 + (o.dy ?? 0) + 5 * push(u + (o.ph ?? 0)) });
      Rig.MODES.tugged = (u, o) => ({ ...Rig.MODES.supine(u, o), rootY: -40 + (o.dy ?? 0), rootX: 90 * sm(u / 0.45) + 4 * Math.sin(u * 40) * (u < 0.8 ? 1 : 0) });
      Rig.MODES.tugBack = (u, o) => ({ ...Rig.MODES.supine(u, o), rootY: -40 + (o.dy ?? 0), rootX: 90 * (1 - sm(u / 0.35)) });
      Rig.MODES.jolt = (u, o) => ({ ...Rig.MODES.supine(u, o), rootY: -40 + (o.dy ?? 0) - 34 * Math.exp(-u * 9) * Math.abs(Math.sin(u * 30)), uaF: -20 * Math.exp(-u * 8), uaB: 20 * Math.exp(-u * 8) });
      Rig.MODES.kneel = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: 14, faF: -40, uaB: -14, faB: 40, torso: 0, head: 6 });
      Rig.MODES.kneelShake = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: 16 + 8 * Math.sin(u * 34), faF: -46, uaB: -16 - 8 * Math.sin(u * 34 + 1), faB: 46, torso: 3 * Math.sin(u * 34), head: 6 + 3 * Math.sin(u * 34) });
      Rig.MODES.cpr = (u, o) => { const k = push(u + (o.ph ?? 0)); return { ...Rig.MODES.crouch(u, o), uaF: o.ua ?? -30, faF: -4, uaB: (o.ua ?? -30) + 4, faB: -6, torso: 10 + 5 * k, head: 18 + 3 * k, bodyY: (o.by ?? 190) + 12 * k }; };
      Rig.MODES.haul = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: -72, faF: -8, uaB: -66, faB: -12, torso: -8 + 2 * Math.sin(u * 20), head: -6, bodyY: (o.by ?? 150) + 6 * Math.sin(u * 20) });
      Rig.MODES.kneelUp = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: -166, faF: -8, uaB: 166, faB: 8, torso: -2, head: -4, bodyY: o.by ?? 150 });
      Rig.MODES.handsUp = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -168 + 3 * Math.sin(u * 9), faF: -6, uaB: 168 - 3 * Math.sin(u * 9), faB: 6, head: -4 });
      Rig.MODES.kneelPhone = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: -30, faF: -150, uaB: 4, faB: -12, torso: 4, head: 6, bodyY: o.by ?? 150 });
      Rig.MODES.sitPoint = (u, o) => ({ ...Rig.MODES.sitChair(u, o), uaF: -96 + Math.sin(u * 3), faF: -8, head: 4 });
      Rig.MODES.cry = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -40 + 4 * Math.sin(u * 7), faF: -120, uaB: -10, faB: -30, torso: 4 + 2 * Math.sin(u * 7), head: 8 + 2 * Math.sin(u * 7) });
      Rig.MODES.lieBed = (u, o) => ({ ...Rig.MODES.lie(u, o), torso: 0.4 * Math.sin(u * 1.6), uaF: 4, faF: -10, uaB: -4, faB: -8, head: o.head ?? 8 });
      Object.assign(Rig.CAST, { piakNail: { ...Rig.CAST.piak, hand: Mm.PROP.polish() }, piakAed: { ...Rig.CAST.piak, hand: `<g transform="translate(0,104)"><rect x="-46" y="0" width="92" height="66" rx="12" fill="#2fa864" stroke="#26201c" stroke-width="4"/><path d="M-20,0V-14H20V0" stroke="#26201c" stroke-width="7" fill="none"/><path d="M0,44C-10,36 -18,28 -16,22C-14,16 -6,16 0,22C6,16 14,16 16,22C18,28 10,36 0,44Z" fill="#fff"/></g>` } });
      const SRC = (L, tl, t0, dur, text) => MmUI.source(tl, L.light, t0, dur, { text });
      const ETA = (L, tl, t0, dur, from, to, o = {}) => MmUI.eta(tl, L.light, t0, dur, { from, to, ...o });
      // Keng where the story puts him: on his mattress, then on the planks in front of it
      const KENGBED = (tr) => A("keng", 790, 1672, 0.86, tr);
      const KFLOOR = (tr) => A("keng", 840, 1868, 0.86, tr);
      const FONCPR = (o = {}) => A("fon", o.x ?? 360, o.y ?? 1830, 0.8, [{ t: 0, mode: "cpr", opts: { by: o.by ?? 190, ua: o.ua ?? -30, ph: o.ph ?? 0 }, eyes: o.eyes || "wide", mouth: o.mouth || "frown" }], o.extra || {});

      // ---------- 1. 3 a.m. again: she shakes him; his arm drops; at the foot of the mattress, two green points ----------
      add("hook", {
        set: "sleep2", setOpts: { id: "hk", netOpen: true, clock: false, ghost: true }, dark: 0.34, blur: { sky: 4, mid: 3 }, light: MOON, grade: GLATE,
        cam: { keys: [{ t: 0, ...fr(760, 1560, 1.08, 540, 1000) }, { t: D("hook"), glide: D("hook"), ...fr(780, 1560, 1.24, 540, 1000) }] },
        shake: (t) => 4 * Math.sin(t * 29),
        actors: [A("fon", 420, 1720, 0.8, [{ t: 0, mode: "kneelShake", eyes: "wide", mouth: "scream" }]), KENGBED([{ t: 0, mode: "supine", eyes: "closed", mouth: "flat" }])],
        captions: caps("hook"),
        fx(tl, id, t0) {
          tl.set("#black", { opacity: 0 }, t0);
          Fx.glitch(tl, `#${id}`, t0, 0.25, 18, 2101);
          tl.set("#hk-ghost", { opacity: 0 }, t0);
          tl.fromTo("#hk-ghost-eyes", { opacity: 0 }, { opacity: 1, duration: 0.5, immediateRender: false }, t0 + 1.2);
          tl.set("#hk-ghost-eyes", { opacity: 0 }, t0 + 2.2); tl.set("#hk-ghost-eyes", { opacity: 1 }, t0 + 2.32);
          Fx.heart(tl, t0, D("hook"), 0.45, 0.45);
        },
      });
      // ---------- 2. mom at the door with the torch: the ghost doctor ----------
      add("hook2", {
        set: "sleep2", setOpts: { id: "h2", clock: false }, dark: 0.3, blur: { sky: 4, mid: 2 }, light: MOON, grade: GLATE,
        cam: { keys: [{ t: 0, ...fr(110, 980, 1.5, 540, 980) }, { t: D("hook2"), glide: D("hook2"), ...fr(110, 980, 1.62, 540, 980) }] },
        actors: [A("chan", 150, 1186, 0.9, [{ t: 0, mode: "torch", eyes: "wide", mouth: "o", torch: true }], { flip: true })],
        captions: caps("hook2"),
        fx(tl, id, t0, L) { tl.set(["#h2-net2", "#h2-net3"], { opacity: 0 }, t0); put(L.glow, `<path d="M40,700L-900,520L-900,1100Z" fill="#fff6d8" opacity=".14" style="mix-blend-mode:screen"/>`); },
      });
      add("mom", {
        set: "sleep2", setOpts: { id: "mo", clock: false }, dark: 0.26, blur: { sky: 6, mid: 4, set: 3 }, light: MOON, grade: GLATE,
        cam: { keys: [{ t: 0, ...fr(170, 640, 2.4, 540, 980) }, { t: D("mom"), glide: D("mom"), ...fr(170, 640, 2.55, 540, 980) }] },
        actors: [A("chan", 150, 1186, 0.9, [{ t: 0, mode: "torch", eyes: "worry", mouth: "scream", torch: true }], { talk: [TALK("mom", 0, "scream")] })],
        captions: caps("mom", undefined, { quote: true }),
        fx(tl, id, t0) { tl.set(["#mo-net2", "#mo-net3"], { opacity: 0 }, t0); },
      });
      add("fon", {
        set: "sleep2", setOpts: { id: "fn", netOpen: true, clock: false }, dark: 0.26, blur: { sky: 6, mid: 4 }, light: MOON, grade: GLATE,
        cam: { keys: [{ t: 0, ...fr(400, 1290, 2.3, 540, 980) }] },
        actors: [A("fon", 420, 1720, 0.8, [{ t: 0, mode: "kneel", eyes: "normal", mouth: "frown" }], { flip: true, talk: [TALK("fon", 0, "scream")] }), KENGBED([{ t: 0, mode: "supine", eyes: "closed", mouth: "flat" }])],
        captions: caps("fon", undefined, { quote: true }),
        fx(tl, id, t0) { tl.set(["#fn-net2", "#fn-net3"], { opacity: 0 }, t0); tl.fromTo(`#${id} .stage`, { x: 0 }, { keyframes: [{ x: -7, duration: 0.04 }, { x: 6, duration: 0.04 }, { x: 0, duration: 0.05 }], immediateRender: false }, t0 + F("fon", 0, 1)); },
      });
      // ---------- 3. memory: Bua at the sala, then rule 2 over the dark room ----------
      add("rule", {
        set: "sala2", setOpts: { id: "ru", chairs: [] }, dark: 0, blur: { sky: 6, far: 6, set: 2 }, light: SUN, grade: GMEM,
        cam: { keys: [{ t: 0, ...fr(640, 1070, 1.8, 540, 1260) }, { t: D("rule"), glide: D("rule"), ...fr(640, 1070, 1.9, 540, 1260) }] },
        actors: [A("bua", 640, 1530, 0.92, [{ t: 0, mode: "point", eyes: "normal", mouth: "flat" }], { talk: [TALK("rule", 0, "flat")] })],
        captions: caps("rule", undefined, { quote: true }),
        fx(tl, id, t0, L) {
          put(L.light, `<rect id="ru-vig" width="1080" height="1920" fill="url(#mu2Vig)"/><rect id="ru-dim" width="1080" height="1920" fill="#000" opacity="0"/>`);
          tl.fromTo("#flashw", { opacity: 0.55 }, { opacity: 0, duration: 0.3, immediateRender: false }, t0);
          tl.to("#ru-dim", { opacity: 0.4, duration: 0.3 }, t0 + 0.6);
          MmUI.rule(tl, L.light, t0 + 0.6, D("rule") - 0.6, { active: 1, done: [0], y: 420 });
        },
      });
      // ---------- 4. the check, from above: no breath, no rise ----------
      add("check", {
        set: "chestTop", setOpts: { id: "ck", fon: true }, dark: 0.1, light: false, grade: GLATE,
        cam: { keys: [{ t: 0, ...fr(560, 520, 1.25, 540, 860) }, { t: D("check"), glide: D("check"), ...fr(560, 540, 1.35, 540, 860) }] },
        captions: caps("check"),
        fx(tl, id, t0) {
          tl.set(["#ck-arms", "#ck-xr", "#ck-low"], { opacity: 0 }, t0);
          MmUI.breathAnim(tl, "ck", t0, { x0: vo("check", 0) + 0.6, x1: F("check", 0, 1) + 0.1 });
        },
      });
      // ---------- 5. the call ----------
      add("call", {
        set: "sleep2", setOpts: { id: "cl2", netOpen: true, clock: false }, dark: 0.3, blur: { sky: 4, mid: 3 }, light: MOON, grade: GLATE,
        cam: { keys: [{ t: 0, ...fr(430, 1390, 1.9, 540, 1000) }] },
        actors: [A("fon", 420, 1720, 0.8, [{ t: 0, mode: "kneelPhone", eyes: "wide", mouth: "o" }], { talk: [TALK("call", 0, "scream")] }), KENGBED([{ t: 0, mode: "supine", eyes: "closed", mouth: "flat" }])],
        captions: caps("call", undefined, { quote: true }),
        fx(tl, id, t0, L) { tl.set(["#cl2-net2", "#cl2-net3"], { opacity: 0 }, t0); put(L.glow, `<circle cx="480" cy="1290" r="300" fill="url(#mu2Phone)" style="mix-blend-mode:screen"/>`); },
      });
      add("know1", {
        set: "sleep2", setOpts: { id: "k1", netOpen: true, clock: false }, dark: 0.5, blur: { sky: 10, mid: 10, set: 10, act: 8 }, light: MOON, grade: GLATE,
        cam: { keys: [{ t: 0, ...fr(560, 1500, 1.2, 540, 1000) }] },
        actors: [A("fon", 420, 1720, 0.8, [{ t: 0, mode: "kneelPhone", eyes: "wide", mouth: "o" }]), KENGBED([{ t: 0, mode: "supine", eyes: "closed", mouth: "flat" }])],
        captions: caps("know1"),
        fx(tl, id, t0, L) {
          const v = vo("know1", 0);
          MmUI.phone(tl, L.light, t0 + 0.05, D("know1") - 0.05, { connect: 0.5, timer0: 4, rows: [v + 1.3, F("know1", 0, 1) + 0.25, F("know1", 0, 1) + 1.0, F("know1", 0, 2) + 0.15] });
          SRC(L, tl, t0 + 0.4, D("know1") - 0.5, "ที่มา: ศิริราช การช่วยชีวิตขั้นพื้นฐาน (4 มิ.ย. 2561)");
        },
      });
      add("eta", {
        set: "sleep2", setOpts: { id: "k2", netOpen: true, clock: false }, dark: 0.5, blur: { sky: 10, mid: 10, set: 10, act: 8 }, light: MOON, grade: GLATE,
        cam: { keys: [{ t: 0, ...fr(560, 1500, 1.2, 540, 1000) }] },
        actors: [A("fon", 420, 1720, 0.8, [{ t: 0, mode: "kneelPhone", eyes: "wide", mouth: "o" }]), KENGBED([{ t: 0, mode: "supine", eyes: "closed", mouth: "flat" }])],
        captions: caps("eta", undefined, { quote: true }),
        fx(tl, id, t0, L) {
          MmUI.phone(tl, L.light, t0, D("eta") + 0.05, { connect: 0, timer0: 10, rows: [-1, -1, -1, -1], cardAt: -1, out: false });
          ETA(L, tl, t0 + F("eta", 0, 1) - 0.1, D("eta") - F("eta", 0, 1) + 0.1, 720, 716, { big: true, fly: 1.4 });
        },
      });
      // ---------- 6. the neighbour ----------
      add("window", {
        set: "sleep2", setOpts: { id: "wi", clock: false }, dark: 0.22, blur: { sky: 2 }, light: MOON, grade: GLATE,
        cam: { keys: [{ t: 0, ...fr(1010, 760, 1.7, 540, 940) }, { t: D("window"), glide: D("window"), ...fr(1020, 760, 1.8, 540, 940) }] },
        actors: [A("fon", 1000, 1186, 0.86, [{ t: 0, mode: "point", eyes: "wide", mouth: "scream" }], { talk: [TALK("window", 0, "scream")] })],
        captions: caps("window", undefined, { quote: true }),
        fx(tl, id, t0, L) {
          tl.set("#wi-winL", { scaleX: 0.12, svgOrigin: "950 430" }, t0); tl.set("#wi-winR", { scaleX: 0.12, svgOrigin: "1210 430" }, t0);
          put(L.sky, `<g transform="translate(1180,700) scale(.5)"><path d="M-200,0V-260L0,-380L200,-260V0Z" fill="#0a0c14"/><rect x="-60" y="-200" width="80" height="70" fill="#ffd27a" opacity=".85"/><path d="M-220,0V120M220,0V120M0,0V120" stroke="#0a0c14" stroke-width="24"/></g>`);
          ETA(L, tl, t0, D("window"), 712, 704);
        },
      });
      add("piak", {
        set: "yard2", setOpts: { id: "pk", time: "dusk", crow: 700 }, dark: 0.5, blur: { far: 3, fg: 8 }, light: MOON, grade: GNIGHT,
        cam: { keys: [{ t: 0, ...fr(590, 1190, 1.3, 540, 1000) }] },
        actors: [A("piakNail", 470, 1500, 0.9, [{ t: 0, mode: "sitChair", eyes: "closed", mouth: "o" }, { t: 0.35, mode: "sitPoint", eyes: "normal", mouth: "o" }], { talk: [TALK("piak", 0)] })],
        captions: caps("piak", undefined, { quote: true }),
        fx(tl, id, t0, L) {
          oneHand(id, 0);
          put(L.glow, `<circle cx="470" cy="900" r="520" fill="url(#mmBulb)" style="mix-blend-mode:screen"/>`);
          ETA(L, tl, t0, D("piak"), 703, 696);
        },
      });
      add("fon2", {
        set: "sleep2", setOpts: { id: "f2", clock: false }, dark: 0.22, blur: { sky: 3, mid: 2 }, light: MOON, grade: GLATE,
        cam: { keys: [{ t: 0, ...fr(1050, 690, 2.5, 540, 900) }] },
        actors: [A("fon", 1000, 1186, 0.86, [{ t: 0, mode: "point", eyes: "wide", mouth: "scream" }], { talk: [TALK("fon2", 0, "scream")] })],
        captions: caps("fon2", undefined, { quote: true }),
        fx(tl, id, t0, L) { tl.set("#f2-winL", { scaleX: 0.12, svgOrigin: "950 430" }, t0); tl.set("#f2-winR", { scaleX: 0.12, svgOrigin: "1210 430" }, t0); },
      });
      // ---------- 7. the village map: Piak's motorbike to the sala's AED and back ----------
      const V = Maps.VIL;
      add("map", {
        set: "mapVillage", setOpts: { id: "mv", name: "บ้านโนนคำ", vehicle: "moto", carS: 1.1, from: "ลุงเปี๊ยก", to: "บ้านเก่ง", fromIcon: Maps.ICON.moto, toIcon: Maps.ICON.house, labDx: [80, -60],
          route: [V.piak, [338, 872], [430, 864], [432, 700], [440, 560], [520, 530], [440, 526], [300, 532], [122, 548], [112, 720], [100, 860], [180, 872], V.keng],
          stops: [{ at: V.sala, label: "ตู้ AED", dx: 70 }] },
        dark: 0, light: false, grade: GMAP,
        cam: { keys: [{ t: 0, ...fr(90 + 420, 300 + 640, 1.2, 540, 900) }, { t: D("map"), glide: D("map"), ...fr(90 + 420, 300 + 660, 1.3, 540, 900) }] },
        captions: caps("map"),
        fx(tl, id, t0, L) { Maps.route(tl, "mv", t0, { go: [0.35, 3.9] }); ETA(L, tl, t0, D("map"), 690, 600); },
      });
      // ---------- 8. off the mattress, onto the planks ----------
      add("floor", {
        set: "sleep2", setOpts: { id: "fl", netOpen: true, clock: false, lamp: true }, dark: 0.16, blur: { sky: 3 }, light: BULB, grade: GLATE,
        cam: { keys: [{ t: 0, ...fr(560, 1720, 1.3, 540, 1250) }, { t: D("floor"), glide: D("floor"), ...fr(560, 1760, 1.36, 540, 1250) }] },
        actors: [A("chan", 120, 1700, 0.76, [{ t: 0, mode: "haul", eyes: "worry", mouth: "frown" }]), A("fon", 250, 1760, 0.8, [{ t: 0, mode: "haul", opts: { by: 170 }, eyes: "wide", mouth: "frown" }]),
          KENGBED([{ t: 0, mode: "pulled", opts: { dy: 228 }, eyes: "closed", mouth: "flat" }])],
        captions: caps("floor"),
        fx(tl, id, t0, L) {
          tl.set(["#fl-net2", "#fl-net3"], { opacity: 0 }, t0);
          MmUI.versus(tl, L.light, t0, D("floor"), { a: "ที่นอนนุ่ม", b: "พื้นแข็ง", at: [vo("floor", 0) + 0.2, F("floor", 0, 1)], y: 470 });
          ETA(L, tl, t0, D("floor"), 596, 584);
        },
      });
      // ---------- 9. the hands, from above ----------
      add("hands", {
        set: "chestTop", setOpts: { id: "hd" }, dark: 0.05, light: false, grade: GLATE,
        cam: { keys: [{ t: 0, ...fr(560, 760, 1.22, 540, 860) }, { t: D("hands"), glide: D("hands"), ...fr(560, 780, 1.3, 540, 860) }] },
        captions: caps("hands"),
        fx(tl, id, t0, L) {
