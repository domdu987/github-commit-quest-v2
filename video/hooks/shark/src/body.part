      // ---------- ฮุก ฉลามวนรอบ: 0.0 split-level at dusk: ปลายฟ้า on her board, a fin slicing in from the right, the whole shark under it · 1.5 it circles closer, bigger · 3.0 her face, the fin right behind her: อย่าว่ายหนี ----------
      const SL = 900;
      add("h", {
        set: "sharkSea", setOpts: { id: "ss", sl: SL, board: [520, 1.0], fin: [1360, -0.9], shark: [1400, SL + 260, -1.15, 0] },
        dark: 0, light: { from: "right", rim: "#ffd8a0", rimOp: 0.8, shade: "#1a2a4a", shadeOp: 0.3, cast: false, vol: false }, grade: { top: "#ffb070", bottom: "#02121c", op: 0.16 },
        cam: { keys: [{ t: 0, ...fr(620, 960, 0.92, 540, 900) }, { t: 1.5, glide: 1.4, ...fr(600, 960, 0.95, 540, 900) }, { t: 3.0, glide: 1.4, ...fr(560, 820, 1.7, 540, 820) }] },
        shake: (t) => ({ x: 3 * Math.sin(t * 2.1), y: 7 * Math.sin(t * 1.7), r: 0.8 * Math.sin(t * 1.3) }),
        actors: [A("surf", 480, SL + 130, 1.1, [T("boardSit", "wide", "o"), T("boardSit", "wide", "scream", 2.3)])],
        captions: [{ text: "ถ้าวันหนึ่ง… [ครีบฉลามวนรอบตัวคุณ]", t: 0, end: 2.55 }, { text: "{อย่าว่ายหนี}", t: 2.6, end: 3.55 }],
        fx(tl, id, t0, L) {
          tl.fromTo("#ss-finw", { x: 0 }, { x: -620, duration: 3.4, ease: "sine.inOut", immediateRender: false }, t0);
          tl.fromTo("#ss-sw", { x: 0, y: 0 }, { x: -640, y: -60, duration: 3.4, ease: "sine.inOut", immediateRender: false }, t0);
          tl.fromTo("#ss-shark", { rotation: -3, svgOrigin: "0 0" }, { rotation: 3, svgOrigin: "0 0", duration: 0.6, yoyo: true, repeat: 6, ease: "sine.inOut", immediateRender: false }, t0);
          Pop2.particles(tl, L.mid, { type: "dust", n: 30, box: [-600, SL + 100, 2400, 1200], t0, dur: 3.6, seed: 9 });
          put(L.light, `<radialGradient id="vgH"><stop offset=".6" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".6"/></radialGradient><rect width="1080" height="1920" fill="url(#vgH)"/>`);
        },
      });
