      const A = (who, x, y, s, track, extra = {}) => ({ who, x, y, s, track, blinks: [9], ...extra });
      const NGT = { from: "right", rim: "#9ec8ff", rimOp: 0.75, shade: "#0a0e18", shadeOp: 0.45, cast: false, vol: false };
      const WRM = { from: "left", rim: "#ffcf8a", rimOp: 0.85, shade: "#0a0e18", shadeOp: 0.5, cast: false, vol: false };
      const GNH = { top: "#3a4a6a", bottom: "#0a0e14", op: 0.2 };
      const cap = (text) => [{ text, t: 0, end: 1 }];
      // her hand on the switch: in the glow layer so it shares the set's depth (fingertip at the switch rocker)
      const hand = (L, x, y, rot = 8, s = 1) => put(L.glow, `<g transform="translate(${x},${y}) rotate(${rot}) scale(${s})">${Hands.poke({ r: 56, sleeve: "#d8a62a", cuff: "#f0c860", sleeveLen: 500 })}</g>`);
      const SW = { x: 120, y: 1330, s: 0.8 };
      // ---- แก๊สรั่ว ----
      add("g0", { set: "hkKitchen", setOpts: { id: "a", gas: 0.75, sw: SW }, dark: 0.1, light: WRM, grade: GNH, blur: { far: 2 }, cam: { keys: [{ t: 0, ...fr(560, 1150, 1.0, 540, 960) }] },
        actors: [A("ning", 420, 2260, 2.0, [{ t: 0, mode: "idle", eyes: "worry", mouth: "o" }])], captions: cap("ถ้าวันหนึ่ง… คุณกลับบ้าน[ตอนดึก]"),
        fx: (tl, id, t0, L) => hand(L, 128, 1312, 24, 1) });
      add("g1", { set: "hkKitchen", setOpts: { id: "b", gas: 0.95, sw: SW }, dark: 0.12, light: WRM, grade: GNH, blur: { far: 3 }, cam: { keys: [{ t: 0, ...fr(330, 1250, 1.5, 540, 1000) }] },
        actors: [A("ning", 430, 2240, 2.0, [{ t: 0, mode: "idle", eyes: "pain", mouth: "o" }])], captions: cap("แล้ว[ได้กลิ่นแก๊ส]"),
        fx: (tl, id, t0, L) => hand(L, 150, 1316, 24, 1) });
      add("g2", { set: "hkKitchen", setOpts: { id: "c", gas: 1.2, spark: true, sw: SW }, dark: 0.15, light: WRM, grade: GNH, blur: { far: 4 }, cam: { keys: [{ t: 0, ...fr(230, 1300, 2.1, 540, 1000) }] },
        actors: [A("ning", 440, 2230, 2.0, [{ t: 0, mode: "idle", eyes: "wide", mouth: "scream" }])], captions: cap("{อย่าเปิดไฟ!}"),
        fx: (tl, id, t0, L) => hand(L, 122, 1322, 24, 1) });
      // ---- จระเข้บุกบ้าน ----
      const TEDDY = (L, x, y, s) => put(L.set, `<g transform="translate(${x},${y}) scale(${s})"><circle cx="0" cy="0" r="46" fill="#c8945a" stroke="#1e1a16" stroke-width="4"/><circle cx="-34" cy="-38" r="18" fill="#c8945a" stroke="#1e1a16" stroke-width="4"/><circle cx="34" cy="-38" r="18" fill="#c8945a" stroke="#1e1a16" stroke-width="4"/><circle cx="-14" cy="-6" r="5" fill="#1e1a16"/><circle cx="14" cy="-6" r="5" fill="#1e1a16"/><ellipse cx="0" cy="12" rx="14" ry="10" fill="#e8c8a0"/></g>`);
      add("c0", { set: "hkFlood", setOpts: { id: "d", flash: 1, croc: { x: 330, y: 1380, s: 1.1, shine: 1 } }, dark: 0, light: NGT, grade: GNH, cam: { keys: [{ t: 0, ...fr(600, 1120, 0.95, 540, 960) }] },
        actors: [A("jeng", 1000, 1260, 1.15, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }], { flip: true }), A("bai", 820, 1400, 0.8, [{ t: 0, mode: "idle", eyes: "wide", mouth: "scream" }], { flip: true })],
        captions: cap("ถ้าวันหนึ่ง… [น้ำท่วม]บ้านคุณ"), fx: (tl, id, t0, L) => TEDDY(L, 600, 1390, 0.8) });
      add("c1", { set: "hkFlood", setOpts: { id: "e", flash: 0.3, croc: { x: 470, y: 1460, s: 1.25, shine: 1 } }, dark: 0, light: NGT, grade: GNH, cam: { keys: [{ t: 0, ...fr(680, 1240, 1.12, 540, 960) }] },
        actors: [A("jeng", 1010, 1260, 1.15, [{ t: 0, mode: "point", eyes: "wide", mouth: "scream" }], { flip: true }), A("bai", 740, 1520, 0.8, [{ t: 0, mode: "point", eyes: "normal", mouth: "o" }], { flip: true })],
        captions: cap("แล้วมี[บางอย่าง]ว่ายเข้ามา"), fx: (tl, id, t0, L) => TEDDY(L, 640, 1420, 0.8) });
      add("c2", { set: "hkFlood", setOpts: { id: "f", flash: 0.85, croc: { x: 560, y: 1600, s: 1.25, open: 1, shine: 1 } }, dark: 0, light: NGT, grade: GNH, cam: { keys: [{ t: 0, ...fr(700, 1300, 1.1, 540, 960) }] },
        actors: [A("jeng", 1010, 1260, 1.15, [{ t: 0, mode: "point", eyes: "wide", mouth: "scream" }], { flip: true }), A("bai", 860, 1400, 0.8, [{ t: 0, mode: "run", eyes: "wide", mouth: "scream" }], { flip: true })],
        captions: cap("{อย่าลงไปในน้ำ!}") });
