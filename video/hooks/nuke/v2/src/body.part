      // ---------- 60 วินาที (นิวเคลียร์กรุงเทพ v2): hooks A/B/C at 0 / 1 / 2 s + samples ----------
      const G = 1180;
      const DUSK = { from: "right", rim: "#ffc890", rimOp: 0.8, shade: "#2a1a3a", shadeOp: 0.28, cast: false, vol: false };
      const HOME = { from: "left", rim: "#ffe0b0", rimOp: 0.6, shade: "#3a2a20", shadeOp: 0.25, cast: false, vol: false };
      const VG = (L, a = 0.55) => { const g = `vg${L.light.id}`; put(L.light, `<radialGradient id="${g}"><stop offset=".58" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity="${a}"/></radialGradient><rect width="1080" height="1920" fill="url(#${g})"/>`); };
      const siren = (L, x, y, s) => put(L.set, `<g transform="translate(${x},${y}) scale(${s})"><rect x="-10" y="0" width="20" height="900" fill="#7a7a80" ${`stroke="${INK}" stroke-width="3"`}/><g id="sir${x}">${[-1, 1].map((d) => `<path d="M0,-20L${d * 120},-80V60Z" fill="#c8ccd0" stroke="${INK}" stroke-width="4"/>`).join("")}</g>${[1, 2, 3].map((k) => `<path d="M${130 + k * 40},-120q${30 + k * 10},${100} 0,${200}M${-130 - k * 40},-120q${-30 - k * 10},100 0,200" stroke="#fff" stroke-width="6" fill="none" opacity="${0.7 - k * 0.18}"/>`).join("")}</g>`);
      const alertPhone = (L, id) => put(L.light, `<g id="${id}"><g transform="translate(760,1420) rotate(-8)"><rect x="-150" y="-280" width="300" height="560" rx="40" fill="#141418" stroke="${INK}" stroke-width="6"/><rect x="-132" y="-256" width="264" height="512" rx="26" fill="#2a3a5a"/>
        <rect x="-120" y="-220" width="240" height="250" rx="18" fill="#fbfaf4"/><rect x="-120" y="-220" width="240" height="60" rx="18" fill="#e2382e"/><text x="0" y="-178" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="30" fill="#fff">⚠ แจ้งเตือนภัย</text>
        <text x="-104" y="-120" font-family="Kanit" font-weight="900" font-size="30" fill="#26201c">ภัยร้ายแรงสูงสุด</text><text x="-104" y="-76" font-family="Kanit" font-weight="700" font-size="26" fill="#26201c">เข้าอาคารคอนกรีต</text><text x="-104" y="-38" font-family="Kanit" font-weight="700" font-size="26" fill="#26201c">ที่ใกล้ที่สุดทันที</text>
        <path d="M-150,40h-26M-150,90h-26" stroke="#141418" stroke-width="12"/></g></g>`);
      add("pad", { set: "bkk", setOpts: { id: "bp", view: "parking", g: G }, dark: 0, light: DUSK, grade: { top: "#3a2a5a", bottom: "#2a1418", op: 0.12 }, cam: { keys: [{ t: 0, ...still(fr(540, G, 0.8, 540, 960)) }] } });
      // A: the siren wails over the city, every phone screams — 60 seconds; the family runs for the car park → อย่าวิ่งลงไปขึ้นรถ
      add("hA", {
        set: "bkk", setOpts: { id: "ba", view: "parking", g: G, prang: -120 }, dark: 0, light: DUSK, grade: { top: "#5a2a3a", bottom: "#2a1418", op: 0.15 },
        cam: { keys: [{ t: 0, ...fr(560, G + 140, 0.86, 540, 1000) }, { t: 1.0, glide: 0.9, ...fr(520, G + 200, 1.0, 540, 1000) }, { t: 2.0, glide: 0.8, ...fr(320, G + 160, 1.9, 540, 900) }] },
        shake: (t) => ({ x: 4 * Math.sin(t * 9), y: 3 * Math.sin(t * 7), r: 0 }),
        actors: [A("ploy", 820, G + 760, 1.3, [T("run", "wide", "scream")], { flip: true, moveTo: { x: 330, y: G + 760, dur: 2.0 } }), A("phumCat", 1180, G + 760, 1.15, [T("run", "wide", "scream")], { flip: true, moveTo: { x: 700, y: G + 760, dur: 2.2 } }),
          A("tuadTin", 1500, G + 740, 1.15, [T("walk", "angry", "o")], { flip: true, moveTo: { x: 1300, y: G + 740, dur: 2.4 } })],
        captions: [{ text: "ถ้าวันหนึ่ง… [หวอดังทั่วกรุง]", t: -0.35, end: 1.45 }, { text: "{อย่าวิ่งลงไปขึ้นรถ!}", t: 1.5, end: 2.35 }],
        fx(tl, id, t0, L) { siren(L, 980, G - 720, 1.0); alertPhone(L, "ap1"); tl.fromTo("#ap1", { x: -6 }, { x: 6, duration: 0.05, yoyo: true, repeat: 20, immediateRender: false }, t0); tl.to("#ap1", { y: 500, duration: 0.3, ease: "power2.in", immediateRender: false }, t0 + 0.9); VG(L); },
      });
      // B: 60 seconds, dark comedy — she grabs the gold, he grabs the cat, ลุงชัย the TV remote; ยายทวด already has water, the radio and the pills → อย่าเสียวินาทีกับทอง
      add("hB", {
        set: "shophouse", setOpts: { id: "bs" }, dark: 0, light: HOME, grade: { top: "#5a3a2a", bottom: "#2a1a10", op: 0.12 },
        cam: { keys: [{ t: 0, ...fr(560, 1180, 0.82, 540, 1000) }, { t: 1.0, glide: 0.8, ...fr(760, 1160, 1.0, 540, 1000) }, { t: 2.0, glide: 0.7, ...fr(260, 1020, 2.0, 540, 900) }] },
        shake: (t) => ({ x: 3 * Math.sin(t * 11), y: 2 * Math.sin(t * 9), r: 0 }),
        actors: [A("ployGold", 260, 1700, 1.2, [T("grabUp", "wide", "laugh")]), A("phumCat", 600, 1720, 1.1, [T("hugCat", "wide", "o")], { flip: true }), A("chaiRemote", 1180, 1700, 1.15, [T("grabUp", "wide", "o")], { flip: true }),
          A("tuadTin", 880, 1700, 1.1, [T("idle", "angry", "flat")])],
        captions: [{ text: "ถ้าวันหนึ่ง… [คุณมี 60 วินาที]", t: -0.35, end: 1.45 }, { text: "{อย่าเสียวินาทีกับทอง!}", t: 1.5, end: 2.35 }],
        fx(tl, id, t0, L) {
          put(L.act, `<g transform="translate(980,1460)">${NukeProp.water}<g transform="translate(110,30)">${NukeProp.radio}</g><g transform="translate(220,30)">${NukeProp.meds}</g></g>`);
          put(L.set, `<g id="clk" transform="translate(1020,640)"><circle r="92" fill="#fbfaf4" stroke="${INK}" stroke-width="8"/>${Array.from({ length: 12 }, (_, k) => `<path d="M0,-80V-66" stroke="${INK}" stroke-width="5" transform="rotate(${k * 30})"/>`).join("")}<g id="clkh"><path d="M0,10V-78" stroke="#e2382e" stroke-width="5" stroke-linecap="round"/></g><path d="M0,0V-50" stroke="${INK}" stroke-width="9" stroke-linecap="round" transform="rotate(200)"/><circle r="8" fill="#e2382e"/></g>`);
          tl.fromTo("#clkh", { rotation: 0, svgOrigin: "0 0" }, { rotation: 72, svgOrigin: "0 0", duration: 2.4, ease: "steps(12)", immediateRender: false }, t0); VG(L, 0.45);
        },
      });
      // C: the cloud fills the window; the phone: แม่ "ลูกอยู่ไหน" — she grabs the keys for the door → อย่าออกไปตามหาครอบครัว
      add("hC", {
        set: "bkk", setOpts: { id: "bc", view: "window", g: G, cloud: [560, G - 20, 1.45], prang: 980 }, dark: 0, light: { from: "left", rim: "#ffb070", rimOp: 0.85, shade: "#2a1a2a", shadeOp: 0.3, cast: false, vol: false }, grade: { top: "#5a2a2a", bottom: "#1a1010", op: 0.18 },
        cam: { keys: [{ t: 0, ...fr(640, G + 60, 0.9, 540, 1000) }, { t: 1.0, glide: 0.8, ...fr(900, G + 160, 1.0, 540, 1000) }, { t: 2.0, glide: 0.7, ...fr(1300, G + 60, 1.75, 540, 900) }] },
        actors: [A("ployPhone", 540, G + 860, 1.3, [T("phoneLook", "wide", "o"), T("walk", "angry", "flat", 0.6), T("reachDoor", "angry", "o", 1.6)], { moveTo: { x: 1240, y: G + 860, at: 0.6, dur: 1.1 } })],
        captions: [{ text: "ถ้าวันหนึ่ง… [แม่โทรมาตอนหวอดัง]", t: -0.35, end: 1.45 }, { text: "{อย่าออกไปตามหาครอบครัว!}", t: 1.5, end: 2.35 }],
        fx(tl, id, t0, L) {
          put(L.light, `<g id="ms3"><g transform="translate(540,620)"><rect x="-300" y="-90" width="600" height="180" rx="40" fill="#fbfaf4" stroke="${INK}" stroke-width="5"/><circle cx="-220" cy="0" r="50" fill="#f2c8a8" stroke="${INK}" stroke-width="4"/><text x="-150" y="-14" font-family="Kanit" font-weight="900" font-size="44" fill="#26201c">แม่</text><text x="-150" y="46" font-family="Kanit" font-weight="700" font-size="44" fill="#26201c">ลูกอยู่ไหน</text></g></g>`);
          tl.fromTo("#ms3", { x: -5 }, { x: 5, duration: 0.05, yoyo: true, repeat: 16, immediateRender: false }, t0); tl.to("#ms3", { opacity: 0, duration: 0.2, immediateRender: false }, t0 + 1.3); VG(L);
        },
      });
      // samples: the skyline at the flash · the basement shelter (bright enough) · ยายทวด's rules on her old paper
      add("s1", { set: "bkk", setOpts: { id: "b1", view: "skywalk", g: G, cloud: [640, G - 40, 2.0], flash: [1500, G - 900], prang: 120 }, dark: 0, light: DUSK, grade: { top: "#5a2a2a", bottom: "#2a1418", op: 0.12 },
        cam: { keys: [{ t: 0, ...still(fr(540, G - 620, 0.6, 540, 1000)) }] },
        actors: [A("ploy", 340, G + 330, 1.3, [T("look", "wide", "o")]), A("phumCat", 620, G + 330, 1.15, [T("hugCat", "wide", "o")]), A("tuad", 860, G + 330, 1.1, [T("look", "angry", "flat")], { flip: true })],
        fx(tl, id, t0, L) { VG(L, 0.45); } });
      add("s2", { set: "shelter", setOpts: { id: "sh2", dust: true }, dark: 0, light: { from: "left", rim: "#fffbe0", rimOp: 0.6, shade: "#2a2a34", shadeOp: 0.25, cast: false, vol: false }, grade: { top: "#4a4a50", bottom: "#202024", op: 0.1 },
        cam: { keys: [{ t: 0, ...still(fr(420, 1260, 1.1, 540, 1000)) }] },
        actors: [A("tuadTin", 120, 1640, 0.95, [T("sit", "normal", "flat")]), A("ploy", 380, 1640, 0.95, [T("sit", "wide", "flat")]), A("phumCat", 640, 1660, 0.9, [T("sit", "side", "flat")], { flip: true }), A("uncle", 900, 1620, 0.95, [T("idle", "normal", "flat")], { flip: true })],
        fx(tl, id, t0, L) { put(L.act, `<g transform="translate(300,1600)">${NukeProp.radio}</g>`); VG(L, 0.4); } });
      add("s3", { set: "shophouse", setOpts: { id: "s3h" }, dark: 0, light: HOME, grade: { top: "#5a3a2a", bottom: "#2a1a10", op: 0.1 }, blur: { set: 6, act: 4 },
        cam: { keys: [{ t: 0, ...still(fr(540, 1300, 0.95, 540, 1100)) }] },
        actors: [A("tuadTin", 540, 1860, 1.25, [T("point", "angry", "o")])],
        fx(tl, id, t0, L) { put(L.light, `<g transform="translate(540,560) rotate(-3)"><rect x="-430" y="-330" width="860" height="680" fill="#000" opacity=".3" transform="translate(14,18)"/><rect x="-430" y="-330" width="860" height="680" fill="#efe2bc" stroke="#a8946a" stroke-width="4"/>
          ${Array.from({ length: 10 }, (_, k) => `<path d="M-400,${-210 + k * 56}H400" stroke="#c8b488" stroke-width="2"/>`).join("")}<rect x="200" y="-300" width="190" height="150" fill="#d8ccb0" stroke="#8a7a5a" stroke-width="3" transform="rotate(6 295 -225)"/><path d="M210,-170q40,-60 80,-20q40,-50 80,20" fill="#6a5a48" opacity=".6" transform="rotate(6 295 -225)"/><text x="230" y="-130" font-family="Sriracha" font-size="22" fill="#5a4a3a" transform="rotate(6 295 -225)">หลุมหลบภัย ๒๔๘๗</text>
          <text x="-380" y="-240" font-family="Sriracha" font-size="62" fill="#7a1a10">กฎของยายตอนหวอ</text>
          ${[["เสียงหวอดัง อย่าหวังรถ", 0], ["มือมีสอง อย่ามัวมองทอง", 1], ["ลูกหลานอยู่ไกล อย่าไปตาม", 2]].map(([t, k]) => `${k === 1 ? `<path d="M-390,${-96 + k * 120}h700" stroke="#ffd23a" stroke-width="56" opacity=".55" stroke-linecap="round"/>` : ""}<text x="-380" y="${-80 + k * 120}" font-family="Sriracha" font-size="56" fill="${k === 2 ? "#8a7a6a" : "#2a2a3a"}">${k + 1}. ${t}</text>`).join("")}
          <path d="M-380,330l40,-20" stroke="#c8302a" stroke-width="4"/></g>`); VG(L, 0.4); } });
