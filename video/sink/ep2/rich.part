      // ---------- นาทีก่อนจม: the 10/10 pass — ต้น in jeans, a furnished cabin with light and caustics, the car seen from under the water ----------
      // ต้น: the same face and tee, long jeans and sneakers (no bare mannequin legs when he sits)
      Rig.CAST.tonJ = { v2: { ...Rig.CAST.boss.v2, bottom: { kind: "jeans", c: "#3b4a63" }, feet: { kind: "sneaker", c: "#eceae4", sole: "#3a3530", lace: "#8a8e94" } } };
      // the cutaway furnished: door trims (armrests, handles, speakers, pockets), seat stitching and shading, grab handles,
      // the dash's vent and gauges, glass on the closed windows, and the light: the dash's cyan on the driver, the lamp's warm spill,
      // shadow at the floor, caustics thrown on the roof by the water inside (o.caustic). Call in fx right after the set is built.
      const cabRich = (L, tl, id, t0, dur, o = {}) => {
        const st = (d, w = 3) => `<path d="${d}" stroke="#4a5566" stroke-width="${w}" stroke-dasharray="7 6" fill="none" opacity=".75"/>`;
        let s = `<linearGradient id="${id}-trim" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#262e3a"/><stop offset="1" stop-color="#151a22"/></linearGradient>
          <linearGradient id="${id}-seatG" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#ffffff" stop-opacity=".1"/><stop offset=".45" stop-color="#ffffff" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".25"/></linearGradient>
          <linearGradient id="${id}-ao" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".55"/></linearGradient>`;
        // the door trims under the far windows
        [[492, 1004, 560, 900, 640], [44, 466, 120, 420, 300]].forEach(([x0, x1, a0, a1, hx]) => {
          s += `<path d="M${x0},1236H${x1}V1488H${x0}Z" fill="url(#${id}-trim)"/><path d="M${x0},1240H${x1}" stroke="#0b0e13" stroke-width="8"/><path d="M${x0},1236H${x1}" stroke="#3a4556" stroke-width="3"/>
            <rect x="${a0}" y="1300" width="${a1 - a0}" height="34" rx="16" fill="#2c3644" stroke="#0b0e13" stroke-width="5"/><path d="M${a0 + 14},1306H${a1 - 14}" stroke="#4a5566" stroke-width="3" stroke-linecap="round"/>
            <path d="M${a0},1440H${a1}" stroke="#0e1218" stroke-width="10"/><path d="M${a0},1446H${a1}" stroke="#2a3240" stroke-width="3"/>
            <rect x="${hx - 34}" y="1258" width="68" height="26" rx="12" fill="#0e1218" stroke="#000" stroke-width="3"/><path d="M${hx - 22},1271H${hx + 18}" stroke="#b8c0ca" stroke-width="7" stroke-linecap="round"/>
            <g transform="translate(${(a0 + a1) / 2 + 60},1390)"><circle r="34" fill="#11151c" stroke="#0b0e13" stroke-width="4"/>${Array.from({ length: 19 }, (_, k) => { const a = k * 2.4, r = 6 + (k % 4) * 6; return `<circle cx="${f1(Math.cos(a) * r)}" cy="${f1(Math.sin(a) * r)}" r="2" fill="#2c3644"/>`; }).join("")}</g>`;
        });
        // grab handles over the doors, the roof liner's seam, the dome light
        s += `<path d="M600,1056q40,18 80,0" stroke="#2c3644" stroke-width="10" fill="none" stroke-linecap="round"/><path d="M280,1056q40,18 80,0" stroke="#2c3644" stroke-width="10" fill="none" stroke-linecap="round"/>
          <path d="M214,1060Q480,1040 760,1060" stroke="#323c4c" stroke-width="3" fill="none"/>`;
        // the seats: stitching and a light-to-shade fall across them; the shadow under the cushions
        s += `${st("M546,1150L578,1386")}${st("M506,1186L536,1392", 2.4)}${st("M540,1408H726")}
          <path d="M530,1408L486,1142Q482,1112 512,1108L556,1106Q582,1108 586,1136L610,1398Z" fill="url(#${id}-seatG)"/>
          ${st("M84,1180L112,1384")}${st("M100,1404H330")}<path d="M92,1404L52,1150Q48,1122 76,1118L118,1114Q142,1116 146,1142L170,1392Z" fill="url(#${id}-seatG)"/>
          <rect x="28" y="1440" width="984" height="62" fill="url(#${id}-ao)"/>`;
        // the dash: a round vent at its side, the gauges' glow under the hood, the gear lever between the seats
        s += `<g transform="translate(980,1268)"><circle r="22" fill="#0e1218" stroke="#3a4250" stroke-width="5"/>${[-12, -4, 4, 12].map((y) => `<path d="M-15,${y}H15" stroke="#3a4250" stroke-width="3"/>`).join("")}</g>
          <ellipse cx="896" cy="1214" rx="34" ry="12" fill="#7fd1ff" opacity=".35"/><path d="M760,1500L776,1404" stroke="#14181e" stroke-width="12" stroke-linecap="round"/><circle cx="778" cy="1398" r="13" fill="#232a34" stroke="#0b0e13" stroke-width="4"/>`;
        // glass on the closed windows (the open one in EP.2 gets none: openWin draws over it)
        if (o.glass !== false) s += `<g opacity=".55">${o.openF ? "" : `<path d="M600,1070L650,1070L560,1214H510Z" fill="#dff4ff" opacity=".14"/><path d="M680,1070H700L610,1214H590Z" fill="#dff4ff" opacity=".18"/>`}
          <path d="M260,1070L300,1070L190,1214H150Z" fill="#dff4ff" opacity=".14"/><path d="M330,1070H346L236,1214H220Z" fill="#dff4ff" opacity=".18"/></g>`;
        if (o.caustic) s += `<g id="${id}-cau" opacity=".5">${Array.from({ length: 9 }, (_, k) => `<path d="M${200 + k * 64},${1062 + (k % 3) * 6}q16,-8 32,0t32,0" stroke="#bff4e6" stroke-width="3" fill="none"/>`).join("")}</g>`;
        put(L.set, MIR(id, s));
        // light: the dash's cyan reaching his face and hands, the lamp's warm spill through the far windows
        put(L.glow, MIR(id, `<radialGradient id="${id}-dg2"><stop offset="0" stop-color="#5ab8ff" stop-opacity=".3"/><stop offset="1" stop-color="#5ab8ff" stop-opacity="0"/></radialGradient>
          <radialGradient id="${id}-lw2"><stop offset="0" stop-color="#ffb060" stop-opacity=".16"/><stop offset="1" stop-color="#ffb060" stop-opacity="0"/></radialGradient>
          <ellipse cx="840" cy="1240" rx="280" ry="220" fill="url(#${id}-dg2)"/><ellipse cx="560" cy="1120" rx="420" ry="200" fill="url(#${id}-lw2)"/>`));
        if (o.caustic) tl.fromTo(`#${id}-cau`, { x: -24, opacity: 0.35 }, { x: 24, opacity: 0.6, duration: 1.1, repeat: Math.ceil(dur / 1.1), yoyo: true, ease: "sine.inOut", immediateRender: false }, t0);
      };

      // the car from under the water, side-on and nose down: its lights still on in the murk, the two of them inside lit by the dash,
      // bubbles streaming from its seams, the canal bed below, the lamp's rays down through the surface
      Sets.sinkOut = (L, o = {}) => {
        const id = o.id || "so";
        put(L.sky, `<linearGradient id="${id}-g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2a6a60"/><stop offset=".35" stop-color="#123a36"/><stop offset="1" stop-color="#030a0a"/></linearGradient>
          <rect x="-900" y="-600" width="2900" height="3400" fill="url(#${id}-g)"/>
          ${[[300, 160], [560, 120], [760, 180]].map(([x, w]) => `<path class="${id}-ray" d="M${x},-200L${x + w},-200L${x + w - 260},1700L${x - 340},1700Z" fill="#cfffee" opacity=".07"/>`).join("")}
          <path d="M-900,250Q-700,238 -500,250T-100,250T300,250T700,250T1100,250T1500,250T1900,250" stroke="#cfffee" stroke-width="5" fill="none" opacity=".6"/>`);
        put(L.far, `${Array.from({ length: 50 }, (_, k) => `<circle cx="${f1(-200 + ((k * 211) % 1500))}" cy="${f1(300 + ((k * 137) % 1500))}" r="${f1(2 + (k % 4) * 1.5)}" fill="#bfe8d8" opacity="${(0.2 + (k % 5) * 0.08).toFixed(2)}"/>`).join("")}
          <path d="M-900,1700Q-300,1640 300,1690T1500,1660T2000,1690V2600H-900Z" fill="#0a1410"/>${Array.from({ length: 26 }, (_, k) => `<path d="M${-300 + k * 70},${1690 - (k % 3) * 10}q${k % 2 ? 14 : -14},-90 ${k % 2 ? -6 : 8},-${110 + (k * 17) % 70}" stroke="#14261c" stroke-width="10" fill="none"/>`).join("")}`);
        // the car: body side-on facing right, tilted nose down; through its windows the cabin, the dash's glow on two faces
        const win = (d) => `<path d="${d}" fill="#0c2a2e"/>`;
        const W1 = "M-60,-250L-40,-360Q60,-372 170,-360L250,-250Z", W2 = "M-300,-250L-250,-356Q-160,-370 -70,-362L-80,-250Z";
        const person = (x, y, s, skin, top, hair, long) => `<g transform="translate(${x},${y}) scale(${s})"><path d="M-46,40Q-50,-10 -30,-24H30Q50,-10 46,40Z" fill="${top}"/>
          <rect x="-9" y="-40" width="18" height="20" fill="${skin}"/>${long ? `<path d="M-30,-60Q-34,-14 -26,8H26Q34,-14 30,-60Z" fill="${hair}"/>` : ""}<ellipse cx="0" cy="-62" rx="26" ry="30" fill="${skin}"/>
          <path d="M-27,-66Q-26,-96 0,-96Q26,-96 27,-66Q14,-80 0,-80Q-14,-80 -27,-66Z" fill="${hair}"/><path d="M14,-74Q22,-60 16,-44" stroke="#7fd1ff" stroke-width="5" fill="none" opacity=".8"/>
          <circle cx="10" cy="-64" r="3" fill="#1e2228"/><ellipse cx="12" cy="-48" rx="5" ry="4" fill="#5a1a18"/></g>`;
        put(L.act, `<g transform="translate(${o.x ?? 560},${o.y ?? 1060}) rotate(${o.tilt ?? 22})"><g id="${id}-car">
          <g id="${id}-beams"><path d="M380,-170L1300,-520L1300,260Z" fill="#e8fff0" opacity=".12"/><path d="M380,-170L1100,-330L1100,90Z" fill="#e8fff0" opacity=".12"/></g>
          ${win(W1)}${win(W2)}
          <g clip-path="url(#${id}-wc)">${person(110, -250, 1.15, "#d8a078", "#4a9a5a", "#1a1410", false)}${person(-180, -258, 0.85, "#ecc29c", "#c8b4e6", "#3a2418", true)}
            <circle cx="210" cy="-280" r="60" fill="#5ab8ff" opacity=".22"/><path d="M190,-300L230,-230" stroke="#14181e" stroke-width="12"/></g>
          <clipPath id="${id}-wc"><path d="${W1}"/><path d="${W2}"/></clipPath>
          <path d="M-420,-120Q-430,-230 -330,-246L-260,-370Q-160,-392 -40,-388Q120,-386 190,-370L290,-250Q400,-236 470,-190Q500,-120 470,-60H-400Q-430,-70 -420,-120Z${W1}${W2}" fill="#dfe4e8" fill-rule="evenodd" stroke="#0b0e13" stroke-width="7"/>
          <path d="M-410,-150H470" stroke="#b8c0c8" stroke-width="5"/><path d="M-80,-250V-70M160,-240V-70" stroke="#9aa4ae" stroke-width="4"/>
          <rect x="430" y="-196" width="44" height="26" rx="8" fill="#fff6dc"/><rect x="-424" y="-180" width="22" height="34" rx="6" fill="#c8302a"/>
          ${[-270, 300].map((x) => `<g transform="translate(${x},-60)"><circle r="72" fill="#14161a" stroke="#0b0e13" stroke-width="6"/><circle r="40" fill="#8a929c"/><circle r="12" fill="#2a2c30"/></g>`).join("")}
          <path d="M-420,-120Q-430,-230 -330,-246L-260,-370Q-160,-392 -40,-388Q120,-386 190,-370L290,-250Q400,-236 470,-190Q500,-120 470,-60H-400Q-430,-70 -420,-120Z" fill="#1c5a52" opacity=".38"/>
          ${Array.from({ length: 16 }, (_, k) => `<circle class="${id}-bb" cx="${-200 + ((k * 97) % 520)}" cy="${-380 + ((k * 31) % 60)}" r="${5 + (k % 4) * 4}" fill="none" stroke="#dff8f0" stroke-width="3" opacity=".85"/>`).join("")}</g></g>`);
      };
      const sinkOutLife = (tl, id, t0, dur) => {
        tl.fromTo(`#${id}-car`, { y: 0, rotation: 0 }, { y: 70, rotation: 3, duration: dur, ease: "sine.in", immediateRender: false }, t0);
        document.querySelectorAll(`.${id}-bb`).forEach((el, k) => tl.fromTo(el, { y: 0, opacity: 0.9 }, { y: -420 - (k % 5) * 80, x: ((k % 5) - 2) * 18, opacity: 0, duration: 1.4 + (k % 4) * 0.25, repeat: Math.ceil(dur / 1.4), delay: (k % 6) * 0.2, ease: "power1.out", immediateRender: false }, t0));
        tl.fromTo(`.${id}-ray`, { opacity: 0.04 }, { opacity: 0.11, duration: 0.9, repeat: Math.ceil(dur / 0.9), yoyo: true, stagger: 0.25, ease: "sine.inOut", immediateRender: false }, t0);
        tl.fromTo(`#${id}-beams`, { opacity: 1 }, { opacity: 0.55, duration: 0.16, yoyo: true, repeat: 5, immediateRender: false }, t0 + 1.0);
      };
