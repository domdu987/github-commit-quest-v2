      // ---------- นาทีก่อนจม on-screen graphics, in the house style of ผีแม่ม่าย / เห็ดปอบ / ทะเลลด ----------
      // One design language (mmui.js): ink outline 4–5, flat fills, one shade + one highlight, soft drop shadow (#muDrop), Kanit;
      // everything enters eased (back / elastic) and staggered, then keeps a small secondary motion. Screen space: put into L.light.
      const SU = { ink: "#26201c", paper: "#fdfaf2", green: "#2fa864", greenD: "#1e7a48", red: "#e2382e", redD: "#a81e18", yellow: "#ffd23a",
        blue: "#2f6fd0", blueL: "#d6e6fb", water: "#2a7ab8", waterD: "#17507e", slate: "#1e2630", muted: "#8a8f98", car: "#e9edf2", carD: "#b8c2ce" };
      const SO = (w = 4) => `stroke="${SU.ink}" stroke-width="${w}" stroke-linejoin="round" stroke-linecap="round"`;
      let suSeq = 0;
      const SinkUI = {};
      // the four steps' icons (100-unit box, centred): 0 belt release · 1 window down · 2 child out first · 3 out
      SinkUI.icon = (k, x, y, s, id) => {
        let g = "";
        if (k === 0) g = `<path d="M-40,-46L18,24" stroke="#5a6070" stroke-width="18" stroke-linecap="round"/><path d="M-40,-46L18,24" stroke="#8a90a0" stroke-width="6" stroke-linecap="round" opacity=".7"/>
          <rect x="-6" y="8" width="56" height="40" rx="10" fill="#3a3e48" ${SO(3.5)}/><rect id="${id}-btn" x="8" y="18" width="28" height="20" rx="5" fill="${SU.red}" ${SO(2.5)}/>
          <path d="M-30,30l-16,16" stroke="${SU.green}" stroke-width="7" stroke-linecap="round"/><path d="M-50,34l-2,14l14,-2" stroke="${SU.green}" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`;
        if (k === 1) g = `<path d="M-46,-40H30L46,-10V42H-46Z" fill="#cfe4f6" ${SO(3.5)}/><rect id="${id}-gl" x="-40" y="-34" width="80" height="34" fill="#7ab4e0" opacity=".85"/>
          <path d="M-46,4H46" stroke="${SU.ink}" stroke-width="3"/><path d="M0,10V40M-12,28l12,14l12,-14" stroke="${SU.green}" stroke-width="7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`;
        if (k === 2) g = `<path d="M-48,44V-28Q-48,-44 -32,-44H40V44" fill="none" ${SO(3.5)}/><circle cx="-6" cy="-14" r="14" fill="#efc6a0" ${SO(3)}/><path d="M-20,-22q14,-14 28,-2" stroke="#3d241b" stroke-width="7" fill="none"/>
          <path d="M-22,0q16,-6 32,0l4,30h-40Z" fill="#c9b6ea" ${SO(3)}/><path d="M24,-30l20,-20M30,-50h14v14" stroke="${SU.green}" stroke-width="7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`;
        if (k === 3) g = `<path d="M-46,44V-8H46V44" fill="#cfe4f6" opacity=".6" ${SO(3.5)}/><circle cx="2" cy="-26" r="14" fill="#d39a6e" ${SO(3)}/><path d="M-16,-8q18,-8 36,0l4,22h-44Z" fill="#2fa45a" ${SO(3)}/>
          <path d="M-16,-6l-18,-26M20,-6l18,-26" stroke="#d39a6e" stroke-width="8" stroke-linecap="round"/><path d="M0,-48V-62M-10,-54l10,-10l10,10" stroke="${SU.green}" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`;
        return `<g transform="translate(${x},${y}) scale(${s})"><g id="${id}"><circle r="62" fill="#fff" ${SO(4)}/><circle r="62" fill="none" stroke="${SU.green}" stroke-width="8" opacity=".25" transform="scale(.86)"/>${g}</g></g>`;
      };
      SinkUI.RULES = ["ปลดเข็มขัด", "เปิดกระจก", "ส่งเด็กออกก่อน", "ออกทางหน้าต่าง"];
      // the laminated card that hangs from the rear-view mirror: "1 นาที ทำ 4 อย่าง". o.active (−1 none), o.done [i…], o.y, o.s, o.out
      SinkUI.rules = (tl, layer, t0, dur, o = {}) => {
        const id = `sr${suSeq++}`, active = o.active ?? -1, done = o.done || [], Y = o.y ?? 470, S = o.s ?? 1, W = 900, H = 800;
        let c = `<path d="M-50,-${Y + 40}L-14,-6M50,-${Y + 40}L14,-6" stroke="#c8302a" stroke-width="16"/><path d="M-50,-${Y + 40}L-14,-6M50,-${Y + 40}L14,-6" stroke="#ffd36a" stroke-width="3" stroke-dasharray="10 14" opacity=".8"/>
          <circle r="22" fill="${SU.gold || "#e8b860"}" ${SO(3)}/><path d="M-10,-2h20M0,-12v20" stroke="#8a5a1a" stroke-width="4"/>`;
        c += `<g filter="url(#muDrop)"><rect x="${-W / 2}" y="26" width="${W}" height="${H}" rx="38" fill="${SU.paper}" ${SO(5)}/></g>
          <path d="M${-W / 2},64Q${-W / 2},26 ${-W / 2 + 38},26H${W / 2 - 38}Q${W / 2},26 ${W / 2},64V170H${-W / 2}Z" fill="${SU.red}" ${SO(5)}/>
          <circle cx="0" cy="56" r="12" fill="#7a1410"/><text x="0" y="140" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="58" fill="#fff">รถตกน้ำ · <tspan fill="#ffd23a">1 นาที</tspan> ทำ 4 อย่าง</text>`;
        SinkUI.RULES.forEach((t, k) => {
          const y = 270 + k * 140, st = done.includes(k) ? "done" : k === active ? "active" : active < 0 ? "all" : "next";
          c += `<g id="${id}-row${k}" opacity="${st === "next" ? 0.38 : 1}">`;
          if (st === "active") c += `<rect id="${id}-hl" x="-250" y="${y - 40}" width="${t.length * 40 + 60}" height="80" rx="16" fill="${SU.yellow}" opacity=".75"/>`;
          c += `<text x="-388" y="${y + 18}" font-family="Kanit" font-weight="900" font-size="46" fill="${SU.red}">${k + 1}</text>`;
          c += SinkUI.icon(k, -290, y, 0.92, `${id}-i${k}`);
          c += `<text x="-220" y="${y + 18}" font-family="Kanit" font-weight="${st === "active" ? 900 : 800}" font-size="54" fill="${SU.ink}">${t}</text>`;
          if (st === "done") c += `<g transform="translate(370,${y})"><circle r="32" fill="${SU.green}" ${SO(3.5)}/><path id="${id}-ck${k}" d="M-14,0l10,11l19,-21" stroke="#fff" stroke-width="8" fill="none" stroke-linecap="round" stroke-linejoin="round" pathLength="1" stroke-dasharray="1 1"/></g>`;
          c += `</g>`;
        });
        put(layer, `<g transform="translate(540,${Y}) scale(${S})"><g id="${id}" opacity="0">${c}</g></g>`);
        tl.set(`#${id}`, { opacity: 1 }, t0);
        tl.fromTo(`#${id}`, { y: -1000 }, { y: 0, duration: 0.55, ease: "power3.out", immediateRender: false }, t0);
        tl.fromTo(`#${id}`, { rotation: 9, svgOrigin: `0 -${Y + 40}` }, { rotation: 0, svgOrigin: `0 -${Y + 40}`, duration: 1.8, ease: "elastic.out(1, 0.3)", immediateRender: false }, t0 + 0.2);
        tl.to(`#${id}`, { rotation: 1.2, svgOrigin: `0 -${Y + 40}`, duration: 1.4, yoyo: true, repeat: Math.max(0, Math.ceil((dur - 2) / 1.4)), ease: "sine.inOut" }, t0 + 2.0);
        SinkUI.RULES.forEach((_, k) => tl.fromTo(`#${id}-row${k}`, { x: 70 }, { x: 0, duration: 0.45, ease: "power3.out", immediateRender: false }, t0 + 0.4 + k * (o.stagger ?? 0.12)));
        done.forEach((k, j) => tl.fromTo(`#${id}-ck${k}`, { attr: { "stroke-dashoffset": 1 } }, { attr: { "stroke-dashoffset": 0 }, duration: 0.35, ease: "power2.out", immediateRender: false }, t0 + 0.8 + j * 0.12));
        if (active >= 0) {
          tl.fromTo(`#${id}-i${active}`, { scale: 0.4, svgOrigin: "0 0" }, { scale: 1, svgOrigin: "0 0", duration: 0.6, ease: "back.out(3)", immediateRender: false }, t0 + 0.7);
          tl.fromTo(`#${id}-hl`, { scaleX: 0, svgOrigin: `-250 0` }, { scaleX: 1, svgOrigin: `-250 0`, duration: 0.5, ease: "power2.inOut", immediateRender: false }, t0 + 0.9);
          tl.to(`#${id}-i${active}`, { scale: 1.1, svgOrigin: "0 0", duration: 0.45, yoyo: true, repeat: Math.max(1, Math.ceil((dur - 1.4) / 0.45)), ease: "sine.inOut" }, t0 + 1.35);
        } else SinkUI.RULES.forEach((_, k) => tl.fromTo(`#${id}-i${k}`, { scale: 0.3, svgOrigin: "0 0" }, { scale: 1, svgOrigin: "0 0", duration: 0.5, ease: "back.out(3)", immediateRender: false }, t0 + 0.6 + k * (o.stagger ?? 0.12)));
        if (o.out !== false) tl.to(`#${id}`, { y: -70, opacity: 0, duration: 0.3, ease: "power2.in" }, t0 + (o.out ?? dur) - 0.3);
        return id;
      };
      // a simple sedan side-on for the diagrams (nose right), ink style; (0,0) = the middle of its belly
      SinkUI.car = (c = SU.car) => `<path d="M-300,-30Q-310,-110 -230,-120L-150,-200Q-60,-218 60,-212Q130,-208 170,-176L240,-120Q300,-112 312,-70L318,-24Q316,0 290,2H-280Q-300,0 -300,-30Z" fill="${c}" ${SO(5)}/>
        <path d="M-136,-186L-80,-120H40V-196Q-40,-200 -136,-186Z" fill="#5a7a96" ${SO(3.5)}/><path d="M60,-196V-120H200L150,-176Q120,-196 60,-196Z" fill="#5a7a96" ${SO(3.5)}/>
        <path d="M-120,-180L-90,-130" stroke="#fff" stroke-width="6" opacity=".5"/><path d="M-300,-66H316" stroke="${SU.carD}" stroke-width="5"/><path d="M50,-118V0" stroke="${SU.carD}" stroke-width="4"/>
        <rect x="292" y="-104" width="26" height="20" rx="6" fill="#fff4c8" ${SO(2.5)}/><rect x="-306" y="-100" width="14" height="24" rx="4" fill="#d8302a" ${SO(2.5)}/>
        ${[-180, 190].map((x) => `<g transform="translate(${x},0)"><circle r="54" fill="#22262e" ${SO(4)}/><circle r="26" fill="#9aa2ae" ${SO(3)}/><circle r="8" fill="#3a3e48"/></g>`).join("")}`;
      // a stopwatch (chrome case, crown, the minute dial, a red hand); #id-hand rotates about (0,0)
      SinkUI.watch = (id, x, y, s) => `<g transform="translate(${x},${y}) scale(${s})"><g filter="url(#muDrop)"><rect x="-26" y="-196" width="52" height="40" rx="8" fill="#c8ccd4" ${SO(4)}/><rect x="-40" y="-214" width="80" height="26" rx="10" fill="#e0e4ea" ${SO(4)}/>
        <circle r="170" fill="#d4d8de" ${SO(5)}/></g><circle r="148" fill="#fdfaf2" ${SO(4)}/><path d="M-100,-104A148,148 0 0 1 104,-100" stroke="#fff" stroke-width="10" fill="none" opacity=".7"/>
        ${Array.from({ length: 60 }, (_, k) => { const a = (k / 60) * Math.PI * 2, r0 = k % 5 ? 132 : 120; return `<path d="M${f1(Math.sin(a) * r0)},${f1(-Math.cos(a) * r0)}L${f1(Math.sin(a) * 142)},${f1(-Math.cos(a) * 142)}" stroke="${SU.ink}" stroke-width="${k % 5 ? 2.5 : 5}"/>`; }).join("")}
        ${[0, 15, 30, 45].map((n) => { const a = (n / 60) * Math.PI * 2; return `<text x="${f1(Math.sin(a) * 96)}" y="${f1(-Math.cos(a) * 96 + 14)}" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="38" fill="${SU.ink}">${n || 60}</text>`; }).join("")}
        <path id="${id}-sweep" d="M0,0V-140A140,140 0 0 1 0,-140Z" fill="${SU.red}" opacity=".18"/><g id="${id}-hand"><path d="M0,22V-128" stroke="${SU.red}" stroke-width="8" stroke-linecap="round"/><circle r="14" fill="${SU.red}" ${SO(3)}/></g></g>`;
      // the minute afloat: the canal in cross-section, the car floats, tips nose down and goes under while the watch runs to 60
      SinkUI.minute = (tl, layer, t0, dur, o = {}) => {
        const id = `sm${suSeq++}`;
        put(layer, `<g id="${id}"><rect width="1080" height="1920" fill="#1a1e44"/><rect y="0" width="1080" height="560" fill="#2a2a68"/>
          ${Array.from({ length: 30 }, (_, k) => `<circle cx="${(k * 137) % 1080}" cy="${40 + ((k * 89) % 480)}" r="${1.5 + (k % 3)}" fill="#fff" opacity=".6"/>`).join("")}
          <path d="M0,560H1080V1920H0Z" fill="#2a7ab8"/><path d="M0,560H1080V1920H0Z" fill="url(#${id}-wg)"/>
          <linearGradient id="${id}-wg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a9ad0"/><stop offset=".55" stop-color="#1a5a8e"/><stop offset="1" stop-color="#0a2a4a"/></linearGradient>
          ${[[180, 140], [520, 110], [820, 160]].map(([x, w]) => `<path d="M${x},560h${w}l-160,1360h-${w + 120}Z" fill="#cfefff" opacity=".08"/>`).join("")}
          <path d="M0,560Q90,548 180,560T360,560T540,560T720,560T900,560T1080,560" stroke="#d8f2ff" stroke-width="7" fill="none"/>
          <path d="M0,520L0,1920H120Q150,1500 110,1200Q90,900 60,560Z" fill="#3a5a3a" ${SO(4)}/><path d="M0,520H60L62,560" fill="#4a4c58" ${SO(4)}/>
          <path d="M0,1780Q300,1720 540,1760T1080,1740V1920H0Z" fill="#4a3a2a" ${SO(4)}/>${Array.from({ length: 9 }, (_, k) => `<path d="M${150 + k * 110},${1770 - (k % 3) * 12}q${k % 2 ? 16 : -16},-70 ${k % 2 ? -6 : 6},-110" stroke="#2f6a3c" stroke-width="9" fill="none"/>`).join("")}
          <g transform="translate(420,600)"><g id="${id}-car"><g transform="scale(.95)">${SinkUI.car()}</g></g></g>
          ${Array.from({ length: 12 }, (_, k) => `<circle id="${id}-bb${k}" cx="${330 + (k * 37) % 200}" cy="700" r="${6 + (k % 4) * 4}" fill="none" stroke="#e8f8ff" stroke-width="3.5" opacity="0"/>`).join("")}
          ${SinkUI.watch(`${id}-w`, 850, 290, 0.9)}
          <g transform="translate(850,500)"><rect x="-130" y="-34" width="260" height="68" rx="34" fill="${SU.paper}" ${SO(4)}/><text y="16" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="44" fill="${SU.red}">≈ 1 นาที</text></g></g>`);
        tl.fromTo(`#${id}`, { opacity: 0 }, { opacity: 1, duration: 0.25, immediateRender: false }, t0);
        tl.fromTo(`#${id}-w-hand`, { rotation: 0, svgOrigin: "0 0" }, { rotation: 360, svgOrigin: "0 0", duration: dur - 0.4, ease: "none", immediateRender: false }, t0 + 0.2);
        const sw = { a: 0 }, el = document.getElementById(`${id}-w-sweep`);
        tl.to(sw, { a: 359.9, duration: dur - 0.4, ease: "none", immediateRender: false, onUpdate: () => { const a = (sw.a * Math.PI) / 180, big = sw.a > 180 ? 1 : 0; el.setAttribute("d", `M0,0V-140A140,140 0 ${big} 1 ${f1(Math.sin(a) * 140)},${f1(-Math.cos(a) * 140)}Z`); } }, t0 + 0.2);
        // afloat, bobbing; the nose (engine) goes first; under; down to the mud
        tl.fromTo(`#${id}-car`, { y: 0, rotation: 0, svgOrigin: "0 -80" }, { y: 14, duration: 0.5, yoyo: true, repeat: 1, ease: "sine.inOut", immediateRender: false }, t0 + 0.1);
        tl.to(`#${id}-car`, { rotation: 32, y: 120, svgOrigin: "0 -80", duration: dur * 0.35, ease: "power1.in" }, t0 + 1.1);
        tl.to(`#${id}-car`, { rotation: 48, y: 820, svgOrigin: "0 -80", duration: dur * 0.42, ease: "power1.in" }, t0 + 1.1 + dur * 0.35);
        for (let k = 0; k < 12; k++) tl.fromTo(`#${id}-bb${k}`, { y: 60 + (k % 4) * 80, opacity: 0.9 }, { y: -160, opacity: 0, duration: 1.0 + (k % 3) * 0.3, ease: "power1.out", immediateRender: false }, t0 + 1.3 + (k % 6) * 0.25);
      };
      // a forbidden thing on a tile, stamped with the red no-sign: o.what "phone" | "headrest" | "jump" | "door"
      SinkUI.nope = (tl, layer, t0, dur, o = {}) => {
        const id = `sn${suSeq++}`, x = o.x ?? 540, y = o.y ?? 820;
        let pic = "";
        if (o.what === "phone") pic = `<g transform="rotate(-8)"><rect x="-120" y="-220" width="240" height="440" rx="40" fill="#1b1f26" ${SO(5)}/><rect x="-104" y="-202" width="208" height="404" rx="28" fill="url(#mu2Scr)"/>
          <circle cx="0" cy="-90" r="56" fill="#f2b6a0" ${SO(3)}/><path d="M-40,-110q40,-50 80,0" stroke="#3a241c" stroke-width="16" fill="none"/><text y="10" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="40" fill="#fff">แม่</text>
          <text y="52" text-anchor="middle" font-family="Kanit" font-weight="500" font-size="26" fill="#aab4c2">สายเรียกเข้า…</text><circle cx="-60" cy="140" r="34" fill="${SU.red}"/><circle cx="60" cy="140" r="34" fill="${SU.green}"/>
          <path d="M44,140h32M-76,140h32" stroke="#fff" stroke-width="8" stroke-linecap="round"/></g>`;
        if (o.what === "jump") pic = `<path d="M-260,120Q-200,96 -130,120T0,120T130,120T260,120V300H-260Z" fill="#5ab0e0" ${SO(4)}/><path d="M-260,120Q-200,96 -130,120T0,120T130,120T260,120" stroke="#fff" stroke-width="8" fill="none" opacity=".6"/>
          <g transform="translate(-20,-60) rotate(40)"><circle cx="0" cy="-120" r="34" fill="#d39a6e" ${SO(4)}/><path d="M-28,-84Q0,-94 28,-84L32,30H-32Z" fill="#2fa45a" ${SO(4)}/><path d="M-14,30L-20,120M14,30L18,120" stroke="#3b4a63" stroke-width="24" stroke-linecap="round"/>
            <path d="M-24,-74L-46,-190M24,-74L46,-190" stroke="#2fa45a" stroke-width="20" stroke-linecap="round"/></g>
          <path d="M140,-40q30,10 40,-20M160,10q30,4 44,-22" stroke="${SU.ink}" stroke-width="6" fill="none" opacity=".5"/>`;
        if (o.what === "headrest") pic = `<rect x="-150" y="-170" width="300" height="190" rx="70" fill="#4a5060" ${SO(5)}/><path d="M-110,-150Q0,-180 110,-150" stroke="#6a7286" stroke-width="10" fill="none"/><rect x="-80" y="20" width="22" height="200" rx="8" fill="#c8ccd4" ${SO(4)}/><rect x="58" y="20" width="22" height="200" rx="8" fill="#c8ccd4" ${SO(4)}/>`;
        put(layer, `<g transform="translate(${x},${y})"><g id="${id}" opacity="0"><g filter="url(#muDrop)"><rect x="-300" y="-330" width="600" height="660" rx="48" fill="${SU.paper}" ${SO(5)}/></g>
          <rect x="-300" y="-330" width="600" height="660" rx="48" fill="#e9f6ee" opacity=".7"/><g id="${id}-pic">${pic}</g>
          <g id="${id}-no"><circle r="250" fill="none" stroke="${SU.red}" stroke-width="40" opacity=".92"/><path d="M-176,-176L176,176" stroke="${SU.red}" stroke-width="40" stroke-linecap="round" opacity=".92"/></g>
          ${o.label ? `<g transform="translate(0,380)"><rect x="-${o.label.length * 22 + 40}" y="-44" width="${o.label.length * 44 + 80}" height="88" rx="44" fill="${SU.red}" ${SO(4)}/><text y="18" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="52" fill="#fff">${o.label}</text></g>` : ""}</g></g>`);
        tl.fromTo(`#${id}`, { opacity: 0, scale: 0.6, svgOrigin: "0 0" }, { opacity: 1, scale: 1, svgOrigin: "0 0", duration: 0.4, ease: "back.out(2.4)", immediateRender: false }, t0);
        if (o.what === "phone") tl.fromTo(`#${id}-pic`, { rotation: -3, svgOrigin: "0 0" }, { rotation: 3, svgOrigin: "0 0", duration: 0.07, yoyo: true, repeat: 9, ease: "none", immediateRender: false }, t0 + 0.3);
        tl.fromTo(`#${id}-no`, { scale: 2.2, opacity: 0, svgOrigin: "0 0" }, { scale: 1, opacity: 1, svgOrigin: "0 0", duration: 0.32, ease: "power4.in", immediateRender: false }, t0 + (o.stamp ?? 0.55));
        tl.fromTo(`#${id}`, { x: -10 }, { x: 0, duration: 0.25, ease: "elastic.out(1.2,0.3)", immediateRender: false }, t0 + (o.stamp ?? 0.55) + 0.32);
        tl.to(`#${id}`, { opacity: 0, scale: 0.9, svgOrigin: "0 0", duration: 0.2, ease: "power2.in" }, t0 + dur - 0.2);
      };
      // the door from outside, under the water: the canal leans on it (arrows), about a hundred kilos of it; his push from inside does nothing
      SinkUI.press = (tl, layer, t0, dur, o = {}) => {
        const id = `sp${suSeq++}`;
        put(layer, `<g id="${id}"><rect width="1080" height="1920" fill="#14425e"/><rect width="1080" height="1920" fill="url(#${id}-g)"/>
          <linearGradient id="${id}-g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a8ab8"/><stop offset="1" stop-color="#0a2236"/></linearGradient>
          ${[[140, 120], [460, 90], [760, 140]].map(([x, w]) => `<path d="M${x},0h${w}l-200,1920h-${w + 140}Z" fill="#cfefff" opacity=".07"/>`).join("")}
          <g transform="translate(640,900)"><g filter="url(#muDrop)"><path d="M-110,-560H260V500H-110Z" fill="#dfe4ea" ${SO(6)}/></g><path d="M-80,-530H230V-60H-80Z" fill="#3a6a8a" ${SO(4)}/><path d="M-60,-500L40,-120" stroke="#fff" stroke-width="10" opacity=".35"/>
            <rect x="-90" y="40" width="70" height="26" rx="10" fill="#9aa4ae" ${SO(3)}/><path d="M-110,-20H260" stroke="#b8c2ce" stroke-width="6"/>
            <path d="M260,-560H520V500H260" fill="#2a3a48" opacity=".55"/><text x="330" y="-480" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="40" fill="#e8f0f8">ในรถ</text></g>
          <g transform="translate(940,960)"><g id="${id}-hand">${handAt([0, 0], -90, 1.5, SK.ton, { ...GRIP, band: BAND, sw: 0.6, fore: 600 })}</g></g>
          ${[0, 1, 2, 3, 4, 5].map((k) => `<g transform="translate(${130 + (k % 2) * 60},${420 + k * 170})"><g id="${id}-a${k}"><path d="M0,-26H230V-58L330,0L230,58V26H0Z" fill="#7ad0ff" ${SO(4)}/><path d="M14,-12H220" stroke="#fff" stroke-width="6" opacity=".6"/></g></g>`).join("")}
          <g transform="translate(300,300)"><g id="${id}-kg"><g filter="url(#muDrop)"><path d="M-130,40Q-150,-60 -80,-90H80Q150,-60 130,40Q120,110 0,116Q-120,110 -130,40Z" fill="#3a3e48" ${SO(5)}/></g>
            <path d="M-60,-90Q-60,-170 0,-170Q60,-170 60,-90" stroke="#3a3e48" stroke-width="30" fill="none"/><path d="M-60,-90Q-60,-170 0,-170Q60,-170 60,-90" stroke="${SU.ink}" stroke-width="4" fill="none"/>
            <text y="40" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="58" fill="#fff">≈100</text><text y="88" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="36" fill="#d8dce4">กิโล</text></g></g>
          ${Array.from({ length: 10 }, (_, k) => `<circle id="${id}-bb${k}" cx="${120 + (k * 97) % 860}" cy="1700" r="${6 + (k % 4) * 4}" fill="none" stroke="#e8f8ff" stroke-width="3" opacity=".7"/>`).join("")}
          <g transform="translate(700,960)"><g id="${id}-x" opacity="0"><circle r="66" fill="${SU.red}" ${SO(5)}/><path d="M-28,-28L28,28M28,-28L-28,28" stroke="#fff" stroke-width="16" stroke-linecap="round"/></g></g></g>`);
        tl.fromTo(`#${id}`, { opacity: 0 }, { opacity: 1, duration: 0.25, immediateRender: false }, t0);
        [0, 1, 2, 3, 4, 5].forEach((k) => { tl.fromTo(`#${id}-a${k}`, { x: -420, opacity: 0 }, { x: 0, opacity: 1, duration: 0.45, ease: "back.out(1.6)", immediateRender: false }, t0 + 0.2 + k * 0.08);
          tl.to(`#${id}-a${k}`, { x: 22, duration: 0.5, yoyo: true, repeat: Math.ceil(dur / 0.5), ease: "sine.inOut" }, t0 + 0.9 + k * 0.06); });
        tl.fromTo(`#${id}-kg`, { y: -500, rotation: -12, svgOrigin: "0 0" }, { y: 0, rotation: 0, svgOrigin: "0 0", duration: 0.6, ease: "bounce.out", immediateRender: false }, t0 + 0.5);
        tl.fromTo(`#${id}-hand`, { x: 160 }, { x: 0, duration: 0.5, ease: "power3.out", immediateRender: false }, t0 + 1.2);
        tl.to(`#${id}-hand`, { x: -14, duration: 0.12, yoyo: true, repeat: 7, ease: "sine.inOut" }, t0 + 1.7);
        tl.fromTo(`#${id}-x`, { opacity: 0, scale: 0.3, svgOrigin: "0 0" }, { opacity: 1, scale: 1, svgOrigin: "0 0", duration: 0.4, ease: "back.out(3)", immediateRender: false }, t0 + 2.6);
        for (let k = 0; k < 10; k++) tl.fromTo(`#${id}-bb${k}`, { y: 0 }, { y: -1500, duration: 3 + (k % 3), repeat: 1, ease: "none", immediateRender: false }, t0 + k * 0.2);
      };
      // the phone on the bank: 1669 calling, a green "ขึ้นฝั่งแล้ว" chip; the phone wet, dripping, held in a real hand
      SinkUI.call = (tl, layer, t0, dur, o = {}) => {
        const id = `sc${suSeq++}`, W = 400, H = 780;
        put(layer, `<g id="${id}" opacity="0"><g transform="translate(560,860) rotate(-6)"><g id="${id}-ph">
          <g filter="url(#muDrop)"><rect x="${-W / 2}" y="${-H / 2}" width="${W}" height="${H}" rx="60" fill="#1b1f26" ${SO(5)}/></g><rect x="${-W / 2 + 14}" y="${-H / 2 + 14}" width="${W - 28}" height="${H - 28}" rx="48" fill="url(#mu2Scr)"/>
          <rect x="-50" y="${-H / 2 + 26}" width="100" height="22" rx="11" fill="#07090c"/>
          <g transform="translate(0,${-H / 2 + 220})">${[0, 1, 2].map((k) => `<circle id="${id}-rg${k}" r="86" fill="none" stroke="#7fd8a0" stroke-width="5" opacity="0"/>`).join("")}<circle r="86" fill="${SU.green}" ${SO(4)}/>
            <path d="M-34,-12q6,-26 22,-26l10,22l-12,10q8,18 26,28l10,-12l22,10q0,18 -26,22q-60,-6 -52,-54z" fill="#fff"/></g>
          <text y="${-H / 2 + 400}" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="88" fill="#fff" letter-spacing="2">1669</text>
          <text y="${-H / 2 + 450}" text-anchor="middle" font-family="Kanit" font-weight="500" font-size="28" fill="#aab4c2">แจ้งเหตุฉุกเฉิน</text>
          <text id="${id}-st" y="${-H / 2 + 510}" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="32" fill="#7fd8a0">กำลังโทร…</text>
          <g transform="translate(0,${H / 2 - 110})"><circle r="44" fill="${SU.red}" ${SO(3)}/><path d="M-18,4h36" stroke="#fff" stroke-width="9" stroke-linecap="round"/></g>
          ${Array.from({ length: 7 }, (_, k) => `<ellipse cx="${-150 + k * 50}" cy="${-260 + (k * 97) % 520}" rx="${6 + (k % 3) * 3}" ry="${9 + (k % 3) * 4}" fill="#cfefff" opacity=".55"/>`).join("")}
          ${[0, 1, 2].map((k) => `<path id="${id}-dr${k}" d="M${-120 + k * 110},${H / 2 - 6}c-7,12 -7,20 0,22c7,-2 7,-10 0,-22z" fill="#9fd8ff"/>`).join("")}</g></g>
          <g transform="translate(540,300)"><g id="${id}-chip"><rect x="-230" y="-48" width="460" height="96" rx="48" fill="${SU.paper}" ${SO(5)}/><circle cx="-180" cy="0" r="30" fill="${SU.green}" ${SO(3)}/><path d="M-194,0l10,11l18,-20" stroke="#fff" stroke-width="7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <text x="20" y="18" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="48" fill="${SU.ink}">ขึ้นฝั่งแล้ว</text></g></g></g>`);
        tl.set(`#${id}`, { opacity: 1 }, t0);
        tl.fromTo(`#${id}-ph`, { y: 900, rotation: 10, svgOrigin: "0 0" }, { y: 0, rotation: 0, svgOrigin: "0 0", duration: 0.6, ease: "back.out(1.4)", immediateRender: false }, t0);
        tl.fromTo(`#${id}-chip`, { scale: 0, svgOrigin: "0 0" }, { scale: 1, svgOrigin: "0 0", duration: 0.45, ease: "back.out(2.6)", immediateRender: false }, t0 + (o.chip ?? 0.4));
        for (let k = 0; k < 3; k++) tl.fromTo(`#${id}-rg${k}`, { attr: { r: 86 }, opacity: 0.9 }, { attr: { r: 170 }, opacity: 0, duration: 1.2, repeat: Math.ceil(dur / 1.2), ease: "power1.out", immediateRender: false }, t0 + 0.6 + k * 0.4);
        for (let k = 0; k < 3; k++) tl.fromTo(`#${id}-dr${k}`, { y: 0, opacity: 1 }, { y: 120, opacity: 0, duration: 0.7, repeat: Math.ceil(dur / 1.0), repeatDelay: 0.3, ease: "power2.in", immediateRender: false }, t0 + 0.5 + k * 0.3);
        tl.to(`#${id}-ph`, { rotation: 1.5, svgOrigin: "0 0", duration: 1.2, yoyo: true, repeat: Math.ceil(dur / 1.2), ease: "sine.inOut" }, t0 + 0.6);
      };
      // from above: the car's four windows; the lock button pressed → three windows lock (red), the driver's stays open (green)
      SinkUI.locks = (tl, layer, t0, dur, o = {}) => {
        const id = `sl${suSeq++}`;
        const lock = (k, x, y, open) => `<g transform="translate(${x},${y})"><g id="${id}-L${k}"><circle r="56" fill="${open ? SU.green : SU.red}" ${SO(4)}/>
          <rect x="-24" y="-6" width="48" height="38" rx="7" fill="#fff"/><path d="M-14,-6V-20Q-14,-38 0,-38Q14,-38 14,-20${open ? "V-30" : "V-6"}" stroke="#fff" stroke-width="8" fill="none" ${open ? 'transform="translate(14,-4)"' : ""}/></g></g>`;
        put(layer, `<g id="${id}" opacity="0"><rect width="1080" height="1920" fill="#1e2a44" opacity=".9"/>
          <g transform="translate(540,880)"><g filter="url(#muDrop)"><path d="M-230,-470Q-230,-560 -120,-570H120Q230,-560 230,-470V460Q230,560 120,570H-120Q-230,560 -230,460Z" fill="${SU.car}" ${SO(6)}/></g>
            <path d="M-180,-380Q0,-430 180,-380L160,-250Q0,-280 -160,-250Z" fill="#5a7a96" ${SO(4)}/><path d="M-170,360Q0,400 170,360L156,260Q0,284 -156,260Z" fill="#5a7a96" ${SO(4)}/>
            <rect x="-150" y="-230" width="300" height="470" rx="40" fill="#dfe4ea" ${SO(4)}/><path d="M-150,-10H150" stroke="#b8c2ce" stroke-width="5"/>
            ${[[-1, -150], [1, -150], [-1, 120], [1, 120]].map(([sd, y]) => `<path d="M${sd * 232},${y}V${y + 210}" stroke="#7ab4e0" stroke-width="18" stroke-linecap="round"/>`).join("")}
            <path d="M-238,-300l-50,-20v40Z M238,-300l50,-20v40Z" fill="${SU.carD}" ${SO(3)}/>
            <g transform="translate(90,-80)"><circle r="44" fill="#2a2e38" ${SO(3)}/><circle r="30" fill="none" stroke="#9aa2ae" stroke-width="8"/><text y="96" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="34" fill="${SU.ink}">คนขับ</text></g></g>
          ${lock(0, 850, 860, true)}${lock(1, 230, 860, false)}${lock(2, 230, 1130, false)}${lock(3, 850, 1130, false)}
          <g transform="translate(540,250)"><g id="${id}-btn"><g filter="url(#muDrop)"><rect x="-210" y="-80" width="420" height="160" rx="30" fill="#2a2e38" ${SO(5)}/></g>
            <rect x="-180" y="-52" width="120" height="104" rx="18" fill="#3a3e4a" ${SO(3)}/><rect x="-148" y="-14" width="56" height="44" rx="8" fill="#e8ecf2"/><path d="M-136,-14V-28Q-136,-44 -120,-44Q-104,-44 -104,-28V-14" stroke="#e8ecf2" stroke-width="8" fill="none"/>
            <circle id="${id}-led" cx="-82" cy="-38" r="9" fill="#5a3a20"/><text x="60" y="16" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="38" fill="#f4f0e6">ปุ่มล็อกกระจก</text></g></g></g>`);
        tl.fromTo(`#${id}`, { opacity: 0 }, { opacity: 1, duration: 0.25, immediateRender: false }, t0);
        tl.fromTo(`#${id}-btn`, { scale: 0.5, svgOrigin: "0 0" }, { scale: 1, svgOrigin: "0 0", duration: 0.45, ease: "back.out(2.4)", immediateRender: false }, t0 + 0.1);
        tl.to(`#${id}-btn`, { scale: 0.94, svgOrigin: "0 0", duration: 0.1, yoyo: true, repeat: 1 }, t0 + 0.7);
        tl.set(`#${id}-led`, { attr: { fill: "#ff9a2a" } }, t0 + 0.75);
        [1, 2, 3].forEach((k, j) => tl.fromTo(`#${id}-L${k}`, { scale: 0, svgOrigin: "0 0" }, { scale: 1, svgOrigin: "0 0", duration: 0.4, ease: "back.out(3)", immediateRender: false }, t0 + 0.9 + j * 0.18));
        tl.fromTo(`#${id}-L0`, { scale: 0, svgOrigin: "0 0" }, { scale: 1, svgOrigin: "0 0", duration: 0.5, ease: "back.out(3)", immediateRender: false }, t0 + (o.driver ?? 1.8));
        tl.to(`#${id}-L0`, { scale: 1.12, svgOrigin: "0 0", duration: 0.35, yoyo: true, repeat: Math.max(1, Math.ceil((dur - 2.4) / 0.35)), ease: "sine.inOut" }, t0 + (o.driver ?? 1.8) + 0.5);
      };
      // a name tag that pops near someone (screen space), as in ทะเลลด
      SinkUI.tag = (tl, layer, t0, dur, x, y, text, c = "#e8823a") => {
        const id = `st${suSeq++}`, w = 30 * text.length + 70;
        put(layer, `<g transform="translate(${x},${y})"><g id="${id}" opacity="0"><rect x="${-w / 2 + 4}" y="-30" width="${w}" height="66" rx="33" fill="#0a1a24" opacity=".35"/>
          <rect x="${-w / 2}" y="-36" width="${w}" height="66" rx="33" fill="${SU.paper}" stroke="#2a2420" stroke-width="4"/><circle cx="${-w / 2 + 34}" cy="-3" r="16" fill="${c}" stroke="#2a2420" stroke-width="3"/>
          <text x="${-w / 2 + 60}" y="9" font-family="Kanit" font-weight="800" font-size="34" fill="#1e2a3a">${text}</text></g></g>`);
        tl.set(`#${id}`, { opacity: 1 }, t0);
        tl.fromTo(`#${id}`, { scale: 0.3, rotation: -8, svgOrigin: "0 0" }, { scale: 1, rotation: 0, svgOrigin: "0 0", duration: 0.5, ease: "back.out(3)", immediateRender: false }, t0);
        tl.to(`#${id}`, { opacity: 0, duration: 0.2 }, t0 + dur - 0.2);
      };
      // the end card: the canal's warning sign at night, a paper note taped under it names the next episode (wet, dripping)
      SinkUI.nextSign = (tl, layer, t0, dur, o = {}) => {
        const id = `sx${suSeq++}`;
        put(layer, `<g id="${id}" opacity="0"><rect width="1080" height="1920" fill="#120f2e"/><rect width="1080" height="1920" fill="url(#klSky)" opacity=".85"/>
          <circle cx="820" cy="300" r="240" fill="url(#klMoon)"/><circle cx="820" cy="300" r="58" fill="#fff6dc"/>
          <path d="M0,1500Q300,1460 540,1490T1080,1470V1920H0Z" fill="#11293e"/>${Array.from({ length: 10 }, (_, j) => `<path d="M${780 + (j % 2) * 16},${1500 + j * 36}h${70 - j * 5}" stroke="#fff4d0" stroke-width="6" opacity="${(0.6 - j * 0.05).toFixed(2)}"/>`).join("")}
          <rect x="520" y="900" width="40" height="700" fill="#8a909c" ${SO(4)}/>
          <g transform="translate(540,760)"><g id="${id}-sg"><g filter="url(#muDrop)"><rect x="-330" y="-240" width="660" height="430" rx="26" fill="#f2c020" ${SO(6)}/></g><rect x="-306" y="-216" width="612" height="382" rx="18" fill="none" stroke="${SU.ink}" stroke-width="6"/>
            <text y="-120" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="92" fill="${SU.ink}">ระวัง!</text>
            <g transform="translate(0,30)"><path d="M-200,40Q-100,10 0,40T200,40" stroke="${SU.ink}" stroke-width="10" fill="none"/><path d="M-200,80Q-100,50 0,80T200,80" stroke="${SU.ink}" stroke-width="8" fill="none" opacity=".7"/>
              <g transform="translate(-30,-10) rotate(28)"><path d="M-80,0Q-84,-30 -60,-34L-40,-60H40L60,-34Q84,-30 80,0Z" fill="${SU.ink}"/><circle cx="-50" cy="4" r="16" fill="${SU.ink}"/><circle cx="50" cy="4" r="16" fill="${SU.ink}"/></g></g>
            <text y="150" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="52" fill="${SU.ink}">ถนนเลียบคลอง</text></g></g>
          <g transform="translate(560,1130) rotate(3)"><g id="${id}-nt"><rect x="-260" y="0" width="520" height="290" fill="#f4eedc" ${SO(3.5)}/><rect x="-60" y="-18" width="120" height="40" fill="#e8dca8" opacity=".85" transform="rotate(-4)"/>
            <text y="86" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="46" fill="#b8261c">${o.l1 || "ตอนที่ 2"}</text>
            <text y="170" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="${o.l2 && o.l2.length > 12 ? 58 : 70}" fill="#b8261c">${o.l2 || ""}</text>
            <text y="244" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="32" fill="#5a4a3a">${o.l3 || "กดติดตาม แล้วพาขิมออกไปด้วยกัน"}</text></g></g>
          ${Array.from({ length: 6 }, (_, k) => `<path id="${id}-d${k}" d="M${300 + k * 90},1420c-7,12 -7,20 0,22c7,-2 7,-10 0,-22z" fill="#9fc3d8" opacity=".85"/>`).join("")}
          <text x="540" y="1700" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="44" fill="#fff" letter-spacing="10">ROD MAI CLUB</text></g>`);
        tl.fromTo(`#${id}`, { opacity: 0 }, { opacity: 1, duration: 0.35, immediateRender: false }, t0);
        tl.fromTo(`#${id}-sg`, { y: -300, rotation: -6, svgOrigin: "0 0" }, { y: 0, rotation: 0, svgOrigin: "0 0", duration: 0.7, ease: "bounce.out", immediateRender: false }, t0 + 0.1);
        tl.fromTo(`#${id}-nt`, { scaleY: 0, svgOrigin: "0 0" }, { scaleY: 1, svgOrigin: "0 0", duration: 0.5, ease: "back.out(2)", immediateRender: false }, t0 + 0.6);
        tl.to(`#${id}-nt`, { rotation: 5, svgOrigin: "0 0", duration: 0.9, yoyo: true, repeat: Math.ceil(dur / 0.9), ease: "sine.inOut" }, t0 + 1.1);
        for (let k = 0; k < 6; k++) tl.fromTo(`#${id}-d${k}`, { y: 0, opacity: 0.9 }, { y: 180, opacity: 0, duration: 0.8, repeat: Math.ceil(dur / 1.2), repeatDelay: 0.4, ease: "power2.in", immediateRender: false }, t0 + 0.4 + k * 0.2);
      };
      // ---------- EP.2 cards ----------
      // a paper card with a coloured header (screen space), returns the inner markup's wrapper ids: #id (in/out), header text
      const suCard = (id, x, y, W, H, head, hc = SU.red) => `<g transform="translate(${x},${y})"><g id="${id}"><g filter="url(#muDrop)"><rect x="${-W / 2}" y="0" width="${W}" height="${H}" rx="36" fill="${SU.paper}" ${SO(5)}/></g>
        <path d="M${-W / 2},36Q${-W / 2},0 ${-W / 2 + 36},0H${W / 2 - 36}Q${W / 2},0 ${W / 2},36V112H${-W / 2}Z" fill="${hc}" ${SO(5)}/><text y="78" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="52" fill="#fff">${head}</text>`;
      const suIn = (tl, id, t0, dur) => { tl.fromTo(`#${id}`, { y: 80, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: "back.out(1.8)", immediateRender: false }, t0); tl.to(`#${id}`, { opacity: 0, duration: 0.2 }, t0 + dur - 0.2); };
      const suBg = (layer, c = "#1a2a44") => put(layer, `<rect width="1080" height="1920" fill="${c}"/><rect width="1080" height="1920" fill="url(#klSky)" opacity=".55"/>`);
      // the crack star (lines + rings) at (x,y), class `${id}-ck` to draw on
      const suCrack = (id, x, y, r = 120, n = 11) => `<g transform="translate(${x},${y})">${Array.from({ length: n }, (_, k) => { const a = (k / n) * Math.PI * 2 + (k % 3) * 0.2, L = r * (0.7 + (k % 4) * 0.12);
        return `<path class="${id}-ck" d="M0,0L${f1(Math.cos(a) * L * 0.5)},${f1(Math.sin(a) * L * 0.5)}L${f1(Math.cos(a + 0.12) * L)},${f1(Math.sin(a + 0.12) * L)}" stroke="#fff" stroke-width="5" fill="none" pathLength="1" stroke-dasharray="1 1" stroke-dashoffset="1"/>`; }).join("")}
        ${[0.35, 0.62].map((q) => `<circle class="${id}-ck" r="${f1(r * q)}" fill="none" stroke="#fff" stroke-width="3.5" opacity=".8" pathLength="1" stroke-dasharray="1 1" stroke-dashoffset="1"/>`).join("")}<circle r="9" fill="#fff"/></g>`;
      // the windscreen is laminated: glass | film | glass — a hard hit only cracks it, the pieces stay on the film
      SinkUI.lami = (tl, layer, t0, dur, o = {}) => {
        const id = `sa${suSeq++}`;
        suBg(layer);
        put(layer, suCard(id, 540, 300, 960, 1120, "กระจกหน้า = ลามิเนต") + `
          <g transform="translate(-110,440)"><path d="M-330,140L-260,-150H260L330,140Z" fill="#9fd0f0" ${SO(5)}/><path d="M-250,-130L-220,-40" stroke="#fff" stroke-width="10" opacity=".6"/>${suCrack(id, -20, 10, 150)}</g>
          <g transform="translate(310,300)"><circle r="140" fill="#fff" ${SO(4)}/><g clip-path="circle(144px at 0 0)">
            <rect x="-150" y="-150" width="92" height="300" fill="#9fd0f0"/><rect x="-58" y="-150" width="36" height="300" fill="#ffd36a"/><rect x="-22" y="-150" width="92" height="300" fill="#9fd0f0"/>
            <path d="M-150,-150V150M-58,-150V150M-22,-150V150M70,-150V150" stroke="${SU.ink}" stroke-width="4"/></g><circle r="150" fill="none" ${SO(5)}/></g>
          <path d="M230,420L110,530" stroke="${SU.ink}" stroke-width="4" stroke-dasharray="10 8"/>
          <g id="${id}-lb"><rect x="190" y="520" width="280" height="64" rx="32" fill="${SU.yellow}" ${SO(4)}/><text x="330" y="564" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="38" fill="${SU.ink}">ฟิล์มกั้นกลาง</text></g>
          <g transform="translate(-60,880)"><g id="${id}-st"><rect x="-210" y="-58" width="420" height="116" rx="58" fill="${SU.red}" ${SO(5)}/><text y="20" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="58" fill="#fff">แค่ร้าว</text></g></g>
          <g id="${id}-fist" transform="translate(-60,200)"><g id="${id}-fi">${handAt([0, 0], 180, 1.4, SK.ton, { curl: [1, 1, 1, 1], thumb: 1, band: BAND, sw: 0.6, fore: 500 })}</g></g></g></g>`);
        suIn(tl, id, t0, dur);
        tl.fromTo(`#${id}-fi`, { y: -400 }, { y: 0, duration: 0.3, ease: "power3.in", immediateRender: false }, t0 + 0.5);
        tl.to(`#${id}-fi`, { y: -120, duration: 0.35, ease: "power2.out" }, t0 + 0.8);
        tl.to(`#${id}-fi`, { y: 0, duration: 0.22, ease: "power3.in" }, t0 + 1.25);
        tl.to(`#${id}-fi`, { y: -1100, duration: 0.6, ease: "power2.inOut" }, t0 + 1.5);
        tl.fromTo(`.${id}-ck`, { attr: { "stroke-dashoffset": 1 } }, { attr: { "stroke-dashoffset": 0 }, duration: 0.35, stagger: 0.02, ease: "power2.out", immediateRender: false }, t0 + 0.8);
        tl.fromTo(`#${id}-lb`, { scale: 0, svgOrigin: "330 552" }, { scale: 1, svgOrigin: "330 552", duration: 0.45, ease: "back.out(2.6)", immediateRender: false }, t0 + 1.6);
        tl.fromTo(`#${id}-st`, { scale: 2, opacity: 0, svgOrigin: "0 0" }, { scale: 1, opacity: 1, svgOrigin: "0 0", duration: 0.3, ease: "power4.in", immediateRender: false }, t0 + (o.stamp ?? 2.6));
      };
      // the side window is (mostly) tempered: one sharp hit at the corner and the whole pane drops as small cubes
      SinkUI.tempered = (tl, layer, t0, dur, o = {}) => {
        const id = `sb${suSeq++}`;
        suBg(layer);
        let cubes = "";
        for (let k = 0; k < 70; k++) { const x = -250 + ((k * 53) % 500), y = -190 + ((k * 97) % 330), r = (k * 37) % 360;
          cubes += `<rect class="${id}-cu" x="${x}" y="${y}" width="${16 + (k % 3) * 6}" height="${14 + (k % 4) * 5}" rx="3" fill="#bfe4fa" stroke="#5a8ab0" stroke-width="2" transform="rotate(${r} ${x} ${y})" opacity="0"/>`; }
        put(layer, suCard(id, 540, 300, 960, 1120, "กระจกข้าง = เทมเปอร์", SU.green) + `
          <g transform="translate(0,520)"><path id="${id}-pane" d="M-280,-200L-150,-220H240L290,170H-280Z" fill="#9fd0f0" ${SO(5)}/><path d="M-250,-170L-200,-60" stroke="#fff" stroke-width="10" opacity=".6"/>
            <path d="M-300,-230H310V200H-300Z" fill="none" stroke="#4a5060" stroke-width="18"/>${cubes}
            <g transform="translate(250,140)"><g id="${id}-hit" opacity="0"><circle r="60" fill="#fff" opacity=".8"/><path d="M-40,-40L40,40M40,-40L-40,40" stroke="#ffd36a" stroke-width="10"/></g></g></g>
          <g transform="translate(0,940)"><g id="${id}-st"><rect x="-330" y="-58" width="660" height="116" rx="58" fill="${SU.green}" ${SO(5)}/><text y="20" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="52" fill="#fff">แตกทั้งบาน ในครั้งเดียว</text></g></g></g></g>`);
        suIn(tl, id, t0, dur);
        const hitT = t0 + (o.hit ?? 1.3);
        tl.fromTo(`#${id}-hit`, { opacity: 0, scale: 0.3, svgOrigin: "0 0" }, { opacity: 1, scale: 1.2, svgOrigin: "0 0", duration: 0.12, immediateRender: false }, hitT);
        tl.to(`#${id}-hit`, { opacity: 0, duration: 0.25 }, hitT + 0.15);
        tl.set(`#${id}-pane`, { opacity: 0 }, hitT + 0.05);
        tl.set(`.${id}-cu`, { opacity: 1 }, hitT + 0.05);
        document.querySelectorAll(`.${id}-cu`).forEach((el, k) => tl.fromTo(el, { y: 0, x: 0 }, { y: 520 + (k % 5) * 60, x: ((k % 7) - 3) * 30, duration: 0.8 + (k % 4) * 0.12, ease: "power2.in", immediateRender: false }, hitT + 0.05 + (k % 9) * 0.015));
        tl.fromTo(`#${id}-st`, { scale: 0.3, opacity: 0, svgOrigin: "0 0" }, { scale: 1, opacity: 1, svgOrigin: "0 0", duration: 0.4, ease: "back.out(2.6)", immediateRender: false }, hitT + 0.5);
      };
      // where to hit it: the lower front corner of the side window, with something hard and pointed
      SinkUI.corner = (tl, layer, t0, dur, o = {}) => {
        const id = `sk${suSeq++}`;
        suBg(layer);
        put(layer, suCard(id, 540, 300, 960, 1120, "ทุบตรงไหน?", SU.blue) + `
          <g transform="translate(0,560)"><path d="M-300,-230H310V200H-300Z" fill="#4a5060" ${SO(5)}/><path d="M-280,-200L-150,-220H240L290,170H-280Z" fill="#9fd0f0" ${SO(4)}/><path d="M-250,-170L-200,-60" stroke="#fff" stroke-width="10" opacity=".6"/>
            <text x="-200" y="-250" font-family="Kanit" font-weight="700" font-size="32" fill="${SU.muted}">ท้ายรถ</text><text x="200" y="-250" text-anchor="end" font-family="Kanit" font-weight="700" font-size="32" fill="${SU.muted}">หน้ารถ ▶</text>
            <g transform="translate(240,130)"><g id="${id}-tg">${[60, 40, 20].map((r, k) => `<circle r="${r}" fill="${k % 2 ? "#fff" : SU.red}" ${SO(3)}/>`).join("")}</g></g>
            ${suCrack(id, 240, 130, 170, 9)}
            <g transform="translate(240,130)"><g id="${id}-tool"><g transform="rotate(-40)"><rect x="-22" y="-300" width="44" height="220" rx="12" fill="#e8402a" ${SO(4)}/><path d="M-30,-80H30L10,-20H-10Z" fill="#c8ccd4" ${SO(4)}/><path d="M0,-20V0" stroke="${SU.ink}" stroke-width="8"/></g></g></g></g>
          <g transform="translate(0,960)"><g id="${id}-st"><rect x="-330" y="-58" width="660" height="116" rx="58" fill="${SU.blue}" ${SO(5)}/><text y="20" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="52" fill="#fff">มุมล่าง ด้านหน้า</text></g></g></g></g>`);
        suIn(tl, id, t0, dur);
        tl.fromTo(`#${id}-tg`, { scale: 0, svgOrigin: "0 0" }, { scale: 1, svgOrigin: "0 0", duration: 0.45, ease: "back.out(3)", immediateRender: false }, t0 + 0.4);
        tl.to(`#${id}-tg`, { scale: 1.15, svgOrigin: "0 0", duration: 0.35, yoyo: true, repeat: 3, ease: "sine.inOut" }, t0 + 0.85);
        tl.fromTo(`#${id}-tool`, { x: 260, y: -260, opacity: 0 }, { x: 0, y: 0, opacity: 1, duration: 0.5, ease: "power3.in", immediateRender: false }, t0 + (o.hit ?? 2.0) - 0.5);
        tl.to(`#${id}-tool`, { x: 30, y: -30, duration: 0.3, ease: "power2.out" }, t0 + (o.hit ?? 2.0) + 0.05);
        tl.fromTo(`.${id}-ck`, { attr: { "stroke-dashoffset": 1 } }, { attr: { "stroke-dashoffset": 0 }, duration: 0.3, stagger: 0.02, immediateRender: false }, t0 + (o.hit ?? 2.0));
        tl.fromTo(`#${id}-st`, { scale: 0.3, opacity: 0, svgOrigin: "0 0" }, { scale: 1, opacity: 1, svgOrigin: "0 0", duration: 0.4, ease: "back.out(2.6)", immediateRender: false }, t0 + (o.label ?? 1.0));
      };
      // many models: the side windows are laminated too (a film between the glass) — three cars, two light up with the film
      SinkUI.models = (tl, layer, t0, dur, o = {}) => {
        const id = `sd${suSeq++}`;
        suBg(layer);
        const car = (k, y, film) => `<g transform="translate(0,${y})"><g transform="scale(.8)">${SinkUI.car(["#e9edf2", "#d84a3a", "#3a6ad8"][k])}</g>
          ${film ? `<g id="${id}-f${k}" opacity="0"><path d="M-104,-148L-60,-96H32V-156Q-30,-160 -104,-148Z M48,-156V-96H160L120,-140Q96,-156 48,-156Z" fill="#ffd36a" opacity=".8"/>
            <g transform="translate(250,-150)"><rect x="-70" y="-30" width="140" height="60" rx="30" fill="${SU.yellow}" ${SO(3.5)}/><text y="12" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="32" fill="${SU.ink}">ฟิล์ม</text></g></g>` : ""}</g>`;
        put(layer, suCard(id, 540, 300, 960, 1150, "รถหลายรุ่น · กระจกข้าง") + `<g transform="translate(0,0)">${car(0, 420, false)}${car(1, 720, true)}${car(2, 1020, true)}</g></g></g>`);
        suIn(tl, id, t0, dur);
        [1, 2].forEach((k, j) => tl.fromTo(`#${id}-f${k}`, { opacity: 0 }, { opacity: 1, duration: 0.3, ease: "power2.out", immediateRender: false }, t0 + (o.at ?? 1.6) + j * 0.35));
      };
      // it won't break: move to the next window, now — car side-on, a hit that bounces, an arrow to the next pane, that one goes
      SinkUI.switchWin = (tl, layer, t0, dur, o = {}) => {
        const id = `sw${suSeq++}`;
        suBg(layer);
        put(layer, suCard(id, 540, 420, 980, 900, "ทุบไม่แตก → เปลี่ยนบาน", SU.blue) + `<g transform="translate(0,520)"><g transform="scale(1.35)">${SinkUI.car()}</g>
          <g transform="translate(90,-215)"><g id="${id}-x" opacity="0"><circle r="40" fill="${SU.red}" ${SO(4)}/><path d="M-16,-16L16,16M16,-16L-16,16" stroke="#fff" stroke-width="10" stroke-linecap="round"/></g></g>
          <path id="${id}-ar" d="M60,-280Q-20,-360 -100,-280" stroke="${SU.green}" stroke-width="14" fill="none" stroke-linecap="round" pathLength="1" stroke-dasharray="1 1" stroke-dashoffset="1"/>
          <path id="${id}-ah" d="M-100,-280l-6,-34M-100,-280l32,-14" stroke="${SU.green}" stroke-width="14" stroke-linecap="round" opacity="0"/>
          <g transform="translate(-60,-215)"><g id="${id}-ok" opacity="0"><circle r="40" fill="${SU.green}" ${SO(4)}/><path d="M-16,0l10,12l20,-22" stroke="#fff" stroke-width="9" fill="none" stroke-linecap="round" stroke-linejoin="round"/></g></g></g></g></g>`);
        suIn(tl, id, t0, dur);
        tl.fromTo(`#${id}-x`, { opacity: 0, scale: 0.3, svgOrigin: "0 0" }, { opacity: 1, scale: 1, svgOrigin: "0 0", duration: 0.35, ease: "back.out(3)", immediateRender: false }, t0 + 0.35);
        tl.fromTo(`#${id}-ar`, { attr: { "stroke-dashoffset": 1 } }, { attr: { "stroke-dashoffset": 0 }, duration: 0.45, ease: "power2.out", immediateRender: false }, t0 + 0.9);
        tl.set(`#${id}-ah`, { opacity: 1 }, t0 + 1.3);
        tl.fromTo(`#${id}-ok`, { opacity: 0, scale: 0.3, svgOrigin: "0 0" }, { opacity: 1, scale: 1, svgOrigin: "0 0", duration: 0.35, ease: "back.out(3)", immediateRender: false }, t0 + 1.55);
      };
      // the car in cross-section: the canal outside, the water inside rising; big arrows on the door while it's low;
      // only when it's nearly full do the arrows even out and the door can open. o.mode "last" (EP.2: the last resort) | "open" (EP.3: it opens)
      SinkUI.equalize = (tl, layer, t0, dur, o = {}) => {
        const id = `se${suSeq++}`, last = o.mode !== "open";
        put(layer, `<g id="${id}"><rect width="1080" height="1920" fill="#14425e"/><rect width="1080" height="1920" fill="url(#${id}-g)"/>
          <linearGradient id="${id}-g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a8ab8"/><stop offset="1" stop-color="#0a2236"/></linearGradient>
          <g transform="translate(540,960)"><g filter="url(#muDrop)"><path d="M-380,-260Q-380,-300 -340,-300H340Q380,-300 380,-260V300H-380Z" fill="#dfe4ea" ${SO(6)}/></g>
            <rect x="-350" y="-270" width="700" height="540" fill="#f4f0e6"/><clipPath id="${id}-cp"><rect x="-350" y="-270" width="700" height="540"/></clipPath>
            <g clip-path="url(#${id}-cp)"><rect id="${id}-in" x="-350" y="170" width="700" height="600" fill="#5ab0e0" opacity=".85"/></g>
            <rect x="-350" y="-270" width="700" height="540" fill="none" ${SO(5)}/>
            <g transform="translate(380,0)"><g id="${id}-door"><rect x="-20" y="-270" width="24" height="540" fill="#9aa4ae" ${SO(4)}/></g></g>
            ${[-180, -60, 60, 180].map((y, k) => `<g transform="translate(430,${y})"><g id="${id}-a${k}"><path d="M150,-22H40V-50L-30,0L40,50V22H150Z" fill="#7ad0ff" ${SO(4)}/></g></g>`).join("")}
            <text x="0" y="-320" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="40" fill="#e8f4ff">ในรถ</text>
            <g transform="translate(0,-110)"><g id="${id}-air"><rect x="-120" y="-40" width="240" height="80" rx="40" fill="#fff" ${SO(3.5)}/><text y="14" text-anchor="middle" font-family="Kanit" font-weight="800" font-size="36" fill="${SU.ink}">อากาศ</text></g></g></g>
          <g transform="translate(540,300)"><g id="${id}-lb"><rect x="-310" y="-60" width="620" height="120" rx="60" fill="${last ? SU.red : SU.green}" ${SO(5)}/>
            <text y="20" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="54" fill="#fff">${last ? "ประตู = ทางสุดท้าย" : "แรงดันเท่ากัน → เปิดได้"}</text></g></g>
          ${Array.from({ length: 10 }, (_, k) => `<circle id="${id}-bb${k}" cx="${150 + (k * 97) % 800}" cy="1750" r="${6 + (k % 4) * 4}" fill="none" stroke="#e8f8ff" stroke-width="3" opacity=".7"/>`).join("")}</g>`);
        tl.fromTo(`#${id}`, { opacity: 0 }, { opacity: 1, duration: 0.25, immediateRender: false }, t0);
        const fillT = last ? dur * 0.75 : dur * 0.45;
        tl.fromTo(`#${id}-in`, { y: 0 }, { y: -400, duration: fillT, ease: "power1.in", immediateRender: false }, t0 + 0.2);
        tl.fromTo(`#${id}-air`, { y: 0, scale: 1, svgOrigin: "0 0" }, { y: -100, scale: 0.75, svgOrigin: "0 0", duration: fillT, ease: "power1.in", immediateRender: false }, t0 + 0.2);
        [0, 1, 2, 3].forEach((k) => { tl.fromTo(`#${id}-a${k}`, { scale: 1.25, svgOrigin: "0 0" }, { scale: 0.45, svgOrigin: "0 0", duration: fillT, ease: "power1.in", immediateRender: false }, t0 + 0.2);
          tl.to(`#${id}-a${k}`, { x: -14, duration: 0.4, yoyo: true, repeat: Math.ceil(dur / 0.4), ease: "sine.inOut" }, t0 + 0.3 + k * 0.05); });
        tl.to(`#${id}-door`, { rotation: last ? 18 : 55, svgOrigin: "0 -270", duration: 0.6, ease: "power2.out" }, t0 + 0.2 + fillT);
        tl.fromTo(`#${id}-lb`, { scale: 0.3, opacity: 0, svgOrigin: "0 0" }, { scale: 1, opacity: 1, svgOrigin: "0 0", duration: 0.45, ease: "back.out(2.6)", immediateRender: false }, t0 + (o.label ?? (last ? fillT * 0.6 : fillT)));
        for (let k = 0; k < 10; k++) tl.fromTo(`#${id}-bb${k}`, { y: 0 }, { y: -1600, duration: 3 + (k % 3), ease: "none", immediateRender: false }, t0 + k * 0.2);
      };
      // ---------- EP.3 cards ----------
      // the shadow screen (the house style's legend device): a backlit cloth; what would happen if you jumped in — black shapes
      SinkUI.shadow = (tl, layer, t0, dur, o = {}) => {
        const id = `sh${suSeq++}`, WL = 1020;
        const person = (pid, arms) => `<g id="${pid}"><circle cx="0" cy="-150" r="34" fill="#140c08"/><path d="M-30,-112Q0,-122 30,-112L36,0H-36Z" fill="#140c08"/>
          <path d="M-14,0L-24,110M14,0L22,110" stroke="#140c08" stroke-width="24" stroke-linecap="round"/>${arms}</g>`;
        put(layer, `<g id="${id}"><rect width="1080" height="1920" fill="#120a06"/>
          <radialGradient id="${id}-cl" cx=".5" cy=".45" r=".7"><stop offset="0" stop-color="#ffe2a8"/><stop offset=".6" stop-color="#e8a050"/><stop offset="1" stop-color="#8a4a1c"/></radialGradient>
          <rect x="40" y="240" width="1000" height="1300" fill="url(#${id}-cl)"/>
          <path d="M40,240${Array.from({ length: 20 }, (_, k) => `l25,${k % 2 ? -26 : 26}`).join("")}H1040" fill="none" stroke="#2a160a" stroke-width="10"/>
          <rect x="20" y="220" width="1040" height="1340" fill="none" stroke="#3a200e" stroke-width="40"/>
          <clipPath id="${id}-cp"><rect x="40" y="240" width="1000" height="1300"/></clipPath>
          <g clip-path="url(#${id}-cp)">
            <path d="M40,${WL - 60}L300,${WL - 60}L330,${WL + 400}H40Z" fill="#140c08"/>
            <g transform="translate(560,${WL + 60})"><g id="${id}-v">${person(`${id}-vp`, `<path d="M-26,-100L-70,-200M26,-100L70,-200" stroke="#140c08" stroke-width="20" stroke-linecap="round"/>`)}</g></g>
            <g transform="translate(220,${WL - 60})"><g id="${id}-r">${person(`${id}-rp`, `<path d="M-26,-100L-80,-150M26,-100L80,-150" stroke="#140c08" stroke-width="20" stroke-linecap="round"/>`)}</g></g>
            <path id="${id}-wv" d="M40,${WL}${Array.from({ length: 21 }, (_, k) => `q25,${k % 2 ? 22 : -22} 50,0`).join("")}V1560H40Z" fill="#140c08" opacity=".86"/>
            ${Array.from({ length: 12 }, (_, k) => `<circle id="${id}-b${k}" cx="${520 + (k * 23) % 120}" cy="${WL + 220}" r="${8 + (k % 3) * 5}" fill="none" stroke="#140c08" stroke-width="5" opacity="0"/>`).join("")}</g>
          <g transform="translate(540,1700)"><text text-anchor="middle" font-family="Kanit" font-weight="800" font-size="40" fill="#e8c890" opacity=".85">${o.label || ""}</text></g></g>`);
        tl.fromTo(`#${id}`, { opacity: 0 }, { opacity: 1, duration: 0.3, immediateRender: false }, t0);
        tl.fromTo(`#${id}-wv`, { x: -50 }, { x: 0, duration: 0.9, repeat: Math.ceil(dur / 0.9), ease: "none", immediateRender: false }, t0);
        tl.fromTo(`#${id}-v`, { y: 0, rotation: -6, svgOrigin: "0 0" }, { y: -16, rotation: 6, svgOrigin: "0 0", duration: 0.35, yoyo: true, repeat: 5, ease: "sine.inOut", immediateRender: false }, t0);
        // the jump: an arc off the bank into the water beside her
        tl.fromTo(`#${id}-r`, { x: 0, y: 0, rotation: 0, svgOrigin: "0 0" }, { x: 160, y: -170, rotation: 30, svgOrigin: "0 0", duration: 0.35, ease: "power2.out", immediateRender: false }, t0 + 0.5);
        tl.to(`#${id}-r`, { x: 270, y: 150, rotation: 70, svgOrigin: "0 0", duration: 0.4, ease: "power2.in" }, t0 + 0.85);
        tl.to(`#${id}-r`, { x: 300, y: 120, rotation: 0, svgOrigin: "0 0", duration: 0.35, ease: "power2.out" }, t0 + 1.25);
        // she climbs onto him: her arms round his head, both go down
        tl.to(`#${id}-v`, { x: -40, y: -60, rotation: -15, svgOrigin: "0 0", duration: 0.35, ease: "power3.out" }, t0 + 1.7);
        tl.to([`#${id}-v`, `#${id}-r`], { y: "+=460", duration: dur - 2.2, ease: "power1.in" }, t0 + 2.1);
        tl.to(`#${id}-r`, { rotation: -10, svgOrigin: "0 0", duration: 0.25, yoyo: true, repeat: Math.ceil((dur - 2) / 0.25), ease: "sine.inOut" }, t0 + 1.9);
        for (let k = 0; k < 12; k++) tl.fromTo(`#${id}-b${k}`, { y: 0, opacity: 0.9 }, { y: -300, opacity: 0, duration: 0.9, ease: "power1.out", immediateRender: false }, t0 + 2.2 + (k % 6) * 0.25);
      };
      // three words that help without going in: ตะโกน · โยน · ยื่น (tiles with the drawn icons, the active one lifted)
      SinkUI.three = (tl, layer, t0, dur, o = {}) => {
        const id = `s3${suSeq++}`, W = ["ตะโกน", "โยน", "ยื่น"], IC = ["shout", "throw", "reach"], col = [SU.red, SU.blue, SU.green];
        const tile = (k, x) => `<g transform="translate(${x},${o.y ?? 860})"><g id="${id}-t${k}"><g filter="url(#muDrop)"><rect x="-150" y="-190" width="300" height="380" rx="34" fill="${SU.paper}" ${SO(5)}/></g>
          <rect x="-150" y="-190" width="300" height="80" rx="34" fill="${col[k]}" ${SO(5)}/><rect x="-150" y="-140" width="300" height="30" fill="${col[k]}"/>
          <text y="-134" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="46" fill="#fff">${k + 1}</text>
          <g transform="translate(-102,-90) scale(1.7)">${(window.GameUI && GameUI.ILL[IC[k]]) || ""}</g>
          <text y="160" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="64" fill="${SU.ink}">${W[k]}</text></g></g>`;
        put(layer, `<g id="${id}"><g transform="translate(540,${(o.y ?? 860) - 330})"><g id="${id}-hd"><rect x="-340" y="-56" width="680" height="112" rx="56" fill="${SU.paper}" ${SO(5)}/>
          <text y="20" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="52" fill="${SU.ink}">ช่วย<tspan fill="${SU.red}">จากบนฝั่ง</tspan> · ไม่ต้องลงน้ำ</text></g></g>${tile(0, 200)}${tile(1, 540)}${tile(2, 880)}</g>`);
        tl.fromTo(`#${id}-hd`, { scale: 0.4, opacity: 0, svgOrigin: "0 0" }, { scale: 1, opacity: 1, svgOrigin: "0 0", duration: 0.45, ease: "back.out(2.4)", immediateRender: false }, t0);
        [0, 1, 2].forEach((k) => tl.fromTo(`#${id}-t${k}`, { y: 300, opacity: 0, rotation: (k - 1) * 8, svgOrigin: "0 0" }, { y: 0, opacity: 1, rotation: 0, svgOrigin: "0 0", duration: 0.55, ease: "back.out(1.8)", immediateRender: false }, t0 + 0.3 + k * 0.18));
        (o.lift || []).forEach(([k, at]) => { tl.to(`#${id}-t${k}`, { y: -30, scale: 1.08, svgOrigin: "0 0", duration: 0.3, ease: "back.out(2)" }, t0 + at); tl.to(`#${id}-t${k}`, { y: 0, scale: 1, svgOrigin: "0 0", duration: 0.3 }, t0 + at + 0.7); });
        tl.to(`#${id}`, { opacity: 0, duration: 0.2 }, t0 + dur - 0.2);
      };
      // the end of the series: the card from the mirror with all four ticked, the three words from the bank, share it
      SinkUI.finale = (tl, layer, t0, dur, o = {}) => {
        put(layer, `<rect width="1080" height="1920" fill="#0a0c18" opacity=".55"/>`);
        SinkUI.rules(tl, layer, t0, dur, { active: -1, done: [0, 1, 2, 3], y: 300, s: 0.86, stagger: 0.1, out: false });
        const id = `sf${suSeq++}`;
        put(layer, `<g transform="translate(540,1130)"><g id="${id}"><g filter="url(#muDrop)"><rect x="-430" y="-90" width="860" height="250" rx="34" fill="${SU.paper}" ${SO(5)}/></g>
          <text y="-24" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="46" fill="${SU.ink}">บนฝั่ง: <tspan fill="${SU.red}">ตะโกน</tspan> · <tspan fill="${SU.blue}">โยน</tspan> · <tspan fill="${SU.green}">ยื่น</tspan></text>
          ${["shout", "throw", "reach"].map((k, j) => `<g transform="translate(${-260 + j * 260},20) scale(1)">${(window.GameUI && GameUI.ILL[k]) || ""}</g>`).join("")}</g></g>
          <g transform="translate(540,1460)"><g id="${id}-cta"><rect x="-420" y="-52" width="840" height="104" rx="52" fill="${SU.red}" ${SO(5)}/>
          <text y="18" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="44" fill="#fff">แชร์ให้คนที่คุณรัก… ก่อนวันที่ต้องใช้</text></g></g>
          <text x="540" y="1640" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="42" fill="#fff" letter-spacing="10">ROD MAI CLUB</text>
          <text x="540" y="1690" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="30" fill="#c8d0d8">นาทีก่อนจม · จบ</text>`);
        tl.fromTo(`#${id}`, { y: 200, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "back.out(1.8)", immediateRender: false }, t0 + 1.2);
        tl.fromTo(`#${id}-cta`, { scale: 0.3, opacity: 0, svgOrigin: "0 0" }, { scale: 1, opacity: 1, svgOrigin: "0 0", duration: 0.45, ease: "back.out(2.6)", immediateRender: false }, t0 + 1.8);
        tl.to(`#${id}-cta`, { scale: 1.05, svgOrigin: "0 0", duration: 0.5, yoyo: true, repeat: Math.ceil(dur / 0.5), ease: "sine.inOut" }, t0 + 2.4);
      };
