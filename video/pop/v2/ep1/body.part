          PopUI.timeline(tl, L.light, t0 + vo("fine", 1), D("fine") - vo("fine", 1), { y: 520 });
          PopUI.source(tl, L.light, t0 + vo("fine", 1) + 0.3, D("fine") - vo("fine", 1) - 0.3, { text: "ที่มา: กรมควบคุมโรค (3 เม.ย. 2568)", y: 1380 });
        },
      });

      // ---------- 25. 2 a.m. on the same clock, moonlit ----------
      add("two", {
        set: "clock2", setOpts: { id: "ck25", night: true, hh: 60, mm: 0 }, dark: 0.2, blur: { far: 6 }, grade: GNIGHT,
        cam: { keys: [{ t: 0, ...fr(540, 860, 1.12, 540, 880) }, { t: D("two"), ...fr(540, 860, 1.2, 540, 880) }] },
        captions: caps("two"),
        fx(tl, id, t0) { tl.fromTo("#ck25-ss", { attr: { transform: "rotate(0)" } }, { attr: { transform: "rotate(12)" }, duration: D("two"), ease: "steps(2)", immediateRender: false }, t0); Fx.heart(tl, t0, D("two"), 0.5, 0.5); },
      });

      // ---------- 26. upstairs under the net: มิ้นท์ sits up; chewing sounds come up through the floor ----------
      add("sound", {
        set: "bedroom2", setOpts: { id: "b26", phone: true }, dark: 0.2, blur: { sky: 6, mid: 3, fg: 10 }, light: MOON, grade: GNIGHT,
        cam: { keys: [{ t: 0, ...fr(560, GB + 60 - 400 * 2.0, 1.0, 540, 900) }, { t: D("sound"), ...fr(560, GB + 60 - 400 * 2.0, 1.08, 540, 900) }] },
        actors: [MINT(560, GB + 60, 2.0, [{ t: 0, mode: "sit", eyes: "closed", mouth: "flat" }, { t: 0.4, mode: "sit", eyes: "wide", mouth: "o" }, { t: voEnd("sound") + 0.1, mode: "sit", eyes: "side", mouth: "flat" }])],
        captions: caps("sound", undefined, { quote: true }),
        fx(tl, id, t0, L) {
          PopUI.sfx(tl, L.light, t0 + 0.25, 1.2, "กร้วม…", 260, 1760, { size: 84, rot: -8 }); PopUI.sfx(tl, L.light, t0 + 1.2, 1.3, "กร้วม…", 800, 1850, { size: 100, rot: 6 });
          Fx.heart(tl, t0 + 0.4, D("sound") - 0.4, 0.42, 0.55);
        },
      });

      // ---------- 27. top-down through the gap in the floorboards: dark, embers — two green eyes look up. One hit, cut ----------
      const PB = 1.2, PC = 3.0, PD = 3.4;
      add("peek", {
        set: "gap2", setOpts: { id: "gp27" }, dark: 0.08, blur: { mid: 2 }, grade: GLATE,
        cam: { keys: [{ t: 0, ...fr(560, 960, 1.0, 540, 960) }, { t: PB, glide: 1.6, ...fr(560, 980, 1.35, 540, 960) }] },
        extra(L) { put(L.light, `<g id="pk-face" opacity="0">${Pop2.pobFace(540, 1000, 1.25, { id: "pk-f" })}</g>`); },
        fx(tl, id, t0) {
          tl.set("#gp27-pob-eyes", { opacity: 0 }, t0);
          tl.to("#gp27-pob-eyes", { opacity: 1, duration: 0.5, ease: "power1.in" }, t0 + PB);
          tl.to("#gp27-pob-eyes", { x: "+=8", duration: 0.6, yoyo: true, repeat: 1, ease: "sine.inOut" }, t0 + PB + 0.8);
          Fx.heart(tl, t0 + 0.3, PC - 0.3, 0.6, 0.65);
          tl.to("#gp27-pob-eyes", { opacity: 0, duration: 0.08 }, t0 + PC);
          tl.fromTo("#pk-face", { opacity: 0, scale: 1.25, svgOrigin: "540 1000" }, { opacity: 1, scale: 1, duration: 0.09, ease: "power4.out", immediateRender: false }, t0 + PD);
          Fx.glitch(tl, `#${id}`, t0 + PD + 0.05, 0.18, 16, 927);
          tl.set("#black", { opacity: 1 }, t0 + PD + 0.22);
        },
