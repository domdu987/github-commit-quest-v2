      // ---------- 28. morning: in the dirt by the pot, bare prints with toes far too long — and the trail, out across the yard to ลุงทองดี's ----------
      split("clue", vo("clue", 1) - 0.1, {
        set: "printsTop", setOpts: { id: "c28" }, dark: 0, light: false, grade: { top: "#ffe8b8", bottom: "#4a3a5a", op: 0.25 },
        cam: { keys: [{ t: 0, ...fr(540, 760, 1.0, 540, 960) }, { t: vo("clue", 1) - 0.1, ...fr(640, 1300, 1.0, 540, 960) }] },
        captions: caps("clue").filter((c) => c.t < vo("clue", 1) - 0.1),
        fx(tl, id, t0) {
          tl.set("#black", { opacity: 0 }, t0);
          for (let i = 0; i < 8; i++) tl.fromTo(`#c28-p${i}`, { opacity: 0 }, { opacity: 1, duration: 0.25, immediateRender: false }, t0 + 0.3 + i * 0.32);
          Fx.heart(tl, t0, vo("clue", 1), 0.45, 0.55);
        },
