        set: "kok2", setOpts: { id: "c28b", mound: false, house: [940, 0.6], fence: [560, 10, GF + 100], trunks: [[-200, 120], [1300, 110]], fgTrunk: false }, dark: 0, blur: { far: 3, mid: 2, fg: 10 }, light: SUN,
        grade: { top: "#ffe8b8", bottom: "#4a3a5a", op: 0.3 },
        cam: { keys: [{ t: 0, ...fr(480, 1420, 1.0, 540, 1250) }, { t: D("clue") - vo("clue", 1) + 0.1, glide: D("clue") - vo("clue", 1) - 0.3, ...fr(640, 1120, 0.96, 540, 1020) }] },
        actors: [MINT(250, GF + 600, 1.05, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }], { flip: false }), TON(120, GF + 650, 0.88, [{ t: 0, mode: "idle", eyes: "side", mouth: "flat" }])],
        captions: capsFrom("clue", vo("clue", 1) - 0.1),
        extra(L) { put(L.set, Pop2.trail(380, 2120, 830, 1450, 7, 0.95, 0.26, { toe: 1.9 })); },
        fx(tl, id, t0) { Fx.heart(tl, t0, D("clue") - vo("clue", 1), 0.45, 0.55); },
      });

      // ---------- 29. under the net at first light: ต้น curled up, holding his stomach; มิ้นท์ beside him ----------
      add("pain", {
        set: "bedroom2", setOpts: { id: "b29" }, dark: 0.12, blur: { sky: 4, mid: 2, fg: 10 }, light: MOON, grade: { top: "#5a6a9a", bottom: "#2a1a3a", op: 0.3 },
        cam: { keys: [{ t: 0, ...fr(560, GB - 160, 1.25, 540, 1050) }, { t: D("pain"), ...fr(560, GB - 160, 1.35, 540, 1050) }] },
        actors: [MINT(430, GB - 40, 0.95, [{ t: 0, mode: "idle", eyes: "worry", mouth: "o" }], { flip: true }), TON(820, GB + 80, 1.05, [{ t: 0, mode: "lie", eyes: "closed", mouth: "frown" }])],
        captions: caps("pain", undefined, { quote: true }),
        fx(tl, id, t0) { Fx.heart(tl, t0, D("pain"), 0.4, 0.6); },
      });

      // ---------- 30. the choice: hospital now / wait for morning — the "wait" side gets taken over ----------
      add("choice", {
        set: "bedroom2", setOpts: { id: "b30" }, dark: 0.35, blur: { sky: 6, mid: 6, set: 6, act: 4, fg: 10 }, light: MOON, grade: GNIGHT,
        cam: { keys: [{ t: 0, ...fr(560, GB - 160, 1.35, 540, 1150) }] },
        actors: [TON(820, GB + 80, 1.05, [{ t: 0, mode: "lie", eyes: "closed", mouth: "frown" }])],
        fx(tl, id, t0, L) {
          PopUI.choice(tl, L.light, t0 + 0.05, D("choice") - 0.05, { q: "จะทำยังไง?", a: "พาไปโรงพยาบาล", b: "รอเช้าค่อยไป", secs: 3, y: 780,
            possessed: { at: 1.0, side: "b", glitch: "รอเช้า…", who: "…นอนเถอะ เดี๋ยวก็หาย" } });
          Fx.heart(tl, t0, D("choice"), 0.38, 0.85); Fx.tunnel(tl, t0, t0 + D("choice") + 0.5, 0.75);
          Fx.glitch(tl, `#${id}`, t0 + 1.0, 0.3, 12, 930); Fx.glitch(tl, `#${id}`, t0 + D("choice") - 0.6, 0.4, 18, 931);
          tl.set("#black", { opacity: 1 }, t0 + D("choice") - 0.2);
        },
      });

      // ---------- 31. end card: the community-forest sign, a note from ยายคำ pinned under it ----------
      add("next", {
        set: "sign2", setOpts: { id: "sg", ep: "ตอนที่ 2", title: "เอาเห็ดไปหาหมอ" }, dark: 0, blur: { far: 6, mid: 5, fg: 10 }, grade: GDAY,
        cam: { keys: [{ t: 0, ...fr(540, 880, 1.0, 540, 900) }, { t: D("next"), ...fr(540, 880, 1.05, 540, 900) }] },
        fx(tl, id, t0, L) {
          tl.set("#black", { opacity: 0 }, t0 + 0.3);
          tl.fromTo("#sg-sign", { rotation: -9, svgOrigin: "540 500" }, { rotation: 0, duration: 1.6, ease: "elastic.out(1,0.4)", immediateRender: false }, t0 + 0.3);
          tl.fromTo("#sg-note", { y: 60, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "back.out(2)", immediateRender: false }, t0 + 0.6);
          dust(L, t0, D("next"), 8, 24)(tl);
        },
      });

      shots.forEach((sh) => { const f = sh.fx; sh.fx = (tl, id, t0, L) => { if (f) f(tl, id, t0, L); Pop.life(tl, `#${id}`, t0, sh.dur); }; });
