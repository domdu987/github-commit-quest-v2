      // ======================================================================================================
      // เอาชีวิตรอด 99 วัน · EP.3 "คนแปลกหน้า"
      // ======================================================================================================
      const put = (el, html) => el.insertAdjacentHTML("beforeend", html);
      const SKIN_PIM = { skin: "#ecc29c", sleeve: "#9fc5d8" }, SKIN_PHU = { skin: "#d39a6e", sleeve: "#6b7a5a" };
      const CDC = "ที่มา: <em>CDC (สหรัฐฯ)</em> · ", NHS = "ที่มา: <em>NHS (สหราชอาณาจักร)</em> · ", MLP = "ที่มา: <em>MedlinePlus (สหรัฐฯ)</em> · ";
      const HA = (who, x, y, s, track, extra = {}) => ({ who, x, y, s, blinks: [], track, ...extra });
      const ZF = (L, tl, pre, t0, dur, list, mode = "lunge") => list.forEach(([w, x, s, ph], k) => behind(L, tl, `${pre}-z${k}`, w, x, 1180, s, true, t0, dur, [{ t: 0, mode, eyes: "dead", mouth: "snarl", opts: { period: 1.2 + ph } }]));
      // story icons: the kitchen knife (the last weapon), the bandage
      PK_ICON.knife = (p) => `${PKG(p)}${SHADOW(24, 45, 16)}<g class="a-wob" style="transform-origin:24px 24px"><path d="M8,40l10,-10" stroke="#3a2e22" stroke-width="7" stroke-linecap="round"/><path d="M16,32L36,8q6,-2 6,6L24,38z" fill="#dfe6e2" stroke="${PK_INK}" stroke-width="2" stroke-linejoin="round"/><path d="M20,32L36,12" stroke="#fff" stroke-width="2"/></g>`;
      PK_ICON.wound = (p) => `${PKG(p)}${SHADOW(24, 45, 14)}<rect x="6" y="14" width="36" height="22" rx="6" fill="#f4ecd8" stroke="${PK_INK}" stroke-width="2"/><path d="M12,18h24M12,32h24" stroke="#d9d0bc" stroke-width="2"/><circle class="a-pulse" cx="24" cy="25" r="6" fill="#c8392b"/>`;
      // the checklist glyphs for the search (viewBox 0 0 120 120): an arm, a neck, a back, a leg with the gash; and the four signs of infection
      const CHK = {
        arm: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<path d="M20,80q20,-50 60,-50q20,0 24,20" stroke="#d39a6e" stroke-width="30" fill="none" stroke-linecap="round"/><path d="M20,80q20,-50 60,-50q20,0 24,20" stroke="${PK_INK}" stroke-width="3" fill="none" stroke-linecap="round" stroke-dasharray="0 0" opacity=".0"/><circle cx="100" cy="56" r="16" fill="#d39a6e" stroke="${PK_INK}" stroke-width="3"/>`,
        neck: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<circle cx="60" cy="40" r="26" fill="#d39a6e" stroke="${PK_INK}" stroke-width="3"/><path d="M46,62v18h28V62" fill="#d39a6e" stroke="${PK_INK}" stroke-width="3"/><path d="M24,100q36,-30 72,0" fill="#6b7a5a" stroke="${PK_INK}" stroke-width="3"/>`,
        back: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<circle cx="60" cy="30" r="18" fill="#2b2522" stroke="${PK_INK}" stroke-width="3"/><path d="M30,100V62q0,-14 14,-14h32q14,0 14,14v38z" fill="#d39a6e" stroke="${PK_INK}" stroke-width="3"/><path d="M60,52v44" stroke="#b27c52" stroke-width="3"/>`,
        leg: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<path d="M44,16h32v70H44z" fill="#2f3438" stroke="${PK_INK}" stroke-width="3"/><path d="M48,54h24v22H48z" fill="#d39a6e"/><path d="M52,58l16,14" stroke="#8f1b1b" stroke-width="7" stroke-linecap="round"/><path d="M40,86h40v16H40z" fill="#1e1e1e" stroke="${PK_INK}" stroke-width="3"/>`,
        red: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<rect x="24" y="30" width="72" height="60" rx="10" fill="#d39a6e" stroke="${PK_INK}" stroke-width="3"/><circle class="a-pulse" cx="60" cy="60" r="22" fill="#e0564a" opacity=".85"/><path d="M50,60h20" stroke="#8f1b1b" stroke-width="6" stroke-linecap="round"/>`,
        pain: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<rect x="24" y="30" width="72" height="60" rx="10" fill="#d39a6e" stroke="${PK_INK}" stroke-width="3"/><path d="M50,60h20" stroke="#8f1b1b" stroke-width="6" stroke-linecap="round"/><g class="a-pulse" style="transform-origin:60px 60px"><path d="M60,20l-10,22h20l-12,24" stroke="#f2c55c" stroke-width="6" fill="none" stroke-linejoin="round"/><path d="M26,46l-10,-8M94,46l10,-8" stroke="#f2c55c" stroke-width="5" stroke-linecap="round"/></g>`,
        pus: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<rect x="24" y="30" width="72" height="60" rx="10" fill="#d39a6e" stroke="${PK_INK}" stroke-width="3"/><path d="M50,60h20" stroke="#8f1b1b" stroke-width="6" stroke-linecap="round"/><path class="a-bob" d="M60,66q14,18 0,30q-14,-12 0,-30z" fill="#c9c93a" stroke="${PK_INK}" stroke-width="2"/>`,
        fever: (p) => `${PKG(p)}${SHADOW(60, 104, 34)}<rect x="48" y="14" width="24" height="70" rx="12" fill="#fff" stroke="${PK_INK}" stroke-width="3"/><circle cx="60" cy="92" r="16" fill="#e0564a" stroke="${PK_INK}" stroke-width="3"/><rect class="a-pulse" x="56" y="40" width="8" height="44" fill="#e0564a"/><path d="M76,30h8M76,44h8M76,58h8" stroke="${PK_INK}" stroke-width="2"/>`,
      };
      Object.assign(GameUI.ILL, {
        wash: `${PKG("ws")}${SHADOW(60, 108, 34)}<path d="M30,26h40q14,0 14,14v10" stroke="#8d9299" stroke-width="12" fill="none" stroke-linecap="round"/><rect x="18" y="14" width="24" height="18" rx="4" fill="#5b6066" stroke="${PK_INK}" stroke-width="2.5"/><g class="a-bob"><path d="M84,54q14,20 0,34q-14,-14 0,-34z" fill="#6fb3d6" stroke="${PK_INK}" stroke-width="2.5"/></g><path d="M34,100q26,-30 52,0" fill="#d39a6e" stroke="${PK_INK}" stroke-width="3"/><path d="M40,92q20,-8 40,0" stroke="#fff" stroke-width="5" stroke-linecap="round" opacity=".8" fill="none"/>`,
        tetanus: `${PKG("tt")}${SHADOW(60, 108, 34)}<g transform="rotate(-35 60 60)"><rect x="52" y="20" width="16" height="76" fill="#8a6a42" stroke="${PK_INK}" stroke-width="3"/><rect x="44" y="14" width="32" height="10" rx="3" fill="#6b4a2e" stroke="${PK_INK}" stroke-width="2.5"/><path d="M52,96l8,14l8,-14z" fill="#8a6a42" stroke="${PK_INK}" stroke-width="3"/><path d="M54,40q6,6 0,12M66,56q-6,6 0,12M55,70q6,6 0,12" stroke="#c0552c" stroke-width="5" fill="none"/></g><g class="a-pulse" style="transform-origin:60px 60px">${[[22, 34], [96, 30], [100, 84], [20, 88], [86, 104]].map(([x, y]) => `<circle cx="${x}" cy="${y}" r="5" fill="#5a0f0f"/><path d="M${x - 9},${y}h18M${x},${y - 9}v18" stroke="#5a0f0f" stroke-width="2"/>`).join("")}</g>`,
        hospital: `${PKG("hp")}${SHADOW(60, 108, 40)}<rect x="18" y="34" width="84" height="70" rx="6" fill="#f3e4bb" stroke="${PK_INK}" stroke-width="3"/><rect x="48" y="74" width="24" height="30" fill="#2a2420"/><rect x="26" y="44" width="14" height="14" fill="#9fc5d8"/><rect x="80" y="44" width="14" height="14" fill="#9fc5d8"/><g class="a-pulse" style="transform-origin:60px 24px"><circle cx="60" cy="24" r="18" fill="#fff" stroke="${PK_INK}" stroke-width="3"/><path d="M60,14v20M50,24h20" stroke="#c8392b" stroke-width="7" stroke-linecap="round"/></g>`,
        press: `${PKG("pr")}${SHADOW(60, 108, 34)}<rect x="14" y="60" width="92" height="40" rx="10" fill="#d39a6e" stroke="${PK_INK}" stroke-width="3"/><path d="M48,80h24" stroke="#8f1b1b" stroke-width="7" stroke-linecap="round"/><g class="a-bob"><rect x="40" y="48" width="40" height="30" rx="6" fill="#f4ecd8" stroke="${PK_INK}" stroke-width="2.5"/><path d="M60,12v28M46,22q14,-14 28,0" stroke="#ecc29c" stroke-width="14" stroke-linecap="round" fill="none"/><path d="M46,22q14,-14 28,0" stroke="${PK_INK}" stroke-width="2.5" fill="none"/></g>`,
      });
      // the sickle blade left in the bars last night (EP.2): a rusted hook at the gate, our side
      const BLADE = (id, x, y, s = 1) => `<g id="${id}" transform="translate(${x},${y}) scale(${s})"><path d="M0,0C70,-20 120,-100 90,-180C120,-110 60,-50 0,-26Z" fill="#b8793f" stroke="#2e2a26" stroke-width="4"/><path d="M8,-8C60,-28 100,-90 88,-150" stroke="#dfe6e2" stroke-width="5" fill="none" stroke-linecap="round" opacity=".7"/><path d="M30,-40C70,-60 95,-110 88,-160" stroke="#9a5a2a" stroke-width="7" fill="none" stroke-linecap="round" opacity=".85"/><path d="M20,-20q12,-6 24,-14" stroke="#6b3a14" stroke-width="5" fill="none" opacity=".8"/></g>`;
      // ภู's hand coming through the bars from the far side (Hand.open, his skin) — the thing the hook opens on
      const PHU_HAND = (id, x, y, s = 1, rot = 0) => `<g id="${id}" transform="translate(${x},${y}) rotate(${rot}) scale(${s})">${Hand.open(SKIN_PHU)}</g>`;

      // ---------- 1. hook, first person through the bars: a man on the road, his hand on a bar; "อย่าเพิ่งเปิดประตู" ----------
      add("hook", {
        set: "gateClose", setOpts: { id: "hk", time: "morning", bolt: 0 }, dark: 0.22, blur: { far: 4, mid: 1 },
        cam: { keys: [{ t: 0, ...fr(540, 1050, 0.82, 540, 1000), drift: { s: 0.02 } }, { t: vo("hook", 1) - 0.05, glide: 0.6, ...fr(520, 1120, 1.15, 540, 1000), drift: { s: 0.03 } }, { t: vo("hook", 2) - 0.05, ...fr(600, 1180, 1.35, 540, 1050), drift: { s: 0.04 } }] },
        shake: (t) => (t > vo("hook", 2) && t < vo("hook", 2) + 0.35 ? 12 * Math.sin(t * 23) * (vo("hook", 2) + 0.35 - t) / 0.35 : 1.5 * Math.sin(t * 2.6)),
        captions: caps("hook"),
        extra(L) { put(L.set, PHU_HAND("hk-hand", 257, 1330, 0.72, 0)); },
        fx(tl, id, t0, L) {
          behind(L, tl, "hk-phu", "phu", 760, 1180, 0.95, false, t0, D("hook"), [{ t: 0, mode: "lie", eyes: "closed", mouth: "flat" }, { t: vo("hook", 1) - 0.2, mode: "lie", eyes: "normal", mouth: "o" }]);
          tl.fromTo("#hk-hand", { attr: { transform: "translate(257,1600) rotate(0) scale(0.72)" } }, { attr: { transform: "translate(257,1330) rotate(0) scale(0.72)" }, duration: 0.7, ease: "power2.out", immediateRender: false }, t0 + vo("hook", 1) - 0.3);
          tl.fromTo("#hk-hand", { attr: { transform: "translate(257,1330) rotate(0) scale(0.72)" } }, { attr: { transform: "translate(259,1324) rotate(2) scale(0.72)" }, duration: 0.12, repeat: 9, yoyo: true, immediateRender: false }, t0 + vo("hook", 1) + 0.5);
          Fx.punch(tl, `#${id} .stage`, t0 + vo("hook", 2), 1.08, 0.4); Fx.glitch(tl, `#${id}`, t0 + vo("hook", 2), 0.25, 10, 11); red(tl, t0 + vo("hook", 2));
          Fx.punch(tl, `#${id} .stage`, t0 + F("hook", 2, 1), 1.05, 0.3); red(tl, t0 + F("hook", 2, 1), 0.5, 0.5);
          Fx.heart(tl, t0 + 0.3, D("hook") - 0.3, 0.55, 0.5);
          tl.set("#black", { opacity: 1 }, t0 + D("hook") - 0.12); tl.set("#black", { opacity: 0 }, t0 + D("hook"));
        },
      });

      // ---------- 2. chapter: the page, 97 days; the radio said six — and this morning there is a sixth ----------
      add("chapter", {
        set: "schoolYard", setOpts: { id: "ch", time: "morning", level: 0.6 }, dark: 0.25, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(560, 760, 0.62, 540, 900), drift: { s: 0.012, y: 10 } }] },
        captions: caps("chapter"),
        ui: [{ type: "board", t: 0.05, day: "97", ep: "ตอนที่ 3 · คนแปลกหน้า", top: 330 },
          { type: "counter", t: F("chapter", 0, 1) - 0.1, end: D("chapter") - 0.05, label: "คนในค่าย", icon: "people", unit: "คน", max: 6, sub: "วิทยุบอก… หก", keys: [{ t: F("chapter", 0, 1), v: 5 }, { t: F("chapter", 0, 2) + 0.3, v: 6 }], alarm: F("chapter", 0, 2) + 0.3, top: 1080, right: true }],
        fx(tl, id, t0) { Fx.heart(tl, t0 + 0.6, D("chapter") - 0.6, 0.7, 0.3); Fx.punch(tl, `#${id} .stage`, t0 + F("chapter", 0, 2) + 0.3, 1.05, 0.3); red(tl, t0 + F("chapter", 0, 2) + 0.3, 0.4, 0.5); },
      });

      // ---------- 3. rule two, on its card: "ช่วยได้… แต่อย่าเชื่อ" ----------
      add("rule", {
        set: "schoolYard", setOpts: { id: "ru", time: "morning", gate: 0 }, dark: 0.15, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(700, 1150, 0.92, 540, 1050), drift: { s: 0.015 } }] },
        actors: [PI(560, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }, { t: vo("rule", 1), mode: "point", eyes: "normal", mouth: "flat" }]), KO(360, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }]),
          MA(160, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }]), HO(-40, 1500, 0.9, [{ t: 0, mode: "write", eyes: "normal", mouth: "flat" }], { prop: "ledger" }), PU(-200, 1500, 0.58, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }])],
        captions: [...caps("rule", [0]), ...caps("rule", [1], { quote: true })],
        ui: [{ type: "fRule", t: vo("rule", 1) - 0.3, nums: [2], label: "กฎของครูพิม", rows: ["ช่วยได้… <u>แต่อย่าเชื่อ</u>"], at: [vo("rule", 1) - 0.3], end: D("rule") - 0.05, top: 250 }],
        fx(tl, id, t0, L) { behind(L, tl, "ru-phu", "phu", 960, 1180, 0.9, false, t0, D("rule"), [{ t: 0, mode: "lie", eyes: "normal", mouth: "o" }]); Fx.punch(tl, `#${id} .stage`, t0 + F("rule", 1, 1), 1.05, 0.35); red(tl, t0 + F("rule", 1, 1), 0.4, 0.5); Fx.heart(tl, t0, D("rule"), 0.65, 0.35); },
      });

      // ---------- 4. crane down from above the yard: ก้อง runs for the gate; "ยังก่อน ก้อง ถอยออกมา" ----------
      add("gate", {
        set: "schoolYard", setOpts: { id: "gt", time: "morning", gate: 0 }, dark: 0.15, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(640, 560, 0.5, 540, 760), drift: { s: 0.01 } }, { t: D("gate") - 0.2, glide: D("gate") - 0.4, ...fr(700, 1200, 1.05, 540, 1050), drift: { s: 0.02 } }] },
        actors: [KO(260, 1500, 0.9, [{ t: 0, mode: "run", eyes: "wide", mouth: "o" }, { t: 0.9, mode: "reach", eyes: "wide", mouth: "o" }, { t: vo("gate", 1) + 0.3, mode: "idle", eyes: "normal", mouth: "frown" }], { moveTo: { x: 760, dur: 0.9, ease: "power1.out" } }),
          PI(540, 1500, 0.9, [{ t: 0, mode: "walk", eyes: "normal", mouth: "frown" }, { t: vo("gate", 1) - 0.1, mode: "stopHand", eyes: "wide", mouth: "o" }], { moveTo: { x: 600, dur: vo("gate", 1) } }),
          MA(160, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }]), HO(-20, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }]), PU(-180, 1500, 0.58, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }])],
        bubbles: [bub("gate", 0, 420, 560, 320), bub("gate", 1, 60, 560, 280)],
        fx(tl, id, t0, L) { behind(L, tl, "gt-phu", "phu", 960, 1180, 0.9, false, t0, D("gate"), [{ t: 0, mode: "lie", eyes: "normal", mouth: "o" }]); Fx.heart(tl, t0, D("gate"), 0.5, 0.5); Fx.punch(tl, `#${id} .stage`, t0 + vo("gate", 1), 1.04, 0.3); },
      });

      // ---------- 5. he sits up against the bars: "ผมเห็นไฟ เมื่อคืน" — the engine did not call only them ----------
      add("plea", {
        set: "schoolYard", setOpts: { id: "pl", time: "morning", gate: 0 }, dark: 0.2, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(900, 1150, 1.3, 540, 1050), drift: { s: 0.02 } }, { t: vo("plea", 1) - 0.05, ...fr(760, 1150, 1.0, 540, 1050), drift: { s: 0.02 } }] },
        actors: [PI(600, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }]), KO(400, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }])],
        captions: caps("plea", [1]),
        bubbles: [bub("plea", 0, 380, 520, 560)],
        ui: [{ type: "callback", t: F("plea", 1, 1), end: D("plea") - 0.05, label: "กฎของเรื่อง", text: "มันเดินตามเสียง… <em>คนก็เหมือนกัน</em>", top: 1300 }],
        fx(tl, id, t0, L) { behind(L, tl, "pl-phu", "phu", 960, 1180, 0.9, false, t0, D("plea"), [{ t: 0, mode: "lie", eyes: "normal", mouth: "o" }, { t: 0.4, mode: "sitHold", eyes: "normal", mouth: "flat" }]); Fx.punch(tl, `#${id} .stage`, t0 + F("plea", 1, 1), 1.05, 0.35); Fx.heart(tl, t0, D("plea"), 0.6, 0.4); },
      });

      // ---------- 6. first person through the bars: arms out, neck, turn around — the checklist; the leg is the one ✗ ----------
      add("search", {
        set: "gateClose", setOpts: { id: "se", time: "morning", bolt: 0 }, dark: 0.2, blur: { far: 4 },
        cam: { keys: [{ t: 0, ...fr(560, 900, 0.95, 540, 900), drift: { s: 0.02 } }, { t: F("search", 1, 2) - 0.05, glide: 0.5, ...fr(560, 1150, 1.2, 540, 1000), drift: { s: 0.03 } }] },
        captions: caps("search", [1]),
        bubbles: [bub("search", 0, 60, 300, 400)],
        ui: [{ type: "signs", t: F("search", 0, 0) + 0.5, items: ["แขน", "คอ", "หลัง", "ขา <em>มีแผล</em>"], icons: [CHK.arm, CHK.neck, CHK.back, CHK.leg], ok: [1, 1, 1, 0], at: [F("search", 0, 0) + 0.5, F("search", 0, 0) + 1.3, F("search", 0, 1) + 0.3, F("search", 1, 2)], end: D("search") - 0.05, top: 900 }],
        fx(tl, id, t0, L) {
          behind(L, tl, "se-phu", "phu", 560, 1180, 0.95, false, t0, D("search"), [{ t: 0, mode: "holdArm", eyes: "normal", mouth: "flat" }, { t: F("search", 0, 0) + 0.3, mode: "showArms", eyes: "normal", mouth: "flat" }, { t: F("search", 0, 1) + 0.1, mode: "idle", eyes: "normal", mouth: "flat" }, { t: F("search", 1, 2) - 0.2, mode: "holdArm", eyes: "normal", mouth: "frown" }]);
          tl.set("#se-phu", { attr: { transform: "translate(560,1180) scale(-0.95,0.95)" } }, t0 + F("search", 0, 1) + 0.15);   // he turns his back
          tl.set("#se-phu", { attr: { transform: "translate(560,1180) scale(0.95,0.95)" } }, t0 + F("search", 1, 2) - 0.2);
          Fx.punch(tl, `#${id} .stage`, t0 + F("search", 1, 2), 1.06, 0.35); red(tl, t0 + F("search", 1, 2), 0.5, 0.5); Fx.heart(tl, t0, D("search"), 0.6, 0.4);
        },
      });

      // ---------- 7. the gash: the trouser torn at the shin, a cut from metal, dirt in it; "ขอมีดหน่อยครับ" ----------
      add("wound", {
        set: "woundClose", setOpts: { id: "wd", time: "morning" }, dark: 0.2, blur: { far: 2 },
        cam: { keys: [{ t: 0, ...fr(480, 1000, 1.15, 540, 960), drift: { s: 0.02 } }, { t: F("wound", 0, 2) - 0.05, glide: 0.5, ...fr(420, 990, 1.7, 540, 960), drift: { s: 0.03 } }, { t: vo("wound", 1) - 0.05, glide: 0.4, ...fr(500, 1000, 1.2, 540, 960), drift: { s: 0.02 } }] },
        captions: caps("wound", [0]),
        bubbles: [bub("wound", 1, 80, 420, 400)],
        extra(L) { put(L.act, `<g id="wd-ring" opacity="0"><ellipse cx="405" cy="975" rx="120" ry="90" fill="none" stroke="#c8392b" stroke-width="10" stroke-dasharray="26 16" transform="rotate(-18 405 975)"/></g>`); },
        fx(tl, id, t0) { tl.fromTo("#wd-ring", { opacity: 0, scale: 1.6 }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2)", svgOrigin: "405 975", immediateRender: false }, t0 + F("wound", 0, 2)); tl.to("#wd-ring", { opacity: 0, duration: 0.2 }, t0 + vo("wound", 1)); Fx.punch(tl, `#${id} .stage`, t0 + F("wound", 0, 2), 1.06, 0.35); red(tl, t0 + F("wound", 0, 2), 0.5, 0.5); Fx.heart(tl, t0, D("wound"), 0.6, 0.4); },
      });

      // ---------- 8. first person: our hand puts the kitchen knife through the bars into his — the last weapon, outside the fence ----------
      add("knife", {
        set: "gateClose", setOpts: { id: "kn", time: "morning", bolt: 0 }, dark: 0.22, blur: { far: 4 },
        cam: { keys: [{ t: 0, ...fr(560, 1150, 1.05, 540, 1050), drift: { s: 0.02 } }, { t: F("knife", 1, 1) - 0.05, ...fr(640, 1100, 1.3, 540, 1050), drift: { s: 0.04 } }] },
        captions: caps("knife"),
        ui: [{ type: "counter", t: F("knife", 0, 1) - 0.1, end: D("knife") - 0.05, label: "อาวุธของค่าย", icon: "knife", unit: "ชิ้น", max: 1, sub: "เคียวหักเมื่อคืน", keys: [{ t: F("knife", 0, 1), v: 1 }, { t: F("knife", 1, 1), v: 0 }], alarm: F("knife", 1, 1), top: 150 }],
        extra(L) { put(L.set, PHU_HAND("kn-hand", 760, 1000, 1.0, -10)); put(L.fg, `<g id="kn-grip" transform="translate(320,1560) rotate(-20) scale(0.8)">${Fence.KNIFE("", 1)}${Hand.grip(SKIN_PIM)}</g>`); },
        fx(tl, id, t0) {
          tl.fromTo("#kn-grip", { attr: { transform: "translate(320,1560) rotate(-20) scale(0.8)" } }, { attr: { transform: "translate(470,1180) rotate(-35) scale(0.8)" }, duration: 1.1, ease: "power2.inOut", immediateRender: false }, t0 + 0.3);
          tl.to("#kn-grip", { attr: { transform: "translate(330,1480) rotate(-20) scale(0.8)" }, duration: 0.7, ease: "power2.in" }, t0 + F("knife", 1, 1) + 0.2);
          tl.to("#kn-hand", { attr: { transform: "translate(700,1020) rotate(-30) scale(1.0)" }, duration: 0.5, ease: "power2.out" }, t0 + F("knife", 1, 1));
          Fx.punch(tl, `#${id} .stage`, t0 + F("knife", 1, 1), 1.07, 0.4); red(tl, t0 + F("knife", 1, 1), 0.6, 0.6); Fx.glitch(tl, `#${id}`, t0 + F("knife", 1, 1), 0.15, 8, 21); Fx.heart(tl, t0, D("knife"), 0.5, 0.5);
        },
      });

      // ---------- 9. he saws the trouser leg open; "เรียบร้อย เปิดได้แล้วครับ" — the gate rolls for a stranger ----------
      split("open", voEnd("open", 0) + 0.3, {
        set: "schoolYard", setOpts: { id: "op", time: "morning", gate: 0 }, dark: 0.15, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(900, 1180, 1.25, 540, 1050), drift: { s: 0.02 } }] },
        actors: [PI(620, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }])],
        bubbles: [bub("open", 0, 360, 560, 560)],
        fx(tl, id, t0, L) { behind(L, tl, "op-phu", "phu", 960, 1180, 0.9, false, t0, voEnd("open", 0) + 0.3, [{ t: 0, mode: "cutCloth", eyes: "normal", mouth: "flat" }, { t: vo("open", 0), mode: "sitHold", eyes: "normal", mouth: "smile" }], { prop: "knife" }); Fx.heart(tl, t0, voEnd("open", 0) + 0.3, 0.6, 0.4); },
      }, {
        set: "schoolYard", setOpts: { id: "og", time: "morning", gate: 0.8 }, dark: 0.15, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(760, 1150, 0.95, 540, 1050), drift: { s: 0.02 } }] },
        shake: (t) => (t < 0.4 ? 5 * Math.sin(t * 40) : 0),
        actors: [PI(620, 1500, 0.9, [{ t: 0, mode: "push", eyes: "normal", mouth: "flat" }, { t: 0.4, mode: "idle", eyes: "normal", mouth: "frown" }], { flip: true }), KO(380, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "smile" }]),
          PH(1250, 1500, 0.9, [{ t: 0, mode: "limp", eyes: "normal", mouth: "flat" }, { t: D("open") - voEnd("open", 0) - 0.5, mode: "holdArm", eyes: "normal", mouth: "smile" }], { flip: true, moveTo: { x: 860, dur: D("open") - voEnd("open", 0) - 0.5, ease: "none" } })],
        fx(tl, id, t0) { tl.fromTo("#flashw", { opacity: 0.25 }, { opacity: 0, duration: 0.3, immediateRender: false }, t0); Fx.heart(tl, t0, D("open") - voEnd("open", 0) - 0.3, 0.55, 0.45); },
      });

      // ---------- 10. he washes it himself: clean water, soap around it, a clean cloth over it (NHS) — fast, like a hundred times before ----------
      add("wash", {
        set: "woundClose", setOpts: { id: "ws", time: "day", can: true, hand: true }, dark: 0.15, blur: { far: 2 },
        cam: { keys: [{ t: 0, ...fr(480, 900, 1.05, 540, 960), drift: { s: 0.02 } }, { t: vo("wash", 1) - 0.05, glide: 0.5, ...fr(450, 1000, 1.3, 540, 960), drift: { s: 0.02 } }] },
        captions: caps("wash"),
        ui: [{ type: "tip", t: vo("wash", 1) - 0.1, end: D("wash") - 0.05, ill: "wash", label: "ล้างแผล · NHS", text: "[น้ำสะอาด] → สบู่ → {ผ้าสะอาดปิด}", tone: "rule", top: 230 },
          { type: "src", t: F("wash", 1, 2), end: D("wash") - 0.05, top: 560, text: NHS + "“Clean the wound by rinsing it with bottled or tap water… Cover the wound with sterile gauze or a clean cloth.”" }],
        fx(tl, id, t0) {
          tl.fromTo("#ws-pour", { opacity: 0 }, { opacity: 1, duration: 0.2, immediateRender: false }, t0 + 0.3); tl.to("#ws-pour", { opacity: 0, duration: 0.3 }, t0 + F("wash", 1, 1));
          tl.to("#ws-dirt", { opacity: 0, duration: 0.8 }, t0 + 0.6);
          tl.fromTo("#ws-hand", { attr: { transform: "translate(760,1300) rotate(-30) scale(0.7)" } }, { attr: { transform: "translate(620,1180) rotate(-30) scale(0.7)" }, duration: 0.5, ease: "power2.out", immediateRender: false }, t0 + F("wash", 1, 1));
          for (let k = 0; k < 5; k++) tl.to("#ws-hand", { attr: { transform: `translate(${620 - k * 30},${1180 - k * 24}) rotate(-30) scale(0.7)` }, duration: 0.14, ease: "sine.inOut" }, t0 + F("wash", 1, 1) + 0.5 + k * 0.14);
          tl.to("#ws-hand", { attr: { transform: "translate(900,1500) rotate(-30) scale(0.7)" }, duration: 0.4, ease: "power2.in" }, t0 + F("wash", 1, 2) - 0.1);
          tl.fromTo("#ws-wrap", { opacity: 0, scale: 1.3 }, { opacity: 1, scale: 1, duration: 0.3, ease: "power2.out", svgOrigin: "400 1000", immediateRender: false }, t0 + F("wash", 1, 2) + 0.2);
          Fx.punch(tl, `#${id} .stage`, t0 + F("wash", 1, 2) + 0.2, 1.04, 0.3); Fx.heart(tl, t0, D("wash"), 0.7, 0.3);
        },
      });

      // ---------- 11. the ledger: the tank, one notch less — "หมดไปกับขาเขา" ----------
      add("ledger", {
        set: "schoolYard", setOpts: { id: "lg", time: "day", level: 0.5 }, dark: 0.15, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(300, 1180, 1.1, 540, 1050), drift: { s: 0.02 } }] },
        actors: [HO(200, 1500, 0.9, [{ t: 0, mode: "write", eyes: "normal", mouth: "frown" }, { t: vo("ledger", 0), mode: "point", eyes: "normal", mouth: "frown" }], { prop: "ledger" }), PH(560, 1500, 0.9, [{ t: 0, mode: "sitHold", eyes: "normal", mouth: "flat" }], { flip: true }), PU(400, 1500, 0.58, [{ t: 0, mode: "crouchDraw", eyes: "normal", mouth: "smile" }], { prop: "crayon" })],
        bubbles: [bub("ledger", 0, 40, 520, 240)],
        ui: [{ type: "counter", t: 0.2, end: D("ledger") - 0.05, label: "น้ำในแท็งก์", icon: "water", unit: "ขีด", max: 10, keys: [{ t: 0.2, v: 5 }, { t: vo("ledger", 0) + 0.3, v: 4 }], alarm: vo("ledger", 0) + 0.3, top: 150, right: true }],
        fx(tl, id, t0) { Fx.heart(tl, t0, D("ledger"), 0.7, 0.3); },
      });

      // ---------- 12. afternoon: the sickle blade still in the bars, rusted — and one of them walking up the road; the lunge at the bars (POV) ----------
      split("blade", D("blade") - 1.0, {
        set: "schoolYard", setOpts: { id: "bl", time: "day", gate: 0, sunX: 900 }, dark: 0.15, blur: { far: 2 },
        cam: { keys: [{ t: 0, ...fr(900, 1100, 1.2, 540, 1000), drift: { s: 0.02 } }, { t: F("blade", 0, 2) - 0.05, glide: 0.5, ...fr(980, 1000, 1.7, 540, 960), drift: { s: 0.03 } }] },
        actors: [MA(760, 1500, 0.9, [{ t: 0, mode: "walk", eyes: "normal", mouth: "flat" }, { t: 1.0, mode: "reach", eyes: "normal", mouth: "flat" }, { t: F("blade", 0, 2), mode: "pullBolt", eyes: "normal", mouth: "frown" }], { moveTo: { x: 880, dur: 1.0 } })],
        captions: capsFrom("blade", 0).filter((c) => c.t < D("blade") - 1.1),
        ui: [{ type: "callback", t: F("blade", 0, 2), end: D("blade") - 1.05, label: "ภัยที่มองไม่เห็น", text: "<em>สนิม</em> + ดิน + เลือดเก่า", top: 300 }],
        extra(L) { put(L.act, BLADE("bl-sick", 1000, 1050, 1.15)); },
        fx(tl, id, t0, L) {
          behind(L, tl, "bl-z0", "ha2", 1700, 1180, 0.8, true, t0, D("blade") - 1.0, [{ t: 0, mode: "shamble", eyes: "dead", mouth: "snarl" }]);
          route(tl, "bl-z0", t0, [{ t: 0, x: 1700, y: 1180 }, { t: D("blade") - 1.0, x: 1180, y: 1180 }], 0.8, true);
          Fx.punch(tl, `#${id} .stage`, t0 + F("blade", 0, 2), 1.05, 0.35); red(tl, t0 + F("blade", 0, 2), 0.4, 0.5); Fx.heart(tl, t0, D("blade") - 1.0, 0.55, 0.45);
        },
      }, {   // first person: her face at the bars
        set: "gateClose", setOpts: { id: "bz", time: "day", bolt: 0 }, dark: 0.35, blur: { far: 6, mid: 4 },
        cam: { keys: [{ t: 0, ...fr(540, 1100, 1.1, 540, 960), drift: { s: 0.1 } }] },
        shake: (t) => 10 * Math.sin(t * 27),
        extra(L) { put(L.set, Zom.zLunge("bz-z", 540, 1150, 0.55).replace(/#b9c4d6/g, "#6a5a4a").replace(/#7b8aa6/g, "#4a3c30").replace(/#97a3b8/g, "#d9c9a0")); },
        fx(tl, id, t0) {
          tl.set("#bz-z", { opacity: 1 }, t0);
          tl.fromTo("#bz-z", { attr: { transform: "translate(540,1250) scale(0.5)" } }, { attr: { transform: "translate(540,1150) scale(1.25)" }, duration: 1.0, ease: "power3.in", immediateRender: false }, t0);
          Fx.tunnel(tl, t0, t0 + 1.2, 0.6); red(tl, t0 + 0.75, 0.8, 0.4); Fx.heart(tl, t0, 1.0, 0.3, 0.9);
          tl.fromTo("#flashw", { opacity: 0.6 }, { opacity: 0, duration: 0.1, immediateRender: false }, t0 + 0.9);
        },
      });

      // ---------- 13. he jerks back — the blade opens his hand; "โอ๊ย มันบาด" ----------
      add("cut", {
        set: "schoolYard", setOpts: { id: "ct", time: "day", gate: 0, sunX: 900 }, dark: 0.2, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(860, 1150, 1.15, 540, 1050), r: -2, drift: { s: 0.04, r: 3 } }, { t: vo("cut", 1) - 0.05, ...fr(760, 1200, 1.35, 540, 1050), drift: { s: 0.03 } }] },
        shake: (t) => (t < 0.5 ? 12 * Math.sin(t * 25) : 2 * Math.sin(t * 9)),
        actors: [MA(880, 1500, 0.9, [{ t: 0, mode: "knocked", eyes: "wide", mouth: "scream" }, { t: 0.5, mode: "sitHold", eyes: "closed", mouth: "frown" }], { moveTo: { x: 700, dur: 0.4, ease: "power2.out" } })],
        captions: caps("cut", [1]),
        bubbles: [bub("cut", 0, 60, 560, 300)],
        extra(L) { put(L.act, BLADE("ct-sick", 1000, 1050, 1.15)); put(L.act, `<g id="ct-blood" opacity="0"><ellipse cx="760" cy="1480" rx="60" ry="14" fill="#7a1414" opacity=".8"/><path d="M700,1300q20,60 10,120M740,1320q10,50 20,110" stroke="#7a1414" stroke-width="7" fill="none" stroke-linecap="round"/></g>`); },
        fx(tl, id, t0, L) {
          behind(L, tl, "ct-z0", "ha2", 1180, 1180, 0.8, true, t0, D("cut"), [{ t: 0, mode: "lunge", eyes: "dead", mouth: "snarl" }, { t: 0.8, mode: "still", eyes: "dead", mouth: "snarl" }]);
          impact(tl, id, L, t0 + 0.05, 1000, 1080, 0.8); red(tl, t0 + 0.05, 0.8, 0.5); Fx.glitch(tl, `#${id}`, t0 + 0.05, 0.2, 12, 31);
          tl.fromTo("#ct-blood", { opacity: 0 }, { opacity: 1, duration: 0.3, immediateRender: false }, t0 + 0.5);
          Fx.punch(tl, `#${id} .stage`, t0 + F("cut", 1, 1), 1.06, 0.35); red(tl, t0 + F("cut", 1, 1), 0.5, 0.5); Fx.heart(tl, t0, D("cut"), 0.36, 0.85);
        },
      });

      // ---------- 14. ภู is there before anyone: pressure, don't let go, ten minutes — the card "หมอ" ----------
      add("press", {
        set: "schoolYard", setOpts: { id: "pr", time: "day", gate: 0, sunX: 900 }, dark: 0.2, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(640, 1200, 1.1, 540, 1050), drift: { s: 0.02 } }, { t: vo("press", 1) - 0.05, ...fr(600, 1200, 1.3, 540, 1100), drift: { s: 0.03 } }] },
        actors: [MA(700, 1500, 0.9, [{ t: 0, mode: "sitHold", eyes: "closed", mouth: "frown" }, { t: 1.2, mode: "sitHold", eyes: "normal", mouth: "frown" }]),
          PH(100, 1500, 0.9, [{ t: 0, mode: "run", eyes: "wide", mouth: "flat" }, { t: 0.6, mode: "press", eyes: "normal", mouth: "flat" }], { moveTo: { x: 520, dur: 0.6, ease: "power1.out" } }),
          PI(300, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }, { t: 0.8, mode: "crouch", eyes: "wide", mouth: "o" }]), KO(-60, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }])],
        captions: caps("press", [1]),
        bubbles: [bub("press", 0, 60, 520, 500)],
        ui: [{ type: "skill", t: 0.9, end: vo("press", 1) + 0.4, x: 60, y: 820, name: "ภู", skill: "หมอ", desc: "ห้ามเลือด · ล้างแผล · รู้ก่อนใครว่าอันตราย", icon: "medic" },
          { type: "tip", t: vo("press", 1) + 0.3, end: D("press") - 0.05, ill: "press", label: "ห้ามเลือด · MedlinePlus", text: "กดตรงแผล [10 นาที] · ไม่หยุด → {หาหมอ}", tone: "warn", top: 230 }],
        extra(L) { put(L.act, `<g id="pr-blood" opacity="1"><ellipse cx="760" cy="1480" rx="60" ry="14" fill="#7a1414" opacity=".8"/></g>`); },
        fx(tl, id, t0) { Fx.punch(tl, `#${id} .stage`, t0 + 0.9, 1.05, 0.35); Fx.punch(tl, `#${id} .stage`, t0 + F("press", 1, 1), 1.04, 0.3); Fx.heart(tl, t0, D("press"), 0.45, 0.6); },
      });

      // ---------- 15. the card: tetanus — rust, soil, dust; through a deep wound; lockjaw first; 3–21 days; one in ten (CDC) ----------
      add("tetanus", {
        set: "classroom", setOpts: { id: "tt", time: "day", lampX: 760, lampY: 1120 }, dark: 0.3, blur: { far: 4, set: 2 },
        cam: { keys: [{ t: 0, ...fr(560, 1180, 1.1, 540, 1050), drift: { s: 0.02 } }, { t: vo("tetanus", 2) - 0.05, ...fr(640, 1200, 1.3, 540, 1100), drift: { s: 0.03 } }] },
        shake: (t) => (t > F("tetanus", 1, 2) && t < F("tetanus", 1, 2) + 0.35 ? 12 * Math.sin(t * 23) : 0),
        actors: [MA(700, 1500, 0.9, [{ t: 0, mode: "sitChair", eyes: "normal", mouth: "frown" }], { flip: true }), PH(420, 1500, 0.9, [{ t: 0, mode: "kneelAid", eyes: "normal", mouth: "flat" }]), PI(140, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }])],
        captions: caps("tetanus"),
        ui: [{ type: "tip", t: F("tetanus", 0, 1) - 0.1, end: D("tetanus") - 0.05, ill: "tetanus", label: "บาดทะยัก", text: "สนิม · ดิน · ฝุ่น → [สปอร์] → {ขากรรไกรแข็ง}", tone: "danger", top: 230 },
          { type: "src", t: F("tetanus", 1, 2), end: vo("tetanus", 2) - 0.1, top: 600, text: CDC + "“The first sign is most commonly spasms of the jaw muscles, or ‘lockjaw.’”" },
          { type: "src", t: vo("tetanus", 2), end: D("tetanus") - 0.05, top: 600, text: CDC + "“Symptoms typically occur between 3 and 21 days… Tetanus can lead to death (1 in 10 cases in the United States are fatal).”" },
          { type: "callback", t: F("tetanus", 2, 1), end: D("tetanus") - 0.05, label: "บาดทะยัก", text: "ตาย <em>1 ใน 10</em>", top: 1300 }],
        fx(tl, id, t0) { Fx.punch(tl, `#${id} .stage`, t0 + F("tetanus", 1, 2), 1.1, 0.5); Fx.glitch(tl, `#${id}`, t0 + F("tetanus", 1, 2), 0.3, 14, 51); red(tl, t0 + F("tetanus", 1, 2), 0.8, 0.7); Fx.punch(tl, `#${id} .stage`, t0 + F("tetanus", 2, 1), 1.06, 0.4); red(tl, t0 + F("tetanus", 2, 1), 0.5, 0.6); Fx.heart(tl, t0, D("tetanus"), 0.5, 0.55); },
      });

      // ---------- 16. "ลุงฉีดกันบาดทะยักครั้งสุดท้ายเมื่อไหร่" — "จำไม่ได้ นานแล้ว" ----------
      add("needle", {
        set: "classroom", setOpts: { id: "nd", time: "day", lampX: 760, lampY: 1120 }, dark: 0.3, blur: { far: 4 },
        cam: { keys: [{ t: 0, ...fr(560, 1180, 1.2, 540, 1050), drift: { s: 0.02 } }, { t: vo("needle", 1) - 0.05, ...fr(720, 1180, 1.45, 540, 1050), drift: { s: 0.03 } }] },
        actors: [MA(700, 1500, 0.9, [{ t: 0, mode: "sitChair", eyes: "normal", mouth: "frown" }, { t: vo("needle", 1), mode: "sitChair", eyes: "closed", mouth: "frown" }], { flip: true }), PH(420, 1500, 0.9, [{ t: 0, mode: "kneelAid", eyes: "normal", mouth: "flat" }, { t: vo("needle", 0), mode: "crouch", eyes: "normal", mouth: "flat" }])],
        bubbles: [bub("needle", 0, 40, 520, 360), bub("needle", 1, 420, 520, 620)],
        fx(tl, id, t0) { Fx.punch(tl, `#${id} .stage`, t0 + F("needle", 1, 1), 1.07, 0.4); red(tl, t0 + F("needle", 1, 1), 0.6, 0.6); Fx.glitch(tl, `#${id}`, t0 + F("needle", 1, 1), 0.15, 8, 41); Fx.heart(tl, t0, D("needle"), 0.5, 0.5); },
      });

      // ---------- 17. from now on, every morning: red, more pain, yellow-green pus, a fever over 37.7 for four hours (MedlinePlus) ----------
      add("signs", {
        set: "classroom", setOpts: { id: "sg", time: "day", lampX: 760, lampY: 1120 }, dark: 0.3, blur: { far: 4, set: 2 },
        cam: { keys: [{ t: 0, ...fr(600, 1150, 1.0, 540, 1000), drift: { s: 0.02 } }] },
        actors: [MA(700, 1500, 0.9, [{ t: 0, mode: "sitChair", eyes: "normal", mouth: "flat" }], { flip: true }), PH(380, 1500, 0.9, [{ t: 0, mode: "point", eyes: "normal", mouth: "flat" }]), HO(120, 1500, 0.9, [{ t: 0, mode: "write", eyes: "normal", mouth: "flat" }], { prop: "ledger" })],
        captions: caps("signs"),
        ui: [{ type: "signs", t: F("signs", 0, 1), items: ["<em>แดง</em> ร้อน บวม", "<em>ปวด</em>มากขึ้น", "หนอง<em>เหลือง-เขียว</em>", "ไข้ <em>37.7°C+</em> เกิน 4 ชม."], icons: [CHK.red, CHK.pain, CHK.pus, CHK.fever], at: [F("signs", 0, 1), F("signs", 0, 1) + 0.55, F("signs", 0, 2), F("signs", 1, 0)], end: D("signs") - 0.05, top: 170 },
          { type: "src", t: F("signs", 1, 2), end: D("signs") - 0.05, top: 1240, text: MLP + "“Redness, increased pain, or yellow or green pus… Fever of 100°F (37.7°C) or higher for more than 4 hours.”" }],
        fx(tl, id, t0) { Fx.punch(tl, `#${id} .stage`, t0 + F("signs", 1, 2), 1.05, 0.35); red(tl, t0 + F("signs", 1, 2), 0.4, 0.5); Fx.heart(tl, t0, D("signs"), 0.6, 0.4); },
      });

      // ---------- 18. in real life: a dirty wound, a bite, pus — hospital; you may need a tetanus shot (NHS) ----------
      add("real", {
        set: "schoolYard", setOpts: { id: "rl", time: "day", level: 0.5 }, dark: 0.2, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(560, 1150, 0.85, 540, 1050), drift: { s: 0.015 } }] },
        actors: [MA(500, 1500, 0.9, [{ t: 0, mode: "holdArm", eyes: "normal", mouth: "flat" }]), PH(760, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }], { flip: true }), PI(260, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }])],
        captions: caps("real"),
        ui: [{ type: "tip", t: F("real", 0, 1) - 0.1, end: D("real") - 0.05, ill: "hospital", label: "ในชีวิตจริง", text: "สกปรก · ถูกกัด · มีหนอง → {ไปโรงพยาบาล}", tone: "rule", top: 230 },
          { type: "src", t: F("real", 0, 2), end: D("real") - 0.05, top: 600, text: NHS + "“Get medical help as soon as possible if… a wound has soil, pus or body fluids in it… You may also need to have an injection to prevent tetanus.”" }],
        fx(tl, id, t0) { Fx.punch(tl, `#${id} .stage`, t0 + F("real", 0, 2), 1.05, 0.3); Fx.heart(tl, t0, D("real"), 0.7, 0.3); },
      });

      // ---------- 19. dusk: the register gets a sixth name — everyone starts to believe him; one person stands apart ----------
      add("trust", {
        set: "schoolYard", setOpts: { id: "tr", time: "dusk", sunX: 900, level: 0.5 }, dark: 0.25, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(400, 1150, 0.82, 540, 1050), drift: { s: 0.015 } }, { t: F("trust", 0, 2) - 0.05, glide: 0.6, ...fr(1000, 1200, 1.25, 540, 1050), drift: { s: 0.03 } }] },
        actors: [PH(360, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "smile" }]), KO(120, 1500, 0.9, [{ t: 0, mode: "point", eyes: "normal", mouth: "smile" }]), MA(580, 1500, 0.9, [{ t: 0, mode: "holdArm", eyes: "normal", mouth: "smile" }], { flip: true }),
          HO(-80, 1500, 0.9, [{ t: 0, mode: "write", eyes: "normal", mouth: "smile" }], { prop: "ledger" }), PU(240, 1500, 0.58, [{ t: 0, mode: "pointUp", eyes: "normal", mouth: "smile" }]),
          PI(1080, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }, { t: F("trust", 0, 2), mode: "holdHead", eyes: "normal", mouth: "frown" }], { flip: true })],
        captions: caps("trust"),
        ui: [{ type: "roster", t: 0.3, end: F("trust", 0, 2) + 0.4, top: 150, title: "ทะเบียนค่าย", who: "วันที่ 102 · เพิ่มชื่อ", rows: [{ name: "ภู", skill: "หมอ", desc: "ห้ามเลือด · ล้างแผล · อดีตกู้ภัย", icon: "medic", at: F("trust", 0, 1) }] }],
        fx(tl, id, t0) { Fx.punch(tl, `#${id} .stage`, t0 + F("trust", 0, 2), 1.05, 0.35); red(tl, t0 + F("trust", 0, 2), 0.35, 0.5); Fx.heart(tl, t0 + F("trust", 0, 2), D("trust") - F("trust", 0, 2), 0.5, 0.5); },
      });

      // ---------- 20. "ขอบคุณนะ… น้องปั้น" — nobody told him her name; "เมื่อกี้ครูเรียกเอง" — she didn't ----------
      add("name", {
        set: "schoolYard", setOpts: { id: "nm", time: "dusk", sunX: 900, level: 0.5 }, dark: 0.35, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(360, 1250, 1.3, 540, 1100), drift: { s: 0.02 } }, { t: vo("name", 1) - 0.05, ...fr(300, 1180, 1.05, 540, 1050), drift: { s: 0.02 } }, { t: vo("name", 2) - 0.05, ...fr(700, 1150, 1.1, 540, 1050), drift: { s: 0.02 } }, { t: vo("name", 3) - 0.05, ...fr(380, 1120, 1.5, 540, 1000), drift: { s: 0.03 } }, { t: vo("name", 4) - 0.05, ...fr(380, 1120, 1.7, 540, 1000), drift: { s: 0.05 } }] },
        shake: (t) => (t > F("name", 4, 1) && t < F("name", 4, 1) + 0.4 ? 10 * Math.sin(t * 23) : 0),
        actors: [PH(420, 1500, 0.9, [{ t: 0, mode: "crouch", eyes: "normal", mouth: "smile" }, { t: vo("name", 3), mode: "idle", eyes: "normal", mouth: "flat" }], { flip: true }), PU(200, 1500, 0.58, [{ t: 0, mode: "crouchDraw", eyes: "normal", mouth: "smile" }, { t: voEnd("name", 0), mode: "lookUp", eyes: "normal", mouth: "smile" }], { prop: "crayon" }),
          PI(900, 1500, 0.9, [{ t: 0, mode: "idle", eyes: "normal", mouth: "frown" }, { t: vo("name", 1), mode: "idle", eyes: "wide", mouth: "o" }, { t: vo("name", 2) - 0.1, mode: "stopHand", eyes: "wide", mouth: "o" }], { flip: true }), MA(1100, 1500, 0.9, [{ t: 0, mode: "holdArm", eyes: "normal", mouth: "flat" }], { flip: true })],
        captions: [...caps("name", [1]), ...caps("name", [4])],
        bubbles: [bub("name", 0, 60, 520, 440), bub("name", 2, 380, 520, 820), bub("name", 3, 40, 520, 440)],
        fx(tl, id, t0) {
          Fx.punch(tl, `#${id} .stage`, t0 + F("name", 0, 1), 1.05, 0.35); red(tl, t0 + F("name", 0, 1), 0.5, 0.6); Fx.glitch(tl, `#${id}`, t0 + F("name", 0, 1), 0.15, 8, 61);
          Fx.punch(tl, `#${id} .stage`, t0 + F("name", 1, 1), 1.06, 0.4); red(tl, t0 + F("name", 1, 1), 0.5, 0.6);
          Fx.punch(tl, `#${id} .stage`, t0 + F("name", 4, 1), 1.1, 0.5); Fx.glitch(tl, `#${id}`, t0 + F("name", 4, 1), 0.35, 16, 62); red(tl, t0 + F("name", 4, 1), 0.8, 0.8);
          Fx.heart(tl, t0 + vo("name", 1), D("name") - vo("name", 1), 0.42, 0.7);
        },
      });

      // ---------- channel signature ----------
      add("sig", {
        set: "schoolYard", setOpts: { id: "sgn", time: "night", lampX: -300 }, dark: 0.55, blur: { far: 10, set: 8, mid: 8 },
        cam: { keys: Sig.cam(F, fr(560, 1100, 0.9, 540, 960)) }, shake: Sig.shake(F),
        captions: caps("sig"),
        ui: [Sig.ui(F, "เหลือ 97 วัน · เช็กลิสต์เอาตัวรอด", [["ค้นตัวก่อนเปิดประตู", true], ["ล้างแผลด้วยน้ำสะอาด", true], ["กดห้ามเลือด 10 นาที", true], ["???", false]], D("sig"))],
        fx(tl, id, t0) { Sig.fx(tl, id, t0, F, D("sig")); },
      });

      // ---------- 21. the radio: "เก้าสิบหกวัน… หก" — "ตอนนี้เราหกคนพอดี" — "บังเอิญ" ----------
      split("radio", vo("radio", 2) - 0.1, {
        set: "radioClose", setOpts: { id: "ra" }, dark: 0.55,
        cam: { keys: [{ t: 0, ...fr(540, 1000, 1.0, 540, 960), drift: { s: 0.02 } }, { t: vo("radio", 1) - 0.3, ...fr(400, 900, 1.5, 540, 960), drift: { s: 0.03 } }] },
        captions: [...caps("radio", [0]), ...caps("radio", [1], { quote: true })],
        ui: [{ type: "tearCal", t: vo("radio", 1) - 0.5, end: vo("radio", 2) - 0.25, top: 150, label: "เหลือ", unit: "วัน", keys: [{ t: vo("radio", 1) - 0.5, v: 97 }, { t: F("radio", 1, 1), v: 96 }], tag: { t: F("radio", 1, 2), text: "· หก" } }],
        fx(tl, id, t0) {
          const on = t0 + vo("radio", 1) - 0.35;
          tl.fromTo(["#ra-dialw", "#ra-glow"], { opacity: 0 }, { opacity: 1, duration: 0.05, repeat: 5, yoyo: true, immediateRender: false }, on); tl.set(["#ra-dialw", "#ra-glow"], { opacity: 1 }, on + 0.3);
          tl.fromTo("#ra-needle", { x: 0 }, { x: 180, duration: 0.6, ease: "power1.inOut", immediateRender: false }, on + 0.1);
          for (let t = on + 0.7; t < t0 + vo("radio", 2); t += 0.11) tl.set("#ra-needle", { x: 180 + ((t * 977) % 9) - 4 }, t);
          const n0 = caps("radio", [0]).length, n1 = caps("radio", [1]).length;
          document.querySelectorAll(`#${id} .capbox`).forEach((c, i) => { if (i >= n0 && i < n0 + n1) c.classList.add("radio"); });
          Fx.punch(tl, `#${id} .stage`, t0 + F("radio", 1, 2), 1.08, 0.5); Fx.glitch(tl, `#${id}`, t0 + F("radio", 1, 2), 0.2, 10, 71); red(tl, t0 + F("radio", 1, 2), 0.5, 0.6);
          Fx.heart(tl, t0 + vo("radio", 1), vo("radio", 2) - vo("radio", 1), 0.5, 0.5);
        },
      }, {
        set: "classroom", setOpts: { id: "rb", night: true, lampX: 400, lampY: 1100 }, dark: 0.6, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(700, 1100, 1.0, 540, 950), drift: { s: 0.03 } }, { t: vo("radio", 3) - vo("radio", 2) + 0.05, ...fr(1000, 1150, 1.2, 540, 1000), drift: { s: 0.03 } }] },
        actors: [HO(500, 1500, 0.9, [{ t: 0, mode: "sitChair", eyes: "wide", mouth: "o" }, { t: 0.3, mode: "point", eyes: "wide", mouth: "o" }]), MA(1000, 1500, 0.9, [{ t: 0, mode: "sit", eyes: "normal", mouth: "frown" }], { flip: true }),
          PH(1260, 1500, 0.9, [{ t: 0, mode: "sit", eyes: "normal", mouth: "flat" }], { flip: true }), PU(760, 1500, 0.58, [{ t: 0, mode: "sleepSit", eyes: "closed", mouth: "flat" }]), PI(260, 1500, 0.9, [{ t: 0, mode: "lookUp", eyes: "wide", mouth: "o" }])],
        bubbles: [bub("radio", 2, 60, 520, 400, { end: vo("radio", 3) - vo("radio", 2) }), bub("radio", 3, 420, 520, 900)].map((b, i) => ({ ...b, t: i ? vo("radio", 3) - vo("radio", 2) + 0.05 : 0.05 })),
        ui: [{ type: "counter", t: 0.05, end: D("radio") - (vo("radio", 2) - 0.1) - 0.05, label: "วิทยุนับ · เหลือ", icon: "radio", unit: "วัน", keys: [{ t: 0, v: 96 }], top: 150, right: true }, { type: "counter", t: 0.05, end: D("radio") - (vo("radio", 2) - 0.1) - 0.05, label: "คนในค่าย", icon: "people", unit: "คน", max: 6, keys: [{ t: 0, v: 6 }], alarm: F("radio", 2, 1) - (vo("radio", 2) - 0.1), top: 150 }],
        fx(tl, id, t0) { const X = t0 + F("radio", 2, 1) - (vo("radio", 2) - 0.1); tl.set("#rb-dialw", { opacity: 1 }, t0); tl.to("#rb-dialw", { opacity: 0, duration: 0.1 }, t0 + 0.6); Fx.punch(tl, `#${id} .stage`, X, 1.08, 0.5); Fx.glitch(tl, `#${id}`, X, 0.3, 14, 72); red(tl, X, 0.7, 0.7); Fx.heart(tl, t0, D("radio") - (vo("radio", 2) - 0.1), 0.45, 0.6); },
      });

      // ---------- 22. the drawing of day 102: six of them — and ภู at the fence, talking to someone outside ----------
      add("drawing", {
        set: "drawing3", setOpts: { id: "dw" }, dark: 0.2,
        cam: { keys: [{ t: 0, ...fr(540, 1000, 1.0, 540, 960), drift: { s: 0.02 } }, { t: F("drawing", 0, 1) - 0.05, glide: 0.5, ...fr(440, 1400, 1.4, 540, 960), drift: { s: 0.02 } }, { t: F("drawing", 1, 0) - 0.05, glide: 0.5, ...fr(760, 1400, 1.6, 540, 960), drift: { s: 0.03 } }] },
        captions: caps("drawing"),
        fx(tl, id, t0) { Fx.heart(tl, t0 + F("drawing", 0, 1), D("drawing") - F("drawing", 0, 1), 0.6, 0.4); Fx.punch(tl, `#${id} .stage`, t0 + F("drawing", 1, 2), 1.06, 0.4); Fx.glitch(tl, `#${id}`, t0 + F("drawing", 1, 2), 0.2, 10, 81); red(tl, t0 + F("drawing", 1, 2), 0.5, 0.6); },
      });

      // ---------- 23. 2 a.m.: he stands at the fence, an arm through the bars, talking to the dark ----------
      add("night", {
        set: "schoolYard", setOpts: { id: "ni", time: "night", lampX: -300, gate: 0 }, dark: 0.55, blur: { far: 3, mid: 1 },
        cam: { keys: [{ t: 0, ...fr(560, 1100, 0.72, 540, 950), drift: { s: 0.02 } }, { t: D("night") - 0.1, glide: D("night") - 0.6, ...fr(900, 1200, 1.3, 540, 1050), drift: { s: 0.03 } }] },
        actors: [PH(840, 1500, 0.9, [{ t: 0, mode: "talkOut", eyes: "normal", mouth: "flat" }])],
        captions: caps("night"),
        fx(tl, id, t0, L) { behind(L, tl, "ni-dark", "ha2", 1260, 1180, 0.82, true, t0, D("night"), [{ t: 0, mode: "still", eyes: "dead", mouth: "flat", opts: { period: 14 } }]); tl.set("#ni-dark", { opacity: 0.35 }, t0); Fx.punch(tl, `#${id} .stage`, t0 + F("night", 0, 2), 1.05, 0.4); red(tl, t0 + F("night", 0, 2), 0.4, 0.6); Fx.heart(tl, t0, D("night"), 0.5, 0.5); },
      });

      // ---------- 24. the knife left on the road — is not there any more ----------
      add("knife2", {
        set: "gateClose", setOpts: { id: "k2", time: "night", bolt: 0 }, dark: 0.35, blur: { far: 4 },
        cam: { keys: [{ t: 0, ...fr(420, 1250, 1.2, 540, 1100), drift: { s: 0.03 } }, { t: F("knife2", 0, 1) - 0.05, ...fr(400, 1280, 1.45, 540, 1100), drift: { s: 0.05 } }] },
        shake: (t) => (t > F("knife2", 0, 1) && t < F("knife2", 0, 1) + 0.3 ? 10 * Math.sin(t * 23) : 0),
        captions: caps("knife2"),
        ui: [{ type: "callback", t: F("knife2", 0, 1) + 0.3, end: D("knife2") - 0.05, label: "สมุดบัญชีเจ๊หงส์", text: "อาวุธ <em>0</em> · มีดหาย", top: 1120 }],
        extra(L) { put(L.set, `<g id="k2-knife" transform="translate(330,1300) rotate(-8)">${Fence.KNIFE("", 1.1).replace(/#cfd4d8/g, "#eef2f4")}</g><g id="k2-ghost" opacity="0" transform="translate(330,1300) rotate(-8)"><path d="M-150,-26h150l330,0q90,0 130,26l-80,30H-150z" fill="none" stroke="#f4ecd8" stroke-width="6" stroke-dasharray="18 12" transform="scale(1.1)"/></g>`); put(L.glow, `<circle cx="330" cy="1300" r="520" fill="url(#fLamp)" opacity=".9"/><circle cx="330" cy="1300" r="200" fill="#dfe8f0" opacity=".12"/>`); },
        fx(tl, id, t0) { const X = t0 + F("knife2", 0, 1); tl.fromTo("#flashw", { opacity: 0.5 }, { opacity: 0, duration: 0.15, immediateRender: false }, X); tl.set("#k2-knife", { opacity: 0 }, X + 0.05); tl.set("#k2-ghost", { opacity: 0.8 }, X + 0.05); Fx.punch(tl, `#${id} .stage`, X, 1.08, 0.5); Fx.glitch(tl, `#${id}`, X, 0.3, 14, 91); red(tl, X, 0.7, 0.7); Fx.heart(tl, t0, D("knife2"), 0.42, 0.7); },
      });

      // ---------- 25. trust him? (pulled to "ไว้ใจ…") — "…เขารู้ชื่อปั้น" ----------
      add("choice", {
        set: "schoolYard", setOpts: { id: "cho", time: "night", lampX: -300, gate: 0 }, dark: 0.55, blur: { far: 3 },
        cam: { keys: [{ t: 0, ...fr(760, 1150, 1.0, 540, 1000), drift: { s: 0.02 } }, { t: 1.0, glide: 1.6, ...fr(860, 1200, 1.6, 540, 1050), r: 2, drift: { s: 0.03, r: 0.8 } }] },
        shake: (t) => shakeH(t) * 2,
        actors: [PH(840, 1500, 0.9, [{ t: 0, mode: "talkOut", eyes: "normal", mouth: "flat" }, { t: 1.8, mode: "idle", eyes: "normal", mouth: "flat" }], { flip: false })],
        ui: [{ type: "choice", t: 0.05, q: "ไว้ใจภูมั้ย?", a: "ไว้ใจ", b: "ไม่ไว้ใจ", secs: 3, top: 300, possessed: { at: 1.0, side: "a", glitch: "ไว้ใจ…", who: "…เขารู้ชื่อปั้น" } }],
        fx(tl, id, t0, L) {
          behind(L, tl, "cho-dark", "ha2", 1260, 1180, 0.82, true, t0, D("choice"), [{ t: 0, mode: "still", eyes: "dead", mouth: "flat", opts: { period: 14 } }]); tl.set("#cho-dark", { opacity: 0.35 }, t0);
          tl.set(`#${id}-a0`, { attr: { transform: "translate(840,1500) scale(-0.9,0.9)" } }, t0 + 1.8);   // he turns to the camera
          Fx.heart(tl, t0, D("choice"), 0.38, 0.85); Fx.tunnel(tl, t0, t0 + D("choice") + 0.5, 0.75);
          Fx.glitch(tl, `#${id}`, t0 + 1.0, 0.3, 12, 64); Fx.glitch(tl, `#${id}`, t0 + D("choice") - 0.6, 0.4, 18, 65);
          tl.set("#black", { opacity: 1 }, t0 + D("choice") - 0.2);
        },
      });

      // ---------- 26. end card: the ledger — tomorrow there are no weapons at all ----------
      add("next", {
        set: "classroom", setOpts: { id: "nx", night: true, lampX: 540, lampY: 900 }, dark: 0.75, blur: { far: 6, set: 6 },
        cam: { keys: [{ t: 0, ...fr(540, 1000, 1.0, 540, 960), drift: { s: 0.03 } }] },
        ui: [{ type: "nextCard", t: 0.3, big: "ตอนที่ 4", tag: "รั้วล้ม… เสียงเด็กร้องนอกรั้ว", top: 150 }, { type: "ledger", t: 0.6, day: "เหลือ 96 วัน", rows: [["วิทยุนับถอยหลัง", "97 → 96"], ["น้ำในแท็งก์", "5 → 4 ขีด"], ["อาวุธ (มีดครัว)", "1 → 0", "red"], ["แผลลุงหมาน", "เช็กทุกเช้า"], ["คน", "6", "red"]], six: "6 = 6", next: "ไม้กวาด · เทป · ท่อเหล็ก", cta: "กดติดตาม · <em>อ่านหน้าถัดไป</em> ตอนที่ 4", top: 560 }],
        fx(tl, id, t0) {
          tl.set("#black", { opacity: 0 }, t0 + 0.3);
          tl.set(`#${id} .stage`, { opacity: 0.3 }, t0 + 0.3); tl.set(`#${id} .stage`, { opacity: 1 }, t0 + 0.45);
          Fx.glitch(tl, `#${id}`, t0 + 1.9, 0.12, 10, 91);
          Fx.heart(tl, t0 + 1.2, D("next") - 1.2, 0.7, 0.35);
        },
      });

      // ---------- the look: depth, haze, light sources per shot ----------
      const MORN = (L) => { Fence.light(L, 900, 300, 900, "#ffe0b0", 0.4); Fence.haze(L, 1120, 460, "#e8e2d0", 0.35); Fence.depth(L, "grass"); };
      const DAY = (L) => { Fence.light(L, 760, 300, 900, "#ffe6b0", 0.3); Fence.haze(L, 1120, 460, "#dfe8ea", 0.3); Fence.depth(L, "grass"); };
      const DUSK = (x) => (L) => { Fence.light(L, x, 1000, 760, "#ff9a40", 0.55); Fence.haze(L, 1150, 420, "#ffb070", 0.28); Fence.depth(L, "grass"); };
      const NIGHTYARD = (L) => { Fence.light(L, 760, 340, 520, "#9fb8d8", 0.28); Fence.haze(L, 1150, 400, "#5a6f90", 0.3); Fence.depth(L, "grass", { col: "#04060a" }); };
      const LAMP = (x, y) => (L) => { Fence.light(L, x, y - 80, 420, "#ffd58a", 0.55, "lampf"); Fence.cone(L, x, y - 40, 700, 800, "#ffd58a", 0.3); Fence.depth(L, "desk", { op: 0.85 }); };
      const ROOMDAY = (L) => { Fence.light(L, 300, 300, 800, "#fff2c0", 0.35); Fence.depth(L, "desk", { op: 0.8 }); };
      const BARS = (L) => { Fence.haze(L, 1120, 460, "#e8e2d0", 0.3); Fence.depth(L, "bars", { op: 0.75 }); };
      const LOOK = {
        hook: (L) => { Fence.light(L, 300, 300, 800, "#ffe0b0", 0.35); BARS(L); },
        chapter: (L) => { MORN(L); Fence.depth(L, "branch", { op: 0.8 }); },
        rule: MORN, gate: MORN, plea: (L) => { MORN(L); Fence.depth(L, "post", { x: 1000, w: 260, op: 0.8 }); },
        search: (L) => { Fence.light(L, 300, 300, 800, "#ffe0b0", 0.3); BARS(L); }, knife: (L) => { Fence.light(L, 300, 300, 800, "#ffe0b0", 0.3); BARS(L); },
        wound: (L) => { Fence.light(L, 200, 200, 900, "#ffe0b0", 0.3); }, wash: (L) => { Fence.light(L, 200, 200, 900, "#fff2c0", 0.3); },
        "open#0": MORN, "open#1": MORN, ledger: DAY,
        "blade#0": (L) => { DAY(L); Fence.depth(L, "post", { x: 1100, w: 240, op: 0.8 }); }, "blade#1": (L) => { Fence.light(L, 300, 300, 800, "#fff2c0", 0.25); BARS(L); },
        cut: DAY, press: DAY, tetanus: ROOMDAY, needle: ROOMDAY, signs: ROOMDAY, real: DAY,
        trust: DUSK(900), name: DUSK(900),
        sig: NIGHTYARD,
        "radio#0": (L) => { Fence.depth(L, "post", { x: -200, w: 300, op: 0.85 }); }, "radio#1": LAMP(400, 1100),
        drawing: (L) => { Fence.light(L, 540, 320, 640, "#ffd58a", 0.4, "lampf"); Fence.cone(L, 540, 260, 1100, 1300, "#ffd58a", 0.22); },
        night: (L) => { NIGHTYARD(L); Fence.light(L, -300, 920, 420, "#ffd58a", 0.5, "lampf"); },
        knife2: (L) => { Fence.light(L, 330, 1300, 500, "#9fb8d8", 0.18); Fence.depth(L, "bars", { op: 0.8 }); },
        choice: (L) => { NIGHTYARD(L); Fence.depth(L, "bars", { op: 0.75 }); },
        next: LAMP(540, 900),
      };
      const seen = {}, depth0 = Fence.depth;
      shots.forEach((sh) => { const n = seen[sh.key] = (seen[sh.key] ?? -1) + 1, look = LOOK[`${sh.key}#${n}`] || (n === 0 ? LOOK[sh.key] : null), e = sh.extra;
        if (look) sh.extra = (L, id) => { if (e) e(L, id); const k0 = (sh.cam && sh.cam.keys && sh.cam.keys[0]) || { x: 0, y: 0, s: 1 }; Fence.depth = (L2, kind, o = {}) => depth0(L2, kind, { cam: k0, ...o }); look(L, id); Fence.depth = depth0; }; });
      shots.forEach((sh) => { const f = sh.fx; sh.fx = (tl, id, t0, L) => { if (f) f(tl, id, t0, L); Zom.zlife(tl, `#${id}`, t0, sh.dur); Fence.flife(tl, `#${id}`, t0, sh.dur); }; });
