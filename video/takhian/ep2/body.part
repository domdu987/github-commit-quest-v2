        { ...SC("sce", { horizon: 1000, tree: { x: 170, y: 1100, s: 0.6 }, bund: 300, flash: 0.35, rain: 0.8 }), grade: { top: "#6a6a6a", bottom: "#1a1a1a", op: 0.25 },
          cam: push2("scars", fr(560, 1250, 1.0, 540, 1000), fr(180, 700, 2.4, 540, 900)),
