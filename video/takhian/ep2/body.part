      // 28 · the shrine photo: zoom into the young man standing under this same tree (its cloths behind him)
      ADD("photo", { set: "tkShrine", setOpts: { id: "pc", noCloth: 1 }, dark: 0.02, light: { from: "right", rim: "#ffd890", rimOp: 0.6, shade: "#1a0e08", shadeOp: 0.3, cast: false, vol: false }, grade: { top: "#ffd090", bottom: "#3a1a0a", op: 0.18 },
        cam: push2("photo", fr(540, 1040, 1.0, 540, 960), fr(480, 1080, 1.5, 540, 960)), captions: caps("photo"), fx: (tl, id, t0, L) => put(L.set, Tk.photo(540, 1040, 1.6)) });
      // 29 · ยาย: the photo held close, then her face, eyes red (no flashback)
      SPLITN("grand", [2.0], [
