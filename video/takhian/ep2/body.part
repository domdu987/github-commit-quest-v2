      // ---------- ต้นตะเคียนกลางนา EP.2 อย่ากลัวจับตัวเขา (v2: film look + gate review fixes) ----------
      // ลุง lies head-left on the bund for the whole episode (one rig). The CPR never stops once it starts: ยาย's drag, the argument, the tiredness
      // and the swap all happen while someone keeps pressing.
      const CAMS = (k, z0 = 1.8, z1 = 1.9) => push2(k, fr(560, 1720, z0, 540, 1250), fr(560, 1720, z1, 540, 1250));
      const BUND = (id, o = {}) => SC(id, { horizon: 980, rain: 0.4, fgRice: false, reflect: false, dof: 1, tree: { x: 1020, y: 1060, s: 0.38, burnt: 0.8 }, ...o });
      const LUNGB = (mode = "pressed", eyes = "closed", mouth = "flat", o = {}) => LUNG(58, 1860, 1.15, mode, eyes, mouth, o);
      const PLOYCPR = (mode = "kCPR", o = {}) => P("ploy", 470, 1805, 0.95, mode, o.eyes || "normal", o.mouth || "frown", o);
      const ARMS_P = (L, tl, t0, dur) => CPRARMS(L, tl, t0, dur, [527, 1690], [412, 1690], [482, 1760]);
      const ARMS_T = (L, tl, t0, dur) => CPRARMS(L, tl, t0, dur, [520, 1716], [430, 1716], [482, 1764], 0.8, ["#3a9a5a", "#2a7a4a"], SK.ton);
      const BEAT = (L, tl, t0, dur, x = 482, y = 1764) => { const gid = `bt${Math.round(t0 * 100)}`; put(L.glow, `<circle id="${gid}" cx="${x}" cy="${y}" r="40" fill="none" stroke="#fff2b0" stroke-width="6"/>`); const n = Math.floor(dur / PER); for (let i = 0; i < n; i++) tl.fromTo(`#${gid}`, { attr: { r: 30 }, opacity: 0.8 }, { attr: { r: 110 }, opacity: 0, duration: PER * 0.9, ease: "power1.out", immediateRender: false }, t0 + i * PER); };
      // 1 · from EP.1's last frame: ลุง still on the bund by the tree; scorched ground smoking (not him); the family frozen
      ADD("hook", { ...SC("h", { horizon: 1050, tree: { x: 640, y: 1400, s: 1.05, burnt: 1 }, flash: 0.25, rain: 0.6, reflect: false }),
        cam: push2("hook", fr(540, 1300, 1.0, 540, 1000), fr(520, 1420, 1.12, 540, 1000)), shake: rumble(1),
        actors: [LUNG(90, 1720, 0.85), P("ploy", 870, 1700, 1.05, "idle", "wide", "scream", { flip: true }), P("ton", 1010, 1660, 0.78, "idle", "wide", "o", { flip: true })],
        captions: caps("hook"), fx: (tl, id, t0, L) => { put(L.set, Tk.scorch(640, 1430, 1, 1)); FLICK(tl, t0 + 0.3, 0.3); } });
      // 2 · the command: พลอย kneels at his shoulder, her hand hovers over him (knees on the ground, fully in frame)
      ADD("cmd", { ...BUND("c"), cam: CAMS("cmd", 1.5, 1.62),
        actors: [P("ploy", 780, 1800, 0.95, "kReach", "worry", "frown", { flip: true }), LUNGB("supine")], captions: caps("cmd") });
      // 3 · พลอย, close, shaking
      ADD("fear", { ...BUND("f"), cam: { keys: [{ t: 0, ...fr(760, 1499, 2.1, 540, 760) }] }, shake: (t) => ({ x: 2 * Math.sin(t * 40), y: 0, r: 0 }),
        actors: [P("ploy", 780, 1800, 0.95, "kT", "worry", "frown", { flip: true, talk: TALK("fear", 0, "o") }), LUNGB("supine")], captions: caps("fear") });
      // 4 · ต้น's small hand lands on ลุง's arm: nothing happens (knees on the ground); a slow push, then his face reacts
      SPLITN("safe", [2.0], [
        { ...BUND("sf"), cam: push2("safe", fr(560, 1720, 1.7, 540, 1250), fr(560, 1720, 1.85, 540, 1250)),
          actors: [P("ton", 560, 1830, 0.78, "kReach", "wide", "o", { opts: { by: 130 } }), LUNGB("supine")] },
        { ...BUND("sf2"), cam: push2("safe", fr(560, 1560, 2.4, 540, 1000), fr(540, 1520, 2.75, 540, 1000)), actors: [P("ton", 560, 1830, 0.78, "kT", "normal", "smile", { opts: { by: 130 }, then: [{ t: 0.9, mode: "kReach", eyes: "wide", mouth: "o" }, { t: 1.9, mode: "kTap", eyes: "normal", mouth: "smile" }, { t: 2.9, mode: "kT", eyes: "normal", mouth: "smile" }] }), LUNGB("supine")] }]);
      // 5 · ต้น raps rule 2 kneeling at the chest; the bamboo rules drop in (rule 1 ticked, rule 2 lit)
      SPLITN("rap", [1.9], [
        { set: "tkHut", setOpts: { id: "rp0", mood: "storm", dark: 0.9, rain: 0.4 }, dark: 0.3, light: TEAL, grade: GT, cam: push2("rap", fr(540, 960, 1.0, 540, 960), fr(540, 960, 1.04, 540, 960)),
          fx: (tl, id, t0, L) => Tk.board(tl, L.light, t0, 1.9, { active: 1, y: 330 }) },
        { ...BUND("rp"), cam: CAMS("rap", 1.5, 1.6), actors: [P("ton", 560, 1830, 0.78, "kReach", "wide", "frown", { opts: { by: 130 }, talk: [0, 2.2, "scream"], then: [{ t: 1.1, mode: "kTap", eyes: "wide", mouth: "scream" }] }), LUNGB("supine")] }]);
      // 6 · พลอย taps both his shoulders and shouts his name
      ADD("call", { ...BUND("cl"), cam: CAMS("call"), shake: kick(0, 0.6, 4),
        actors: [P("ploy", 420, 1805, 0.95, "kTap", "wide", "scream", { talk: TALK("call", 0, "scream") }), LUNGB("supine")], captions: caps("call") });
      // 7 · no answer → she bends to his chest: it does not rise (side close: her ear over his mouth, eyes on the chest)
      SPLITN("still", [1.4], [
        { ...BUND("sl"), cam: { keys: [{ t: 0, ...fr(240, 1760, 2.8, 540, 1100) }] }, actors: [P("ploy", 420, 1805, 0.95, "kTap", "worry", "frown"), LUNGB("supine", "closed", "flat")] },
        { ...BUND("sl2"), cam: push2("still", fr(270, 1770, 2.6, 540, 1150), fr(270, 1770, 2.8, 540, 1150)), actors: [P("ploy", 420, 1805, 0.95, "kLook", "worry", "frown"), LUNGB("supine", "closed", "flat")],
          fx: (tl, id, t0, L) => put(L.glow, `<path d="M300,1640V1600M330,1640V1600" stroke="#9ad0e0" stroke-width="4" stroke-dasharray="6 6" opacity=".5"/>`) }]);
      // 8 · พลอย on the phone: phone at her ear → insert: the phone in her hand, 1669 on the screen, her thumb on the speaker key
      SPLITN("phone", [1.6], [
        { ...BUND("ph"), cam: CAMS("phone", 1.6, 1.7), actors: [P("ployPhone", 440, 1805, 0.95, "kPhone", "wide", "o", { talk: TALK("phone", 0, "scream") }), LUNGB("supine")] },
        { ...BUND("ph2", { rain: 0.4 }), cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }] },
          fx: (tl, id, t0, L) => { put(L.light, `<g id="ph2p" transform="translate(540,960) rotate(-8)"><rect x="-190" y="-360" width="380" height="720" rx="50" fill="#1e1e24" stroke="#1e1a16" stroke-width="8"/><rect x="-166" y="-320" width="332" height="620" rx="20" fill="#1e5a3e"/>
            <text x="0" y="-150" text-anchor="middle" font-family="sans-serif" font-weight="800" font-size="110" fill="#fff">1669</text><text x="0" y="-80" text-anchor="middle" font-family="sans-serif" font-size="36" fill="#cfe">กำลังโทร…</text>
            <circle cx="-90" cy="130" r="60" fill="#2a3a34"/><path d="M-110,110v40h16l26,22v-84l-26,22Z" fill="#fff"/><circle id="ph2s" cx="-90" cy="130" r="60" fill="#3ad06a" opacity="0"/><circle cx="90" cy="230" r="60" fill="#e83a2a"/>
            <g transform="translate(-40,330)">${handBack(SK.ploy, { curl: [0.6, 0.6, 0.6, 0.6], thumb: 0 }).split(INK).join(RLINE)}</g><g id="ph2t" transform="translate(-170,260) rotate(-40)"><rect x="-18" y="-80" width="36" height="110" rx="18" fill="#e0a880" stroke="#3a2622" stroke-width="3"/></g></g>`);
            tl.fromTo("#ph2t", { x: -30, y: 40 }, { x: 60, y: -110, duration: 0.5, ease: "power2.inOut", immediateRender: false }, t0 + 0.4); tl.fromTo("#ph2s", { opacity: 0 }, { opacity: 0.85, duration: 0.1, immediateRender: false }, t0 + 0.9); } }]);
      // 9 · top-down: the phone on speaker on the grass; her hands go to his chest
      ADD("speak", { set: "tkCPR", setOpts: { id: "sp", phone: 1, rain: 0.5 }, dark: 0, light: TEAL, grade: GT,
        cam: push2("speak", fr(900, 560, 1.6, 540, 700), fr(620, 1050, 0.95, 540, 980)), captions: caps("speak"), fx: (tl, id, t0, L) => TOPARMS(L, tl, t0 + 1.0, D("speak") - 1.0) });
      // 10 · side, medium: arms straight, perpendicular to his body — a thin glowing plumb line from her shoulders to the hands, a right-angle mark
      ADD("hands", { ...BUND("hd"), cam: CAMS("hands", 1.85, 1.95),
        actors: [PLOYCPR(), LUNGB("pressed")], captions: caps("hands"),
        fx: (tl, id, t0, L) => { ARMS_P(L, tl, t0, D("hands")); put(L.glow, `<g id="hdl" opacity="0"><path d="M478,1560V1752" stroke="#fff6c0" stroke-width="4" stroke-dasharray="10 8"/><path d="M478,1730h22v22" stroke="#fff6c0" stroke-width="4" fill="none"/><path d="M200,1772H760" stroke="#fff6c0" stroke-width="3" opacity=".6"/></g>`); tl.fromTo("#hdl", { opacity: 0 }, { opacity: 0.9, duration: 0.3, immediateRender: false }, t0 + F("hands", 0, 2)); } });
      // 11 · side, medium: depth 5–6 cm (a bracket at the chest that closes on every push), the rate pulsing with each push
      ADD("rate", { ...BUND("rt"), cam: CAMS("rate", 1.95, 2.05),
        actors: [PLOYCPR(), LUNGB("pressed")], captions: caps("rate"),
        fx: (tl, id, t0, L) => { ARMS_P(L, tl, t0, D("rate")); BEAT(L, tl, t0 + F("rate", 0, 1), D("rate") - F("rate", 0, 1));
          put(L.glow, `<g id="rtb"><path d="M560,1740h26M560,1770h26M573,1740v30" stroke="#fff6c0" stroke-width="4"/><text x="596" y="1764" font-family="Sriracha" font-size="22" fill="#fff6c0">5–6 ซม.</text></g>`);
          const n = Math.floor(D("rate") / PER); tl.fromTo("#rtb", { scaleY: 1, svgOrigin: "573 1755" }, { scaleY: 0.55, svgOrigin: "573 1755", duration: PER * 0.42, yoyo: true, repeat: n * 2 - 1, ease: "sine.out", immediateRender: false }, t0); } });
      // 12 · ต้น counts beside her, on the beat
      ADD("count", { ...BUND("cn"), cam: CAMS("count", 1.4, 1.45),
        actors: [P("ton", 820, 1830, 0.78, "kT", "wide", "scream", { flip: true, opts: { by: 130 }, talk: TALK("count", 0, "scream") }), PLOYCPR(), LUNGB("pressed")], captions: caps("count"),
        fx: (tl, id, t0, L) => { ARMS_P(L, tl, t0, D("count")); BEAT(L, tl, t0, D("count")); } });
      // 13 · ยาย takes his ankles to drag him to the tree — พลอย keeps pressing
      ADD("drag", { ...BUND("dr", { horizon: 1000 }), cam: CAMS("drag", 1.25, 1.3),
        actors: [PLOYCPR(), P("yaiHom", 1000, 1830, 0.9, "kReach", "worry", "frown", { flip: true, talk: TALK("drag", 0, "o") }), LUNGB("pressed")], captions: caps("drag"),
        fx: (tl, id, t0, L) => { ARMS_P(L, tl, t0, D("drag")); FLICK(tl, t0 + 0.4, 0.3); } });
      // 14 · พลอย shouts at ยาย without lifting her hands, turning her head to the burnt tree
      ADD("no", { ...BUND("no", { horizon: 1000 }), cam: CAMS("no", 1.35, 1.45), shake: kick(0, 0.5, 5),
        actors: [PLOYCPR("kCPRshout", { eyes: "angry", mouth: "scream", talk: TALK("no", 0, "scream") }), P("yaiHom", 1000, 1830, 0.9, "kT", "wide", "o", { flip: true }), LUNGB("pressed")], captions: caps("no"),
        fx: (tl, id, t0, L) => ARMS_P(L, tl, t0, D("no")) });
      // 15 · keep pressing, hands never lift (side medium, a slow arc)
      ADD("only", { ...BUND("on"), cam: push2("only", fr(520, 1720, 1.75, 540, 1250), fr(600, 1730, 1.9, 540, 1250)),
        actors: [PLOYCPR(), LUNGB("pressed")], captions: caps("only"), fx: (tl, id, t0, L) => { ARMS_P(L, tl, t0, D("only")); BEAT(L, tl, t0, D("only")); } });
      // 16 · พลอย tiring, still pressing: arms trembling, panting
      ADD("tired", { ...BUND("ti"), cam: { keys: [{ t: 0, ...fr(480, 1600, 2.3, 540, 1100) }] },
        actors: [PLOYCPR("kCPRtired", { eyes: "closed", mouth: "o", talk: TALK("tired", 0, "o") }), LUNGB("pressed")], captions: caps("tired"), fx: (tl, id, t0, L) => ARMS_P(L, tl, t0, D("tired")) });
      // 17 · the swap in one beat: ต้น's hands go on as hers come off; she shifts aside, he presses
      ADD("swap", { ...BUND("sw"), cam: CAMS("swap", 1.6, 1.65),
        actors: [P("ploy", 300, 1790, 0.95, "kT", "closed", "o", { moveTo: { x: 240, dur: 0.4 } }), P("ton", 470, 1830, 0.8, "kCPR", "wide", "frown", { opts: { by: 130 }, talk: TALK("swap", 0, "scream") }), LUNGB("pressed")], captions: caps("swap"),
        fx: (tl, id, t0, L) => ARMS_T(L, tl, t0, D("swap")) });
      // 18 · ลุง jolts and draws a huge breath, coughs; ต้น and พลอย in frame
      ADD("gasp", { ...BUND("gp", { rain: 0.3 }), cam: CAMS("gasp", 1.5, 1.6),
        actors: [P("ploy", 250, 1790, 0.95, "kT", "wide", "o"), P("ton", 760, 1830, 0.8, "kT", "wide", "laugh", { flip: true }), LUNGB("jolt", "wide", "o", { then: [{ t: 0.9, mode: "supine", eyes: "normal", mouth: "o" }] })], captions: caps("gasp") });
      // 19 · ลุง, eyes open, a dry smile on his joke; the two relieved above him
      ADD("joke", { ...BUND("jk", { rain: 0.2 }), cam: push2("joke", fr(250, 1790, 2.2, 540, 1000), fr(250, 1790, 2.35, 540, 1000)),
        actors: [P("ploy", 250, 1790, 0.95, "kT", "normal", "laugh"), P("ton", 600, 1830, 0.8, "kT", "normal", "laugh", { flip: true }), LUNGB("supine", "normal", "smile", { talk: TALK("joke", 0, "smile") })], captions: caps("joke") });
      // 20 · the ambulance arrives on the dirt road (Star of Life, 1669), the rain stops, a rainbow
      ADD("clear", { ...CLR("cr", { horizon: 1050, tree: { x: 260, y: 1100, s: 0.5, burnt: 0.6 }, farStorm: 1, farStormX: 1450 }),
        cam: push2("clear", fr(540, 1300, 0.95, 540, 1000), fr(540, 1250, 0.9, 540, 1000)), captions: caps("clear"),
        fx: (tl, id, t0, L) => { put(L.set, `<rect x="-900" y="1300" width="2900" height="160" fill="#8a7a5a"/>` + Tk.pickup(-60, 1420, 0.5, {}) + `<g id="cr-amb">${Tk.ambulance(1500, 1440, 0.55, { lit: 0.6 })}</g>`); tl.fromTo("#cr-amb", { x: 0 }, { x: -700, duration: D("clear") * 0.8, ease: "power2.out", immediateRender: false }, t0); } });
      // 21 · ต้น runs off toward the tree for the buffalo — the buffalo clearly at the foot of the tree
      ADD("buff", { ...CLR("bf", { horizon: 1050, tree: { x: 660, y: 1160, s: 0.6, burnt: 0.6 }, buf: { x: 860, y: 1180, s: 0.42, stake: [780, 1182], flip: 1 }, bund: 520, farStorm: 1, farStormX: 1450 }),
        cam: push2("buff", fr(600, 1300, 1.05, 540, 1000), fr(660, 1230, 1.18, 540, 1000)),
        actors: [P("ton", 520, 1720, 0.75, "run", "normal", "laugh", { flip: true, moveTo: { x: 600, dur: D("buff") }, talk: TALK("buff", 0, "laugh") })], captions: caps("buff") });
      // 22 · far horizon: the black cloud flickers in silence
      ADD("far", { ...CLR("fa", { horizon: 1050, farStorm: 1, farStormX: 700, farBolt: 1, fgRice: false }), cam: push2("far", fr(600, 900, 1.2, 540, 960), fr(600, 900, 1.35, 540, 960)), captions: caps("far") });
      // 23 · ยาย grabs ต้น's stopwatch: counting up from the last thunder, 12:04 → …, a ring toward 30:00
      SPLITN("watch", [1.2], [
        { ...CLR("wa", { horizon: 1050, farStorm: 1 }), cam: { keys: [{ t: 0, ...fr(540, 1400, 1.5, 540, 1050) }] }, actors: [P("yaiHom", 540, 1720, 0.95, "yell", "wide", "scream", { talk: TALK("watch", 0, "scream") })] },
        { ...CLR("wb", { horizon: 1050, fgRice: false }), cam: push2("watch", fr(540, 960, 1.0, 540, 960), fr(540, 960, 1.05, 540, 960)),
          fx: (tl, id, t0, L) => { put(L.glow, `<g id="wbw">${Tk.watch(540, 900, 1.55, { id: "wbw", mm: "12", ss: "04", label: "นับจากฟ้าร้องครั้งสุดท้าย", labelSize: 22, ring: 724 / 1800, sub: "ต้องครบ 30:00" })}</g>`); Tk.watchRun(tl, "wbw", t0, D("watch") - 1.2, 724, { ring: 1 }); tl.fromTo("#wbw", { y: 30 }, { y: 0, duration: 0.3, ease: "back.out(2)", immediateRender: false }, t0); } }]);
      // 24 · rule 3 on the bamboo
      SPLITN("rule3", [1.9], [
        { set: "tkHut", setOpts: { id: "r30", mood: "clear", dark: 0.6 }, dark: 0.25, light: CLEARL, grade: GC, cam: push2("rule3", fr(540, 960, 1.0, 540, 960), fr(540, 960, 1.04, 540, 960)),
          fx: (tl, id, t0, L) => Tk.board(tl, L.light, t0, 1.9, { active: 2, y: 330, flashes: [0.6] }) },
        { ...CLR("r3", { horizon: 1000, tree: { x: 360, y: 1080, s: 0.42, burnt: 0.4 }, farStorm: 1, fgRice: false }), cam: push2("rule3", fr(540, 960, 1.0, 540, 900), fr(540, 960, 1.04, 540, 900)),
          fx: (tl, id, t0, L) => { const c = Tk.cabIn({ id: "r3c" }), by = Tk.backHead("yai", 200, 1470, 1.3, 1), bp = Tk.backHead("ploy", 880, 1490, 1.25, -1);
            put(L.set, `<g transform="translate(0,60)">${c.glass}${c.frame}<g transform="translate(560,560) rotate(-8)"><path d="M0,-90V-20" stroke="#e8e4d8" stroke-width="4"/>${Tk.watch(0, 60, 0.32, { mm: "12", ss: "40" })}</g></g>`); put(L.light, by.g + bp.g + c.seats);
            tl.fromTo("#r3c-keys", { rotation: -4, svgOrigin: "420 1340" }, { rotation: 4, svgOrigin: "420 1340", duration: 0.7, ease: "sine.inOut", yoyo: true, repeat: 6, immediateRender: false }, t0); } }]);
      // 25 · the bolt from the blue on the same tree; ต้น stopped on the bund about 30 m from it, sits down hard (the tree far behind him)
