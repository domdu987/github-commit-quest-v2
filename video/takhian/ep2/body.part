        fx: (tl, id, t0, L) => { STRIKE(tl, L, t0, 0.25, { sil: 0.14, dx: 400, ground: 1, to: [[540, 1120], [880, 1130], [640, 1220]] }); } });
      // 26 · ต้น in the mud, shaking
