      Rig.MODES.fallB = (u, o) => { const k = sm(u / 0.55); return { ...Rig.MODES.idle(u, o), uaF: -120 * (1 - k) + 10 * k, faF: -40, uaB: 110 * (1 - k), faB: 30, thF: -10 * k, shF: 20 * (1 - k), torso: -10 - 10 * k, head: -14, rootR: -88 * k, rootY: -40 * k, rootX: -60 * k }; };
      Rig.MODES.sitHard = (u, o) => { const j = Math.exp(-u * 5) * Math.sin(u * 40); return { ...Rig.MODES.sit(u, o), uaF: -30 + 20 * j, faF: -20, uaB: 50, faB: 30, torso: -18 + 4 * j, head: -10 + 6 * j }; };
      Rig.MODES.jump = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -140, faF: -50, uaB: 130, faB: 60, torso: -10, head: -12, bodyY: -30 * Math.exp(-u * 6) });
      // lying ลุง: one rig for the whole story, head always to screen-left; hx = where his head lies, s = scale
      const LUNG = (hx, y, s, mode = "supine", eyes = "closed", mouth = "flat", o = {}) => P("lungPiak", hx + 760 * s, y, s, mode, eyes, mouth, o);
      // wet look in the rain: clothes ~16% darker, strands of hair stuck to the face, drips from the hair and the hem; ลุง's headband tails and ยาย's sarong hem flap
      const WETHAIR = { ploy: "#1a120e", ployPhone: "#1a120e", ton: "#16100c", yaiHom: "#d8d4cc" };
      const WET = (aid, who, tl, t0, dur) => { const a = document.getElementById(aid); if (!a || !who) return; a.style.filter = "brightness(0.84) saturate(1.08)";
        const hd = document.querySelector(`#${aid}-head > g`), to = document.getElementById(`${aid}-torso`), hc = WETHAIR[who], drop = (k, x, y) => `<circle id="${aid}-wd${k}" cx="${x}" cy="${y}" r="4.5" fill="#d8e8f4" stroke="#1e1a16" stroke-width="1.5" opacity="0"/>`;
        if (hd && hc) hd.insertAdjacentHTML("beforeend", `<g opacity=".92"><path d="M-24,-590q-14,44 -16,92" stroke="${hc}" stroke-width="5.5" fill="none" stroke-linecap="round"/><path d="M4,-592q-10,26 -2,52" stroke="${hc}" stroke-width="4.5" fill="none" stroke-linecap="round"/><path d="M26,-588q14,40 8,88" stroke="${hc}" stroke-width="5" fill="none" stroke-linecap="round"/></g>` + drop(0, 40, -520) + drop(1, -36, -524));
        if (to) to.insertAdjacentHTML("beforeend", drop(2, -30, -296) + drop(3, 34, -300));
        if (who === "lungPiak" && hd) { hd.insertAdjacentHTML("beforeend", `<g id="${aid}-hb"><path d="M56,-562q32,-8 62,2l-5,15q-28,-8 -52,-3Z" fill="#e8e4d8" stroke="#1e1a16" stroke-width="2.2"/><path d="M56,-554q28,4 50,24l-10,9q-20,-18 -40,-21Z" fill="#e8e4d8" stroke="#1e1a16" stroke-width="2.2"/><path d="M70,-556h34" stroke="#c83a2a" stroke-width="4" stroke-dasharray="8 6"/></g>`);
