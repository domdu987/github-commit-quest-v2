      // ---------- ต้นตะเคียนกลางนา: shared lights, poses and helpers (both episodes) ----------
      SK.ploy = ["#e0a880", "#b07a52", "#f2c8a0"]; SK.ton = SK.ton || ["#d39a6e", "#a8704a", "#ecc09a"];
      const ST = { from: "left", rim: "#b8c8ff", rimOp: 0.85, shade: "#0a0e18", shadeOp: 0.4, cast: false, vol: false };
      const FL = { from: "right", rim: "#ffffff", rimOp: 1, shade: "#0a0e18", shadeOp: 0.35, cast: false, vol: false };
      const DAY = { from: "right", rim: "#ffe2a0", rimOp: 0.8, shade: "#3a2a40", shadeOp: 0.25, cast: false, vol: false };
      const GS = { top: "#2a3048", bottom: "#0a0e14", op: 0.16 }, GD = { top: "#ffe0a0", bottom: "#3a5a3a", op: 0.1 }, GW = { top: "#6a6a6a", bottom: "#1a1a1a", op: 0.2 };
      const sm = (x) => { x = Math.max(0, Math.min(1, x)); return x * x * (3 - 2 * x); };
      const PER = 60 / 110, push = (u) => { const ph = (u % PER) / PER; return ph < 0.42 ? Math.sin((ph / 0.42) * Math.PI / 2) : Math.cos(((ph - 0.42) / 0.58) * Math.PI / 2); };
      Rig.MODES.supine = (u, o) => ({ ...Rig.MODES.lie(u, o), torso: 0, uaF: 2, faF: -2, uaB: -2, faB: -2, thF: -2, thB: 2, shF: 4, shB: 2, head: 4 });
      Rig.MODES.pressed = (u, o) => ({ ...Rig.MODES.supine(u, o), rootY: -40 + (o.dy ?? 0) + 5 * push(u + (o.ph ?? 0)) });
      Rig.MODES.jolt = (u, o) => ({ ...Rig.MODES.supine(u, o), rootY: -40 + (o.dy ?? 0) - 34 * Math.exp(-u * 9) * Math.abs(Math.sin(u * 30)), uaF: -20 * Math.exp(-u * 8), uaB: 20 * Math.exp(-u * 8) });
      Rig.MODES.kneel = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: 14, faF: -40, uaB: -14, faB: 40, torso: 0, head: 6 });
      Rig.MODES.kneelPhone = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: -30, faF: -150, uaB: 4, faB: -12, torso: 4, head: 6, bodyY: o.by ?? 150 });
      Rig.MODES.kneelReach = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: -60 + 8 * Math.sin(u * 3), faF: -6, uaB: 6, faB: -10, torso: 10, head: 10, bodyY: o.by ?? 150 });
      Rig.MODES.cprF = (u, o) => { const k = push(u + (o.ph ?? 0)); return { ...Rig.MODES.crouch(u, o), uaF: -6, faF: 0, uaB: 6, faB: 0, torso: 14 + 4 * k, head: 20 + 3 * k, bodyY: (o.by ?? 190) + 14 * k }; };
      // the right reaction in an open field: knees bent low, the head tucked, one forearm across the face, the other hand over the head, shaking
      Rig.MODES.cower = (u, o) => ({ ...Rig.MODES.idle(u, o), thF: -48, shF: 78, thB: -30, shB: 70, bodyY: 92, torso: 10 + 1.5 * Math.sin(u * 40), head: 14, uaF: -96 + 3 * Math.sin(u * 37), faF: -118, uaB: -128, faB: -84 });
      Rig.MODES.flinch = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -150 + 4 * Math.sin(u * 30), faF: -60, uaB: 140, faB: 70, torso: -8, head: -10 });
      Rig.MODES.pant = (u, o) => { const b = Math.sin(u * 8); return { ...Rig.MODES.idle(u, o), uaF: 20, faF: -20, uaB: -20, faB: 20, torso: 16 + 3 * b, head: 8 + 3 * b, bodyY: 10 + 3 * b }; };
      Rig.MODES.grab = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -80, faF: -4, uaB: 10, faB: -10, torso: 8, head: 4 });
      Rig.MODES.drag = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: -40, faF: -6, uaB: -34, faB: -8, torso: -14, head: -6, bodyY: o.by ?? 140 });
      Rig.MODES.sitDown = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: -40 + 10 * Math.sin(u * 30) * Math.exp(-u * 3), faF: -30, uaB: 40, faB: 30, torso: -14, head: -6, bodyY: o.by ?? 260 });
      Rig.MODES.yell = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -100, faF: -10, uaB: 8, faB: -20, torso: -4, head: -8 + 2 * Math.sin(u * 14) });
      const A = (who, x, y, s, track, extra = {}) => { if (extra.talk) track.talk = Array.isArray(extra.talk[0]) ? extra.talk : [extra.talk]; return { who, x, y, s, track, blinks: [0.9, 2.7, 4.1], ...extra }; };
      const TALK = (k, i = 0, m = "o") => [vo(k, i), voEnd(k, i), m];
      const P = (who, x, y, s, mode, eyes = "normal", mouth = "flat", o = {}) => A(who, x, y, s, [{ t: 0, mode, eyes, mouth, opts: o.opts || {} }, ...(o.then || [])], o);
      const STORM = (id, o = {}) => ({ set: "tkField", setOpts: { id, mood: "storm", dark: 0.8, rain: 0.8, ...o }, dark: 0.04, light: ST, grade: GS });
      const HOLD = (a) => ({ keys: [{ t: 0, ...a }, { t: 4, glide: 4, ...a, s: a.s * 1.07 }] });   // a "static" framing still creeps in
      // checklist 6 (3 พ.ย.): no shot stands still — every push is at least 7 % over the shot and drifts sideways a little if it doesn't already
      const push2 = (k, a, b) => { const r = b.s / a.s, bb = { ...b }; if (Math.abs(r - 1) < 0.07) { const s2 = a.s * (r >= 1 ? 1.08 : 0.93); bb.x = b.x + (b.x === a.x ? 18 / s2 : 0); bb.s = s2; } return { keys: [{ t: 0, ...a }, { t: D(k), glide: D(k), ...bb }] }; };
      const rumble = (amp = 2) => (t) => ({ x: amp * Math.sin(t * 23) + amp * 0.5 * Math.sin(t * 61), y: amp * 0.8 * Math.sin(t * 31), r: 0.1 * Math.sin(t * 7) });
      const kick = (a, b, amp) => (t) => (t >= a && t < b ? { x: amp * Math.sin(t * 61) * (1 - (t - a) / (b - a)), y: amp * 0.8 * Math.sin(t * 47) * (1 - (t - a) / (b - a)), r: 0 } : 0);
      // a strike on the tree in this shot: the bolt group (L.glow) hidden until t, then the flash / silhouette / relight; the bolt fades to an afterglow
      // StormFX (lane C): every storm shot gets layered rain + wind + its far/in-cloud lightning; STRIKE = the bolt onto this shot's tree
      let CUR = {};
      // V1b (owner 2 พ.ย.: "ปวดตามาก ฝนมันเยอะไป"): lightning at most once per 10 s, never a white screen. The story strikes are kept
      // (their shots are listed here); an ambient flash/far bolt is dropped when it falls within 10 s of any other bolt, and a strike
      // within 10 s of the previous strike keeps its bolt but loses its sky flash and silhouette beat
      const STRIKE_KEYS = ['cmd', 'why', 'sci2', 'wflat', 'crouch', 'strike'], STRIKE_T = STRIKE_KEYS.filter((k) => SH[k]).map((k) => SH[k].start), BOLTS = [];
      const boltOK = (t) => !BOLTS.some((b) => Math.abs(b - t) < 10) && !STRIKE_T.some((b) => Math.abs(b - t) < 10);
      const STORMFX = (spec, tl, t0, L) => { const so = spec.setOpts || {}; CUR = { tree: so.tree, hz: so.horizon ?? 1000, ground: so._ground, rain: null };
        if (spec.set !== "tkScape" || so.mood !== "storm") return; const dur = spec._dur || 4, hz = CUR.hz, rk = so._rain ?? 0.8;
        // V1b: rain only where the storm/strike is the point of the shot (≈80 thin lines behind the actors); dialogue and knowledge
        // shots keep a faint far rain (≈30) — the downpour reads from the far veils, the ripples, the wet clothes and the sound
        const hard = !!(so._strike || so._dist || so._flash > 0.3);
        if (rk > 0) CUR.rain = StormFX.rain(L, tl, t0, dur, { wind: 0.22, horizon: hz, density: 1, lines: hard ? 80 : 30, period: hard ? 1.15 : 1.4, seed: 101 + (t0 * 10 | 0), ripples: [{ x: -400, y: hz + 40, w: 1900, h: 300, n: Math.round(28 * rk), r: 12, layer: "mid" }] });
        StormFX.wind(L, tl, t0, dur, { leaves: so._leaves ?? Math.round(2 + 3 * rk), dir: -1, seed: 202 + (t0 * 10 | 0) });
        if (so._dist && boltOK(t0 + (so._distAt ?? 0.45)) && BOLTS.push(t0 + (so._distAt ?? 0.45))) StormFX.bolt(L, tl, t0 + (so._distAt ?? 0.45), { x0: so._dist[0], y0: hz - 560, x1: so._dist[1], y1: hz - 8, seed: 41, w: 0.32, layer: "sky", flash: 0.28, cx: so._dist[0], cy: hz - 600, cloudR: 0.55, leader: 0.08, lit: CUR.rain });
        else if (so._flash > 0 && !so._strike && boltOK(t0 + (so._flashAt ?? 0.5)) && BOLTS.push(t0 + (so._flashAt ?? 0.5))) { const fx0 = so.flashX ?? 760; StormFX.bolt(L, tl, t0 + (so._flashAt ?? 0.5), { x0: fx0 - 260, y0: hz - 760, x1: fx0 + 220, y1: hz - 600, seed: 53, w: 0.28, layer: "sky", flash: Math.min(0.4, so._flash * 0.6), cx: fx0, cy: hz - 680, cloudR: 0.7, leader: 0.1, depth: 2, lit: CUR.rain }); } };
      const STRIKE = (tl, L, t0, at, o = {}) => { const T = o.tree || CUR.tree, s = T.s || 1, top = T.y - 1600 * s, lead = 0.14, tt = t0 + at;
        if (BOLTS.some((b) => tt - b < 10 && tt - b > -0.5)) o = { ...o, flash: 0, sil: 0 }; BOLTS.push(tt);
        const b = StormFX.bolt(L, tl, t0 + at - lead, { x0: T.x + (o.dx ?? 280) * s, y0: top - 1500, x1: T.x + 10 * s, y1: top, seed: o.seed ?? 7, w: Math.max(0.55, 1.25 * s), flash: o.flash ?? 1, sil: o.sil ?? 0.12, cx: T.x + 160 * s, cy: top - 380, leader: lead, lit: CUR.rain });
        StormFX.strikeTree(L, tl, b.tR, { x: T.x, y: T.y, s, seed: o.treeSeed ?? 19, side: o.side ?? 1, dur: o.dur ?? 6, branch: o.branch ?? true });
        const g = o.ground ?? CUR.ground; if (g) StormFX.ground(L, tl, b.tR + 0.03, { x: T.x, y: T.y + 10 * s, s: Math.max(0.45, s), to: o.to || [[T.x - 560 * s * g, T.y + 170 * s], [T.x + 520 * s * g, T.y + 250 * s], [T.x - 140 * s, T.y + 440 * s * g]] });
        return b; };
      // a trace of นางตะเคียน on this shot's tree (checklist 5): kind "eyes" (in the knot-hollow) or "hair" (under the crown), shown at t for dur
      const TRACE = (tl, L, t, kind, dur = 0.5, T = CUR.tree) => { if (!T) return; const gid = `tr${kind}${Math.round(t * 100)}`, s = T.s || 1;
        put(L.set, `<g id="${gid}" opacity="0" transform="translate(${T.x},${T.y}) scale(${s})">${kind === "hair" ? Tk.traceHair() : Tk.traceEyes()}</g>`);
        tl.set(`#${gid}`, { opacity: 1 }, t); tl.to(`#${gid}`, { opacity: 0, duration: kind === "hair" ? 0.08 : 0.3 }, t + dur); };
      // a side flash: the current jumping from the trunk into the people beside it, synced to a STRIKE handle
      const SIDE = (L, tl, b, x, y, pts) => pts.forEach(([px, py], k) => StormFX.bolt(L, tl, b.tR - 0.03 + 0.02 * k, { x0: x, y0: y, x1: px, y1: py, seed: 60 + k, w: 0.42, flash: 0, cloud: false, leader: 0.03, depth: 1 }));
      const FLICK = (tl, t, op = 0.35) => { tl.set("#flashw", { opacity: op }, t); tl.to("#flashw", { opacity: 0, duration: 0.4, ease: "power2.out" }, t + 0.03); };   // V1b: one soft pulse
      // the rescuer's forearms and stacked real hands over the patient's chest (side view; the rig arms end behind his body)
      const CPRARMS = (L, tl, t0, dur, SF, SB, W, sc = 0.95, sl = ["#e86a8a", "#c04a6a"], skin = SK.ploy) => {
        const gid = `cpa${Math.round(t0 * 100)}${Math.round(W[0])}`;
        put(L.glow, `<g id="${gid}">${armSl(SB, [W[0] + 6, W[1] - 8], 80, 70, 1, skin, sl, { w: [30, 26], hs: 0.85, hand: OPEN })}${armSl(SF, W, 80, 70, -1, skin, sl, { w: [30, 26], hs: 0.85, hand: { curl: [0.5, 0.5, 0.55, 0.6], thumb: 0.3 } })}</g>`);
        const n = Math.floor(dur / PER); if (n > 0) tl.fromTo(`#${gid}`, { y: 0 }, { y: 14 * sc, duration: PER * 0.42, ease: "sine.out", yoyo: true, repeat: n * 2 - 1, immediateRender: false }, t0);
      };
      const TOPARMS = (L, tl, t0, dur, X = 600) => { const gid = `cpt${Math.round(t0 * 100)}`; put(L.set, `<g id="${gid}">${armSl([X - 240, 1020], [X - 30, 1100], 130, 120, 1, SK.ploy, ["#e86a8a", "#c04a6a"], { w: [52, 44], hs: 1.5, hand: OPEN })}${armSl([X - 230, 1180], [X - 15, 1086], 130, 120, -1, SK.ploy, ["#e86a8a", "#c04a6a"], { w: [52, 44], hs: 1.5, hand: OPEN })}</g>`);
        const n = Math.floor(dur / PER); if (n > 0) tl.fromTo(`#${gid}`, { scale: 1, svgOrigin: `${X} 1090` }, { scale: 0.965, svgOrigin: `${X} 1090`, duration: PER * 0.42, yoyo: true, repeat: n * 2 - 1, ease: "sine.out", immediateRender: false }, t0); };
      // a what-if beat: grey grade + vignette, then the tear back at `back` (seconds into the shot)
      const WHATIF = (L, tl, t0, back) => { whatIf(L, tl, t0); if (back != null) tear(L, tl, t0 + back); };
      // the lone dirt sign with the title, staked in the paddy (EP.1 opening, in-world title)
      const titleSign = (x, y, s, top, sub) => `<g transform="translate(${x},${y}) scale(${s}) rotate(-3)"><path d="M-10,0V-260M10,0V-260" stroke="#2a1a0c" stroke-width="22"/><path d="M-10,0V-260M10,0V-260" stroke="#6a4a2a" stroke-width="14"/>
        <rect x="-330" y="-470" width="660" height="230" rx="14" fill="#8a6a3e" stroke="#2a1a0c" stroke-width="7"/>${[0, 1, 2, 3, 4].map((k) => `<path d="M-316,${-450 + k * 44}H316" stroke="#6a4a2a" stroke-width="4" opacity=".6"/>`).join("")}
        <text x="0" y="-360" text-anchor="middle" font-family="Sriracha" font-size="92" fill="#fff6dc" stroke="#2a1a0c" stroke-width="10" paint-order="stroke">${top}</text><text x="0" y="-275" text-anchor="middle" font-family="Sriracha" font-size="54" fill="#ffd84a" stroke="#2a1a0c" stroke-width="8" paint-order="stroke">${sub}</text>
        ${[-260, -100, 120, 280].map((dx, k) => `<path d="M${dx},-240q4,${20 + k * 8} 0,${40 + k * 10}" stroke="#4a3220" stroke-width="6" opacity=".6"/>`).join("")}</g>`;
      // the shrine and the painted cloth, a set of its own (dark wood shelter, candles)
      Sets.tkShrine = (L, o = {}) => {
        put(L.sky, `<rect x="-900" y="-800" width="2900" height="3600" fill="#1a1410"/>`);
        put(L.far, `<rect x="-900" y="-800" width="2900" height="3600" fill="#2a1e16"/>${Array.from({ length: 16 }, (_, k) => `<path d="M${-900 + k * 180},-800V2800" stroke="#1e1610" stroke-width="10"/>`).join("")}`);
        put(L.set, (o.noCloth ? `<rect x="-900" y="1500" width="2900" height="600" fill="#3a2a1e"/><rect x="180" y="1460" width="720" height="40" fill="#5a3a22" stroke="#1e1a16" stroke-width="5"/>` : Tk.cloth(540, o.y ?? 260, o.s ?? 1, { id: o.id, open: o.open }) + `<rect x="-900" y="${(o.y ?? 260) + 1560 * (o.s ?? 1)}" width="2900" height="400" fill="#3a2a1e"/>`));
        put(L.glow, [180, 900].map((cx) => `<g><path d="M${cx},1820V1700" stroke="#f2f0ea" stroke-width="18"/><ellipse cx="${cx}" cy="1684" rx="10" ry="20" fill="#ffd27a"/><circle cx="${cx}" cy="1684" r="220" fill="url(#tkSun)" opacity=".55"/></g>`).join(""));
      };
      // ---------- review fixes: true kneeling (knees and shins on the ground), CPR from the knees, the fall, auto real hands, multi-splits ----------
      SK.yai = ["#b98a64", "#8a5e40", "#d8ac86"]; SK.lung = ["#8a5a3a", "#6a4028", "#a8744e"]; SK.medic = ["#c99068", "#9c6844", "#e2b48c"];
      const SKN = { ploy: SK.ploy, ployPhone: SK.ploy, ton: SK.ton, yaiHom: SK.yai, lungPiak: SK.lung, medic: SK.medic };
      const KNEE = (o) => ({ thF: -12, shF: 98, thB: -6, shB: 96, bodyY: o.by ?? 130 });
      Rig.MODES.kT = (u, o) => ({ ...Rig.MODES.idle(u, o), ...KNEE(o), torso: 6, head: 4, uaF: 10, faF: -20, uaB: -10, faB: -20 });
      Rig.MODES.kReach = (u, o) => ({ ...Rig.MODES.idle(u, o), ...KNEE(o), torso: 16, head: 10, uaF: -62 + 6 * Math.sin(u * 3), faF: -8, uaB: 8, faB: -16 });
      Rig.MODES.kTap = (u, o) => { const k = Math.abs(Math.sin(u * 9)); return { ...Rig.MODES.idle(u, o), ...KNEE(o), torso: 18, head: 12, uaF: -52 - 10 * k, faF: -10, uaB: -48 - 10 * k, faB: -8 }; };
      Rig.MODES.kLook = (u, o) => ({ ...Rig.MODES.idle(u, o), ...KNEE(o), torso: 34, head: 26, uaF: -20, faF: -30, uaB: -16, faB: -24, bodyY: (o.by ?? 130) + 20 });
      Rig.MODES.kPhone = (u, o) => ({ ...Rig.MODES.idle(u, o), ...KNEE(o), torso: 6, head: 6, uaF: -30, faF: -150, uaB: 6, faB: -18 });
      Rig.MODES.kCPR = (u, o) => { const k = push(u + (o.ph ?? 0)); return { ...Rig.MODES.idle(u, o), ...KNEE(o), torso: 22 + 5 * k, head: 18 + 4 * k + (o.turn ?? 0), uaF: -6, faF: 0, uaB: 6, faB: 0, bodyY: (o.by ?? 130) + 12 * k }; };
      Rig.MODES.kCPRtired = (u, o) => { const k = push(u + (o.ph ?? 0)), j = 3 * Math.sin(u * 40); return { ...Rig.MODES.kCPR(u, o), uaF: -6 + j, uaB: 6 - j, torso: 26 + 4 * k + j * 0.4, head: 28 + 4 * Math.sin(u * 7) }; };
