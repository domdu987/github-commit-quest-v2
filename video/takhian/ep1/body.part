        captions: caps("nosafe"), fx: (tl, id, t0) => FLICK(tl, t0 + 1.2, 0.3) });
      // 6 · พลอย / ยาย in the rain
      add("chabu", { ...STORM("cb", { horizon: 900, tree: { x: 980, y: 980, s: 0.3, burnt: 0.4 } }),
