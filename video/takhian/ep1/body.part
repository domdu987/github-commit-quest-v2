          P("ton", 800, 1750, 0.4, "run", "wide", "o", { moveTo: { x: 980, dur: D("spread") } }), P("yaiHom", 420, 1250, 0.44, "run", "worry", "frown", { moveTo: { x: 560, dur: D("spread") } })],
        captions: caps("spread"), fx: (tl, id, t0, L) => put(L.set, [1350, 1550, 1800].map((y, k) => `<path d="M-900,${y}H2000" stroke="#6a5a42" stroke-width="${30 + k * 8}"/>`).join("") + Tk.pickup(980, 1150, 0.3, {})) });
      // 21 · ลุงเปี๊ยก throws himself flat in the mud
      add("flat", { ...STORM("fl", { horizon: 900 }),
        cam: push2("flat", fr(540, 1450, 1.35, 540, 1000), fr(500, 1480, 1.42, 540, 1000)),
        actors: [P("ploy", 820, 1580, 1.0, "point", "wide", "o", { flip: true })],
