      // 9 · the painted cloth: tilt down from the storm band to นางตะเคียน
      add("leg1", { set: "tkShrine", setOpts: { id: "lc", y: 260, s: 1.05 }, dark: 0.02, light: { from: "right", rim: "#ffd890", rimOp: 0.6, shade: "#1a0e08", shadeOp: 0.3, cast: false, vol: false }, grade: { top: "#ffd090", bottom: "#3a1a0a", op: 0.18 },
        cam: push2("leg1", fr(540, 700, 1.25, 540, 760), fr(540, 1120, 1.4, 540, 900)), captions: caps("leg1") });
      // 10 · her arm beckons; the painted villagers under her shade
      add("leg2", { set: "tkShrine", setOpts: { id: "lc2", y: 260, s: 1.05 }, dark: 0.02, light: { from: "right", rim: "#ffd890", rimOp: 0.6, shade: "#1a0e08", shadeOp: 0.3, cast: false, vol: false }, grade: { top: "#ffd090", bottom: "#3a1a0a", op: 0.18 },
        cam: push2("leg2", fr(700, 1300, 1.5, 540, 960), fr(620, 1600, 1.7, 540, 1000)), captions: caps("leg2"),
        fx: (tl, id, t0) => tl.fromTo("#lc2-arm", { rotation: 0, svgOrigin: "40 120" }, { rotation: -14, svgOrigin: "40 120", duration: 0.9, yoyo: true, repeat: 3, ease: "sine.inOut", immediateRender: false }, t0) });
      // 11 · ลุงเปี๊ยก laughs it off
      add("joke", { ...STORM("j", { horizon: 900 }), cam: push2("joke", fr(540, 1300, 1.9, 540, 1000), fr(540, 1300, 2.0, 540, 1000)),
        actors: [P("lungPiak", 540, 1650, 1.0, "laugh", "closed", "laugh", { talk: TALK("joke", 0, "laugh") })], captions: caps("joke") });
      // 12 · low angle up the tree, lightning crawling in the clouds
      add("sci1", { ...STORM("s1", { tree: { x: 540, y: 2050, s: 1.55 }, horizon: 1800, far: false, bund: false, distBolt: [200, 260] }),
        cam: push2("sci1", fr(540, 900, 0.72, 540, 960), fr(540, 860, 0.76, 540, 960)), captions: caps("sci1"), fx: (tl, id, t0) => { FLICK(tl, t0 + 0.8, 0.35); FLICK(tl, t0 + 2.4, 0.25); } });
      // 13 · what-if: strike, side flash, the current runs out along the ground
      add("sci2", { ...STORM("s2", { tree: { x: 540, y: 1560, s: 0.85 }, bolt: 1, side: [[250, 1470]], ground: 1, flash: 0.8, horizon: 1150 }), light: FL, grade: GW,
        cam: push2("sci2", fr(540, 1050, 0.82, 540, 960), fr(540, 1150, 0.9, 540, 960)),
