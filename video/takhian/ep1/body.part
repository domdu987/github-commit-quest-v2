      // ---------- ต้นตะเคียนกลางนา EP.1 อย่าวิ่งไปหลบใต้ต้นตะเคียน ----------
      // grammar: the run at the tree (wide, push) → the strike in their faces → ยายหอม stops them → what-if under the tree → the open field (high)
      // → the family in the rain (jokes, the stopwatch, the buffalo) → the painted cloth → science (low angle, what-if) → rule 1 on the hut post
      // → the hut is no shelter → the pickup → spread out → the uncle lies flat (what-if) → crouching (what-if) → the truck → he goes back → the strike
      // → frozen → the hand that won't touch → the note on the window
      const FAM = (k, x0, dx, y = 1640, s = 1, moods = {}) => [
        P("lungPiak", x0, y, s, "run", "wide", "laugh", { flip: true, moveTo: { x: x0 - dx, dur: D(k), ease: "none" } }),
        P("ploy", x0 + 250, y + 70, s * 1.04, "run", "wide", "scream", { flip: true, moveTo: { x: x0 + 250 - dx, dur: D(k), ease: "none" } }),
        P("ton", x0 + 470, y + 20, s * 0.78, "run", "wide", "o", { flip: true, moveTo: { x: x0 + 470 - dx, dur: D(k), ease: "none" } }),
        P("yaiHom", x0 + 660, y - 40, s * 0.92, "run", "worry", "frown", { flip: true, moveTo: { x: x0 + 660 - dx * 0.9, dur: D(k), ease: "none" } })];

      // 1 · the run at the lone tree; a bolt far off; the title sign staked in the paddy
      add("hook", { ...STORM("h", { tree: { x: 170, y: 1100, s: 0.6 }, distBolt: [780, 840], flash: 0.5, buf: { x: 560, y: 1092, s: 0.3, stake: [500, 1096], flip: 1 }, bundX: 300, fgRice: true }),
        cam: push2("hook", fr(560, 1250, 1.0, 540, 1000), fr(520, 1250, 1.1, 540, 1000)), shake: rumble(1.5),
        actors: FAM("hook", 330, 90),
        captions: caps("hook"),
        fx: (tl, id, t0, L) => { put(L.set, titleSign(640, 1100, 0.5, "ต้นตะเคียนกลางนา", "EP.1 อย่าวิ่งไปหลบใต้ต้นตะเคียน")); put(L.set, `<g id="hk-dog">${Tk.dog(470, 1760, 0.8, { flip: 1, bark: 1 })}</g>`); tl.fromTo("#hk-dog", { x: 0 }, { x: -110, duration: D("hook"), ease: "none", immediateRender: false }, t0); FLICK(tl, t0 + 0.45, 0.4); FLICK(tl, t0 + 1.9, 0.3); } });
      // 2 · the command: the bolt hits the tree as they come under it — flash, silhouettes, they flinch apart
      add("cmd", { ...STORM("c", { tree: { x: 540, y: 1750, s: 0.95 }, bolt: 1, ground: 0.8, flash: 0.4, horizon: 1300 }), light: FL,
        cam: push2("cmd", fr(540, 1000, 0.85, 540, 900), fr(540, 1040, 0.92, 540, 900)), shake: kick(0.12, 0.9, 16),
        actors: [P("lungPiak", 200, 1840, 0.95, "run", "wide", "scream", { then: [{ t: 0.14, mode: "flinch", eyes: "wide", mouth: "scream" }] }),
          P("ploy", 860, 1870, 1.0, "run", "wide", "scream", { flip: true, then: [{ t: 0.14, mode: "flinch", eyes: "wide", mouth: "scream" }] }),
          P("ton", 1010, 1800, 0.72, "run", "wide", "scream", { flip: true, then: [{ t: 0.14, mode: "flinch", eyes: "wide", mouth: "scream" }] })],
        captions: caps("cmd"), fx: (tl, id, t0, L) => STRIKE(tl, L, t0, 0.1, { after: 0.75 }) });
      // 3 · ยายหอม grabs พลอย's wrist
