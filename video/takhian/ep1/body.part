      // 31 · the wet note slapped on the truck window
      add("next", { ...STORM("nx", { horizon: 900, rain: 0.7 }), cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }] }, captions: caps("next"),
        fx: (tl, id, t0, L) => { put(L.light, `<path d="M0,0H1080V1920H0Z M80,380H1000V1560H80Z" fill="#c8ccd0" fill-rule="evenodd" stroke="#1e1a16" stroke-width="10"/><path d="M0,1700H1080" stroke="#9aa0a6" stroke-width="40"/>`);
          put(L.light, `<g id="nx-n">${Tk.note(540, 1000, 1.1, ["ถ้าวันหนึ่ง…", "คนข้างคุณโดนฟ้าผ่า", "EP.2 อย่ากลัวจับตัวเขา"])}</g>`);
          tl.fromTo("#nx-n", { y: -1400 }, { y: 0, duration: 0.35, ease: "power3.in", immediateRender: false }, t0 + 0.2); } });
