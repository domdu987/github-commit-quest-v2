        captions: caps("chabu") });
      // 7 · ต้น and his stopwatch (insert at 1.0 s)
      split("timer", 1.0,
        { ...STORM("t1", { horizon: 900 }), cam: { keys: [{ t: 0, ...fr(540, 1500, 1.7, 540, 1100) }] },
          actors: [P("ton", 540, 1700, 0.9, "point", "wide", "laugh", { flip: true, talk: TALK("timer", 0, "laugh") })], captions: caps("timer").filter((c) => c.t < 1.0) },
        { ...STORM("t2", { horizon: 900, rain: 0.5 }), cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }] }, captions: capsFrom("timer", 1.0),
          fx: (tl, id, t0, L) => { put(L.glow, `<g id="tw">${Tk.watch(540, 900, 1.6, { mm: "10", ss: "00", label: "ดำนา" })}</g>`); tl.fromTo("#tw", { scale: 1.06, svgOrigin: "540 900" }, { scale: 1, svgOrigin: "540 900", duration: 0.4, ease: "back.out(2)", immediateRender: false }, t0); } });
      // 8 · ลุงเปี๊ยก points at his buffalo tied at the foot of the tree
      add("buff", { ...STORM("b", { tree: { x: 380, y: 1180, s: 0.5, burnt: 0.4 }, buf: { x: 560, y: 1190, s: 0.42, stake: [470, 1194], flip: 1 }, horizon: 1050 }),
