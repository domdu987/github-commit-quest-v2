        fx: (tl, id, t0, L) => { put(L.set, `<rect x="-900" y="1400" width="2900" height="240" fill="#6a5a42"/>` + Tk.pickup(560, 1560, 1.0, { keys: 1 })); } });
      // 19 · ยาย points at the truck; everyone sets off
      add("go", { ...STORM("g", { horizon: 1000 }),
        cam: push2("go", fr(540, 1400, 1.1, 540, 1050), fr(500, 1400, 1.12, 540, 1050)),
        actors: [P("yaiHom", 420, 1700, 0.95, "point", "angry", "scream", { talk: TALK("go", 0, "scream") }), P("ploy", 650, 1730, 1.0, "run", "wide", "o", { moveTo: { x: 1200, dur: D("go") } }), P("ton", 820, 1700, 0.78, "run", "wide", "o", { moveTo: { x: 1300, dur: D("go") } })],
        captions: caps("go"), fx: (tl, id, t0, L) => put(L.set, Tk.pickup(-120, 1200, 0.4, {})) });
      // 20 · top-down-ish wide: the four run apart along different bunds
      add("spread", { ...STORM("sp", { horizon: 600, bund: false }),
        cam: push2("spread", fr(540, 1200, 0.7, 540, 960), fr(540, 1200, 0.74, 540, 960)),
