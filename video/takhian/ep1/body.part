        fx: (tl, id, t0, L) => { WHATIF(L, tl, t0, D("sci2") - 0.45); STRIKE(tl, L, t0, 0.2, { after: 0.6 }); } });
      // 14 · rule 1: ยายหอม's bamboo rules drop onto the hut post, rule 1 lit, ticked as she finishes it
      add("rule1", { set: "tkHut", setOpts: { id: "r1", mood: "storm", dark: 0.9, rain: 0.4, tree: { x: 620, y: 1180, s: 0.5 } }, dark: 0.3, light: ST, grade: GS,
        cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }] }, captions: caps("rule1"),
        fx: (tl, id, t0, L) => Tk.rules(tl, L.light, t0 + 0.15, D("rule1") - 0.15, { active: 0, tickAt: voEnd("rule1") - 0.25 }) });
      // 15 · ต้น points at the เถียงนา; they run for it
      add("hut", { ...STORM("hu", { hut: { x: 860, y: 1300, s: 0.7 }, horizon: 1000, bundX: 700 }),
        cam: push2("hut", fr(540, 1350, 1.0, 540, 1000), fr(600, 1350, 1.06, 540, 1000)),
        actors: [P("ploy", 80, 1660, 0.95, "run", "wide", "o", { moveTo: { x: 260, dur: D("hut") } }), P("ton", 400, 1760, 0.85, "point", "wide", "scream", { talk: TALK("hut", 0, "scream") })], captions: caps("hut") });
      // 16 · under the roof, panting
      add("relief", { set: "tkHut", setOpts: { id: "rl", mood: "storm", dark: 0.85, rain: 0.9, tree: { x: 640, y: 1180, s: 0.5, burnt: 0.4 } }, dark: 0.04, light: ST, grade: GS,
        cam: push2("relief", fr(540, 1300, 1.12, 540, 1080), fr(540, 1300, 1.16, 540, 1080)),
        actors: [P("ploy", 300, 1680, 1.0, "pant", "closed", "smile", { talk: TALK("relief", 0, "smile") }), P("ton", 560, 1680, 0.78, "pant", "normal", "o", { flip: true }), P("yaiHom", 840, 1680, 0.95, "idle", "worry", "frown", { flip: true })],
        captions: caps("relief"), fx: (tl, id, t0, L) => put(L.set, Tk.dog(160, 1700, 0.6, {})) });
      // 17 · ยาย: open on four sides — lightning flickers through the roof
      add("nohut", { set: "tkHut", setOpts: { id: "nh", mood: "storm", dark: 0.85, rain: 0.9, flash: 0.6, tree: { x: 300, y: 1180, s: 0.4, burnt: 0.4 } }, dark: 0.04, light: FL, grade: GS,
        cam: push2("nohut", fr(700, 1300, 1.7, 540, 1080), fr(700, 1300, 1.8, 540, 1080)), shake: kick(0.1, 0.5, 6),
        actors: [P("yaiHom", 760, 1680, 0.95, "yell", "angry", "scream", { flip: true, talk: TALK("nohut", 0, "scream") })], captions: caps("nohut"),
        fx: (tl, id, t0) => FLICK(tl, t0 + 0.15, 0.5) });
      // 18 · the pickup at the dirt road: hard roof, windows up
      add("shelter", { ...STORM("sh", { horizon: 1000, rain: 0.6 }),
