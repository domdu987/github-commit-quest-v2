        cam: push2("stop", fr(540, 1450, 1.35, 540, 1050), fr(540, 1450, 1.45, 540, 1050)), shake: kick(0, 0.5, 6),
        actors: [P("yaiHom", 330, 1700, 1.0, "grab", "angry", "scream", { talk: TALK("stop", 0, "scream") }), P("ploy", 650, 1720, 1.04, "flinch", "wide", "o", { flip: true })],
        captions: caps("stop") });
      // 4 · what-if: under the tree, the side flash into the people at the trunk
      add("why", { ...STORM("w", { tree: { x: 540, y: 1600, s: 0.85 }, bolt: 1, side: [[260, 1500], [830, 1500]], ground: 0.6, flash: 0.8, horizon: 1200 }), light: FL, grade: GW,
        cam: push2("why", fr(540, 1000, 0.8, 540, 900), fr(540, 1060, 0.86, 540, 900)),
        actors: [P("lungPiak", 230, 1660, 0.8, "flinch", "wide", "scream"), P("ploy", 830, 1670, 0.82, "flinch", "wide", "scream", { flip: true }), P("ton", 700, 1640, 0.62, "flinch", "wide", "scream", { flip: true })],
        captions: caps("why"), fx: (tl, id, t0, L) => { WHATIF(L, tl, t0, D("why") - 0.45); STRIKE(tl, L, t0, 0.15, { after: 0.4 }); } });
      // 5 · high wide: four tiny people in the open field, the storm wall
      add("nosafe", { ...STORM("n", { tree: { x: 260, y: 900, s: 0.3, burnt: 0.4 }, horizon: 700, distBolt: [900, 950] }),
        cam: push2("nosafe", fr(540, 1100, 0.62, 540, 960), fr(540, 1100, 0.68, 540, 960)), shake: rumble(1),
