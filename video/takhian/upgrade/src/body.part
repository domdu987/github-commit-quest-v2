        captions: cap("{อย่าวิ่งไปหลบใต้ต้นตะเคียน!}") });
      // ===== Hook B: the uncle throws himself flat in the mud =====
      add("b0", { set: "tkField", setOpts: STORMF({ id: "b0", tree: { x: 860, y: 1060, s: 0.5 }, flash: 0.5, distBolt: [300, 340] }), dark: 0.05, light: ST, grade: GS,
        cam: { keys: [{ t: 0, ...fr(540, 1300, 1.05, 540, 1000) }] },
        actors: [R("lungPiak", 420, 1720, 1.1, "wide", "scream", false), R("ploy", 700, 1660, 1.0, "wide", "o", false), R("ton", 860, 1640, 0.78, "wide", "o", false)], captions: cap("ถ้าวันหนึ่ง… คุณโดน[ฟ้าไล่]กลางนา") });
      add("b1", { set: "tkField", setOpts: STORMF({ id: "b1", flash: 0.3, horizon: 900 }), dark: 0.05, light: ST, grade: GS,
