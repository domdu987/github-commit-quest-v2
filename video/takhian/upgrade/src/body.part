        actors: [R("ploy", 820, 1560, 1.0, "wide", "o", true, "point"), R("ton", 960, 1520, 0.75, "worry", "frown", true, "idle")],
        fx: (tl, id, t0, L) => put(L.set, Tk.lying(330, 1600, 0.9, { flip: 0 }).replace("#000\" opacity=\".35\"", "#000\" opacity=\".2\"")), captions: cap("ลุงบอกให้[หมอบราบ]กับพื้น") });
      add("b2", { set: "tkField", setOpts: STORMF({ id: "b2", tree: { x: 860, y: 1180, s: 0.7 }, flash: 1, bolt: 1, ground: 1, horizon: 1000 }), dark: 0.02, light: FL, grade: GS,
        cam: { keys: [{ t: 0, ...fr(560, 1300, 1.1, 540, 1000) }] },
        fx: (tl, id, t0, L) => { put(L.set, Tk.lying(380, 1640, 0.9)); put(L.glow, [1, 2, 3, 4].map((k) => `<ellipse cx="860" cy="1200" rx="${k * 230}" ry="${k * 70}" fill="none" stroke="#cfe0ff" stroke-width="${10 - k * 2}" opacity="${0.8 - k * 0.15}"/>`).join("")); }, captions: cap("{อย่านอนราบกับพื้น!}") });
      // ===== Hook C (EP.2): the man beside you is struck =====
      add("c0", { set: "tkField", setOpts: STORMF({ id: "c0", tree: { x: 640, y: 1400, s: 1.05, burnt: 1 }, flash: 0.25, rain: 0.6, horizon: 1050 }), dark: 0.06, light: ST, grade: GS,
