      add("a2", { set: "tkField", setOpts: STORMF({ id: "a2", tree: { x: 540, y: 1700, s: 1.35 }, flash: 1, bolt: 0.95, horizon: 1250 }), dark: 0.02, light: FL, grade: GS,
