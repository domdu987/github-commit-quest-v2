      const A = (who, x, y, s, track, extra = {}) => ({ who, x, y, s, track, blinks: [9], ...extra });
      const ST = { from: "left", rim: "#b8c8ff", rimOp: 0.85, shade: "#0a0e18", shadeOp: 0.4, cast: false, vol: false };
      const FL = { from: "right", rim: "#ffffff", rimOp: 1, shade: "#0a0e18", shadeOp: 0.35, cast: false, vol: false };
      const DAY = { from: "right", rim: "#ffe2a0", rimOp: 0.8, shade: "#3a2a40", shadeOp: 0.25, cast: false, vol: false };
      const GS = { top: "#2a3048", bottom: "#0a0e14", op: 0.16 };
      const GD = { top: "#ffe0a0", bottom: "#3a5a3a", op: 0.1 };
      const cap = (text) => [{ text, t: 0, end: 1 }];
      const ARM = (L, fx, fy, sx, sy, sleeve = "#e86a8a", sc = 1) => { const ang = Math.atan2(sy - fy, sx - fx) * 180 / Math.PI, len = Math.hypot(sx - fx, sy - fy) / sc; put(L.glow, `<g transform="translate(${fx},${fy}) rotate(${ang}) scale(${sc})">${Hands.poke({ r: 50, sleeve, cuff: "#ffffff", sleeveLen: Math.max(80, len - 120) })}</g>`); };
      const R = (who, x, y, s, eyes = "wide", mouth = "scream", flip = false, mode = "run") => A(who, x, y, s, [{ t: 0, mode, eyes, mouth }], { flip });
      const STORMF = (o = {}) => ({ mood: "storm", dark: 0.8, rain: 0.8, ...o });
      // ===== Hook A (EP.1): the family running along the bund to the only shelter in the field =====
      add("a0", { set: "tkField", setOpts: STORMF({ id: "a0", tree: { x: 170, y: 1100, s: 0.6 }, flash: 0.55, distBolt: [760, 820], buf: { x: 560, y: 1090, s: 0.3, stake: [500, 1094], flip: 1 }, bundX: 300, fgRice: true }), dark: 0.05, light: ST, grade: GS,
        cam: { keys: [{ t: 0, ...fr(560, 1250, 1.0, 540, 1000) }] },
        actors: [R("lungPiak", 380, 1640, 1.0, "wide", "laugh", true), R("ploy", 600, 1700, 1.05, "wide", "scream", true), R("ton", 790, 1650, 0.8, "wide", "o", true), R("yaiHom", 960, 1610, 0.95, "worry", "frown", true)],
        fx: (tl, id, t0, L) => put(L.set, Tk.dog(470, 1760, 0.8, { flip: 1, bark: 1 })), captions: cap("ถ้าวันหนึ่ง… คุณติด[พายุ]กลางทุ่งนา") });
      add("a1", { set: "tkField", setOpts: STORMF({ id: "a1", tree: { x: 540, y: 1300, s: 1.0 }, flash: 0.6, bund: true }), dark: 0.05, light: FL, grade: GS,
