      add("c2", { set: "tkCPR", setOpts: { id: "c2", hands: 1, phone: 1, rain: 0.5 }, dark: 0, light: ST, grade: GS, cam: { keys: [{ t: 0, ...fr(560, 1000, 0.95, 540, 980) }] },
