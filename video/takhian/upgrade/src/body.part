        cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }] }, captions: [] });
      add("s2", { set: "tkHut", setOpts: STORMF({ id: "s2", tree: { x: 620, y: 1180, s: 0.55 }, rain: 0.9, flash: 0.4 }), dark: 0.05, light: ST, grade: GS, cam: { keys: [{ t: 0, ...fr(540, 960, 1.0, 540, 960) }] },
        actors: [R("yaiHom", 220, 1660, 1.0, "normal", "flat", false, "idle"), R("ton", 860, 1660, 0.78, "worry", "o", true, "point")], fx: (tl, id, t0, L) => put(L.act || L.set, Tk.dog(560, 1680, 0.7, {})), captions: [] });
      add("s3", { set: "tkField", setOpts: { id: "s3", mood: "calm", tree: { x: 540, y: 1180, s: 0.75 }, buf: { x: 930, y: 1250, s: 0.42, stake: [990, 1250], flip: 1 }, hut: { x: 120, y: 1100, s: 0.32 } }, dark: 0, light: DAY, grade: GD,
        cam: { keys: [{ t: 0, ...fr(540, 1100, 1.0, 540, 960) }] },
