          for (let k = 0; k < 9; k++) { const x = 440 + r() * 240, w = 9 + r() * 9; g += `<path class="rb-cl" d="M${x.toFixed(1)},1054l${w.toFixed(1)},-3l3,${(w * 0.8).toFixed(1)}l${(-w * 0.7).toFixed(1)},5z" fill="#5a3c24" stroke="#2a1a10" stroke-width="2" opacity="0"/>`; }
