      // ---------- 26. rumble: dust falls from under the house under the bulb ----------
      add("rumble", { set: "rupYard", setOpts: { id: "rb", time: "night", muddy: 0.95, leanPost: true }, dark: 0.2, light: MOONL, grade: GNIGHT, shake: SHAKE(0.3, 7, 1.6),
