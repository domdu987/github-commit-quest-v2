          document.querySelectorAll(".rb-cl").forEach((el, k) => { const at = t0 + 0.35 + k * 0.22;
            tl.fromTo(el, { y: 0, rotation: 0, opacity: 1, transformOrigin: "50% 50%" }, { y: 178, rotation: 160 + k * 30, transformOrigin: "50% 50%", duration: 0.45, ease: "power2.in", immediateRender: false }, at);
