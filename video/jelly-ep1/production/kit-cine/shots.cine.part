        cam: { keys: [{ t: 0, ...fr(540, 900, 1.55, 540, 760) }, { t: D("c_goneB"), glide: D("c_goneB"), ...fr(540, 1060, 0.95, 540, 960) }] },
        captions: [...caps("c_goneB", [0]), ...caps("c_goneB", [1], { quote: true })],
