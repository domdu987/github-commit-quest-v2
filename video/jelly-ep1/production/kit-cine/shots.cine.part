          PEAK.forEach(([x, y, sc, per, dp], k) => {
            put(lay[dp], `<g id="pk2-${k}" opacity="${[0.45, 0.85, 0.95][dp]}"${dp === 0 ? ' filter="url(#pk2-blur)"' : ""}>${Jelly.box(x, y, sc, { seed: 40 + k, per, len: [260, 300, 340][dp] + 30 * (k % 3), lit: [1.0, 1.3, 1.5][dp], glow: dp > 0, sway: k % 2 ? 0.9 : -0.9 })}</g>`);
            tl.fromTo(`#pk2-${k}`, { y: 0 }, { y: -(20 + 14 * dp) - (k % 4) * 6, duration: 1.1 + (k % 5) * 0.27, repeat: 4, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0 + (k % 7) * 0.13);
          });
          put(L.mid, `<defs><filter id="pk2-blur"><feGaussianBlur stdDeviation="2.2"/></filter></defs>`);
          // the empty duck ring on the surface, rocking; one tentacle from the mid jellyfish below rises and touches its underside
          put(L.set, `<ellipse cx="540" cy="524" rx="230" ry="44" fill="#fff6c8" opacity=".5"/><g transform="translate(540,544)"><g id="pk2-ring">${TideCast.duckRing(0, 0, 1.6, { water: true })}</g></g>
            <path id="pk2-ten" d="M720,1200Q690,1040 640,900Q600,760 580,620" stroke="#f2feff" stroke-width="5" fill="none" stroke-linecap="round" stroke-dasharray="700" stroke-dashoffset="700"/>
            <path id="pk2-ten2" d="M720,1200Q690,1040 640,900Q600,760 580,620" stroke="#a88ae8" stroke-width="2" fill="none" stroke-dasharray="3 8" opacity="0"/>`);
          tl.fromTo("#pk2-ring", { y: -6, rotation: -3, svgOrigin: "0 0" }, { y: 6, rotation: 3, svgOrigin: "0 0", duration: 0.9, repeat: 5, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0);
          tl.to("#pk2-ten", { strokeDashoffset: 0, duration: 2.6, ease: "power1.inOut", immediateRender: false }, t0 + 0.8);
          tl.to("#pk2-ten2", { opacity: 0.7, duration: 0.6, immediateRender: false }, t0 + 2.6);
