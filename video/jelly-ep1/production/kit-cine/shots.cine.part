        captions: caps("c_gone", undefined, { quote: true }) });
      // 27 · the peak: from the empty duck ring, a slow pull-out to the swarm under it; ต้น's "น้ำหวาน…?" over it
      const PEAK = [
        // [x, y, s, per, depth]  depth 0 far · 1 mid · 2 near
        [160, 980, 0.38, 1, 0], [380, 1060, 0.32, 5, 0], [820, 1000, 0.36, 1, 0], [960, 1150, 0.3, 5, 0], [600, 1180, 0.34, 1, 0], [240, 1300, 0.3, 5, 0],
        [300, 1180, 0.72, 5, 1], [720, 1260, 0.8, 1, 1], [500, 1460, 0.75, 5, 1], [900, 1500, 0.7, 5, 1], [130, 1560, 0.68, 1, 1],
        [80, 1180, 1.5, 5, 2], [1010, 1720, 1.6, 1, 2], [620, 1900, 1.4, 5, 2]];
