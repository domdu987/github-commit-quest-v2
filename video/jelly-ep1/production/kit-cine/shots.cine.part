          const cut2 = CT(19, "c_crowd");
          insert(L, tl, t0, "ci-cap", 0, cut2, SAND("ci-s1") + `<g transform="translate(560,980)"><g id="ci-bt"><g transform="rotate(-20) scale(2.4) translate(0,110)">${Jelly.bottle(0, 0, 1, { cap: true })}</g></g>
            <path d="M-120,-430Q-40,-520 60,-500Q120,-480 110,-420L60,-360Q-40,-330 -110,-370Z" fill="#c08a5e" stroke="#1e1a16" stroke-width="5"/><path d="M-60,-470q30,-10 60,0M-70,-430q40,-10 80,0" stroke="#8a5a3a" stroke-width="4" fill="none"/>
            <path d="M110,-420L700,-640" stroke="#1e1a16" stroke-width="120" stroke-linecap="round"/><path d="M110,-420L700,-640" stroke="#f2f0e8" stroke-width="108" stroke-linecap="round"/></g>`);
          tl.fromTo("#ci-bt", { rotation: 0, svgOrigin: "0 -380" }, { rotation: -14, svgOrigin: "0 -380", duration: cut2, ease: "power2.inOut", immediateRender: false }, t0);
          insert(L, tl, t0, "ci-rub", cut2, CT(20, "c_crowd"), SAND("ci-s2") + `<g transform="translate(60,1180) scale(2.2)"><path d="M-120,0Q140,-50 420,-20Q560,0 640,40L640,180Q500,160 300,170Q60,180 -120,200Z" fill="#c8915f" stroke="#1e1a16" stroke-width="4"/>
              ${Jelly.ladder([[60, 30], [180, 60], [300, 40]], { w: 10 })}${Jelly.ladder([[320, 70], [420, 40], [520, 80]], { w: 8 })}</g>
            <g id="ci-hd" transform="translate(620,820)"><path d="M-160,-40Q-80,-120 60,-110Q160,-90 180,-20Q180,40 110,50L-130,40Q-190,20 -160,-40Z" fill="#e0b088" stroke="#1e1a16" stroke-width="6"/>
              ${[-90, -30, 30, 90].map((x) => `<rect x="${x - 24}" y="-170" width="48" height="120" rx="24" fill="#e0b088" stroke="#1e1a16" stroke-width="5"/>`).join("")}
              <path d="M-260,60h-90M280,60h90" stroke="#d8312a" stroke-width="14" stroke-linecap="round"/><path d="M-350,60l30,-22v44zM370,60l-30,-22v44z" fill="#d8312a"/></g>`, 1.04);
          tl.fromTo("#ci-hd", { x: -50 }, { x: 50, duration: 0.18, repeat: 6, yoyo: true, ease: "sine.inOut", immediateRender: false }, t0 + cut2);
        } });
      add("c_know", { ...O.know, ...NOG, captions: caps("c_know"), fx(tl, id, t0, L) { O.know.fx(tl, id, t0, L); } });
      // 24 · the bottle over the leg, dead still, quiet
      add("c_choice", { ...O.choice, ...NOG, captions: caps("c_choice", undefined, { quote: true }), fx(tl, id, t0, L) { O.choice.fx(tl, id, t0, L); } });
      // 25 · ต้น's face; he sets the bottle down → (rack) the rhyme board on the post behind him, rule 1 ticks → ภูมิ's "พ่อไม่ช่วยผม…" over his face
      add("c_choiceB", { ...O.choiceB, ...NOG,
