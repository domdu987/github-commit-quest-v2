        captions: caps("c_stingB", undefined, { quote: true }) });
      // 18–23 · the crowd, cut fast on inserts: the cap twisted off → a hand about to rub → ภูมิ CU → the welts → น้ำหวาน → ต้น still (the command)
      add("c_crowd", { ...O.crowd, ...NOG,
        cam: { keys: [{ t: 0, ...fr(500, 1520, 1.3, 540, 1150) },
          { t: CT(20, "c_crowd"), ...fr(450, 1530, 4.4, 540, 860) }, { t: CT(21, "c_crowd"), ...fr(645, 1785, 4.5, 540, 900) },
          { t: CT(22, "c_crowd"), ...fr(640, 1400, 2.6, 540, 800) }, { t: CT(23, "c_crowd"), ...fr(300, 1372, 4.0, 540, 820) }] },
        captions: caps("c_crowd", undefined, { quote: true }),
        fx(tl, id, t0, L) {
