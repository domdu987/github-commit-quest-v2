            <g transform="translate(540,1520) scale(2.6)">${postBoard(0, 0, 1, "pbr").replace(/opacity="0.38"/g, 'opacity="1"').replace('fill="#f2c230" opacity=".6"', 'fill="#f2c230" opacity=".45"')}</g></g>`);
          tl.set("#cb-rk", { opacity: 0 }, 0); tl.fromTo("#cb-rk", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "power1.inOut", immediateRender: false }, t0 + a);
          tl.to("#cb-rk", { opacity: 0, duration: 0.4, ease: "power1.inOut", immediateRender: false }, t0 + b);
          tl.fromTo("#pbr-on", { opacity: 0 }, { opacity: 1, duration: 0.4, immediateRender: false }, t0 + a + 0.4);
          tl.fromTo("#pbr-tick", { opacity: 0, scale: 0.2, svgOrigin: "0 0" }, { opacity: 1, scale: 1, svgOrigin: "0 0", duration: 0.5, ease: "back.out(3)", immediateRender: false }, t0 + a + 0.8);
          SRC(L, tl, t0 + a + 0.4, 1.5, "ที่มา: กรมควบคุมโรค");
        } });
      // 26 · two-shot: ต้น turns and shouts for น้ำหวาน (ภูมิ's shoulder in the foreground); slow pull-out
      add("c_gone", { ...O.gone, ...NOG,
