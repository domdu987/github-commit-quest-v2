          const gl = grp(L.glow); gl.innerHTML = `<g style="mix-blend-mode:screen"><ellipse cx="${KENG + 30}" cy="${1400 - 500 * 0.95}" rx="220" ry="160" fill="url(#brPhoneGlow)"/></g>`; } });
      shot("c07", { ...camp("c07"), camAt: fr(840, 1090, 0.95, 540, 940), push: 0.012, shake: JKC.impact(F("c07", 0, 1), 0.5, 14),
