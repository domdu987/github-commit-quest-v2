      shot("c15", { ...NIGHTCAMP("c15"), camAt: fr(760, 1300, 2.2, 540, 1000), push: 0.03, blur: { far: 9, mid: 8, set: 4 }, dark: 0.3,
        fx(tl, id, t0, L) { hudSwap(tl, id, t0, vo("c15") + 0.75, H_BAT(2), H_BAT(1)); tray(L, 760, 1392, true);
          const ph = phoneUI(L, `${id}-ph`, { time: "19:12", pct: 1 }); tl.set(ph, { opacity: 0 }, 0); tl.set(`#${id}-ph-al, #${id}-ph-msg`, { opacity: 0 }, 0); pop(tl, ph, t0 + 0.1, { origin: "540 760", from: 0.7, dur: 0.4 });
          tl.fromTo(`#${id}-ph-big`, { opacity: 0, scale: 1.6, svgOrigin: "0 -130" }, { opacity: 1, scale: 1, svgOrigin: "0 -130", duration: 0.35, ease: "back.out(2.5)", immediateRender: false }, t0 + vo("c15") + 0.75);
          loop(tl, `#${id}-ph-big text:first-child`, { opacity: 1 }, { opacity: 0.35 }, 0.4, t0 + vo("c15") + 1.15, D("c15") - vo("c15") - 1.15);
          tl.to(`#${id}-dark`, { opacity: 0.55, duration: 0.8 }, t0 + D("c15") - 1.0); } });

      // ---------- c16 next: the full story on YouTube · c17 logo ----------
      shot("c16", { ...camp("c16", { night: true, torches: true, fog: true }), camAt: fr(900, 1000, 0.8, 540, 900), push: 0.01, dark: 0.45, blur: { set: 12, mid: 10, far: 10, glow: 8 }, captions: [],
        fx(tl, id, t0, L) { NkV.chalkEnd(tl, grp(L.light), t0, D("c16"), { big: "ดูเรื่องเต็ม", q: "ทาง YouTube", tag: "ดูต่อได้ที่", foot: "กดติดตาม แล้วดูเรื่องเต็มที่ YouTube" });
          const yt = grp(L.light); yt.innerHTML = `<g transform="translate(540,1430)"><rect x="-150" y="-50" width="100" height="100" rx="26" fill="#e8302a"/><path d="M-112,-24L-112,24L-72,0Z" fill="#fff"/>
            <text x="-30" y="-6" font-family="Kanit" font-weight="900" font-size="44" fill="#ffffff">${CHANNEL}</text><text x="-30" y="38" font-family="Kanit" font-weight="700" font-size="28" fill="#f2c55c">เรื่องเต็มทุกตอน</text></g>`;
          tl.set(yt, { opacity: 0 }, 0); tl.fromTo(yt, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.4, ease: "back.out(2)", immediateRender: false }, t0 + 1.3); } });
      shot("c17", { light: false, captions: [], fx(tl, id, t0, L) { const g = grp(L.light); NkUI.logo(g); pop(tl, g, t0 + 0.05, { from: 0.9, dy: 0, origin: "540 880" }); } });
