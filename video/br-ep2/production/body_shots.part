      // ---------- EP.2 helpers: a second status bar to switch to, the tray, the grill, the assistant's screen ----------
      const hud2 = (id, items, cls) => { const el = document.getElementById(id); if (!el) return;
        el.insertAdjacentHTML("beforeend", `<div class="sghud ${cls}">${items.map(([l, v, c], i) => `${i ? "<i></i>" : ""}<small>${l}</small><b style="color:${c || "#f4ecd8"}">${v}</b>`).join("")}</div>`); };
      const hudSwap = (tl, id, t0, at, a, b) => { hud2(id, a, "hA"); hud2(id, b, "hB"); tl.set(`#${id} .sghud.hB`, { opacity: 0 }, 0); tl.set(`#${id} .sghud.hA`, { opacity: 0 }, t0 + at); tl.set(`#${id} .sghud.hB`, { opacity: 1 }, t0 + at);
        tl.fromTo(`#${id} .sghud.hB`, { scale: 1.25 }, { scale: 1, duration: 0.3, ease: "back.out(3)", immediateRender: false }, t0 + at); };
      const tray = (L, x = 760, y = 1392, lit = false) => { const g = grp(L.act); g.innerHTML = `<g transform="translate(${x},${y})"><ellipse rx="92" ry="24" fill="#6a4a2a"/><ellipse cy="-6" rx="82" ry="19" fill="#c8a860"/><ellipse cy="-8" rx="70" ry="14" fill="#d8b878"/>
        <g transform="translate(0,-36) rotate(-8)"><rect x="-22" y="-44" width="44" height="88" rx="6" fill="#1a1a22"/><rect class="trScr" x="-18" y="-38" width="36" height="70" rx="4" fill="${lit ? "#243a66" : "#101016"}"/></g></g>`; return g; };
      const grill = (L, x = 560, y = 1400) => { const g = grp(L.act); g.innerHTML = `<g transform="translate(${x},${y})"><path d="M-64,-50V0M64,-50V0" stroke="#3a2a1a" stroke-width="8"/><rect x="-74" y="-60" width="148" height="12" rx="3" fill="#3a2a1a"/>
        <g class="brFire"><path d="M-20,-62Q-30,-90 -8,-108Q-2,-90 8,-100Q22,-76 4,-62Z" fill="#ff9a3a"/><path d="M-8,-64Q-12,-80 -2,-90Q2,-80 8,-84Q12,-72 2,-64Z" fill="#ffd860"/></g>
        ${[-44, -16, 12, 40].map((dx) => `<path d="M${dx},-60V-130" stroke="#b89058" stroke-width="5"/><path d="M${dx - 16},-126Q${dx},-160 ${dx + 16},-126Q${dx},-108 ${dx - 16},-126Z" fill="#c87a3a"/><path d="M${dx - 8},-128q8,-14 16,-6" stroke="#8a4a1a" stroke-width="2.5" fill="none"/>`).join("")}
        <g class="brSmoke" opacity=".5">${[-30, 10, 40].map((dx, k) => `<path d="M${dx},-160q-10,-24 0,-48q8,-20 -2,-40" stroke="#fff" stroke-width="${6 - k}" fill="none" stroke-linecap="round"/>`).join("")}</g></g>`; return g; };
      // the assistant's screen (screen space): the lock screen frame, a listening orb and voice bars that dance while she talks
      const assistUI = (L, id, o = {}) => { const g = grp(L.light), x = o.x ?? 540, y = o.y ?? 760, s = o.s ?? 0.72;
        g.innerHTML = `<g transform="translate(${x},${y}) scale(${s})"><rect x="-300" y="-550" width="600" height="1100" rx="60" fill="#1a1a22"/><rect x="-272" y="-522" width="544" height="1044" rx="44" fill="#0b0d16"/><rect x="-90" y="-512" width="180" height="34" rx="17" fill="#1a1a22"/>
          <text x="-236" y="-452" font-family="Kanit" font-weight="700" font-size="30" fill="#f4ecd8" opacity=".85">${o.time || "06:40"}</text>
          <g transform="translate(236,-466)"><rect x="-60" y="-14" width="54" height="28" rx="6" fill="none" stroke="#f4ecd8" stroke-width="3"/><rect x="-5" y="-6" width="5" height="12" rx="1.5" fill="#f4ecd8"/><rect x="-55" y="-9" width="4" height="18" rx="1" fill="#ff5a4a"/></g>
          <text x="166" y="-456" text-anchor="end" font-family="Kanit" font-weight="800" font-size="30" fill="#ff8a7a">${o.pct ?? 3}%</text>
          <circle id="${id}-orb" cy="-140" r="110" fill="url(#brPhoneGlow)"/><circle cy="-140" r="70" fill="#5a86f0" opacity=".9"/><circle cy="-140" r="70" fill="url(#jkiRing)"/>
          <g id="${id}-bars" transform="translate(0,120)">${[-120, -80, -40, 0, 40, 80, 120].map((bx, k) => `<rect id="${id}-bar${k}" x="${bx - 12}" y="-40" width="24" height="80" rx="12" fill="#9ad8ff"/>`).join("")}</g>
          <text x="0" y="260" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="36" fill="#f4ecd8" opacity=".8">กำลังฟัง…</text></g>`; return g; };
      const bars = (tl, id, t0, dur) => [0, 1, 2, 3, 4, 5, 6].forEach((k) => loop(tl, `#${id}-bar${k}`, { scaleY: 0.3, transformOrigin: "50% 50%" }, { scaleY: 1.4 + (k % 3) * 0.3, transformOrigin: "50% 50%" }, 0.18 + k * 0.03, t0, dur));
      const qmarks = (tl, L, pts, at) => { const g = grp(L.act); g.innerHTML = pts.map(([x, y]) => `<text x="${x}" y="${y}" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="90" fill="#f6d36a" stroke="#2e2a26" stroke-width="6" paint-order="stroke">?</text>`).join("");
        tl.set(g, { opacity: 0 }, 0); tl.fromTo(g, { opacity: 0, y: 30, scale: 0.6, svgOrigin: `${pts[0][0]} ${pts[0][1]}` }, { opacity: 1, y: 0, scale: 1, svgOrigin: `${pts[0][0]} ${pts[0][1]}`, duration: 0.35, ease: "back.out(2.5)", immediateRender: false }, at); return g; };
      const CROWD = (dx = 0) => [A("brMan1", 520 + dx, 1400, 0.98, [{ t: 0, mode: "foldX", eyes: "normal", mouth: "flat" }]), A("brMan2", 630 + dx * 0.6, 1400, 1.0, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }]),
        A("brMan3", 900 - dx * 0.6, 1400, 1.0, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }], { flip: true }), A("brWom1", 1010 - dx, 1400, 0.96, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }], { flip: true }),
        A("brJukSword", 1100 - dx, 1400, 0.68, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }], { flip: true }), A("brTaeng", 1190 - dx, 1400, 0.82, [{ t: 0, mode: "foldX", eyes: "squint", mouth: "flat" }], { flip: true })];

      // ---------- c01–c04 "ผมมาจากอนาคต" ----------
      shot("c01", { ...camp("c01"), camAt: fr(820, 1080, 1.15, 540, 940), push: 0.02,
        actors: [ME("brKeng", KENG, 1400, [{ t: 0, mode: "tiedStruggle", eyes: "wide", mouth: "o" }], { talk: [[F("c01", 0, 1), voEnd("c01", 0), "o"]] }), ...CROWD(0)],
        fx(tl, id, t0, L) { hud(id, H_BAT()); shadows(L, id, act("c01"), -0.5); rope(L, KENG, 0.95, 1400, id);
          qmarks(tl, L, [[520, 800], [630, 790], [900, 790], [1010, 800], [1100, 920], [1190, 860]], t0 + F("c01", 0, 1) + 0.5); } });
      shot("c02", { ...camp("c02"), cam: JKC.move(fr(820, 1080, 1.15, 540, 940), fr(790, 1060, 1.5, 540, 940), D("c02") - 0.2, 1.2),
