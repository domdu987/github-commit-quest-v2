      const NIGHTCAMP = (k, o = {}) => ({ ...camp(k, { night: true, torches: true, offerings: true, ...o }), dark: 0.14, light: { from: "left", rim: "#ffd9a0", rimOp: 0.6, rimW: 4, shade: "#101428", shadeOp: 0.34, shadeW: 26, soft: 9, vol: false }, grade: { top: "#ffd9a0", bottom: "#0c1030", op: 0.26 } });
