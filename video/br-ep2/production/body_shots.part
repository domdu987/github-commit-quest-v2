          A("brJukSword", 640, 1400, 0.68, [{ t: 0, mode: "idle", eyes: "wide", mouth: "o" }]), A("brPhaeoLadle", 430, 1400, 0.9, [{ t: 0, mode: "stir", eyes: "normal", mouth: "flat" }], { flip: true })],
