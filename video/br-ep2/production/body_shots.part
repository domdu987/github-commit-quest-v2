          moveTo: { x: a.x + (a.x < KENG ? 70 : -70), dur: 1.5, at: 0.1 } }))],
        fx(tl, id, t0, L) { hud(id, H_BAT()); shadows(L, id, act("c02"), -0.5); rope(L, KENG, 0.95, 1400, id); } });
      shot("c03", { ...camp("c03"), camAt: face(KENG, 1400, 2.8, false, 540, 820), push: 0.03, blur: { far: 7, mid: 6, set: 3 }, shake: JKC.impact(F("c03", 0, 0), 0.4, 7),
        actors: [ME("brKeng", KENG, 1400, [{ t: 0, mode: "tiedStruggle", eyes: "wide", mouth: "o" }], { talk: [[vo("c03"), voEnd("c03"), "o"]] })],
        sfxText: [{ text: "อนาคต!", x: 90, y: 560, size: 96, rot: -8, color: "#f6d36a", t: F("c03", 0, 0) + 0.3, end: F("c03", 0, 1) + 0.2 }],
        fx(tl, id, t0, L) { hud(id, H_BAT()); rope(L, KENG, 0.95, 1400, id); BRI.badge(tl, L.light, t0, D("c03"), { kind: "phone", x: 800, y: 520, tone: "blue", label: "รู้จากติ๊กต็อก", at: F("c03", 0, 1) + 0.3 }); } });
      shot("c04", { ...camp("c04"), camAt: fr(940, 1010, 1.7, 540, 900), push: 0.012, blur: { far: 6, mid: 5 },
