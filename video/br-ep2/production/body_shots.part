          A("brJukSword", 1100, 1400, 0.68, [{ t: 0, mode: "idle", eyes: "side", mouth: "flat" }], { flip: true }), A("brTaeng", 1190, 1400, 0.82, [{ t: 0, mode: "foldX", eyes: "squint", mouth: "flat" }], { flip: true })],
        sfxText: [{ text: "…", x: 470, y: 520, size: 120, rot: 0, color: "#f4ecd8", t: 0.2, end: D("c04") - 0.1 }],
        fx(tl, id, t0, L) { hud(id, H_BAT()); shadows(L, id, act("c04"), -0.5); qmarks(tl, L, [[900, 770], [1010, 780], [1100, 920], [1190, 850]], t0 + 0.4); } });

