        actors: [ME("brKeng", 900, 1400, [{ t: 0, mode: "idle", eyes: "happy", mouth: "smile" }], { flip: true }), A("brMan2Banana", 1180, 1400, 1.0, [{ t: 0, mode: "walk", eyes: "normal", mouth: "flat" }, { t: 2.2, mode: "kneelBow", eyes: "closed", mouth: "flat" }], { flip: true, moveTo: { x: 1040, dur: 2.0, at: 0.1 } }),
          A("brWom1Bowl", 1330, 1400, 0.96, [{ t: 0, mode: "walk", eyes: "normal", mouth: "flat" }, { t: 2.6, mode: "idle", eyes: "normal", mouth: "flat" }], { flip: true, moveTo: { x: 1170, dur: 2.4, at: 0.1 } }),
