        fx(tl, id, t0, L) { hud(id, H_BAT()); rope(L, KENG, 0.95, 1400, id); const px = KENG + 26 * 0.95, py = 1400 - 431 * 0.95; const ph = grp(L.act);
          ph.innerHTML = `<g transform="translate(0,-52) rotate(-16)"><rect x="-13" y="-28" width="26" height="56" rx="5" fill="#1a1a22"/><rect x="-10" y="-23" width="20" height="44" rx="3" fill="#101016"/><rect id="${id}-scr" x="-10" y="-23" width="20" height="44" rx="3" fill="#8ab8ff" opacity="0"/></g>`;
          ph.setAttribute("transform", `translate(${px.toFixed(1)},${py.toFixed(1)})`); tl.to(`#${id}-scr`, { opacity: 1, duration: 0.08 }, t0 + F("c05", 0, 1) + 0.15);
          const gl = grp(L.glow); gl.innerHTML = `<g style="mix-blend-mode:screen"><ellipse cx="${px}" cy="${py - 60}" rx="180" ry="140" fill="url(#brPhoneGlow)"/></g>`; tl.set(gl, { opacity: 0 }, 0); tl.to(gl, { opacity: 0.9, duration: 0.1 }, t0 + F("c05", 0, 1) + 0.15); } });
      shot("c06", { ...camp("c06"), camAt: fr(KENG + 30, 1400 - 480 * 0.95, 2.4, 540, 1000), push: 0.01, blur: { far: 9, mid: 8, set: 5 }, dark: 0.25, captions: caps("c06", null, { quote: false }),
