        fx(tl, id, t0, L) { hud(id, H_BAT()); shadows(L, id, act("c07"), -0.5); rope(L, KENG, 0.95, 1400, id); const b = buffalo(L, 1420, 1400, 1, true); lick(tl, b, t0, D("c07"), { down: 24, tilt: 10 });
