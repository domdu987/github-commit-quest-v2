
      // ======================= ภาค 2 · ครึ่งหลัง: ถ้ำบนภูเขา → คืนนั้น =======================
      { const M = Rig.MODES, Z = M.idle;
        M.pointSword = M.pointSword || ((u, o) => { const j = Math.sin(u * 33) * 2.5; return { ...Z(u, o), uaF: -92 + j, faF: 6, uaB: 30, faB: 40, head: -2 + j, torso: -4, bodyY: 0 }; });
        M.knock = M.knock || ((u, o) => ({ ...Z(u, o), uaF: -96, faF: -40 + 24 * Math.max(0, Math.sin(u * 2 * Math.PI / 0.45)), head: 2, torso: 2 }));
        M.payUp = M.payUp || ((u, o) => ({ ...Z(u, o), uaF: -80, faF: -20, uaB: 10, faB: -10, head: 4, torso: 2 }));
        // the sword held straight out along the arm (o.arm: upper-arm angle, -90 = level), a slow tremble
        M.swordAim = (u, o) => { const j = Math.sin(u * 23) * 1.2; return { ...Z(u, o), uaF: (o.arm ?? -96) + j, faF: 0, uaB: 24, faB: 30, head: -2, torso: -3 }; };
        // a stomach ache: both arms across the belly, bent over, shaking
        M.belly = (u, o) => { const j = Math.sin(u * 37) * 1.5; return { ...Z(u, o), uaF: -24 + j, faF: -104, uaB: 24 - j, faB: 104, torso: 24 + j * 0.5, head: 12 + j, bodyY: 26, thF: -16, shF: 24, thB: 6, shB: 16 }; };
        M.kneelSit = (u, o) => ({ ...M.sitChair(u, o) }); }
      C2.jkArthurAim = { v2: C2.jkArthur.v2, hand: JK.GSWORD(0), keep: "F" }; S2.jkArthurAim = S2.jkArthur;
      S2.jkArthur.headTop = ((f) => () => f().replace(/cx="-33"/g, 'cx="-49"').replace(/cx="41"/g, 'cx="57"').replace(/cy="-540"/g, 'cy="-526"').replace(/cy="-539"/g, 'cy="-525"'))(S2.jkArthur.headTop);
      const HX = 300, KX = 20, AX = 1000, WX = -260;               // you, ถั่วงอก, Arthur, the witch (the cave ledge)
      const DGX = 2300, DGS = 2.6, DGY = 1400 - 166 * DGS;       // the dragon, twice as big, facing left (its mouth ≈ 1408,734 · its eye ≈ 1676,474)
      const MOUTH = [DGX - 343 * DGS, DGY - 90 * DGS];
      // the dragon in its own wrapper (so a shot can move/turn the whole body), heads wagging, wings breathing
      const dragonAt = (tl, L, id, t0, dur, o = {}) => { const g = grp(L.set); const s = o.s ?? DGS, x = o.x ?? DGX, y = o.y ?? (1400 - 166 * s);
        g.innerHTML = `<g transform="translate(${x},${y}) scale(${-s},${s})">${JK.dragon(o.fill || "#4f8a5e", { heads: `${id}-dg` })}</g>`;
        [0, 1, 2].forEach((k) => { const el = document.getElementById(`${id}-dgh${k}`); if (el) loop(tl, el, { rotation: -3 - k, svgOrigin: ["60 -30", "40 -60", "96 -16"][k] }, { rotation: 3 + k, svgOrigin: ["60 -30", "40 -60", "96 -16"][k] }, 0.9 + k * 0.2, t0, dur); });
        loop(tl, g, { y: 0 }, { y: -8 }, 1.3, t0, dur); return g; };
      const CAVE_CAST = (o = {}) => [ME("jkYouBucket", HX, 1400, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }]), A("jkKidTorch", KX, 1400, 0.64, [{ t: 0, mode: o.kid || "tremble", eyes: "wide", mouth: "o" }]),
        A("jkArthur", AX, 1400, 0.98, [{ t: 0, mode: "idle", eyes: "squint", mouth: "flat" }], { flip: true }), A("jkWitchWand", WX, 1400, 0.95, [{ t: 0, mode: "tremble", eyes: "wide", mouth: "o" }])];
      const contract = (tl, L, at, o = {}) => { const g = grp(L.light); g.innerHTML = `<g transform="${LS(o.x ?? 300, o.y ?? 960)} rotate(-3)"><rect x="-260" y="-330" width="520" height="660" rx="16" fill="#f8f2e2"/><rect x="-260" y="-330" width="520" height="100" rx="16" fill="#2a4a8a"/><rect x="-260" y="-250" width="520" height="20" fill="#2a4a8a"/>
          <text x="0" y="-262" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="44" fill="#fff">ประกันชีวิต มั่นใจ</text>
          <text x="-220" y="-170" font-family="Kanit" font-weight="800" font-size="32" fill="#3a3a48">ผู้เอาประกัน: มังกร</text><text x="-220" y="-116" font-family="Kanit" font-weight="800" font-size="32" fill="#3a3a48">เบี้ย: 1 ถุงทอง / เดือน</text>
          <text x="-220" y="-62" font-family="Kanit" font-weight="800" font-size="32" fill="#3a3a48">คุ้มครอง: ไม่มีใครกล้าตี</text><path d="M-220,0h440M-220,40h380" stroke="#d4ccb8" stroke-width="7" stroke-linecap="round"/>
          <path d="M-220,210H220" stroke="#5a5a66" stroke-width="3" stroke-dasharray="10 8"/><text x="-220" y="250" font-family="Kanit" font-weight="700" font-size="24" fill="#8a8a96">ลายเซ็นผู้เอาประกัน</text>
          <path id="${o.id}-sig" d="M-190,190q30,-60 60,0t60,-10q20,-50 50,0t40,-20q30,-30 60,10" fill="none" stroke="#2a1a10" stroke-width="9" stroke-linecap="round" stroke-dasharray="520" stroke-dashoffset="520"/>
          <g id="${o.id}-stamp" opacity="0" transform="translate(140,90) rotate(-14)"><rect x="-110" y="-46" width="220" height="92" rx="12" fill="none" stroke="#c8242a" stroke-width="9"/><text x="0" y="22" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="56" fill="#c8242a">อนุมัติ</text></g>
          <text x="200" y="-290" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="22" fill="#cfe0ff">สาขา 112</text></g>`;
        pop(tl, g, at, { origin: `${o.x ?? 300} ${o.y ?? 960}`, from: 0.85 }); return g; };

      // ---------- b01 · the cave on the mountain: the same dragon, awake, twice as big ----------
      const B1 = CAVE_CAST();
      shot("b01", { ...cave("b01"), blur: { far: 2, mid: 1 }, cam: { keys: [{ t: 0, ...fr(400, 900, 0.62, 540, 1000), drift: { s: 0.01 } }, { t: F("b01", 0, 1) - 0.2, ...fr(1150, 1000, 0.62, 540, 1000), glide: 1.0 }, { t: F("b01", 0, 3) - 0.1, ...fr(1150, 980, 0.7, 540, 1000), glide: 0.5 }] },
        actors: B1, shake: JKC.impact(F("b01", 0, 2), 0.7, 12), sfxText: [{ text: "แฮ่!!", x: 800, y: 520, size: 150, rot: -6, color: "#ff8a5a", t: F("b01", 0, 2), end: F("b01", 0, 3) }],
        fx(tl, id, t0, L) { dragonAt(tl, L, id, t0, D("b01")); shadows(L, id, B1, 0.5); torchLife(tl, t0, D("b01"));
          JKI.badge(tl, L.light, t0, D("b01"), { kind: "dragon", x: 220, y: 520, s: 1.4, tone: "red", label: "ใหญ่ ×2", at: F("b01", 0, 3) }); } });

      // ---------- b02 · Arthur draws the gold sword… and points it at the bucket on your head ----------
      const TD = F("b02", 0, 0) + 1.0, TT2 = F("b02", 0, 2);
      const B2 = [ME("jkYouBucket", HX, 1400, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: TT2 + 0.2, mode: "startle", eyes: "wide", mouth: "o", sweat: true }]),
        A("jkArthur", AX, 1400, 0.98, [{ t: 0, mode: "idle", eyes: "squint", mouth: "flat" }], { until: TD }),
        A("jkArthurSwordUp", AX, 1400, 0.98, [{ t: 0, mode: "raise", eyes: "angry", mouth: "frown" }], { from: TD, until: TT2 }),
        A("jkArthurAim", AX, 1400, 0.98, [{ t: 0, mode: "swordAim", opts: { arm: -100 }, eyes: "angry", mouth: "frown" }], { flip: true, from: TT2 })];
      shot("b02", { ...cave("b02"), blur: { far: 4, mid: 2 }, cam: { keys: [{ t: 0, ...faceAt(AX, 1400, 0.98, 1.5, false, 540, 900), drift: { s: 0.012 } }, { t: TT2 - 0.1, ...fr(580, 1060, 1.35, 540, 980), glide: 0.35 }] }, actors: B2,
        fx(tl, id, t0, L) { dragonAt(tl, L, id, t0, D("b02")); shadows(L, id, B2, 0.5); const gl = grp(L.glow); gl.innerHTML = `<g style="mix-blend-mode:screen"><circle cx="${AX + 20}" cy="${1400 - 900}" r="260" fill="url(#jkWarm)" opacity=".6"/></g>`; gl.style.opacity = 0; tl.to(gl, { opacity: 1, duration: 0.2 }, t0 + TD); tl.to(gl, { opacity: 0, duration: 0.2 }, t0 + TT2);
          JKI.badge(tl, L.light, t0, D("b02"), { kind: "gsword", x: 860, y: 520, s: 1.4, tone: "yellow", label: "ดาบทอง", at: TD + 0.1 }); } });

      // ---------- b03 · "take the bucket off! let me see if your ears go red!" ----------
      const B3 = [A("jkArthurAim", AX, 1400, 0.98, [{ t: 0, mode: "swordAim", opts: { arm: -100 }, eyes: "angry", mouth: "scream" }], { flip: true, talk: [[0.06, voEnd("b03"), "scream"]] })];
      shot("b03", { ...cave("b03"), blur: { far: 8, mid: 6, set: 3 }, cam: { keys: [{ t: 0, ...faceAt(AX, 1400, 0.98, 2.6, true, 600, 820), drift: { s: 0.03 } }] }, actors: B3, shake: JKC.hand(3, 0.4),
        fx(tl, id, t0, L) { JKI.badge(tl, L.light, t0, D("b03"), { kind: "ears", x: 220, y: 520, s: 1.4, tone: "red", label: "หูแดงไหม?", at: F("b03", 0, 1) }); } });

      // ---------- b04 · in the suit pocket, one paper from the old world: the insurance policy ----------
      splitN("b04", [F("b04", 0, 2) - 0.1], [
        () => { const B = [ME("jkYouBucket", HX, 1400, [{ t: 0, mode: "startle", eyes: "wide", mouth: "o", sweat: true }, { t: F("b04", 0, 1), mode: "pocket", eyes: "normal", mouth: "flat" }]),
            A("jkArthurAim", AX, 1400, 0.98, [{ t: 0, mode: "swordAim", opts: { arm: -100 }, eyes: "angry", mouth: "frown" }], { flip: true })];
          return { ...cave("b04"), blur: { far: 5, mid: 3 }, cam: { keys: [{ t: 0, ...fr(580, 1060, 1.35, 540, 980), drift: { s: 0.012 } }, { t: F("b04", 0, 1) - 0.1, ...fr(HX + 30, 1400 - 380, 2.6, 540, 900), glide: 0.8 }] }, actors: B,
            fx(tl, id, t0, L) { dragonAt(tl, L, id, t0, F("b04", 0, 2)); shadows(L, id, B, 0.5); } }; },
        (off) => ({ ...cave("b04b"), dark: 0.35, blur: { far: 12, mid: 10, set: 8 }, cam: { keys: [{ t: 0, ...fr(HX, 1100, 1.6, 540, 960), drift: { s: 0.02 } }] },
          fx(tl, id, t0, L) { const g = grp(L.light); g.innerHTML = `<g transform="${LS(540, 960)}"><g transform="rotate(-4)"><rect x="-300" y="-380" width="600" height="760" rx="14" fill="#f8f4ea"/><rect x="-300" y="-380" width="600" height="150" rx="14" fill="#2a4a8a"/><rect x="-300" y="-250" width="600" height="20" fill="#2a4a8a"/>
              <text x="0" y="-290" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="62" fill="#fff">ประกันชีวิต</text><rect id="${id}-hl" x="-260" y="-200" width="520" height="90" rx="14" fill="#f2c55c" opacity="0"/>
              <text x="0" y="-136" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="54" fill="#2a2a38">มั่นใจ · สาขา 112</text>
              <path d="M-240,-40h480M-240,10h420M-240,60h460M-240,110h300" stroke="#c8c0b0" stroke-width="12" stroke-linecap="round"/>
              <circle cx="170" cy="250" r="70" fill="none" stroke="#c84040" stroke-width="8"/><text x="170" y="266" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="42" fill="#c84040">112</text>
              <path d="M-240,260q40,-40 80,0t80,0" fill="none" stroke="#2a3a6a" stroke-width="6"/></g></g>`;
            pop(tl, g, t0 + 0.05, { origin: "540 960", from: 0.6, dur: 0.4 }); tl.to(`#${id}-hl`, { opacity: 1, duration: 0.25 }, t0 + F("b04", 0, 3) - off); JKI.badge(tl, L.light, t0, D("b04") - off, { kind: "paper", x: 900, y: 560, s: 1.3, tone: "blue", label: "จากโลกเก่า", at: 0.3 }); } })]);

      // ---------- b05 · you hold it up to the blade: it stops dead, 1 mm from the paper ----------
      splitN("b05", [F("b05", 0, 1) - 0.05], [
        () => { const B = [ME("jkYouBucketPaper", HX, 1400, [{ t: 0, mode: "raise", eyes: "closed", mouth: "o" }]), A("jkArthurAim", AX, 1400, 0.98, [{ t: 0, mode: "lunge", opts: { arm: -96 }, eyes: "angry", mouth: "scream" }], { flip: true, moveTo: { x: AX - 120, dur: 0.6, ease: "power2.out" } })];
          return { ...cave("b05"), blur: { far: 5, mid: 3 }, cam: { keys: [{ t: 0, ...fr(560, 1040, 1.4, 540, 980), drift: { s: 0.03 } }] }, actors: B,
            fx(tl, id, t0, L) { dragonAt(tl, L, id, t0, F("b05", 0, 1)); shadows(L, id, B, 0.5); } }; },
        (off) => ({ ...cave("b05b"), dark: 0.3, blur: { far: 14, mid: 12, set: 10 }, cam: { keys: [{ t: 0, ...fr(HX, 1000, 1.8, 540, 960), drift: { s: 0.03 } }] }, shake: JKC.impact(0, 0.3, 10),
          sfxText: [{ text: "กึก!", x: 800, y: 520, size: 140, rot: 8, color: "#ffffff", t: 0.02, end: 1.2 }],
          fx(tl, id, t0, L) { const g = grp(L.light); g.innerHTML = `<g transform="${LS(540, 960)}"><g transform="translate(-260,0) rotate(-6)"><rect x="-230" y="-300" width="460" height="600" rx="12" fill="#f8f4ea"/><rect x="-230" y="-300" width="460" height="110" rx="12" fill="#2a4a8a"/>
              <text x="0" y="-228" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="50" fill="#fff">ประกันชีวิต</text><path d="M-190,-120h380M-190,-70h320M-190,-20h360" stroke="#c8c0b0" stroke-width="12" stroke-linecap="round"/></g>
              <g id="${id}-sw"><g transform="translate(24,0)"><path d="M-10,-26L620,-26L620,26L-10,26L-40,0Z" fill="#fff4c0"/><path d="M-40,0L-10,-46L700,-46L700,46L-10,46Z" fill="#ffd040" opacity=".35"/><path d="M-10,0H620" stroke="#fff" stroke-width="6" opacity=".9"/><rect x="620" y="-70" width="34" height="140" rx="8" fill="#e8c048"/></g></g>
