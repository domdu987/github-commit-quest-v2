            const sw = g.querySelector(`#${id}-sw`); tl.fromTo(sw, { x: 420 }, { x: 0, duration: 0.18, ease: "power4.out" }, t0);
            tl.to(g.querySelector(`#${id}-mm`), { opacity: 1, duration: 0.2 }, t0 + F("b05", 0, 2) - off); flash(tl, t0, 0.6, 0.3); } })]);

      // ---------- b06 · Arthur reads the header… both his ears go red like brake lights ----------
      const B6 = [A("jkArthurAim", AX - 120, 1400, 0.98, [{ t: 0, mode: "swordAim", opts: { arm: -70 }, eyes: "side", mouth: "flat" }, { t: F("b06", 0, 2), mode: "swordAim", opts: { arm: -60 }, eyes: "wide", mouth: "o", sweat: true }], { flip: true })];
      shot("b06", { ...cave("b06"), blur: { far: 8, mid: 6, set: 3 }, cam: { keys: [{ t: 0, ...faceAt(AX - 120, 1400, 0.98, 2.3, true, 560, 860), drift: { s: 0.02 } }, { t: F("b06", 0, 1) - 0.1, ...faceAt(AX - 120, 1400, 0.98, 3.0, true, 560, 840), glide: 0.6 }] }, actors: B6,
        fx(tl, id, t0, L) { earsBlink(tl, `${id}-a0`, t0 + F("b06", 0, 2), D("b06") - F("b06", 0, 2), 0.28); JKI.badge(tl, L.light, t0, D("b06"), { kind: "ears", x: 220, y: 520, s: 1.4, tone: "red", label: "แดงแจ๋!", at: F("b06", 0, 2) + 0.1 }); } });

      // ---------- b07 · "senior… I sold insurance too, branch 111 — and fell down a drain" ----------
      splitN("b07", [F("b07", 0, 2) - 0.05], [
        () => { const B = [A("jkArthurAim", AX - 120, 1400, 0.98, [{ t: 0, mode: "swordAim", opts: { arm: -40 }, eyes: "worry", mouth: "o", sweat: true }], { flip: true, talk: [[F("b07", 0, 1), F("b07", 0, 2), "o"]] })];
          return { ...cave("b07"), blur: { far: 8, mid: 6, set: 3 }, cam: { keys: [{ t: 0, ...faceAt(AX - 120, 1400, 0.98, 2.8, true, 560, 840), drift: { s: 0.02 } }] }, actors: B,
            fx(tl, id, t0, L) { earsBlink(tl, `${id}-a0`, t0, F("b07", 0, 2), 0.28); } }; },
        (off) => ({ set: "jkCity", setOpts: { id: `jy${off}`, manhole: true, dark: true }, dark: 0.25, light: false, grade: { top: "#d8b890", bottom: "#3a2a20", op: 0.42 }, blur: { far: 4, mid: 2 },
          cam: { keys: [{ t: 0, ...fr(1100, 1200, 1.0, 540, 1000), drift: { s: 0.02 } }] },
          fx(tl, id, t0, L) { const g = grp(L.act); g.innerHTML = `<g transform="translate(1180,1120)"><rect x="-60" y="0" width="120" height="86" rx="8" fill="#4a3426"/><rect x="-60" y="0" width="120" height="18" fill="#3a281c"/><path d="M-18,0v-16h36v16" stroke="#3a281c" stroke-width="7" fill="none"/></g>`;
            tl.set(g, { opacity: 1 }, 0); tl.fromTo(g, { y: -500, rotation: 0, svgOrigin: "1180 1160" }, { y: 300, rotation: 50, svgOrigin: "1180 1160", duration: 0.9, ease: "power2.in", immediateRender: false }, t0 + F("b07", 0, 3) - off);
            const sg = grp(L.set); sg.innerHTML = `<g transform="translate(1060,1360)"><rect x="-220" y="-540" width="440" height="100" fill="#2a4a8a"/><text x="0" y="-478" text-anchor="middle" font-family="Kanit" font-weight="900" font-size="46" fill="#f6d36a">ประกันชีวิต มั่นใจ</text><text x="0" y="-448" text-anchor="middle" font-family="Kanit" font-weight="700" font-size="22" fill="#f4ecd8">สาขา 111</text></g>`; tagW(tl, L, 820, 640, "สาขา 111 · ที่ทำงานเก่าของรุ่นพี่", t0 + 0.1); const v = grp(L.light); v.innerHTML = `<g transform="${LS(540, 960)}"><rect x="-1280" y="-720" width="2560" height="1440" fill="none" stroke="#2a1a10" stroke-width="90" opacity=".55"/></g>`;
            JKI.badge(tl, L.light, t0, D("b07") - off, { kind: "sales", x: 220, y: 520, s: 1.3, tone: "blue", label: "เซลส์รุ่นน้อง", at: 0.2 }); } })]);

      // ---------- b08 · "I never lose: I told everyone that whoever fights me gets a sudden stomach ache!" (his story, sepia) ----------
      const B8 = [A("jkArthurSwordUp", 760, 1400, 0.98, [{ t: 0, mode: "raise", eyes: "squint", mouth: "smirk" }], { flip: true }),
        A("jkGuardSpear", 260, 1400, 1.0, [{ t: 0, mode: "idle", eyes: "angry", mouth: "frown" }, { t: F("b08", 0, 2) + 0.3, mode: "belly", eyes: "closed", mouth: "scream", sweat: true }]),
        A("jkGuardSpear", 20, 1400, 1.0, [{ t: 0, mode: "idle", eyes: "angry", mouth: "frown" }, { t: F("b08", 0, 2) + 0.5, mode: "belly", eyes: "wide", mouth: "o", sweat: true }])];
      shotT("b08", { ...town2("b08"), dark: 0.18, grade: { top: "#e8c890", bottom: "#3a2a18", op: 0.4 }, blur: { far: 5, mid: 3 }, cam: { keys: [{ t: 0, ...fr(420, 1060, 1.15, 540, 980), drift: { s: 0.015 } }] }, actors: B8,
        sfxText: [{ text: "โอ๊ย!", x: 300, y: 560, size: 120, rot: -8, color: "#ffffff", t: F("b08", 0, 2) + 0.4, end: D("b08") - 0.1 }],
        fx(tl, id, t0, L) { shadows(L, id, B8, 0.5); earsBlink(tl, `${id}-a0`, t0 + F("b08", 0, 1), D("b08") - F("b08", 0, 1), 0.28); tagW(tl, L, 40, 1400 - 760, "ปวดท้องกะทันหัน!", t0 + F("b08", 0, 2) + 0.5);
          const v = grp(L.light); v.innerHTML = `<g transform="${LS(540, 960)}"><rect x="-1280" y="-720" width="2560" height="1440" fill="none" stroke="#2a1a10" stroke-width="90" opacity=".5"/></g>`; } });

      // ---------- b09 · two salesmen, one plan ----------
      const B9 = [ME("jkYouBucketPaper", HX + 200, 1400, [{ t: 0, mode: "idle", eyes: "normal", mouth: "flat" }, { t: F("b09", 0, 2), mode: "nod", eyes: "normal", mouth: "smile" }]),
        A("jkArthurAim", AX, 1400, 0.98, [{ t: 0, mode: "swordAim", opts: { arm: 20 }, eyes: "worry", mouth: "o" }, { t: F("b09", 0, 2), mode: "nod", eyes: "squint", mouth: "grin" }], { flip: true })];
      shot("b09", { ...cave("b09"), blur: { far: 6, mid: 4 }, cam: { keys: [{ t: 0, ...fr(700, 1060, 1.55, 540, 960), drift: { s: 0.015 } }] }, actors: B9,
        fx(tl, id, t0, L) { shadows(L, id, B9, 0.5); earsBlink(tl, `${id}-a1`, t0, D("b09"), 0.28); const [hx, hy] = headTop(HX + 200, 1400); const sm = grp(L.act);
          sm.innerHTML = `<g transform="translate(${hx},${1400 - 560 * 0.95})"><path d="M-22,4q8,-8 16,0M18,4q8,-8 16,0" stroke="#fff4c0" stroke-width="4" fill="none" stroke-linecap="round"/></g>`; sm.style.opacity = 0; tl.to(sm, { opacity: 1, duration: 0.2 }, t0 + F("b09", 0, 1));
