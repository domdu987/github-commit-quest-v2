          tl.fromTo("#lvf-ws", { scaleY: 0.2, opacity: 0.3, svgOrigin: "0 -180" }, { scaleY: 1, opacity: 1, svgOrigin: "0 -180", duration: 1.6, ease: "power2.out", immediateRender: false }, t0 + 0.6); life(tl, t0, d); } })],
