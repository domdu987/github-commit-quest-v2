      // ---------- รอดคนเดียว EP.2 v4 round 2 · S17 card rhythm · lane C ----------
      // frame 0 = EP.1 v4b's last frame (crashSite m1, the plume across the bay); then the island in the ทะเลลด kit: palms, glitter, long
      // shadows, a foreground in every shot. Faces ≥ 1/3 on the beats (sees the smoke · sees the 4 a.m. fire · the helicopter passes ·
      // "ว่างเปล่า"). Facts live on things (the wet chart, the safety card on its rope). No HUD.
      const still = (x) => ({ ...x, drift: { s: 0 } });
      const A = (who, x, y, s, track, extra = {}) => { if (extra.talk) track.talk = extra.talk; return { who, x, y, s, track, blinks: [0.7, 2.6, 4.4], ...extra }; };
      const T = (mode, eyes = "normal", mouth = "flat", t = 0) => ({ t, mode, eyes, mouth });
      const TALK = (k, i, m) => [vo(k, i), voEnd(k, i), m];
      const QUO = { quote: true };
      Rig.MODES.crouchLook = (u, o) => ({ ...Rig.MODES.crouch(u, o), uaF: -72 + 8 * Math.sin(u * 3.1), faF: -8, uaB: 20, faB: -30, head: -8 });
      Rig.MODES.zip = (u, o) => ({ ...Rig.MODES.sit(u, o), uaF: -40, faF: -120 + 10 * Math.sin(u * 6), uaB: -30, faB: -110, head: 10, torso: 6 });
      Rig.MODES.pointF = (u, o) => ({ ...Rig.MODES.idle(u, o), torso: 3, head: -6, uaF: -96 + 3 * Math.sin(u * 4), faF: -4, uaB: 12, faB: -10 });
      Rig.MODES.cock = (u, o) => ({ ...Rig.MODES.idle(u, o), torso: 6, head: 4, uaF: 30, faF: -100, uaB: -10, faB: -20, bodyY: 6 });
      Rig.MODES.lookUp = (u, o) => ({ ...Rig.MODES.idle(u, o), torso: -6, head: -22 + 2 * Math.sin(u * 3), uaF: -20, faF: -60, uaB: 10, faB: -20 });
      const DUSKL = { from: "left", rim: "#ffc890", rimOp: 0.95, shade: "#2a1a3a", shadeOp: 0.2, cast: { len: 0.6, op: 0.3 }, vol: false };
      const EP1L = { from: "left", rim: "#ffc890", rimOp: 0.7, shade: "#141a2a", shadeOp: 0.35, cast: false, vol: false };
      const MOONL = { from: "right", rim: "#cfe0ff", rimOp: 0.9, shade: "#14204a", shadeOp: 0.2, cast: { len: 0.3, op: 0.25 }, vol: false };
      const DAYL = { from: "right", rim: "#ffffff", rimOp: 0.7, shade: "#3a4a6a", shadeOp: 0.12, cast: { len: 0.35, op: 0.28 }, vol: false };
      const DAWNL = { from: "right", rim: "#ffe0b0", rimOp: 0.8, shade: "#3a2a4a", shadeOp: 0.16, cast: { len: 0.5, op: 0.28 }, vol: false };
      const GDUSK = { top: "#ffd8a0", bottom: "#2a1a3a", op: 0.05 }, GNITE = { top: "#4a6aaa", bottom: "#0a1226", op: 0.06 }, GDAY = { top: "#fff8e0", bottom: "#2a4a6a", op: 0.03 }, GSEA = { top: "#ffb080", bottom: "#101828", op: 0.12 };
      const PLUME = [820, 1020, 820];
      const ISLE = (id, time, view, extra = {}) => ({ set: "isle", setOpts: { id, time, view, ...extra }, dark: 0,
        light: { dusk: DUSKL, night: MOONL, day: DAYL, dawn: DAWNL }[time], grade: { dusk: GDUSK, night: GNITE, day: GDAY, dawn: GDAY }[time], blur: { far: 1, mid: 0.5, fg: 10 } });
      const ROCKS = (id, extra = {}) => ISLE(id, "dusk", "rocks", { plume: PLUME, ...extra });
      const seg = (k, segs) => segs.forEach(([at, mkSpec], i) => {
        const end = i + 1 < segs.length ? segs[i + 1][0] : D(k), dur = end - at, spec = mkSpec(dur, at);
        add(k, { captions: capsFrom(k, at, undefined, spec.capO), ...spec }); const sh = shots[shots.length - 1]; sh.start = SH[k].start + at; sh.dur = dur; });
      const C = (k, i = 0, j = 0) => Math.max(0, F(k, i, j) - 0.1);
      const life = (tl, t0, d) => { Isle.life2(tl, null, t0, d); Isle.life6(tl, t0, d); };
      // a face close-up: the actor at scale s, the camera on the head (≥ 1/3 of the frame), the set out of focus behind
      const CU = (base, who, x, track, o = {}) => (d) => ({ ...base, blur: { far: 6, mid: 6, set: 7, fg: 12 },
        cam: { keys: [{ t: 0, ...fr(x + (o.dx ?? 0), 1130, o.z ?? 3.1, 540, 760) }, { t: d, glide: d, ...fr(x + (o.dx ?? 0), 1130, (o.z ?? 3.1) * 1.06, 540, 760) }] },
        actors: [A(who, x, 1700, 1.0, track, o.flip ? { flip: true } : {})],
        fx(tl, id, t0, L) { life(tl, t0, d); o.fx && o.fx(tl, id, t0, L, d); } });
      const warmFace = (L, id, side = "right", col = "#ff8a3a", op = 0.4) => put(L.light, `<radialGradient id="${id}-wf" cx="${side === "right" ? 1 : 0}" cy=".4" r=".9"><stop offset="0" stop-color="${col}" stop-opacity="${op}"/><stop offset="1" stop-color="${col}" stop-opacity="0"/></radialGradient><rect width="1080" height="1920" fill="url(#${id}-wf)" style="mix-blend-mode:screen"/>`);

      // ===== B0 hook: EP.1's last frame (the plume across the bay) → คิว on the rocks, rim-lit, points at a smoke column a third of the frame =====
      // ---- v5: inserts are drawn at the identity camera (world = screen), the set behind thrown out of focus ----
      const ID = fr(540, 960, 1.0, 540, 960);
      const INS = (base, d, push = 0.04) => ({ ...base, blur: { far: 8, mid: 8, set: 9, fg: 14 }, cam: { keys: [{ t: 0, ...ID }, { t: d, glide: d, ...fr(540, 960, 1 + push, 540, 960) }] } });
      Rig.MODES.pull = (u, o) => ({ ...Rig.MODES.kneel(u, o), torso: 4 + 2 * Math.sin(u * 3), head: -10, uaF: -92 + 3 * Math.sin(u * 5), faF: -6, uaB: -82, faB: -14 });
      Rig.MODES.cup = (u, o) => ({ ...Rig.MODES.kneel(u, o), torso: 34, head: 6, uaF: -54, faF: -48, uaB: -44, faB: -56 });
      Rig.MODES.sitFire = (u, o) => ({ ...Rig.MODES.kneel(u, o), torso: 18, head: -4 + 2 * Math.sin(u * 1.2), uaF: -60, faF: -30, uaB: -20, faB: -60 });
      Rig.MODES.throwF = (u, o) => { const c = (x) => Math.max(0, Math.min(1, x)), k1 = c(u / 0.3), k2 = c((u - 0.3) / 0.16), e = k2 * k2 * (3 - 2 * k2), st = c((u - 0.6) / 0.5);
        // v6b: a real throw — wind the arm back, fling it forward, follow through and settle
        return { ...Rig.MODES.idle(u, o), torso: -8 * k1 + 20 * e - 8 * st, head: -4 + 4 * e, uaF: 20 + 50 * k1 - 190 * e + 40 * st, faF: -20 - 50 * k1 + 60 * e, uaB: 10 - 25 * e, faB: -20 }; };
      Rig.MODES.throwFq = (u, o) => Rig.MODES.throwF(u + 0.22, o);
      // v6b-A: closing the jacket over the vest (the open pose run backwards) · zipping it up standing
      Rig.MODES.closeJacket = (u, o) => { const k = 1 - x3(u); return { ...Rig.MODES.idle(u, o), uaF: -20 - 26 * k, faF: 112 - 14 * k, uaB: 20 + 26 * k, faB: -112 + 14 * k, head: 6 }; };
      Rig.MODES.zipUp = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -20 + 4 * Math.sin(u * 7), faF: 108 + 8 * Math.sin(u * 7), uaB: 20 - 4 * Math.sin(u * 7), faB: -108 - 8 * Math.sin(u * 7), head: 10, torso: 3 });
      const x3 = (u) => { const x = Math.max(0, Math.min(1, (u - 0.05) / 0.45)); return x * x * (3 - 2 * x); };
      const cl = (x) => Math.max(0, Math.min(1, x)), ease = (x) => x * x * (3 - 2 * x);
      // v6b: both hands take the jacket's edges and pull it open
      Rig.MODES.openJacket = (u, o) => { const k = ease(cl((u - 0.1) / 0.4)); return { ...Rig.MODES.idle(u, o), uaF: -20 - 26 * k, faF: 112 - 14 * k, uaB: 20 + 26 * k, faB: -112 + 14 * k, head: -6 * k, torso: 0 }; };
      // v6b: one arm up, holding the metal panel and tilting it at the sun
      Rig.MODES.holdPanel = (u, o) => ({ ...Rig.MODES.idle(u, o), uaF: -118 + 6 * Math.sin(u * 7), faF: -14, uaB: 14, faB: -20, head: -10, torso: -3 });
      { const C = Rig.CAST, k = C.kiw.v2, ln = (w) => `stroke="#241c22" stroke-width="${w}" stroke-linejoin="round"`;
        // the jacket pulled open: the orange vest across the chest, two silver reflective bands, the jacket's edges folded back to both sides
        C.kiwOpen = { v2: { ...k, print: "", extra: `<path d="M-50,-484Q0,-470 50,-484L52,-286Q0,-276 -52,-286Z" fill="#ff6a14" ${ln(2.6)}/><path d="M-6,-478V-280" stroke="#c84a0a" stroke-width="4"/>
          <rect x="-52" y="-430" width="104" height="18" fill="#e8eef4" ${ln(2)}/><rect x="-52" y="-362" width="104" height="18" fill="#e8eef4" ${ln(2)}/><path d="M-50,-425h100M-50,-357h100" stroke="#ffffff" stroke-width="4" opacity=".9"/>
          <rect x="-14" y="-330" width="28" height="18" rx="4" fill="#2a2a30"/>
          <path d="M-50,-486L-74,-470L-82,-290L-52,-286Z" fill="#d9a43a" ${ln(2.4)}/><path d="M50,-486L74,-470L82,-290L52,-286Z" fill="#d9a43a" ${ln(2.4)}/><path d="M-60,-470L-66,-300M60,-470L66,-300" stroke="#a87420" stroke-width="4" opacity=".7"/>` + `<path d="M-40,-482Q0,-452 40,-482" stroke="#f4f4f0" stroke-width="9" fill="none"/>` } }; }
      const DAYR = (id, extra = {}) => ISLE(id, "day", "rocks", extra);
      // B0 frame 0 = EP.1 v4b's last place: the ทะเลลด beach at eerie dusk, the smoke behind the far karst (820, 650); คิว big in front, pointing at it
      add("hook", { set: "tideBeach", setOpts: { id: "h0", view: "sea", time: "eerie", sea: 0, boats: 0, fish: 0, people: 0, seed: 7, palms: false }, dark: 0.02, light: { from: "left", rim: "#ffc890", rimOp: 0.9, shade: "#141a2a", shadeOp: 0.25, cast: { len: 0.6, op: 0.3 }, vol: false },
        grade: { top: "#ff8a5a", bottom: "#2a2050", op: 0.18 }, blur: { fg: 6 },
        cam: { keys: [{ t: 0, ...fr(560, 991, 1.0, 540, 960) }, { t: D("hook"), glide: D("hook"), ...fr(590, 960, 1.06, 540, 960) }] }, captions: caps("hook"),
        actors: [A("kiw", 380, 1560, 1.75, [T("idle", "wide", "o"), T("cock", "wide", "o", 0.5), T("pointF", "wide", "o", 0.72)])],
        fx(tl, id, t0, L) { Tide.sea(tl, "h0", t0, D("hook"), {});
          put(L.sky, `<linearGradient id="h0-dk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a4a6a"/><stop offset=".6" stop-color="#c87a6a"/><stop offset="1" stop-color="#f2b080"/></linearGradient><rect x="-2000" y="-1400" width="5200" height="2050" fill="url(#h0-dk)"/><circle cx="260" cy="640" r="260" fill="#fff0c8" opacity=".35"/><circle cx="260" cy="640" r="66" fill="#fff6e0"/>`);
          put(L.far, `${Isle.smokeStream("h0s", 800, 600, 900, { lean: 0.22, r: 78, n: 20, period: 3.6 })}${Isle.flames("h0f", 800, 646, 0.32)}`); life(tl, t0, D("hook")); } });
      // the command on his face (≥ 1/3): eyes on the smoke, gold rim from the left
      add("cmd", { ...CU(ROCKS("c0"), "kiw", 380, [T("pointF", "wide", "o")], { dx: 50 })(D("cmd")), captions: caps("cmd") });
      seg("why", [
        [0, (d) => ({ ...ROCKS("w1", { fg: false }), cam: { keys: [{ t: 0, ...fr(560, 1500, 1.2, 540, 960) }, { t: d, glide: d, ...fr(560, 1300, 0.42, 540, 960) }] },
          actors: [A("kiw", 520, 1780, 1.45, [T("idle", "wide", "o")])], fx(tl, id, t0) { life(tl, t0, d); } })],
        [C("why", 0, 2), (d) => ({ set: "aerial", setOpts: { id: "w2" }, dark: 0, light: false, grade: GDAY,
          cam: { keys: [{ t: 0, ...fr(560, 960, 1.0, 540, 960) }, { t: d, glide: d, ...fr(620, 1100, 1.25, 540, 960) }] },
          fx(tl, id, t0) { life(tl, t0, d); tl.fromTo("#w2-dot", { opacity: 1 }, { opacity: 0.3, duration: 0.2, yoyo: true, repeat: 6, immediateRender: false }, t0); } })],
      ]);
      seg("wreck", [
        [0, (d) => ({ set: "aerial", setOpts: { id: "k1" }, dark: 0, light: false, grade: GDAY,
          cam: { keys: [{ t: 0, ...fr(560, 1110, 1.6, 540, 960) }, { t: d, glide: d, ...fr(560, 1110, 2.1, 540, 960) }] },
          fx(tl, id, t0) { life(tl, t0, d); tl.fromTo("#k1-ring", { opacity: 0, scale: 1.5, svgOrigin: "560 1110" }, { opacity: 1, scale: 1, svgOrigin: "560 1110", duration: 0.4, ease: "back.out(2)", immediateRender: false }, t0 + 0.4); } })],
        [C("wreck", 0, 1), (d) => ({ set: "tailIn", setOpts: { id: "k2" }, dark: 0, light: MOONL, grade: { top: "#9ab8f0", bottom: "#1a2236", op: 0.05 }, blur: { far: 5, set: 4 },
          cam: { keys: [{ t: 0, ...still(fr(540, 960, 1.0, 540, 960)) }] },
          fx(tl, id, t0, L) { put(L.act, `<g transform="translate(540,900) rotate(-3) scale(1.55)">${Isle.chart("ch")}</g>`);
            tl.fromTo("#ch-rt", { attr: { "stroke-dashoffset": 600 } }, { attr: { "stroke-dashoffset": 0 }, duration: d * 0.7, ease: "power1.inOut", immediateRender: false }, t0);
            tl.fromTo("#ch-x", { scale: 0, svgOrigin: "0 0" }, { scale: 1, svgOrigin: "0 0", duration: 0.35, ease: "back.out(3)", immediateRender: false }, t0 + d * 0.65);
            tl.fromTo("#ch", { rotation: -1 }, { rotation: 1, svgOrigin: "0 0", duration: 1.1, yoyo: true, repeat: 3, ease: "sine.inOut", immediateRender: false }, t0); } })],
      ]);
      // over his shoulder: only the smoke (it darkens on "แต่")
      // the clock: half a bottle of water in his hand
      add("bottle", { ...INS(ROCKS("bo", { fg: false }), D("bottle")), captions: caps("bottle"),
        fx(tl, id, t0, L) { life(tl, t0, D("bottle")); put(L.act, `<g transform="translate(560,1330) scale(1.7) rotate(-6)">${Isle.bottle("bo1", 0.5)}</g>${Isle.hand([470, 1180], 84, 2.2, { hand: { curl: [0.8, 0.85, 0.85, 0.9], thumb: 0.2 } })}`);
          tl.fromTo("#bo1-w", { y: 0 }, { y: 4, duration: 0.5, yoyo: true, repeat: 5, ease: "sine.inOut", immediateRender: false }, t0); } });
      // the sun on the rocks all day: white heat, shimmer, him small and squinting
      add("sun", { ...DAYR("su", { tail: [460, 1500, 1.0], grey: true }), dark: 0, cam: { keys: [{ t: 0, ...fr(540, 1100, 1.05, 540, 1000) }, { t: D("sun"), glide: D("sun"), ...fr(540, 1080, 1.15, 540, 1000) }] }, captions: caps("sun"),
        actors: [A("kiw", 230, 1820, 1.2, [T("idle", "worry", "frown")])],
        fx(tl, id, t0, L) { life(tl, t0, D("sun")); put(L.light, `<rect id="su-h" width="1080" height="1920" fill="#fff6d8" opacity=".25" style="mix-blend-mode:screen"/>`);
          tl.fromTo("#su-h", { opacity: 0.1 }, { opacity: 0.35, duration: 0.4, yoyo: true, repeat: 5, ease: "sine.inOut", immediateRender: false }, t0); } });
      // the last drop
      add("empty1", { ...INS(DAYR("e1", { fg: false }), D("empty1")), captions: caps("empty1"),
        fx(tl, id, t0, L) { life(tl, t0, D("empty1")); put(L.act, `<g transform="translate(560,620) scale(1.8) rotate(160)">${Isle.bottle("bo2", 0.03)}</g>${Isle.hand([700, 930], -28, 2.0, { hand: { curl: [0.8, 0.85, 0.85, 0.9], thumb: 0.2 } })}`);
          tl.fromTo("#bo2-d", { opacity: 1, attr: { cy: -330 } }, { opacity: 1, attr: { cy: -560 }, duration: 0.6, ease: "power2.in", immediateRender: false }, t0 + 0.3); tl.to("#bo2-d", { opacity: 0, duration: 0.1 }, t0 + 0.9); } });
      // cracked lips (≥ 1/3) → he kneels at the water's edge and cups the sea in both hands
      seg("thirst", [
        [0, CU(DAYR("th1"), "kiw", 360, [T("idle", "worry", "frown")], { dx: 50 })],
        [C("thirst", 0, 1), (d) => ({ ...DAYR("th2", { fg: false }), cam: { keys: [{ t: 0, ...fr(560, 1380, 1.25, 540, 1100) }, { t: d, glide: d, ...fr(560, 1400, 1.35, 540, 1100) }] },
          actors: [A("kiw", 520, 1560, 1.3, [T("kneel", "wide", "o"), T("cup", "wide", "o", 0.35)])], fx(tl, id, t0) { life(tl, t0, d); } })],
      ]);
      // the cupped seawater stops at his mouth
      add("nosea", { ...INS(DAYR("ns", { fg: false }), D("nosea"), 0.08), captions: caps("nosea"), shake: (t) => ({ x: t < 0.2 ? 6 * Math.sin(t * 70) : 0, y: 0, r: 0 }),
        fx(tl, id, t0, L) { life(tl, t0, D("nosea")); put(L.act, `<g id="ns-h">${Isle.hand([470, 1120], 18, 2.4, { hand: { curl: [0.25, 0.25, 0.25, 0.3], thumb: 0.6 } })}${Isle.hand([610, 1120], -18, 2.4, { mirror: true, hand: { curl: [0.25, 0.25, 0.25, 0.3], thumb: 0.6 } })}<ellipse cx="540" cy="1000" rx="120" ry="34" fill="#5ab0d8" opacity=".85"/><path d="M450,990q90,-20 180,0" stroke="#fff" stroke-width="6" opacity=".7" fill="none"/></g>`);
          tl.fromTo("#ns-h", { y: 160 }, { y: 0, duration: 0.25, ease: "power3.out", immediateRender: false }, t0); } });
      // the water runs out between his fingers onto the rock; the salt crust left where the sea dried
      // the mechanism with his own bottles: one bottle of seawater goes in → two bottles of the body's water pour out → salt crystals on his palm
      seg("salt", [
        [0, (d) => ({ ...INS(DAYR("sl1", { fg: false }), d), fx(tl, id, t0, L) { life(tl, t0, d);
          put(L.act, `<path d="M-300,1500Q500,1440 1400,1520V2400H-300Z" fill="#4a4a54"/><g id="sl1b" transform="translate(540,1120) scale(2.0)">${Isle.bottle("sb1", 0.95, { c: "#3a9a9a", label: "น้ำทะเล" })}</g>${Isle.hand([470, 1080], 70, 2.1, { hand: { curl: [0.8, 0.85, 0.85, 0.9], thumb: 0.2 } })}`);
          tl.fromTo("#sl1b", { rotation: 0, svgOrigin: "540 1120" }, { rotation: -150, svgOrigin: "540 1120", duration: d * 0.6, ease: "power1.inOut", immediateRender: false }, t0 + 0.1);
          tl.fromTo("#sb1-w", { scaleY: 1, svgOrigin: "0 0" }, { scaleY: 0.02, svgOrigin: "0 0", duration: d * 0.7, ease: "power1.in", immediateRender: false }, t0 + 0.3); } })],
        [C("salt", 0, 1), (d) => ({ ...INS(DAYR("sl2", { fg: false }), d), fx(tl, id, t0, L) { life(tl, t0, d);
          put(L.act, `<path d="M-300,1450Q500,1400 1400,1470V2400H-300Z" fill="#4a4a54"/>${[[330, "sb2"], [750, "sb3"]].map(([x, b2]) => `<g id="${b2}g" transform="translate(${x},1180) scale(1.8)">${Isle.bottle(b2, 0.95, { label: "น้ำในตัว" })}</g><path id="${b2}s" d="M${x},700Q${x + 90},900 ${x + 70},1450" stroke="#7ac8f0" stroke-width="22" fill="none" stroke-linecap="round" opacity="0"/>`).join("")}
            <g id="sl2d">${Array.from({ length: 14 }, (_, k) => `<circle cx="${200 + (k * 71) % 700}" cy="${1440 + (k % 3) * 14}" r="${8 + (k % 3) * 3}" fill="#7ac8f0"/>`).join("")}</g>`);
          ["sb2", "sb3"].forEach((b2, j) => { tl.fromTo(`#${b2}g`, { rotation: 0, svgOrigin: `${j ? 750 : 330} 1180` }, { rotation: j ? 120 : -120, svgOrigin: `${j ? 750 : 330} 1180`, duration: 0.45, ease: "power2.in", immediateRender: false }, t0 + 0.15 + j * 0.2);
            tl.fromTo(`#${b2}-w`, { scaleY: 1, svgOrigin: "0 0" }, { scaleY: 0.02, svgOrigin: "0 0", duration: d - 0.8, ease: "none", immediateRender: false }, t0 + 0.55 + j * 0.2); });
          tl.fromTo("#sl2d", { opacity: 0, y: -20 }, { opacity: 1, y: 0, duration: 0.4, immediateRender: false }, t0 + 0.7); } })],
        [C("salt", 0, 2), (d) => ({ ...INS(DAYR("sl3", { fg: false }), d, 0.08), fx(tl, id, t0, L) { life(tl, t0, d); const r = Pop2.mk(9);
          put(L.act, `${Isle.hand([540, 1250], 0, 3.0, { hand: { curl: [0, 0, 0, 0], thumb: 0 } })}<g id="sl3c">${Array.from({ length: 34 }, () => { const x = 460 + r() * 170, y = 1020 + r() * 210, s2 = 5 + r() * 9; return `<rect x="${f1(x)}" y="${f1(y)}" width="${f1(s2)}" height="${f1(s2)}" fill="#ffffff" stroke="#c8d4dc" stroke-width="1.5" transform="rotate(${f1(r() * 90)} ${f1(x)} ${f1(y)})"/>`; }).join("")}</g>`);
          tl.fromTo("#sl3c", { opacity: 0.2 }, { opacity: 1, duration: 0.18, yoyo: true, repeat: Math.ceil(d / 0.18), ease: "sine.inOut", immediateRender: false }, t0); } })],
      ]);
